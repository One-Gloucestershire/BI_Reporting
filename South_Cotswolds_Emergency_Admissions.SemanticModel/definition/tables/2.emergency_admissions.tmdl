	measure SPC_average_total_frail_emg_adm_per_1000 = ```
			
			VAR  FilteredTable = 
			    CALCULATETABLE(
			        REF_Date,
			        ALL(REF_Date),
			        REF_Date[SPC_Flag] = 1
			    )
			
			VAR SummaryTable = 
			    SUMMARIZE(  ---Creates a 'virtual pivot table within the measure 
			       FilteredTable,
			        REF_Date[financial_year],
			        REF_Date[month_name],
			        "total_frail_emg_adm_per_1000", [total_frail_emg_adm_per_1000] --- CHANGE TO YOUR MEASURE
			    )
			
			VAR AverageRate =    --calculates the average of the summary table above to obtain the average over the SPC period
			    AVERAGEX(
			        SummaryTable,
			        [total_frail_emg_adm_per_1000]
			    )
			RETURN
			    AverageRate
			```
		formatString: 0.00
		displayFolder: SPC - Emergency Admissions
		lineageTag: 30b8f764-5b75-4983-b1c3-774be0f9fcf8

	measure SPC_Standard_deviation_total_frail_emg_adm_per_1000 = ```
			
			VAR  FilteredTable = 
			    CALCULATETABLE(
			        REF_Date,
			        ALL(REF_Date),
			        REF_Date[SPC_Flag] = 1
			    )
			
			VAR SummaryTable = 
			    SUMMARIZE(
			       FilteredTable,
			        REF_Date[financial_year],
			        REF_Date[month_name],
			        "total_frail_emg_adm_per_1000", [total_frail_emg_adm_per_1000])
			
			VAR stand_dev =
