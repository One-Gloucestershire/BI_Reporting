	measure SCV_emg_adm_Two_out_of_three_points_near_to_the_LCL = ```
			
			
			VAR FilteredTable_ =
			    filter(ALLSELECTED(REF_Date),REF_Date[YearMonthIndex] >= 1)
			
			VAR SummaryTable =
			    SUMMARIZE(
			        FilteredTable_,
			        REF_Date[financial_year],
			        REF_Date[month_name],
			        REF_Date[YearMonthIndex],
			        REF_Date[SPC_Flag],
			        "total_frail_emg_adm_per_1000", [total_frail_emg_adm_per_1000]
			    )
			
			VAR MeanValue = [SPC_average_total_frail_emg_adm_per_1000]
			
			VAR cumualitive_moving_average_value = divide([Emg_adm_moving_range],2.66)
			
			VAR LowerOuterThird = MeanValue - (2*(cumualitive_moving_average_value/1.128))
			
			VAR SummaryTableWithFlags =
			    ADDCOLUMNS(
			        SummaryTable,
			        "IsBelowLowerOuterThird",
			        IF([total_frail_emg_adm_per_1000] < LowerOuterThird, 1, 0),
			        "IsBelowMean",
			        IF([total_frail_emg_adm_per_1000] < MeanValue, 1, 0)
			    )
			
			VAR PatternTable =
			    ADDCOLUMNS(
			        SummaryTableWithFlags,
			        "PatternFlag",
			        VAR CurrentIndex = REF_Date[YearMonthIndex]
			
			        // Check the range of two months behind the current month index
			        VAR CheckPrevRange =
			            CALCULATE(
			                SUMX(
			                    FILTER(
			                        SummaryTableWithFlags,
			                        REF_Date[YearMonthIndex] IN {CurrentIndex - 2, CurrentIndex - 1, CurrentIndex}
			                    ),
			                    [IsBelowLowerOuterThird]
			                )
			            )
			        
			        // Check the range of one month either side of the current month index
			        VAR CheckMidRange =
			            CALCULATE(
			                SUMX(
			                    FILTER(
			                        SummaryTableWithFlags,
			                        REF_Date[YearMonthIndex] IN {CurrentIndex - 1, CurrentIndex, CurrentIndex + 1}
			                    ),
			                    [IsBelowLowerOuterThird]
			                )
			            )
			        
			        // Check the range of two months in front of the current month index
			        VAR CheckNextRange =
			            CALCULATE(
			                SUMX(
			                    FILTER(
			                        SummaryTableWithFlags,
			                        REF_Date[YearMonthIndex] IN {CurrentIndex, CurrentIndex + 1, CurrentIndex + 2}
			                    ),
			                    [IsBelowLowerOuterThird]
			                )
			            )
			        
			        // Ensure all points in the previous range are below the mean
			        VAR CheckAllBelowMeanPrevRange =
			            CALCULATE(
			                SUMX(
			                    FILTER(
			                        SummaryTableWithFlags,
			                        REF_Date[YearMonthIndex] IN {CurrentIndex - 2, CurrentIndex - 1, CurrentIndex}
			                    ),
			                    [IsBelowMean]
			                )
			            )
			        
			        // Ensure all points in the middle range are below the mean
			        VAR CheckAllBelowMeanMidRange =
			            CALCULATE(
			                SUMX(
			                    FILTER(
			                        SummaryTableWithFlags,
			                        REF_Date[YearMonthIndex] IN {CurrentIndex - 1, CurrentIndex, CurrentIndex + 1}
			                    ),
			                    [IsBelowMean]
			                )
			            )
			        
			        // Ensure all points in the next range are below the mean
			        VAR CheckAllBelowMeanNextRange =
			            CALCULATE(
			                SUMX(
			                    FILTER(
			                        SummaryTableWithFlags,
			                        REF_Date[YearMonthIndex] IN {CurrentIndex, CurrentIndex + 1, CurrentIndex + 2}
			                    ),
			                    [IsBelowMean]
			                )
			            )
			        
			        RETURN
			   
			            IF(
			                AND(
			                    [IsBelowLowerOuterThird] = 1,
			                    OR(
			                        AND(CheckPrevRange >= 2, CheckAllBelowMeanPrevRange = 3),
			                        OR(
			                            AND(CheckMidRange >= 2, CheckAllBelowMeanMidRange = 3),
			                            AND(CheckNextRange >= 2, CheckAllBelowMeanNextRange = 3)
			                        )
			                    )
			                ),
			                1,
			                0
			            )
			    )
			
			VAR AdditionalFlags =
			    SELECTCOLUMNS(
			        FILTER(
			            PatternTable,
			            [PatternFlag] = 1
			        ),
			        "YearMonthIndex", REF_Date[YearMonthIndex]
			    )
			
			RETURN
			IF(
			    MIN(REF_Date[YearMonthIndex]) IN AdditionalFlags,
			    [total_frail_emg_adm_per_1000],
			    BLANK()
			)
			```
		displayFolder: SPC - Emergency Admissions
		lineageTag: b36feccb-6fdc-45e0-a87e-45403f80fc52

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure SCV_emg_adm_Two_out_of_three_points_near_to_the_UCL = ```
			
			
			VAR FilteredTable_ =
			    filter(ALLSELECTED(REF_Date),REF_Date[YearMonthIndex]>=1)
			
			VAR SummaryTable =
			    SUMMARIZE(
			        FilteredTable_,
			        REF_Date[financial_year],
			        REF_Date[month_name],
			        REF_Date[YearMonthIndex],
			        REF_Date[SPC_Flag],
			        "total_frail_emg_adm_per_1000", [total_frail_emg_adm_per_1000]
			    )
			
			VAR MeanValue = [SPC_average_total_frail_emg_adm_per_1000]
			
			VAR cumualitive_moving_average_value = divide([Emg_adm_moving_range],2.66)
			
			VAR UpperOuterThird = MeanValue +(2*(cumualitive_moving_average_value/1.128))
			
			VAR SummaryTableWithFlags =
			    ADDCOLUMNS(
			        SummaryTable,
			        "IsAboveUpperOuterThird",
			        IF([total_frail_emg_adm_per_1000] > UpperOuterThird, 1, 0),
			        "IsAboveMean",
			        IF([total_frail_emg_adm_per_1000] > MeanValue, 1, 0)
			    )
			
			VAR PatternTable =
			    ADDCOLUMNS(
			        SummaryTableWithFlags,
			        "PatternFlag",
			        VAR CurrentIndex = REF_Date[YearMonthIndex]
			        
			        // Check the range of two months behind the current month index
			        VAR CheckPrevRange =
			            CALCULATE(
			                SUMX(
			                    FILTER(
			                        SummaryTableWithFlags,
			                        REF_Date[YearMonthIndex] >= CurrentIndex - 2 &&
			                        REF_Date[YearMonthIndex] <= CurrentIndex
			                    ),
			                    [IsAboveUpperOuterThird]
			                )
			            )
			        
			        // Check the range of one month either side of the current month index
			        VAR CheckMidRange =
			            CALCULATE(
			                SUMX(
			                    FILTER(
			                        SummaryTableWithFlags,
			                        REF_Date[YearMonthIndex] >= CurrentIndex - 1 &&
			                        REF_Date[YearMonthIndex] <= CurrentIndex + 1
			                    ),
			                    [IsAboveUpperOuterThird]
			                )
			            )
			        
			        // Check the range of two months in front of the current month index
			        VAR CheckNextRange =
			            CALCULATE(
			                SUMX(
			                    FILTER(
			                        SummaryTableWithFlags,
			                        REF_Date[YearMonthIndex] >= CurrentIndex &&
			                        REF_Date[YearMonthIndex] <= CurrentIndex + 2
			                    ),
			                    [IsAboveUpperOuterThird]
			                )
			            )
			        
			        // Ensure all points in the previous range are above the mean
			        VAR CheckAllAboveMeanPrevRange =
			            CALCULATE(
			                SUMX(
			                    FILTER(
			                        SummaryTableWithFlags,
			                        REF_Date[YearMonthIndex] >= CurrentIndex - 2 &&
			                        REF_Date[YearMonthIndex] <= CurrentIndex
			                    ),
			                    [IsAboveMean]
			                )
			            )
			        
			        // Ensure all points in the middle range are above the mean
			        VAR CheckAllAboveMeanMidRange =
			            CALCULATE(
			                SUMX(
			                    FILTER(
			                        SummaryTableWithFlags,
			                        REF_Date[YearMonthIndex] >= CurrentIndex - 1 &&
			                        REF_Date[YearMonthIndex] <= CurrentIndex + 1
			                    ),
			                    [IsAboveMean]
			                )
			            )
			        
			        // Ensure all points in the next range are above the mean
			        VAR CheckAllAboveMeanNextRange =
			            CALCULATE(
			                SUMX(
			                    FILTER(
			                        SummaryTableWithFlags,
			                        REF_Date[YearMonthIndex] >= CurrentIndex &&
			                        REF_Date[YearMonthIndex] <= CurrentIndex + 2
			                    ),
			                    [IsAboveMean]
			                )
			            )
			        
			        RETURN
			            IF(
			                AND(
			                    [IsAboveUpperOuterThird] = 1,
			                    OR(
			                        AND(CheckPrevRange >= 2, CheckAllAboveMeanPrevRange = 3),
			                        OR(
			                            AND(CheckMidRange >= 2, CheckAllAboveMeanMidRange = 3),
			                            AND(CheckNextRange >= 2, CheckAllAboveMeanNextRange = 3)
			                        )
			                    )
			                ),
			                1,
			                0
			            )
			    )
			
			VAR AdditionalFlags =
			    SELECTCOLUMNS(
			        FILTER(
			            PatternTable,
			            [PatternFlag] = 1 
			        ),
			        "YearMonthIndex", REF_Date[YearMonthIndex]
			    )
			
			RETURN
			IF(
			    MIN(REF_Date[YearMonthIndex]) IN AdditionalFlags ,
			    [total_frail_emg_adm_per_1000],
			    BLANK()
			)
			```
