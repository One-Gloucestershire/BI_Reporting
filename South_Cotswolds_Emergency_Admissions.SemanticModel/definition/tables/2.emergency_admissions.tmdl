	measure SCV_emg_adm_per_1000_6_points_above_mean = ```
			
			
			VAR FilteredTable_ =
			    CALCULATETABLE(
			        REF_Date,
			        filter(ALLSELECTED(REF_Date),REF_Date[YearMonthIndex] >= 1)
			    )
			
			
			VAR SummaryTable =
			
			    SUMMARIZE(
			        FilteredTable_,
			        REF_Date[financial_year],
			        REF_Date[month_name],
			        REF_Date[YearMonthIndex],
			        REF_Date[SPC_Flag],
			        "total_frail_emg_adm_per_1000", [total_frail_emg_adm_per_1000]
			    )
			
			
			
			VAR LatestYearMonthIndex = MAX(REF_Date[YearMonthIndex])
			
			
			  VAR MeanValue = [SPC_average_total_frail_emg_adm_per_1000]
			   
			VAR SummaryTableWithCount =
			    ADDCOLUMNS(
			        SummaryTable,
			        "AboveMeanCount",
			        VAR CurrentYearMonthIndex = REF_Date[YearMonthIndex]
			        VAR CurrentLastSixMonths =
			            FILTER(
			                SummaryTable,
			                REF_Date[YearMonthIndex] <= CurrentYearMonthIndex &&
			                REF_Date[YearMonthIndex] > CurrentYearMonthIndex - 6
			            )
			        VAR CurrentAboveMeanCount =
			            COUNTROWS(
			                FILTER(
			                    CurrentLastSixMonths,
			                    [total_frail_emg_adm_per_1000] > MeanValue
			                )
			            )
			        RETURN IF(CurrentAboveMeanCount >= 6, 1, 0)
			    )
			
			VAR FlaggedYearMonthIndexes =
			    SELECTCOLUMNS(
			        FILTER(
			            SummaryTableWithCount,
			            [AboveMeanCount] = 1
			        ),
			        "YearMonthIndex", REF_Date[YearMonthIndex]
			    )
			
			VAR AdditionalFlags =
			    UNION(
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [YearMonthIndex] - 5),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [YearMonthIndex] - 4),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [YearMonthIndex] - 3),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [YearMonthIndex] - 2),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [YearMonthIndex] - 1),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [YearMonthIndex]),
			            "YearMonthIndex", [OffsetIndex]
			        )
			    )
			
			VAR FinalTable =
			    ADDCOLUMNS(
			        SummaryTableWithCount,
			        "AdditionalFlag",
			        IF(
			            REF_Date[YearMonthIndex] IN AdditionalFlags, 1, 0
			        )
			    )
			
			
			
			RETURN
			if(min(REF_Date[YearMonthIndex]) in  AdditionalFlags,[total_frail_emg_adm_per_1000],BLANK())
			```
		displayFolder: SPC - Emergency Admissions
		lineageTag: f96a9291-1ffc-4c64-8734-920dbe292462

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure SCV_emg_adm_per_1000_6_points_below_mean =
			
			
			VAR FilteredTable_ =
			    CALCULATETABLE(
			        REF_Date,
			       filter(ALLSELECTED(REF_Date),REF_Date[YearMonthIndex] >= 1)
			    )
			
			VAR SummaryTable =
			    SUMMARIZE(
			        FilteredTable_,
			        REF_Date[financial_year],
			        REF_Date[month_name],
			        REF_Date[YearMonthIndex],
			        REF_Date[SPC_Flag],
			        "total_frail_emg_adm_per_1000", [total_frail_emg_adm_per_1000]
			    )
			
			VAR LatestYearMonthIndex = MAX(REF_Date[YearMonthIndex])
			
			VAR MeanValue = [SPC_average_total_frail_emg_adm_per_1000]
			
			
			VAR SummaryTableWithCount =
			    ADDCOLUMNS(
			        SummaryTable,
			        "BelowMeanCount",
			        VAR CurrentYearMonthIndex = REF_Date[YearMonthIndex]
			        VAR CurrentLastSixMonths =
			            FILTER(
			                SummaryTable,
			                REF_Date[YearMonthIndex] <= CurrentYearMonthIndex &&
			                REF_Date[YearMonthIndex] > CurrentYearMonthIndex - 6
			            )
			        VAR CurrentAboveMeanCount =
			            COUNTROWS(
			                FILTER(
			                    CurrentLastSixMonths,
			                    [total_frail_emg_adm_per_1000] < MeanValue
			                )
			            )
			        RETURN IF(CurrentAboveMeanCount >= 6, 1, 0)
			    )
			
			VAR FlaggedYearMonthIndexes =
			    SELECTCOLUMNS(
			        FILTER(
			            SummaryTableWithCount,
			            [BelowMeanCount] = 1
			        ),
			        "YearMonthIndex", REF_Date[YearMonthIndex]
			    )
			
			VAR AdditionalFlags =
			    UNION(
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [YearMonthIndex] - 5),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [YearMonthIndex] - 4),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [YearMonthIndex] - 3),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [YearMonthIndex] - 2),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [YearMonthIndex] - 1),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [YearMonthIndex]),
			            "YearMonthIndex", [OffsetIndex]
			        )
			    )
			
			VAR FinalTable =
			    ADDCOLUMNS(
			        SummaryTableWithCount,
			        "AdditionalFlag",
			        IF(
			            REF_Date[YearMonthIndex] IN AdditionalFlags, 1, 0
			        )
			    )
			
			
			
			RETURN
			if(min(REF_Date[YearMonthIndex]) in  AdditionalFlags,[total_frail_emg_adm_per_1000],BLANK())
