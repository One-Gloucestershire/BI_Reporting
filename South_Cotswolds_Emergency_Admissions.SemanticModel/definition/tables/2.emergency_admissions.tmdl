	measure 'Emergency admissions Per 1000 frail population trend line' = ```
			
			 
			VAR Temp_Table =
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED( 'REF_Date'[financial_year], 'REF_Date'[financial_month],
			                         'REF_Date'[month_name], 'REF_Date'[month_number] ),
			            "Value_x", 'REF_Date'[month_number],
			            "Value_y", [total_frail_emg_adm_per_1000]
			        ),
			        AND (
			            NOT ( ISBLANK ( "Value_x" ) ),
			            NOT ( ISBLANK ( "Value_y" ) )
			        )
			    )
			 
			VAR LINESTX_Table =
			    LINESTX(Temp_Table, [Value_y], [Value_x], TRUE)
			VAR Slope =
			    MAXX ( LINESTX_Table, [Slope1] )
			VAR Intercept =
			    MAXX ( LINESTX_Table, [Intercept] )
			 
			RETURN
			    SUMX (
			        DISTINCT ( 'REF_Date'[month_number] ),
			        Intercept + Slope * 'REF_Date'[month_number]
			    )
			```
		lineageTag: 2afc0ea7-01d6-43e7-8590-4ea730d5c1e3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

