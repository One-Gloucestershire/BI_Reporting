		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Emg_adm_moving_range = ```
			
			VAR FilteredTable_ =
			    FILTER(
			        ALL(REF_Date),
			        REF_Date[YearMonthIndex] >= 1 && REF_Date[SPC_Flag] = 1
			    )
			
			VAR SummaryTable =
			    SUMMARIZE(
			        FilteredTable_,
			        REF_Date[financial_year],
			        REF_Date[month_name],
			        REF_Date[YearMonthIndex],
			        REF_Date[SPC_Flag],
			        "total_frail_emg_adm_per_1000", [total_frail_emg_adm_per_1000] --- CHANGE TO YOUR MEASURE 
			    )
			
			VAR SummaryTableWithDifference =
			    ADDCOLUMNS(
			        SummaryTable,
			        "Difference",
			        VAR CurrentYearMonthIndex = [YearMonthIndex]
			        VAR NextValue =
			            CALCULATE(
			                MINX(
			                    FILTER(
			                        SummaryTable,
			                        [YearMonthIndex] = CurrentYearMonthIndex + 1
			                    ),
			                    [total_frail_emg_adm_per_1000] --- change to your measure that you labelled in the SummaryTable above
			                )
			            )
			        RETURN IF(ISBLANK(NextValue), BLANK(),  abs([total_frail_emg_adm_per_1000] - NextValue))
			    )
			
			VAR Differences =
			    SELECTCOLUMNS(SummaryTableWithDifference, "Diff", [Difference])
			
			    VAR Cumulative_moving_range = (AVERAGEX(Differences, [Diff])) 
			
			RETURN Cumulative_moving_range *2.66
			```
		formatString: 0.00000
		displayFolder: SPC - Emergency Admissions
		lineageTag: 63ad5780-0eb7-4322-993b-fcd0934b0a42

	measure Confidence_Limits_Lower_Emg_adm_Mild_Frailty_Rate_per_1000 = ```
			VAR CountVariable = [mildly_frail_emg_adm]
			VAR DenominatorVariable = [Mild_frailty_population_end_of_each_fy]
			VAR ConfidenceLevel = 95
			VAR ScalingFactor = 1000
			// Approximate the Inverse of the Standard Normal Distribution
			VAR ApproxNORM_INV = 
			IF(
			 ConfidenceLevel = 95, 
			1.9599639845400500, // 95% confidence level
			 IF(
			 ConfidenceLevel = 90, 
			1.645, // 90% confidence level
			 1.28 // 80% confidence level as an example
			 )
			 )
			// Byars Calculation
			RETURN
			
			IFERROR(
			 IF(
			 CountVariable < 10, 
			IFERROR( (CHISQ.INV(1 - (0.5 + ConfidenceLevel / 200), 2 * CountVariable) / 2),
			 BLANK())
			 
			, CountVariable * (1 - 1 / (9 * CountVariable) - (ApproxNORM_INV / (3 * SQRT(CountVariable))))^3
			 )
			 / DenominatorVariable * ScalingFactor
			 ,BLANK()
			)
			
			
			
			    
			```
		displayFolder: Frail_Emergency_Adm_Rate_Per_1000_Confidence_Limits
		lineageTag: 938e7bd7-7d1d-4ffd-83b7-5783dc106c5e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Confidence_Limits_Upper_Emg_adm_Mild_Frailty_Rate_per_1000 = ```
			VAR CountVariable = [mildly_frail_emg_adm]
			VAR DenominatorVariable = [Mild_frailty_population_end_of_each_fy]
			VAR ConfidenceLevel = 95
			VAR ScalingFactor = 1000
			// Approximate the Inverse of the Standard Normal Distribution
			VAR ApproxNORM_INV = 
			IF(
			 ConfidenceLevel = 95, 
			1.9599639845400500, // 95% confidence level
			 IF(
			 ConfidenceLevel = 90, 
			1.645, // 90% confidence level
			 1.28 // 80% confidence level as an example
			 )
			 )
			// Byars Calculation for Upper Bound
			RETURN
			IFERROR(
			IF(
			 CountVariable < 10, 
			iferror( (CHISQ.INV(1 - (0.5 - ConfidenceLevel / 200), 2*CountVariable+2) / 2),
			 BLANK()), 
			(CountVariable + 1) * (1 - 1 / (9 * (CountVariable + 1)) + (ApproxNORM_INV / (3 * SQRT(CountVariable + 1))))^3
			) / DenominatorVariable * ScalingFactor
			,BLANK()
			)
			
			
			
			    
			```
