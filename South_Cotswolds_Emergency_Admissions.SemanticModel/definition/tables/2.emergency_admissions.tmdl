	measure total_frail_emg_adm_2025/26 = CALCULATE(DISTINCTCOUNT('2.emergency_admissions'[nhs_number]),FILTER('2.emergency_admissions','2.emergency_admissions'[efi_category] IN {"Mild Frailty","Moderate Frailty","Severe Frailty"}),FILTER('REF_Date','REF_Date'[financial_year] = "2025/26"),filter('2.emergency_admissions','2.emergency_admissions'[Emergency_Admission_flag] = 1))
		formatString: 0
		lineageTag: e14345d5-0a36-4517-86b5-e3b6f02fc171

	measure %_emg_adm_2025/26 =
			
			
			IF([total_frail_emg_adm_2025/26]<6,0, --SUPPRESSED
			IF(ISBLANK([total_frail_emg_adm_2025/26]/[total_frail_population_current]),"0%",[total_frail_emg_adm_2025/26]/[total_frail_population_current])
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 2692b17f-d04b-4280-81bf-65a4ceecab1f

