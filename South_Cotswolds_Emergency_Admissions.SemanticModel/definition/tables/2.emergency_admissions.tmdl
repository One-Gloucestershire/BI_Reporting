	measure SCV_emg_adm_per_1000_increasing_trend = ```
			
			VAR FilteredTable_ =
			   filter(ALLSELECTED(REF_Date),REF_Date[YearMonthIndex] >= 1)
			
			VAR SummaryTable =
			    SUMMARIZE(
			        FilteredTable_,
			        REF_Date[financial_year],
			        REF_Date[month_name],
			        REF_Date[YearMonthIndex],
			        REF_Date[SPC_Flag],
			        "total_frail_emg_adm_per_1000", [total_frail_emg_adm_per_1000]
			    )
			
			VAR SummaryTableWithDifference =
			    ADDCOLUMNS(
			        SummaryTable,
			        "Difference",
			        VAR CurrentYearMonthIndex = REF_Date[YearMonthIndex]
			        VAR NextValue =
			            CALCULATE(
			                MAXX(
			                    FILTER(
			                        SummaryTable,
			                        REF_Date[YearMonthIndex] = CurrentYearMonthIndex + 1
			                    ),
			                    [total_frail_emg_adm_per_1000]
			                )
			            )
			        RETURN NextValue - [total_frail_emg_adm_per_1000]
			    )
			
			VAR SummaryTableWithIncreasingFlag =
			    ADDCOLUMNS(
			        SummaryTableWithDifference,
			        "IncreasingFlag",
			        IF([Difference] > 0, 1, 0)
			    )
			
			VAR IncreasingSequence =
			    FILTER(
			        ADDCOLUMNS(
			            SummaryTableWithIncreasingFlag,
			            "IncreasingSequence",
			            VAR CurrentYearMonthIndex = REF_Date[YearMonthIndex]
			            VAR IncreasingCount =
			                COUNTROWS(
			                    FILTER(
			                        SummaryTableWithIncreasingFlag,
			                        REF_Date[YearMonthIndex] >= CurrentYearMonthIndex &&
			                        REF_Date[YearMonthIndex] <= CurrentYearMonthIndex + 4 &&
			                        [IncreasingFlag] = 1
			                    )
			                )
			            RETURN 
			            
			            IF(IncreasingCount =5, 1, 0) -- Adjust the number of periods for your trend
			        ),
			        [IncreasingSequence] = 1
			    )
			
			
			VAR AdditionalFlags =
			   UNION(
			        
			
			   
			              SELECTCOLUMNS(
			            ADDCOLUMNS(IncreasingSequence, "OffsetIndex", [YearMonthIndex] + 5),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			   
			
			              SELECTCOLUMNS(
			            ADDCOLUMNS(IncreasingSequence, "OffsetIndex", [YearMonthIndex] + 4),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			   
			        SELECTCOLUMNS(
			            ADDCOLUMNS(IncreasingSequence, "OffsetIndex", [YearMonthIndex] + 3),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(IncreasingSequence, "OffsetIndex", [YearMonthIndex] + 2),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(IncreasingSequence, "OffsetIndex", [YearMonthIndex] + 1),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(IncreasingSequence, "OffsetIndex", [YearMonthIndex]),
			            "YearMonthIndex", [OffsetIndex]
			        )
			    )
			
			
			
			    
			RETURN
			IF(
			    MIN(REF_Date[YearMonthIndex]) IN AdditionalFlags,
			    [total_frail_emg_adm_per_1000],
			    BLANK()
			)
