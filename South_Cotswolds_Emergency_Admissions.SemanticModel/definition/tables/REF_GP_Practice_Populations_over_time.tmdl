	partition REF_GP_Practice_Populations_over_time-3b9bd41f-4e8e-4093-bdac-9292b9e34415 = m
		mode: import
		queryGroup: 'Reference Tables'
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "CCG_Reference", [Query="----------------------------------#(lf)-------- POPULATION TABLE --------#(lf)----------------------------------#(lf)#(lf)SELECT #(lf)Census_Date#(lf),Derived_NHS_Number#(lf),[Practice_Code] = gp.PrimaryCareProvider#(lf),Age_at_census#(lf),LSOA#(lf),Ethnicity_code#(lf),Gender#(lf),efi_category#(lf),QOF_Dementia_Flag#(lf),living_in_a_care_home#(lf),Core20Flag#(lf),Smoking_Flag#(lf),[mild_frailty] = case when efi_category = 'Mild Frailty' then 1 END #(lf),[moderate_frailty] = case when efi_category = 'Moderate Frailty' then 1 END#(lf),[severe_frailty] = case when efi_category = 'Severe Frailty' then 1 END#(lf)#(lf)#(lf)#(lf)FROM PowerBI_Reporting.AgeingWell.tbl02_Proactive_Whiteboard_Registered_Population_Over_Time as gp#(lf)left join CCG_Reference.Reference.vw_GPPractice as gp_ref on GP.PrimaryCareProvider = gp_ref.OrganisationCode#(lf)#(lf)WHERE cast(gp.Age_at_census as int) >= 65#(lf)and cast(gp.Census_Date as date) between '2021-04-01' and  DATEADD(MONTH, DATEDIFF(MONTH, 0, GETDATE()) - 2, 0) -- gets the start date of 2 months ago #(lf)and gp.Derived_Registered_CCG like '11M%'#(lf)#(lf)order by gp.Census_Date,gp.Age_at_census#(lf)#(lf)"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

