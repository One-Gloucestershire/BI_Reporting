			calculate(DISTINCTCOUNT(REF_GP_Practice_Populations_over_time[Derived_NHS_Number])
			,all(REF_Date)
			,REF_GP_Practice_Populations_over_time[Census_Date] = previous_census_date_in_population_)
			
			RETURN
			
			if(GP_population<6,0, --supressed
			
			if(isblank(GP_population),0,GP_population)
			
			)
			```
		formatString: 0
		lineageTag: 00d97c85-7005-4ede-ae82-c0900362009a

