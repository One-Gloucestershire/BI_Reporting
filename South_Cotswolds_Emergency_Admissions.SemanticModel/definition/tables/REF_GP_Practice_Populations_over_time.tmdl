				,REMOVEFILTERS(REF_Site)
				,REMOVEFILTERS(REF_Providers)
			--,REMOVEFILTERS(REF_Frail_Patients_Deficits)
			        )
			        ,
			         
			        "Reference_Population",   ---set your number for reference population i.e. total Gloucestershire population 
			          
			        var latest_month_in_range = STARTOFMONTH(LASTDATE(REF_Date[date]))
			        var Gloucestershire_moderate_fail_populations_at_year_end = 
			        calculate([Total_65+_Population_ot]
			        ,REF_Date[date] = latest_month_in_range
			   ,REMOVEFILTERS(REF_GP_Practice)
