	measure previous_census_in_population_over_time_dataset =
			
			VAR latest_date_in_dataset = CALCULATE(
			    MAX(REF_GP_Practice_Populations_over_time[Census_Date]),
			    ALL(REF_GP_Practice_Populations_over_time)
			)
			VAR previous_month_end_date = EOMONTH(latest_date_in_dataset, -1)
			VAR previous_month_in_dataset = CALCULATE(
			    MAX(REF_GP_Practice_Populations_over_time[Census_Date]),
			    REF_GP_Practice_Populations_over_time[Census_Date] <= previous_month_end_date,
			    REF_GP_Practice_Populations_over_time[Census_Date] >= EOMONTH(previous_month_end_date, -1) + 1
			)
			RETURN previous_month_in_dataset
		formatString: MMMM YYYY
		lineageTag: 61b4c215-ef0c-41ec-9547-55f01790a0bc

		annotation PBI_FormatHint = {"isCustom":true}

	measure GP_population_65+_previous_census = ```
			
			Var previous_census_date_in_population_ = [previous_census_in_population_over_time_dataset]
