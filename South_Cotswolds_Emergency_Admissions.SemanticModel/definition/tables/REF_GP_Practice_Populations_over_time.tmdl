	measure dementia_current =
			
			
			var latest_census_date = [Latest_census_in_population_over_time_dataset]
			RETURN
			IF( CALCULATE(SUM(REF_GP_Practice_Populations_over_time[QOF_Dementia_Flag])
			 ,REF_GP_Practice_Populations_over_time[Census_Date] = latest_census_date
			 ,all(ref_date)
			 )<6,0, -- suppressed
			
			
			 CALCULATE(SUM(REF_GP_Practice_Populations_over_time[QOF_Dementia_Flag])
			 ,REF_GP_Practice_Populations_over_time[Census_Date] = latest_census_date
			 ,all(ref_date)
			 )
			
