table Extract
	lineageTag: 65e6a800-13ad-4bde-93c9-44dadac2a5c0

	measure TotalAntibiotics = Sum('Extract'[AntibioticAndTreatment])+Sum('Extract'[AntibioticNoTreatment])
		lineageTag: 572d8184-194f-4bec-8615-10fa2029e7d7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Antibiotics %' = [TotalAntibiotics]/sum('Extract'[AppointmentsBooked])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 963db6e7-b5fa-4fca-8af2-216af60e96e4

	measure 'Antibiotics % Last Year' = CALCULATE([Antibiotics %], SAMEPERIODLASTYEAR('Extract'[ReportingMonth]))
		lineageTag: c6e6ecc6-6980-41b0-9681-2267701a173d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Antibiotics % Latest Month' =
			
			VAR latestmonth = MONTH(MAX('Extract'[ReportingMonth]) )
			RETURN
			CALCULATE([Antibiotics %], FILTER('Extract', MONTH('Extract'[ReportingMonth]) = latestmonth ))
		lineageTag: 2d862274-d9cc-4f27-bc54-d0223fd7d2a0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Antibiotics % Prev Month' = CALCULATE([Antibiotics %], DATEADD('Extract'[ReportingMonth], -1, MONTH) )
		lineageTag: 8978b9f8-951f-454a-a393-7d58320d449f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Extractions %'
		lineageTag: de859f59-fc7b-4ad7-8f01-c32da2597f64

