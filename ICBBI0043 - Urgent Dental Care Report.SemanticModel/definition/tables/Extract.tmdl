	partition Extract = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "bireports", [Query="SELECT [UDC].*,#(lf)[Month] = LEFT([D].[MonthName],3),#(lf)[FinancialYear] = [D].[FinancialYear],#(lf)[FinancialMonth] = [D].[FinancialMonth]#(lf)FROM [BIReports].[dbo].[UrgentDentalCare] [UDC]#(lf)#(lf)#(tab)LEFT JOIN [CCG_Reference].[Reference].[vw_DateLookup] AS [D]#(lf)#(tab)ON [D].[Date] = CAST([UDC].[ReportingMonth] AS DATE)#(lf)"]),
				    #"Renamed Columns" = Table.RenameColumns(Source,{{"AntibioticPrescriptionIssuesFurtherTreatmentGiven", "AntibioticAndTreatment"}, {"AntibioticPrescriptionIssuesNoOtherTreatmentGiven", "AntibioticNoTreatment"}}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Renamed Columns",{{"FinancialMonth", Int64.Type}}),
				    #"Added Conditional Column" = Table.AddColumn(#"Changed Type", "Provider Number", each if Text.Contains([ProviderName], "Bupa") then "Provider 1" else if Text.Contains([ProviderName], "Genix") then "Provider 3" else if Text.Contains([ProviderName], "Central") then "Provider 2" else if Text.Contains([ProviderName], "Tuffley") then "Provider 4" else "Not Recorded")
				in
				    #"Added Conditional Column"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

