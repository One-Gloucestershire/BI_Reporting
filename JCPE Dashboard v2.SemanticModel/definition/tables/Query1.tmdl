	measure Arrows_PrevMonth_DividedValues =
			
			VAR Latest_Value_High = CALCULATE(SUM('Query1'[Numerator])/sum(Query1[Denominator]),'Query1'[Latest Month Flag] = 1,'Query1'[Good Is]="High")
			VAR Previous_Value_High = CALCULATE(SUM('Query1'[Numerator])/sum(Query1[Denominator]),'Query1'[Last Month Flag] = 1,'Query1'[Good Is]="High")
			VAR Latest_Value_Low = CALCULATE(SUM('Query1'[Numerator])/sum(Query1[Denominator]),'Query1'[Latest Month Flag] = 1,'Query1'[Good Is]="Low")
			VAR Previous_Value_Low = CALCULATE(SUM('Query1'[Numerator])/sum(Query1[Denominator]),'Query1'[Last Month Flag] = 1,'Query1'[Good Is]="Low")
			
			RETURN
			
			IF(Latest_Value_High>Previous_Value_High,UNICHAR(UNICODE("↑")),
			IF(Latest_Value_High<Previous_Value_High,UNICHAR(UNICODE("↓")),
			IF(Latest_Value_Low>Previous_Value_Low,UNICHAR(UNICODE("↑")),
			IF(Latest_Value_Low<Previous_Value_Low,UNICHAR(UNICODE("↓")),""))))
		lineageTag: 8389ab72-9c2e-4172-b24a-199599cb7f93

	measure Arrows_Colour_PrevMonth_DividedValues =
			
			VAR Latest_Value_High = CALCULATE(SUM('Query1'[Numerator])/sum(Query1[Denominator]),'Query1'[Latest Month Flag] = 1,'Query1'[Good Is]="High")
			VAR Previous_Value_High = CALCULATE(SUM('Query1'[Numerator])/sum(Query1[Denominator]),'Query1'[Last Month Flag] = 1,'Query1'[Good Is]="High")
			VAR Latest_Value_Low = CALCULATE(SUM('Query1'[Numerator])/sum(Query1[Denominator]),'Query1'[Latest Month Flag] = 1,'Query1'[Good Is]="Low")
			VAR Previous_Value_Low = CALCULATE(SUM('Query1'[Numerator])/sum(Query1[Denominator]),'Query1'[Last Month Flag] = 1,'Query1'[Good Is]="Low")
			
			RETURN
			
			IF(Latest_Value_High>Previous_Value_High,"#78BE20",
			IF(Latest_Value_High<Previous_Value_High,"#AE2424",
			IF(Latest_Value_Low>Previous_Value_Low,"#AE2424",
			IF(Latest_Value_Low<Previous_Value_Low,"#78BE20"))))
