	column 'H&H Care Hours YTD' = ```
			
			VAR current_month = MONTH('H@H quarterly care hours SP'[Month])
			VAR f_current_month = SWITCH(TRUE(),
			current_month = 4, 1,
			current_month = 5, 2,
			current_month = 6, 3,
			current_month = 7, 4,
			current_month = 8, 5,
			current_month = 9, 6,
			current_month = 10, 7,
			current_month = 11, 8,
			current_month = 12, 9,
			current_month = 1, 10,
			current_month = 2, 11,
			current_month = 3, 12
			)
			VAR max_month = CALCULATE(MONTH(MAX('H@H quarterly care hours SP'[Month])), ALLEXCEPT('H@H quarterly care hours SP','H@H quarterly care hours SP'[Provider]))
			VAR f_max_month = SWITCH(TRUE(),
			max_month = 4, 1,
			max_month = 5, 2,
			max_month = 6, 3,
			max_month = 7, 4,
			max_month = 8, 5,
			max_month = 9, 6,
			max_month = 10, 7,
			max_month = 11, 8,
			max_month = 12, 9,
			max_month = 1, 10,
			max_month = 2, 11,
			max_month = 3, 12
			)
			return if(f_current_month <= f_max_month, "Year to Date", "Not Year to Date")
			
			```
		lineageTag: 090eedbf-cfa1-4ffe-8eb6-58ba64edc283
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

