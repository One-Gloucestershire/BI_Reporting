table 'Patient Carer services SP'
	lineageTag: f15a2827-3ff5-4aed-b1bc-e8a3d3fa79b8

	measure counter_small_number_suppression_pcs = if(DISTINCTCOUNT('Patient Carer services SP'[patient_id])<5,"<5",DISTINCTCOUNT('Patient Carer services SP'[patient_id]))
		formatString: 0
		lineageTag: 4c5051f3-1c7e-49db-9f35-0c4d0fd96557

		annotation PBI_FormatHint = {"isDecimal":true}

	measure distinct_patients = ```
			DISTINCTCOUNT('Patient Carer services SP'[patient_id]) 
			```
		formatString: 0
		lineageTag: c368a9f3-093f-4db9-b99f-9bc81e35f8c5

	measure practice_%_of_total_pcs =
			DIVIDE(
			                            CALCULATE(
			                                COUNT('Patient Carer services SP'[Practice])
			                            ),
			                            CALCULATE(
			                                COUNT('Patient Carer services SP'[Practice]),
			                                ALL('Patient Carer services SP')
			                                )
			                            )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f7c35591-5281-4483-a707-ae7b98ffa4b2

	measure %_of_total_pcs = ```
			
			        divide(
			            distinctcount('Patient Carer services SP'[patient_id]),
			                calculate(
			                    distinctcount('Patient Carer services SP'[patient_id]),
			                    allselected('Patient Carer services SP')
			                    ))
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: bb9d03c6-8769-4c84-b697-ac02a70e7468

	measure Average_PCS_activity =
			
			--CALCULATE('pat_care_services'[distinct_patients] / [Date Diff])
			--CALCULATE((AVERAGEX(
			--	KEEPFILTERS(VALUES('date_table'[day_month_year])),
			--	CALCULATE(DISTINCTCOUNT('pat_care_services'[nhs_number])) +0)  ))
			CALCULATE('Patient Carer services SP'[distinct_patients] /CALCULATE(SUM('REF date_table'[Counter]))) +0
		lineageTag: 3371c4b9-de92-4032-b9e7-85dc5248265c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'PCS Patients Rate per 1000 - By Month' =
			
			
			VAR PCS = CALCULATE ( 'Patient Carer services SP'[distinct_patients] )
			VAR POP = CALCULATE ( SUM ( 'REF Population'[population] ) )
			
			RETURN (PCS/POP*1000)
		lineageTag: 2a999c80-bd30-4e20-b0a2-8aee90a17129

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'PCS Patients - By Year' =
			
			
			VAR PCS = CALCULATE ( 'Patient Carer services SP'[distinct_patients]  )
			VAR POP = CALCULATE ( SUM ( 'REF Population'[population]  ) )
			RETURN (PCS/POP*1000)
		lineageTag: 65ef0250-534e-4b66-b119-f9f9cf19609f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'DNA % of Non-Cancelled Appointments' =
			IFERROR(
			    CALCULATE(SUM('Patient Carer services SP'[total_dna_appointments])) / CALCULATE(SUM('Patient Carer services SP'[Total Non-Cancelled Appointments])), BLANK())
		formatString: 0.000%;-0.000%;0.000%
		lineageTag: 8dc5e662-3e92-45c8-afa6-9acdd44a54e9

	measure 'Total Average PCS' =
			
			
			var max_date = ENDOFMONTH('Patient Carer services SP'[referral_date])
			var min_date = STARTOFMONTH('Patient Carer services SP'[Referral_Date])
			var diff = DATEDIFF(min_date, max_date, DAY) +1
			var total_hours = DISTINCTCOUNT('Patient Carer services SP'[nhs_number])
			RETURN total_hours / diff
		lineageTag: c0670850-8414-4bac-b8d0-c725b0e98444

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Date Diff' = DATEDIFF(MAX('Patient Carer services SP'[min_date]), MAX('Patient Carer services SP'[max_date]), DAY) +1
		formatString: 0
		lineageTag: 20c1729e-7b96-4754-a4d1-16b184cd7463

