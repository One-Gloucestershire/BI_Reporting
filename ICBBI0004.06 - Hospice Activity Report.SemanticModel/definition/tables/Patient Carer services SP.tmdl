	column 'PCS YTD' =
			
			VAR current_month = MONTH('Patient Carer services SP'[referral_date])
			VAR f_current_month = SWITCH(TRUE(),
			current_month = 4, 1,
			current_month = 5, 2,
			current_month = 6, 3,
			current_month = 7, 4,
			current_month = 8, 5,
			current_month = 9, 6,
			current_month = 10, 7,
			current_month = 11, 8,
			current_month = 12, 9,
			current_month = 1, 10,
			current_month = 2, 11,
			current_month = 3, 12
			)
			VAR max_month = CALCULATE(MONTH(MAX('Patient Carer services SP'[referral_date])),ALLEXCEPT('Patient Carer services SP','Patient Carer services SP'[Provider]))
			VAR f_max_month = SWITCH(TRUE(),
			max_month = 4, 1,
			max_month = 5, 2,
			max_month = 6, 3,
			max_month = 7, 4,
			max_month = 8, 5,
			max_month = 9, 6,
			max_month = 10, 7,
			max_month = 11, 8,
			max_month = 12, 9,
			max_month = 1, 10,
			max_month = 2, 11,
			max_month = 3, 12
			)
			return if(f_current_month <= f_max_month, "Year to Date", "Not Year to Date")
		lineageTag: 858fbf09-9e94-4fbd-a7ca-fdc2a407e115
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Total Cancelled Appointments' = ```
			IF(
			    'Patient Carer services SP'[total_booked_appointments] - ('Patient Carer services SP'[total_attended_appointments] + 'Patient Carer services SP'[total_dna_appointments]) < 0, BLANK(), 
			    'Patient Carer services SP'[total_booked_appointments] - ('Patient Carer services SP'[total_attended_appointments] + 'Patient Carer services SP'[total_dna_appointments]))
			```
		lineageTag: 91883179-87af-4712-a3ef-fc78378ffa71
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Total Non-Cancelled Appointments' = 'Patient Carer services SP'[total_attended_appointments] + 'Patient Carer services SP'[total_dna_appointments]
