		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Reference", [Query="#(lf)SET ANSI_WARNINGS OFF#(lf)SET NOCOUNT ON#(lf)if object_id ('tempdb..#FY_flag') is not null drop table #FY_flag#(lf)#(lf)SELECT distinct#(lf)#(lf)[Financial_year_abridged] = SUBSTRING([FinancialYear], 1, 4)#(lf)#(lf),[Current_FY] = case when cast(getdate() as date) = date then FinancialYear END#(lf),financialyear#(lf)#(lf)INTO #FY_flag #(lf)#(lf)FROM [CCG_Reference].[Reference].[vw_DateLookup]#(lf)#(lf)ORDER BY FinancialYear#(lf)#(lf)if object_id ('tempdb..#FY_flag_2') is not null drop table #FY_flag_2#(lf)#(lf)SELECT #(lf)#(lf)[Financial_year_abridged] #(lf),[Current_FY] #(lf),financialyear#(lf),[Last_FY]#(lf)#(lf)INTO #FY_flag_2#(lf)#(lf)FROM #FY_flag#(lf)#(lf)LEFT JOIN#(lf)(SELECT DISTINCT#(lf)[FY_abridged] = SUBSTRING([FinancialYear], 1, 4)#(lf),[Last_FY] = financialyear#(lf)FROM [CCG_Reference].[Reference].[vw_DateLookup]) AS [B] ON [FY_abridged] = [Financial_year_abridged] - 1#(lf)#(lf)WHERE [Current_FY] IS NOT NULL#(lf)#(lf)ORDER BY financialyear#(lf)#(lf)select [Date] [date]#(lf)      ,[DayMonthYear] [day_month_year]#(lf)      ,[Day] [day]#(lf)      ,[Weekday] [weekday]#(lf)      ,[WeekDayName] [weekday_name]#(lf)      ,[Month] [month]#(lf)      ,left([MonthName],3) [month_name]#(lf)      ,[Quarter] [quarter]#(lf)      ,[YearMonth] [year_month]#(lf)      ,[IsWeekend] [is_weekend]#(lf)      ,[IsHoliday] [is_holiday]#(lf)      ,[FinancialWeekofYear] [financial_week_of_year]#(lf)      ,[A].[FinancialYear] [financial_year]#(lf)      ,[FinancialQuarter] [financial_quarter]#(lf)      ,[FinancialMonth] [financial_month]#(lf)      ,[financial_quarter_name] = case#(tab)when [FinancialQuarter] like 1 then 'Quarter 1'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when [FinancialQuarter] like 2 then 'Quarter 2'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when [FinancialQuarter] like 3 then 'Quarter 3'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when [FinancialQuarter] like 4 then 'Quarter 4'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)END#(lf)#(tab),[year_quarter] = concat(substring([A].[FinancialYear],3,2), substring([A].[FinancialYear],6,2), [FinancialQuarter])#(lf)#(tab)#(lf)#(tab),[financial_quarter_counter] = dense_rank() over (order by concat(substring([A].[FinancialYear],3,2), substring([A].[FinancialYear],6,2), [FinancialQuarter]))#(lf)#(lf)#(tab),[ytd_flag] = CASE WHEN [FinancialMonth] <= (#(lf)                                           SELECT#(lf)                                           CAST([FinancialMonth] AS INT)#(lf)                                           FROM [CCG_Reference].[Reference].[vw_DateLookup]#(lf)                                           WHERE [Date] = EOMONTH(DATEADD(MONTH, -4, GETDATE()))#(lf)                                           )#(lf)                                           THEN 1 ELSE 0 END#(lf)#(tab) ,[ytd_description] = CASE WHEN [FinancialMonth] <= (#(lf)                                           SELECT#(lf)                                           CAST([FinancialMonth] AS INT)#(lf)                                           FROM [CCG_Reference].[Reference].[vw_DateLookup]#(lf)                                           WHERE [Date] = EOMONTH(DATEADD(MONTH, -4, GETDATE()))#(lf)                                           )#(lf)                                           THEN 'Year to Date' ELSE '' END#(lf)#(tab),[B].[Current_FY]#(lf)#(tab),[C].[Last_FY]#(lf)#(tab),[Current_FY_Flag] = case when [B].[Current_FY] = [A].[FinancialYear] then 1 else 0 END#(lf)#(tab),[Last_FY_Flag] = case when [C].[Last_FY] = [A].[FinancialYear] then 1 else 0 END#(lf)#(lf)from [CCG_Reference].[Reference].[vw_DateLookup] [A]#(lf)#(lf)LEFT JOIN #FY_flag_2 [B] ON [A].[FinancialYear] = [B].[FinancialYear]#(lf)#(lf)LEFT JOIN #FY_flag_2 [C] ON [A].[FinancialYear] = [C].[Last_FY]#(lf)#(lf)where [Date] >= '20190401'#(lf)and [Date] <= EOMONTH(DATEADD(MONTH, -1, GETDATE()))#(lf)#(lf)order by date#(lf)#(lf)#(lf)"]),
