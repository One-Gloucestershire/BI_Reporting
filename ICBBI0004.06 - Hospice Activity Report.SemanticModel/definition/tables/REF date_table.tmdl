	column 'School Holiday Flag' =
			
			SWITCH(TRUE(),
			'REF date_table'[date] >= VALUE("30/10/2023") && 'REF date_table'[date] <= VALUE("05/11/2023"), 1,
			'REF date_table'[date] >= VALUE("25/12/2023") && 'REF date_table'[date] <= VALUE("07/01/2024"), 1,
			'REF date_table'[date] >= VALUE("12/02/2024") && 'REF date_table'[date] <= VALUE("18/02/2024"), 1,
			'REF date_table'[date] >= VALUE("25/03/2024") && 'REF date_table'[date] <= VALUE("07/04/2024"), 1,
			'REF date_table'[date] >= VALUE("27/05/2024") && 'REF date_table'[date] <= VALUE("02/06/2024"), 1,
			'REF date_table'[date] >= VALUE("23/07/2024") && 'REF date_table'[date] <= VALUE("01/09/2024"), 1,
			0)
		formatString: 0
		lineageTag: 14bb91a5-3029-4b26-92c8-0e59ec9d3489
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

