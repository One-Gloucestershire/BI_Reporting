	measure '< 18 weeks arrow' =
			SWITCH(TRUE,
			RTT[% < 18 Weeks Variance] > 0, UNICHAR(8593),
			RTT[% < 18 Weeks Variance] < 0, UNICHAR(8595),
			UNICHAR(9640))
		lineageTag: 5de9bdc8-abf6-4db4-9b35-35fb49c18d66

		changedProperty = IsHidden

	measure '65 weeks arrow' =
			SWITCH(TRUE,
			RTT[No. 65+ Weeks Variance] < 0, UNICHAR(9650),
