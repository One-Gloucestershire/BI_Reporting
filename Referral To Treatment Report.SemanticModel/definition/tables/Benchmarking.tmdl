	measure Gloucestershire = CALCULATE(SUM(Benchmarking[0-18 Weeks])/SUM(Benchmarking[Total_All]), filter(Benchmarking, Benchmarking[Benchmarking_Organisation_Name] = "Gloucestershire ICB"))
