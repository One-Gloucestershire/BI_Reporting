table Benchmarking
	lineageTag: 1c80dabe-8245-4262-97ab-04dc195cfc78

	measure 'South West Benchmarking 0-18 Weeks' = ```
			CALCULATE(SUM(Benchmarking[0-18 Weeks]), Benchmarking[Benchmarking_SouthWest] <> "") 
			```
		formatString: #,0
		lineageTag: 2802416f-4dcd-46ec-a11c-a8a96ea0d616

