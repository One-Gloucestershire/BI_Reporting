table Pupils
lineageTag: pup1ls-0000-4b00-9c00-900000000001

measure 'Total Pupils (latest year)' = 
VAR lp = CALCULATE ( MAX ( Pupils[period_year] ), ALL ( Pupils ) )
RETURN CALCULATE ( SUM ( Pupils[total_pupils] ), Pupils[period_year] = lp )
formatString: #,0

measure 'FSM Eligible % (latest)' = 
VAR lp = CALCULATE ( MAX ( Pupils[period_year] ), ALL ( Pupils ) )
RETURN CALCULATE ( AVERAGE ( Pupils[fsm_eligible_pct] ), Pupils[period_year] = lp )
formatString: 0.0%

measure 'SEND Support % (latest)' = 
VAR lp = CALCULATE ( MAX ( Pupils[period_year] ), ALL ( Pupils ) )
RETURN CALCULATE ( AVERAGE ( Pupils[send_support_pct] ), Pupils[period_year] = lp )
formatString: 0.0%

