table Weather
lineageTag: w34th3r-0000-4b00-9c00-900000000001

measure 'Latest Max Temp C' = 
VAR lp = CALCULATE ( MAX ( Weather[date] ), ALL ( Weather ) )
RETURN CALCULATE ( MAX ( Weather[temp_max_c] ), Weather[date] = lp )
formatString: 0.0

measure 'Heatwave Days (YTD)' = CALCULATE ( COUNTROWS ( FILTER ( Weather, Weather[is_heatwave_day] = 1 ) ) )
formatString: #,0

measure 'Cold Snap Days (YTD)' = CALCULATE ( COUNTROWS ( FILTER ( Weather, Weather[is_cold_snap_day] = 1 ) ) )
formatString: #,0

column area_code
dataType: string
lineageTag: w34th3r-0000-4b00-9c00-900000000002
summarizeBy: none
sourceColumn: area_code

column date
