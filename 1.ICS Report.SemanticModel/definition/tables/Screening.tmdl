table Screening
lineageTag: scr33n1ng-0000-4b00-9c00-900000000001

measure 'Latest Coverage %' = 
VAR lp = CALCULATE ( MAX ( Screening[period_year] ), ALL ( Screening ) )
RETURN CALCULATE ( AVERAGE ( Screening[coverage_pct] ), Screening[period_year] = lp )
formatString: 0.0%

measure 'Screening Coverage (Glos latest)' = 
VAR lp = CALCULATE ( MAX ( Screening[period_year] ), ALL ( Screening ) )
RETURN CALCULATE ( AVERAGE ( Screening[coverage_pct] ), Screening[area_code] = "Gloucestershire", Screening[period_year] = lp )
formatString: 0.0%

column area_code
dataType: string
lineageTag: scr33n1ng-0000-4b00-9c00-900000000002
summarizeBy: none
sourceColumn: area_code

column programme
dataType: string
lineageTag: scr33n1ng-0000-4b00-9c00-900000000003
summarizeBy: none
sourceColumn: programme

column age_band
dataType: string
lineageTag: scr33n1ng-0000-4b00-9c00-900000000004
summarizeBy: none
sourceColumn: age_band

column period_year
dataType: string
lineageTag: scr33n1ng-0000-4b00-9c00-900000000005
summarizeBy: none
sourceColumn: period_year

column coverage_pct
