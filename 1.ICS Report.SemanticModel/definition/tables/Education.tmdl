table Education
	lineageTag: 1f9c0a00-0000-4b00-9c00-9000000000495

	measure 'Attainment 8' = SUM ( Education[attainment8_average] )
		formatString: 0.0
		lineageTag: 1f9c0a00-0000-4b00-9c00-9000000000496

	measure 'Persistent Absence %' = SUM ( Education[persistent_absence_pct] )
		formatString: 0.0\%
		lineageTag: 1f9c0a00-0000-4b00-9c00-9000000000497

	measure 'Severe Absence %' = SUM ( Education[severe_absence_pct] )
		formatString: 0.0\%
		lineageTag: 1f9c0a00-0000-4b00-9c00-9000000000498

	measure 'Attainment 8 (Glos)' = CALCULATE ( SUM ( Education[attainment8_average] ), Education[area] = "Gloucestershire" )
		formatString: 0.0
		lineageTag: 1f9c0a00-0000-4b00-9c00-9000000000505

	measure 'Attainment 8 (England)' = CALCULATE ( SUM ( Education[attainment8_average] ), Education[area] = "England" )
		formatString: 0.0
		lineageTag: 1f9c0a00-0000-4b00-9c00-9000000000506

	measure 'Persistent Absence % (Glos)' = CALCULATE ( SUM ( Education[persistent_absence_pct] ), Education[area] = "Gloucestershire" )
		formatString: 0.0\%
		lineageTag: 1f9c0a00-0000-4b00-9c00-9000000000507

	measure 'Persistent Absence % (England)' = CALCULATE ( SUM ( Education[persistent_absence_pct] ), Education[area] = "England" )
		formatString: 0.0\%
		lineageTag: 1f9c0a00-0000-4b00-9c00-9000000000508

	measure 'Glos Attainment 8 (latest)' =
			VAR lp = CALCULATE ( MAX ( Education[time_period] ), ALL ( Education ) )
			RETURN CALCULATE ( SUM ( Education[attainment8_average] ), Education[area] = "Gloucestershire", Education[time_period] = lp )
		formatString: 0.0
		lineageTag: 1f9c0a00-0000-4b00-9c00-9000000000509

	measure 'England Attainment 8 (latest)' =
			VAR lp = CALCULATE ( MAX ( Education[time_period] ), ALL ( Education ) )
			RETURN CALCULATE ( SUM ( Education[attainment8_average] ), Education[area] = "England", Education[time_period] = lp )
		formatString: 0.0
		lineageTag: 1f9c0a00-0000-4b00-9c00-9000000000510

	column area
		dataType: string
		lineageTag: 1f9c0a00-0000-4b00-9c00-9000000000499
