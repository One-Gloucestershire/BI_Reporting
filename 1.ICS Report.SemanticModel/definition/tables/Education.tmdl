	partition Education = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "select area, geographic_level, time_period, attainment8_average, persistent_absence_pct, severe_absence_pct from db03_pid.data_mart_l050_phm_rpt.education_la", null, [EnableFolding=true])
				in
