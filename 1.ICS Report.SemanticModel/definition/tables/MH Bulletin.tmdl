table 'MH Bulletin'
lineageTag: mhbull3t1n-0000-4b00-9c00-900000000001

measure 'Latest MH Rate per 100k' = 
VAR lp = CALCULATE ( MAX ( 'MH Bulletin'[period] ), ALL ( 'MH Bulletin' ) )
RETURN CALCULATE ( SUM ( 'MH Bulletin'[rate_per_100k] ), 'MH Bulletin'[period] = lp )
formatString: 0.0

measure 'MH Service Users (latest)' = 
VAR lp = CALCULATE ( MAX ( 'MH Bulletin'[period] ), ALL ( 'MH Bulletin' ) )
RETURN CALCULATE ( SUM ( 'MH Bulletin'[value] ), 'MH Bulletin'[period] = lp , 'MH Bulletin'[metric_code] = "users" )  // example
formatString: #,0

