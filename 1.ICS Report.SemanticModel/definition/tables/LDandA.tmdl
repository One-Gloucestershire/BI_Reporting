table LDandA
	lineageTag: c574712c-a6e0-eead-0b80-7e67c7213e8b

	measure 'LDA Cohort (latest)' = VAR m = CALCULATE ( MAX ( LDandA[month_date] ), ALL ( LDandA[month_date] ) ) RETURN CALCULATE ( SUM ( LDandA[patient_count] ), LDandA[month_date] = m )
		formatString: #,0
		lineageTag: 0e95ac56-dc7f-e8f1-5eb5-b23081345759

	measure 'LDA LD (latest)' = VAR m = CALCULATE ( MAX ( LDandA[month_date] ), ALL ( LDandA[month_date] ) ) RETURN CALCULATE ( SUM ( LDandA[ld_patients] ), LDandA[month_date] = m )
		formatString: #,0
		lineageTag: 0f0d44ad-f39c-c263-609b-e0e62325301b

	measure 'LDA Autism (latest)' = VAR m = CALCULATE ( MAX ( LDandA[month_date] ), ALL ( LDandA[month_date] ) ) RETURN CALCULATE ( SUM ( LDandA[autism_patients] ), LDandA[month_date] = m )
		formatString: #,0
		lineageTag: 99c33b9a-e7e9-f64d-d331-2bbbb3f8cad6

	measure 'LDA ADHD (latest)' = VAR m = CALCULATE ( MAX ( LDandA[month_date] ), ALL ( LDandA[month_date] ) ) RETURN CALCULATE ( SUM ( LDandA[adhd_patients] ), LDandA[month_date] = m )
		formatString: #,0
		lineageTag: 7b37b478-200e-806b-e0a4-64a4a61aefec

	measure 'LDA Patient-Months' = SUM ( LDandA[patient_count] )
		formatString: #,0
		lineageTag: b981e333-1027-33c2-8d5d-e9d002ad8634

	measure 'LDA % Most Deprived' = VAR m = CALCULATE ( MAX ( LDandA[month_date] ), ALL ( LDandA[month_date] ) ) RETURN DIVIDE ( CALCULATE ( SUM ( LDandA[patient_count] ), LDandA[month_date] = m, LDandA[glos_imd_decile] <= 2 ), CALCULATE ( SUM ( LDandA[patient_count] ), LDandA[month_date] = m ) )
		formatString: 0.0%
		lineageTag: f9bdd1f1-64e7-4795-a42e-0ea7083a23bc

