	partition LDandA = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "select date_trunc('month', census_date)::date as month_date, imdcountydecile as glos_imd_decile, coalesce(age_band_10yr,'Unknown') as age_band, coalesce(gender,'Unknown') as gender, coalesce(ethnic_origin_grouped,'Unknown') as ethnicity, coalesce(locality,'Unknown') as locality, count(distinct derived_nhs_number) as patients, count(distinct case when ld_flag=1 then derived_nhs_number end) as ld_patients, count(distinct case when autism_flag=1 then derived_nhs_number end) as autism_patients, count(distinct case when adhd_flag=1 then derived_nhs_number end) as adhd_patients from data_mart_powerbi_ldanda.tbl01_ld_autism_adhd_cohort group by 1,2,3,4,5,6", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table
