table 'Air Quality'
lineageTag: a1rqu4l1ty-0000-4b00-9c00-900000000001

measure 'Latest PM2.5' = 
VAR lp = CALCULATE ( MAX ( 'Air Quality'[datetime] ), ALL ( 'Air Quality' ) )
RETURN CALCULATE ( AVERAGE ( 'Air Quality'[value] ), 'Air Quality'[pollutant] = "PM2.5", 'Air Quality'[datetime] = lp )
formatString: 0.00

measure 'Latest NO2' = 
VAR lp = CALCULATE ( MAX ( 'Air Quality'[datetime] ), ALL ( 'Air Quality' ) )
RETURN CALCULATE ( AVERAGE ( 'Air Quality'[value] ), 'Air Quality'[pollutant] = "NO2", 'Air Quality'[datetime] = lp )
formatString: 0.00

measure 'Stations Reporting' = DISTINCTCOUNT ( 'Air Quality'[station] )
formatString: #,0

column station
dataType: string
lineageTag: a1rqu4l1ty-0000-4b00-9c00-900000000002
summarizeBy: none
sourceColumn: station

column lat
dataType: double
lineageTag: a1rqu4l1ty-0000-4b00-9c00-900000000003
summarizeBy: none
sourceColumn: lat

column long
dataType: double
lineageTag: a1rqu4l1ty-0000-4b00-9c00-900000000004
summarizeBy: none
sourceColumn: long

column pollutant
dataType: string
lineageTag: a1rqu4l1ty-0000-4b00-9c00-900000000005
summarizeBy: none
sourceColumn: pollutant

column datetime
dataType: datetime
lineageTag: a1rqu4l1ty-0000-4b00-9c00-900000000006
summarizeBy: none
sourceColumn: datetime

column value
dataType: double
lineageTag: a1rqu4l1ty-0000-4b00-9c00-900000000007
summarizeBy: none
sourceColumn: value

annotation SummarizationSetBy = Automatic
