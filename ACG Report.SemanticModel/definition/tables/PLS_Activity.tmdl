	partition PLS_Activity = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "ICB_Products", [Query="WITH ACTIVITY_CTE AS#(lf)(#(lf)SELECT DISTINCT [ACT].[PseudoNHSNumber]#(lf)               ,[ACT].[ActivityType]#(lf)               ,[DATE].[FirstDateofMonth]#(lf)               ,[DerivedActivityCost] = CASE WHEN [ActivityType] = 'Community Care' THEN 83.20 /* Average Unit Cost for 2023/24 GHC */#(lf)#(tab)                                   WHEN [ActivityType] = 'Mental Health' THEN 612.90 /* Average Unit Cost for 2023/24 GHC */#(lf)#(tab)#(tab)#(tab)#(tab)     WHEN [ActivityType] = 'MIIU' THEN 281.20 /* Average Unit Cost for 2023/24 GHC */#(lf)#(tab)#(tab)#(tab)#(tab)     WHEN [ActivityType] = '111' THEN 15.00 /* Average Unit Cost for 2023/24 GHC */#(lf)#(tab)#(tab)#(tab)#(tab)     ELSE [DerivedActivityCost] END#(lf)               ,[ACT].[Counter]#(lf)#(lf)FROM [ICB_Products].[Patient].[vw_Activity] AS [ACT]#(lf)#(lf)LEFT JOIN (#(lf)           SELECT DISTINCT [Date]#(lf)#(tab)                ,[FirstDateofMonth]#(lf)           FROM [CCG_Reference].[Reference].[vw_DateLookup]#(lf)#(tab)) AS [DATE]#(lf)ON [DATE].[Date] = [ACT].[ActivityStartDate]#(lf)#(lf)WHERE [ActivityStartDate] >= DATEADD(MONTH, DATEDIFF(MONTH, 0, GETDATE()) - 12,0)#(lf)AND [ActivityStartDate] < DATEADD(MONTH, DATEDIFF(MONTH, 0, GETDATE()), 0)#(lf))#(lf)SELECT [PseudoNHSNumber]#(lf)      ,[ActivityType]#(lf)      ,[FirstDateofMonth]#(lf)      ,[DerivedActivityCost] = SUM([DerivedActivityCost])#(lf)      ,[Counter] = SUM([Counter])#(lf)#(lf)FROM ACTIVITY_CTE#(lf)#(lf)GROUP BY [PseudoNHSNumber]#(lf)        ,[ActivityType]#(lf)        ,[FirstDateofMonth]#(lf)#(lf)/* 2023/24 Costs taken from Health Expenditure Benchmarking Tool#(lf)-https://app.powerbi.com/groups/75c0f44b-4988-4e28-9d87-b0101466255a/reports/eae1fcf9-5c50-4804-9090-2b8ec8f4ec06/ReportSection1543306fc27b894145e5?experience=power-bi */"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

