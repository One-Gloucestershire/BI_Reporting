table PLS_Activity
	lineageTag: d030c443-cacd-4ab5-aa0b-1a1dd96627ca

	measure 'Cost per Person' =
			
			
			SUM('PLS_Activity'[DerivedActivityCost]) / SUM('PLS_Summary'[Counter])
		formatString: "£"#,0.0;-"£"#,0.0;"£"#,0.0
		lineageTag: 1be37347-fa7d-4be8-aecc-5aaa04f0ec9c

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Activity per Person' =
			
			
			SUM('PLS_Activity'[Counter]) / SUM('PLS_Summary'[Counter])
		lineageTag: 31a29185-7ddf-4f81-9ee5-61689f07d6ee

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Primary Selection - Activity per Person' =
			
			
			CALCULATE(
			    SUM('PLS_Activity'[Counter]),
			    ALL('Ref_GP_Secondary')
			)
			/
			CALCULATE(
			    SUM('PLS_Summary'[Counter])
			    ,ALL('Ref_GP_Secondary')
			)
		lineageTag: b60ea283-26be-4f40-8e72-4e5f8f1bac32

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Secondary Selection - Activity per Person' =
			
			
			CALCULATE(
			    SUM('PLS_Activity'[Counter]),
			    ALL('Ref_GP_Primary')
			)
			/
			CALCULATE(
			    SUM('PLS_Summary'[Counter])
			    ,ALL('Ref_GP_Primary')
			)
		lineageTag: 189f0fb9-a5e3-4b56-b9db-5c5a2ba65f60

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Activity - Emergency Admissions Rate per 1,000' = ```
			
			
			VAR _ACTIVITY = 
			
			CALCULATE(
			    SUM('PLS_Activity'[Counter]),
			    'PLS_Activity'[ActivityType] = "Emergency Admission"
			)
			
			VAR _POPULATION = 
			
			SUM('PLS_Summary'[Counter])
			
			RETURN
			
			(_ACTIVITY / _POPULATION) * 1000
			```
		formatString: 0.0
		lineageTag: 9fc58d65-0a52-418a-b732-a01dedab9104

	measure 'Activity - 111 - Cost PPPY' = ```
			
			
			CALCULATE(
			    SUM('PLS_Activity'[DerivedActivityCost]),
			    'PLS_Activity'[ActivityType] = "111"
			)
			 /  
			
			SUM('PLS_Summary'[Counter])
			```
		formatString: "£"#,0.0;-"£"#,0.0;"£"#,0.0
		displayFolder: Activity Cost Measure - PPPY
