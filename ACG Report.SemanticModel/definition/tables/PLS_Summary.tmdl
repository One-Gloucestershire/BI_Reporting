				    Source = Sql.Database("grh-ccg-sql", "ICB_Products", [Query="SELECT DISTINCT [PLS].[PseudoNHSNumber]#(lf)               ,[Counter] = 1#(lf)               ,[Gender] = CASE WHEN [PLS].[Gender] = 'M' THEN 'Male'#(lf)#(tab)                      WHEN [PLS].[Gender] = 'F' THEN 'Female'#(lf)#(tab)#(tab)#(tab)  ELSE 'Unknown' END#(lf)               ,[PLS].[DerivedAge]#(lf)#(tab)     ,[PLS].[PracticeCode]#(lf)#(tab)     ,[PLS].[HIUFlag]#(lf)#(tab)     ,[IMD].[Core20Flag]#(lf)#(tab)     ,[PLS].[LTCCountDerived]#(lf)#(tab)     ,[eFI_Frailty_Category] = CASE WHEN [PLS].[eFICategoryDerived] IS NULL THEN 'Not Recorded'#(lf)#(tab)                                    ELSE [PLS].[eFICategoryDerived] END#(lf)#(tab)     ,[PLS].[ACGPatientNeedsGroup]#(lf)#(tab)     ,[ACG].[chronic_condition_count]#(lf)#(tab)     ,[Chronic_Condition_Group] = CASE WHEN [ACG].[chronic_condition_count] = 0 THEN '0'#(lf)#(tab)                                       WHEN [ACG].[chronic_condition_count] = 1 THEN '1'#(lf)#(tab)#(tab)#(tab)#(tab)         WHEN [ACG].[chronic_condition_count] BETWEEN 2 AND 3 THEN '2-3'#(lf)#(tab)#(tab)#(tab)#(tab)         WHEN [ACG].[chronic_condition_count] BETWEEN 4 AND 5 THEN '4-5'#(lf)#(tab)#(tab)#(tab)#(tab)         ELSE '6+' END#(lf)#(tab)     ,[ACG].[active_ingredient_count]#(lf)#(tab)     ,[ACG].[probability_unexpected_pharmacy_cost]#(lf)#(tab)     ,[ACG].[probability_persistent_high_user]#(lf)#(tab)     ,[ACG].[probability_icu_hosp]#(lf)#(tab)     ,[ACG].[probability_ip_hosp]#(lf)#(tab)     ,[ACG].[probability_injury_hosp]#(lf)#(tab)     ,[ACG].[probability_extended_hosp]#(lf)#(tab)     ,[ACG].[probability_unplanned_30_day_readmission]#(lf)#(tab)     ,[ProcessedDate] = CAST([PLS].[ProcessedDate] AS DATE)#(lf)#(lf)FROM [ICB_Products].[Patient].[vw_Summary] AS [PLS]#(lf)#(lf)LEFT JOIN (#(lf)           SELECT [patient_id]#(lf)#(tab)       ,[chronic_condition_count]#(lf)#(tab)       ,[active_ingredient_count]#(lf)                 ,[probability_unexpected_pharmacy_cost]#(lf)                 ,[probability_persistent_high_user]#(lf)#(tab)       ,[probability_icu_hosp]#(lf)                 ,[probability_ip_hosp]#(lf)                 ,[probability_injury_hosp]#(lf)                 ,[probability_extended_hosp]#(lf)                 ,[probability_unplanned_30_day_readmission]#(lf)           FROM [CCG_Current].[ACG].[vw_ACGResults]#(lf)#(tab) WHERE [IsLatest] = 1#(lf)          ) AS [ACG]#(lf)ON [ACG].[patient_id] = [PLS].[PseudoNHSNumber]#(lf)#(lf)LEFT JOIN (#(lf)           SELECT DISTINCT [PseudoNHSNumber]#(lf)#(tab)                ,[Core20Flag]#(lf)#(tab) FROM [ICB_Products].[Patient].[vw_IMD_and_Geography]#(lf)          ) AS [IMD]#(lf)ON [IMD].[PseudoNHSNumber] = [PLS].[PseudoNHSNumber]#(lf)#(lf)WHERE [PLS].[ICBofRegistration] = '11M'"])
				in
				    Source

	annotation PBI_ResultType = Table

