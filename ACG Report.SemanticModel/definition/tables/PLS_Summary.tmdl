table PLS_Summary
	lineageTag: 6a5ef35a-c6f2-4dc5-9824-6d9fbcc4eeb2

	measure 'Primary Selection - PNG % Breakdown' = ```
			
			
			CALCULATE(
			    SUM('PLS_Summary'[Counter])
			    ,ALL('Ref_GP_Secondary')
			)
			/ 
			CALCULATE(
			    SUM('PLS_Summary'[Counter])
			    ,ALL('Ref_PNG')
			    ,ALL('Ref_GP_Secondary')
			)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 5d6fc20d-2486-4420-af37-d939f755afdf

	measure 'Secondary Selection - PNG % Breakdown' = ```
			
			
			CALCULATE(
			    SUM('PLS_Summary'[Counter])
			    ,ALL('Ref_GP_Primary')
			)
			/ 
			CALCULATE(
			    SUM('PLS_Summary'[Counter])
			    ,ALL('Ref_PNG')
			    ,ALL('Ref_GP_Primary')
			)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: d8e35497-9490-45fd-bbfa-539e960c9d07

	measure 'Combined - PNG % Breakdown' = ```
			
			
			VAR _DIFFERENCE = 
			
			SWITCH(
			    TRUE(),
			    [Primary Selection - PNG % Breakdown] > [Secondary Selection - PNG % Breakdown], [Secondary Selection - PNG % Breakdown] - [Primary Selection - PNG % Breakdown]
			    ,[Primary Selection - PNG % Breakdown] < [Secondary Selection - PNG % Breakdown], [Secondary Selection - PNG % Breakdown] - [Primary Selection - PNG % Breakdown]
			    ,[Primary Selection - PNG % Breakdown] = [Secondary Selection - PNG % Breakdown], 0
			)
			
			RETURN
			
			[Primary Selection - PNG % Breakdown] + (_DIFFERENCE/2)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 36d3128c-0902-4ae4-8635-531782e3b525

	measure 'Variance - PNG % Breakdown' =
			
			
			[Primary Selection - PNG % Breakdown] - [Secondary Selection - PNG % Breakdown]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 8721a477-c783-43d7-9bec-6478b70656ee

	measure 'Primary Selection - % High Risk of Long LoS' =
			
			
			VAR _TotalPop =
			
			    CALCULATE(
			        SUM('PLS_Summary'[Counter]),
			        ALL('PLS_Summary')
			    )
			    /* Total people in ICB Population */
			
			VAR _Top10Cutoff =
			
			    ROUNDUP(_TotalPop * 0.10, 0)
			    /* Number of people in 10% */
			
			VAR Top10_Table =
			
			    TOPN(
			        _Top10Cutoff,
			        ALL('PLS_Summary'),
			        'PLS_Summary'[probability_extended_hosp],
			        DESC
			    )
			    /* Top 10% of people in the ICB ranked by probability */
			
			RETURN
			
			CALCULATE(
			    SUM('PLS_Summary'[Counter]),
			    ALL('Ref_GP_Secondary'),
			    KEEPFILTERS(Top10_Table)
			)
			/* Numerator is total individuals who appear in the ICB top 10 % */
			
			/
			
			CALCULATE(
			    SUM('PLS_Summary'[Counter]),
			    ALL('Ref_GP_Secondary')
			)
			/* Denominator is total selection population */
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c12223b1-dea1-41e1-864a-dd25c47ac823

	measure 'Secondary Selection - % High Risk of Long LoS' =
			
			
