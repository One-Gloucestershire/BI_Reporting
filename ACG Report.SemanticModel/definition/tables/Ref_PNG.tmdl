	partition Ref_PNG = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "ICB_Products", [Query="SELECT DISTINCT [PNG_Order] = LEFT([ACGPatientNeedsGroup], 2)#(lf)               ,[ACGPatientNeedsGroup]#(lf)               ,[Wider_PNG_Group] = CASE WHEN [ACGPatientNeedsGroup] IN ('01 Non-User', '02 Low Need Child', '03 Low Need Adult') THEN 'Healthy'#(lf)#(tab)                               WHEN [ACGPatientNeedsGroup] IN ('04 Multi-Morbidity Low Complexity', '05 Multi-Morbidity Medium Complexity') THEN 'Moderate Needs'#(lf)#(tab)#(tab)#(tab)#(tab) WHEN [ACGPatientNeedsGroup] IN ('06 Pregnancy Low Complexity', '07 Pregnancy High Complexity') THEN 'Pregnant'#(lf)#(tab)#(tab)#(tab)#(tab) WHEN [ACGPatientNeedsGroup] IN ('08 Dominant Psychiatric/Behavioral Condition', '09 Dominant Major Chronic Condition') THEN 'Dominant Chronic'#(lf)#(tab)#(tab)#(tab)#(tab) WHEN [ACGPatientNeedsGroup] IN ('10 Multi-Morbidity High Complexity', '11 Frailty') THEN 'High Complexity; Multi-Morbidity'#(lf)#(tab)#(tab)#(tab)#(tab) ELSE NULL END#(lf)               ,[Wider_PNG_Order] = CASE WHEN [ACGPatientNeedsGroup] IN ('01 Non-User', '02 Low Need Child', '03 Low Need Adult') THEN 1#(lf)#(tab)                               WHEN [ACGPatientNeedsGroup] IN ('04 Multi-Morbidity Low Complexity', '05 Multi-Morbidity Medium Complexity') THEN 2#(lf)#(tab)#(tab)#(tab)#(tab) WHEN [ACGPatientNeedsGroup] IN ('06 Pregnancy Low Complexity', '07 Pregnancy High Complexity') THEN 3#(lf)#(tab)#(tab)#(tab)#(tab) WHEN [ACGPatientNeedsGroup] IN ('08 Dominant Psychiatric/Behavioral Condition', '09 Dominant Major Chronic Condition') THEN 4#(lf)#(tab)#(tab)#(tab)#(tab) WHEN [ACGPatientNeedsGroup] IN ('10 Multi-Morbidity High Complexity', '11 Frailty') THEN 5#(lf)#(tab)#(tab)#(tab)#(tab) ELSE NULL END#(lf)#(lf)FROM [ICB_Products].[Patient].[vw_Summary]#(lf)#(lf)WHERE [ACGPatientNeedsGroup] IS NOT NULL"])
				in
				    Source

	changedProperty = Name

