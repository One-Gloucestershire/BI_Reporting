	partition PLS_Geography = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "ICB_Products", [Query="  SELECT DISTINCT [PseudoNHSNumber]#(lf)                 ,[LSOACode]#(lf)#(tab)       ,[WardName]#(lf)#(tab)       ,[DistrictDescription]#(lf)#(tab)       ,[RuralUrbanClassification]#(lf)#(tab)       ,[RuralurbanFlag]#(lf)#(tab)       ,[IMD_England_Decile] = [IMDNationalDecile]#(lf)#(tab)       ,[IMD_Gloucester_Decile] = [IMDCountyDecile]#(lf)#(tab)       ,[Core20Flag]#(lf)#(tab)       ,[DerivedIsLivingAlone]#(lf)#(tab)       ,[DerivedIsLivingInCareHome]#(lf)#(lf)  FROM [ICB_Products].[Patient].[vw_IMD_and_Geography]"])
				in
				    Source

	changedProperty = Name

	annotation PBI_ResultType = Exception

