table PLS_Geography
	lineageTag: 3b2e2708-df16-4ace-b59d-1a8b6fde2a17

	measure Measure
		lineageTag: 7ae84121-c05b-4a6c-bda7-c043f96a3c15

	measure 'Map Distribution - Crude Rate per 1,000' = ```
			
			
			VAR _NUMERATOR = SUM('PLS_Summary'[Counter])
			
			VAR _DENOMINATOR = 
			
			CALCULATE(
			    SUM('PLS_Summary'[Counter]),
			    ALL('PLS_Geography')
			)
			
			RETURN
			
			(_NUMERATOR / _DENOMINATOR) * 1000
			```
		formatString: 0.0
		lineageTag: 95fd6ebe-80fa-458a-b80f-704c86b6a8d3

	measure 'Map Distribution - Crude Rate per 1,000 - Max' =
			
			
			MAXX(
			    VALUES('PLS_Geography'[LSOACode]),
			    [Map Distribution - Crude Rate per 1,000]
			)
		formatString: 0.0
		lineageTag: d4fd5a5f-627b-469e-8a4a-d4253597b194

	measure 'Map Distribution - Crude Rate per 1,000 - Min' =
			
			
			MINX(
			    VALUES('PLS_Geography'[LSOACode]),
			    [Map Distribution - Crude Rate per 1,000]
			)
		formatString: 0.0
		lineageTag: e4ae00e3-37d2-4a4e-b381-70338b654f3c

