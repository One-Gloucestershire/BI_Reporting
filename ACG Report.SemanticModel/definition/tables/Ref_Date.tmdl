	partition Ref_Date = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Reference", [Query="SELECT [Date]#(lf)      ,[MonthName] = LEFT([MonthName], 3)#(lf)      ,[FinancialYear]#(lf)      ,[YearMonth]#(lf)      ,[FinancialMonth]#(lf)      ,[FinancialQuarter]#(lf)      ,[IsWeekend]#(lf)      ,[IsHoliday]#(lf)#(lf)FROM [CCG_Reference].[Reference].[vw_DateLookup]#(lf)#(lf)  WHERE [Date] >= DATEADD(MONTH, DATEDIFF(MONTH, 0, GETDATE()) - 12,0)#(lf)  AND [Date] < DATEADD(MONTH, DATEDIFF(MONTH, 0, GETDATE()), 0)"])
				in
				    Source

