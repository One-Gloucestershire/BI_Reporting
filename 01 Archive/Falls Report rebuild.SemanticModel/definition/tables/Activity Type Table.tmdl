	measure 'Total crude rate' =
			
			
			VAR activity_selection = SELECTEDVALUE('Activity Selection Table'[Activity Selection])
			
			VAR observed_events_for_activity_selection =    IF(activity_selection = "ED Attendance", [Number of ED Attendances],
			                                                IF(activity_selection = "Hospital Admission", [Number of Admission Falls],
			                                                IF(activity_selection = "SWAST Call", [Number of SWAST Falls],BLANK())))
			
			return observed_events_for_activity_selection / [Current Population]*1000
		lineageTag: 02fb1b09-580f-4c46-a0c8-c7d9b9c82d73

