table 'Date Table'
	lineageTag: 6e675f31-74a6-4511-9ea9-d9cd96cf0239

	measure 'Count of all PCN' = count('Place Population'[Primary Care Network])
		formatString: 0
		lineageTag: 1951bb90-5cab-40c8-b016-62cbd618bbbe

	measure 'Count of ED PCN' = count('ED Falls (new)'[Primary Care Network])
		formatString: 0
		lineageTag: 218033bd-6652-4398-b1a9-5c76fb1cbbbc

	measure Measure = ([Count of ED PCN] / [Count of all PCN]) *1000
		lineageTag: 54ed9bb4-5e4a-4aa4-b754-d4ce4f6a1766

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Count of 65+ ED falls per PCN divided by Count of 65+ pop per PCN' =
			
			DIVIDE(
				SUM('PCN ED'[Count of 65+ ED falls per PCN]),
				SUM('PCN Pop'[Count of 65+ pop per PCN])
			) *1000
		formatString: 0
		lineageTag: ab72139a-6996-4fe1-91f1-c1cfa20476ca

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalDivision"
				}

	measure 'Dash Line' = REPT("|"&UNICHAR(10),20)
		lineageTag: cb6357e0-fe41-48fd-ac80-1e6166af54dd

	measure 'Refresh date' = TODAY()
		formatString: mmmm yyyy
		lineageTag: b9b104bf-1aa9-49ad-9129-1155d32ed2c2

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	measure 'Data up to' = MAX('SWAST All Years Falls'[dateofincident])
		formatString: mmmm yyyy
		lineageTag: ff0e33a7-eeee-4b12-8f00-3e817b500ce8

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

