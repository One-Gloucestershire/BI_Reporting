	partition 'Date Table-4919b28c-06fb-4a2e-8247-f0dadd718d4e' = m
		mode: import
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "CCG_Reference", [Query="SELECT a.*#(lf),b.Fin_Year#(lf)#(tab)    ,[ytd_flag] = CASE WHEN financial_month <= (#(lf)                                           SELECT#(lf)                                           CAST(financial_month AS INT)#(lf)                                           FROM [CCG_Reference].[Reference].[vw_DateLookup]#(lf)                                           WHERE [Date] = EOMONTH(DATEADD(MONTH, -2, GETDATE()))#(lf)                                           )#(lf)                                           THEN 'Year to Date' ELSE 'Non-Year to Date' END#(lf)  FROM [CCG_Reference].[Reference].[vw_Date] a#(lf)#(lf)  left join DSCRO_NATIONAL_LOOKUPS.dbo.ref_Dates b on b.Full_Date = a.date"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

