	partition 'Current Population' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "ICB_Products", [Query="#(lf)#(tab)  SELECT#(lf)#(tab)  locality = case when m.Locality like '%cotswold%' then 'Cotswolds' else Locality end#(lf)#(tab)  ,MH_flag = case when m.MentalIllness is null then 0 else m.MentalIllness end#(lf)#(tab)  ,LD_flag = case when m.LearningDisability  is null then 0 else m.LearningDisability end#(lf)#(tab)  ,Core20Flag = case when m.Core20Flag is null then 0 else m.Core20Flag end#(lf)#(tab)  ,[Ethnic Origin Grouped] = case#(tab)when DerivedEthnicityGroup is null then 'Unknown' #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when DerivedEthnicityGroup like 'Not known' then 'Unknown' #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)else DerivedEthnicityGroup #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)end #(lf)#(tab)  ,[5YR_Age_Band] = case#(tab)when m.AgeBand5yr like '0-4' then '00-04'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when m.AgeBand5yr like '5-9' then '05-09'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)else m.AgeBand5yr#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)end#(lf)#(tab)  ,m.PseudoNHSNumber#(lf)#(tab)  ,IMDCountyDecile  = case when m.IMDCountyDecile is null then null else m.IMDCountyDecile end#(lf)#(tab)  ,counter = 1#(lf),PracticeCode#(lf),PrimaryCareNetwork#(lf)#(lf)#(tab)  from ICB_Products.[Patient].[vw_Summary] m#(lf)#(lf)#(tab)  left join [ICB_Products].[Patient].[vw_IMD_and_Geography] b on b.PseudoNHSNumber = m.PseudoNHSNumber"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

