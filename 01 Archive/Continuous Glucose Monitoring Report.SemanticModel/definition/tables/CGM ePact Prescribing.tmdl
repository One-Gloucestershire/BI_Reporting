table 'CGM ePact Prescribing'
	lineageTag: 91cfa9a3-8a52-4a40-80ce-464b81c03fd4

	measure Cost_per_patient = sum('CGM ePact Prescribing'[Cost (£)])/distinctcount('NDA Diabetic Population'[Derived_Pseudo_NHS_Number])
		lineageTag: d9a82fbb-a112-45d3-b4cf-55fb45dc7369

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Current_YTD_Cost = calculate(sum('CGM ePact Prescribing'[Cost (£)]),'CGM ePact Prescribing'[FinancialYear] = "2024/25")
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 241596a6-f169-4d9b-9bc4-5a5e160b9419

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure Previous_YTD_Cost = calculate(sum('CGM ePact Prescribing'[Cost (£)]),datesytd(sameperiodlastyear(date_table[date]),"31/3"))
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: 39499a54-fad1-4dee-87a4-77177243cd01

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure Previous_YTD = calculate(sum('CGM ePact Prescribing'[Cost (£)]),'CGM ePact Prescribing'[FinancialYear] = "2022/23",'CGM ePact Prescribing'[ytd_months] = 1)
		lineageTag: f8046b9b-3dae-4ee1-b45a-c6040980bf72

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Cost_per_1000 = (DIVIDE('CGM ePact Prescribing'[Current_YTD_Cost],'Cohort'[Diabetic_population])) * 1000
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: 39e90335-24cf-4549-a47d-59090f08b3de

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure Current_YTD_quantity = calculate(sum('CGM ePact Prescribing'[Quantity]),datesytd(date_table[date],"31/3"))
		formatString: 0
		lineageTag: 2d5361a0-e7c2-46ab-b8e4-909631102975

	measure Quantity_per_1000 = (DIVIDE([Current_YTD_quantity],Cohort[Diabetic_population])) * 1000
		lineageTag: 78847d45-767d-48b4-bed5-a20b014b27a0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure max_financial_month = maxx(filter('date_table',date_table[financial_year] = "2023/24"),date_table[financial_month])
		formatString: 0
		lineageTag: bcedf783-9489-4475-b437-ac58aab458c7

	measure 'Bars over projection colour' =
			if(
			    sum('CGM ePact Prescribing'[Cost (£)]) > sum(cost_projection[Projection (linear)]),"#E02C20", "")
		lineageTag: 0d2777b8-d058-4577-b8e1-83e2eefa0f1d

	measure 'Gauge colour' =
			if(
			    [Current_YTD_Cost]>[ytd_projection],"#BA1200","#007875")
		lineageTag: 18f010da-9a01-4de3-8f16-cab8f256ade4

	measure Cost_per_month_-_rebate = calculate(sum('CGM ePact Prescribing'[Cost (£)]),'CGM ePact Prescribing'[Rebate_recieved] = "Yes")-sum(Rebate[ConfirmedRebate])
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 741d5108-3168-4c93-acd8-314864725747

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure Full_year_cost_-_rebate = calculate(sum('CGM ePact Prescribing'[Cost (£)])-sum(Rebate[ConfirmedRebate]))
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 96cddf69-2527-4cd2-930c-ecd263ca54cb

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure Cost_before_rebate = if(calculate(sum('CGM ePact Prescribing'[Cost (£)]),'CGM ePact Prescribing'[Rebate_recieved] = "No")-sum(Rebate[ConfirmedRebate])<0,0,calculate(sum('CGM ePact Prescribing'[Cost (£)]),'CGM ePact Prescribing'[Rebate_recieved] = "No")-sum(Rebate[ConfirmedRebate]))
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 7e3d0a79-ee17-4e24-a688-de48765f5391

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 2023_24_Cost_-_Rebate = calculate(sum('CGM ePact Prescribing'[Cost (£)]),'CGM ePact Prescribing'[FinancialYear] = "2023/24")-sum(Rebate[ConfirmedRebate])
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: d9ed51f3-9965-4314-8778-93a9b50d4570

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 2023_24_Cost_with_rebate_and_test_strip_savings = (calculate(sum('CGM ePact Prescribing'[Cost (£)]),'CGM ePact Prescribing'[FinancialYear] = "2023/24")-sum(Rebate[ConfirmedRebate]))+'Test strips ePact Prescribing'[23_24_test_strip_savings]
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 23ea2cfa-05eb-4c2f-933b-fb2495aa70f5

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

