	partition 'CGM ePact Prescribing' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Current", [Query="SET ANSI_NULLS ON#(lf)SET QUOTED_IDENTIFIER ON#(lf)set nocount on#(lf)set ansi_warnings off #(lf)#(lf)IF OBJECT_ID('tempdb..#temp_ytd') is not null#(lf)drop table #temp_ytd#(lf)#(lf)SELECT distinct [A].[YearMonth]#(lf)#(tab)  ,[D].[FinancialMonth]#(lf)into #temp_ytd#(lf)#(tab)  #(lf)#(lf)FROM [CCG_Current].[ePACT2].[vw_Extract] as [A]#(lf)#(lf)#(tab)#(tab)LEFT JOIN [CCG_Reference].[Reference].[vw_GPPractice] as [B]#(lf)#(tab)#(tab)ON [A].[HSPracticeCode] = [B].[OrganisationCode]#(lf)#(lf)#(tab)#(tab)left join [CCG_Reference].[Reference].[vw_DateLookup][D]#(lf)#(tab)#(tab)on [A].[YearMonth] = [D].[YearMonth]#(lf)#(lf)WHERE [BNFChemicalSubstanceCode] in ('0601060D0','0601060X0')#(lf)  AND [A].[YearMonth] >= '202304'#(lf)  and [HSCommissioner_or_ProviderCode] like '11M%'#(lf)  and [D].[Date] = [D].[LastDateofMonth]#(lf)#(lf)/*------------------------------------------------------------------------#(lf)------------------------------------------------------------------------*/#(lf)#(lf)SELECT [A].[YearMonth]#(lf)      ,[A].[Month]#(lf)#(tab)  ,[D].[LastDateofMonth]#(lf)#(tab)  ,[D].[FinancialMonth]#(lf)#(tab)  ,[D].[FinancialYear]#(lf)      ,[HSPracticeCode]#(lf)      ,[HSPractice]#(lf)      ,[BNFPresentationCode]#(lf)      ,[BNFPresentation]#(lf)      ,[Items] #(lf)      ,[ActualCost]#(lf)      ,[Quantity]#(lf)      ,[fiveyearsageband]#(lf)#(tab)  ,[B].[OrganisationName]#(lf)#(tab)  ,[B].[ReportingOrganisationName]#(lf)#(tab)  ,[B].[PrimaryCareNetwork]#(lf)#(tab)  ,[ytd_months] = case when [D].[financialmonth] in (select distinct [financialmonth] from #temp_ytd) then 1 else 0 end#(lf)#(tab)  #(lf)#(lf)FROM [CCG_Current].[ePACT2].[vw_Extract] as [A]#(lf)#(lf)#(tab)#(tab)LEFT JOIN [CCG_Reference].[Reference].[vw_GPPractice] as [B]#(lf)#(tab)#(tab)ON [A].[HSPracticeCode] = [B].[OrganisationCode]#(lf)#(lf)#(tab)#(tab)left join [CCG_Reference].[Reference].[vw_DateLookup][D]#(lf)#(tab)#(tab)on [A].[YearMonth] = [D].[YearMonth]#(lf)#(lf)WHERE [BNFPresentationCode] like '2148%'#(lf)  AND [A].[YearMonth] >= '201904'#(lf)  and [HSCommissioner_or_ProviderCode] like '11M%'#(lf)  and [D].[Date] = [D].[LastDateofMonth]#(lf)"]),
				    #"Renamed Columns" = Table.RenameColumns(Source,{{"ActualCost", "Cost (£)"}, {"BNFPresentation", "BNF Product Name"}, {"fiveyearsageband", "Age"}, {"ReportingOrganisationName", "Practice Name"}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Renamed Columns",{"Month"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Removed Columns",{{"LastDateofMonth", type date}})
				in
				    #"Changed Type"

