 = [D].[YearMonth]#(lf)#(lf)WHERE [BNFChemicalSubstanceCode] in ('0601060D0','0601060X0')#(lf)  AND [A].[YearMonth] >= '201904'#(lf)  and [HSCommissioner_or_ProviderCode] like '11M%'#(lf)  and [D].[Date] = [D].[LastDateofMonth]#(lf)"]),
