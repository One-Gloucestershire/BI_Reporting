	measure cgm_-_test_strips_saving_old = calculate('CGM ePact Prescribing'[Full_year_cost_-_rebate],'CGM ePact Prescribing'[FinancialYear] = "2023/24")-[test_strips_diff_previous_ytd_cost]
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: c2d2232d-581f-4583-9bab-4b7310a77282

