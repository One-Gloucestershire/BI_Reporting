	measure Previous_YTD_Cost_test_strips = calculate(sum('Test strips ePact Prescribing'[Cost (£)]),datesytd(sameperiodlastyear(date_table[date]),"31/3"))
		lineageTag: baa63c89-4446-41a1-98e7-8445d50541c7

