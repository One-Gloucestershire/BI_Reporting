		lineageTag: 22ceeff0-a81b-418b-a6cf-e26ccf1b4a96

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure Test_Strips_Cost_per_1000 = (DIVIDE('Test strips ePact Prescribing'[test_strips_ytd_cost],'NDA Diabetic Population'[Diabetic Population])) * 1000
