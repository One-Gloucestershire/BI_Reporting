	measure test_strips_2022_23_same_point_cost = calculate(sum('Test strips ePact Prescribing'[Cost (£)]),'Test strips ePact Prescribing'[FinancialYear] = "2022/23", 'Test strips ePact Prescribing'[ytd_months] = 1)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 887a65b7-23e7-4501-a62f-45ce63814b39

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure test_strips_diff_previous_ytd_cost = 'Test strips ePact Prescribing'[test_strips_2023_24_same_point_cost] - 'Test strips ePact Prescribing'[test_strips_ytd_cost]
