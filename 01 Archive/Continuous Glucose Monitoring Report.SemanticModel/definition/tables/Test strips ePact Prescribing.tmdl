	measure total_test_strip_savings_202204_onwards = 'Test strips ePact Prescribing'[22_23_test_strips_savings] + 'Test strips ePact Prescribing'[23_24_test_strip_savings] +'Test strips ePact Prescribing'[test_strips_diff_previous_ytd_cost]
