table 'Distinct Count'
	lineageTag: affe7eb4-1aa1-4f15-acaa-356a0c0fbc25

	measure '90D Total' =
			
			CALCULATE(
				SUM('Distinct Count'[Counter]),
				FILTER(
					ALL('Distinct Count'[Date]),
					'Distinct Count'[Date]>MAX('Distinct Count'[Date])-90 &&
			        'Distinct Count'[Date]<=MAX('Distinct Count'[Date])))
		formatString: 0
		lineageTag: 21057399-b4b8-4c0c-aca2-36a4998ce22c

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "RunningTotal"
				}

		changedProperty = FormatString

	column Counter
		dataType: int64
		formatString: 0
		lineageTag: 62c5532a-6761-48a0-bdff-0436c4a26791
		summarizeBy: sum
		sourceColumn: Counter

		annotation SummarizationSetBy = Automatic

	column NHS_Number
		dataType: string
		lineageTag: 14d6e36e-5eb9-45e6-a781-977064c02902
		summarizeBy: none
		sourceColumn: NHS_Number

		annotation SummarizationSetBy = Automatic

