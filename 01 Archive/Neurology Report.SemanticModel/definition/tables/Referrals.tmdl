table Referrals
	lineageTag: 28cbee6b-f412-4038-844a-709b97b8b1e8

	measure 'Referrals Rejection Rate' = CALCULATE((sum('Referrals'[Referrals_rejected_flag])/sum('Referrals'[counter])))
		formatString: 0%;-0%;0%
		lineageTag: c6ce0fd3-a1e9-48e4-ab99-2d559b50e09e

	measure 'Referrals Acceptance Rate' =
			CALCULATE(
			    (sum('Referrals'[counter])-sum('Referrals'[Discharged_without_contact]))
			    /
			    sum('Referrals'[counter]))
		formatString: 0%;-0%;0%
		lineageTag: 3dadfaa2-edac-49fe-a469-c6b1ff9dc45c

	measure 'Max Referral Date' = MAX('Referrals'[ReferralRequestReceivedDate])
		formatString: mmmm yyyy
		lineageTag: ca2725d6-3d76-45d4-bb6a-d4dece9dacaf

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

