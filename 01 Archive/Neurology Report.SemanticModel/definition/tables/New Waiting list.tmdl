	column 'Weeks Waiting' =
			
			
			IF('New Waiting list'[Date_to_use] = BLANK(), DATEDIFF('New Waiting list'[ReferralRequestReceivedDate],'New Waiting list'[Max Date],WEEK), DATEDIFF('New Waiting list'[ReferralRequestReceivedDate],'New Waiting list'[Date_to_use],WEEK))
		formatString: 0
		lineageTag: ebc3acad-e939-49fc-aebd-8b91188bd257
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Days Waiting' =
			
			
			IF('New Waiting list'[Date_to_use] = BLANK(), DATEDIFF('New Waiting list'[ReferralRequestReceivedDate],'New Waiting list'[Max Date],DAY), DATEDIFF('New Waiting list'[ReferralRequestReceivedDate],'New Waiting list'[Date_to_use],DAY))
		formatString: 0
		lineageTag: 151335a0-412f-44a9-9d52-326b9c2b8361
