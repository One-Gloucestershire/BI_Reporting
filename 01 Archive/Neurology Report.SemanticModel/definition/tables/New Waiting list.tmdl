	column Correct_date_to_use =
			
			
			VAR max_date = MAX('New Waiting list'[Date_to_use])
			
			VAR correct_max_date = EOMONTH(max_date,0) + 1
			
			RETURN IF('New Waiting list'[Date_to_use] = BLANK(), correct_max_date, 'New Waiting list'[Date_to_use])
		formatString: General Date
		lineageTag: cbc2338e-b4fe-4b29-a1f7-67ea3a786fd8
