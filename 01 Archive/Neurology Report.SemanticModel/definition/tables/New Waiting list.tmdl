table 'New Waiting list'
	lineageTag: f435985c-ff1b-4674-9972-02214f5d5af8

	measure 'Referrals Per Month' = ```
			
			 
			VAR CurrentDate = MAX('Date Waiting List'[Date])
			 
			RETURN
			    CALCULATE(
			        count('New Waiting list'[UniqueServiceRequestID]),
			        'New Waiting list'[ReferralRequestReceivedDate] <= CurrentDate
			        && 'New Waiting list'[Correct_date_to_use] > CurrentDate )
			    
			```
		formatString: 0
		lineageTag: 55ec4e99-0233-47cf-b9af-64be38ce8ce7

	measure 'If waiting days' = ```
			
			 
			VAR CurrentDate = MAX('Date Waiting List'[Date])
			 
			VAR days_waiting = if(max('New Waiting list'[ReferralRequestReceivedDate]) <= CurrentDate
			                    && max('New Waiting list'[Correct_date_to_use]) > CurrentDate, 
			                    DATEDIFF(max('New Waiting list'[ReferralRequestReceivedDate]),CurrentDate,DAY),BLANK())
			
			
			RETURN days_waiting
			```
		formatString: 0
		lineageTag: b42e050f-6d20-4238-a70f-3fa43d3a5562

	measure 'If waiting week_banding' = ```
			
			
			SWITCH(TRUE(),
			[If waiting days] < 15, "0-2 Weeks",
			[If waiting days] < 29 && [If waiting days] > 14, "2-4 Weeks",
			[If waiting days] < 43 && [If waiting days] > 28, "4-6 Weeks", 
			[If waiting days] < 57 && [If waiting days] > 42, "6-8 Weeks", 
			[If waiting days] < 71 && [If waiting days] > 56, "8-10 Weeks", 
			[If waiting days] < 85 && [If waiting days] > 70, "10-12 Weeks", 
			[If waiting days] < 99 && [If waiting days] > 84, "12-14 Weeks", 
			[If waiting days] < 113 && [If waiting days] > 98, "14-16 Weeks", 
			[If waiting days] < 127 && [If waiting days] > 112, "16-18 Weeks", 
			[If waiting days] > 126, "18+ Weeks",
			BLANK())
			
			
			
			```
		lineageTag: 9e9abc32-cc42-4648-b228-96fbca6c97f2

	measure 'Dynamic Measure for Week Waiting Band' = ```
			
			var _0_2_Weeks =
			CALCULATE(
			    COUNTROWS('New Waiting list'),
			    FILTER('New Waiting list',[If waiting week_banding] = "0-2 Weeks"),FILTER('New Waiting list',[If waiting days] > 0)
			)
			
			var _test =
			COUNTROWS(
			    FILTER('New Waiting list',[If waiting week_banding] = "0-2 Weeks")
			)
			
			VAR _2_4_Weeks = 
			COUNTROWS(
			    FILTER('New Waiting list',[If waiting week_banding] = "2-4 Weeks")
			)
			
			VAR _4_6_Weeks = 
			COUNTROWS(
			    FILTER('New Waiting list',[If waiting week_banding] = "4-6 Weeks")
			)
			
			VAR _6_8_Weeks = 
			COUNTROWS(
			    FILTER('New Waiting list',[If waiting week_banding] = "6-8 Weeks")
			)
			
			VAR _8_10_Weeks = 
			COUNTROWS(
			    FILTER('New Waiting list',[If waiting week_banding] = "8-10 Weeks")
			)
			
			VAR _10_12_Weeks = 
			COUNTROWS(
			    FILTER('New Waiting list',[If waiting week_banding] = "10-12 Weeks")
			)
			
			VAR _12_14_Weeks = 
			COUNTROWS(
			    FILTER('New Waiting list',[If waiting week_banding] = "12-14 Weeks")
			)
			
			VAR _14_16_Weeks = 
			COUNTROWS(
			    FILTER('New Waiting list',[If waiting week_banding] = "14-16 Weeks")
			)
			
			VAR _16_18_Weeks = 
			COUNTROWS(
			    FILTER('New Waiting list',[If waiting week_banding] = "16-18 Weeks")
			)
			
			VAR _18_Weeks = 
			COUNTROWS(
			    FILTER('New Waiting list',[If waiting week_banding] = "18+ Weeks")
			)
			
			
			RETURN
			SWITCH(
			    SELECTEDVALUE('Week Waiting Reference'[Type]),
			    "0-2 Weeks", _0_2_Weeks,
			    "2-4 Weeks", _2_4_Weeks,
			    "4-6 Weeks", _4_6_Weeks,
			    "6-8 Weeks", _6_8_Weeks,
			    "8-10 Weeks", _8_10_Weeks,
			    "10-12 Weeks", _10_12_Weeks,
			    "12-14 Weeks", _12_14_Weeks,
			    "14-16 Weeks", _14_16_Weeks,
			    "16-18 Weeks", _16_18_Weeks,
			    "18+ Weeks", _18_Weeks
			)
			```
		formatString: 0
		lineageTag: e9adc319-8321-4c23-944f-46f704aaf73c

