	measure GHFT_Inpatient_Cost = ```
			
			    CALCULATE(
			        SUM('Inpatients'[spell_commissioning_tariff_calculation_final_price]), 
			        'Inpatients'[Provider_Code] = "RTE",
			        REMOVEFILTERS('Inpatients'[Provider_Name], 'Inpatients'[Provider]) ) + 0
			```
		lineageTag: 1c2a4bf3-433e-4712-8fd0-c80dd7447ecd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Other_Inpatient_Cost = ```
			
