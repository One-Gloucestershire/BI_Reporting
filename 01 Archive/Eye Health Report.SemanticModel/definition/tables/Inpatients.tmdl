table Inpatients
	lineageTag: 62f3e750-7bf1-4a03-a18b-3fa75a9aa2ea

	measure 'KPI Inpt YTD Latest' = ```
			
			VAR _CurrentFY = 'Inpatients Date Table'[IPCurrentFY]
			RETURN 
			CALCULATE(
			    SUM('Inpatients'[Counter]),
			    'Inpatients Date Table'[ytd_flag] = 1,
			    'Inpatients Date Table'[financial_year] = _CurrentFY ) +0
			```
		formatString: 0
		lineageTag: 5885d72b-66c4-46a8-bb3b-972e6d9559ce

	measure 'KPI Inpt YTD Previous' = ```
			
			VAR _PreviousFY = 'Inpatients Date Table'[IPPreviousFY]
