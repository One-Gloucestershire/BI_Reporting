table 'Inpatients Date Table'
	lineageTag: 03a7653e-0003-4780-9fa6-4e9775fcdfbd

	measure IPCurrentFY =
			
			MAX('Inpatients Date Table'[financial_year])  // Automatically detect the latest FY
		lineageTag: ddd34f3b-9caf-4b65-8155-aa59912250e6

	measure IPPreviousFY =
			
			VAR TodayDate = TODAY()
			VAR CurrentYear = YEAR(TodayDate)
			VAR CurrentMonth = MONTH(TodayDate)
			RETURN
			    IF(
			        CurrentMonth >= 4,
			        FORMAT(CurrentYear - 1, "0000") & "/" & RIGHT(FORMAT(CurrentYear, "0000"), 2),
			        FORMAT(CurrentYear - 2, "0000") & "/" & RIGHT(FORMAT(CurrentYear - 1, "0000"), 2)
			    )
		lineageTag: da221ce2-63f5-4839-a85f-aa91cbbd5ef4

	measure IPPreviousPreviousFY =
			
			VAR TodayDate = TODAY()
			VAR CurrentYear = YEAR(TodayDate)
			VAR CurrentMonth = MONTH(TodayDate)
			RETURN
			    IF(
			        CurrentMonth >= 4,
			        FORMAT(CurrentYear - 2, "0000") & "/" & RIGHT(FORMAT(CurrentYear -1, "0000"), 2),
			        FORMAT(CurrentYear - 3, "0000") & "/" & RIGHT(FORMAT(CurrentYear - 2, "0000"), 2)
			    )
		lineageTag: 9b2fcee2-d895-4bcd-808b-476bd83e6894

