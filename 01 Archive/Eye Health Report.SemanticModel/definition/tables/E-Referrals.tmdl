table E-Referrals
	lineageTag: 5e63965f-71ed-4589-8975-acf814382a89

	measure 'KPI Latest month' = CALCULATE(COUNT('E-Referrals'[counter]), 'E-Referrals Date Table'[latest_month_flag] = 1 )
		formatString: 0
		lineageTag: a0439867-2f16-4550-a61e-ee4da74f711f

	measure 'KPI Previous Month' = CALCULATE(SUM('E-Referrals'[counter]), 'E-Referrals Date Table'[previous_month_flag])
		formatString: 0
		lineageTag: ba86a063-2053-46c6-ad7b-ee96c03bf614

	measure 'KPI YTD Latest' = ```
			
			VAR _CurrentFY = 'E-Referrals Date Table'[ERCurrentFY]
			RETURN 
			CALCULATE(
			    SUM('E-Referrals'[Counter]),
			    'E-Referrals Date Table'[ytd_flag] = 1,
			    'E-Referrals Date Table'[financial_year] = _CurrentFY )
			```
		formatString: 0
		lineageTag: 129fe4f6-f180-469d-b764-7b6b9442f9e5

	measure 'KPI Month Diff' = CALCULATE(([KPI Latest month] - [KPI Previous Month])/ [KPI Previous Month])
		lineageTag: cacb65e5-569e-43d3-beb3-40d5384246bb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'KPI YTD Previous' = ```
			
			VAR _PreviousFY = 'E-Referrals Date Table'[ERPreviousFY]
			RETURN 
			CALCULATE(
			    SUM('E-Referrals'[Counter]),
			    'E-Referrals Date Table'[ytd_flag] = 1,
			    'E-Referrals Date Table'[financial_year] = _PreviousFY )
			```
		formatString: 0
		lineageTag: 0f9bc841-0304-4a0e-a125-70ca2a171eca

	measure 'KPI YTD Diff' = CALCULATE(([KPI YTD Latest] - [KPI YTD Previous])/ [KPI YTD Previous])
		lineageTag: fc6da089-ece5-4fd8-ae40-29449fc64607

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'EREF Year to Date' = CALCULATE(SUM('E-Referrals'[counter]), 'E-Referrals Date Table'[ytd_flag] = 1)
		formatString: 0
		lineageTag: 0d11bc1e-686a-41ae-a107-f24b1e66998f

	measure 'KPI 12M Previous' = CALCULATE(SUM('E-Referrals'[counter]), 'E-Referrals Date Table'[previous_12_months_flag] = 1)
		formatString: 0
		lineageTag: 00c47077-14e2-4253-91ef-016e84eeaece

	measure 'KPI 12M Latest' = CALCULATE(SUM('E-Referrals'[counter]), 'E-Referrals Date Table'[latest_12_months_flag] = 1)
		formatString: 0
		lineageTag: d03b439b-3a0d-4b8d-8162-1d9e77109a44

	measure 'KPI 12M Diff' = ([KPI 12M Latest] - [KPI 12M Previous]) + 0
		formatString: 0
		lineageTag: efef7ee4-4d53-4691-a34e-d3c419ba2b01

	measure 'KPI SameM Last' = CALCULATE(SUM('E-Referrals'[counter]), 'E-Referrals Date Table'[same_month_last_year_flag] = 1)
		formatString: 0
		lineageTag: 2ee1335c-735a-4e90-acac-adeb75f1927f

	measure 'KPI SameM Diff' = ([KPI Latest month] - [KPI SameM Last]) +0
		formatString: 0
		lineageTag: e6b215b1-b450-4d90-97ca-9383a5baaa9f

	measure 'SPC E-ref Mean' = ```
			
			VAR FilteredTable = 
			    CALCULATETABLE(
			        'A&G Date Table',
			        ALL('A&G Date Table'),
			        'A&G Date Table'[SPC_flag] = 1
			    )
			
			VAR SummaryTable = 
			    SUMMARIZE( 
			       FilteredTable,
			       [Financial Year],
			       [month_name],
			       "total_E_refs", COALESCE(SUM('E-Referrals'[counter]),0) 
			    )
			
			VAR AverageRate =    
			    AVERAGEX(
			        SummaryTable,
			        COALESCE([total_E_refs],0)  -- Use the already calculated column instead of recalculating SUM
			    )
			
			RETURN
			    AverageRate
			
			
			```
		lineageTag: cca69ce7-d40f-469a-8a81-5b50236f0bef

		annotation PBI_FormatHint = {"isGeneralNumber":true}

