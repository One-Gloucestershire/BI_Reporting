	partition ICB_populations = m
		mode: import
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "PowerBI_Reporting", [Query="-- Pulls data from one table only. UNIONs use group bys to add England and SW average rows. #(lf)-- ICB level data#(lf)SELECT Extract_Date AS MonthExtracted, FinancialYear, #(lf)UPPER(REPLACE(REPLACE(ICB_Name,'Integrated Care Board','ICB'),'Â','')) AS ICB_Name, #(lf)UPPER(Region_Code) AS Region_Code, UPPER(Region_Name) AS Region_Name, #(lf)SUM([Population]) AS [Population]#(lf)FROM [PowerBI_Reporting].[primarycare].[tbl09_National_ICB_Populations]#(lf)WHERE Extract_Date >= '2023-04-01'#(lf)AND MONTH(Extract_Date) = 4#(lf)GROUP BY ICB_Name, Extract_Date, FinancialYear, UPPER(Region_Code), Region_Name#(lf)#(lf)UNION -- England average#(lf)#(lf)SELECT Extract_Date AS MonthExtracted, FinancialYear, #(lf)'ENGLAND' AS ICB_Name, 'ENG' AS Region_Code, 'ENGLAND' AS Region_Name, #(lf)SUM([Population]) AS [Population]#(lf)FROM [PowerBI_Reporting].[primarycare].[tbl09_National_ICB_Populations]#(lf)WHERE Extract_Date >= '2023-04-01'#(lf)AND MONTH(Extract_Date) = 4#(lf)GROUP BY Extract_Date, FinancialYear#(lf)#(lf)UNION -- South West region average#(lf)#(lf)SELECT Extract_Date AS MonthExtracted, FinancialYear, #(lf)UPPER(Region_Name) AS ICB_Name, UPPER(Region_Code) AS Region_Code, UPPER(Region_Name) AS Region_Name, #(lf)SUM([Population]) AS [Population]#(lf)FROM [PowerBI_Reporting].[primarycare].[tbl09_National_ICB_Populations]#(lf)WHERE Extract_Date >= '2023-04-01'#(lf)AND MONTH(Extract_Date) = 4#(lf)AND UPPER(Region_Code) = 'Y58'#(lf)GROUP BY Extract_Date, FinancialYear, UPPER(Region_Code), Region_Name#(lf);"])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

