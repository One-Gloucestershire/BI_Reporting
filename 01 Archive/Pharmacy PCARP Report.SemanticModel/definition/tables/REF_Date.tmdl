	partition REF_Date = m
		mode: import
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "CCG_Reference", [Query="DECLARE @startdate DATE = (SELECT MIN(Consultation_Month) FROM PowerBI_Reporting.primarycare.[tbl07_Pharm_Consultations])#(lf)DECLARE @enddate DATE = (SELECT MAX(Consultation_Month) FROM PowerBI_Reporting.primarycare.[tbl07_Pharm_Consultations])#(lf)#(lf)SELECT #(lf)Month_Start#(lf), Year_Month#(lf), Cal_Year#(lf), CONCAT('20',Fin_Year_yy_yy) AS FinancialYear#(lf), Fin_Year_First_Part#(lf), Month_No#(lf), Fin_Month_No#(lf), Month_Name#(lf), Month_Short_Name#(lf), CONCAT(Month_Short_Name,'-',Cal_Year) AS MonthYearName#(lf), CONCAT(Month_Name,' ',Cal_Year) AS MonthYearName2#(lf), CONCAT(DATENAME(MONTH,GETDATE()),' ',YEAR(GETDATE())) AS RefreshMonthYear#(lf), ComparisonMonth = DATEDIFF(m,Month_Start,@enddate)#(lf)FROM [DSCRO_NATIONAL_LOOKUPS].[dbo].[ref_Dates]#(lf)WHERE Full_Date >= @startdate#(lf)AND Full_Date <= @enddate#(lf)AND Full_Date = Month_Start#(lf)ORDER BY Full_Date#(lf);"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

