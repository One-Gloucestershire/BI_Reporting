	partition ICB_populations_childbearing = m
		mode: import
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "BIReports", [Query="DECLARE @AGE1 INT = 15#(lf)DECLARE @AGE2 INT = 55#(lf)#(lf)SELECT #(lf)  MonthExtracted = t1.EXTRACT_DATE#(lf), t2.FinancialYear#(lf), ICB_Name = UPPER(REPLACE(REPLACE(t2.ICB_Name,'Integrated Care Board','ICB'),'Â','')) #(lf), Region_Code = UPPER(t2.Region_Code) #(lf), Region_Name = UPPER(t2.Region_Name)#(lf), t1.SEX#(lf), AGE = CONCAT(CAST(@AGE1 AS VARCHAR), '-', CAST(@AGE2 AS VARCHAR))#(lf), [Population] = SUM(t1.NUMBER_OF_PATIENTS)#(lf)FROM BIReports.dbo.ICB_populations t1#(lf)LEFT JOIN [PowerBI_Reporting].[primarycare].[tbl09_National_ICB_Populations] t2#(lf)#(tab)ON t1.SUB_ICB_LOCATION_CODE = t2.SUB_ICB_Code AND t1.EXTRACT_DATE = t2.Extract_Date#(lf)#(lf)WHERE SEX = 'FEMALE'#(lf)#(tab)AND LEFT(AGE,1) IN ('1','2','3','4','5')#(lf)#(tab)AND CAST(AGE AS INT) >= @AGE1#(lf)#(tab)AND CAST(AGE AS INT) <= @AGE2#(lf)GROUP BY t1.EXTRACT_DATE, t2.FinancialYear, t1.SUB_ICB_LOCATION_CODE, t2.ICB_Name, t2.Region_Code, t2.Region_Name, t1.SEX#(lf)#(lf)UNION #(lf)#(lf)SELECT #(lf)  MonthExtracted = t1.EXTRACT_DATE, t2.FinancialYear#(lf), ICB_Name = 'ENGLAND' #(lf), Region_Code = 'ENG' #(lf), Region_Name = 'ENGLAND'#(lf), t1.SEX#(lf), AGE = CONCAT(CAST(@AGE1 AS VARCHAR), '-', CAST(@AGE2 AS VARCHAR))#(lf), [Population] = SUM(t1.NUMBER_OF_PATIENTS)#(lf)FROM BIReports.dbo.ICB_populations t1#(lf)LEFT JOIN [PowerBI_Reporting].[primarycare].[tbl09_National_ICB_Populations] t2#(lf)#(tab)ON t1.SUB_ICB_LOCATION_CODE = t2.SUB_ICB_Code AND t1.EXTRACT_DATE = t2.Extract_Date#(lf)#(lf)WHERE SEX = 'FEMALE'#(lf)#(tab)AND LEFT(AGE,1) IN ('1','2','3','4','5')#(lf)#(tab)AND CAST(AGE AS INT) >= @AGE1#(lf)#(tab)AND CAST(AGE AS INT) <= @AGE2#(lf)GROUP BY t1.EXTRACT_DATE, t2.FinancialYear, t1.SEX#(lf)#(lf)UNION #(lf)#(lf)SELECT #(lf)  MonthExtracted = t1.EXTRACT_DATE, t2.FinancialYear#(lf), ICB_Name = UPPER(Region_Name) #(lf), Region_Code = UPPER(Region_Code)#(lf), Region_Name = UPPER(Region_Name) #(lf), t1.SEX#(lf), AGE = CONCAT(CAST(@AGE1 AS VARCHAR), '-', CAST(@AGE2 AS VARCHAR))#(lf), [Population] = SUM(t1.NUMBER_OF_PATIENTS)#(lf)FROM BIReports.dbo.ICB_populations t1#(lf)LEFT JOIN [PowerBI_Reporting].[primarycare].[tbl09_National_ICB_Populations] t2#(lf)#(tab)ON t1.SUB_ICB_LOCATION_CODE = t2.SUB_ICB_Code AND t1.EXTRACT_DATE = t2.Extract_Date#(lf)#(lf)WHERE SEX = 'FEMALE'#(lf)#(tab)AND LEFT(AGE,1) IN ('1','2','3','4','5')#(lf)#(tab)AND CAST(AGE AS INT) >= @AGE1#(lf)#(tab)AND CAST(AGE AS INT) <= @AGE2#(lf)#(tab)AND UPPER(Region_Code) = 'Y58'#(lf)GROUP BY t1.EXTRACT_DATE, t2.FinancialYear, UPPER(Region_Code), Region_Name, t1.SEX#(lf);"])
