table PF_Consultation_Source_ICB
	lineageTag: 6c4e1c6a-9c11-4e1a-a0db-77c7c79562f4

	measure 'GP referrals per 100k population' =
			
			DIVIDE(
				SUM('PF_Consultation_Source_ICB'[GP Practice])*100000,
				SUM('ICB_populations_FYtoMonth'[Population])
			)
		lineageTag: 5b72ff41-9691-4065-98b8-0fcefbe3cfb7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Self referrals per 100k population' =
			
			DIVIDE(
				SUM('PF_Consultation_Source_ICB'[Self referral])*100000,
				SUM('ICB_populations_FYtoMonth'[Population])
			)
		lineageTag: 14aad2ca-e67c-4c5f-a70f-3f2eb5cfe37e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

