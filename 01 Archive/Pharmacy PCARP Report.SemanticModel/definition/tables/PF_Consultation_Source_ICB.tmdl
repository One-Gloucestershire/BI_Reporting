	partition PF_Consultation_Source_ICB = m
		mode: import
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "BIReports", [Query="-- Pulls data from one table only. UNIONs use group bys to add England and SW average rows. #(lf)-- ICB level data#(lf)SELECT #(lf)  [Region Code]#(lf), [Region Name]#(lf), [ICB Code]#(lf), [ICB Name]#(lf), [Consultation_Month]#(lf), [Pathway]#(lf), [Ambulance Service]#(lf), [Emergency Department]#(lf), [GP Practice]#(lf), [NHS 111]#(lf), [Other]#(lf), [Self referral]#(lf), [Signposted]#(lf), [Urgent Treatment Centre]#(lf), [Walk in Centre]#(lf), [Total]#(lf)FROM [BIReports].dbo.PharmFirst_Consultation_Source_ICB#(lf)#(lf)UNION -- England average#(lf)#(lf)SELECT #(lf)  'ENG' AS [Region Code]#(lf), 'ENGLAND' AS [Region Name]#(lf), 'ENG' AS [ICB Code]#(lf), 'ENGLAND' AS [ICB Name]#(lf), [Consultation_Month]#(lf), [Pathway]#(lf), SUM([Ambulance Service]) AS [Ambulance Service]#(lf), SUM([Emergency Department]) AS [Emergency Department]#(lf), SUM([GP Practice]) AS [GP Practice]#(lf), SUM([NHS 111]) AS [NHS 111]#(lf), SUM([Other]) AS [Other]#(lf), SUM([Self referral]) AS [Self referral]#(lf), SUM([Signposted]) AS [Signposted]#(lf), SUM([Urgent Treatment Centre]) AS [Urgent Treatment Centre]#(lf), SUM([Walk in Centre]) AS [Walk in Centre]#(lf), SUM([Total]) AS [Total]#(lf)FROM [BIReports].dbo.PharmFirst_Consultation_Source_ICB#(lf)GROUP BY [Consultation_Month], [Pathway]#(lf)#(lf)UNION -- South West region average#(lf)#(lf)SELECT #(lf)  [Region Code]#(lf), [Region Name]#(lf), [Region Code] AS [ICB Code]#(lf), [Region Name] AS [ICB Name]#(lf), [Consultation_Month]#(lf), [Pathway]#(lf), SUM([Ambulance Service]) AS [Ambulance Service]#(lf), SUM([Emergency Department]) AS [Emergency Department]#(lf), SUM([GP Practice]) AS [GP Practice]#(lf), SUM([NHS 111]) AS [NHS 111]#(lf), SUM([Other]) AS [Other]#(lf), SUM([Self referral]) AS [Self referral]#(lf), SUM([Signposted]) AS [Signposted]#(lf), SUM([Urgent Treatment Centre]) AS [Urgent Treatment Centre]#(lf), SUM([Walk in Centre]) AS [Walk in Centre]#(lf), SUM([Total]) AS [Total]#(lf)FROM [BIReports].dbo.PharmFirst_Consultation_Source_ICB#(lf)WHERE [Region Code] = 'Y58'#(lf)GROUP BY [Region Code], [Region Name], Consultation_Month, [Pathway];"])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

