		lineageTag: b036a714-7116-48f8-a825-dc114ad9aff2
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'GP Practice' = [Routine_GP Practice] + [Urgent_GP Practice]
		formatString: 0
		lineageTag: cdc009d3-7942-4a01-b2ce-67b509f6f123
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'OOH GP Practice' = [Routine_Out of hours GP] + [Urgent_Out of hours GP]
		formatString: 0
		lineageTag: 3cfec0d8-377b-48df-b0ff-f6fcc5f42e34
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

