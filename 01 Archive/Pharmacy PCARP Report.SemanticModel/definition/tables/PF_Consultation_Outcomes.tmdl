		lineageTag: 9a9ecb55-3fcd-4898-8417-8ac0da27fc71
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Other (MI)' = [Total] - [Not recorded_Advice given only] - [Not recorded_Sale of an Over the Counter (OTC) medicine] - [Routine_GP Practice] - [Urgent_GP Practice] - [Routine_Out of hours GP] - [Urgent_Out of hours GP]
		formatString: 0
		lineageTag: f08b30bb-909f-4206-bd68-37cb70b3196b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

