		summarizeBy: sum
		sourceColumn: #+ OC needed

		annotation SummarizationSetBy = Automatic

	column '£1000 threshold met' = ```
			IF(BundlingPayments[Threshold £1000]=0,BLANK(), -- if threshold doesn't exist then flag = blank
			                        IF(BundlingPayments[Clinical pathways consultation]>=BundlingPayments[Threshold £1000] -- elif threshold does exist compare to PF CP consultations. 
			                        ,1,0) 
			                        )
			```
		formatString: 0
		lineageTag: 601bbf76-abb4-4706-8822-cd1342197f45
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column '£500 threshold met' = ```
			IF(BundlingPayments[Threshold £500]=0,BLANK(), -- if threshold doesn't exist then flag = blank
			                        IF(BundlingPayments[Clinical pathways consultation]>=BundlingPayments[Threshold £500] -- elif threshold does exist compare to PF CP consultations. 
			                        ,1,0) 
			                        )
			```
		formatString: 0
		lineageTag: 9deb4878-1bd1-4910-b54e-a629f8c99080
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Bundling opt req met' = ```
			IF(BundlingPayments[Bundling opt in needed]=0,BLANK(), -- if threshold doesn't exist then flag = blank
			                        IF(BundlingPayments[AllThreeOpt]=1,1,0) -- elif threshold does exist check AllThreeOpt. 
			                        )
			```
		formatString: 0
		lineageTag: 8357aea5-28dc-4559-9fdf-018271a868d1
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'ABPM req met' =
			IF(BundlingPayments[1+ ABPM needed]=0,BLANK(), -- if threshold doesn't exist then flag = blank
			                    IF(BundlingPayments[ABPM]>=1,1,0) -- elif threshold does exist check ABPM for consultations.
			                    )
		formatString: 0
		lineageTag: 8c9aa59c-0588-4052-abe4-b5be67fe6818
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'OC req met' =
			IF(BundlingPayments[#+ OC needed]=0,BLANK(), -- if threshold doesn't exist then flag = blank
			                        IF(BundlingPayments[OC_Total]>=10000,1,0) -- elif threshold does exist check OC_Total for consultations. Note threshold unknown currently.
			                        )
		formatString: 0
		lineageTag: 8be1a598-89cb-4dcf-8c1f-cfd4018597b0
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Jun25_£1000_met = ```
			IF(BundlingPayments[AllThreeOpt] = 1 
			                    && BundlingPayments[Clinical pathways consultation] >= 30
			                    , 1) 
			```
		formatString: 0
		lineageTag: f012a120-14b6-46d0-b769-0efbf9b58204
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Jun25_£500_met = ```
			IF(BundlingPayments[AllThreeOpt] = 1 
			                    && BundlingPayments[Clinical pathways consultation] >= 20 
			                    && BundlingPayments[Clinical pathways consultation] < 30
			                    , 1) 
			```
		formatString: 0
		lineageTag: b75a5e7d-1bc5-4770-9b0d-fc08226b8c92
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Oct25_£1000_met = ```
			IF(BundlingPayments[AllThreeOpt] = 1 
			                    && BundlingPayments[Clinical pathways consultation] >= 30
			                    && BundlingPayments[ABPM] >= 1
			                    , 1) 
			```
		formatString: 0
		lineageTag: ebe04eed-3bd6-4cb4-a396-ed0e1fd136a2
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Oct25_£500_met = ```
			IF(BundlingPayments[AllThreeOpt] = 1 
			                    && BundlingPayments[Clinical pathways consultation] >= 20 
			                    && BundlingPayments[Clinical pathways consultation] < 30
			                    && BundlingPayments[ABPM] >= 1
			                    , 1) 
			```
		formatString: 0
		lineageTag: ec172222-d623-4c73-81a3-823d7da2e4a3
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Mar26_£500_met = ```
			IF(BundlingPayments[AllThreeOpt] = 1 
			                    && BundlingPayments[Clinical pathways consultation] >= 20 
			                    && BundlingPayments[Clinical pathways consultation] < 30
			                    && BundlingPayments[ABPM] >= 1
			                    && BundlingPayments[OC_Total] >= 5 -- OC threshold not known yet
			                    , 1)
			```
		formatString: 0
		lineageTag: 64e4604b-b03a-48ae-a9c6-ce3ecfec0881
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Mar26_£1000_met = ```
			IF(BundlingPayments[AllThreeOpt] = 1 
			                    && BundlingPayments[Clinical pathways consultation] >= 30
			                    && BundlingPayments[ABPM] >= 1
			                    && BundlingPayments[OC_Total] >= 5 -- OC threshold not known yet
			                    , 1) 
			```
		formatString: 0
		lineageTag: 94c1cf3e-1531-499a-8f08-72e54d891e8e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Payment_May25 =
			
			SWITCH (
			    TRUE (),
			    [£1000 threshold met]=1 , 1000
			)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: ed895796-a611-4d26-a58a-1d29bb16b5f2
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	column Payment_Jun25 =
			
			SWITCH (
			    TRUE (),
			    [Jun25_£1000_met]=1 , 1000,
			    [Jun25_£500_met]=1 , 500
			)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 11253c7c-2921-465b-98c9-5250bfb5fef1
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	column Payment_Oct25 =
			
			SWITCH (
			    TRUE (),
			    [Oct25_£1000_met]=1 , 1000,
			    [Oct25_£500_met]=1 , 500
			)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: c5d3c9ca-6928-4973-9288-3394a3c9cb1f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	column Payment_Mar26 =
			
			SWITCH (
			    TRUE (),
			    [Mar26_£1000_met]=1 , 1000,
			    [Mar26_£500_met]=1 , 500
			)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 6df18daf-7286-4490-92f7-c50ac2dc6425
