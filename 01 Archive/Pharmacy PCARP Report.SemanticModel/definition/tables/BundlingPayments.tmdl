	partition BundlingPayments = m
		mode: import
		source =
				let
				    Source = Table.NestedJoin(Consultations, {"Consultation_Month"}, BundlingPaymentCriteria, {"Month"}, "PF CP Payment thresholds", JoinKind.RightOuter),
				    #"Expanded PF CP Payment thresholds" = Table.ExpandTableColumn(Source, "PF CP Payment thresholds", {"Month", "Threshold £1000", "Threshold £500", "Bundling opt in needed", "1+ ABPM needed", "#+ OC needed"}, {"Month", "Threshold £1000", "Threshold £500", "Bundling opt in needed", "1+ ABPM needed", "#+ OC needed"}),
				    #"Removed Other Columns" = Table.SelectColumns(#"Expanded PF CP Payment thresholds",{"Pharmacy ODS Code", "AllThreeOpt", "ABPM", "OC_Total", "Clinical pathways consultation", "Month", "Threshold £1000", "Threshold £500", "Bundling opt in needed", "1+ ABPM needed", "#+ OC needed"})
				in
				    #"Removed Other Columns"

