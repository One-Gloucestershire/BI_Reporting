	partition REF_ICBs = m
		mode: import
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "BIReports", [Query="SELECT DISTINCT [Region Code], [Region Name], [ICB Code], [ICB Name], #(lf)Benchmarking_Flag = CASE WHEN [ICB Code] IN ('QR1', 'QUY') THEN 'Focus View' END#(lf)FROM BIReports.dbo.Pharm_Consultations_ICB#(lf)#(lf)UNION#(lf)#(lf)SELECT #(lf)  'ENG' AS [Region Code]#(lf), 'ENGLAND' AS [Region Name]#(lf), 'ENG' AS [ICB Code]#(lf), 'ENGLAND' AS [ICB Name]#(lf), Benchmarking_Flag = 'Focus View'#(lf)#(lf)UNION#(lf)#(lf)SELECT   #(lf)  [Region Code]#(lf), [Region Name]#(lf), [Region Code] AS [ICB Code]#(lf), [Region Name] AS [ICB Name]#(lf), Benchmarking_Flag = 'Focus View'#(lf)FROM BIReports.dbo.Pharm_Consultations_ICB#(lf)WHERE [Region Code] = 'Y58'#(lf);"])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

