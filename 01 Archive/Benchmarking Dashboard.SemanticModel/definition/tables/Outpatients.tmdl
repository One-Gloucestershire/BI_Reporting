table Outpatients
	lineageTag: 00b2d75f-95d5-4bcd-9177-12af730c4f14

	measure 'Gloucestershire OP Attendances' =
			
			CALCULATE(
				SUM('Outpatients'[Number of OP Attendances]),
				'Outpatients'[ICB of Registration]
					IN { "NHS GLOUCESTERSHIRE INTEGRATED CARE BOARD" }
			)
		formatString: #,0
		lineageTag: 8606216e-bf15-40a2-8a76-6da5811dd2a5

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "FilteredMeasure"
				}

		changedProperty = FormatString

	measure 'Peer Average OP Attendance Rate' =
			
			AVERAGEX(
				KEEPFILTERS(VALUES('Outpatients'[ICB of Registration])),
				CALCULATE(SUM('Outpatients'[OP Attendance Rate per 1000 (Crude)]))
			)
		lineageTag: d5f44570-f812-4f1b-a331-9fbf78cab7cd

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "AveragePerCategory"
				}

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Peer 1st Quartile OP Attendance Rate' =
			
			PERCENTILEX.INC(
			    KEEPFILTERS(VALUES('Outpatients'[ICB of Registration])),
			    CALCULATE(SUM('Outpatients'[OP Attendance Rate per 1000 (Crude)]))
			,.25)
		lineageTag: e0058834-4284-40ff-9a13-cbe4eddbdfb0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Peer 1st Decile OP Attendance Rate' =
			
			PERCENTILEX.INC(
			    KEEPFILTERS(VALUES('Outpatients'[ICB of Registration])),
			    CALCULATE(SUM('Outpatients'[OP Attendance Rate per 1000 (Crude)]))
			,.10)
		lineageTag: 6fd1fa38-2826-461c-8211-dbdccd2373cb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Peer Average OP Attendance Rate Variance to Glos OP Attendances' =
			
			(VAR __BASELINE_VALUE =
				CALCULATE(
					[Peer Average OP Attendance Rate],
					'Outpatients'[ICB of Registration]
						IN { "NHS GLOUCESTERSHIRE INTEGRATED CARE BOARD" }
				)
			VAR __MEASURE_VALUE = [Peer Average OP Attendance Rate]
			RETURN
				IF(NOT ISBLANK(__MEASURE_VALUE), __MEASURE_VALUE - __BASELINE_VALUE))*-1
		lineageTag: a0f462e0-57b4-48c9-a63a-731c0cc0b515

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gloucestershire OP Attendance Rate' =
			
			CALCULATE(
				SUM('Outpatients'[OP Attendance Rate per 1000 (Crude)]),
				'Outpatients'[ICB of Registration]
					IN { "NHS GLOUCESTERSHIRE INTEGRATED CARE BOARD" }
			)
		lineageTag: 5a8bad19-f2f3-4c3f-ade4-4dfdcff26c82

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "FilteredMeasure"
				}

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Peer 1st Quartile OP Attendance Rate Variance to Glos OP Attendance Rate' =
			
			[Gloucestershire OP Attendance Rate] - [Peer 1st Quartile OP Attendance Rate]
		lineageTag: 47c9a088-8a59-4d75-be25-9f898030a84c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Peer 1st Decile OP Attendance Rate Variance to Glos OP Attendance Rate' =
			
			[Gloucestershire OP Attendance Rate] - [Peer 1st Decile OP Attendance Rate]
		lineageTag: 7ff4fe8c-d0c2-46c8-803e-dcf7e35720ef

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Excess to Peer Average OP Attendances' = [Peer Average OP Attendance Rate Variance to Glos OP Attendances]* 674.37
		formatString: #,0
		lineageTag: 8da28600-ff1e-460f-9029-43660ab53297

	measure 'Excess to Peer 1st Quartile OP Attendances' = [Peer 1st Quartile OP Attendance Rate Variance to Glos OP Attendance Rate]* 674.37
		formatString: #,0
		lineageTag: df93d4ec-f7dd-4757-89bd-18c579400cc4

	measure 'Excess to Peer 1st Decile OP Attendances' = [Peer 1st Decile OP Attendance Rate Variance to Glos OP Attendance Rate]* 674.37
		formatString: #,0
		lineageTag: d32da9c1-e31a-466b-8525-ecd9a65ffc86

	measure 'Excess to Peer Average £ OP Attendances' =
			
			[Excess to Peer Average OP Attendances] * AVERAGE('Outpatients'[Tariff])
		formatString: #,0
		lineageTag: 7c9944cc-bca9-4563-8a16-b84e6c3fa30d

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalMultiplication"
				}

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Excess to Peer 1st Quartile £ OP Attendances' =
			
			[Excess to Peer 1st Quartile OP Attendances] * AVERAGE('Outpatients'[Tariff])
		formatString: #,0
		lineageTag: 29e5bcf6-da03-4b6e-b051-099e886f9c9b

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Excess to Peer 1st Decile £ OP Attendances' =
			
			[Excess to Peer 1st Decile OP Attendances] * AVERAGE('Outpatients'[Tariff])
		formatString: #,0
		lineageTag: 671fcbba-e5b4-44e2-8993-6e227f6cbacb

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Gloucestershire OP DNAs' =
			
			CALCULATE(
				SUM('Outpatients'[Number of OP DNAs]),
				'Outpatients'[ICB of Registration]
					IN { "NHS GLOUCESTERSHIRE INTEGRATED CARE BOARD" }
			)
		formatString: 0
		lineageTag: fa790490-33ea-4d2e-ab94-9e3054ddc21f

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "FilteredMeasure"
				}

		changedProperty = FormatString

	measure 'Gloucestershire OP DNA Rate' =
			
			CALCULATE(
				SUM('Outpatients'[OP DNA Rate]),
				'Outpatients'[ICB of Registration]
					IN { "NHS GLOUCESTERSHIRE INTEGRATED CARE BOARD" }
			)
		lineageTag: 806271eb-e776-45b0-a834-7b0c091a06b4

		extendedProperty MeasureTemplate =
