	column Tariff = IF(OR(Outpatients[New/Follow Up Code]="1 First attendance face to face",Outpatients[New/Follow Up Code]="3 First telephone or telemedicine consultation"),LOOKUPVALUE('OP Tariff Nov 22'[WF01B First Attendance - Single Professional],'OP Tariff Nov 22'[TFC Code],Outpatients[TFC Code]),LOOKUPVALUE('OP Tariff Nov 22'[WF01A Follow Up Attendance - Single Professional],'OP Tariff Nov 22'[TFC Code],Outpatients[TFC Code]))
		formatString: 0
		lineageTag: 3232fb5c-045c-4db2-b68f-cb21dccf17b7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'OP DNA Rate' = DIVIDE(Outpatients[Number of OP DNAs],(Outpatients[Registered Population]/1000))
