table 'ED Attendances'
	lineageTag: 9204ff2d-61b8-4d48-8338-992191a11d6e

	measure 'Total Last FY Attendances' =
			
			CALCULATE(
				SUM('ED Attendances'[Care Home ED Attendances]),
			    'Date Table'[financial_year] = 'Date Table'[Last_FY]
			)
		formatString: 0
		lineageTag: 6a1acf68-6eb7-446b-b622-ccdde90ed3ec

	measure 'CH Current FY YTD Attendances' =
			
			CALCULATE(
				SUM('ED Attendances'[Care Home ED Attendances]),
			   'ED Attendances'[ED attendances year adjusted] = 'ED Attendances'[ED attendances current year]
			)
		formatString: 0
		lineageTag: ce90a0e0-993e-4c6d-b3ca-6fc34fcf7add

	measure 'CH Last FY YTD Attendances' =
			
			CALCULATE(
				SUM('ED Attendances'[Care Home ED Attendances]),
			    'ED Attendances'[ED attendances year adjusted] = 'ED Attendances'[ED attendances previous year]
			)
		formatString: 0
		lineageTag: 7ba4013c-597a-49fb-b1ca-0d8c6c0a8cad

	measure '% Over/Under FY YTD Attendances' = CALCULATE(('ED Attendances'[CH Current FY YTD Attendances] - 'ED Attendances'[CH Last FY YTD Attendances]))/'ED Attendances'[CH Last FY YTD Attendances]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 8fc9da82-a14b-4c7b-872f-2dc9b3d26881

	measure '% non-injurious' = CALCULATE(sum('ED Attendances'[non_injurious_attendance_flag]),'ED Attendances'[Care Home ED Attendances] == 1) /sum('ED Attendances'[Care Home ED Attendances])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9561619f-7e7d-45a6-9b06-de6b83795bdc

	measure 'Non-CH Current FY YTD Attendances' =
			
			CALCULATE(
				SUM('ED Attendances'[counter]),
			    'Date Table'[ytd_flag] IN { 1 },
			    'Date Table'[Current_FY_Flag] in { 1 }
			)
		formatString: 0
		lineageTag: c1eae2f1-5c74-4a96-bc0c-5d112189c499

	measure 'Non-CH Last FY YTD Attendances' =
			
			CALCULATE(
				SUM('ED Attendances'[counter]),
			    'Date Table'[ytd_flag] IN { 1 },
			    'Date Table'[financial_year] = 'Date Table'[Last_FY]
			)
		formatString: 0
		lineageTag: 74169059-b027-4aea-a9ee-f3d982cd4715

	measure '% of attendances from CH year on year comparison' =
			CALCULATE(
			    ('ED Attendances'[CH Current FY YTD Attendances]/('ED Attendances'[All FY YTD Attendances]))
			    -
			    ('ED Attendances'[CH Last FY YTD Attendances]/('ED Attendances'[All LY YTD Attendances])))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4697cf10-db1e-456c-95a1-1cf981c44eba

	measure 'Current FY top 3 attendances codes' = ```
			
			CALCULATE (
			SUM ( 'ED Attendances'[Care Home ED Attendances] ),
			ALLEXCEPT ( 'ED Attendances', 'ED Attendances'[chief_complaint], 'Year to Date Reference'[YTD Reference] ),
			'ED Attendances'[ED attendances year adjusted] = 'ED Attendances'[ED attendances current year]
			)
			
			```
		formatString: 0
		lineageTag: 9e2eb1f1-6f9d-4135-adf2-1a897bdbcb44

	measure 'Last FY top 3 attendances codes' = ```
			
			CALCULATE (
			SUM ( 'ED Attendances'[Care Home ED Attendances] ),
			ALLEXCEPT ( 'ED Attendances', 'ED Attendances'[chief_complaint] ),
			'ED Attendances'[ED attendances year adjusted] = 'ED Attendances'[ED attendances previous year], 'ED Attendances'[ED attendances YTD] = "Year to Date"
			)
			
			```
		formatString: 0
		lineageTag: 1d98d12b-831d-43ab-abe7-cb3d16d7755a

	measure 'Measure 2'
		lineageTag: 53784072-0d1f-4a5a-9e25-5c8c64d21fa3

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	measure 'Current FY top 3 treatment codes' = ```
			
			CALCULATE (
			SUM ( 'ED Attendances'[Care Home ED Attendances] ),
			ALLEXCEPT ( 'ED Attendances', 'ED Attendances'[Treatment_Code] ),
			'Date Table'[Current_FY_Flag] = 1
			)
			
			```
		formatString: 0
		lineageTag: 1a52906f-162f-4217-92b5-3c3f435c07f3

	measure 'Last FY top 3 treatment codes' = ```
			
			CALCULATE (
			SUM ( 'ED Attendances'[Care Home ED Attendances] ),
			ALLEXCEPT ( 'ED Attendances', 'ED Attendances'[Treatment_Code] ),
			'Date Table'[Last_FY_Flag] = 1 && 'Date Table'[ytd_flag] = 1
			)
			
			```
		formatString: 0
		lineageTag: a7cf4ef5-59c5-48fe-8930-86531c3647ac

	measure 'ED Attendance rate per 1000' = IFERROR(CALCULATE((sum('ED Attendances'[Care Home ED Attendances])/'Current Care Home Population'[Current Care Home Patients])*1000),blank())
		formatString: 0
		lineageTag: 15219407-abe7-41ed-a8ae-fcc99fc711ed

	measure 'ED care home patients returned home' =
			
			CALCULATE(
				SUM('ED Attendances'[Care Home ED Attendances]),
				'ED Attendances'[Patient_returned_home] IN { 1 }
			)
		formatString: 0
		lineageTag: 28b43410-c55b-4185-9e57-572b8d74e00e

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "FilteredMeasure"
				}

		changedProperty = FormatString

	measure 'ED Rate per 1000 Yearly' =
			
			
			VAR ED = CALCULATE ( SUM ('ED Attendances'[Care Home ED Attendances] ))
			VAR POP = CALCULATE ( [Care Home Population Per Month]  , ALLEXCEPT ('date table', 'date table'[financial_year] ), 'date table'[month_name] IN {"Apr"} )
			
			RETURN (ED/POP*1000)
		lineageTag: 87698fba-2f87-4599-b543-a82b89b4d90d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ED Rate per 1000 Monthly' =
			
			
			VAR ED = CALCULATE ( SUM ('ED Attendances'[Care Home ED Attendances] ))
			VAR POP = CALCULATE ( [Care Home Population Per Month]  )
			RETURN (ED/POP*1000)
		lineageTag: adfd58ea-fecd-4faa-b562-c6b6b1c1e453

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'LY Reasons ED Rate per 1000 Yearly' =
			
			
			VAR SWAST = [Last FY top 3 attendances codes]
			VAR POP = CALCULATE ( [Care Home Population Per Month]  , ALLEXCEPT ('date table', 'date table'[financial_year] ), 'date table'[month_name] IN {"Apr"}, 'Date table (pop over time)'[Financial year adjusted] = 'Date table (pop over time)'[Care home patient previous year])
			
			
			RETURN (SWAST/POP*1000)
		lineageTag: 400ea009-fffe-4e1b-b084-5996e13bceea

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CY Reasons ED Rate per 1000 Yearly' =
			
			
			VAR SWAST = [Current FY top 3 attendances codes]
			VAR POP = CALCULATE ( [Care Home Population Per Month]  , ALLEXCEPT ('date table', 'date table'[financial_year] ), 'date table'[month_name] IN {"Apr"}, 'Date table (pop over time)'[Financial year adjusted] = 'Date table (pop over time)'[Care home patient previous year])
			
			
			RETURN (SWAST/POP*1000)
		lineageTag: 2065dda4-b164-4d26-bbff-2582193fcce0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'All FY YTD Attendances' =
			
			CALCULATE(
				SUM('ED Attendances'[counter]),
			   'ED Attendances'[ED attendances year adjusted] = 'ED Attendances'[ED attendances current year]
			)
		formatString: 0
		lineageTag: ad87eb73-beec-468a-a8af-24f1d558b9f7

	measure 'All LY YTD Attendances' =
			
			CALCULATE(
				SUM('ED Attendances'[counter]),
			   'ED Attendances'[ED attendances year adjusted] = 'ED Attendances'[ED attendances previous year], 'ED Attendances'[ED attendances YTD] = "Year to Date"
			)
		formatString: 0
		lineageTag: 42bc184d-3f45-4b08-8679-51902df220ad

	measure '% of attendances from CH patients v2' = IFERROR(CALCULATE(sum('ED Attendances'[Care Home ED Attendances])/sum('ED Attendances'[counter])), blank())
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: badf8b4f-9c2c-43a7-8f50-656989ecf6cf

	measure 'Attendance activity y-axis' = ```
			
			
			VAR  rate_or_actual = 
			    if(SELECTEDVALUE('Actual or Rate'[Actual or Rate]) = "Actual Activity", "Actual"
			    ,if(SELECTEDVALUE('Actual or Rate'[Actual or Rate]) = "Rate per 1000", "Rate"))
			
			
			VAR x_axis =
			    SELECTCOLUMNS (
			        SUMMARIZE ( 'Month or Year Parameter', 'Month or Year Parameter'[Month or Year Parameter], 'Month or Year Parameter'[Month or Year Parameter Fields] ),
			        'Month or Year Parameter'[Month or Year Parameter])
			
			RETURN  if(rate_or_actual = "Rate" && x_axis = "Yearly", 'ED Attendances'[ED Rate per 1000 Yearly]
			
			        ,if(rate_or_actual = "Rate" && x_axis = "Monthly", 'ED Attendances'[ED Rate per 1000 Monthly]
			        
			        ,if(rate_or_actual = "Actual", CALCULATE(sum('ED Attendances'[Care Home ED Attendances])))))
			```
		lineageTag: 780aac65-7aca-421e-a4ad-900a0a4757d4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Attendance activity title' = ```
			
			
			VAR  rate_or_actual = 
			    if(SELECTEDVALUE('Actual or Rate'[Actual or Rate]) = "Actual Activity", "Actual"
			    ,if(SELECTEDVALUE('Actual or Rate'[Actual or Rate]) = "Rate per 1000", "Rate"))
			
			
			VAR x_axis =
			    SELECTCOLUMNS (
			        SUMMARIZE ( 'Month or Year Parameter', 'Month or Year Parameter'[Month or Year Parameter], 'Month or Year Parameter'[Month or Year Parameter Fields] ),
			        'Month or Year Parameter'[Month or Year Parameter])
			
			RETURN  if(rate_or_actual = "Rate", "ED Attendances for Care Home Residents - Rate per 1000"
			        ,if(rate_or_actual = "Actual", "ED Attendances for Care Home Residents - Actual Number of Attendances"))
			```
		lineageTag: 827013f4-5ee9-40c8-9d53-010f62bc9343

	measure 'Attendance activity via SWAST title' = ```
			
			
			VAR  rate_or_actual = 
			    if(SELECTEDVALUE('Actual or Rate'[Actual or Rate]) = "Actual Activity", "Actual"
			    ,if(SELECTEDVALUE('Actual or Rate'[Actual or Rate]) = "Rate per 1000", "Rate"))
			
			
			VAR x_axis =
			    SELECTCOLUMNS (
			        SUMMARIZE ( 'Month or Year Parameter', 'Month or Year Parameter'[Month or Year Parameter], 'Month or Year Parameter'[Month or Year Parameter Fields] ),
			        'Month or Year Parameter'[Month or Year Parameter])
			
			RETURN  if(rate_or_actual = "Rate", "ED Attendances via SWAST for Care Home Residents - Rate per 1000"
			        ,if(rate_or_actual = "Actual", "ED Attendances via SWAST for Care Home Residents - Actual Number of Attendances"))
			```
		lineageTag: 3e823af0-bb2f-4142-bd79-7e5e690e0bba

