	column 'ED attendances financial month' = ```
			
			VAR currmonth = MONTH('ED Attendances'[arrival_date])
			VAR cal = SWITCH(TRUE(),
			currmonth = 4, 1,
			currmonth = 5, 2,
			currmonth = 6, 3,
			currmonth = 7, 4,
			currmonth = 8, 5,
