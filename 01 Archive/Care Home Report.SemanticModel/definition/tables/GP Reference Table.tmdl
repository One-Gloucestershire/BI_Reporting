	partition 'GP Reference Table' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "ccg_current", [Query="/****** Script for SelectTopNRows command from SSMS  ******/#(lf)SELECT [Locality]#(lf)      ,[Network]#(lf)      ,[Place]#(lf)      ,[PrimaryCareNetwork]#(lf)      ,[OrganisationCode]#(lf)      ,[OrganisationName]#(lf)      ,[ReportingOrganisationName]#(lf)      ,[ITSystem]#(lf)      ,[NumberOfLocations]#(lf)      ,[NumberOfEnhancedServices]#(lf)      ,[DispensingPractice]#(lf)      ,[DispensingPracticeDescription]#(lf)      ,[ContractType]#(lf)      ,[CoCommissioningModel]#(lf)      ,[OnlineAppointmentsEnabled]#(lf)      ,[OnlineAppointmentsEnabledDescription]#(lf)      ,[OnlinePrescriptionsEnabled]#(lf)      ,[OnlinePrescriptionsEnabledDescription]#(lf)      ,[NationalGrouping]#(lf)      ,[HighLevelHealthGeography]#(lf)      ,[AddressLine1]#(lf)      ,[AddressLine2]#(lf)      ,[AddressLine3]#(lf)      ,[AddressLine4]#(lf)      ,[AddressLine5]#(lf)      ,[Postcode]#(lf)      ,[OpenDate]#(lf)      ,[CloseDate]#(lf)      ,[StatusCode]#(lf)      ,[StatusDescription]#(lf)      ,[OrganisationSubTypeCode]#(lf)      ,[OrganisationSubTypeDescription]#(lf)      ,[Commissioner]#(lf)      ,[JoinProviderPurchaserDate]#(lf)      ,[LeftProviderPurchaserDate]#(lf)      ,[ContactTelephoneNumber]#(lf)      ,[AmendedRecordIndicator]#(lf)      ,[ProviderPurchaser]#(lf)      ,[PrescribingSetting]#(lf)      ,[PrescribingSettingDescription]#(lf)      ,[UpdateDate]#(lf)      ,[ReportingOrganisationCode]#(lf)  FROM [CCG_Reference].[Reference].[vw_GPPractice]#(lf)#(lf)where Locality is not null"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

