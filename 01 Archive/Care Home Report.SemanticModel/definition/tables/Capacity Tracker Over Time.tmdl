table 'Capacity Tracker Over Time'
	lineageTag: e6f5999d-0ae1-443f-8baf-7f840427627d

	measure 'Occupancy %' =
			CALCULATE(
			    (sum('Capacity Tracker Over Time'[Maximum Capacity]) - sum('Capacity Tracker Over Time'[Vacancies (Total)]))
			/CALCULATE(sum('Capacity Tracker Over Time'[Maximum Capacity])))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 268264ca-4305-4d50-8860-b395c14b29b5

