	column 'Months since Training' = ```
			
			var max_date = MAX('SWAST Calls'[SWAST_call_date])
			var min_date = 'CQC Final'[Training date]
			var diff = DATEDIFF(min_date, max_date, DAY)
			return SWITCH(TRUE(),
			diff < 91 && diff > 0, "0-3 months",
			diff < 181 && diff > 90, "3-6 months",
			diff < 271 && diff > 180, "6-9 months",
			diff < 361 &&diff > 270, "9-12 months",
			diff > 361, "12 months",
			"error")
			
