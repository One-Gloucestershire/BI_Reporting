	measure 'Average Daily Calls per Care Home with Training' = ```
			
			//var max_date = DATE(2024,12,31)
			//var min_date_1 = DATE(2024,01,01)
			var calls = CALCULATE(sum('SWAST Calls'[Care Home SWAST Calls]), 
			//'SWAST Calls'[SWAST_call_date] < max_date, 
			'SWAST Calls'[Symptom_Group_Chief_Complaint] = "Falls",
			//'SWAST Calls'[SWAST_call_date] > min_date_1,
			'CQC Final'[Care home training flag] = "Have had training") / 365
			var homes = CALCULATE(DISTINCTCOUNT('CQC Final'[Assigned_name]),'CQC Final'[Care home training flag] = "Have had training")
			RETURN 
			calls / homes
			```
		formatString: 0.0000
		lineageTag: 9a961810-13a4-4206-874a-4c8394bcd9b3

	measure 'Average Daily Calls per Care Home without Training' = ```
			
			//var max_date = DATE(2024,12,31)
			//var min_date_1 = DATE(2024,01,01)
			var calls = CALCULATE(sum('SWAST Calls'[Care Home SWAST Calls]), 
			//'SWAST Calls'[SWAST_call_date] < max_date, 
			'SWAST Calls'[Symptom_Group_Chief_Complaint] = "Falls",
			//'SWAST Calls'[SWAST_call_date] > min_date_1,
			'CQC Final'[Care home training flag] = "Have not had training") / 365
			var homes = CALCULATE(DISTINCTCOUNT('CQC Final'[Assigned_name]),'CQC Final'[Care home training flag] = "Have not had training", 'Care Home Type'[Care Home Type] <> "Closed")
			RETURN 
			calls / homes
			```
		formatString: 0.0000
		lineageTag: c730ec4a-92f1-47cf-959d-3592ae0aab8b

