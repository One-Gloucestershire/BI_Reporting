	measure 'Average Falls per 100 Beds per Day' =
			
			var max_date = ENDOFMONTH('SWAST Calls'[SWAST_call_date])
			var min_date = STARTOFMONTH('SWAST Calls'[SWAST_call_date])
			var diff = DATEDIFF(min_date, max_date, DAY) +1
			var total_hours = CALCULATE(sum('SWAST Calls'[counter]) / SUM('CQC Final'[Bed_count])*100,'SWAST Calls'[Symptom_Group_Chief_Complaint] = "Falls")
			RETURN IFERROR(total_hours / diff, BLANK())
