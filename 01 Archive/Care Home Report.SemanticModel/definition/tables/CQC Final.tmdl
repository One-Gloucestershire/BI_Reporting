	measure 'Average Falls per Day' =
			
			var max_date = ENDOFMONTH('SWAST Calls'[SWAST_call_date])
			var min_date = STARTOFMONTH('SWAST Calls'[SWAST_call_date])
			var diff = DATEDIFF(min_date, max_date, DAY) +1
			var total_hours = CALCULATE(sum('SWAST Calls'[counter]),'SWAST Calls'[Symptom_Group_Chief_Complaint] = "Falls")
			RETURN total_hours / diff
		lineageTag: a68ee448-3e44-41cd-aa30-b73277281efc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Falls' = ```
			
