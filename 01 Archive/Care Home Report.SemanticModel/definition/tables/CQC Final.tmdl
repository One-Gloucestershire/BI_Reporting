	measure 'Average Calls per Week per Care Home post Training 3-6 months measure' =
			
			
			var care_homes = CALCULATE(DISTINCTCOUNT('CQC Final'[Assigned_name]),'CQC Final'[6 months flag] = 1)
			
			var _average = (DIVIDE(SUM([Total Calls post Training 3-6 Months]),13))
			
			RETURN DIVIDE(_average,care_homes)
