	column 'Care home training flag' = IF('CQC Final'[Training datekey] = BLANK(), "Have not had training", "Have had training")
		lineageTag: c40c6a66-b6c5-4137-8780-ae3a4002f935
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Training date' = ```
			DATE(LEFT([Training datekey],4),MID([Training datekey],5,2),RIGHT([Training datekey],2))
			
			```
		formatString: Short Date
		lineageTag: a74fb346-a6b9-4071-9aaa-8ae15bfa0f82
		summarizeBy: none

		variation Variation
			isDefault
			relationship: da0d994f-8d1b-4c66-a3aa-555a94c8f317
			defaultHierarchy: LocalDateTable_40a815c9-005c-4ad1-bdb9-9f1f7343422d.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column 'Total Average Calls per Day post Training' = ```
			
			var max_call = MAX('SWAST Calls'[SWAST_call_date])
			var max_date = IF(DATEDIFF('CQC Final'[Training date], max_call,day) <367, max_call, [12 months since training]) 
			var min_date = 'CQC Final'[Training date]
			var diff = DATEDIFF(min_date, max_date, DAY)
			var total_hours = CALCULATE(sum('SWAST Calls'[Care Home SWAST Calls]), 'SWAST Calls'[SWAST_call_date] > min_date && 'SWAST Calls'[SWAST_call_date] <= max_date, 'SWAST Calls'[Symptom_Group_Chief_Complaint] = "Falls")
			RETURN 
			IF(
			total_hours / diff 
