	partition 'Date Table-704a0eea-2cd4-4538-a00a-bb67b5cfb426' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Reference", [Query="#(lf)#(lf)SET ANSI_WARNINGS OFF#(lf)SET NOCOUNT ON#(lf)if object_id ('tempdb..#FY_flag') is not null drop table #FY_flag#(lf)#(lf)SELECT distinct#(lf)#(lf)[Financial_year_abridged] = SUBSTRING([FinancialYear], 1, 4)#(lf)#(lf),[Current_FY] = case when cast(getdate() as date) = date then FinancialYear END#(lf),financialyear#(lf)#(lf)INTO #FY_flag #(lf)#(lf)FROM [CCG_Reference].[Reference].[vw_DateLookup]#(lf)#(lf)ORDER BY FinancialYear#(lf)#(lf)if object_id ('tempdb..#FY_flag_2') is not null drop table #FY_flag_2#(lf)#(lf)SELECT #(lf)#(lf)[Financial_year_abridged] #(lf),[Current_FY] #(lf),financialyear#(lf),[Last_FY]#(lf)#(lf)INTO #FY_flag_2#(lf)#(lf)FROM #FY_flag#(lf)#(lf)LEFT JOIN#(lf)(SELECT DISTINCT#(lf)[FY_abridged] = SUBSTRING([FinancialYear], 1, 4)#(lf),[Last_FY] = financialyear#(lf)FROM [CCG_Reference].[Reference].[vw_DateLookup]) AS [B] ON [FY_abridged] = [Financial_year_abridged] - 1#(lf)#(lf)WHERE [Current_FY] IS NOT NULL#(lf)#(lf)ORDER BY financialyear#(lf)#(lf)#(lf)SELECT [Date] [date]#(lf)#(tab)  ,[month_number] = DENSE_RANK() over(order by [YearMonth])#(lf)      ,[DayMonthYear] [day_month_year]#(lf)      ,[Day] [day]#(lf)      ,[Weekday] [weekday]#(lf)      ,[WeekDayName] [weekday_name]#(lf)      ,[Month] [month]#(lf)      ,left([MonthName],3) [month_name]#(lf)      ,[Quarter] [quarter]#(lf)      ,[YearMonth] [year_month]#(lf)      ,[IsWeekend] [is_weekend]#(lf)      ,[IsHoliday] [is_holiday]#(lf)      ,[FinancialWeekofYear] [financial_week_of_year]#(lf)      ,[A].[FinancialYear] [financial_year]#(lf)      ,[FinancialQuarter] [financial_quarter]#(lf)      ,[FinancialMonth] [financial_month]#(lf)      ,[MonthYearName] [month_year_name]#(lf)#(lf)      ,[ytd_flag] = CASE WHEN [FinancialMonth] <= (#(lf)                                           SELECT#(lf)                                           CAST([FinancialMonth] AS INT)#(lf)                                           FROM [CCG_Reference].[Reference].[vw_DateLookup]#(lf)                                           WHERE [Date] = EOMONTH(DATEADD(MONTH, -2, GETDATE()))#(lf)                                           )#(lf)                                           THEN 1 ELSE 0 END#(lf)#(tab)      ,[ytd_description] = CASE WHEN [FinancialMonth] <= (#(lf)                                           SELECT#(lf)                                           CAST([FinancialMonth] AS INT)#(lf)                                           FROM [CCG_Reference].[Reference].[vw_DateLookup]#(lf)                                           WHERE [Date] = EOMONTH(DATEADD(MONTH, -2, GETDATE()))#(lf)                                           )#(lf)                                           THEN 'Year to Date' ELSE '' END#(lf)#(tab),[B].[Current_FY]#(lf)#(tab),[C].[Last_FY]#(lf)#(tab),[Current_FY_Flag] = case when [B].[Current_FY] = [A].[FinancialYear] then 1 else 0 END#(lf)#(tab),[Last_FY_Flag] = case when [C].[Last_FY] = [A].[FinancialYear] then 1 else 0 END#(lf)#(tab),[A].DateKey#(lf)#(tab),[Financial_year_order_column] = LEFT(RIGHT([A].[FinancialYear], LEN([A].[FinancialYear]) - 2), 2)#(lf)#(lf)from [CCG_Reference].[Reference].[vw_DateLookup] [A]#(lf)#(lf)LEFT JOIN #FY_flag_2 [B] ON [A].[FinancialYear] = [B].[FinancialYear]#(lf)#(lf)LEFT JOIN #FY_flag_2 [C] ON [A].[FinancialYear] = [C].[Last_FY]#(lf)#(lf)where [Date] >'20160401' "])
				in
				    Source

	annotation PBI_ResultType = Table

