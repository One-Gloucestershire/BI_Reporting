	column 'Months since latest SWAST data' =
			
			
			VAR max_SWAST_date = MAX('SWAST Calls'[SWAST_call_date])
			
			VAR date_dif = DATEDIFF('Date Table'[date],max_SWAST_date,MONTH)
			
			RETURN date_dif
		formatString: 0
