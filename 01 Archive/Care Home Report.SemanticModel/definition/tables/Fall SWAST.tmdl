	measure 'SWAST Fall LD Yearly' =
			
			VAR SWAST = CALCULATE(
				SUM('Fall SWAST'[counter_column]),
				'Fall SWAST'[Care_home_status] IN { "LD" }
			)
			VAR POP = CALCULATE ( [Care Home Population Per Month]  , ALLEXCEPT ('date table', 'date table'[financial_year] ), 'date table'[month_name] IN {"Nov"} )
			
			RETURN (SWAST/POP*1000)
		lineageTag: 90f9dc9a-2d27-4a38-8de0-aecf4827b187

		annotation PBI_FormatHint = {"isGeneralNumber":true}

