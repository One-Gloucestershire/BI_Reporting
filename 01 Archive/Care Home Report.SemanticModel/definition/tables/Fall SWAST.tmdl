	measure 'SWAST Fall Counter' =
			
			CALCULATE(
				SUM('Fall SWAST'[counter_column])
			)
		formatString: 0
		lineageTag: ae09dc43-c818-4bed-8841-e51351831114

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "FilteredMeasure"
