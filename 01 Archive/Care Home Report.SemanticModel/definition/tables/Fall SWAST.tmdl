	column 'Fall SWAST YTD' = ```
			if('Fall SWAST'[Fall SWAST financial month] <= 'Fall SWAST'[Fall SWAST max financial month column], "Year to Date", "Not Year to Date")
			
			```
		lineageTag: 05f471f8-a678-463b-b801-0e30c9b6d303
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Fall SWAST max financial month column' = ```
			
			VAR currmonth = MONTH(MAX('Fall SWAST'[dateofincident]
			))
			VAR cal = SWITCH(TRUE(),
			currmonth = 4, 1,
			currmonth = 5, 2,
			currmonth = 6, 3,
			currmonth = 7, 4,
			currmonth = 8, 5,
			currmonth = 9, 6,
			currmonth = 10, 7,
			currmonth = 11, 8,
			currmonth = 12, 9,
			currmonth = 1, 10,
			currmonth = 2, 11,
			currmonth = 3, 12
			)
			return cal
			
			```
		formatString: 0
		lineageTag: 750a9363-97f0-4039-92c9-6cba2ab07aa4
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Fall SWAST current year' = ```
			
			VAR max_year = YEAR(MAX('Fall SWAST'[dateofincident]))
			VAR max_month = MONTH(MAX('Fall SWAST'[dateofincident]))
			VAR financial_month = SWITCH(TRUE(),
			max_month = 4, 1,
			max_month = 5, 2,
			max_month = 6, 3,
			max_month = 7, 4,
			max_month = 8, 5,
			max_month = 9, 6,
			max_month = 10, 7,
			max_month = 11, 8,
			max_month = 12, 9,
			max_month = 1, 10,
			max_month = 2, 11,
			max_month = 3, 12
			)
			VAR adjust_year = SWITCH(TRUE(),
			max_month = 1, max_year - 1,
			max_month = 2, max_year - 1,
			max_month = 3, max_year - 1,
			max_month = 4, max_year,
			max_month = 5, max_year,
			max_month = 6, max_year,
			max_month = 7, max_year,
			max_month = 8, max_year,
			max_month = 9, max_year,
			max_month = 10, max_year,
			max_month = 11, max_year,
			max_month = 12, max_year
			)
			return adjust_year
			
			```
		formatString: 0
		lineageTag: 93c6bc0e-6969-44cb-a892-e00ed08577b4
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Fall  SWAST year adjusted' = ```
			if(
			    'Fall SWAST'[Fall SWAST financial month] = 10, YEAR('Fall SWAST'[dateofincident]
			) -1, 
			    if('Fall SWAST'[Fall SWAST financial month]= 11, YEAR('Fall SWAST'[dateofincident]
			) -1, 
			    if('Fall SWAST'[Fall SWAST financial month] = 12, YEAR('Fall SWAST'[dateofincident]
			) -1, year('Fall SWAST'[dateofincident]
			))))
			
			```
		formatString: 0
		lineageTag: 4fc14e48-4e13-4d77-9fff-44909fdc49d2
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Fall SWAST previous year' = ```
