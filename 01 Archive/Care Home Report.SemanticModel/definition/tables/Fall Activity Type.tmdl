table 'Fall Activity Type'
	lineageTag: 06541178-590a-47b6-9dde-694d5f71a061

	measure 'Fall activity y-axis' = ```
			
			
			VAR activity_type =
			    SELECTCOLUMNS (
			        SUMMARIZE ( 'Fall Activity Type', 'Fall Activity Type'[Fall Activity Type], 'Fall Activity Type'[Fall Activity Type Fields] ),
			        'Fall Activity Type'[Fall Activity Type])
			
			VAR  rate_or_actual = 
			    if(SELECTEDVALUE('Actual or Rate'[Actual or Rate]) = "Actual Activity", "Actual"
			    ,if(SELECTEDVALUE('Actual or Rate'[Actual or Rate]) = "Rate per 1000", "Rate"))
			
			
			VAR x_axis =
			    SELECTCOLUMNS (
			        SUMMARIZE ( 'Month or Year Parameter', 'Month or Year Parameter'[Month or Year Parameter], 'Month or Year Parameter'[Month or Year Parameter Fields] ),
			        'Month or Year Parameter'[Month or Year Parameter])
			
			RETURN  if(activity_type = "SWAST Calls" && rate_or_actual = "Rate" && x_axis = "Yearly", 'Fall SWAST'[SWAST Fall Rate per 1000 Yearly]
			        ,if(activity_type = "A&E Attendances" && rate_or_actual = "Rate" && x_axis = "Yearly", 'Fall Attendances'[Fall Attendances Rate per 1000 Yearly]
			        ,if(activity_type = "Admissions" && rate_or_actual = "Rate" && x_axis = "Yearly", 'Fall Admissions'[Fall Admissions Rate per 1000 Yearly]
			
			        ,if(activity_type = "SWAST Calls" && rate_or_actual = "Rate" && x_axis = "Monthly", 'Fall SWAST'[SWAST Fall Rate per 1000 Monthly]
			        ,if(activity_type = "A&E Attendances" && rate_or_actual = "Rate" && x_axis = "Monthly", 'Fall Attendances'[Fall Attendances Rate per 1000 Monthly]
			        ,if(activity_type = "Admissions" && rate_or_actual = "Rate" && x_axis = "Monthly", 'Fall Admissions'[Fall Admissions Rate per 1000 Monthly]
			        
			        ,if(activity_type = "SWAST Calls" && rate_or_actual = "Actual", CALCULATE(sum('Fall SWAST'[counter_column]))
			        ,if(activity_type = "A&E Attendances" && rate_or_actual = "Actual", CALCULATE(sum('Fall Attendances'[counter]))
			        ,if(activity_type = "Admissions" && rate_or_actual = "Actual", CALCULATE(sum('Fall Admissions'[counter])))))))))))
			```
		lineageTag: 8584fea4-0050-4d66-854e-c395a3fd366f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Fall activity title' = ```
			
			
			VAR activity_type =
			    SELECTCOLUMNS (
			        SUMMARIZE ( 'Fall Activity Type', 'Fall Activity Type'[Fall Activity Type], 'Fall Activity Type'[Fall Activity Type Fields] ),
			        'Fall Activity Type'[Fall Activity Type])
			
			VAR  rate_or_actual = 
			    if(SELECTEDVALUE('Actual or Rate'[Actual or Rate]) = "Actual Activity", "Actual"
			    ,if(SELECTEDVALUE('Actual or Rate'[Actual or Rate]) = "Rate per 1000", "Rate"))
			
			
			VAR x_axis =
			    SELECTCOLUMNS (
			        SUMMARIZE ( 'Month or Year Parameter', 'Month or Year Parameter'[Month or Year Parameter], 'Month or Year Parameter'[Month or Year Parameter Fields] ),
			        'Month or Year Parameter'[Month or Year Parameter])
			
			RETURN  if(activity_type = "SWAST Calls" && rate_or_actual = "Rate" && x_axis = "Yearly", "Fall SWAST Calls Rate per 1000 (Yearly)"
			        ,if(activity_type = "A&E Attendances" && rate_or_actual = "Rate" && x_axis = "Yearly", "Fall A&E Attendances Rate per 1000 (Yearly)"
			        ,if(activity_type = "Admissions" && rate_or_actual = "Rate" && x_axis = "Yearly", "Fall Admissions Rate per 1000 (Yearly)"
			
			        ,if(activity_type = "SWAST Calls" && rate_or_actual = "Rate" && x_axis = "Monthly", "Fall SWAST Calls Rate per 1000 (Monthly)"
			        ,if(activity_type = "A&E Attendances" && rate_or_actual = "Rate" && x_axis = "Monthly", "Fall A&E Attendances Rate per 1000 (Monthly)"
			        ,if(activity_type = "Admissions" && rate_or_actual = "Rate" && x_axis = "Monthly", "Fall Admissions Rate per 1000 (Monthly)"
			        
			        ,if(activity_type = "SWAST Calls" && rate_or_actual = "Actual" && x_axis = "Yearly", "Fall SWAST Calls Actual Activity (Yearly)"
			        ,if(activity_type = "A&E Attendances" && rate_or_actual = "Actual" && x_axis = "Yearly", "Fall A&E Attendances Actual Activity (Yearly)"
			        ,if(activity_type = "Admissions" && rate_or_actual = "Actual" && x_axis = "Yearly", "Fall Admissions Actual Activity (Yearly)"
			
			        ,if(activity_type = "SWAST Calls" && rate_or_actual = "Actual" && x_axis = "Monthly", "Fall SWAST Calls Actual Activity (Monthly)"
			        ,if(activity_type = "A&E Attendances" && rate_or_actual = "Actual" && x_axis = "Monthly", "Fall A&E Attendances Actual Activity (Monthly)"
			        ,if(activity_type = "Admissions" && rate_or_actual = "Actual" && x_axis = "Monthly", "Fall Admissions Actual Activity (Monthly)"))))))))))))        
			```
		lineageTag: 37e82583-c1ae-4dae-a380-0e360400d3af

