table 'Capacity Tracker Staff Over Time'
	lineageTag: a73e199c-352e-4733-93cc-4ebab52ec4aa

	measure 'Nurse Vacancy Rate %' = ```
			CALCULATE(
			    (SUM('Capacity Tracker Staff Over Time'[NursesAbsentCovid]) + sum('Capacity Tracker Staff Over Time'[NursesAbsentGeneral]))
			    /
			    (SUM('Care Home Staff'[NursesEmployed]) + sum('Capacity Tracker Staff Over Time'[NursesAbsentCovid]) + sum('Capacity Tracker Staff Over Time'[NursesAbsentGeneral])))
			    
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e96927ec-84a1-4f6e-954c-eace08fdfcc4

	measure 'Care Worker Vacancy Rate %' = ```
			CALCULATE(
			    (SUM('Capacity Tracker Staff Over Time'[CareWorkersAbsentGeneral]) + sum('Capacity Tracker Staff Over Time'[CareWorkersAbsentCovid]))
			    /
			    (SUM('Capacity Tracker Staff Over Time'[CareWorkersEmployed]) + sum('Capacity Tracker Staff Over Time'[CareWorkersAbsentGeneral]) + sum('Capacity Tracker Staff Over Time'[CareWorkersAbsentCovid])))
			    
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 5a48d253-c6df-432c-b6be-1e5914802e58

	measure 'Care worker agency to absence ratio' = CALCULATE(SUM('Capacity Tracker Staff Over Time'[AgencyCareWorkersEmployed])/(sum('Care Home Staff'[CareWorkersAbsentCovid]) + sum('Capacity Tracker Staff Over Time'[CareWorkersAbsentGeneral])))
		lineageTag: ffad54ef-2839-47a5-bbdf-b99ea5891ca3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Nurse agency to absence ratio' = CALCULATE(SUM('Capacity Tracker Staff Over Time'[AgencyNursesEmployed])/(sum('Care Home Staff'[NursesAbsentCovid]) + sum('Capacity Tracker Staff Over Time'[NursesAbsentGeneral])))
		lineageTag: 659a9f27-33fc-4a13-850e-5c1181989986

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Care Workers Total Absent' = sum('Care Home Staff'[CareWorkersAbsentCovid]) + sum('Capacity Tracker Staff Over Time'[CareWorkersAbsentGeneral])
		formatString: 0
		lineageTag: 8a61470d-d845-4d1d-9123-087afa65e2b6

	measure 'Nurse Absent General' = sum('Capacity Tracker Staff Over Time'[NursesAbsentCovid]) + sum('Capacity Tracker Staff Over Time'[NursesAbsentGeneral])
		formatString: 0
		lineageTag: 85ab92f7-c8f8-4c3b-ac81-5a4543194d26

