	measure 'TEP %' = CALCULATE(sum('Current Care Home Population'[treatment_escalation_plan_coded_in_current_FY_flag]))/'Current Care Home Population'[Current Care Home Patients]
		formatString: 0.0%;-0.0%;0.0%
