table 'Current Care Home Population'
	lineageTag: d3181770-8025-4965-afb9-a11f760cb743

	measure 'Current Care Home Patients' = DISTINCTCOUNT('Current Care Home Population'[PseudoNHSNumber])
		formatString: 0
		lineageTag: 7a0dea88-3672-42ad-a51e-e0f70d9bbcd3

	measure 'Respect form %' = CALCULATE(sum('Current Care Home Population'[respect_coded_in_current_FY_flag]))/'Current Care Home Population'[Current Care Home Patients]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c44bcca6-e26d-4b1a-ab2c-dfad5081518d

	measure 'SMR %' = CALCULATE(sum('Current Care Home Population'[SMR_coded_in_current_FY_flag]))/'Current Care Home Population'[Current Care Home Patients]
		formatString: 0.0%;-0.0%;0.0%
