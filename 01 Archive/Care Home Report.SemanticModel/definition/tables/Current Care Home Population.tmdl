	measure 'DCP %' = CALCULATE(sum('Current Care Home Population'[dementia_care_plan_coded_in_current_FY_flag]))/'Dementia Care Home Patients'[Current Dementia Care Home Population]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 21da3d2a-031f-4c51-b8ea-f4c45a49dd3f

	measure 'CHV %' = CALCULATE(sum('Current Care Home Population'[care_home_visit_coded_in_current_FY_flag]))/'Current Care Home Population'[Current Care Home Patients]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: dfd64ef1-66f0-45aa-b7e4-c19445d94440

	measure 'PCSP %' = CALCULATE(sum('Current Care Home Population'[PCSP_coded_in_current_FY_flag]))/'Current Care Home Population'[Current Care Home Patients]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 9dfc6bf0-d972-4f67-b4f0-e1777e27c7ad

