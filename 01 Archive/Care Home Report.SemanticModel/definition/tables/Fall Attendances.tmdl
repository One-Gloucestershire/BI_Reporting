	column 'Falls ED attendances max financial month' = ```
			
			VAR currmonth = MONTH(MAX('Fall Attendances'[arrival_date]))
			VAR cal = SWITCH(TRUE(),
			currmonth = 4, 1,
			currmonth = 5, 2,
			currmonth = 6, 3,
			currmonth = 7, 4,
			currmonth = 8, 5,
			currmonth = 9, 6,
			currmonth = 10, 7,
			currmonth = 11, 8,
			currmonth = 12, 9,
			currmonth = 1, 10,
			currmonth = 2, 11,
			currmonth = 3, 12
			)
			return cal
			
			```
		formatString: 0
		lineageTag: c285d711-f934-48bf-b0a5-4073f1641b18
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Fall ED attendances financial month' = ```
			
			VAR currmonth = MONTH('Fall Attendances'[arrival_date]
			)
			VAR cal = SWITCH(TRUE(),
			currmonth = 4, 1,
			currmonth = 5, 2,
			currmonth = 6, 3,
			currmonth = 7, 4,
			currmonth = 8, 5,
			currmonth = 9, 6,
			currmonth = 10, 7,
			currmonth = 11, 8,
			currmonth = 12, 9,
			currmonth = 1, 10,
