table 'Fall Attendances'
	lineageTag: 49b59d14-62df-4d10-a08d-945ad7a3a5ae

	measure 'ED Fall LD Yearly' =
			
			VAR ED = CALCULATE(
				SUM('Fall Attendances'[counter]),
				'Fall Attendances'[Care_home_status] IN { "LD" }
			)
			VAR POP = CALCULATE ( [Care Home Population Per Month]  , ALLEXCEPT ('date table', 'date table'[financial_year] ), 'date table'[month_name] IN {"Nov"} )
			
			RETURN (ED/POP*1000)
		lineageTag: cf353b2d-60a6-4bb9-b6de-d9fd7c3d73b9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ED Fall MH Yearly' =
			
