		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Fall ED attendances YTD' = ```
			if('Fall Attendances'[Fall ED attendances financial month] <= 'Fall Attendances'[Falls ED attendances max financial month], "Year to Date", "Not Year to Date")
			
			```
		lineageTag: e4460055-d72b-4b19-91df-4a7d0d8c165c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Fall ED attendances current year' = ```
			
			VAR max_year = YEAR(MAX('Fall Attendances'[arrival_date]
			))
			VAR max_month = MONTH(MAX('Fall Attendances'[arrival_date]
			))
			VAR financial_month = SWITCH(TRUE(),
			max_month = 4, 1,
			max_month = 5, 2,
			max_month = 6, 3,
			max_month = 7, 4,
			max_month = 8, 5,
			max_month = 9, 6,
			max_month = 10, 7,
			max_month = 11, 8,
			max_month = 12, 9,
			max_month = 1, 10,
			max_month = 2, 11,
			max_month = 3, 12
			)
			VAR adjust_year = SWITCH(TRUE(),
			max_month = 1, max_year - 1,
			max_month = 2, max_year - 1,
			max_month = 3, max_year - 1,
			max_month = 4, max_year,
			max_month = 5, max_year,
			max_month = 6, max_year,
			max_month = 7, max_year,
			max_month = 8, max_year,
			max_month = 9, max_year,
			max_month = 10, max_year,
			max_month = 11, max_year,
			max_month = 12, max_year
			)
			return adjust_year
			
			```
		formatString: 0
		lineageTag: 2f9bd956-4201-468f-b275-3b8e6678e9f2
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Fall ED attendances year adjusted' = ```
			if(
			    'Fall Attendances'[Fall ED attendances financial month] = 10, YEAR('Fall Attendances'[arrival_date]
			) -1, 
			    if('Fall Attendances'[Fall ED attendances financial month]  = 11, YEAR('Fall Attendances'[arrival_date]
			) -1, 
			    if('Fall Attendances'[Fall ED attendances financial month]  = 12, YEAR('Fall Attendances'[arrival_date]
			) -1, year('Fall Attendances'[arrival_date]
			))))
			
			```
		formatString: 0
		lineageTag: 4aa44ca1-a32d-4cd1-a748-32dc640360c1
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Falls ED attendances previous year' = ```
			'Fall Attendances'[Fall ED attendances current year] - 1
			
			```
		formatString: 0
		lineageTag: 8445ff29-3daf-4248-9d65-35e23ee8a626
		summarizeBy: sum

