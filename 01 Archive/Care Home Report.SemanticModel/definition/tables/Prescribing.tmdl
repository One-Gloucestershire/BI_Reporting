	column Processing_Period_Date
		dataType: dateTime
		formatString: General Date
		lineageTag: 2cc74679-4fbf-4bf3-bcfd-fe4e698ba072
		summarizeBy: none
		sourceColumn: Processing_Period_Date

		annotation SummarizationSetBy = Automatic

	column 'Prescribing Financial Year Flag' = ```
			
			VAR max_year = YEAR(MAX('Prescribing'[Processing_Period_Date]
			))
			VAR max_month = MONTH(MAX('Prescribing'[Processing_Period_Date]
			))
			VAR max_financial_month = SWITCH(TRUE(),
			max_month = 4, 1,
			max_month = 5, 2,
			max_month = 6, 3,
			max_month = 7, 4,
			max_month = 8, 5,
			max_month = 9, 6,
			max_month = 10, 7,
			max_month = 11, 8,
			max_month = 12, 9,
			max_month = 1, 10,
			max_month = 2, 11,
			max_month = 3, 12
			)
			VAR current_year = SWITCH(TRUE(),
			max_month = 1, max_year - 1,
			max_month = 2, max_year - 1,
			max_month = 3, max_year - 1,
			max_month = 4, max_year,
			max_month = 5, max_year,
			max_month = 6, max_year,
			max_month = 7, max_year,
			max_month = 8, max_year,
			max_month = 9, max_year,
			max_month = 10, max_year,
			max_month = 11, max_year,
			max_month = 12, max_year
			)
			
			VAR previous_year = current_year - 1
			
			VAR adj_year = YEAR(('Prescribing'[Processing_Period_Date]
			))
			VAR adj_month = MONTH(('Prescribing'[Processing_Period_Date]
			))
			VAR financial_month = SWITCH(TRUE(),
			adj_month = 4, 1,
			adj_month = 5, 2,
			adj_month = 6, 3,
			adj_month = 7, 4,
			adj_month = 8, 5,
			adj_month = 9, 6,
			adj_month = 10, 7,
			adj_month = 11, 8,
			adj_month = 12, 9,
			adj_month = 1, 10,
			adj_month = 2, 11,
			adj_month = 3, 12
			)
			VAR adjusted_year = SWITCH(TRUE(),
			adj_month = 1, adj_year - 1,
			adj_month = 2, adj_year - 1,
			adj_month = 3, adj_year - 1,
			adj_month = 4, adj_year,
			adj_month = 5, adj_year,
			adj_month = 6, adj_year,
			adj_month = 7, adj_year,
			adj_month = 8, adj_year,
			adj_month = 9, adj_year,
			adj_month = 10, adj_year,
			adj_month = 11, adj_year,
			adj_month = 12, adj_year
			)
			
			
			RETURN IF(adjusted_year = current_year, "Current Year", if(adjusted_year = previous_year, "Previous Year", "Other Year"))
			
			```
		lineageTag: 4c56763b-2247-460e-990a-fa15bf585452
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Prescribing YTD' = ```
			
			VAR max_currmonth = MONTH(MAX('Prescribing'[Processing_Period_Date]
			))
			VAR max_cal = SWITCH(TRUE(),
			max_currmonth = 4, 1,
			max_currmonth = 5, 2,
			max_currmonth = 6, 3,
			max_currmonth = 7, 4,
			max_currmonth = 8, 5,
			max_currmonth = 9, 6,
			max_currmonth = 10, 7,
			max_currmonth = 11, 8,
			max_currmonth = 12, 9,
			max_currmonth = 1, 10,
			max_currmonth = 2, 11,
			max_currmonth = 3, 12
			)
			
			
			VAR currmonth = MONTH('Prescribing'[Processing_Period_Date]
			)
			VAR cal = SWITCH(TRUE(),
			currmonth = 4, 1,
			currmonth = 5, 2,
			currmonth = 6, 3,
			currmonth = 7, 4,
			currmonth = 8, 5,
			currmonth = 9, 6,
			currmonth = 10, 7,
			currmonth = 11, 8,
			currmonth = 12, 9,
			currmonth = 1, 10,
			currmonth = 2, 11,
			currmonth = 3, 12
			)
			
			RETURN if(cal <= max_cal, "Year to Date", "Not Year to Date")
			
			```
		lineageTag: 790aeb0f-02bb-453f-bef3-2a27c00e981b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

