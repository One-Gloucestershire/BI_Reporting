table Prescribing
	lineageTag: 08faee75-86a1-42c7-90c4-9dce78fd0a30

	measure 'Cost difference current vs previous year' =
			
			
			var current_year = CALCULATE(SUM('Prescribing'[Item_cost_in_pounds]), Prescribing[Prescribing Financial Year Flag] = "Current Year")
			var previous_year = CALCULATE(SUM('Prescribing'[Item_cost_in_pounds]), Prescribing[Prescribing Financial Year Flag] = "Previous Year")
			
			RETURN current_year - previous_year
		lineageTag: 77197a3d-5616-4336-8955-a4c6581dadad

		annotation PBI_FormatHint = {"isGeneralNumber":true}

