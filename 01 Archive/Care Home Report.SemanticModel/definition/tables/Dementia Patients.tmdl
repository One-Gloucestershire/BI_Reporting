table 'Dementia Patients'
	lineageTag: cb606c25-50bd-464d-9bd8-d9afc16af3a7

	measure 'Dementia Population Per Month' = ```
			
			 
			VAR CurrentDate = MAX('Date table (pop over time)'[Date])
			 
			RETURN
			    CALCULATE(
			        COUNT('Dementia Patients'[pseudo_nhs_number]),
			        'Dementia Patients'[dementia_diagnosis_date] <= CurrentDate,
			        OR (ISBLANK('Dementia Patients'[death_date]),
			        'Dementia Patients'[death_date] >= CurrentDate)
			    
			    )
			```
		formatString: 0
		lineageTag: e13f8f84-675c-4a68-a55f-533fd319627e

	measure 'Current  Diagnosed Dementia Population' = CALCULATE(DISTINCTCOUNT('Dementia Patients'[pseudo_nhs_number]),'Dementia Patients'[death_date] = BLANK())
		formatString: 0
		lineageTag: 92978434-c789-4e53-bc16-28261924143f

	measure '% of dementia patients in a care home' = [Current Dementia Care Home Population] / 'Dementia Patients'[Current  Diagnosed Dementia Population]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: bbe7fa7c-c38d-4c9d-a216-9f5b53588fc5

