table 'Care Home Beds'
	lineageTag: d71ed98d-8075-4ed2-9d13-4d5542efae30

	measure 'Dementia Nursing % Occupied' = IFERROR(CALCULATE(sum('Care Home Beds'[Dementia_Nursing Occupied])/sum('Care Home Beds'[Dementia_Nursing Maximum Capacity])),blank())
