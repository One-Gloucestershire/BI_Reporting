		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Admissions YTD' = ```
			if('Hospital Admissions'[Admissions financial month] <= 'Hospital Admissions'[Admissions max financial month], "Year to Date", "Not Year to Date")
			
			```
		lineageTag: 31c10050-6fea-4be8-b061-8920baa51549
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Admissions current year' = ```
			
			VAR max_year = YEAR(MAX('Hospital Admissions'[DischargeDate_FromHospitalProviderSpell]))
			VAR max_month = MONTH(MAX('Hospital Admissions'[DischargeDate_FromHospitalProviderSpell]))
			VAR financial_month = SWITCH(TRUE(),
			max_month = 4, 1,
			max_month = 5, 2,
			max_month = 6, 3,
			max_month = 7, 4,
			max_month = 8, 5,
			max_month = 9, 6,
			max_month = 10, 7,
			max_month = 11, 8,
			max_month = 12, 9,
			max_month = 1, 10,
			max_month = 2, 11,
			max_month = 3, 12
			)
			VAR adjust_year = SWITCH(TRUE(),
			max_month = 1, max_year - 1,
			max_month = 2, max_year - 1,
			max_month = 3, max_year - 1,
			max_month = 4, max_year,
			max_month = 5, max_year,
			max_month = 6, max_year,
			max_month = 7, max_year,
			max_month = 8, max_year,
			max_month = 9, max_year,
			max_month = 10, max_year,
			max_month = 11, max_year,
			max_month = 12, max_year
			)
			return adjust_year
			
			```
		formatString: 0
		lineageTag: 0a81d5d0-cf11-4b03-8fa8-eb64a337add5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Admission year adjusted' = ```
			if(
			    [Admissions financial month] = 10, YEAR('Hospital Admissions'[DischargeDate_FromHospitalProviderSpell]
			) -1, 
			    if([Admissions financial month] = 11, YEAR('Hospital Admissions'[DischargeDate_FromHospitalProviderSpell]
			) -1, 
			    if([Admissions financial month] = 12, YEAR('Hospital Admissions'[DischargeDate_FromHospitalProviderSpell]
			) -1, year('Hospital Admissions'[DischargeDate_FromHospitalProviderSpell]
			))))
			
			```
		formatString: 0
		lineageTag: 6e681f35-7933-4ab2-80dc-68fe50ffe29b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Admissions previous year' = ```
