	column 'Admissions max financial month' = ```
			
			VAR currmonth = MONTH(MAX('Hospital Admissions'[DischargeDate_FromHospitalProviderSpell]))
			VAR cal = SWITCH(TRUE(),
			currmonth = 4, 1,
			currmonth = 5, 2,
			currmonth = 6, 3,
			currmonth = 7, 4,
			currmonth = 8, 5,
			currmonth = 9, 6,
			currmonth = 10, 7,
			currmonth = 11, 8,
			currmonth = 12, 9,
			currmonth = 1, 10,
			currmonth = 2, 11,
			currmonth = 3, 12
			)
			return cal
			
			```
		formatString: 0
		lineageTag: 5b60f2f7-c8b7-4804-a4dc-632bc0a0d3d9
		summarizeBy: sum

