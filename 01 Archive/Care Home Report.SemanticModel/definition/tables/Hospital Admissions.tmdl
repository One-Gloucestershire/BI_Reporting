	measure 'Admission activity y-axis' = ```
			
			
			VAR  rate_or_actual = 
			    if(SELECTEDVALUE('Actual or Rate'[Actual or Rate]) = "Actual Activity", "Actual"
			    ,if(SELECTEDVALUE('Actual or Rate'[Actual or Rate]) = "Rate per 1000", "Rate"))
			
			
			VAR x_axis =
			    SELECTCOLUMNS (
			        SUMMARIZE ( 'Month or Year Parameter', 'Month or Year Parameter'[Month or Year Parameter], 'Month or Year Parameter'[Month or Year Parameter Fields] ),
			        'Month or Year Parameter'[Month or Year Parameter])
			
			RETURN  if(rate_or_actual = "Rate" && x_axis = "Yearly", 'Hospital Admissions'[Admission Rate per 1000 Yearly]
			
			        ,if(rate_or_actual = "Rate" && x_axis = "Monthly", 'Hospital Admissions'[Admission Rate per 1000 monthly]
			        
			        ,if(rate_or_actual = "Actual", CALCULATE(sum('Hospital Admissions'[Care Home Hospital Admissions])))))
			```
		lineageTag: b772f253-4797-420f-babb-4121999cee9b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Admission activity title' = ```
			
			
			VAR  rate_or_actual = 
			    if(SELECTEDVALUE('Actual or Rate'[Actual or Rate]) = "Actual Activity", "Actual"
			    ,if(SELECTEDVALUE('Actual or Rate'[Actual or Rate]) = "Rate per 1000", "Rate"))
			
			
			VAR x_axis =
			    SELECTCOLUMNS (
			        SUMMARIZE ( 'Month or Year Parameter', 'Month or Year Parameter'[Month or Year Parameter], 'Month or Year Parameter'[Month or Year Parameter Fields] ),
			        'Month or Year Parameter'[Month or Year Parameter])
			
			RETURN  if(rate_or_actual = "Rate", "Hospital Admissions for Care Home Residents - Rate per 1000"
			    ,if(rate_or_actual = "Actual", "Hospital Admissions for Care Home Residents - Actual Number of Admissions"))
			```
		lineageTag: a6d5959b-b32a-43e0-a24e-3f052f9ec381

