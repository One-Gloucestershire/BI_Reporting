table 'Care Home Patients'
	lineageTag: cf588f37-faa0-488b-9ba5-6dae42293a79

	measure 'Care Home Population Per Month' = ```
			
			 
			VAR CurrentDate = MAX('Date table (pop over time)'[Date])
			 
			RETURN
			    CALCULATE(
			        COUNT('Care Home Patients'[PseudoNHSNumber]),
			        'Care Home Patients'[Care_home_date] <= CurrentDate
			        ,'Care Home Patients'[End_date] >= CurrentDate)
			    
			    
			```
		formatString: 0
		lineageTag: 0ec50813-4562-40f1-8861-fd2fcc0decc7

	measure 'Population Trend Line' = ```
			
			 
			VAR Temp_Table =
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED( 'Date Table'[financial_year], 'Date Table'[financial_month],
			                        
			                         'Date Table'[month_name], 'Date Table'[month_number] ),
			            "Value_x", 'Date Table'[month_number],
			            "Value_y", [Care Home Population Per Month]
			        ),
			        AND (
			            NOT ( ISBLANK ( "Value_x" ) ),
			            NOT ( ISBLANK ( "Value_y" ) )
			        )
			    )
			 
			VAR LINESTX_Table =
			    LINESTX(Temp_Table, [Value_y], [Value_x], TRUE)
			VAR Slope =
			    MAXX ( LINESTX_Table, [Slope1] )
			VAR Intercept =
			    MAXX ( LINESTX_Table, [Intercept] )
			 
			RETURN
			    SUMX (
			        DISTINCT ( 'Date Table'[month_number] ),
			        Intercept + Slope * 'Date Table'[month_number]
			    )
			```
		lineageTag: d78abdc5-54b6-4a08-9c60-9e11ede70b57

		annotation PBI_FormatHint = {"isGeneralNumber":true}

