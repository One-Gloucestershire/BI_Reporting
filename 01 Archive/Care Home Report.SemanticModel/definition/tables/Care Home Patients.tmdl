	partition 'Care Home Patients' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "PowerBI_Reporting", [Query="/****** Script for SelectTopNRows command from SSMS  ******/#(lf)select distinct#(lf)c.PseudoNHSNumber#(lf),Care_home_date#(lf),End_date#(lf),Current_patient_flag#(lf),[Derived_Age]#(lf),[PrimaryCareProvider]#(lf)#(lf)from PowerBI_Reporting.CareHomes.tbl01_Population [c]#(lf)#(lf)#(lf)left join #(lf)(#(lf)SELECT#(lf)[max_date] #(lf),[Derived_Age]#(lf),[PrimaryCareProvider]#(lf),[A].[Derived_NHS_Number]#(lf)#(lf)FROM#(lf)(#(lf)SELECT#(lf)[max_date] = MAX(changetimestamp)#(lf),[Derived_NHS_Number]#(lf)FROM#(lf)CCG_Reference.Population.vw_PDS_All#(lf)#(lf)WHERE [PrimaryCareProvider] IS NOT NULL#(lf)#(lf)GROUP BY#(lf)[Derived_NHS_Number]#(lf)) [A]#(lf)#(lf)LEFT JOIN CCG_Reference.Population.vw_PDS_All [B] ON [B].[Derived_NHS_Number] = [A].[Derived_NHS_Number] AND [B].[changetimestamp] = [A].[max_date]#(lf)#(lf)) #(lf)[p] on [p].[Derived_NHS_Number] = [c].[PseudoNHSNumber]#(lf)#(lf)where c.PseudoNHSNumber is not null#(lf)#(lf)order by #(lf)c.PseudoNHSNumber#(lf)"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

