	column 'Rapid response max financial month' = ```
			
			VAR currmonth = MONTH(MAX('Rapid Response'[ReferralRequestReceivedDate]))
			VAR cal = SWITCH(TRUE(),
			currmonth = 4, 1,
			currmonth = 5, 2,
			currmonth = 6, 3,
			currmonth = 7, 4,
			currmonth = 8, 5,
			currmonth = 9, 6,
			currmonth = 10, 7,
			currmonth = 11, 8,
			currmonth = 12, 9,
			currmonth = 1, 10,
			currmonth = 2, 11,
			currmonth = 3, 12
			)
			return cal
			
			```
		formatString: 0
		lineageTag: bd98a765-33bd-41cb-9f8b-33ab8082c462
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Rapid response financial month' = ```
			
			VAR currmonth = MONTH('Rapid Response'[ReferralRequestReceivedDate]
			)
			VAR cal = SWITCH(TRUE(),
			currmonth = 4, 1,
			currmonth = 5, 2,
			currmonth = 6, 3,
			currmonth = 7, 4,
			currmonth = 8, 5,
			currmonth = 9, 6,
			currmonth = 10, 7,
			currmonth = 11, 8,
			currmonth = 12, 9,
			currmonth = 1, 10,
