table 'Rapid Response'
	lineageTag: dd101c09-ac68-4888-9d85-d20c4af79d08

	measure 'RR Rate per 1000 Monthly' = ```
			
			
			VAR RR = CALCULATE ( SUM ('Rapid Response'[Care Home Rapid Response] ))
			VAR POP = [Care Home Population Per Month] 
			
			RETURN (RR/POP*1000)
			```
		lineageTag: ba2705d6-57ae-4247-9f80-9dbdb25c42f5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'RR Rate per 1000 Yearly' =
			
			
			VAR RR = CALCULATE ( SUM ('Rapid Response'[Care Home Rapid Response] ))
			VAR POP = CALCULATE ( [Care Home Population Per Month]  , ALLEXCEPT ('date table', 'date table'[financial_year] ), 'date table'[month_name] IN {"Apr"} )
			RETURN (RR/POP*1000)
		lineageTag: 35c31141-8d69-4363-b470-f6a886876c20

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Current FY top 3 RR codes' =
			
			CALCULATE (
			SUM ( 'Rapid Response'[Care Home Rapid Response] ),
			ALLEXCEPT ( 'Rapid Response', 'Rapid Response'[PrimaryReferralReasonDescription] ),
			'Rapid Response'[Rapid response year adjusted] = 'Rapid Response'[Rapid response current year]
			)
		formatString: 0
		lineageTag: 8f0e5041-d171-477c-9b58-3379b089d24d

	measure 'Last FY top 3 RR codes' = ```
			
			CALCULATE (
			SUM ( 'Rapid Response'[Care Home Rapid Response] ),
			ALLEXCEPT ( 'Rapid Response', 'Rapid Response'[PrimaryReferralReasonDescription] ),
			'Rapid Response'[Rapid response year adjusted] = 'Rapid Response'[Rapid response previous year], 'Rapid Response'[Rapid response YTD] = "Year to Date"
			)
			
			```
		formatString: 0
		lineageTag: c2e3d658-2980-4a35-bf60-6b6248527a6e

	measure 'CY Reasons RR Rate per 1000 Yearly' =
			
			
			VAR SWAST = [Current FY top 3 RR codes]
			VAR POP = CALCULATE ([Care Home Population Per Month] , ALLEXCEPT ('date table', 'date table'[financial_year] ), 'date table'[month_name] IN {"Apr"}, 'Date table (pop over time)'[Financial year adjusted] = 'Date table (pop over time)'[Care home patient current year])
			
			
			
			RETURN (SWAST/POP*1000)
		lineageTag: cdb3ff64-439e-4ac7-9a6f-f85fffe3df85

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'LY Reasons RR Rate per 1000 Yearly' =
			
			
			VAR SWAST = [Last FY top 3 RR codes]
			
			VAR POP = CALCULATE ( [Care Home Population Per Month]  , ALLEXCEPT ('date table', 'date table'[financial_year] ), 'date table'[month_name] IN {"Apr"}, 'Date table (pop over time)'[Financial year adjusted] = 'Date table (pop over time)'[Care home patient previous year])
			
			
			RETURN (SWAST/POP*1000)
		lineageTag: dfb906d4-3839-46d3-926b-fea98788ee67

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% of rapid response from CH patients' = IFERROR(CALCULATE(sum('Rapid Response'[Care Home Rapid Response])/sum('Rapid Response'[Counter])), blank())
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e9795a22-a26f-4b46-a720-1793d1e6f755

	measure 'Rapid Response activity y-axis' = ```
			
			
			VAR  rate_or_actual = 
			    if(SELECTEDVALUE('Actual or Rate'[Actual or Rate]) = "Actual Activity", "Actual"
			    ,if(SELECTEDVALUE('Actual or Rate'[Actual or Rate]) = "Rate per 1000", "Rate"))
			
			
			VAR x_axis =
			    SELECTCOLUMNS (
			        SUMMARIZE ( 'Month or Year Parameter', 'Month or Year Parameter'[Month or Year Parameter], 'Month or Year Parameter'[Month or Year Parameter Fields] ),
			        'Month or Year Parameter'[Month or Year Parameter])
			
			RETURN  if(rate_or_actual = "Rate" && x_axis = "Yearly", 'Rapid Response'[RR Rate per 1000 Yearly]
			
			        ,if(rate_or_actual = "Rate" && x_axis = "Monthly", 'Rapid Response'[RR Rate per 1000 Monthly]
			        
			        ,if(rate_or_actual = "Actual", CALCULATE(sum('Rapid Response'[Care Home Rapid Response])))))
			```
		lineageTag: e3c21465-b303-4e64-bffb-efd79ca161ba

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'RR activity title' = ```
			
			
			VAR  rate_or_actual = 
			    if(SELECTEDVALUE('Actual or Rate'[Actual or Rate]) = "Actual Activity", "Actual"
			    ,if(SELECTEDVALUE('Actual or Rate'[Actual or Rate]) = "Rate per 1000", "Rate"))
			
			
			VAR x_axis =
			    SELECTCOLUMNS (
			        SUMMARIZE ( 'Month or Year Parameter', 'Month or Year Parameter'[Month or Year Parameter], 'Month or Year Parameter'[Month or Year Parameter Fields] ),
			        'Month or Year Parameter'[Month or Year Parameter])
			
			RETURN  if(rate_or_actual = "Rate", "Rapid Response Referrals for Care Home Residents - Rate per 1000"
			        ,if(rate_or_actual = "Actual", "Rapid Response Referrals for Care Home Residents - Actual Number of Calls"))
			```
		lineageTag: 3adcccf1-3cf9-4ad6-aebc-e35f060c0ca7

