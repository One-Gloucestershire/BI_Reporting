table Data_Sheet
	lineageTag: bd782ecc-0e91-4e69-ae1d-44e609a97f90

	measure 'Metric Output' =
			
			
			AVERAGE(
			    'Data_Sheet'[Value - Amended Format]
			)
		formatString: 0.0
		lineageTag: 08b2ca16-7cec-4c44-b6aa-f93990042902

	measure 'Metric Output - ICB Overall' =
			
			
			CALCULATE(
			    AVERAGE('Data_Sheet'[Value - Amended Format])
			    ,ALL('GP_Reference')
			)
		lineageTag: 129e88c2-7136-495e-969a-25fd0638935f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Metric Colouration' =
			
			
			SWITCH(
			    TRUE()
			    ,[Metric Output] > [Metric Output - ICB Overall], "#20a39e"
			    ,[Metric Output] < [Metric Output - ICB Overall], "#ffba49"
			    ,[Metric Output] = [Metric Output - ICB Overall], "#3d405b"
			)
		lineageTag: 6de21a76-09a9-4bfd-9bfe-bf83bd245dc4

	measure Measure
		lineageTag: edb6f80e-e9fc-4607-aa10-532c957efcc6

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	measure 'Metric Output - ICB' =
			
			
			CALCULATE(
			    AVERAGE('Data_Sheet'[Value - Amended Format])
			    ,ALL('GP_Reference')
			)
		lineageTag: b28f2439-19d9-4e01-a810-ead8c8324699

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Metric Output - % Metrics' =
			
			
			AVERAGE(
			    'Data_Sheet'[Value - Amended Format]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 7b823910-3869-497d-80ca-0e605102c085

	measure 'Metric Output - ICB - %' =
			
			
			CALCULATE(
			    AVERAGE('Data_Sheet'[Value - Amended Format])
			    ,ALL('GP_Reference')
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e4466349-01cf-4e37-8a23-107cdca7fd54

