	column 'Value - Amended Format' =
			
			
			SWITCH(
			    TRUE()
			    ,'Data_Sheet'[Value] = "Yes", 1
			    ,'Data_Sheet'[Value] IN {"No", "No Record"}, 0
			    ,ISNUMBER(VALUE('Data_Sheet'[Value])), VALUE('Data_Sheet'[Value])
			    )
		formatString: 0.00
		lineageTag: 1284df97-c472-4992-9f9a-379ff11e92fb
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

