	partition REF_Age_Band = m
		mode: import
		queryGroup: 'Reference Tables'
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Reference", [Query="select *#(lf),[5YR_Age_Band_Revised] = case when [5YR_Age_Band] = '5-9' THEN '05-9' ELSE [5YR_Age_Band] end #(lf)#(lf)#(lf)from CCG_Reference.Reference.vw_AgeBand#(lf)#(lf)where Age <= 200#(lf)AND Age <> -1#(lf)#(lf)ORDER BY Age"])
