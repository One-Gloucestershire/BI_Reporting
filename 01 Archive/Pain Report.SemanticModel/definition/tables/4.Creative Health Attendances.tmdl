	measure Creative_Health_Attendances_Per_1000_population = ```
			
			
			VAR Latest_GP_Population_date = 
			    CALCULATE(
			        MAX(REF_GP_Practice_Populations[CensusDate_as_date]),
			        NOT(ISBLANK(REF_GP_Practice_Ref[Locality]))
			    )
			
			RETURN
			
			
			calculate((sum('4.Creative Health Attendances'[Attended])/sum(REF_GP_Practice_Populations[Total Population]))*1000,REF_GP_Practice_Populations[CensusDate_as_date] = Latest_GP_Population_date)
			```
		lineageTag: d3c8173e-cf6f-4201-b7e1-e318787f113c

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Gloucestershire_Total_Creative_Health_Attendances_Per_1000_population = ```
			
			
			VAR Latest_GP_Population_date = 
			    CALCULATE(
			        MAX(REF_GP_Practice_Populations[CensusDate_as_date]),
			        NOT(ISBLANK(REF_GP_Practice_Ref[Locality]))
			    )
			
			Var Latest_Gloucestershire_GP_Population_Total = 
			
			calculate(sum(REF_GP_Practice_Populations[Total Population])
			,all(REF_GP_Practice_Populations)
			,REF_GP_Practice_Populations[CensusDate_as_date] = Latest_GP_Population_date)
			
			Var Latest_Gloucestershire_Attended_Total = 
			
			calculate(sum('4.Creative Health Attendances'[Attended])
			,all(REF_GP_Practice_Ref)
			,NOT(ISBLANK(REF_GP_Practice_Ref[OrganisationCode])))
			
			
			RETURN
			
			calculate(IFERROR((Latest_Gloucestershire_Attended_Total/Latest_Gloucestershire_GP_Population_Total)*1000,BLANK())
			)
			```
		lineageTag: 47762127-5f71-4319-9512-442ea4db1411

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Test_GP_Practice_Population_Figure = ```
			
			
			VAR Latest_GP_Population_date = 
			    CALCULATE(
			        MAX(REF_GP_Practice_Populations[CensusDate_as_date]),
			        NOT(ISBLANK(REF_GP_Practice_Ref[Locality]))
			    )
			
			RETURN
			
			
			calculate(SUM('4.Creative Health Attendances'[Attended])
			
			
			,FILTER(ALL(REF_GP_Practice_Ref)
			,NOT(ISBLANK(REF_GP_Practice_Ref[OrganisationCode])))
			
			,ALL(REF_GP_Practice_Populations)
			,REF_GP_Practice_Populations[CensusDate_as_date] = Latest_GP_Population_date
			
			)
			```
		formatString: 0
		lineageTag: d7fd66d3-982d-4fc7-ad87-590c5628b9c1

		changedProperty = IsHidden

	measure Attended_Courses_per_1000_conditional_formatting =
			if([Creative_Health_Attendances_Per_1000_population] > [Gloucestershire_Total_Creative_Health_Attendances_Per_1000_population] ,"#FE7A36"
			    ,"#3652AD")
