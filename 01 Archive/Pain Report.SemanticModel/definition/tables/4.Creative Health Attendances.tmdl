	partition '4.Creative Health Attendances' = m
		mode: import
		queryGroup: 'Creative Health'
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Reference", [Query="#(lf)---DUMMY #(lf)#(lf)select [Place_holder] = 1#(lf),[count] = NULL#(lf),[Completed_programme_flag] = NULL#(lf)#(lf)------Attendance#(lf)#(lf)#(lf)--SELECT  [NHS_Number]#(lf)--,'1' as'count'#(lf)--      ,[Derived_DateofReferral]#(lf)--      --,[Referral_month]#(lf)--      --,[Referral_monthyear]#(lf)--      --,[Referral_fyear]#(lf)--#(tab)  ,date.monthname#(lf)--  ,date.financialyear#(lf)--      --,[GP_Practice_at_Referral]#(lf)--      --,[ReferralPracticeCode]#(lf)--      --,[Network]#(lf)--      ,[Source_of_referral]#(lf)--      ,[Referral_appropriate]#(lf)--      ,[Innapropriate_referral_reason]#(lf)--      ,[Derived_NumberofReferralToEachProgramme]#(lf)--#(tab) ,[Num_of_Referrals_to_each_programme] = ROW_NUMBER () over(partition by NHS_Number, [Programme_name] order by [Derived_DateofReferral], [Derived_ProgrammeStartDate])#(lf)--      ,[Derived_NumberofReferralsTotal]#(lf)--#(tab)  , [Num_of_Referrals_Total] = ROW_NUMBER () over(partition by NHS_Number order by [Derived_DateofReferral], [Derived_ProgrammeStartDate])#(lf)--      ,[Completion_of_personalised_support_plan]#(lf)--      ,[Carer_Family_Attendance]#(lf)--#(tab)  ,case when [Carer_Family_Attendance] in ('Yes', 'Carer') then 'Yes'#(lf)--#(tab)  else [Carer_Family_Attendance] end as 'Carer Family Attendence'#(lf)--      ,[Other_carer_responsibilities]#(lf)--#(tab)   ,case when [Reason_for_disengagment] in ('died', 'Person died', 'Deceased', 'Person died') then 'Person died'#(lf)--#(tab)  when [Reason_for_disengagment] like '%moved%' then 'Person moved away' #(lf)--#(tab)  when  [Reason_for_disengagment] = 'Deterioration in physical/mental state' then 'Deterioration in physical/mental state'#(lf)--#(tab)  when  [Reason_for_disengagment] = 'Inaccessible/time constraints' then 'Inaccessible/time constraints'#(lf)--#(tab)   when  [Reason_for_disengagment] like '%mobility%' then 'Inaccessible/time constraints'#(lf)--#(tab)  when  [Reason_for_disengagment] = 'Person no longer required service' then 'Person no longer required service'#(lf)--#(tab)  when  [Reason_for_disengagment] = 'Person did not consent to referral' then 'Person did not consent to referral'#(lf)--#(tab)  when  [Reason_for_disengagment] = 'Unable to contact' then 'Unable to contact'#(lf)--#(tab)  when  [Reason_for_disengagment] = 'Other reason' then 'Other reason'#(lf)--#(tab)  when  [Reason_for_disengagment] = 'No reason given' then 'Other reason'#(lf)--#(tab)  when [Reason_for_disengagment] like '%attended with%' then 'Family/Carer attendance no longer required'#(lf)--#(tab)  when [Reason_for_disengagment] like '%Support for %' then 'Family/Carer attendance no longer required'#(lf)--#(tab)    when [Reason_for_disengagment] like '%Support to %' then 'Family/Carer attendance no longer required'#(lf)--#(tab)  when [Reason_for_disengagment] = 'Illness' then 'Unwell'#(lf)--#(tab)  when  [Reason_for_disengagment] is Null then Null #(lf)--#(tab)  else [Reason_for_disengagment] end as 'Disengagement Reason' #(lf)--      ,[Programme_name]#(lf)-- ,case when [Programme_name] =  'CYP Pain' then 'CYP LTCs' else [Programme_name] end as 'Course Name' #(lf)--      ,[Programme_provider]#(lf)--#(tab)  ,case when  programme_provider is null and Programme_name = 'Adult Pain' then 'Artlift' else programme_provider end as 'Programme Provider'#(lf)--      ,[Programme_capacity]#(lf)--#(tab)  ,cast([Programme_capacity] as Int) 'Capacity'#(lf)--      ,[Derived_ProgrammeStartDate]#(lf)--      ,[Derived_ProgrammeEndDate]#(lf)--#(tab)  ,cast([Number_of_available_sessions] as Int) 'Available'#(lf)--#(tab)-- ,cast([Number_of_attended_sessions] as int) 'Attended'#(lf)--#(tab) ,[Attended] = case when number_of_attended_sessions = 'attended 3 over 2 terms' then '' else cast([Number_of_attended_sessions] as int) end#(lf)--#(tab) -- ,replace(left(cast([Number_of_attended_sessions] as numeric) / cast([Number_of_available_sessions] as Int)*100,2),'.','') + '%'  as '% attendance'#(lf)--      ,[Reason_for_disengagment]#(lf)#(lf)--#(tab)  ,Reason_for_disengagement2 = case when [Reason_for_disengagment] = '' then 0 else 1 end #(lf)#(lf)#(lf)--    --  ,[Completed_programme_flag] = [Derived_CompletedProgrammeFlag]#(lf)--#(tab)  ,[Completed_programme_flag] = case when [Derived_ProgrammeEndDate]< c.ProcessedDate and Number_of_attended_sessions >= 1 then '1'#(lf)--#(tab)  else '0' END#(lf)--#(tab)  ,case when  [Derived_ProgrammeEndDate] < c.[ProcessedDate] and cast([Number_of_attended_sessions] as int) >= '1' then 'Completed'#(lf)--#(tab)  when [Derived_ProgrammeEndDate] < c.[ProcessedDate] and cast([Number_of_attended_sessions] as int) = '0' then 'Did Not Complete (had a programme start date)'#(lf)--#(tab)  when [Derived_DateofReferral] is not NULL and [Derived_ProgrammeStartDate] is null and [Reason_for_disengagment] is not null then 'Did Not Complete (did not have a programme start date)'#(lf)--#(tab)  else 'Not Yet Completed' end as 'completed programme flag'#(lf)--      --,[Unique_identifier]#(lf)--      ,c.[FileName] -- Nick C: presuming c.filename is correct but don't know#(lf)--      ,c.ProcessedDate#(lf)--#(tab)  ,case when ([Derived_NumberofReferralsTotal]  = '1' and [Derived_DateofReferral] is null and NHS_Number is null and Referral_appropriate is Null and [Programme_name] is null) then 'Exclude' #(lf)--#(tab)  else 'Accept' end as 'Accept/Exclude'#(lf)--#(tab)  ,[Referral_Date] = case when [Derived_DateofReferral] > [Derived_ProgrammeStartDate] then [Derived_ProgrammeStartDate] #(lf)--  when [Derived_DateofReferral] is null then [Derived_ProgrammeStartDate]#(lf)--  else [Derived_DateofReferral] end #(lf)--  ,[Practice_Code] = case when gp.OrganisationCode IS null then MPI.PracticeCode else gp.OrganisationCode END #(lf)#(lf)#(lf)#(lf)--  FROM [CCG_Current].[CreativeHealth].[vw_CreativeHealthConsortium] as c #(lf)--   left join [CCG_Reference].[Reference].[vw_DateLookup] date on  date.date = case when [Derived_DateofReferral] > [Derived_ProgrammeStartDate] then [Derived_ProgrammeStartDate] #(lf)--  when [Derived_DateofReferral] is null then [Derived_ProgrammeStartDate]#(lf)--  else [Derived_DateofReferral] end #(lf)#(lf)--    left join  [ICB_Products].Patient.vw_Summary MPI on MPI.[PseudoNHSNumber] =c.NHS_Number#(lf)--#(tab)  left join [CCG_Reference].[Reference].[vw_GPPractice] gp on gp.[OrganisationCode] = c.[Derived_ReferralPracticeCode]#(lf)#(lf)#(lf)#(lf)--  where #(lf)--  ([Referral_appropriate] = 'Appropriate' or [Referral_appropriate] is NULL or [Referral_appropriate] = 'N/A' or [Referral_appropriate] = '' )#(lf)#(lf)#(lf)"]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"count", Int64.Type}, {"Completed_programme_flag", Int64.Type}})
				in
				    #"Changed Type"

	changedProperty = IsHidden

