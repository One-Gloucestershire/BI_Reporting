 ,[Good_Child_Index_Pre_School] = cast([Good_Child_Index_Pre_School] as int)#(lf)--      ,[Good_Child_Index_Pre_Use_of_Time] = cast([Good_Child_Index_Pre_Use_of_Time] as int)#(lf)--      ,[Good_Child_Index_Post_Life_whole] = cast([Good_Child_Index_Post_Life_whole] as int)#(lf)--      ,[Good_Child_Index_Post_Relationship_Family] = cast([Good_Child_Index_Post_Relationship_Family] as int)#(lf)--      ,[Good_Child_Index_Post_Choice_Life] = cast([Good_Child_Index_Post_Choice_Life] as int)#(lf)--      ,[Good_Child_Index_Post_Things_you_have] = cast([Good_Child_Index_Post_Things_you_have] as int)#(lf)--      ,[Good_Child_Index_Post_Health] = cast([Good_Child_Index_Post_Health] as int)#(lf)--      ,[Good_Child_Index_Post_Relationship_Friends] = cast([Good_Child_Index_Post_Relationship_Friends] as int)#(lf)--      ,[Good_Child_Index_Post_Appearance] = cast([Good_Child_Index_Post_Appearance] as int)#(lf)--      ,[Good_Child_Index_Post_Happen_later_life] = cast([Good_Child_Index_Post_Happen_later_life] as int)#(lf)--      ,[Good_Child_Index_Post_Home] = cast([Good_Child_Index_Post_Home] as int)#(lf)--      ,[Good_Child_Index_Post_School] = cast([Good_Child_Index_Post_School] as int)#(lf)--      ,[Good_Child_Index_Post_Use_of_Time] = cast([Good_Child_Index_Post_Use_of_Time] as int)#(lf)#(lf)--,case when ([Good_Child_Index_Pre_score_Part_1]  <> '' and [Good_Child_Index_Pre_score_Part_1] >'0') or #(lf)--#(tab)[Good_Child_Index_Pre_Life_whole] <> '' or#(lf)--#(tab)[Good_Child_Index_Pre_Relationship_Family] <> '' or#(lf)--    [Good_Child_Index_Pre_Choice_Life] <> '' or#(lf)--      [Good_Child_Index_Pre_Things_you_have] <> '' or#(lf)--      [Good_Child_Index_Pre_Health] <> '' or#(lf)--      [Good_Child_Index_Pre_Relationship_Friends] <> '' or#(lf)--      [Good_Child_Index_Pre_Appearance] <> '' or#(lf)--      [Good_Child_Index_Pre_Happen_later_life] <> '' or#(lf)--      [Good_Child_Index_Pre_Home] <> '' or#(lf)--      [Good_Child_Index_Pre_School] <> '' or #(lf)--      [Good_Child_Index_Pre_Use_of_Time] <> '' then '1' end as 'Good child Initial' ---- where there is a initial score#(lf)#(tab)     #(lf)--,case when ([Good_Child_Index_Pre_score_Part_1] <> '' and [Good_Child_Index_Post_score_Part_1] <> '') #(lf)--and ([Good_Child_Index_Pre_Life_whole] <> '' and [Good_Child_Index_Post_Life_whole] <> '') or#(lf)--([Good_Child_Index_Pre_Relationship_Family]  <> '' and [Good_Child_Index_Post_Relationship_Family]<> '') or#(lf)--([Good_Child_Index_Pre_Choice_Life] <> '' and [Good_Child_Index_Post_Choice_Life]<> '') or#(lf)--([Good_Child_Index_Pre_Things_you_have] <> '' and [Good_Child_Index_Post_Things_you_have]<> '') or#(lf)--([Good_Child_Index_Pre_Health] <> '' and [Good_Child_Index_Post_Health]<> '') or#(lf)--([Good_Child_Index_Pre_Relationship_Friends] <> '' and [Good_Child_Index_Post_Relationship_Friends]<> '') or#(lf)--([Good_Child_Index_Pre_Appearance] <> '' and [Good_Child_Index_Post_Appearance]<> '') or#(lf)--([Good_Child_Index_Pre_Happen_later_life] <> '' and [Good_Child_Index_Post_Happen_later_life]<> '') or#(lf)--([Good_Child_Index_Pre_Home] <> '' and [Good_Child_Index_Post_Home]<> '') or#(lf)--([Good_Child_Index_Pre_School] <> '' and [Good_Child_Index_Post_School]<> '') or#(lf)--([Good_Child_Index_Pre_Use_of_Time] <> '' and [Good_Child_Index_Post_Use_of_Time]<> '')#(lf)#(lf)--then '1' end as 'Good child both' ---- where both have a score#(lf)#(lf)--,case when (([Good_Child_Index_Pre_score_Part_1]  <= [Good_Child_Index_Post_score_Part_1]) and  #(lf)--([Good_Child_Index_Pre_Life_whole]  < [Good_Child_Index_Post_Life_whole]) or #(lf)--([Good_Child_Index_Pre_Relationship_Family]  < [Good_Child_Index_Post_Relationship_Family]) or#(lf)--([Good_Child_Index_Pre_Choice_Life] < [Good_Child_Index_Post_Choice_Life]) or#(lf)--([Good_Child_Index_Pre_Things_you_have] < [Good_Child_Index_Post_Things_you_have]) or#(lf)--([Good_Child_Index_Pre_Health] < [Good_Child_Index_Post_Health]) or#(lf)--([Good_Child_Index_Pre_Relationship_Friends] < [Good_Child_Index_P