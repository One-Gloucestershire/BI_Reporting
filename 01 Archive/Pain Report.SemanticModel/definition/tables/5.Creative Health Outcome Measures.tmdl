in_Questionnaire_ Post_score] = cast([Pain_Questionnaire_ Post_score] as int)#(lf)#(lf)--,case when [Pain_Questionnaire_ Pre_score] <> '' then '1' end as 'Pain Initial' ---where there is an initial#(lf)--,case when [Pain_Questionnaire_ Pre_score] <> '' and [Pain_Questionnaire_ Post_score]  <> '' then '1' end as 'Pain both' ---- where both have a score#(lf)--,case when [Pain_Questionnaire_ Post_score]  >  [Pain_Questionnaire_ Pre_score] then '1' end as 'Pain improved'   ----  where there is improvement not sure on direction----#(lf)#(lf)------PHQ-8  A score of 10 or greater is considered major depression, 20 or more is severe major depression.#(lf)--      ,[PHQ_8_Pre_score] = cast([PHQ_8_Pre_score] as int)#(lf)--      ,[PHQ_8_Post_score] = cast([PHQ_8_Post_score] as int)#(lf)--,case when [PHQ_8_Pre_score] <> '' then '1' end as 'PHQ8 Initial' ---where there is an initial#(lf)--,case when [PHQ_8_Pre_score] <> '' and [PHQ_8_Post_score]  <> '' then '1' end as 'PHQ8 both' ---- where both have a score#(lf)--,case when [PHQ_8_Post_score]  <  [PHQ_8_Pre_score] then '1' end as 'PHQ8 improved'   ----  where there is improvement #(lf)#(lf)#(lf)-----------PHQ9 --#(lf)--      ,[PHQ_9_Pre_score] = cast([PHQ_9_Pre_score] as int)#(lf)--      ,[PHQ_9_Post_score] = cast([PHQ_9_Post_score] as int)#(lf)--,case when [PHQ_9_Pre_score] <> '' then '1' end as 'PHQ9 Initial' ---where there is an initial#(lf)--,case when [PHQ_9_Pre_score] <> '' and [PHQ_9_Post_score]  <> '' then '1' end as 'PHQ9 both' ---- where both have a score#(lf)--,case when [PHQ_9_Post_score] = '' then NULL #(lf)--when cast([PHQ_9_Post_score] as int)  <  cast([PHQ_9_Pre_score] as int) then '1' end as 'PHQ9 improved'   ----  where there is improvement #(lf)#(lf)------SWEMWBS#(lf)--      ,[SWEMWBS_Pre_score] = cast([SWEMWBS_Pre_score] as int)#(lf)--      ,[SWEMWBS_Post_score] = cast([SWEMWBS_Post_score] as int)#(lf)--,case when [SWEMWBS_Pre_score] <> '' then '1' end as 'SWEMWBS Initial' ---where there is an initial#(lf)--,case when [SWEMWBS_Pre_score] <> '' and [SWEMWBS_Post_score]  <> '' then '1' end as 'SWEMWBS both' ---- where both have a score#(lf)--,case when cast([SWEMWBS_Post_score]as int)  >  cast([SWEMWBS_Pre_score]as int) and [SWEMWBS_Pre_score] <> '' then '1' end as 'SWEMBS improved'   ----  where there is improvement #(lf)#(lf)#(lf)-------WEMWBS#(lf)--      ,[WEMWBS_Pre_score] = cast([WEMWBS_Pre_score] as int)#(lf)--      ,[WEMWBS_Post_score] = cast([WEMWBS_Post_score] as int)#(lf)--#(tab)  ,case when [WEMWBS_Pre_score] <> '' then '1' end as 'WEMWBS Initial'#(lf)--,case when [WEMWBS_Pre_score] <> '' and [WEMWBS_Post_score]  <> '' then '1' end as 'WEMWBS both' ---- where both have a score#(lf)--,case when cast([WEMWBS_Post_score]as int)  >  cast([WEMWBS_Pre_score] as int) and [WEMWBS_Pre_score] <> '' then '1' end as 'WEMWBS improved' ---- improved #(lf)#(lf)#(lf)------MICA #(lf)--#(tab)   ,[MICA_Pre_score] = cast([MICA_Pre_score] as int)#(lf)--      ,[MICA_dem_Post_score] = cast([MICA_dem_Post_score] as int)#(lf)--#(tab)  ,case when [MICA_Pre_score] <> '' then '1' end as 'MICA Initial'#(lf)--#(tab)  ,case when [MICA_Pre_score] <> '' and [MICA_dem_Post_score]  <> '' then '1' end as 'MICA both' ---- where both have a score#(lf)--#(tab)  ,case when cast([MICA_dem_Post_score] as int)  >  cast([MICA_Pre_score] as int) and [MICA_Pre_score] <> '' then '1' end as 'MICA improved'#(lf)#(lf)#(lf)------PPOM#(lf)--       ,[PPOM_Pre_score] = cast([PPOM_Pre_score] as int)#(lf)--      ,[PPOM_Post_score] = cast([PPOM_Post_score] as int)#(lf)--#(tab)  ,case when [PPOM_Pre_score] <> '' then '1' end as 'PPOM Initial'#(lf)--#(tab)  ,case when [PPOM_Pre_score] <> '' and [PPOM_Post_score]  <> '' then '1' end as 'PPOM both' ---- where both have a score#(lf)--#(tab)  ,case when cast([PPOM_Post_score] as int)  >  cast([PPOM_Pre_score] as int) and [PPOM_Pre_score] <> '' then '1' end as 'PPOM improved'#(lf)#(lf)#(lf)#(tab)  #(lf)--#(tab)  --  ,case when ([MYCaW_Concern1_Pre_score] = 'MYCaW_Concern1_Pre_score'  and date_of_referral is null and NHS_Number is null and Referral_appropriate is Null) then 'Exclude' #(lf)--#(tab) -- else 'Accept' end as 'Accept/Exclude'#(lf)--      ,[FileName]#(lf)--      ,[ProcessedDate]#(lf)--      ,[Referral_month] = Derived_ReferralMonth#(lf)--      ,[Referral_monthyear] = Derived_ReferralMonthYear#(lf)--      ,[Referral_fyear] = Derived_ReferralFinancialYear#(lf)--      ,[Completed_programme_flag] = [Derived_CompletedProgrammeFlag]#(lf)--#(tab)  ,[Practice_Code] = case when gp.OrganisationCode IS null then MPI.PracticeCode else gp.OrganisationCode END #(lf)#(lf)--  FROM [CCG_Current].[CreativeHealth].[vw_CreativeHealthConsortium] as c#(lf)#(lf)--    left join [CCG_Reference].[Reference].[vw_GPPractice] gp on gp.[OrganisationCode] = [Derived_ReferralPracticecode]#(lf)--#(tab)  left join  [BIReports].[MPI].[MPI_current] MPI on MPI.[Derived_Pseudo_NHS] = c.[NHS_Number]#(lf)#(lf)--  where ([Referral_appropriate] = 'Appropriate' or [Referral_appropriate] is NULL or [Referral_appropriate] = 'N/A'or [Referral_appropriate] = '')#(lf)--#(tab)  and [Derived_CompletedProgrammeFlag] = '1' ----only want completed??#(lf)--#(tab)--  and Programme_provider = 'Artlift'#(lf)--#(tab)and Goal_Based_Outcomes_Goal_1_post_score <> 'not scored'#(lf)--#(tab)and Goal_Based_Outcomes_Goal_1_pre_score <> 'not scored'#(lf)--#(tab)and Goal_Based_Outcomes_Goal_2_post_score <> 'not scored'#(lf)--#(tab)and Goal_Based_Outcomes_Goal_2_pre_score <> 'not scored'#(lf)--#(tab)and Goal_Based_Outcomes_Goal_3_post_score <> 'not scored'#(lf)--#(tab)and Goal_Based_Outcomes_Goal_3_pre_score  <> 'not scored'#(lf)--#(tab)and [SWEMWBS_Post_score] <> 'not returned'#(lf)--#(tab)and [SWEMWBS_Pre_score] <> 'not returned'#(lf)--#(tab)and[Good_Child_Index_Pre_Things_you_have] <> 'X'#(lf)--     and[Good_Child_Index_Pre_Health] <> 'X'#(lf)--     and[Good_Child_Index_Pre_Relationship_Friends]<> 'X'#(lf)--     and[Good_Child_Index_Pre_Appearance]<> 'X'#(lf)--#(tab) and[Good_Child_Index_Pre_Appearance]<> 'XX'#(lf)--     and[Good_Child_Index_Pre_Happen_later_life]<> 'X'#(lf)--     and[Good_Child_Index_Pre_Home]<> 'X'#(lf)--     and[Good_Child_Index_Pre_School]<> 'X'#(lf)--     and[Good_Child_Index_Pre_Use_of_Time]<> 'X'#(lf)--#(tab) and[Good_Child_Index_Pre_score_Part_1] <> 'x'#(lf)--#(tab) and [SWEMWBS_Pre_score] <> 'not returned'#(lf)--#(tab) and MICA_dem_Post_score <> 'not completed'#(lf)--#(tab) and [MICA_Pre_score] <> 'not completed'"])
