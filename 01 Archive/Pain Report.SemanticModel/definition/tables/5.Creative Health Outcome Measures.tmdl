	column Testa
		dataType: int64
		formatString: 0
		lineageTag: aa5c526a-4433-45cf-bff9-0cfe4e073ff3
		summarizeBy: sum
		sourceColumn: Testa

		annotation SummarizationSetBy = Automatic

	partition '5.Creative Health Outcome Measures' = m
		mode: import
		queryGroup: 'Creative Health'
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Reference", [Query="select [Testa] = 1 #(lf)#(lf)#(lf)-----Outcome Meaures#(lf)#(lf)--SELECT cast(1 as int) as'count'#(lf)--#(tab)#(tab),[NHS_Number]#(lf)--      ,[Date_of_referral]#(lf)--#(tab)    ,[Referral Date] = case when [Derived_DateofReferral] > [Derived_ProgrammeStartDate] then [Derived_ProgrammeStartDate]#(lf)--  when [Derived_DateofReferral] is null then [Derived_ProgrammeStartDate]#(lf)--  else [Derived_DateofReferral] end #(lf)#(lf)--      ,[Referral_appropriate]#(lf)--      ,[Programme_name]#(lf)--#(tab)   ,case when [Programme_name] =  'CYP Pain' then 'CYP LTCs' else [Programme_name] end as 'Course Name' #(lf)#(lf)--      ,[Programme_provider]#(lf)--,case when  programme_provider is null and Programme_name = 'Adult Pain' then 'Artlift' else programme_provider end as 'Programme Provider'#(lf)--      ,[Programme_start_date]#(lf)--      ,[Programme_end_date]#(lf)--      --,[Num_of_Referrals_to_each_programme]#(lf)--      --,[Num_of_Referrals_Total]#(lf)#(lf)-------ONS#(lf)--      ,[ONS_Pre_Life_Satisfaction] = cast([ONS_Pre_Life_Satisfaction] as int)#(lf)--      ,[ONS_Pre_Worthwhile] = cast ([ONS_Pre_Worthwhile] as int)#(lf)--      ,[ONS_Pre_Happiness] = cast([ONS_Pre_Happiness] as int)#(lf)--      ,[ONS_Pre_Anxiety] = cast([ONS_Pre_Anxiety] as int)#(lf)--      ,[ONS_Post_Life_Satisfaction] = cast([ONS_Post_Life_Satisfaction] as int)#(lf)--      ,[ONS_Post_Worthwhile] = cast([ONS_Post_Worthwhile] as int)#(lf)--      ,[ONS_Post_Happiness] = cast([ONS_Post_Happiness] as int)#(lf)--      ,[ONS_Post_Followup_Anxiety] = cast([ONS_Post_Followup_Anxiety] as int)#(lf)#(lf)--#(tab)  ,case when [ONS_Pre_Life_Satisfaction] <> '' or [ONS_Pre_Worthwhile] <> '' or [ONS_Pre_Happiness] <> '' or [ONS_Pre_Anxiety] <> '' then '1' end as 'ONS initial'#(lf)--#(tab)  ,case when [ONS_Pre_Life_Satisfaction] <> '' or [ONS_Post_Life_Satisfaction]  <> '' then '1' end as 'ONS flag' ---- where there is a score for pre or post#(lf)--,case when [ONS_Pre_Life_Satisfaction] <> '' and [ONS_Post_Life_Satisfaction]  <> '' then '1' end as 'ONS both' ---- where both have a score#(lf)--,case when [ONS_Pre_Life_Satisfaction] < [ONS_Post_Life_Satisfaction] or [ONS_Pre_Worthwhile] < [ONS_Post_Worthwhile] #(lf)--or [ONS_Pre_Happiness] < [ONS_Post_Happiness] or [ONS_Pre_Anxiety] > [ONS_Post_Followup_Anxiety]#(lf)-- then '1' end as 'ONS improved'   ----  where there is improvement #(lf)#(lf)#(lf)--------Anxiety (1 is low and 10 is high) ******* broken #(lf)--   ,[Anxiety_Q1_Confident_Noticing_pre] = cast([Anxiety_Q1_Confident_Noticing_pre]as int)#(lf)--      ,[Anxiety_Q1_Confident_Noticing_post] = cast([Anxiety_Q1_Confident_Noticing_post] as int)#(lf)--      ,[Anxiety_Q2_Knowing_what_helps_pre] = cast([Anxiety_Q2_Knowing_what_helps_pre] as int)#(lf)--      ,[Anxiety_Q2_Knowing_what_helps_post] = cast([Anxiety_Q2_Knowing_what_helps_post] as int)#(lf)--,case when [Anxiety_Q1_Confident_Noticing_pre]  <> '' or [Anxiety_Q2_Knowing_what_helps_pre] <> '' then '1' end as 'Anxiety Initial' --- initial complete#(lf)--,case when [Anxiety_Q1_Confident_Noticing_pre]  <> '' or [Anxiety_Q1_Confident_Noticing_post] <> '' or [Anxiety_Q2_Knowing_what_helps_pre] <> '' or [Anxiety_Q2_Knowing_what_helps_post] <> '' then '1' end as 'Anxiety flag' ---- where there is a score for pre or post#(lf)--,case when [Anxiety_Q1_Confident_Noticing_pre] <> '' and [Anxiety_Q1_Confident_Noticing_post]  <> '' and [Anxiety_Q2_Knowing_what_helps_pre] <> '' and [Anxiety_Q2_Knowing_what_helps_post] <> '' then '1' end as 'Anxiety both' ---- where both have a score#(lf)--,case when cast([Anxiety_Q1_Confident_Noticing_post]as int) > cast([Anxiety_Q1_Confident_Noticing_pre]as int) or cast([Anxiety_Q2_Knowing_what_helps_post]as int) > cast([Anxiety_Q2_Knowing_what_helps_pre]as int) then '1' end as 'Anxiety Improved' ----- how to ignore if blank#(lf)#(lf)----------GAD#(lf)--    ,[GAD_7_Pre_score] = cast([GAD_7_Pre_score] as int) #(lf)--,[GAD_7_Post_score] = cast([GAD_7_Post_score] as int)#(lf)--,case when [GAD_7_Pre_score] <> '' then '1' end as 'GAD Initial'#(lf)--,case when [GAD_7_Pre_score] <> '' or [GAD_7_Post_score]  <> '' then '1' end as 'GAD flag' ---- where there is a score for pre or post#(lf)--,case when [GAD_7_Pre_score] <> '' and [GAD_7_Post_score]  <> '' then '1' end as 'GAD both' ---- where both have a score#(lf)--,case when [GAD_7_Post_score] = '' then Null #(lf)--when cast([GAD_7_Post_score]as int)  < cast([GAD_7_Pre_score]as int)  then '1' end as 'GAD improved'   ----  where there is improvement #(lf)#(lf)-----------Goal based --- Need to work out the improved section case statement #(lf)--      ,[Goal_Based_Outcomes_Goal_1_pre_score] = cast([Goal_Based_Outcomes_Goal_1_pre_score] as int)#(lf)--      ,[Goal_Based_Outcomes_Goal_1_post_score] = cast([Goal_Based_Outcomes_Goal_1_post_score] as int)#(lf)--      ,[Goal_Based_Outcomes_Goal_2_pre_score] = cast([Goal_Based_Outcomes_Goal_2_pre_score] as int)#(lf)--      ,[Goal_Based_Outcomes_Goal_2_post_score] = Cast([Goal_Based_Outcomes_Goal_2_post_score] as int)#(lf)--      ,[Goal_Based_Outcomes_Goal_3_pre_score] = cast([Goal_Based_Outcomes_Goal_3_pre_score] as int)#(lf)--      ,[Goal_Based_Outcomes_Goal_3_post_score] = cast([Goal_Based_Outcomes_Goal_3_post_score] as int)#(lf)#(lf)--,case when ([Goal_Based_Outcomes_Goal_1_pre_score] <> '') or ([Goal_Based_Outcomes_Goal_2_pre_score] <> '') or ([Goal_Based_Outcomes_Goal_3_pre_score] <> '') then '1' end as 'Goal Initial'  #(lf)--#(tab)  ,case when [Goal_Based_Outcomes_Goal_1_pre_score]  <> '' or [Goal_Based_Outcomes_Goal_1_post_score] <> '' or [Goal_Based_Outcomes_Goal_2_pre_score]  <> '' or [Goal_Based_Outcomes_Goal_2_post_score] <> '' or [Goal_Based_Outcomes_Goal_3_pre_score]  <> '' or [Goal_Based_Outcomes_Goal_3_post_score] <> '' then '1' end as 'Goal flag' ---- where there is a score for pre or post#(lf)--,case when ([Goal_Based_Outcomes_Goal_1_pre_score]  <> '' and [Goal_Based_Outcomes_Goal_1_post_score] <> 