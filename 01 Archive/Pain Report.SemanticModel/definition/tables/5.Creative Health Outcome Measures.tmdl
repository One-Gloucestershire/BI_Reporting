table '5.Creative Health Outcome Measures'
	lineageTag: 13ebf465-19cd-4f72-b8e6-202efbd6f83c

	measure 'GAD&PHQ9 Total Potential Individuals to be Assessed (Adult Mental Health & COVID Employment & MH)' =
			
			
			CALCULATE(SUM('5.Creative Health Outcome Measures'[count])
			,'5.Creative Health Outcome Measures'[Course Name] = "COVID Employment & MH" || '5.Creative Health Outcome Measures'[Course Name] = "Adult Mental Health")
		formatString: 0
		displayFolder: 1.GAD-7
		lineageTag: 655fdaac-a820-4ce8-982c-a2a6855a62ad

		changedProperty = IsHidden

	measure 'GAD TOTAL Assessed individuals with an initial questionnaire completed' =
			
			
			Calculate(if(ISBLANK(sum('5.Creative Health Outcome Measures'[count])),0,sum('5.Creative Health Outcome Measures'[count]))
			,'5.Creative Health Outcome Measures'[GAD Initial] = "1")
		formatString: 0
		displayFolder: 1.GAD-7
		lineageTag: dbb5cc9a-9549-4b62-84d9-89645ff5e6f1

		changedProperty = IsHidden

