table REF_GP_Practice_Populations
	lineageTag: 44323b33-1b9c-42ff-a061-71dec5c445ab

	measure Latest_in_dataset_gp_practice_populations = ```
			
			
			VAR Latest_GP_Population_date = 
			    CALCULATE(
			        MAX(REF_GP_Practice_Populations[CensusDate_as_date]),
			        NOT(ISBLANK(REF_GP_Practice_Ref[Locality]))
			    )
			
			RETURN
			
			
			calculate(sum(REF_GP_Practice_Populations[Total Population]),REF_GP_Practice_Populations[CensusDate_as_date] = Latest_GP_Population_date)
			```
		formatString: 0
		lineageTag: ef4dcd01-a92e-4f48-a97f-f9ba9b44d1d8

	measure Test_Latest_Date_in_Dataset = max(REF_Date_Ref[date])
		formatString: General Date
