	partition REF_GP_Practice_Populations = m
		mode: import
		queryGroup: 'Reference Tables'
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Reference", [Query="----------------------------------#(lf)-------- POPULATION TABLE --------#(lf)----------------------------------#(lf)#(lf)SELECT #(lf)[NHS_Number] = [P].Derived_NHS_Number,#(lf)[Practice_Code] = [P].PrimaryCareProvider,#(lf)[Practice_Name] = [gp].ReportingOrganisationName,#(lf)[Locality] = [gp].Reporting_Locality ,#(lf)[Primary Care Network] = [gp].Reporting_PrimaryCareNetwork,#(lf)[Census_Date] = [P].Census_Date,#(lf)[CensusDate_as_date] = [P].Census_Date,#(lf)[Age] = [p].Age_at_census,#(lf)[Derived_Registered_CCG] = [P].Derived_Registered_CCG,#(lf)[Total Population] = 1#(lf)#(lf)#(lf)FROM PowerBI_Reporting.AgeingWell.tbl02_Proactive_Whiteboard_Registered_Population_Over_Time [P]#(lf)left join PowerBI_Reporting.dbo.GP_Practice_Ref as [gp] on [gp].OrganisationCode = [P].PrimaryCareProvider#(lf)#(lf)WHERE #(lf) ISNULL([P].[PrimaryCareProvider],'') <> 'Y00054' -- removes homeless healthcare #(lf) and #(lf) Derived_Registered_CCG like '11M%'#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)"])
				in
				    Source

	annotation PBI_ResultType = Exception

	annotation PBI_NavigationStepName = Navigation

