	measure Average_Rate_Previous_6_time_periods_Opioids+Epilepsy_Drugs = ```
			
			
			VAR End_date_for_drugs_combinations_data = EOMONTH(MAX('2.Drug Combinations'[TimePeriod_End_Date]), -6) // Shift the end date back by 6 more months
			
			VAR Start_date_for_drugs_combinations_date = DATE(
			    YEAR(EDATE(MAX('2.Drug Combinations'[TimePeriod_End_Date]), -11)), 
			    MONTH(EDATE(MAX('2.Drug Combinations'[TimePeriod_End_Date]), -11)),
			    1
			)
			
			Var Pivot_Table_Drug_Rate_Per_Practice =     FILTER(
			    SUMMARIZE(
			        '2.Drug Combinations',
			        '2.Drug Combinations'[TimePeriod_Order],
			        '2.Drug Combinations'[TimePeriod],
			        '2.Drug Combinations'[TimePeriod_Start_Date],
			        '2.Drug Combinations'[TimePeriod_End_Date],
			        REF_GP_Practice_Ref[ReportingOrganisationCode],
			        "Drug_Rate_Opioids+Epliepsy_Drugs", [Drug_Combinations_Rate_Per_1000_Opioids+Epilepsy_Drugs]
			    ),
			    '2.Drug Combinations'[TimePeriod_End_Date] >= Start_date_for_drugs_combinations_date && 
			    EOMONTH('2.Drug Combinations'[TimePeriod_End_Date], 0) <= End_date_for_drugs_combinations_data
			)
			
			RETURN
			
			AVERAGEX(
			    Pivot_Table_Drug_Rate_Per_Practice,
			    [Drug_Rate_Opioids+Epliepsy_Drugs]
			)
			
			
			```
		displayFolder: Measures for Opiod + Epilepsy Drugs per 1000 Graph Cards
		lineageTag: fbb24bdd-11d8-4f98-8880-620e172195a7

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Average_variance_between_6_time_periods_opioid_+_Epilepsy_Drugs_dispensing_arrow = ```
			
			    IF(
			        [Variance_between_Average_Opioids_+_Epilepsy_Drugs_practive_rates_current_6_months_to_previous_6_months_percentage] > 0, UNICHAR(9650),
			        IF(
			            [Variance_between_Average_Opioids_+_Epilepsy_Drugs_practive_rates_current_6_months_to_previous_6_months_percentage] < 0, UNICHAR(9660), 
			            BLANK()
			        )
			    )
			```
