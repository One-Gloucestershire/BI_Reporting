table '2.Drug Combinations'
	lineageTag: 731efce3-a728-4816-8f67-c86d0a94be8d

	measure Drug_Combinations_Rate_Per_1000_Opioids =
			
			(CALCULATE(
			    DISTINCTCOUNT('2.Drug Combinations'[NHS_Number]),
			    '2.Drug Combinations'[Opioid] = 1
			) / SUM(REF_Average_GP_Practice_Populations_Over_Time_Periods[Average_GP_Population])) *1000
		formatString: 0.00
		lineageTag: 363ec915-8329-4b35-981c-0760ee62e07d

		changedProperty = IsHidden

	measure Distinct_Count_NHS_Number = DISTINCTCOUNT('2.Drug Combinations'[NHS_Number])
		formatString: 0
		lineageTag: 09e5df4e-af1b-4411-abfc-8337b725bc59

		changedProperty = IsHidden

	measure Drug_Combinations_Rate_Per_1000_Opioids+Anti_Depressants =
			
			(CALCULATE(
			    DISTINCTCOUNT('2.Drug Combinations'[NHS_Number]),
			    '2.Drug Combinations'[Opioid + Anti_Depressants] = 1
			) / SUM(REF_Average_GP_Practice_Populations_Over_Time_Periods[Average_GP_Population])) *1000
		lineageTag: e5d10aef-a3a0-4895-8c4c-706b19375398

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Drug_Combinations_Rate_Per_1000_Opioids+Diazepam =
			
			(CALCULATE(
			    DISTINCTCOUNT('2.Drug Combinations'[NHS_Number]),
			    '2.Drug Combinations'[Opioid + Diazepam] = 1
			) / SUM(REF_Average_GP_Practice_Populations_Over_Time_Periods[Average_GP_Population])) *1000
		lineageTag: fc531561-a590-47cb-b033-a3c03dedfa7a

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Drug_Combinations_Rate_Per_1000_Opioids+Epilepsy_Drugs =
			
			(CALCULATE(
			    DISTINCTCOUNT('2.Drug Combinations'[NHS_Number]),
			    '2.Drug Combinations'[Opioid + Epliepsy Drugs] = 1
			) / SUM(REF_Average_GP_Practice_Populations_Over_Time_Periods[Average_GP_Population])) *1000
		lineageTag: a7d17dd5-fe39-41e5-8e3b-20b2301a1943

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Latest_Average_Population = ```
			
			CALCULATE(
			    SUM('REF_Average_GP_Practice_Populations_Over_Time_Periods'[Average_GP_Population]),
			    FILTER(
			        'REF_Average_GP_Practice_Populations_Over_Time_Periods',
			        'REF_Average_GP_Practice_Populations_Over_Time_Periods'[Time_Period_Order] = MAX('REF_Average_GP_Practice_Populations_Over_Time_Periods'[Time_Period_Order])
			    )
			)
			
			```
		lineageTag: c940b70e-f6d0-4622-9b21-47123e7ce650

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Latest_Rate_Opiods_6months_ago =
			
			VAR Latest_Population = CALCULATE(
			    SUM('REF_Average_GP_Practice_Populations_Over_Time_Periods'[Average_GP_Population]),
			    FILTER(
			        'REF_Average_GP_Practice_Populations_Over_Time_Periods',
			        'REF_Average_GP_Practice_Populations_Over_Time_Periods'[Time_Period_Order] = (MAX('REF_Average_GP_Practice_Populations_Over_Time_Periods'[Time_Period_Order])-6)
			    )
			)
			
			
			RETURN
			
			(CALCULATE(
			    DISTINCTCOUNT('2.Drug Combinations'[NHS_Number]),
			    '2.Drug Combinations'[Opioid] = 1,
			    (max('2.Drug Combinations'[TimePeriod_Order])-6) = '2.Drug Combinations'[TimePeriod_Order]
			)/ Latest_Population) *1000
		lineageTag: 5628bcb2-c21d-4c8f-bccb-705aa496030e

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Latest_Rate_Opiods_12months_ago =
			
			VAR Latest_Population = CALCULATE(
			    SUM('REF_Average_GP_Practice_Populations_Over_Time_Periods'[Average_GP_Population]),
			    FILTER(
			        'REF_Average_GP_Practice_Populations_Over_Time_Periods',
			        'REF_Average_GP_Practice_Populations_Over_Time_Periods'[Time_Period_Order] = (MAX('REF_Average_GP_Practice_Populations_Over_Time_Periods'[Time_Period_Order])-12)
			    )
			)
			
			
			RETURN
			
			(CALCULATE(
			    DISTINCTCOUNT('2.Drug Combinations'[NHS_Number]),
			    '2.Drug Combinations'[Opioid] = 1,
			    (max('2.Drug Combinations'[TimePeriod_Order])-12) = '2.Drug Combinations'[TimePeriod_Order]
			)/ Latest_Population) *1000
		lineageTag: 1d2c5001-c914-4eb9-9c17-4748feec6c21

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Start_date_for_drugs_combinations_date_Test =
			DATE(
			    YEAR(EDATE(MAX('2.Drug Combinations'[TimePeriod_End_Date]), -5)),
			    MONTH(EDATE(MAX('2.Drug Combinations'[TimePeriod_End_Date]), -5)),
			    1)
		formatString: General Date
		lineageTag: b6d76c74-9445-45d2-be98-4734e7aa5141

		changedProperty = IsHidden

	measure Average_Rate_Current_6_time_periods_Opioids = ```
			
			
			VAR End_date_for_drugs_combinations_data = EOMONTH(MAX('2.Drug Combinations'[TimePeriod_End_Date]), 0)
			
			VAR Start_date_for_drugs_combinations_date = DATE(
			    YEAR(EDATE(MAX('2.Drug Combinations'[TimePeriod_End_Date]), -5)),
			    MONTH(EDATE(MAX('2.Drug Combinations'[TimePeriod_End_Date]), -5)),
			    1
			)
			
			Var Pivot_Table_Drug_Rate_Per_Practice =     FILTER(
			    SUMMARIZE(
			        '2.Drug Combinations',
			        '2.Drug Combinations'[TimePeriod_Order],
			        '2.Drug Combinations'[TimePeriod],
			        '2.Drug Combinations'[TimePeriod_Start_Date],
			        '2.Drug Combinations'[TimePeriod_End_Date],
			        REF_GP_Practice_Ref[ReportingOrganisationCode],
			        "Drug_Rate_Opioids", [Drug_Combinations_Rate_Per_1000_Opioids]
			    ),
			    '2.Drug Combinations'[TimePeriod_End_Date] >= Start_date_for_drugs_combinations_date && 
			    EOMONTH('2.Drug Combinations'[TimePeriod_End_Date], 0) <= End_date_for_drugs_combinations_data
			)
			
			RETURN
			
			AVERAGEX(
			    Pivot_Table_Drug_Rate_Per_Practice,
			    [Drug_Rate_Opioids]
			)
			
			
			
			
			```
		formatString: 0.00
		displayFolder: Measures for Opiod Rate Per 1000 Graph Cards
