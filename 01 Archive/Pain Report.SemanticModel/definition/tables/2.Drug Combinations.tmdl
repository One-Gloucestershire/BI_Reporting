	measure Average_Rate_Previous_6_time_periods_Opioids = ```
			
			
			VAR End_date_for_drugs_combinations_data = EOMONTH(MAX('2.Drug Combinations'[TimePeriod_End_Date]), -6) // Shift the end date back by 6 more months
			
			VAR Start_date_for_drugs_combinations_date = DATE(
			    YEAR(EDATE(MAX('2.Drug Combinations'[TimePeriod_End_Date]), -11)), 
			    MONTH(EDATE(MAX('2.Drug Combinations'[TimePeriod_End_Date]), -11)),
			    1
