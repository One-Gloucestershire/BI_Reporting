			    EOMONTH('2.Drug Combinations'[TimePeriod_End_Date], 0) <= End_date_for_drugs_combinations_data
			)
			
			RETURN
			
			AVERAGEX(
			    Pivot_Table_Drug_Rate_Per_Practice,
			    [Drug_Rate_Opioids]
			)
			
			
			
			
			```
