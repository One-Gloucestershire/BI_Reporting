table '3.Creative Health Referrals'
	lineageTag: 38d8d63e-3cb8-4a43-975c-7077880208e5

	measure Number_of_Creative_Health_Referrals_Suppressed =
			
			
			calculate(if(sum('3.Creative Health Referrals'[count])<=6,0,sum('3.Creative Health Referrals'[count])),'3.Creative Health Referrals'[Accept/Exclude] = "Accept")
		formatString: 0
		lineageTag: 069045d1-eb62-4200-99f8-d637b06fc0df

		changedProperty = IsHidden

	measure Number_of_Creative_Health_Referrals =
			
			
			calculate(SUM('3.Creative Health Referrals'[count]),'3.Creative Health Referrals'[Accept/Exclude] = "Accept")
		formatString: 0
		lineageTag: 52214d19-3cb2-4c47-82f4-7da0ad6950ed

		changedProperty = IsHidden

	measure Creative_Health_Referrals_per_1000_population = ```
			
			
			VAR Latest_GP_Population_date = 
			    CALCULATE(
			        MAX(REF_GP_Practice_Populations[CensusDate_as_date]))
			    
			
			VAR Latest_GP_Registered_Population =
			    CALCULATE(
			        SUM(REF_GP_Practice_Populations[Total Population]),
			        REF_GP_Practice_Populations[CensusDate_as_date] = Latest_GP_Population_date
			    )
			
			RETURN
			
			([Number_of_Creative_Health_Referrals]/Latest_GP_Registered_Population)*1000
			
			
			
			```
		lineageTag: 8a8f5d46-fb77-445c-86fd-1bc96da9612d

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Gloucestershire_Creative_Health_Referrals_per_1000_population = ```
			
			
			VAR Latest_GP_Population_date = 
			  
			        MAX(REF_GP_Practice_Populations[CensusDate_as_date])
			    
			
			VAR Latest_GP_Registered_Population =
			    CALCULATE(
			        SUM(REF_GP_Practice_Populations[Total Population])
			        ,all(REF_GP_Practice_Ref)
			        ,NOT(ISBLANK(REF_GP_Practice_Ref[OrganisationCode]))
			        ,REF_GP_Practice_Populations[CensusDate_as_date] = Latest_GP_Population_date
			        
			        )
			   
			
			    Var Number_of_creative_health_countywide_referrals = 
			    calculate([Number_of_Creative_Health_Referrals]
			    ,ALL(REF_GP_Practice_Ref)
			    ,NOT(ISBLANK(REF_GP_Practice_Ref[OrganisationCode]))
			    )
			    
			  
			
			RETURN
			
			iferror((Number_of_creative_health_countywide_referrals/Latest_GP_Registered_Population)*1000,BLANK())
			
			
			
			```
		lineageTag: 16890c9a-b54f-49a1-9c4d-4f61de515167

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Number_of_Creative_Health_Referrals_Missing_GP_Practice =
			
			calculate([Number_of_Creative_Health_Referrals]
			,isblank('3.Creative Health Referrals'[Practice_Code]))
		formatString: 0
		lineageTag: bf9806a4-6092-4836-9031-c0263d941b63

		changedProperty = IsHidden

	measure Creative_Health_Referral_Rate_per_1000_conditional_formatting =
			
			SWITCH(
			    True(),
			    [Creative_Health_Referrals_per_1000_population] > [Gloucestershire_Creative_Health_Referrals_per_1000_population],"#FE7A36"
			    ,"#3652AD"
			
			)
		lineageTag: 0546781b-8615-4c65-914b-ce51c409215b

		changedProperty = IsHidden

