	partition REF_GP_Practice_Ref = m
		mode: import
		queryGroup: 'Reference Tables'
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Reference", [Query="#(lf)select #(lf)[P].OrganisationCode#(lf),[P].OrganisationName#(lf),[ReportingOrganisationCode] = [P].ReportingOrganisationCode#(lf)#(lf),[ReportingOrganisationName] =  [P].ReportingOrganisationName#(lf)#(lf),[Locality] = Case when [P].Reporting_Locality IN ('The Forest of Dean') then 'The Forest of Dean.'#(lf)ELSE [P].Reporting_Locality END #(lf)#(lf),[PrimaryCareNetwork] = Reporting_PrimaryCareNetwork #(lf)#(lf)from PowerBI_Reporting.dbo.GP_Practice_Ref [P]#(lf)left join CCG_Reference.Reference.vw_GPPractice [R] on [P].ReportingOrganisationCode = [R].OrganisationCode#(lf)#(lf)#(lf)where (p.OrganisationCode in (select distinct gpp.OrganisationCode  from CCG_Reference.Reference.vw_GPPracticePopulation as gpp)#(lf)or [R].Locality is not null)#(lf)#(lf)and [P].OrganisationCode <> 'Y00054' -- The Homeless Healthcare Team#(lf)#(lf)#(lf)order by ReportingOrganisationName#(lf)#(lf);#(lf)#(lf)"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

