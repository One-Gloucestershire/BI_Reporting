	partition REF_PLS_Current = m
		mode: import
		queryGroup: 'Reference Tables'
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Reference", [Query="SELECT DISTINCT  [Derived_Pseudo_NHS] = PLS.PseudoNHSNumber#(lf)      ,pls.[PracticeCode]#(lf)     #(lf)#(tab)  ,[IMDcountyDecile] = PLS.IMDCountyDecile#(lf)#(tab),[MentalIllnessDerived] = PLS.MentalIllness#(lf)#(tab)  ,PLS.[LTCCountDerived]#(lf)#(tab),[SmokerDerived] = PLS.Smoker#(lf)#(tab)  ,[EthnicOriginDescription] = e.DerivedEthnicityDescription#(lf)#(lf)#(tab)  ,CASE#(lf)  /* Normalise group first to be safe on case/whitespace */#(lf)  WHEN UPPER(e.DerivedEthnicityGroup) LIKE '%NOT KNOWN%' THEN 0#(lf)#(lf)  /* White categories (NHS standard) */#(lf)  WHEN e.DerivedEthnicityCode IN ('A','B','C') THEN 0#(lf)#(lf)  /* Gypsy/Roma/Irish Traveller are White in ONS/NHS classification */#(lf)  WHEN e.DerivedEthnicityCode = 'T'#(lf)       OR UPPER(e.DerivedEthnicityDescription) LIKE '%TRAVELLER%'#(lf)       OR UPPER(e.DerivedEthnicityDescription) LIKE '%GYPSY%'#(lf)       OR UPPER(e.DerivedEthnicityDescription) LIKE '%ROMA%'#(lf)  THEN 0#(lf)#(lf)  /* Not stated / Not known single-letter/2-digit NHS codes */#(lf)  WHEN e.DerivedEthnicityCode IN ('Z','99') THEN 0#(lf)#(lf)  /* Everything else is BME */#(lf)  ELSE 1#(lf)END AS BME_Flag#(lf)#(lf), [Ethnicity_Flag] = e.DerivedEthnicityGroup#(lf)#(lf)#(lf),[LSOACode] =  PLS.LSOACode#(lf)#(lf)#(tab) ,[IMDemployment_countydecile] = cast(l.Derived_EmploymentDeprivationDomainGloucestershireDecile as int)#(lf)#(tab)  ,[Derived_Age] = PLS.DerivedAge#(lf)#(tab)#(tab)#(lf)#(tab)  ,CASE WHEN cast([DerivedAge] AS int) >= 60 THEN 1#(lf)#(tab)#(tab)    WHEN cast([DerivedAge] AS int) < 60 THEN NULL#(lf)#(tab)#(tab)    ELSE 'ERROR'#(lf)#(tab)#(tab)    END AS '60_Flag'#(lf)#(lf)#(tab)  ,CASE WHEN cast([DerivedAge] as int) >= 80 THEN 1#(lf)#(tab)#(tab)    WHEN cast([DerivedAge] as int) <80 THEN NULL#(lf)#(tab)#(tab)    ELSE 'ERROR'#(lf)#(tab)#(tab)    END AS '80_Flag'#(lf)#(lf)      ,[Gender]#(lf)#(tab)  ,[CCG_Of_Registration] = PLS.ICBofRegistration#(lf)#(tab)   ,1 as COUNTER#(lf)#(lf)#(lf)#(lf)#(lf)#(tab)    FROM [PowerBI_Reporting].PLS.tbl02_Summary as PLS#(lf)#(lf)#(tab)#(tab)LEFT JOIN [PowerBI_Reporting].PLS.tbl01_Ethnicity as e on e.PseudoNHSNumber = PLS.PseudoNHSNumber#(lf)#(lf)#(tab)#(tab)left join  CCG_Reference.Reference.vw_LSOA_IMD as l on PLS.LSOACode = l.LSOACode#(lf)#(lf)#(tab)#(tab)WHERE pls.[ICBofRegistration] LIKE '%11M%'#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)"]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"IMDcountyDecile", Int64.Type}})
				in
				    #"Changed Type"

	changedProperty = IsHidden

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

