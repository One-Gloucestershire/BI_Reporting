table REF_PLS_Current
	lineageTag: 9d1f43a0-45c0-4728-a9f8-d677c91162b9

	measure '% of over 60_MPI' =
			
			
			
			
			calculate(SUM(REF_PLS_Current[COUNTER]),REF_PLS_Current[60_Flag] = 1)/sum(REF_PLS_Current[COUNTER])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c0ec334c-f44e-423a-91e9-2fa91aeb886c

