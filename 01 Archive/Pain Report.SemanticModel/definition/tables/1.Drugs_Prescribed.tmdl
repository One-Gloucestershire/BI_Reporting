	measure CountyWide_Latest_dispensed_in_time_period_rate_per_1000_for_locality_graph = ```
			
			
			VAR Latest_GP_Population_date = 
			    CALCULATE(
			        MAX(REF_GP_Practice_Populations[CensusDate_as_date]),
			        NOT(ISBLANK(REF_GP_Practice_Ref[Locality]))
			    )
			
			RETURN
			CALCULATE(
			    (SUM('1.Drugs_Prescribed'[Total items]) / SUM(REF_GP_Practice_Populations[Total Population])) * 1000,
			    FILTER(
			        ALL(REF_GP_Practice_Ref),
			        NOT(ISBLANK(REF_GP_Practice_Ref[Locality])) &&
			        REF_GP_Practice_Ref[Locality] <> "The Homeless Healthcare Team"
			    ),
			    FILTER(
			        ALL(REF_GP_Practice_Populations[Locality],REF_GP_Practice_Populations[Practice_Code]),
			        NOT(ISBLANK(REF_GP_Practice_Populations[Locality])) && 
			        REF_GP_Practice_Populations[Locality] <> "The Homeless Healthcare Team"
			    ),
			    REF_GP_Practice_Populations[CensusDate_as_date] = Latest_GP_Population_date
			   
			)
			```
