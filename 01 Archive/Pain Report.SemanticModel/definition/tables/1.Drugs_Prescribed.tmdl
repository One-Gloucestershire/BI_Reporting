	measure Countywide_Drug_Rate_Step_1 = ```
			
			VAR Total_Drugs_Prescribed_County = 
			    CALCULATE(
			        SUM('1.Drugs_Prescribed'[Total items]),
			        ALL(REF_GP_Practice_Ref),
			        NOT(ISBLANK(REF_GP_Practice_Ref[Locality]))
			    )
			
			VAR Latest_GP_Population_date = 
			    CALCULATE(
			        MAX(REF_GP_Practice_Populations[CensusDate_as_date]),
			        ALL(REF_GP_Practice_Ref),
			        NOT(ISBLANK(REF_GP_Practice_Ref[Locality]))
			    )
			
			VAR Latest_GP_Registered_Population =
			    CALCULATE(
			        SUM(REF_GP_Practice_Populations[Total Population]),
			        ALL(REF_GP_Practice_Ref),
			        NOT(ISBLANK(REF_GP_Practice_Ref[Locality])),
			        REF_GP_Practice_Populations[CensusDate_as_date] = Latest_GP_Population_date
			    )
			
			RETURN
			
			            DIVIDE(
			                Total_Drugs_Prescribed_County,
			                Latest_GP_Registered_Population
			            ) * 1000
			```
		displayFolder: Drug rate measures per 1000
		lineageTag: 385fea13-6b80-45c6-95c0-b7358490236a

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

