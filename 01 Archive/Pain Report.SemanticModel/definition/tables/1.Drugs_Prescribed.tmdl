	partition '1.Drugs_Prescribed' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Reference", [Query="#(lf)#(lf)SELECT#(tab)[Practice Code] = a.HSPracticeCode#(lf),a.BNFPresentationCode#(lf)#(tab)#(tab)#(tab), a.[BNFChemicalSubstance] as 'Drug'#(lf)#(tab)#(tab)#(tab),bnf.BNFParagraph as 'BNFParagraph'#(lf)#(tab)#(tab)#(tab),bnf.[BNFSection]  as 'BNFSection' #(lf)#(tab)#(tab)#(tab), a.[BNFPresentation] as 'BNFPresentation'#(lf)#(tab)#(tab)#(tab), a.[YearMonth]#(lf)#(tab)#(tab),[Dispensing_YearMonth_as_Date] = CAST(CONCAT(SUBSTRING(CONVERT(VARCHAR, a.[YearMonth]), 1, 4), '-', SUBSTRING(CONVERT(VARCHAR, a.[YearMonth]), 5, 2), '-01') AS DATE) #(lf)#(tab)#(tab)#(tab), sum(CAST(a.[Items] AS INT) ) as 'Total items'#(lf)#(lf)FROM#(tab)#(tab)[CCG_Current].[ePACT2].[vw_Extract] a#(lf)left join [PowerBI_Reporting].[Prescribing].[tbl01_BNF_Reference] AS BNF on a.BNFPresentationCode = bnf.BNFPresentationCode#(lf)left join CCG_Reference.Reference.vw_GPPractice as gpr on a.HSPracticeCode = gpr.OrganisationCode#(lf)#(lf)WHERE#(tab)#(tab)((bnf.BNFParagraphCode = '40702') -- 4.7.2 -  Opioid analgesics#(lf)or (bnf.BNFSectionCode = '403')-- Anti-Depressants #(lf)  or (bnf.BNFChemicalSubstanceCode IN ('0408010G0','0408010AE')) -- Pregabalin,Gabapentin#(lf)  or (bnf.BNFChemicalSubstanceCode = '0401020K0')) -- Diazepam#(lf)#(lf)  and  CAST(CONCAT(SUBSTRING(CONVERT(VARCHAR, a.[YearMonth]), 1, 4), '-', SUBSTRING(CONVERT(VARCHAR, a.[YearMonth]), 5, 2), '-01') AS DATE)  >='20190401' #(lf)#(lf)#(lf)GROUP BY#(tab)a.HSPracticeCode#(lf)#(tab)#(tab)#(tab),a.BNFPresentationCode#(lf)#(tab)#(tab)#(tab), a.[BNFChemicalSubstance]#(lf)#(tab)#(tab)#(tab),bnf.[BNFParagraph]#(lf)#(tab)#(tab)#(tab),bnf.[BNFSection]  #(lf)#(tab)#(tab)#(tab), a.[BNFPresentation]#(lf)#(tab)#(tab)#(tab), a.yearmonth#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)--- TEST #(lf)"])
				in
				    Source

