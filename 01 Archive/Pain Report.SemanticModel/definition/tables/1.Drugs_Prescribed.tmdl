	measure average_total_dispensed_rate_per_1000 = ```
			
			
			
			VAR TOTAL_ITEMS_DISPENSED_OVER_TIME_PERIOD = 
			calculate(sum('1.Drugs_Prescribed'[Total items])
			,REMOVEFILTERS(REF_Date_Ref)
			,REF_Date_Ref[SPC_Flag] = 1 
			)
			
			
			VAR TOTAL_GP_POPULATIONS_OVER_TIME_PERIOD = 
			calculate(sum(REF_GP_Practice_Populations[Total Population])
			,REMOVEFILTERS(REF_Date_Ref)
			,REF_Date_Ref[SPC_Flag] = 1 
			)
			
			
			
			
			VAR AverageRate =
			(TOTAL_ITEMS_DISPENSED_OVER_TIME_PERIOD/TOTAL_GP_POPULATIONS_OVER_TIME_PERIOD)*1000
			
			
			RETURN
			AverageRate
			```
		formatString: 0.00
		displayFolder: Drug rate measures per 1000
		lineageTag: d5c12ec6-a819-444f-8037-dd7def21e997

		annotation PBI_FormatHint = {"isCustom":true}

