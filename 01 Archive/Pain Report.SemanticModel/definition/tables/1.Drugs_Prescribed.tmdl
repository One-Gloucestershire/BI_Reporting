	measure Confidence_Interval_Lower_Latest_drug_dispensed_rates_per_1000 = ```
			
			VAR Latest_GP_Population_date = 
			    CALCULATE(
			        MAX(REF_GP_Practice_Populations[CensusDate_as_date]),
			        NOT(ISBLANK(REF_GP_Practice_Ref[Locality]))
			    )
			
			VAR CountVariable =
			 SUM('1.Drugs_Prescribed'[Total items])
			 
			VAR DenominatorVariable = 
			    CALCULATE(
			        DISTINCTCOUNT(REF_GP_Practice_Populations[NHS_Number]),
			        FILTER(
			            REF_GP_Practice_Populations,
			            REF_GP_Practice_Populations[Census_Date] = Latest_GP_Population_date
			        ),
			        FILTER(
			            REF_GP_Practice_Ref,
			            NOT(ISBLANK(REF_GP_Practice_Ref[Locality]))
			        )
			    )
			
			VAR ConfidenceLevel = 95
			VAR ScalingFactor = 1000
			// Approximate the Inverse of the Standard Normal Distribution
			VAR ApproxNORM_INV = 
			IF(
			 ConfidenceLevel = 95, 
			1.9599639845400500, // 95% confidence level
			 IF(
			 ConfidenceLevel = 90, 
			1.645, // 90% confidence level
			 1.28 // 80% confidence level as an example
			 )
			 )
			
			// Byars Calculation
			RETURN
			 IF(
			 CountVariable < 10, 
			IFERROR( (CHISQ.INV(1 - (0.5 + ConfidenceLevel / 200), 2 * CountVariable) / 2),
			 BLANK())
			 
			, CountVariable * (1 - 1 / (9 * CountVariable) - (ApproxNORM_INV / (3 * SQRT(CountVariable))))^3
			 )
			 / DenominatorVariable * ScalingFactor
			```
		displayFolder: Drug rate measures per 1000
		lineageTag: fdc169d4-aec4-49ee-9d5a-db6b6a309c4c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Confidence_Interval_Upper_Latest_drug_dispensed_rates_per_1000 = ```
			
			VAR Latest_GP_Population_date = 
			    CALCULATE(
			        MAX(REF_GP_Practice_Populations[CensusDate_as_date]),
			        NOT(ISBLANK(REF_GP_Practice_Ref[Locality]))
			    )
			
			VAR CountVariable =
			 SUM('1.Drugs_Prescribed'[Total items])
			 
			VAR DenominatorVariable = 
			    CALCULATE(
			        DISTINCTCOUNT(REF_GP_Practice_Populations[NHS_Number]),
			        FILTER(
			            REF_GP_Practice_Populations,
			            REF_GP_Practice_Populations[Census_Date] = Latest_GP_Population_date
			        ),
			        FILTER(
			            REF_GP_Practice_Ref,
			            NOT(ISBLANK(REF_GP_Practice_Ref[Locality]))
			        )
			    )
			
			VAR ConfidenceLevel = 95
			VAR ScalingFactor = 1000
			// Approximate the Inverse of the Standard Normal Distribution
			VAR ApproxNORM_INV = 
			IF(
			 ConfidenceLevel = 95, 
			1.9599639845400500, // 95% confidence level
			 IF(
			 ConfidenceLevel = 90, 
			1.645, // 90% confidence level
			 1.28 // 80% confidence level as an example
			 )
			 )
			// Byars Calculation
			
			// Byars Calculation for Upper Bound
			RETURN
			IF(
			 CountVariable < 10, 
			iferror( (CHISQ.INV(1 - (0.5 - ConfidenceLevel / 200), 2*CountVariable+2) / 2),
			 BLANK()), 
			(CountVariable + 1) * (1 - 1 / (9 * (CountVariable + 1)) + (ApproxNORM_INV / (3 * SQRT(CountVariable + 1))))^3
			) / DenominatorVariable * ScalingFactor
			```
		displayFolder: Drug rate measures per 1000
		lineageTag: 69bda77e-5ed5-4bbd-8f79-81a83b1fdc17

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Dispensed_moving_range = ```
			
			
			VAR FilteredTable_ =
			    FILTER(
			        ALL(REF_Date_Ref),
			        REF_Date_Ref[YearMonthIndex] >= 1 && REF_Date_Ref[SPC_Flag] = 1
			    )
			
			VAR SummaryTable =
			    SUMMARIZE(
			        FilteredTable_,
			        ref_date_ref[financial_year],
			        REF_Date_Ref[month_name],
			        REF_Date_Ref[YearMonthIndex],
			        REF_Date_Ref[SPC_Flag],
			        "Dispensed_Rate_per_1000_Population_Per_Month_OT", [Dispensed_Rate_per_1000_Population_Per_Month_OT]
			    )
			
			VAR SummaryTableWithDifference =
			    ADDCOLUMNS(
			        SummaryTable,
			        "Difference",
			        VAR CurrentYearMonthIndex = [YearMonthIndex]
			        VAR NextValue =
			            CALCULATE(
			                MINX(
			                    FILTER(
			                        SummaryTable,
			                        [YearMonthIndex] = CurrentYearMonthIndex + 1
			                    ),
			                    [Dispensed_Rate_per_1000_Population_Per_Month_OT]
			                )
			            )
			        RETURN IF(ISBLANK(NextValue), BLANK(),  abs([Dispensed_Rate_per_1000_Population_Per_Month_OT] - NextValue))
			    )
			
			VAR Differences =
			    SELECTCOLUMNS(SummaryTableWithDifference, "Diff", [Difference])
			
			    VAR Cumulative_moving_range = (AVERAGEX(Differences, [Diff])) 
			
			RETURN Cumulative_moving_range *2.66
			```
		displayFolder: Drug rate measures per 1000
		lineageTag: f67b7e06-adb4-401d-9847-7b6d5ab06220

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure UCL_Drugs_Dispensed_Rate = [average_total_dispensed_rate_per_1000]  + [Dispensed_moving_range]
