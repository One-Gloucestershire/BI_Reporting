	measure Dispensed_Rate_per_1000_Dynamic_Variable = ```
			
			 
			SWITCH (
			    TRUE(),
			    ------------------Locality------------------
			    SELECTEDVALUE('REF_Area Legend'[Field]) = "Locality",
			    CALCULATE([Dispensed_Rate_per_1000_Population_Per_Month_OT],
			    USERELATIONSHIP('REF_Area Legend'[Area], 'REF_GP_Practice_Ref'[Locality])
			    ),
			    ------------------PCN------------------
			     SELECTEDVALUE('REF_Area Legend'[Field]) = "PCN",
			    CALCULATE([Dispensed_Rate_per_1000_Population_Per_Month_OT],
			    USERELATIONSHIP('REF_Area Legend'[Area], 'REF_GP_Practice_Ref'[PrimaryCareNetwork])
			    ),
			    ------------------Practice------------------
			    SELECTEDVALUE('REF_Area Legend'[Field]) = "GP practice",
			    CALCULATE([Dispensed_Rate_per_1000_Population_Per_Month_OT],
			    USERELATIONSHIP('REF_Area Legend'[Area], 'REF_GP_Practice_Ref'[ReportingOrganisationName])
			    ),
			    BLANK())
			```
