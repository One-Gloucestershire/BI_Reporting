	measure Latest_dispensed_in_time_period_rate_per_1000 = ```
			
			
			VAR Latest_GP_Population_date = 
			    CALCULATE(
			        MAX(REF_GP_Practice_Populations[CensusDate_as_date]),
			        NOT(ISBLANK(REF_GP_Practice_Ref[Locality]))
			    )
			
			RETURN
			Calculate((sum('1.Drugs_Prescribed'[Total items])/sum(REF_GP_Practice_Populations[Total Population]))*1000,REF_GP_Practice_Populations[CensusDate_as_date] = Latest_GP_Population_date)
