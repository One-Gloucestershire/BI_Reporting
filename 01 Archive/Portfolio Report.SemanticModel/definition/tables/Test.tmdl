	measure 'Test P Prime Z Value' = ```
			
			
			var percentage_check = MAX('Test'[Is a Percentage Metric])
			
			VAR n_total = IF(
			    percentage_check = 0, BLANK(), 'Test'[Test Total Denominator])
			
			VAR k = IF(
			    percentage_check = 0, BLANK(), COUNT('Test'[Reporting_Date]))  
			
			VAR N_value = n_total / k
			
			VAR np = IF(
			    percentage_check = 0, BLANK(), CALCULATE([Test Total Numerator],ALL('Date Reference')))
			
			VAR n = IF(
			    percentage_check = 0, BLANK(), CALCULATE([Test Total Denominator],ALL('Date Reference')))  
			
			VAR p_values = CALCULATE(np / n,ALL('Date Reference'))
			
			VAR p = IF(
			    percentage_check = 0, BLANK(), [Test Total Value])
			
			Var z_value =  (p - p_values) / 
			SQRT((((1 - p_values) * p_values) / n_value)) 
			
			RETURN z_value
			
			```
		lineageTag: 93159662-b124-40b0-b79d-9a86344494dc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

