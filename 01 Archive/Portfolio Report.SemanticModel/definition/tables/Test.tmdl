	column Test_YearMonthIndex =
			
			
			
			RANKX(
			    ALL('Test'[Reporting_Date]),
			    'Test'[Reporting_Date],
			    ,
			    ASC,
			    DENSE
			) - 1
		formatString: 0
		lineageTag: b454a9ea-8c6d-4b0e-b4ca-26285f7a9896
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Test Moving Range' = ```
			
			     if('Test'[Test_YearMonthIndex]<=1,0, --ignore the first record
			     ABS('Test'[Test P Prime Z Value]-'Test'[Prior Z Value])
			 )
			
			 //calculate the absolute difference between the current game and the prior game yards
			
			```
