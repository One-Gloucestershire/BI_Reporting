	measure 'Doesnt Work Moving Range Test' = ```
			
			VAR FilteredTable_ =
			    FILTER(
			        ALL('Date Reference'),
			        'Date Reference'[YearMonthIndex] >= 1 && 'Date Reference'[Test_SPC_flag] = 1
			    )
			
			VAR SummaryTable =
			    SUMMARIZE(
			        FilteredTable_,
			        'Date Reference'[Fin_Year],
			        'Date Reference'[month_name],
			        'Date Reference'[YearMonthIndex],
			        'Date Reference'[Test_SPC_flag],
			        "Total Value", [Test P Prime Z Value]
			    )
			
			VAR SummaryTableWithDifference =
			    ADDCOLUMNS(
			        SummaryTable,
			        "Difference",
			        VAR CurrentYearMonthIndex = [YearMonthIndex]
			        VAR NextValue =
			            CALCULATE(
			                MINX(
			                    FILTER(
			                        SummaryTable,
			                        [YearMonthIndex] = CurrentYearMonthIndex + 1
			                    ),
			                   [Test P Prime Z Value]
			                )
			            )
			        RETURN IF(ISBLANK(NextValue), BLANK(),  abs([Test P Prime Z Value] - NextValue))
			    )
			
			VAR Differences =
			    SELECTCOLUMNS(SummaryTableWithDifference, "Diff", [Difference])
			
			    RETURN (AVERAGEX(Differences, [Diff])) 
			
			```
		lineageTag: d8f853ed-ac3c-4897-8049-8c04ace053bd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Doesnt Work New Moving Range Test' =
			
			
			VAR EarlierTime =
			    CALCULATE (
			        MAX ( 'Date Reference'[Full_Date] ),
			        FILTER (
			            ALLSELECTED ( 'Date Reference'[Full_Date] ),
			            'Date Reference'[Full_Date] < SELECTEDVALUE ( 'Date Reference'[Full_Date] )
			        )
			    )
			VAR EarlierMeasureValue =
			    CALCULATE ( ( 'Test'[Test P Prime Z Value] ), 'Date Reference'[Full_Date] = EarlierTime )
			RETURN
			     ABS ( EarlierMeasureValue - ( 'Test'[Test P Prime Z Value]) )
		lineageTag: 7602f237-5c09-48f2-a213-4e5ba77e75d5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Test Moving Range' = CALCULATE(AVERAGE('Test'[Test Moving Range]),ALL('Date Reference'))
		lineageTag: 9938b9df-88d5-4db4-adc0-9ecb4049188e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Test Standard Deviation Z Value' = 'Test'[Average Test Moving Range] / 1.128
		lineageTag: 9ac4834c-eb46-4d05-9f85-998e3015fb19

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Test P UCL' = ```
			
			
			    var percentage_check = MAX('Test'[Is a Percentage Metric])
			
			VAR n_total = IF(
			    percentage_check = 0, BLANK(), 'Test'[Test Total Denominator])
			
			VAR k = IF(
			    percentage_check = 0, BLANK(), COUNT('Test'[Reporting_Date]))  
			
			VAR N_value = n_total / k
			
			VAR np = IF(
			    percentage_check = 0, BLANK(), CALCULATE([Test Total Numerator],ALL('Date Reference')))
			
			VAR n = IF(
			    percentage_check = 0, BLANK(), CALCULATE([Test Total Denominator],ALL('Date Reference')))  
			
			VAR p_values = CALCULATE(np / n,ALL('Date Reference'))
			
			VAR p = IF(
			    percentage_check = 0, BLANK(), [Test Total Value])
			
			RETURN p_values + 3*[Test Standard Deviation Z Value] *
			    ((SQRT(((p_values*(1-p_values)) /n_total))))
			
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8babf8d1-2df6-46db-9b35-fba03d44b55b

