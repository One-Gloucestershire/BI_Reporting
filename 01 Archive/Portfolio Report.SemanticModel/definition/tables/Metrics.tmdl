	measure 'P Prime Standard Deviation Z Value' = 'Metrics'[Lanley P Prime Moving Range Average] / 1.128
		formatString: 0.0000
		displayFolder: SPC - P Prime
		lineageTag: 0ba143da-70de-4404-b73a-dbc907f9bbb3

	measure 'Laney P Prime UCL' = ```
			
			
			var percentage_as_rate_per_1000 = SELECTEDVALUE('Metrics'[Percentage Metric as Rate per 1000])
			
			VAR denominator = 'Metrics'[Total Denominator]
			
			VAR total_numerator = CALCULATE([Total Numerator],ALL('Date Reference'))
			
			VAR total_denominator = CALCULATE([Total Denominator],ALL('Date Reference'))
			
			VAR total_value = CALCULATE(total_numerator / total_denominator,ALL('Date Reference'))
			
			VAR ucl = IFERROR(total_value + 3*[P Prime Standard Deviation Z Value] *
			    ((SQRT(((total_value*(1-total_value)) /denominator)))),BLANK())
			
			RETURN 
			SWITCH(TRUE(),
			percentage_as_rate_per_1000 = TRUE() && ucl > 1000, 999    --this uses the same SPC logic as the P chart but as it is calculated as a rate per 1000 it ensures it can never   be over 1000 as that is 100%
			,percentage_as_rate_per_1000 = FALSE() && ucl > 1,0.999         --this ensures any percentage metric doesn't go over 100%
			,ucl)
			
			```
		formatString: 0.0000
		displayFolder: SPC - P Prime
		lineageTag: 1c13de39-9d21-4f85-ac0b-b47b76e0a151

	measure 'Laney P Prime LCL' =
			
			
			VAR n_total = 'Metrics'[Total Denominator]
			
			VAR k = COUNT('Metrics'[Reporting_Date])
			
			VAR N_value = n_total / k
			
			VAR np = CALCULATE([Total Numerator],ALL('Date Reference'))
			
			VAR n = CALCULATE([Total Denominator],ALL('Date Reference'))
			
			VAR p_values = CALCULATE(np / n,ALL('Date Reference'))
			
			VAR p = [Total Value]
			
			VAR lcl = IFERROR(p_values - 3*[P Prime Standard Deviation Z Value] *
			    ((SQRT(((p_values*(1-p_values)) /n_total)))),BLANK())
			
			VAR final = IF(lcl <= 0, 0.001, lcl)
			
			RETURN final
		displayFolder: SPC - P Prime
		lineageTag: 26bddf28-9700-46fa-8f49-c755b86cf8d4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Prior Laney P Prime Z Value' =
			
			
			VAR CurrMetric = SELECTEDVALUE('Metrics'[Metric_ID])
			VAR CurrYM = MAX('Date Reference'[YearMonth_YYYYMM])   -- use Date Reference, not Metrics
			
			-- Find the previous month that exists in Date Reference
			VAR PrevYM =
			    MAXX(
			        FILTER(
			            ALL('Date Reference'),
			            'Date Reference'[YearMonth_YYYYMM] < CurrYM
			        ),
			        'Date Reference'[YearMonth_YYYYMM]
			    )
			
			VAR final =
			IF(
			    ISBLANK(PrevYM),
			    BLANK(),
			    CALCULATE(
			        [Laney P Prime Z Value],
			        KEEPFILTERS(VALUES('Metrics'[Metric_ID])),
			        REMOVEFILTERS('Date Reference'[YearMonth_YYYYMM]),
			        TREATAS({PrevYM}, 'Date Reference'[YearMonth_YYYYMM])
			    )
			)
			
			RETURN IFERROR(final, BLANK())
		displayFolder: SPC - P Prime
		lineageTag: 4885fecc-fe0d-4a7d-a942-bb8190a10c7a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

