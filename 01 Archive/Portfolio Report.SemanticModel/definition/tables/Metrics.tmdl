	measure 'SPC special variation concern' = ```
			
			
			VAR good_is = max([Good_Is])
			
			VAR final =
			SWITCH(TRUE(),
			
			[SPC_value_outside_of_LCL] <> BLANK() && good_is = "High", [Total Value],
			[SPC_value_outside_of_LCL] <> BLANK() && good_is = "Low", BLANK(),
			
			[SPC_outside_of_UCL] <> BLANK() && good_is = "Low", [Total Value],
			[SPC_outside_of_UCL] <> BLANK() && good_is = "High", BLANK(),
			
			[SPC_two_out_of_three_in_outer_and_or_lower_third] <> BLANK() 
			&& [SPC_two_out_of_three_in_outer_and_or_lower_third] >= [UpperOuterThird] && good_is = "Low", [Total Value],
			[SPC_two_out_of_three_in_outer_and_or_lower_third] <> BLANK() 
			&& [SPC_two_out_of_three_in_outer_and_or_lower_third] <= [LowerOuterThird] && good_is = "High", [Total Value],
			
			[SPC_two_out_of_three_in_outer_and_or_lower_third] <> BLANK() 
			&& [SPC_two_out_of_three_in_outer_and_or_lower_third] >= [UpperOuterThird] && good_is = "High", BLANK(),
			[SPC_two_out_of_three_in_outer_and_or_lower_third] <> BLANK() 
			&& [SPC_two_out_of_three_in_outer_and_or_lower_third] <= [LowerOuterThird] && good_is = "Low", BLANK(),
			
