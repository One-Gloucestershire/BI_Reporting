	measure 'I Prime Standard Deviation' = ```
			
			
			VAR current_denominator = [Total Denominator] 
			VAR current_value = [Total Value]
			VAR prior_denominator = [I Prime Prior Denominator]
			VAR prior_value = [I Prime Prior Value]
			
			VAR value_compute =
			ABS(current_value - prior_value)
			
			VAR denominator_compute =
			1/current_denominator + 1/prior_denominator
			
			VAR sqrt_denominator =
			IFERROR(SQRT(denominator_compute),BLANK())
			
			VAR divide_value_by_numerator =
			IFERROR(value_compute / sqrt_denominator,BLANK())
			
			VAR pi_compute =
			PI()/2
			
			--VAR pi_multiply =
			--IFERROR(pi_compute * divide_value_by_numerator,BLANK())
			
			--VAR total_sqrt =
			--IFERROR(SQRT(pi_multiply),BLANK())
			
			--VAR final =
			--IFERROR(total_sqrt,BLANK())
			
			VAR sqrt_pi =
			SQRT(pi_compute)
			
			VAR final = 
			sqrt_pi * divide_value_by_numerator
			
			
			
			RETURN
			final
			
			```
		formatString: 0.000000
		lineageTag: 80a72ef4-7bd5-4e3f-a5de-a7f8d3c47048

	measure 'I Prime Prior Value' =
			
			
			VAR CurrMetric = SELECTEDVALUE('Metrics'[Metric_ID])
			VAR CurrYM = MAX('Date Reference'[YearMonth_YYYYMM])   -- use Date Reference, not Metrics
			
			-- Find the previous month that exists in Date Reference
			VAR PrevYM =
			    MAXX(
			        FILTER(
			            ALL('Date Reference'),
			            'Date Reference'[YearMonth_YYYYMM] < CurrYM
			        ),
			        'Date Reference'[YearMonth_YYYYMM]
			    )
			
			VAR final =
			IF(
			    ISBLANK(PrevYM),
			    BLANK(),
			    CALCULATE(
			        [Total Value],
			        KEEPFILTERS(VALUES('Metrics'[Metric_ID])),
			        REMOVEFILTERS('Date Reference'[YearMonth_YYYYMM]),
			        TREATAS({PrevYM}, 'Date Reference'[YearMonth_YYYYMM])
			    )
			)
			
			RETURN IFERROR(final, BLANK())
		lineageTag: c4af330e-4826-4684-95ad-595a2a89ca34

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'I Prime Prior Denominator' =
			
			
			VAR CurrMetric = SELECTEDVALUE('Metrics'[Metric_ID])
			VAR CurrYM = MAX('Date Reference'[YearMonth_YYYYMM])   -- use Date Reference, not Metrics
			
			-- Find the previous month that exists in Date Reference
			VAR PrevYM =
			    MAXX(
			        FILTER(
			            ALL('Date Reference'),
			            'Date Reference'[YearMonth_YYYYMM] < CurrYM
			        ),
			        'Date Reference'[YearMonth_YYYYMM]
			    )
			
			VAR final =
			IF(
			    ISBLANK(PrevYM),
			    BLANK(),
			    CALCULATE(
			        [Total Denominator],
			        KEEPFILTERS(VALUES('Metrics'[Metric_ID])),
			        REMOVEFILTERS('Date Reference'[YearMonth_YYYYMM]),
			        TREATAS({PrevYM}, 'Date Reference'[YearMonth_YYYYMM])
			    )
			)
			
			RETURN IFERROR(final, BLANK())
		lineageTag: 15d1dbed-63f0-44b8-884d-f459fafc6157

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'I Prime Average Standard Deviation' = ```
			
			
			VAR sum_of_standard_deviation = 
			CALCULATE(
			sumx(
			    VALUES('Date Reference'[YearMonth_YYYYMM]),   -- iterate over each month
			    [I Prime Standard Deviation]                                        -- evaluate MR for that row/context
			),ALL('Date Reference'))
			
			VAR number_of_data_points = CALCULATE([Number of data points],ALL('Date Reference')) -1
			
			VAR final =
			sum_of_standard_deviation / number_of_data_points
			
			RETURN
			final
			```
		formatString: 0.0000
		lineageTag: 14ef9606-fd9b-47d8-9be3-33faeea7043c

	measure 'I Prime UCL new' =
			
			
			VAR sqrt_denominator =
			SQRT([Total Denominator])
			
			VAR std_dev_divide_sqrt_denom =
			[I Prime Average Standard Deviation] / sqrt_denominator
			
			VAR final =
			CALCULATE([Total Numerator]/[Total Denominator],ALL('Date Reference')) + 3 * std_dev_divide_sqrt_denom
			
			RETURN
			IFERROR(final,BLANK())
		formatString: 0.0000
		lineageTag: 41168767-16fc-4532-87ee-2165a4617b9b

	measure SPC_15_points_near_the_mean_daily =
			
			
			VAR FilteredTable_ =
			    CALCULATETABLE(
			        'Date Reference',
			       filter(ALLSELECTED('Date Reference'),'Date Reference'[Date_112] >= 1)
			    )
			
			VAR SummaryTable =
			    SUMMARIZE(
			        FilteredTable_,
			       'Date Reference'[Full_Date],
			        'Date Reference'[Date_112],
			        'Date Reference'[SPC_Flag],
			        "Total Value", [Total Value]
			    )
			
			VAR LatestYearMonthIndex = MAX('Date Reference'[Date_112])
			
			VAR MeanValue = [Value SPC Mean]
			
			VAR LowerInnerThird = [LowerInnerThird]
			
			VAR UpperInnerThird = [UpperInnerThird]
			
			VAR SummaryTableWithCount =
			    ADDCOLUMNS(
			        SummaryTable,
			        "NeartheMeanCount",
			        VAR CurrentYearMonthIndex = 'Date Reference'[Date_112]
			        VAR CurrentLast15Months =
			            FILTER(
			                SummaryTable,
			                'Date Reference'[Date_112] <= CurrentYearMonthIndex &&
			                'Date Reference'[Date_112] > CurrentYearMonthIndex - 15
			            )
			        VAR In_Inner_Upper_or_Lower_Third =
			    COUNTROWS(
			        FILTER(
			            CurrentLast15Months,
			            (
			                [Total Value] >= MeanValue &&
			                [Total Value] <= UpperInnerThird
			            )
			            ||
			            (
			                [Total Value] <= MeanValue &&
			                [Total Value] >= LowerInnerThird
			            )
			        ))
			        RETURN IF(In_Inner_Upper_or_Lower_Third >= 15, 1, 0)
			    )
			
			VAR FlaggedYearMonthIndexes =
			    SELECTCOLUMNS(
			        FILTER(
			            SummaryTableWithCount,
			            [NeartheMeanCount] = 1
			        ),
			        "Date_112", 'Date Reference'[Date_112]
			    )
			
			VAR AdditionalFlags =
			    UNION(
			
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [Date_112] - 14),
			            "Date_112", [OffsetIndex]
			        ),
			
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [Date_112] - 13),
			            "Date_112", [OffsetIndex]
			        ),
			
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [Date_112] - 11),
			            "Date_112", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [Date_112] - 10),
			            "Date_112", [OffsetIndex]
			        ),
			
			
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [Date_112] - 9),
			            "Date_112", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [Date_112] - 8),
			            "Date_112", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [Date_112] - 7),
			            "Date_112", [OffsetIndex]
			        ),
			
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [Date_112] - 6),
			            "Date_112", [OffsetIndex]
			        ),
			
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [Date_112] - 5),
			            "Date_112", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [Date_112] - 4),
			            "Date_112", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [Date_112] - 3),
			            "Date_112", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [Date_112] - 2),
			            "Date_112", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [Date_112] - 1),
			            "Date_112", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [Date_112]),
			            "Date_112", [OffsetIndex]
			        )
			    )
			
			VAR FinalTable =
			    ADDCOLUMNS(
			        SummaryTableWithCount,
			        "AdditionalFlag",
			        IF(
			            'Date Reference'[Date_112] IN AdditionalFlags, 1, 0
			        )
			    )
			
			
			VAR final = if(min('Date Reference'[Date_112]) in  AdditionalFlags,[Total Value],BLANK())
			
			RETURN  final
		lineageTag: c494b025-f823-4dab-baca-d62cc481232c

