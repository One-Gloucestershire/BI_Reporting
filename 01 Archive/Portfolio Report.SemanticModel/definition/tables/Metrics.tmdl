	measure SPC_increasing_trend = ```
			
			VAR FilteredTable_ =
			   filter(ALLSELECTED('Date Reference'),'Date Reference'[YearMonthIndex] >= 1)
			
			VAR SummaryTable =
			    SUMMARIZE(
			        FilteredTable_,
			        'Date Reference'[Fin_Year],
			        'Date Reference'[month_name],
			        'Date Reference'[YearMonthIndex],
			        'Date Reference'[SPC_Flag],
			        "Total Value", [Total Value]
			    )
			
			VAR SummaryTableWithDifference =
			    ADDCOLUMNS(
			        SummaryTable,
			        "Difference",
			        VAR CurrentYearMonthIndex = 'Date Reference'[YearMonthIndex]
			        VAR NextValue =
			            CALCULATE(
			                MAXX(
			                    FILTER(
			                        SummaryTable,
			                        'Date Reference'[YearMonthIndex] = CurrentYearMonthIndex + 1
			                    ),
			                    [Total Value]
			                )
			            )
			        RETURN NextValue - [Total Value]
			    )
			
			VAR SummaryTableWithIncreasingFlag =
			    ADDCOLUMNS(
			        SummaryTableWithDifference,
			        "IncreasingFlag",
			        IF([Difference] > 0, 1, 0)
			    )
			
			VAR IncreasingSequence =
			    FILTER(
			        ADDCOLUMNS(
			            SummaryTableWithIncreasingFlag,
			            "IncreasingSequence",
			            VAR CurrentYearMonthIndex = 'Date Reference'[YearMonthIndex]
			            VAR IncreasingCount =
			                COUNTROWS(
			                    FILTER(
			                        SummaryTableWithIncreasingFlag,
			                        'Date Reference'[YearMonthIndex] >= CurrentYearMonthIndex &&
			                        'Date Reference'[YearMonthIndex] <= CurrentYearMonthIndex + 4 &&
			                        [IncreasingFlag] = 1
			                    )
			                )
			            RETURN 
			            
			            IF(IncreasingCount =5, 1, 0) -- Adjust the number of periods for your trend
			        ),
			        [IncreasingSequence] = 1
			    )
			
			VAR AdditionalFlags =
			   UNION(
			   
			              SELECTCOLUMNS(
			            ADDCOLUMNS(IncreasingSequence, "OffsetIndex", [YearMonthIndex] + 5),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			   
			              SELECTCOLUMNS(
			            ADDCOLUMNS(IncreasingSequence, "OffsetIndex", [YearMonthIndex] + 4),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			   
			        SELECTCOLUMNS(
			            ADDCOLUMNS(IncreasingSequence, "OffsetIndex", [YearMonthIndex] + 3),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(IncreasingSequence, "OffsetIndex", [YearMonthIndex] + 2),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(IncreasingSequence, "OffsetIndex", [YearMonthIndex] + 1),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(IncreasingSequence, "OffsetIndex", [YearMonthIndex]),
			            "YearMonthIndex", [OffsetIndex]
			        )
			    )
			    
			RETURN
			IF(    MIN('Date Reference'[YearMonthIndex]) IN AdditionalFlags,    [Total Value],    BLANK())
			```
