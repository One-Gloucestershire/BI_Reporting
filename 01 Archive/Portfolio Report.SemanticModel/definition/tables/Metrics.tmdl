	measure SPC_Two_out_of_three_points_near_to_the_LCL = ```
			
			
			VAR FilteredTable_ =
			    filter(ALLSELECTED('Date Reference'),'Date Reference'[YearMonthIndex] >= 1)
			
			VAR SummaryTable =
			    SUMMARIZE(
			        FilteredTable_,
			        'Date Reference'[Fin_Year],
			        'Date Reference'[month_name],
			        'Date Reference'[YearMonthIndex],
			        'Date Reference'[SPC_Flag],
			        "Total Value", [Total Value]
			    )
			
			VAR MeanValue = [Value SPC Mean]
			VAR ucl = [UCL SPC]
			VAR lcl = [LCL SPC]
			VAR sigma = (ucl - lcl) / 6
			
			VAR LowerOuterThird = [LowerOuterThird]
			VAR UpperOuterThird = [UpperOuterThird]
			
			VAR SummaryTableWithFlags =
			    ADDCOLUMNS(
			        SummaryTable,
			        "IsBelowLowerOuterThird",
			        IF([Total Value] < [LowerOuterThird], 1, 0),
			        "IsBelowMean",
			        IF([Total Value] < [Value SPC Mean], 1, 0),
			         "IsAboveUpperOuterThird",
			        IF([Total Value] > [UpperOuterThird], 1, 0),
			        "IsAboveMean",
			        IF([Total Value] > [Value SPC Mean], 1, 0)       
			    )
			
			VAR PatternTable =
			    ADDCOLUMNS(
			        SummaryTableWithFlags,
			        "PatternFlag",
			        VAR CurrentIndex = 'Date Reference'[YearMonthIndex]
			
			        // Check the range of two months behind the current month index
			        VAR CheckPrevRange =
			            CALCULATE(
			                SUMX(
			                    FILTER(
			                        SummaryTableWithFlags,
			                        'Date Reference'[YearMonthIndex] IN {CurrentIndex - 2, CurrentIndex - 1, CurrentIndex}
			                    ),
			                    [IsBelowLowerOuterThird]
			                )
			            )
			        
			        // Check the range of one month either side of the current month index for lower third
			        VAR CheckMidRange_Lower =
			            CALCULATE(
			                SUMX(
			                    FILTER(
			                        SummaryTableWithFlags,
			                        'Date Reference'[YearMonthIndex] IN {CurrentIndex - 1, CurrentIndex, CurrentIndex + 1}
			                    ),
			                    [IsBelowLowerOuterThird]
			                )
			            )
			
			        // Check the range of one month either side of the current month index for upper third
			        VAR CheckMidRange_Upper =
			            CALCULATE(
			                SUMX(
			                    FILTER(
			                        SummaryTableWithFlags,
			                        'Date Reference'[YearMonthIndex] IN {CurrentIndex - 1, CurrentIndex, CurrentIndex + 1}
			                    ),
			                    [IsAboveUpperOuterThird]
			                )
			            )            
			        
			        // Check the range of two months in front of the current month index for lower third
			        VAR CheckNextRange_Lower =
			            CALCULATE(
			                SUMX(
			                    FILTER(
			                        SummaryTableWithFlags,
			                        'Date Reference'[YearMonthIndex] IN {CurrentIndex, CurrentIndex + 1, CurrentIndex + 2}
			                    ),
			                    [IsBelowLowerOuterThird]
			                )
			            )
			
			        // Check the range of two months in front of the current month index for upper third
			        VAR CheckNextRange_Upper =
			            CALCULATE(
			                SUMX(
			                    FILTER(
			                        SummaryTableWithFlags,
			                        'Date Reference'[YearMonthIndex] IN {CurrentIndex, CurrentIndex + 1, CurrentIndex + 2}
			                    ),
			                    [IsAboveUpperOuterThird]
			                )
			            )            
			        
			        // Ensure all points in the previous range are below the mean
			        VAR CheckAllBelowMeanPrevRange_Below =
			            CALCULATE(
			                SUMX(
			                    FILTER(
			                        SummaryTableWithFlags,
			                        'Date Reference'[YearMonthIndex] IN {CurrentIndex - 2, CurrentIndex - 1, CurrentIndex}
			                    ),
			                    [IsBelowMean]
			                )
			            )
			
			        // Ensure all points in the previous range are above the mean
			        VAR CheckAllBelowMeanPrevRange_Above =
			            CALCULATE(
			                SUMX(
			                    FILTER(
			                        SummaryTableWithFlags,
			                        'Date Reference'[YearMonthIndex] IN {CurrentIndex - 2, CurrentIndex - 1, CurrentIndex}
			                    ),
			                    [IsAboveMean]
			                )
			            )            
			        
			        // Ensure all points in the middle range are below the mean
			        VAR CheckAllBelowMeanMidRange_Below =
			            CALCULATE(
			                SUMX(
			                    FILTER(
			                        SummaryTableWithFlags,
			                        'Date Reference'[YearMonthIndex] IN {CurrentIndex - 1, CurrentIndex, CurrentIndex + 1}
			                    ),
			                    [IsBelowMean]
			                )
			            )
			
			        // Ensure all points in the middle range are above the mean
			        VAR CheckAllBelowMeanMidRange_Above =
			            CALCULATE(
			                SUMX(
			                    FILTER(
			                        SummaryTableWithFlags,
			                        'Date Reference'[YearMonthIndex] IN {CurrentIndex - 1, CurrentIndex, CurrentIndex + 1}
			                    ),
			                    [IsAboveMean]
			                )
			            )            
			        
			        // Ensure all points in the next range are below the mean
			        VAR CheckAllBelowMeanNextRange_Below =
			            CALCULATE(
			                SUMX(
			                    FILTER(
			                        SummaryTableWithFlags,
			                        'Date Reference'[YearMonthIndex] IN {CurrentIndex, CurrentIndex + 1, CurrentIndex + 2}
			                    ),
			                    [IsBelowMean]
			                )
			            )
			
			        // Ensure all points in the next range are above the mean
			        VAR CheckAllBelowMeanNextRange_Above =
			            CALCULATE(
			                SUMX(
			                    FILTER(
			                        SummaryTableWithFlags,
			                        'Date Reference'[YearMonthIndex] IN {CurrentIndex, CurrentIndex + 1, CurrentIndex + 2}
			                    ),
			                    [IsAboveMean]
			                )
			            )            
			        
			        RETURN
			   
			IF (
			    [IsBelowLowerOuterThird] = 1 || [IsAboveUpperOuterThird] = 1 &&
			    (
			        (CheckPrevRange >= 2 && (CheckAllBelowMeanPrevRange_Below = 3 || CheckAllBelowMeanPrevRange_Above = 3)) ||
			        (CheckMidRange_Lower >= 2 && (CheckAllBelowMeanMidRange_Below = 3 || CheckAllBelowMeanMidRange_Above = 3)) ||
			        (CheckNextRange_Lower >= 2 && (CheckAllBelowMeanNextRange_Below = 3 || CheckAllBelowMeanNextRange_Above = 3))
			    ),
			    1,
			    0
			)
			
			    )
			
			VAR AdditionalFlags =
			    SELECTCOLUMNS(
			        FILTER(
			            PatternTable,
			            [PatternFlag] = 1
			        ),
			        "YearMonthIndex", 'Date Reference'[YearMonthIndex]
			    )
			
			RETURN
			IF(
			    MIN('Date Reference'[YearMonthIndex]) IN AdditionalFlags,
			    [Total Value],
			    BLANK()
			)
			```
		displayFolder: SPC - Old
		lineageTag: 66b1f2a8-6b65-4850-8ee0-4fc0f5042d33

