	measure 'SPC breached card (daily) over whole period' = ```
			
			
			var good_is = MAX('Metrics'[Good_Is])
			
			--var filtered = CALCULATE([Total Value],'Metrics'[Last 28 Days Flag] = TRUE())
			
			--var spc_breached_high = IF(CALCULATE([Total Value],'Metrics'[Last 28 Days Flag] = TRUE()) > CALCULATE([UCL SPC],'Metrics'[Last 28 Days Flag] = TRUE()), 1, 0)
			--var spc_breached_low = IF(CALCULATE([Total Value],'Metrics'[Last 28 Days Flag] = TRUE()) < CALCULATE([LCL SPC],'Metrics'[Last 28 Days Flag] = TRUE()), 1, 0)
			
			var data_points = SELECTEDVALUE('Metrics'[Number of data points per metric])
			
			VAR HighMaxValue =
			    MAXX ( ALLSELECTED ( 'Date Reference'[Full_Date] ), [Total Value] )
			VAR MinUCL =
			    MINX ( ALLSELECTED ( 'Date Reference'[Full_Date] ), [UCL SPC] )
			VAR spc_breached_high =
			    IF ( HighMaxValue > MinUCL, 1, 0 )
			
			
			VAR LowMaxValue =
			    MinX ( ALLSELECTED ( 'Date Reference'[Full_Date] ), [Total Value] )
			VAR MinLCL =
			    MaxX ( ALLSELECTED ( 'Date Reference'[Full_Date] ), [LCL SPC] )
			VAR spc_breached_low =
			    IF ( LowMaxValue < MinLCL, 1, 0 )
			
			
			var final = 
			SWITCH(TRUE(),
			data_points < 13, "No SPC",
			spc_breached_high = 1 && good_is = "N/A", "Breach",
			spc_breached_low = 1 && good_is = "N/A", "Breach",
			spc_breached_high = 1 && spc_breached_low = 1, "Postive & Negative Breach",
			spc_breached_high = 1 && good_is = "High", "Positive Breach",
			spc_breached_low = 1 && good_is = "Low", "Positive Breach",
			spc_breached_high = 1 && good_is = "Low", "Negative Breach",
			spc_breached_low = 1 && good_is = "High", "Negative Breach",
			
			"No Breach"
			)
			
			RETURN final
			```
		displayFolder: SPC - Breached Measures
		lineageTag: 62c778af-ca1f-438a-89e9-ecc619ce76e0

