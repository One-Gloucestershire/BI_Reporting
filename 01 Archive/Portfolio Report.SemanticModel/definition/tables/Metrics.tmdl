	measure SPC_decreasing_trend_daily = ```
			
			VAR FilteredTable_ =
			    filter(ALLSELECTED('Date Reference'),'Date Reference'[Date_112] >= 1)
			
			VAR SummaryTable =
			    SUMMARIZE(
			        FilteredTable_,
			        'Date Reference'[Full_Date],
