	column 'Decimal Places' =
			
			
			Var current_value = ABS([Current Value]) --makes number into a positive int
			
			
			RETURN
			SWITCH(TRUE(),
			[Metric Type] = "Count metric", "0 DP",
			
			[Metric Type] = "Percentage metric" && current_value >= 0.1, "1 DP",
			[Metric Type] = "Percentage metric" && current_value < 0.1, "2 DP",
			
			[Metric Type] = "Rate metric" && current_value >= 1000, "0 DP",
			[Metric Type] = "Rate metric" && current_value >= 100 && current_value < 1000, "1 DP",
			[Metric Type] = "Rate metric" && current_value < 100, "2 DP",
			
			
			[Metric Type] = "Inequalities metric" && current_value >= 100, "0 DP",
			[Metric Type] = "Inequalities metric" && current_value >= 100 && current_value < 1000, "1 DP",
			[Metric Type] = "Inequalities metric" && current_value < 100, "2 DP",
			
			[Metric Type] = "Measurement metric" && current_value >= 1000, "0 DP",
			[Metric Type] = "Measurement metric" && current_value >= 100 && current_value < 1000, "1 DP",
			[Metric Type] = "Measurement metric" && current_value < 100, "2 DP",
			
			"Error")
		lineageTag: b726419e-d314-43ce-8f3f-52b84275784d
		summarizeBy: none

