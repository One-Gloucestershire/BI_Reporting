	column 'Max Date per Metric' =
			
			
			var max_date = CALCULATE (
			    MAX('Metrics'[Reporting_Date] ),
			    FILTER (
			        'Metrics',
			        'Metrics'[Metric_ID] = EARLIER ( 'Metrics'[Metric_ID] )
			    )
			)
			
			RETURN CONCATENATE(LOOKUPVALUE('Date Reference'[Month_Name],'Date Reference'[Full_Date],max_date), CONCATENATE("-", RIGHT(LOOKUPVALUE('Date Reference'[Cal_Year],'Date Reference'[Full_Date],max_date),2)))
