	measure LowerOuterThird =
			
			
			VAR MeanValue = [Value SPC Mean]
			VAR ucl = [UCL SPC]
			VAR lcl = [LCL SPC]
			VAR sigma = (ucl - lcl) / 6
			
			VAR LowerOuterThird = MeanValue - 2 * sigma
			
			return LowerOuterThird
		displayFolder: SPC - General Measures
