	measure UpperOuterThird =
			
			
			VAR MeanValue = [Value SPC Mean]
			VAR ucl = [UCL SPC]
			VAR lcl = [LCL SPC]
			VAR sigma = (ucl - lcl) / 6
			
			VAR UpperOuterThird = MeanValue + 2 * sigma
			
			return UpperOuterThird
		displayFolder: SPC - General Measures
