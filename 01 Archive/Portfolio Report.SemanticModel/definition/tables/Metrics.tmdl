	measure 'SPC breached card (monthly)' = ```
			
			
			var good_is = MAX('Metrics'[Good_Is])
			
			var spc_breached_high = IF([Current Value] > [Current UCL (Monthly)], 1, 0)
			
			var spc_breached_low = IF([Current Value] < [Current LCL (Monthly)], 1, 0)
			
			var final = 
			SWITCH(TRUE(),
			[Number of data points] < 13, "No SPC",
			spc_breached_high = 1 && good_is = "High", "Positive Breach",
			spc_breached_low = 1 && good_is = "Low", "Positive Breach",
			spc_breached_high = 1 && good_is = "Low", "Negative Breach",
			spc_breached_low = 1 && good_is = "High", "Negative Breach",
			spc_breached_high = 1 && good_is = "N/A", "Breach",
			spc_breached_low = 1 && good_is = "N/A", "Breach",
			"No Breach"
			)
			
			RETURN final
			```
		displayFolder: SPC - Breached Measures
		lineageTag: 22cbff5f-4758-4c13-a70c-d73a956a50d7

	measure 'SPC Breached Text' = ```
			
			
			var good_is = MAX('Metrics'[Good Is Card])
			
			RETURN
			
			SWITCH(TRUE(),
			[SPC breached card (monthly)] = "No breach", "This metric has not breached the upper or lower control limits over the past two years. This means there has not been any one month in which a highly unexpected value occured.",
			
			[SPC breached card (monthly)] = "Negative breach" && good_is = "High", "This metric has breached the lower control limits over the past two years. This means there has been an unexpectedly low value. As the lower the value the better the performance, this is not a positive sign.",
			[SPC breached card (monthly)] = "Positive breach" && good_is = "High", "This metric has breached the upper control limits over the past two years. This means there has been an unexpectedly high value. As the higher the value the better the performance, this is not a positive sign.",
			[SPC breached card (monthly)] = "Breach" && good_is = "N/A", "This metric has breached the control limits over the past two years. This means there has been an unexpected value which has occured.",
			
			[SPC breached card (monthly)] = "Positive breach" && good_is = "Low", "This metric has breached the lower control limits over the past two years. This means there has been an unexpectedly low value. As the lower the value the better the performance, this a positive sign.",
			[SPC breached card (monthly)] = "Negative breach"  && good_is = "High", "This metric has breached the upper control limits over the past two years. This means there has been an unexpectedly high value, which is a positive result. As the higher the value the better the performance, this a positive sign.",
			[SPC breached card (monthly)] = "Breach"  && good_is = "N/A", "This metric has breached the control limits over the past two years. This means there has been an unexpected value which has occured.",
			
			"Error")
			
			```
		displayFolder: SPC - Breached Measures
		lineageTag: ccc9c84f-b86f-4039-bd6f-34ab91b303e2

	measure SPC_8_points_above_mean =
			
			VAR MeanValue = [Value SPC Mean]
			
			-- Current index for the row / point being evaluated
			VAR CurrentIndex = MAX( 'Date Reference'[YearMonthIndex] )
			
			-- Available indexes in the current selection (ensures we only use months actually present)
			VAR AvailableIndexes =
			    DISTINCT(
			        SELECTCOLUMNS(
			            ALLSELECTED( 'Date Reference' ),
			            "YearMonthIndex", 'Date Reference'[YearMonthIndex]
			        )
			    )
			
			-- Helper: a small table containing the 8 expected indexes (CurrentIndex .. CurrentIndex-7)
			VAR WindowIndexes =
			    DISTINCT(
			        UNION(
			            ROW("YearMonthIndex", CurrentIndex),
			            ROW("YearMonthIndex", CurrentIndex - 1),
			            ROW("YearMonthIndex", CurrentIndex - 2),
			            ROW("YearMonthIndex", CurrentIndex - 3),
			            ROW("YearMonthIndex", CurrentIndex - 4),
			            ROW("YearMonthIndex", CurrentIndex - 5),
			            ROW("YearMonthIndex", CurrentIndex - 6),
			            ROW("YearMonthIndex", CurrentIndex - 7)
			        )
			    )
			
			-- Join WindowIndexes to your actual Total Value (returns only values for indexes that exist)
			VAR WindowWithValues =
			    ADDCOLUMNS(
			        WindowIndexes,
			        "TotalValue",
			            CALCULATE(
			                [Total Value],
			                FILTER(
			                    ALLSELECTED( 'Date Reference' ),
			                    'Date Reference'[YearMonthIndex] = EARLIER( [YearMonthIndex] )
			                )
			            )
			    )
			
			-- Count how many of those 8 indexes actually had a TotalValue (non-blank)
			VAR CountExists =
			    COUNTROWS( FILTER( WindowWithValues, NOT( ISBLANK( [TotalValue] ) ) ) )
			
			-- Count how many of those existing ones are strictly below the mean
			VAR CountBelow =
			    COUNTROWS( FILTER( WindowWithValues, NOT( ISBLANK( [TotalValue] ) ) && [TotalValue] > MeanValue ) )
			
			-- This is TRUE only when all 8 expected indexes exist AND all 8 are < Mean
			VAR IsEndOf8BelowRun =
			    IF (
			        CountExists = 8 &&
			        CountBelow = CountExists &&
			        CountBelow >= 8,
			        1,
			        0
			    )
			
			/* -------------------------
			   Collect every run-end index (those indexes which are the last point of an 8-point below-mean run)
			   then enumerate the full 8-member runs from those ends (to flag all points in the run).
			   This avoids back-propagation / false overlaps because we only derive members from confirmed run-ends.
			   ------------------------- */
			
			VAR AllSummaryIndexes =
			    DISTINCT(
			        SELECTCOLUMNS(
			            ALLSELECTED( 'Date Reference' ),
			            "YearMonthIndex", 'Date Reference'[YearMonthIndex]
			        )
			    )
			
			-- Table of run ends across the selection (we must evaluate per index, so we create a table)
			VAR RunEnds =
			    FILTER(
			        ADDCOLUMNS(
			            AllSummaryIndexes,
			            "IsEnd",
			                VAR ThisIdx = [YearMonthIndex]
			                VAR Wnd =
			                    DISTINCT(
			                        UNION(
			                            ROW("YearMonthIndex", ThisIdx),
			                            ROW("YearMonthIndex", ThisIdx - 1),
			                            ROW("YearMonthIndex", ThisIdx - 2),
			                            ROW("YearMonthIndex", ThisIdx - 3),
			                            ROW("YearMonthIndex", ThisIdx - 4),
			                            ROW("YearMonthIndex", ThisIdx - 5),
			                            ROW("YearMonthIndex", ThisIdx - 6),
			                            ROW("YearMonthIndex", ThisIdx - 7)
			                        )
			                    )
			                VAR WndWithVals =
			                    ADDCOLUMNS(
			                        Wnd,
			                        "TotalValue",
			                            CALCULATE(
			                                [Total Value],
			                                FILTER( ALLSELECTED( 'Date Reference' ), 'Date Reference'[YearMonthIndex] = EARLIER( [YearMonthIndex] ) )
			                            )
			                    )
			                VAR ExistsCnt = COUNTROWS( FILTER( WndWithVals, NOT( ISBLANK( [TotalValue] ) ) ) )
			                VAR BelowCnt = COUNTROWS( FILTER( WndWithVals, NOT( ISBLANK( [TotalValue] ) ) && [TotalValue] > MeanValue ) )
			                RETURN     IF (
			        CountExists = 8 &&
			        CountBelow = CountExists &&
			        CountBelow >= 8,
			        1,
			        0
			    )
			        ),
			        [IsEnd] = 1
			    )
			
			-- From confirmed run ends, enumerate all 8 member indexes for each run end
			VAR RunMembers =
			    DISTINCT(
			        UNION(
			            SELECTCOLUMNS( RunEnds, "YearMonthIndex", [YearMonthIndex] ),
			            SELECTCOLUMNS( RunEnds, "YearMonthIndex", [YearMonthIndex] - 1 ),
			            SELECTCOLUMNS( RunEnds, "YearMonthIndex", [YearMonthIndex] - 2 ),
			            SELECTCOLUMNS( RunEnds, "YearMonthIndex", [YearMonthIndex] - 3 ),
			            SELECTCOLUMNS( RunEnds, "YearMonthIndex", [YearMonthIndex] - 4 ),
			            SELECTCOLUMNS( RunEnds, "YearMonthIndex", [YearMonthIndex] - 5 ),
			            SELECTCOLUMNS( RunEnds, "YearMonthIndex", [YearMonthIndex] - 6 ),
			            SELECTCOLUMNS( RunEnds, "YearMonthIndex", [YearMonthIndex] - 7 )
			        )
			    )
			
			-- Final: is the current row in the set of confirmed run member indexes?
			VAR IsMember = IF( CurrentIndex IN RunMembers, 1, 0 )
			
			RETURN
			IsMember
		displayFolder: SPC - Lines
