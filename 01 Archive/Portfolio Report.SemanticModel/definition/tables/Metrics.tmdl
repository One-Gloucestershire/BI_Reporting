	measure 'Laney P Prime LCL Daily' =
			
			
			VAR n_total = 'Metrics'[Total Denominator]
			
			VAR k = COUNT('Metrics'[Reporting_Date])
			
			VAR N_value = n_total / k
			
			VAR np = CALCULATE([Total Numerator],ALL('Date Reference'))
			
			VAR n = CALCULATE([Total Denominator],ALL('Date Reference'))
			
			VAR p_values = CALCULATE(np / n,ALL('Date Reference'))
			
			VAR p = [Total Value]
			
			VAR lcl = IFERROR(p_values - 3*[P Prime Standard Deviation Z Value Daily] *
			    ((SQRT(((p_values*(1-p_values)) /n_total)))),BLANK())
			
			VAR final = IF(lcl <= 0, 0.001, lcl)
			
			RETURN final
		displayFolder: SPC - P Prime
		lineageTag: b2952a95-2074-4367-8a9c-460346c7393a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Laney P Prime UCL Daily' = ```
			
			
			var percentage_as_rate_per_1000 = SELECTEDVALUE('Metrics'[Percentage Metric as Rate per 1000])
			
			VAR n_total = 'Metrics'[Total Denominator]
			
			VAR k = COUNT('Metrics'[Reporting_Date])
			
			VAR N_value = n_total / k
			
			VAR np = CALCULATE([Total Numerator],ALL('Date Reference'))
			
			VAR n = CALCULATE([Total Denominator],ALL('Date Reference'))
			
			VAR p_values = CALCULATE(np / n,ALL('Date Reference'))
			
			VAR p = [Total Value]
			
			VAR ucl = IFERROR(p_values + 3*[P Prime Standard Deviation Z Value Daily] *
			    ((SQRT(((p_values*(1-p_values)) /n_total)))),BLANK())
			
			RETURN 
			SWITCH(TRUE(),
			percentage_as_rate_per_1000 = TRUE() && ucl > 1000, 1000    --this uses the same SPC logic as the P chart but as it is calculated as a rate per 1000 it ensures it can never   be over 1000 as that is 100%
			,percentage_as_rate_per_1000 = FALSE() && ucl > 1,0.999         --this ensures any percentage metric doesn't go over 100%
			,ucl)
			
			```
		displayFolder: SPC - P Prime
		lineageTag: d44d66fd-7d54-442d-90c1-b7f2cdb4d217

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Prior Laney U Prime Z Value Daily' = ```
			
			
			
			VAR CurrMetric = SELECTEDVALUE('Metrics'[Metric_ID])
			VAR CurrYM = MAX('Date Reference'[Date_112])   -- use Date Reference, not Metrics
			
			-- Find the previous month that exists in Date Reference
			VAR PrevYM =
			    MAXX(
			        FILTER(
			            ALL('Date Reference'),
			            'Date Reference'[Date_112] < CurrYM
			        ),
			        'Date Reference'[Date_112]
			    )
			
			RETURN
			IF(
			    ISBLANK(PrevYM),
			    BLANK(),
			    CALCULATE(
			        [Laney U Prime Z Value],
			        KEEPFILTERS(VALUES('Metrics'[Metric_ID])),
			        REMOVEFILTERS('Date Reference'[Date_112]),
			        TREATAS({PrevYM}, 'Date Reference'[Date_112])
			    )
			)
			
			```
		displayFolder: SPC - U Prime
		lineageTag: 97edf0bf-09f0-44a9-9b88-6347abe6bd00

		annotation PBI_FormatHint = {"isGeneralNumber":true}

