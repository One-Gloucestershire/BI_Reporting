	measure 'P Prime Z Value' = ```
			
			
			var percentage_check = MAX('metrics'[Is a Percentage Metric])
			
			VAR n_total = IF(
			    percentage_check = 0, BLANK(), [Total Denominator])
			
			VAR k = IF(
			    percentage_check = 0, BLANK(), COUNT([Reporting_Date]))  
			
			VAR N_value = n_total / k
			
			VAR np = IF(
			    percentage_check = 0, BLANK(), CALCULATE([Total Numerator],ALL('Date Reference')))
			
			VAR n = IF(
			    percentage_check = 0, BLANK(), CALCULATE([Total Denominator],ALL('Date Reference')))  
			
			VAR p_values = CALCULATE(np / n,ALL('Date Reference'))
			
			VAR p = IF(
			    percentage_check = 0, BLANK(), [Total Value])
			
			Var z_value =  (p - p_values) / 
			SQRT((((1 - p_values) * p_values) / n_value)) 
			
			RETURN z_value
			
			```
		displayFolder: SPC - Old
		lineageTag: fa3020fb-620c-44da-b660-080bbd4e5e15

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Moving Range' =
			
			VAR FilteredTable_ =
			    FILTER(
			        ALL('Date Reference'),
			        'Date Reference'[YearMonthIndex] >= 1 && 'Date Reference'[SPC_Flag] = 1
			    )
			
			VAR SummaryTable =
			    SUMMARIZE(
			        FilteredTable_,
			        'Date Reference'[Fin_Year],
			        'Date Reference'[month_name],
			        'Date Reference'[YearMonthIndex],
			        'Date Reference'[SPC_Flag],
			        "Total Value", [Total Value]
			    )
			
			VAR SummaryTableWithDifference =
			    ADDCOLUMNS(
			        SummaryTable,
			        "Difference",
			        VAR CurrentYearMonthIndex = [YearMonthIndex]
			        VAR NextValue =
			            CALCULATE(
			                MINX(
			                    FILTER(
			                        SummaryTable,
			                        [YearMonthIndex] = CurrentYearMonthIndex + 1
			                    ),
			                   [Total Value]
			                )
			            )
			        RETURN IF(ISBLANK(NextValue), BLANK(),  abs([Total Value] - NextValue))
			    )
			
			VAR Differences =
			    SELECTCOLUMNS(SummaryTableWithDifference, "Diff", [Difference])
			
			 RETURN   AVERAGEX(
			        FILTER(SummaryTableWithDifference, NOT ISBLANK([Difference])),
			        [Difference]
			    )
		displayFolder: SPC - Old
		lineageTag: 2019880a-5549-4180-bd2b-420d20ce81ec

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Laney P Prime Z Value' = ```
			
			
			VAR denominator = 'Metrics'[Total Denominator]
			
			VAR total_numerator  = CALCULATE([Total Numerator],ALL('Date Reference'))
			
			VAR total_denominator = CALCULATE([Total Denominator],ALL('Date Reference'))
			
			VAR total_value = CALCULATE(Total_numerator / Total_denominator)
			
			VAR value_ = [Total Value]
			
			Var z_value =  IFERROR( (value_ - total_value) / 
			SQRT((((1 - total_value) * total_value) / denominator)) ,BLANK())
			
			RETURN z_value
			
			```
		displayFolder: SPC - P Prime
		lineageTag: c6e5843b-c267-46de-9cdd-975ca0d6ff2d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

