			        VAR CurrentYearMonthIndex = 'Date Reference'[Date_112]
			        VAR PreviousValue =
			            CALCULATE(
			                MAXX(
			                    FILTER(
			                        SummaryTable,
			                        'Date Reference'[Date_112] = CurrentYearMonthIndex - 1
			                    ),
			                    [Total Value]
			                )
			            )
			        RETURN [Total Value] - PreviousValue
			    )
			
			VAR SummaryTableWithDecreasingFlag =
			    ADDCOLUMNS(
			        SummaryTableWithDifference,
			        "DecreasingFlag",
			        IF([Difference] < 0, 1, 0)
			    )
			
			VAR DecreasingSequence =
			    FILTER(
			        ADDCOLUMNS(
			            SummaryTableWithDecreasingFlag,
			            "DecreasingSequence",
			            VAR CurrentYearMonthIndex = 'Date Reference'[Date_112]
			            VAR DecreasingCount =
			                COUNTROWS(
			                    FILTER(
			                        SummaryTableWithDecreasingFlag,
			                        'Date Reference'[Date_112] >= CurrentYearMonthIndex - 4 &&
			                        'Date Reference'[Date_112] <= CurrentYearMonthIndex &&
			                        [DecreasingFlag] = 1
			                    )
			                )
			            RETURN IF(DecreasingCount =5 , 1, 0) -- Adjust the number of periods for your trend
			        ),
			        [DecreasingSequence] = 1
			    )
			
			VAR AdditionalFlags =
			    UNION(
			   
			   SELECTCOLUMNS(
			           ADDCOLUMNS(DecreasingSequence, "OffsetIndex", [Date_112] - 5),
			           "Date_112", [OffsetIndex]
			       ),
			       SELECTCOLUMNS(
			            ADDCOLUMNS(DecreasingSequence, "OffsetIndex", [Date_112] - 4),
			           "Date_112", [OffsetIndex]
			       ),
			       SELECTCOLUMNS(
			           ADDCOLUMNS(DecreasingSequence, "OffsetIndex", [Date_112] - 3),
			           "Date_112", [OffsetIndex]
			       ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(DecreasingSequence, "OffsetIndex", [Date_112] - 2),
			            "Date_112", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(DecreasingSequence, "OffsetIndex", [Date_112] - 1),
			            "Date_112", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(DecreasingSequence, "OffsetIndex", [Date_112]),
			            "Date_112", [OffsetIndex]
			        )
			    )
			
			
			RETURN
			IF(
			    MIN('Date Reference'[Date_112]) IN AdditionalFlags,
			    [Total Value],
			    BLANK()
			)
			```
		lineageTag: 856232a7-44f7-419f-bbf2-53d6c0d9ea07

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure SPC_increasing_trend_daily = ```
			
			VAR FilteredTable_ =
			   filter(ALLSELECTED('Date Reference'),'Date Reference'[Date_112] >= 1)
			
			VAR SummaryTable =
			    SUMMARIZE(
			        FilteredTable_,
			        'Date Reference'[Full_Date],
			        'Date Reference'[Date_112],
			        'Date Reference'[SPC_Flag],
			        "Total Value", [Total Value]
			    )
			
			VAR SummaryTableWithDifference =
			    ADDCOLUMNS(
			        SummaryTable,
			        "Difference",
			        VAR CurrentYearMonthIndex = 'Date Reference'[Date_112]
			        VAR NextValue =
			            CALCULATE(
			                MAXX(
			                    FILTER(
			                        SummaryTable,
			                        'Date Reference'[Date_112] = CurrentYearMonthIndex + 1
			                    ),
			                    [Total Value]
			                )
			            )
			        RETURN NextValue - [Total Value]
			    )
			
			VAR SummaryTableWithIncreasingFlag =
			    ADDCOLUMNS(
			        SummaryTableWithDifference,
			        "IncreasingFlag",
			        IF([Difference] > 0, 1, 0)
			    )
			
			VAR IncreasingSequence =
			    FILTER(
			        ADDCOLUMNS(
			            SummaryTableWithIncreasingFlag,
			            "IncreasingSequence",
			            VAR CurrentYearMonthIndex = 'Date Reference'[Date_112]
			            VAR IncreasingCount =
			                COUNTROWS(
			                    FILTER(
			                        SummaryTableWithIncreasingFlag,
			                        'Date Reference'[Date_112] >= CurrentYearMonthIndex &&
			                        'Date Reference'[Date_112] <= CurrentYearMonthIndex + 4 &&
			                        [IncreasingFlag] = 1
			                    )
			                )
			            RETURN 
			            
			            IF(IncreasingCount =5, 1, 0) -- Adjust the number of periods for your trend
			        ),
			        [IncreasingSequence] = 1
			    )
			
			
			VAR AdditionalFlags =
			   UNION(
			        
			
			   
			              SELECTCOLUMNS(
			            ADDCOLUMNS(IncreasingSequence, "OffsetIndex", [Date_112] + 5),
			            "Date_112", [OffsetIndex]
			        ),
			   
			
			              SELECTCOLUMNS(
			            ADDCOLUMNS(IncreasingSequence, "OffsetIndex", [Date_112] + 4),
			            "Date_112", [OffsetIndex]
			        ),
			   
			        SELECTCOLUMNS(
			            ADDCOLUMNS(IncreasingSequence, "OffsetIndex", [Date_112] + 3),
			            "Date_112", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(IncreasingSequence, "OffsetIndex", [Date_112] + 2),
			            "Date_112", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(IncreasingSequence, "OffsetIndex", [Date_112] + 1),
			            "Date_112", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(IncreasingSequence, "OffsetIndex", [Date_112]),
			            "Date_112", [OffsetIndex]
			        )
			    )
			
			
			
			    
			RETURN
			IF(
			    MIN('Date Reference'[Date_112]) IN AdditionalFlags,
			    [Total Value],
			    BLANK()
			)
			```
		lineageTag: bcdceb78-1a07-45d2-817f-abce647c3e91

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure SPC_two_out_of_three_in_outer_and_or_lower_third_daily = ```
			
			
			VAR current_value = [Total Value]
			
			VAR one_month_prior = CALCULATE([Total Value], DATEADD('Date Reference'[Full_Date], -1, DAY))
			VAR two_month_prior = CALCULATE([Total Value], DATEADD('Date Reference'[Full_Date], -2, DAY))
			
			VAR one_month_after = CALCULATE([Total Value], DATEADD('Date Reference'[Full_Date], +1, DAY))
			VAR two_month_after = CALCULATE([Total Value], DATEADD('Date Reference'[Full_Date], +2, DAY))
			
			VAR lower_outer_third = [LowerOuterThird]
			VAR upper_outer_third = [UpperOuterThird]
			
			
			VAR current_value_in_outer_third = IF(current_value = BLANK(),0, IF(current_value < lower_outer_third || current_value > upper_outer_third, 1, 0))
			
			VAR one_month_prior_in_outer_third = IF(one_month_prior = BLANK(),0, IF(one_month_prior < lower_outer_third || one_month_prior > upper_outer_third, 1, 0))
			VAR two_month_prior_in_outer_third = IF(two_month_prior = BLANK(),0, IF(two_month_prior < lower_outer_third || two_month_prior > upper_outer_third, 1, 0))
			
			VAR one_month_after_in_outer_third = IF(one_month_after = BLANK(),0, IF(one_month_after < lower_outer_third || one_month_after > upper_outer_third, 1, 0))
			VAR two_month_after_in_outer_third = IF(two_month_after = BLANK(),0, IF(two_month_after < lower_outer_third || two_month_after > upper_outer_third, 1, 0))
			
			VAR two_month_prior_to_current_flag = two_month_prior_in_outer_third + one_month_prior_in_outer_third + current_value_in_outer_third
			VAR one_month_prior_to_one_month_after_flag = one_month_prior_in_outer_third + current_value_in_outer_third + one_month_after_in_outer_third
			VAR current_to_two_month_after_flag = current_value_in_outer_third + one_month_after_in_outer_third + two_month_after_in_outer_third
			
			
			VAR final = 
			SWITCH(TRUE(),
			current_value = BLANK(), BLANK(), 
			two_month_prior_to_current_flag >= 2, [Total Value], 
			one_month_prior_to_one_month_after_flag >= 2, [Total Value], 
			current_to_two_month_after_flag >= 2, [Total Value], 
			BLANK())
			
			RETURN final
			```
		lineageTag: a5dead53-8e23-4c37-9427-ae6dd8876102

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SPC special variation concern daily' = ```
			
			
			VAR good_is = max([Good_Is])
			
			VAR final =
			SWITCH(TRUE(),
			
			[SPC_value_outside_of_LCL] <> BLANK() && good_is = "High", [Total Value],
			[SPC_value_outside_of_LCL] <> BLANK() && good_is = "Low", BLANK(),
			
			[SPC_outside_of_UCL] <> BLANK() && good_is = "Low", [Total Value],
			[SPC_outside_of_UCL] <> BLANK() && good_is = "High", BLANK(),
			
			[SPC_two_out_of_three_in_outer_and_or_lower_third_daily] <> BLANK() 
			&& [SPC_two_out_of_three_in_outer_and_or_lower_third_daily] >= [UpperOuterThird] && good_is = "Low", [Total Value],
			[SPC_two_out_of_three_in_outer_and_or_lower_third_daily] <> BLANK() 
			&& [SPC_two_out_of_three_in_outer_and_or_lower_third_daily] <= [LowerOuterThird] && good_is = "High", [Total Value],
			
			[SPC_two_out_of_three_in_outer_and_or_lower_third_daily] <> BLANK() 
			&& [SPC_two_out_of_three_in_outer_and_or_lower_third_daily] >= [UpperOuterThird] && good_is = "High", BLANK(),
			[SPC_two_out_of_three_in_outer_and_or_lower_third_daily] <> BLANK() 
			&& [SPC_two_out_of_three_in_outer_and_or_lower_third_daily] <= [LowerOuterThird] && good_is = "Low", BLANK(),
			
			[SPC_8_points_above_mean_daily] <> BLANK() && good_is = "Low", [Total Value],
			[SPC_8_points_above_mean_daily] <> BLANK() && good_is = "High", BLANK(),
			
			[SPC_8_points_below_mean_daily] <> BLANK() && good_is = "High", [Total Value],
			[SPC_8_points_below_mean_daily] <> BLANK() && good_is = "Low", BLANK(),
			
			[SPC_decreasing_trend_daily] <> BLANK() && good_is = "High", [Total Value],
			[SPC_decreasing_trend_daily] <> BLANK() && good_is = "Low", BLANK(),
			
			[SPC_increasing_trend_daily] <> BLANK() && good_is = "Low", [Total Value],
			[SPC_increasing_trend_daily] <> BLANK() && good_is = "High", BLANK(),
			
			[SPC_15_points_near_the_mean_daily] <> BLANK(), [Total Value],
			
			BLANK())
			
			RETURN final
			```
