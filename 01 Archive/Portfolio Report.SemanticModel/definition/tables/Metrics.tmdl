	column 'Target Card' = ```
			
			
			VAR 
			Target_string = 
			CONVERT('Metrics'[Target],STRING) //this is required as you can't have a number and a text value both as an outcome, so the interger needs to be converted to text
			
			VAR percentage_metric = CONTAINSSTRING('Metrics'[Metric_Description],"percentage") //checks if the metric contains the term percentage
			
			RETURN 
			SWITCH(TRUE(),
			Target_string = "NA", "N/A",
			Target_string = "N/A", "N/A",
			Target_string = BLANK(), "N/A",
			ISBLANK('Metrics'[Target]) = FALSE() && percentage_metric = TRUE(), CONCATENATE(CONVERT((('Metrics'[Target]) *100),STRING), "%"), //if the target is not blank and relates to a percentage, then this converts the target into a percentage then into text
			Target_string)
			```
