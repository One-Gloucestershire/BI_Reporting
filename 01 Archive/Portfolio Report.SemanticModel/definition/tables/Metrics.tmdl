	measure 'Value SPC Mean' = ```
			
			
			VAR monthly_or_daily = SELECTEDVALUE('Metrics'[Monthly or Daily Data]) 
			
			VAR mean_ = 
			
			SWITCH(TRUE(),
			monthly_or_daily = "Monthly",
			IF([In Reporting Timeframe] = FALSE(), BLANK(),
			        CALCULATE(AVERAGE('Metrics'[Value]),ALL('Date Reference'))),
			monthly_or_daily = "Daily",
			IF([In Reporting Timeframe] = FALSE(), BLANK(),
			        CALCULATE(AVERAGE('Metrics'[Value]),'Metrics'[Last 28 Days Flag] = TRUE(),ALL('Date Reference')
			     
			        //,'Date Reference'[Fin_Year_yy_yy] = "23/24" || 'Date Reference'[Fin_Year_yy_yy] = "24/25",ALLSELECTED('Date Reference')) //should try and calculate this dynamically for a stable period
			        ))
			,BLANK())
			
			RETURN  mean_
			```
		displayFolder: SPC - General Measures
		lineageTag: f8d641ac-b08e-4411-b736-a1f81b3170db

