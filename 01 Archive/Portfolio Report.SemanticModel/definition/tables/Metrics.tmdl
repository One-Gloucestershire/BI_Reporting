	column 'Last 28 Days Flag' =
			
			
			var max_date = CALCULATE (
			    MAX('Metrics'[Reporting_Date] ),
			    FILTER (
			        'Metrics',
			        'Metrics'[Metric_ID] = EARLIER ( 'Metrics'[Metric_ID] )
			    )
			)
			
			var _28_days = max_date - 27
			
			RETURN IF([Monthly or Daily Data] = "Monthly", FALSE(),IF(Metrics[Reporting_Date] >= _28_days, TRUE(), FALSE()))
