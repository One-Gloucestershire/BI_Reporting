		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure SPC_15_points_near_the_mean =
			
			
			VAR FilteredTable_ =
			    CALCULATETABLE(
			        'Date Reference',
			       filter(ALLSELECTED('Date Reference'),'Date Reference'[YearMonthIndex] >= 1)
			    )
			
			VAR SummaryTable =
			    SUMMARIZE(
			        FilteredTable_,
			       'Date Reference'[Fin_Year],
			        'Date Reference'[month_name],
			        'Date Reference'[YearMonthIndex],
			        'Date Reference'[SPC_Flag],
			        "Total Value", [Total Value]
			    )
			
			VAR LatestYearMonthIndex = MAX('Date Reference'[YearMonthIndex])
			
			VAR MeanValue = [Value SPC Mean]
			
			VAR LowerInnerThird = [LowerInnerThird]
			
			VAR UpperInnerThird = [UpperInnerThird]
			
			VAR SummaryTableWithCount =
			    ADDCOLUMNS(
			        SummaryTable,
			        "NeartheMeanCount",
			        VAR CurrentYearMonthIndex = 'Date Reference'[YearMonthIndex]
			        VAR CurrentLast15Months =
			            FILTER(
			                SummaryTable,
			                'Date Reference'[YearMonthIndex] <= CurrentYearMonthIndex &&
			                'Date Reference'[YearMonthIndex] > CurrentYearMonthIndex - 15
			            )
			        VAR In_Inner_Upper_or_Lower_Third =
			    COUNTROWS(
			        FILTER(
			            CurrentLast15Months,
			            (
			                [Total Value] >= MeanValue &&
			                [Total Value] <= UpperInnerThird
			            )
			            &&
			            (
			                [Total Value] <= MeanValue &&
			                [Total Value] >= LowerInnerThird
			            )
			        ))
			        RETURN IF(In_Inner_Upper_or_Lower_Third >= 15, 1, 0)
			    )
			
			VAR FlaggedYearMonthIndexes =
			    SELECTCOLUMNS(
			        FILTER(
			            SummaryTableWithCount,
			            [NeartheMeanCount] = 1
			        ),
			        "YearMonthIndex", 'Date Reference'[YearMonthIndex]
			    )
			
			VAR AdditionalFlags =
			    UNION(
			
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [YearMonthIndex] - 14),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [YearMonthIndex] - 13),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [YearMonthIndex] - 11),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [YearMonthIndex] - 10),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			
			
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [YearMonthIndex] - 9),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [YearMonthIndex] - 8),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [YearMonthIndex] - 7),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [YearMonthIndex] - 6),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [YearMonthIndex] - 5),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [YearMonthIndex] - 4),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [YearMonthIndex] - 3),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [YearMonthIndex] - 2),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [YearMonthIndex] - 1),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(FlaggedYearMonthIndexes, "OffsetIndex", [YearMonthIndex]),
			            "YearMonthIndex", [OffsetIndex]
			        )
			    )
			
			VAR FinalTable =
			    ADDCOLUMNS(
			        SummaryTableWithCount,
			        "AdditionalFlag",
			        IF(
			            'Date Reference'[YearMonthIndex] IN AdditionalFlags, 1, 0
			        )
			    )
			
			
			VAR final = if(min('Date Reference'[YearMonthIndex]) in  AdditionalFlags,[Total Value],BLANK())
			
			RETURN  final
		displayFolder: SPC - Lines
		lineageTag: 30173a1f-067e-4f3c-a973-4c3f9bdaa7e1

