	measure 'Laney U Prime UCL' = ```
			
			
			VAR rate_helper = CALCULATE(SUM([Rate Helper]))
			
			VAR denominator = [Total Denominator]
			
			VAR total_numerator = CALCULATE([Total Numerator],ALL('Date Reference'))
			
			VAR total_denominator = CALCULATE([Total Denominator],ALL('Date Reference'))
			
			VAR total_rate = CALCULATE(total_numerator / total_denominator*rate_helper)
			
			VAR final = IFERROR(
			total_rate + 3*[Lanley U Prime Standard Deviation] *
			    (SQRT((total_rate /denominator))),BLANK())
			
			RETURN 
			IF([Total Value] = BLANK(), BLANK(), final)
			
			```
		displayFolder: SPC - U Prime
		lineageTag: 00ba3db5-7322-4781-8616-a925c18503a0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Laney U Prime LCL' =
			
			
			VAR rate_ = CALCULATE(SUM([Rate Helper]))
			
			VAR n = [Total Denominator]
			
			VAR c = CALCULATE([Total Numerator],ALL('Date Reference'))
			
			VAR n_total = CALCULATE([Total Denominator],ALL('Date Reference'))
			
			VAR u_value = CALCULATE(c / n_total*rate_)
			
			VAR u =  [Total Value]
			
			VAR final = IFERROR(
			u_value - 3*[Lanley U Prime Standard Deviation] *
			    (SQRT((u_value /n))),BLANK())
			
			RETURN IF(final<=0, 0.001, final)
		displayFolder: SPC - U Prime
		lineageTag: bce786cc-5fab-4cdb-b1f2-a465a26e65aa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

