	column 'Histogram Bin' = ```
			
			
			VAR max_value = CALCULATE (
			    MAX('Metrics'[Value]),
			    FILTER (
			        'Metrics',
			        'Metrics'[Metric_ID] = EARLIER ( 'Metrics'[Metric_ID] )
			    )
			)
			
			VAR min_value = CALCULATE (
			    MIN('Metrics'[Value]),
			    FILTER (
			        'Metrics',
			        'Metrics'[Metric_ID] = EARLIER ( 'Metrics'[Metric_ID] )
			    )
			)
			
			VAR bin_range = max_value - min_value
			
			VAR bin_width = bin_range / 6
			
			RETURN min_value + (bin_width*5)
			
			```
		lineageTag: b6089437-1664-4526-a06a-1126230483de
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Bin Width' = ```
			
			
			VAR max_value = CALCULATE (
			    MAX('Metrics'[Value]),
			    FILTER (
			        'Metrics',
			        'Metrics'[Metric_ID] = EARLIER ( 'Metrics'[Metric_ID] )
			    )
			)
			
			VAR min_value = CALCULATE (
			    MIN('Metrics'[Value]),
			    FILTER (
			        'Metrics',
			        'Metrics'[Metric_ID] = EARLIER ( 'Metrics'[Metric_ID] )
			    )
			)
			
			VAR bin_range = max_value - min_value
			
			VAR bin_width = bin_range / 6
			
			return 
			 SWITCH(TRUE(),
			
			 'Metrics'[Value] <= min_value + bin_width, min_value,
			 'Metrics'[Value] <= min_value + (bin_width*2) &&  'Metrics'[Value] > min_value + bin_width, min_value + bin_width,
			 'Metrics'[Value] <= min_value + (bin_width*3) &&  'Metrics'[Value] > min_value + (bin_width*2), min_value + (bin_width*2),
			 'Metrics'[Value] <= min_value + (bin_width*4) &&  'Metrics'[Value] > min_value + (bin_width*3), min_value + (bin_width*3),
			 'Metrics'[Value] <= min_value + (bin_width*5) &&  'Metrics'[Value] > min_value + (bin_width*4), min_value + (bin_width*4),
			 'Metrics'[Value] <= min_value + (bin_width*6)  &&  'Metrics'[Value] > min_value + (bin_width*5), min_value + (bin_width*5),
			
			BLANK())
			```
		lineageTag: bd23d409-7344-4998-9330-3e14b43d23b4
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

