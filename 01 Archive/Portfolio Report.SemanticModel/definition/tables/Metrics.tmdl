	measure SPC_decreasing_trend = ```
			
			VAR FilteredTable_ =
			    filter(ALLSELECTED('Date Reference'),'Date Reference'[YearMonthIndex] >= 1)
			
			VAR SummaryTable =
			    SUMMARIZE(
			        FilteredTable_,
			        'Date Reference'[Fin_Year],
			        'Date Reference'[month_name],
			        'Date Reference'[YearMonthIndex],
			        'Date Reference'[SPC_Flag],
			        "Total Value", [Total Value]
			    )
			
			
			VAR SummaryTableWithDifference =
			    ADDCOLUMNS(
			        SummaryTable,
			        "Difference",
			        VAR CurrentYearMonthIndex = 'Date Reference'[YearMonthIndex]
			        VAR PreviousValue =
			            CALCULATE(
			                MAXX(
			                    FILTER(
			                        SummaryTable,
			                        'Date Reference'[YearMonthIndex] = CurrentYearMonthIndex - 1
			                    ),
			                    [Total Value]
			                )
			            )
			        RETURN [Total Value] - PreviousValue
			    )
			
			VAR SummaryTableWithDecreasingFlag =
			    ADDCOLUMNS(
			        SummaryTableWithDifference,
			        "DecreasingFlag",
			        IF([Difference] < 0, 1, 0)
			    )
			
			VAR DecreasingSequence =
			    FILTER(
			        ADDCOLUMNS(
			            SummaryTableWithDecreasingFlag,
			            "DecreasingSequence",
			            VAR CurrentYearMonthIndex = 'Date Reference'[YearMonthIndex]
			            VAR DecreasingCount =
			                COUNTROWS(
			                    FILTER(
			                        SummaryTableWithDecreasingFlag,
			                        'Date Reference'[YearMonthIndex] >= CurrentYearMonthIndex - 4 &&
			                        'Date Reference'[YearMonthIndex] <= CurrentYearMonthIndex &&
			                        [DecreasingFlag] = 1
			                    )
			                )
			            RETURN IF(DecreasingCount =5 , 1, 0) -- Adjust the number of periods for your trend
			        ),
			        [DecreasingSequence] = 1
			    )
			
			VAR AdditionalFlags =
			    UNION(
			   
			   SELECTCOLUMNS(
			           ADDCOLUMNS(DecreasingSequence, "OffsetIndex", [YearMonthIndex] - 5),
			           "YearMonthIndex", [OffsetIndex]
			       ),
			       SELECTCOLUMNS(
			            ADDCOLUMNS(DecreasingSequence, "OffsetIndex", [YearMonthIndex] - 4),
			           "YearMonthIndex", [OffsetIndex]
			       ),
			       SELECTCOLUMNS(
			           ADDCOLUMNS(DecreasingSequence, "OffsetIndex", [YearMonthIndex] - 3),
			           "YearMonthIndex", [OffsetIndex]
			       ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(DecreasingSequence, "OffsetIndex", [YearMonthIndex] - 2),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(DecreasingSequence, "OffsetIndex", [YearMonthIndex] - 1),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(DecreasingSequence, "OffsetIndex", [YearMonthIndex]),
			            "YearMonthIndex", [OffsetIndex]
			        )
			    )
			
			
			RETURN
			IF(
			    MIN('Date Reference'[YearMonthIndex]) IN AdditionalFlags,
			    [Total Value],
			    BLANK()
			)
			```
		displayFolder: SPC - Lines
		lineageTag: 0a9eda65-1d8e-4cc8-99e6-b4eef4e2eedd

