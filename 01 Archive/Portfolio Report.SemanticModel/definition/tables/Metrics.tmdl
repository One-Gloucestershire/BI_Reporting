	measure SPC_Two_out_of_three_points_near_to_the_UCL = ```
			
			
			
			VAR FilteredTable_ =
			    filter(ALLSELECTED('Date Reference'),'Date Reference'[YearMonthIndex]>=1)
			
			VAR SummaryTable =
			    SUMMARIZE(
			        FilteredTable_,
			        'Date Reference'[Fin_Year],
			        'Date Reference'[month_name],
			        'Date Reference'[YearMonthIndex],
			        'Date Reference'[SPC_Flag],
			        "Total Value", [Total Value]
			    )
			
			VAR MeanValue = [Value SPC Mean]
			VAR ucl = [UCL SPC]
			VAR lcl = [LCL SPC]
			VAR sigma = (ucl - lcl) / 6
			
			VAR UpperOuterThird = MeanValue + 2 * sigma
			
			VAR SummaryTableWithFlags =
			    ADDCOLUMNS(
			        SummaryTable,
			        "IsAboveUpperOuterThird",
			        IF([Total Value] > UpperOuterThird, 1, 0),
			        "IsAboveMean",
			        IF([Total Value] > MeanValue, 1, 0)
			    )
			
			VAR PatternTable =
			    ADDCOLUMNS(
			        SummaryTableWithFlags,
			        "PatternFlag",
			        VAR CurrentIndex = 'Date Reference'[YearMonthIndex]
			        
			        // Check the range of two months behind the current month index
			        VAR CheckPrevRange =
			            CALCULATE(
			                SUMX(
			                    FILTER(
			                        SummaryTableWithFlags,
			                        'Date Reference'[YearMonthIndex] >= CurrentIndex - 2 &&
			                        'Date Reference'[YearMonthIndex] <= CurrentIndex
			                    ),
			                    [IsAboveUpperOuterThird]
			                )
			            )
			        
			        // Check the range of one month either side of the current month index
			        VAR CheckMidRange =
			            CALCULATE(
			                SUMX(
			                    FILTER(
			                        SummaryTableWithFlags,
			                        'Date Reference'[YearMonthIndex] >= CurrentIndex - 1 &&
			                        'Date Reference'[YearMonthIndex] <= CurrentIndex + 1
			                    ),
			                    [IsAboveUpperOuterThird]
			                )
			            )
			        
			        // Check the range of two months in front of the current month index
			        VAR CheckNextRange =
			            CALCULATE(
			                SUMX(
			                    FILTER(
			                        SummaryTableWithFlags,
			                        'Date Reference'[YearMonthIndex] >= CurrentIndex &&
			                        'Date Reference'[YearMonthIndex] <= CurrentIndex + 2
			                    ),
			                    [IsAboveUpperOuterThird]
			                )
			            )
			        
			        // Ensure all points in the previous range are above the mean
			        VAR CheckAllAboveMeanPrevRange =
			            CALCULATE(
			                SUMX(
			                    FILTER(
			                        SummaryTableWithFlags,
			                        'Date Reference'[YearMonthIndex] >= CurrentIndex - 2 &&
			                        'Date Reference'[YearMonthIndex] <= CurrentIndex
			                    ),
			                    [IsAboveMean]
			                )
			            )
			        
			        // Ensure all points in the middle range are above the mean
			        VAR CheckAllAboveMeanMidRange =
			            CALCULATE(
			                SUMX(
			                    FILTER(
			                        SummaryTableWithFlags,
			                        'Date Reference'[YearMonthIndex] >= CurrentIndex - 1 &&
			                        'Date Reference'[YearMonthIndex] <= CurrentIndex + 1
			                    ),
			                    [IsAboveMean]
			                )
			            )
			        
			        // Ensure all points in the next range are above the mean
			        VAR CheckAllAboveMeanNextRange =
			            CALCULATE(
			                SUMX(
			                    FILTER(
			                        SummaryTableWithFlags,
			                        'Date Reference'[YearMonthIndex] >= CurrentIndex &&
			                        'Date Reference'[YearMonthIndex] <= CurrentIndex + 2
			                    ),
			                    [IsAboveMean]
			                )
			            )
			        
			        RETURN
			            IF(
			                AND(
			                    [IsAboveUpperOuterThird] = 1,
			                    OR(
			                        AND(CheckPrevRange >= 2, CheckAllAboveMeanPrevRange = 3),
			                        OR(
			                            AND(CheckMidRange >= 2, CheckAllAboveMeanMidRange = 3),
			                            AND(CheckNextRange >= 2, CheckAllAboveMeanNextRange = 3)
			                        )
			                    )
			                ),
			                1,
			                0
			            )
			    )
			
			VAR AdditionalFlags =
			    SELECTCOLUMNS(
			        FILTER(
			            PatternTable,
			            [PatternFlag] = 1 
			        ),
			        "YearMonthIndex", 'Date Reference'[YearMonthIndex]
			    )
			
			RETURN
			IF(
			    MIN('Date Reference'[YearMonthIndex]) IN AdditionalFlags ,
			    [Total Value],
			    BLANK()
			)
			```
		displayFolder: SPC - Old
		lineageTag: 82e2f5b9-88e6-4616-90db-2452ea717f4b

