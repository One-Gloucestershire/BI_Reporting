	measure 'SPC special variation tooltip daily' = ```
			
			
			VAR good_is = max([Good_Is])
			
			VAR final =
			SWITCH(TRUE(),
			
			[SPC_value_outside_of_LCL] <> BLANK() && good_is = "High", "Concern - Value outside of LCL",
			[SPC_value_outside_of_LCL] <> BLANK() && good_is = "Low", "Improvement - Value outside of LCL",
			
			[SPC_outside_of_UCL] <> BLANK() && good_is = "Low", "Concern - Value outside of UCL",
			[SPC_outside_of_UCL] <> BLANK() && good_is = "High", "Improvement - Value outside of UCL",
			
			[SPC_two_out_of_three_in_outer_and_or_lower_third_daily] <> BLANK() 
			&& [SPC_two_out_of_three_in_outer_and_or_lower_third_daily] >= [UpperOuterThird] && good_is = "Low", "Concern - Value near UCL",
			[SPC_two_out_of_three_in_outer_and_or_lower_third_daily] <> BLANK() 
			&& [SPC_two_out_of_three_in_outer_and_or_lower_third_daily] <= [LowerOuterThird] && good_is = "High", "Concern - Value near LCL",
			
			[SPC_two_out_of_three_in_outer_and_or_lower_third_daily] <> BLANK() 
			&& [SPC_two_out_of_three_in_outer_and_or_lower_third_daily] >= [UpperOuterThird] && good_is = "High", "Improvement - Value near UCL",
			[SPC_two_out_of_three_in_outer_and_or_lower_third_daily] <> BLANK() 
			&& [SPC_two_out_of_three_in_outer_and_or_lower_third_daily] <= [LowerOuterThird] && good_is = "Low", "Improvement - Value near LCL",
			
			[SPC_8_points_above_mean_daily] <> BLANK() && good_is = "Low", "Concern - 6 values above the mean",
			[SPC_8_points_above_mean_daily] <> BLANK() && good_is = "High", "Improvement - 6 values above the mean",
			
			[SPC_8_points_below_mean_daily] <> BLANK() && good_is = "High", "Concern - 6 values below the mean",
			[SPC_8_points_below_mean_daily] <> BLANK() && good_is = "Low", "Improvement - 6 values below the mean",
			
			[SPC_decreasing_trend_daily] <> BLANK() && good_is = "High", "Concern - decreasing trend",
			[SPC_decreasing_trend_daily] <> BLANK() && good_is = "Low", "Improvement - decreasing trend",
			
			[SPC_increasing_trend_daily] <> BLANK() && good_is = "Low", "Concern - increasing trend",
			[SPC_increasing_trend_daily] <> BLANK() && good_is = "High", "Improvement - increasing trend",
			
			[SPC_15_points_near_the_mean_daily] <> BLANK(), "Concern - large amount of points near the mean",
			
			BLANK())
			
			RETURN final
