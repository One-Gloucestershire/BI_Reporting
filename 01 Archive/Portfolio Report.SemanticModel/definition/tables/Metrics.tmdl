	measure Value_moving_range = ```
			
			VAR FilteredTable_ =
			    FILTER(
			        ALL('Date Reference'),
			        'Date Reference'[YearMonthIndex] >= 1 && 'Date Reference'[Test_SPC_flag] = 1
			    )
			
			VAR SummaryTable =
			    SUMMARIZE(
			        FilteredTable_,
			        'Date Reference'[Fin_Year],
			        'Date Reference'[month_name],
			        'Date Reference'[YearMonthIndex],
			        'Date Reference'[SPC_Flag],
			        "Total Value", [Total Value]
			    )
			
			VAR SummaryTableWithDifference =
			    ADDCOLUMNS(
			        SummaryTable,
			        "Difference",
			        VAR CurrentYearMonthIndex = [YearMonthIndex]
			        VAR NextValue =
			            CALCULATE(
			                MINX(
			                    FILTER(
			                        SummaryTable,
			                        [YearMonthIndex] = CurrentYearMonthIndex + 1
			                    ),
			                   [Total Value]
			                )
			            )
			        RETURN IF(ISBLANK(NextValue), BLANK(),  abs([Total Value] - NextValue))
			    )
			
			VAR Differences =
			    SELECTCOLUMNS(SummaryTableWithDifference, "Diff", [Difference])
			
			    VAR Cumulative_moving_range = (AVERAGEX(Differences, [Diff])) 
			
			RETURN Cumulative_moving_range
			```
		formatString: 0.000
		displayFolder: SPC - Old
