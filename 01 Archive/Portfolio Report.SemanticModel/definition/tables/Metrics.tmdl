	measure 'Current Value Card' = ```
			
			
			VAR max_date = MAX('Metrics'[Reporting_Date])
			
			var current_value = ROUND(CALCULATE(SUM(Metrics[Value]),'Metrics'[Reporting_Date] = max_date),1)
			
			
			VAR 
			Target_string = 
			CONVERT(current_value,STRING) //this is required as you can't have a number and a text value both as an outcome, so the interger needs to be converted to text
			
			VAR percentage_metric = MAX('Metrics'[Is a Percentage Metric])
			
			RETURN 
			SWITCH(TRUE(),
			percentage_metric = 1, CONCATENATE(CONVERT(((current_value) *100),STRING), "%"), //if the metric relates to a percentage, then this converts the target into a percentage then into text
			Target_string)
			```
		lineageTag: 638810c3-b1aa-4f1f-ab2e-2119769d34cf

	measure 'Baseline 24/25 Card' = ```
			
			
			VAR baseline = ROUND([Baseline 24/25],1)
			
			VAR 
			baseline_string = 
			CONVERT(baseline,STRING) //this is required as you can't have a number and a text value both as an outcome, so the interger needs to be converted to text
			
			VAR percentage_metric = MAX('Metrics'[Is a Percentage Metric])
			
			RETURN 
			SWITCH(TRUE(),
			percentage_metric = 1, CONCATENATE(CONVERT(((baseline) *100),STRING), "%"), //if the metric relates to a percentage, then this converts the baseline into a percentage then into text
			baseline_string)
			```
		lineageTag: 1752c91e-388b-4566-ade7-8ff755f12f4f

	measure 'Half Way Date' =
			
			
			var number_of_months = DATEDIFF(MIN('Metrics'[Reporting_Date]),MAX('Metrics'[Reporting_Date]),MONTH) / 2
			
			RETURN EOMONTH(MIN('Metrics'[Reporting_Date]), number_of_months)
