	column 'Value as String' = ```
			
			
			VAR 
			Target_string = 
			CONVERT('Metrics'[Value],STRING) //this is required as you can't have a number and a text value both as an outcome, so the interger needs to be converted to text
			
			VAR percentage_metric = 'Metrics'[Is a Percentage Metric]
			
			RETURN 
			SWITCH(TRUE(),
			percentage_metric = 1, CONCATENATE(CONVERT((('Metrics'[Value]) *100),STRING), "%"), //if the metric relates to a percentage, then this converts the target into a percentage then into text
			Target_string)
			```
		lineageTag: ee9f6475-1b4b-4915-81ba-955d92e0a4ba
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Good Is (Interger)' = IF('Metrics'[Good_Is] = "High", 2, IF(Metrics[Good_Is] = "Low", 1, 0))
		formatString: 0
		lineageTag: 128b2b1a-edbf-4b32-b092-7c1f3b04b7fc
