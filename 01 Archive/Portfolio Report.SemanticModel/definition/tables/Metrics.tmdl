	column 'SPC Chart Type' = ```
			
			SWITCH(TRUE(),
			[Metric_ID] = "25/26 Wao-M-06", "U Prime Chart", 
			[Percentage Metric as Rate per 1000] = TRUE(),"P Prime Chart",
			CONTAINSSTRING('Metrics'[Metric_Description],"percentage") = TRUE(),"P Prime Chart",
			CONTAINSSTRING('Metrics'[Metric_Description],"inequalities") = TRUE(),"I/XmR Chart", --P/U chart seems inappropriate for these as value is not a proportion of the denominator
			CONTAINSSTRING('Metrics'[Metric_Description],"rate") = TRUE(),"U Prime Chart", //likely need to add extra option as current U Prime Chart is rate per 1000, so might need new option for rates which are not rate per 1000
			CONTAINSSTRING('Metrics'[Metric_Description],"time") = TRUE(),"I/XmR Chart",
			CONTAINSSTRING('Metrics'[Metric_Description],"days") = TRUE(),"I/XmR Chart",
			CONTAINSSTRING('Metrics'[Metric_Description],"length of stay") = TRUE(),"I/XmR Chart",
			CONTAINSSTRING('Metrics'[Metric_Description],"spend") = TRUE(),"I/XmR Chart",
			
			"I/XmR Chart"
			)
			
			--decision not to use C charts at the moment as they don't seem appropriate
			--as per https://www.cec.health.nsw.gov.au/__data/assets/pdf_file/0011/605657/Understanding-Variation-with-Shewart-Charts.pdf, "the key to using a c-chart is that there should be an equal area of opportunity for a defect to occur. This condition frequently makes it difficult to use this chart in health care because the conditions under which we provide care do not always remain constant."  The XmR chart is used to answer "How many?" over a period of time which most metrics are reporting on i.e. a number of x per month
			```
