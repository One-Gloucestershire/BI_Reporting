	partition 'Reference Metrics Table' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "PowerBI_Reporting", [Query="select *#(lf)from Portfolio.tbl02_Metric_Reference_Table#(lf)where metric_ID not in#(lf)(#(lf)'Missing ID - Has the system been in the lowest qua'#(lf),'Missing ID - Percentage of eligible patients atten'#(lf),'Missing ID - Relative cost difference'#(lf),'Missing ID - Is the system in the lowest quartile '#(lf),'Missing ID - Percentage of inpatients referred to '#(lf))"])
				in
				    Source

