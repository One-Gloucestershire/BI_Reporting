table 'Same Waiting List'
	lineageTag: 671a84ae-5a7c-4cbb-a6c1-dcbd1ccabdc2

	measure '% are Working Age Adults (18-64)' = ```
			
			CALCULATE(
				COUNT('Same Waiting List'[Pseudo_NHS_Number]),
				'Same Waiting List'[AgeBand] IN { "Working Age Adults (18-64)" }
			) 
			/
			CALCULATE(
			    COUNT('Same Waiting List'[Pseudo_NHS_Number]))
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4bdd4feb-9d5d-4d48-9e30-fcb83abf6e38

	measure '% are Children and Young People (0-17)' = ```
			
			CALCULATE(
				COUNT('Same Waiting List'[Pseudo_NHS_Number]),
				'Same Waiting List'[AgeBand] IN { "Children and Young People (0-17)" }
			) 
			/
			CALCULATE(
			    COUNT('Same Waiting List'[Pseudo_NHS_Number]))
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ef313e10-da2f-47cb-bb28-1158f6621110

	measure '% are Older Adults (65+)' = ```
			
			CALCULATE(
				COUNT('Same Waiting List'[Pseudo_NHS_Number]),
				'Same Waiting List'[AgeBand] IN { "Older Adults (65+)" }
			) 
			/
			CALCULATE(
			    COUNT('Same Waiting List'[Pseudo_NHS_Number]))
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 071340e2-bb9c-4f1b-b0db-311160ed65f5

	measure '% are Core20' = ```
			
			CALCULATE(
				sum('Same Waiting List'[Core20Flag])
			) 
			/
			CALCULATE(
			    COUNT('Same Waiting List'[Pseudo_NHS_Number]))
			```
		lineageTag: b5a5c01a-8ca7-4d91-8264-e6b87b373639

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% are Female' = ```
			
			CALCULATE(
				COUNT('Same Waiting List'[Gender]),
				'Same Waiting List'[Gender] IN { "F" }
			) 
			/
			CALCULATE(
			    COUNT('Same Waiting List'[Pseudo_NHS_Number]))
			```
		lineageTag: 574003b2-4247-4e98-bbd5-714ffa49df92

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% are Male' = ```
			
			CALCULATE(
				COUNT('Same Waiting List'[Gender]),
				'Same Waiting List'[Gender] IN { "M" }
			) 
			/
			CALCULATE(
			    COUNT('Same Waiting List'[Pseudo_NHS_Number]))
			```
		lineageTag: 06c00da8-e522-4022-b051-1f50226153ce

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '1 SWL' = ```
			
			if(CALCULATE(
				COUNT('Waiting List Cohort'[Pseudo_NHS_Number]),
				'Waiting List Cohort'[AgeBand] IN { "Children and Young People (0-17)" }
			) = BLANK(),0, CALCULATE(
				COUNT('Waiting List Cohort'[Pseudo_NHS_Number]),
				'Waiting List Cohort'[AgeBand] IN { "Children and Young People (0-17)" }))
			
			
			```
		formatString: 0
		lineageTag: ac49d380-746b-46c9-ab80-b4ce2f1a2d60

