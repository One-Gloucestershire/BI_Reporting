				    Source = Sql.Database("grh-ccg-sql", "BIReports", [Query="SET ANSI_NULLS ON#(lf)SET QUOTED_IDENTIFIER ON#(lf)set nocount on#(lf)set ansi_warnings off #(lf)#(lf)IF OBJECT_ID('tempdb..#TEMP') IS NOT NULL DROP TABLE #TEMP;  #(lf)#(lf)/*=======================================================================#(lf)PARAMETERS#(lf)=======================================================================*/#(lf)#(lf)DECLARE @WEEKENDING DATETIME#(lf)SET @WEEKENDING = (SELECT DISTINCT MAX(#(lf)CASE WHEN DATENAME(DW,[week_ending_date]) = 'MONDAY' THEN DATEADD(DD,-1,[week_ending_date])#(lf)WHEN DATENAME(DW,[week_ending_date]) = 'TUESDAY' THEN DATEADD(DD,-2,[week_ending_date])  #(lf)WHEN DATENAME(DW,[week_ending_date]) = 'WEDNESDAY' THEN DATEADD(DD,-3,[week_ending_date]) #(lf)WHEN  DATENAME(DW,[week_ending_date]) = 'THURSDAY' THEN DATEADD(DD,-4,[week_ending_date])#(lf)WHEN DATENAME(DW,[week_ending_date]) = 'FRIDAY' THEN DATEADD(DD,-5,[week_ending_date])#(lf)WHEN DATENAME(DW,[week_ending_date]) = 'SATURDAY' THEN DATEADD(DD,-6,[week_ending_date])ELSE [week_ending_date] END)#(lf)#(lf)FROM [Data_Mart_COVID19].[dbo].[National_Wait_List_Open_Pathways] where week_ending_date <= GETDATE())#(lf)#(lf)DECLARE @WEEKENDING1 DATETIME#(lf)SET @WEEKENDING1 = (SELECT DISTINCT MAX(#(lf)CASE WHEN DATENAME(DW,[week_ending_date]) = 'MONDAY' THEN DATEADD(DD,-1,[week_ending_date])#(lf)WHEN DATENAME(DW,[week_ending_date]) = 'TUESDAY' THEN DATEADD(DD,-2,[week_ending_date])  #(lf)WHEN DATENAME(DW,[week_ending_date]) = 'WEDNESDAY' THEN DATEADD(DD,-3,[week_ending_date]) #(lf)WHEN  DATENAME(DW,[week_ending_date]) = 'THURSDAY' THEN DATEADD(DD,-4,[week_ending_date])#(lf)WHEN DATENAME(DW,[week_ending_date]) = 'FRIDAY' THEN DATEADD(DD,-5,[week_ending_date])#(lf)WHEN DATENAME(DW,[week_ending_date]) = 'SATURDAY' THEN DATEADD(DD,-6,[week_ending_date])ELSE [week_ending_date] END)#(lf)FROM [Data_Mart_COVID19].[dbo].[National_Wait_List_Open_Pathways] where week_ending_date <= '31-MAR-2022')#(lf)/*=======================================================================#(lf)CURRENT WAIT LIST#(lf)=======================================================================*/#(lf)#(lf)SELECT #(lf)[COUNT] = 1,#(lf)[Date_And_Time_Data_Set_Created],#(lf)[Week_Ending_Date],#(lf)[Days] = DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING),#(lf)[Weeks] = DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING) / 7.0,#(lf)[Weeks_Waiting_Banding] = CASE WHEN DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING) BETWEEN 0   AND 126 THEN '0 < 18 Weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING) BETWEEN 127 AND 182 THEN '18 < 26 Weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING) BETWEEN 183 AND 280 THEN '26 < 40 Weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING) BETWEEN 281 AND 364 THEN '40 <  52 Weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING) BETWEEN 365 AND 546 THEN '52 < 78 Weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING) BETWEEN 547 AND 728 THEN '78 < 104 Weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING) > 729               THEN '104+ Weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   ELSE 'NULL' END,#(lf)[Pseudo_NHS_Number],#(lf)[WL].[Organisation_Identifier_Code_Of_Provider],#(lf)[Provider] = CASE WHEN [TR].[Name] IS NOT NULL THEN [TR].[Name]#(lf)#(tab)#(tab)#(tab)#(tab)  WHEN [WL].[Organisation_Identifier_Code_Of_Provider] = 'R0D' THEN 'UNIVERSITY HOSPITALS DORSET NHS FOUNDATION TRUST'#(lf)#(tab)#(tab)#(tab)#(tab)  ELSE [IP].[Organisationname] END,#(lf)[Organisation_Site_Identifier_Of_Treatment],#(lf)[Activity_Treatment_Function_Code],#(lf)[Treatment Function] =[TF].[TreatmentFunctionDescription],#(lf)[Referral_To_Treatment_Period_Start_Date],#(lf)[Organisation_Identifier_Code_Of_Commissioner],#(lf)[WL].[Derived_Registered_CCG],#(lf)[Derived_GP_Registered_Practice_Code],#(lf)[Waiting_List_Type] = CASE WHEN [Waiting_List_Type] = 'IRTT' then 'Admitted PTL'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN [Waiting_List_Type] = 'ORTT' then 'Non-Admitted PTL' ELSE 'Other' END,#(lf)[Derived_Age_At_Activity],#(lf)[AgeBand5yr] = [AB].[5yr_age_band],#(lf)[AgeBand5yrs] = CASE WHEN [Derived_Age_At_Activity] BETWEEN 85 AND 89 then '85-89'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN [Derived_Age_At_Activity] >= 90 THEN '90+'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab) ELSE [AB].[5yr_age_band] END,#(lf)[AgeBand10yr] = [AB].[10yr_age_band], #(lf)[AB].[Adult_Age_Band],#(lf)[AgeBand] = CASE WHEN CAST([Derived_Age_At_Activity] AS INT) <18 THEN 'Children and Young People (0-17)'#(lf)#(tab)#(tab)#(tab)#(tab) WHEN CAST([Derived_Age_At_Activity] AS INT) BETWEEN 18 AND 64 THEN 'Working Age Adults (18-64)' #(lf)#(tab)#(tab)#(tab)#(tab) WHEN CAST([Derived_Age_At_Activity] AS INT) >64 THEN 'Older Adults (65+)' ELSE 'Unknown' END, #(lf)[Derived_LSOA],#(lf)[MPI Gender] = [MPI].[Gender],#(lf)[MPI Ethnic Description] = [MPI].[EthnicOriginDescription],#(lf)[MPI Deprivation] = [MPI].[IMDcountyDecile],#(lf)[MPI Learning Disability] = [MPI].[Learningdisabilityderived],#(lf)[MPI Core20] = [MPI].[Core20Flag],#(lf)[PDSGender] = CASE WHEN LEFT([PDS].[Gender_desc],1) IS NULL  THEN 'U'#(lf)#(tab)#(tab)#(tab)#(tab)   WHEN [PDS].[Gender_desc] = 'Spine code 9' THEN 'U'#(lf)#(tab)#(tab)#(tab)#(tab)   ELSE LEFT([PDS].[Gender_desc],1) END, #(lf)[PDS].[PrimaryCareProvider],#(lf)[Practice name] = [C].[ReportingOrganisationName],#(lf)[C].[PrimaryCareNetwork],#(lf)[Ethn].[Ethnic Origin Grouped],#(lf)[Ethn].[Ethnic Origin Wider Groups],#(lf)[post].[IMDCountyDecile],#(lf)#(lf)[Core20Flag] = CASE WHEN [Derived_LSOA] in ('E01022120','E01022122','E01022131','E01022133','E01022147','E01022152','E01022160','E01022164','E01022238','E01022284',#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)'E01022285','E01022288','E01022289','E01022290','E01022291','E01022292','E01022311','E01022319','E01022320','E01022322',#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) 'E01022323','E01022324','E01022328','E01022329','E01022332','E01022333','E01022346','E01022347','E01022458','E01032932',#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) 'E01032937') THEN 1 ELSE 0#(tab)END,      #(lf)[WaitingList] = 'Current'#(lf)INTO #TEMP#(lf)FROM [Data_Mart_COVID19].[dbo].[National_Wait_List_Open_Pathways] [WL]#(lf)#(lf)#(tab)LEFT JOIN [CCG_Reference].[Reference].[vw_TreatmentFunction] [TF] #(lf)#(tab)ON WL.[Activity_Treatment_Function_Code] = [TF].[TreatmentFunctionCode]#(lf)#(lf)#(tab)#(tab)LEFT JOIN [CCG_Reference].[Reference].[vw_OrganisationTrust] TR #(lf)#(tab)#(tab)ON TR.[OrganisationCode] = [Organisation_Identifier_Code_Of_Provider]#(lf)#(lf)#(tab)#(tab)#(tab)LEFT JOIN [CCG_Reference].[Reference].[vw_IndependentProvider] IP #(lf)#(tab)#(tab)#(tab)ON IP.[OrganisationCode] = Left([Organisation_Identifier_Code_Of_Provider], 3) #(lf)#(lf)#(tab)#(tab)#(tab)#(tab)LEFT JOIN [BIReports].[MPI].[MPI_current] MPI#(lf)#(tab)#(tab)#(tab)#(tab)ON MPI.Derived_Pseudo_NHS = WL.Pseudo_NHS_Number#(lf)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)LEFT JOIN [CCG_Reference].[Population].[vw_NHAIS_Current] [NHAIS]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)ON [NHAIS].[Derived_Pseudo_NHS] = [WL].[Pseudo_NHS_Number]#(lf)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)LEFT JOIN [CCG_Reference].[Population].[vw_PDS_Current] [PDS]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ON [PDS].Derived_NHS_Number = WL.Pseudo_NHS_Number#(lf)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)LEFT JOIN [BIReports].[MPI].[Ethnicity_Table] [Ethn]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ON [Ethn].[PseudoNHSNo] = [WL].[Pseudo_NHS_Number]#(lf)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)LEFT JOIN [ccg_reference].[reference].[vw_postcode_lookup] [post]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ON [NHAIS].[Derived_Pseudo_Postcode] = [post].[derived_Postcode_Key]#(lf)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)LEFT JOIN [CCG_Reference].[Reference].[vw_GPPractice] [C]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ON [PDS].[PrimaryCareProvider] = [C].[OrganisationCode]#(lf)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(lf)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) LEFT JOIN [CCG_Reference].[Reference].[vw_AgeBand] [AB]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) ON [Derived_Age_At_Activity] = [AB].[Age]#(lf)#(lf)WHERE [Referral_To_Treatment_Period_End_Date] IS NULL#(lf)AND [Referral_To_Treatment_Period_Start_Date] IS NOT NULL#(lf)AND CASE WHEN DATENAME(DW,[week_ending_date]) = 'MONDAY'    THEN DATEADD(DD,-1,[week_ending_date])#(lf)#(tab)#(tab) WHEN DATENAME(DW,[week_ending_date]) = 'TUESDAY'   THEN DATEADD(DD,-2,[week_ending_date])  #(lf)#(tab)#(tab) WHEN DATENAME(DW,[week_ending_date]) = 'WEDNESDAY' THEN DATEADD(DD,-3,[week_ending_date]) #(lf)#(tab)#(tab) WHEN DATENAME(DW,[week_ending_date]) = 'THURSDAY'  THEN DATEADD(DD,-4,[week_ending_date])#(lf)#(tab)#(tab) WHEN DATENAME(DW,[week_ending_date]) = 'FRIDAY'    THEN DATEADD(DD,-5,[week_ending_date])#(lf)#(tab)#(tab) WHEN DATENAME(DW,[week_ending_date]) = 'SATURDAY'  THEN DATEADD(DD,-6,[week_ending_date]) ELSE [week_ending_date] END = @WEEKENDING#(lf)AND [Referral_To_Treatment_Period_Start_Date] <= @WEEKENDING#(lf)AND [WL].[Derived_Registered_CCG] = '11M'#(lf)#(lf)#(lf)#(lf)SET NOCOUNT ON#(lf)IF OBJECT_ID ('TEMPDB..#WL_tbl') IS NOT NULL DROP TABLE #WL_tbl#(lf)#(lf)SELECT DISTINCT #(lf)[T].[Pseudo_NHS_Number],#(lf)[T].[Treatment Function],#(lf)[T].[Weeks_Waiting_Banding],#(lf)[OtherSpecialty] = COUNT(distinct [T2].[Treatment Function])#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)INTO #WL_tbl#(lf)#(lf)FROM #TEMP [T]#(lf)#(lf)LEFT JOIN #TEMP AS [T2]#(lf)ON [T2].[Pseudo_NHS_Number] = [T].[Pseudo_NHS_Number]#(lf)#(lf)group by [T].[Pseudo_NHS_Number],#(lf)[T].[Treatment Function],#(lf)[T].[Weeks_Waiting_Banding]#(lf)#(lf)#(lf)order by [T].[Pseudo_NHS_Number]#(lf)#(lf)#(lf)    SET NOCOUNT ON#(lf)IF OBJECT_ID ('TEMPDB..#demographics') IS NOT NULL DROP TABLE #demographics#(lf)#(lf)  SELECT distinct#(lf)#(lf)  [W].Pseudo_NHS_Number#(lf)  ,OtherSpecialty#(lf)  ,[W].[Treatment Function]#(lf)  ,[Ranking] = rank() OVER(PARTITION BY Pseudo_NHS_Number ORDER BY [Treatment Function] ASC)#(lf)  ,[M].PracNameCurrent#(lf)  ,[M].[NetworkName]#(lf)  ,[M].[AgeBand]#(lf)  ,[M].[EthnicOriginDescription]#(lf)  ,[M].[IMDcountyDecile]#(lf)  ,[M].[Core20Flag]#(lf)  ,[M].[Gender]#(lf)  ,[M].[Current District Ward name]#(lf)  ,[M].[Derived_Age]#(lf)#(lf)#(lf)  #(lf)  INTO #demographics#(lf)#(lf)  FROM #WL_tbl [W]#(lf)#(lf)  LEFT JOIN [BIReports].[MPI].[MPI_current] [M] ON [M].[Derived_Pseudo_NHS] = [W].Pseudo_NHS_Number#(lf)#(lf)  order by [W].Pseudo_NHS_Number#(lf)#(lf)#(lf)  #(tab)------------------#(lf)#(tab)--Rapid Response#(lf)#(tab)------------------#(lf)#(lf)#(tab)SET NOCOUNT ON#(lf)#(tab)IF OBJECT_ID ('TEMPDB..#Rapid_Response') IS NOT NULL DROP TABLE #Rapid_Response#(lf)#(lf)#(tab)SELECT#(lf)#(tab)[t].Pseudo_NHS_Number#(lf)#(tab),[number_of_rapid_response] = sum(1)#(lf)#(lf)#(tab)INTO #Rapid_Response#(lf)#(lf)#(tab)FROM #TEMP t#(lf)#(tab)#(lf)#(tab)LEFT JOIN [CCG_Current].[CSDS].[vw_301_Referral] as r on r.DerivedPseudoNHS = t.Pseudo_NHS_Number#(lf) #(lf)#(tab)LEFT JOIN CCG_Reference.GHC.vw_Hierarchy as h on r.Current_CostCentre = h.Cost_Centre#(lf)#(lf)#(tab)WHERE OrgIDProvider in ('R1J','RTQ')#(lf)#(lf)#(tab)AND [ReferralRequestReceivedDate] >= EOMONTH(DATEADD(MONTH, -13, GETDATE()))#(lf)#(tab)#(lf)#(tab)AND h.Cost_Centre in ('G15503', --Rapid Response#(lf)#(tab)'G15503a', --Rapid Response - RR - ENDNS#(lf)#(tab)'G15503b')--Rapid Response - RR - District Nursing#(lf)#(tab)#(tab)#(lf)#(tab)GROUP BY Pseudo_NHS_Number#(lf)#(lf)#(tab)  ------------------#(lf)  --SWAST Calls#(lf)  ------------------#(lf)#(lf)#(lf)#(tab)SET NOCOUNT ON#(lf)#(tab)IF OBJECT_ID ('TEMPDB..#SWAST') IS NOT NULL DROP TABLE #SWAST#(lf)#(lf)#(tab)SELECT#(lf)#(tab)Pseudo_NHS_Number#(lf)#(tab),[number_of_SWAST_calls] = sum(1)#(lf)#(lf)#(tab)INTO #SWAST#(lf)#(lf)#(tab)FROM #TEMP t#(lf)#(tab)#(lf)#(tab)LEFT JOIN [CCG_Current].[SWASFT].[vw_AmbulanceServicePatient] a on a.Derived_Pseudo_NHSNumber = t.Pseudo_NHS_Number#(lf)#(lf)#(tab)WHERE [Time_Of_Incident] >= EOMONTH(DATEADD(MONTH, -13, GETDATE()))#(lf)#(lf)#(tab)GROUP BY Pseudo_NHS_Number#(lf)#(tab)#(lf)#(tab)------------------#(lf)#(tab)--OOH#(lf)#(tab)------------------#(lf)#(lf)#(tab)SET NOCOUNT ON#(lf)#(tab)IF OBJECT_ID('tempdb..#OOH') is not null drop table #OOH#(lf)#(lf)#(tab)SELECT #(lf)#(tab)Pseudo_NHS_Number#(lf)#(tab),[number_of_OOH_appointments] = SUM(1)#(lf)#(lf)#(tab)into #OOH#(lf)#(tab)FROM  #TEMP t#(lf)#(tab)#(lf)#(tab)LEFT JOIN [CCG_Current].[CareUK].[vw_OutOfHours] o on o.NHSNumber = t.Pseudo_NHS_Number#(lf)#(lf)#(tab)where ReceivedDateTime >= EOMONTH(DATEADD(MONTH, -13, GETDATE()))#(lf)#(lf)#(tab)GROUP BY Pseudo_NHS_Number#(lf)#(lf)#(tab)---------------------#(lf)#(tab)--Combined table#(lf)#(tab)---------------------#(lf)#(lf)#(lf)#(tab)#(tab)SET NOCOUNT ON#(lf)#(tab)IF OBJECT_ID('tempdb..#patients') is not null drop table #patients#(lf)#(lf)#(lf)#(lf)SELECT #(lf)#(tab)[counter] = 1#(lf)#(tab),Core20Flag#(lf)#(tab),[m].[Derived_Pseudo_NHS]#(lf)#(tab),AgeBand#(lf)#(tab),EthnicOriginDescription#(lf)#(tab),Gender#(lf)#(tab),PracNameCurrent#(lf)#(tab),Derived_Age#(lf)#(tab),IMDcountyDecile#(lf)#(tab),[Number_of_ED_attendances] = [m].[EDonlyAETotal]#(lf)#(tab),[number_of_PC_appointments] = [m].[GPapptTotal]#(lf)#(tab),[number_of_SWAST_calls] = case when [number_of_SWAST_calls] is null then '0' else [number_of_SWAST_calls] END#(lf)#(tab),[number_of_111_calls] = [m].[111Total]#(lf)#(tab),[number_of_rapid_response] = case when [number_of_rapid_response] is null then '0' else [number_of_rapid_response] END#(lf)#(tab),[number_of_hospital_admissions] = [m].[EmergencyAdmTotal]#(lf)#(tab),[number_of_MIU_attendances] = [m].[EDonlyMIUTotal]#(lf)#(tab),[number_of_OOH_appointments] = case when [number_of_OOH_appointments] is null then '0' else [number_of_OOH_appointments] END#(lf)#(lf)#(tab)into #patients#(lf)#(lf)  FROM [BIReports].[MPI].[MPI_current] [m]#(lf)#(lf) #(lf)  LEFT JOIN #SWAST [S] ON [S].Pseudo_NHS_Number = [m].[Derived_Pseudo_NHS]#(lf)  LEFT JOIN #Rapid_Response [RR] ON [RR].Pseudo_NHS_Number = [m].[Derived_Pseudo_NHS]#(lf)  LEFT JOIN #OOH [O] ON [O].Pseudo_NHS_Number = [m].[Derived_Pseudo_NHS]#(lf)#(lf)  #(tab)#(tab)SET NOCOUNT ON#(lf)#(tab)IF OBJECT_ID('tempdb..#combined') is not null drop table #combined#(lf)#(lf)#(lf)  select #(lf)  d.Pseudo_NHS_Number#(lf)  ,d.[Treatment Function]#(lf)  ,p.number_of_PC_appointments#(lf)  #(lf)  into #combined#(lf)#(lf)  from #demographics d#(lf)#(lf)  left join #patients p on p.Derived_Pseudo_NHS = d.Pseudo_NHS_Number#(lf)#(lf)    #(tab)#(tab)SET NOCOUNT ON#(lf)#(tab)IF OBJECT_ID('tempdb..#counter') is not null drop table #counter#(lf)#(lf)#(lf)#(lf)  select#(lf)  [waiting_list_size] = sum(1)#(lf)  ,number_of_PC_appointments = sum(number_of_PC_appointments)#(lf)  ,[Treatment Function]#(lf)#(lf)  into #counter#(lf)#(lf)  from #combined#(lf)#(lf)  group by [Treatment Function]#(lf)#(lf)  order by [Treatment Function] asc#(lf)#(lf)#(lf)  select#(lf)  [average_PC_appointments_per_wl_patient] = cast([number_of_PC_appointments] as float) / cast([waiting_list_size] as float)#(lf)  ,[Treatment Function]#(lf)  ,[waiting_list_size]#(lf)  ,[number_of_PC_appointments]#(lf)#(lf)  from #counter#(lf)#(lf)  order by [Treatment Function]"])
