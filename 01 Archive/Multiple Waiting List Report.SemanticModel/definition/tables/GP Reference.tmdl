table 'GP Reference'
	lineageTag: 1802c09a-b96a-4d93-a5b1-85546cc752d9

	column PracNameCurrent
		dataType: string
		lineageTag: 65f57d82-aa80-49df-83dd-8d6c491140b9
		summarizeBy: none
		sourceColumn: PracNameCurrent

		annotation SummarizationSetBy = Automatic

	column NetworkName
		dataType: string
		lineageTag: a5bc051d-dc92-42db-8022-699fc5524848
		summarizeBy: none
		sourceColumn: NetworkName

		annotation SummarizationSetBy = Automatic

	column locality
		dataType: string
		lineageTag: 247c03ba-bd23-40b8-ac52-866265f6ae43
		summarizeBy: none
		sourceColumn: locality

		annotation SummarizationSetBy = Automatic

	partition 'GP Reference' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Reference", [Query="select distinct#(lf)PracNameCurrent#(lf),[locality] = CASE#(tab)WHEN LocalityName LIKE 'South Cotswolds' THEN 'Cotswolds'  #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN LocalityName LIKE 'North Cotswolds' THEN 'Cotswolds'  #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)ELSE LocalityName END#(lf),NetworkName#(lf)from BIReports.MPI.MPI_current#(lf)#(lf)where LocalityName is not null#(lf)#(lf)order by PracNameCurrent"])
				in
				    Source

	annotation PBI_ResultType = Table

