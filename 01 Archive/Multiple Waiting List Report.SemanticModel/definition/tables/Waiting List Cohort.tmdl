table 'Waiting List Cohort'
	lineageTag: 03a8d874-15ca-4fe2-8062-8248f92fb171

	measure 'Average Age WLC' = AVERAGE('Waiting List Cohort'[Derived_Age])
		lineageTag: 9386adc4-4a14-48ce-9606-9bbcdfe386fd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% WLC are Children and Young People (0-17)' = ```
			
			CALCULATE(
				COUNT('Waiting List Cohort'[Pseudo_NHS_Number]),
				'Waiting List Cohort'[AgeBand] IN { "Children and Young People (0-17)" }
			) 
			/
			CALCULATE(
			    COUNT('Waiting List Cohort'[Pseudo_NHS_Number]))
			
			```
		lineageTag: 5ba90821-c6d9-4b8b-b7bc-c572baa0f90f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% WLC are Core20' = ```
			
			CALCULATE(
				sum('Waiting List Cohort'[Core20Flag])
			) 
			/
			CALCULATE(
			    COUNT('Waiting List Cohort'[Pseudo_NHS_Number]))
			```
		lineageTag: 09e8ada0-7ba0-4488-a47e-5c7c77a20899

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% WLC are Female' = ```
			
			CALCULATE(
