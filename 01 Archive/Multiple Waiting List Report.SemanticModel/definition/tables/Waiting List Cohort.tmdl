				    Source = Sql.Database("grh-ccg-sql", "PowerBI_Reporting", [Query="SET ANSI_NULLS ON#(lf)SET QUOTED_IDENTIFIER ON#(lf)set nocount on#(lf)set ansi_warnings off #(lf)#(lf)IF OBJECT_ID('tempdb..#TEMP') IS NOT NULL DROP TABLE #TEMP;  #(lf)#(lf)/*=======================================================================#(lf)PARAMETERS#(lf)=======================================================================*/#(lf)#(lf)DECLARE @WEEKENDING DATETIME#(lf)SET @WEEKENDING = (SELECT DISTINCT MAX(#(lf)CASE WHEN DATENAME(DW,[week_ending_date]) = 'MONDAY' THEN DATEADD(DD,-1,[week_ending_date])#(lf)WHEN DATENAME(DW,[week_ending_date]) = 'TUESDAY' THEN DATEADD(DD,-2,[week_ending_date])  #(lf)WHEN DATENAME(DW,[week_ending_date]) = 'WEDNESDAY' THEN DATEADD(DD,-3,[week_ending_date]) #(lf)WHEN  DATENAME(DW,[week_ending_date]) = 'THURSDAY' THEN DATEADD(DD,-4,[week_ending_date])#(lf)WHEN DATENAME(DW,[week_ending_date]) = 'FRIDAY' THEN DATEADD(DD,-5,[week_ending_date])#(lf)WHEN DATENAME(DW,[week_ending_date]) = 'SATURDAY' THEN DATEADD(DD,-6,[week_ending_date])ELSE [week_ending_date] END)#(lf)#(lf)FROM [Data_Mart_COVID19].[dbo].[National_Wait_List_Open_Pathways] where week_ending_date <= GETDATE())#(lf)#(lf)DECLARE @WEEKENDING1 DATETIME#(lf)SET @WEEKENDING1 = (SELECT DISTINCT MAX(#(lf)CASE WHEN DATENAME(DW,[week_ending_date]) = 'MONDAY' THEN DATEADD(DD,-1,[week_ending_date])#(lf)WHEN DATENAME(DW,[week_ending_date]) = 'TUESDAY' THEN DATEADD(DD,-2,[week_ending_date])  #(lf)WHEN DATENAME(DW,[week_ending_date]) = 'WEDNESDAY' THEN DATEADD(DD,-3,[week_ending_date]) #(lf)WHEN  DATENAME(DW,[week_ending_date]) = 'THURSDAY' THEN DATEADD(DD,-4,[week_ending_date])#(lf)WHEN DATENAME(DW,[week_ending_date]) = 'FRIDAY' THEN DATEADD(DD,-5,[week_ending_date])#(lf)WHEN DATENAME(DW,[week_ending_date]) = 'SATURDAY' THEN DATEADD(DD,-6,[week_ending_date])ELSE [week_ending_date] END)#(lf)FROM [Data_Mart_COVID19].[dbo].[National_Wait_List_Open_Pathways] where week_ending_date <= '31-MAR-2022')#(lf)/*=======================================================================#(lf)CURRENT WAIT LIST#(lf)=======================================================================*/#(lf)#(lf)SELECT #(lf)[COUNT] = 1,#(lf)[Date_And_Time_Data_Set_Created],#(lf)[Week_Ending_Date],#(lf)[Days] = DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING),#(lf)[Weeks] = DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING) / 7.0,#(lf)[Weeks_Waiting_Banding] = CASE WHEN DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING) BETWEEN 0   AND 126 THEN '0 < 18 Weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING) BETWEEN 127 AND 182 THEN '18 < 26 Weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING) BETWEEN 183 AND 280 THEN '26 < 40 Weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING) BETWEEN 281 AND 364 THEN '40 <  52 Weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING) BETWEEN 365 AND 546 THEN '52 < 78 Weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING) BETWEEN 547 AND 728 THEN '78 < 104 Weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING) > 729               THEN '104+ Weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   ELSE 'NULL' END,#(lf)[Pseudo_NHS_Number],#(lf)[WL].[Organisation_Identifier_Code_Of_Provider],#(lf)[Organisation_Site_Identifier_Of_Treatment],#(lf)[Activity_Treatment_Function_Code],#(lf)[Treatment Function] =[TF].[TreatmentFunctionDescription],#(lf)[Referral_To_Treatment_Period_Start_Date],#(lf)[Organisation_Identifier_Code_Of_Commissioner],#(lf)[WL].[Derived_Registered_CCG],#(lf)[Derived_GP_Registered_Practice_Code],#(lf)[Waiting_List_Type] = CASE WHEN [Waiting_List_Type] = 'IRTT' then 'Admitted PTL'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN [Waiting_List_Type] = 'ORTT' then 'Non-Admitted PTL' ELSE 'Other' END,#(lf)#(lf)[AgeBand] = CASE WHEN CAST([Derived_Age_At_Activity] AS INT) <18 THEN 'Children and Young People (0-17)'#(lf)#(tab)#(tab)#(tab)#(tab) WHEN CAST([Derived_Age_At_Activity] AS INT) BETWEEN 18 AND 64 THEN 'Working Age Adults (18-64)' #(lf)#(tab)#(tab)#(tab)#(tab) WHEN CAST([Derived_Age_At_Activity] AS INT) >64 THEN 'Older Adults (65+)' ELSE 'Unknown' END, #(lf)[Derived_LSOA],#(lf)#(lf)#(lf)[WaitingList] = 'Current'#(lf)INTO #TEMP#(lf)FROM [Data_Mart_COVID19].[dbo].[National_Wait_List_Open_Pathways] [WL]#(lf)#(lf)#(tab)LEFT JOIN [CCG_Reference].[Reference].[vw_TreatmentFunction] [TF] #(lf)#(tab)ON WL.[Activity_Treatment_Function_Code] = [TF].[TreatmentFunctionCode]#(lf)#(tab)#(tab)#(tab)#(tab)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(lf)WHERE [Referral_To_Treatment_Period_End_Date] IS NULL#(lf)AND [Referral_To_Treatment_Period_Start_Date] IS NOT NULL#(lf)AND CASE WHEN DATENAME(DW,[week_ending_date]) = 'MONDAY'    THEN DATEADD(DD,-1,[week_ending_date])#(lf)#(tab)#(tab) WHEN DATENAME(DW,[week_ending_date]) = 'TUESDAY'   THEN DATEADD(DD,-2,[week_ending_date])  #(lf)#(tab)#(tab) WHEN DATENAME(DW,[week_ending_date]) = 'WEDNESDAY' THEN DATEADD(DD,-3,[week_ending_date]) #(lf)#(tab)#(tab) WHEN DATENAME(DW,[week_ending_date]) = 'THURSDAY'  THEN DATEADD(DD,-4,[week_ending_date])#(lf)#(tab)#(tab) WHEN DATENAME(DW,[week_ending_date]) = 'FRIDAY'    THEN DATEADD(DD,-5,[week_ending_date])#(lf)#(tab)#(tab) WHEN DATENAME(DW,[week_ending_date]) = 'SATURDAY'  THEN DATEADD(DD,-6,[week_ending_date]) ELSE [week_ending_date] END = @WEEKENDING#(lf)AND [Referral_To_Treatment_Period_Start_Date] <= @WEEKENDING#(lf)AND [WL].[Derived_Registered_CCG] = '11M'#(lf)#(lf)#(lf)#(lf)SET NOCOUNT ON#(lf)IF OBJECT_ID ('TEMPDB..#WL_tbl') IS NOT NULL DROP TABLE #WL_tbl#(lf)#(lf)SELECT DISTINCT #(lf)[T].[Pseudo_NHS_Number]#(lf)#(lf)INTO #WL_tbl#(lf)#(lf)FROM #TEMP [T]#(lf)#(lf)order by [T].[Pseudo_NHS_Number]#(lf)#(lf)#(lf)SET NOCOUNT ON#(lf)IF OBJECT_ID ('TEMPDB..#number_waiting_lists') IS NOT NULL DROP TABLE #number_waiting_lists#(lf)#(lf)#(lf)SELECT DISTINCT #(lf)[T].[Pseudo_NHS_Number],#(lf)[T].[Treatment Function],#(lf)[T].[Weeks_Waiting_Banding],#(lf)[number_of_waiting_lists] = COUNT(distinct [T2].[Treatment Function])#(lf)#(lf)#(lf)INTO #number_waiting_lists#(lf)#(lf)FROM #TEMP [T]#(lf)#(lf)LEFT JOIN #TEMP AS [T2]#(lf)ON [T2].[Pseudo_NHS_Number] = [T].[Pseudo_NHS_Number]#(lf)#(lf)group by [T].[Pseudo_NHS_Number],#(lf)[T].[Treatment Function],#(lf)[T].[Weeks_Waiting_Banding]#(lf)#(lf)#(lf)order by [T].[Pseudo_NHS_Number]#(lf)#(lf)#(lf)#(lf)#(tab)------------------#(lf)#(tab)--Rapid Response#(lf)#(tab)------------------#(lf)#(lf)#(tab)SET NOCOUNT ON#(lf)#(tab)IF OBJECT_ID ('TEMPDB..#Rapid_Response') IS NOT NULL DROP TABLE #Rapid_Response#(lf)#(lf)#(tab)SELECT#(lf)#(tab)[t].Pseudo_NHS_Number#(lf)#(tab),[number_of_rapid_response] = sum(1)#(lf)#(lf)#(tab)INTO #Rapid_Response#(lf)#(lf)#(tab)FROM #TEMP t#(lf)#(tab)#(lf)#(tab)LEFT JOIN [CCG_Current].[CSDS].[vw_301_Referral] as r on r.DerivedPseudoNHS = t.Pseudo_NHS_Number#(lf) #(lf)#(tab)LEFT JOIN CCG_Reference.GHC.vw_Hierarchy as h on r.Current_CostCentre = h.Cost_Centre#(lf)#(lf)#(tab)WHERE OrgIDProvider in ('R1J','RTQ')#(lf)#(lf)#(tab)AND [ReferralRequestReceivedDate] >= EOMONTH(DATEADD(MONTH, -13, GETDATE()))#(lf)#(tab)#(lf)#(tab)AND h.Cost_Centre in ('G15503', --Rapid Response#(lf)#(tab)'G15503a', --Rapid Response - RR - ENDNS#(lf)#(tab)'G15503b')--Rapid Response - RR - District Nursing#(lf)#(tab)#(tab)#(lf)#(tab)GROUP BY Pseudo_NHS_Number#(lf)#(lf)#(tab)  ------------------#(lf)  --SWAST Calls#(lf)  ------------------#(lf)#(lf)#(lf)#(tab)SET NOCOUNT ON#(lf)#(tab)IF OBJECT_ID ('TEMPDB..#SWAST') IS NOT NULL DROP TABLE #SWAST#(lf)#(lf)#(tab)SELECT#(lf)#(tab)Pseudo_NHS_Number#(lf)#(tab),[number_of_SWAST_calls] = sum(1)#(lf)#(lf)#(tab)INTO #SWAST#(lf)#(lf)#(tab)FROM #TEMP t#(lf)#(tab)#(lf)#(tab)LEFT JOIN [CCG_Current].[SWASFT].[vw_AmbulanceServicePatient] a on a.Derived_Pseudo_NHSNumber = t.Pseudo_NHS_Number#(lf)#(lf)#(tab)WHERE [Time_Of_Incident] >= EOMONTH(DATEADD(MONTH, -13, GETDATE()))#(lf)#(lf)#(tab)GROUP BY Pseudo_NHS_Number#(lf)#(tab)#(lf)#(tab)------------------#(lf)#(tab)--OOH#(lf)#(tab)------------------#(lf)#(lf)#(tab)SET NOCOUNT ON#(lf)#(tab)IF OBJECT_ID('tempdb..#OOH') is not null drop table #OOH#(lf)#(lf)#(tab)SELECT #(lf)#(tab)Pseudo_NHS_Number#(lf)#(tab),[number_of_OOH_appointments] = SUM(1)#(lf)#(lf)#(tab)into #OOH#(lf)#(tab)FROM  #TEMP t#(lf)#(tab)#(lf)#(tab)LEFT JOIN [CCG_Current].[CareUK].[vw_OutOfHours] o on o.NHSNumber = t.Pseudo_NHS_Number#(lf)#(lf)#(tab)where ReceivedDateTime >= EOMONTH(DATEADD(MONTH, -13, GETDATE()))#(lf)#(lf)#(tab)GROUP BY Pseudo_NHS_Number#(lf)#(lf)#(tab)------------------------#(lf)#(tab)--Rockwood Frailty#(lf)#(tab)------------------------#(lf)#(lf)IF OBJECT_ID('TEMPDB..#TEMP_ROCKWOOD') IS NOT NULL DROP TABLE #TEMP_ROCKWOOD#(lf)IF OBJECT_ID('TEMPDB..#TEMP_ROCKWOOD_VALUE_FIXED') IS NOT NULL DROP TABLE #TEMP_ROCKWOOD_VALUE_FIXED#(lf);#(lf) #(lf)SELECT DISTINCT PseudoNHSNumber#(lf)#(tab)#(tab)#(tab)   ,[PracticeDescription]#(lf)#(tab)#(tab)#(tab)   ,PracticeCode#(lf)#(tab)#(tab)#(tab)   ,EventDate#(lf)#(tab)#(tab)#(tab)   ,[Event_Order] = ROW_NUMBER() OVER (PARTITION BY PseudoNHSNumber ORDER BY EventDate DESC)#(lf)#(tab)#(tab)#(tab)   ,Value1#(lf)#(tab)#(tab)#(tab)   ,[Value_Fix] = ISNUMERIC(Value1)#(lf) #(lf)INTO #TEMP_ROCKWOOD#(lf)FROM [CCG_Current].[PrimaryCare].[vw_Events]#(lf) #(lf)WHERE (EventCode COLLATE SQL_Latin1_General_CP1_CS_AS IN ('XaQik')#(lf)OR SnomedCode = '763264000')#(lf)AND PseudoNHSNumber IS NOT NULL#(lf);#(lf) #(lf)SELECT DISTINCT #(lf)#(tab)#(tab)#(tab)#(tab)PseudoNHSNumber#(lf)#(tab)#(tab)#(tab)   ,[PracticeDescription]#(lf)#(tab)#(tab)#(tab)   ,PracticeCode#(lf)#(tab)#(tab)#(tab)   ,EventDate#(lf)#(tab)#(tab)#(tab)   ,[Event_Order] = ROW_NUMBER() OVER (PARTITION BY PseudoNHSNumber ORDER BY EventDate DESC)#(lf)#(tab)#(tab)#(tab)   ,Value1#(lf)#(tab)#(tab)#(tab)   ,[Value_1] = CAST(Value1 AS FLOAT)#(lf)#(lf) #(lf)INTO #TEMP_ROCKWOOD_VALUE_FIXED#(lf)FROM #TEMP_ROCKWOOD#(lf) #(lf)WHERE [Value_Fix] = 1#(lf)AND [Event_Order] = 1#(lf);#(lf) #(lf)ALTER TABLE #TEMP_ROCKWOOD_VALUE_FIXED#(lf)ADD [Month_Date] VARCHAR (30)#(lf);#(lf) #(lf)#(lf)SELECT DISTINCT #(lf)PseudoNHSNumber#(lf),[Frailty_Type] =  CASE WHEN [Value_1] BETWEEN 1 AND 4 THEN 'Non-Frail'#(lf)#(tab)#(tab)#(tab)                           WHEN [Value_1] = 5 THEN 'Mild'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN [Value_1] = 6 THEN 'Moderate'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN [Value_1] BETWEEN 7 AND 9 THEN 'Severe'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   ELSE 'Unknown' END#(lf)#(lf)INTO #rockwood#(lf) #(lf)FROM #TEMP_ROCKWOOD_VALUE_FIXED AS [RW]#(lf) #(lf)LEFT JOIN (SELECT DISTINCT [Derived_NHS_Number]#(lf)                          ,[PDS_Flag] = 1 #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)  ,[Derived_Age]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)  ,[Gender_Desc]#(lf) #(lf)#(tab)#(tab)   FROM [CCG_Reference].[Population].[vw_PDS_Current]) AS [PDS]#(lf)ON [PDS].[Derived_NHS_Number] = [RW].PseudoNHSNumber#(lf) #(lf)LEFT JOIN (SELECT DISTINCT [Age], [5YR_Age_Band] FROM [CCG_Reference].[Reference].[vw_AgeBand]) AS [AGE]#(lf)ON [AGE].[Age] = [PDS].[Derived_Age]#(lf) #(lf)WHERE [PDS_Flag] = 1#(lf)#(lf)#(lf)#(lf)#(tab)---------------------#(lf)#(tab)--Combined table#(lf)#(tab)---------------------#(lf)#(lf)SELECT distinct#(lf)#(tab)[counter] = 1#(lf)#(tab),[Core20 Description] = CASE#(tab)WHEN Core20Flag LIKE  0 THEN 'Not Core 20'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN Core20Flag LIKE  1 THEN 'In Core 20' #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ELSE 'Not Recorded'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)END#(lf)#(tab),[Core20Flag]#(lf)#(tab),[W].[Pseudo_NHS_Number]#(lf)#(tab),AgeBand#(lf)#(tab),[m].[AgeBand10yr]#(lf)#(tab),[m].[AgeBand5yr]#(lf)#(tab),[Locality] = CASE#(tab)WHEN [m].[LocalityName] LIKE 'North Cotswolds' THEN 'Cotswolds' #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [m].[LocalityName] LIKE 'South Cotswolds' THEN 'Cotswolds'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ELSE [m].[LocalityName] END#(lf)#(tab),[primary_care_network] = CASE WHEN [m].[NetworkName] LIKE 'Cheltenham St Paul''s' THEN 'Cheltenham St Pauls' ELSE [m].[NetworkName] END#(lf)#(tab),EthnicOriginDescription#(lf)#(tab),Gender#(lf)#(tab),PracNameCurrent = CASE#(tab)WHEN PracNameCurrent LIKE 'St. Catherine''s Surgery' THEN 'St. Catherines Surgery'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN PracNameCurrent LIKE 'St. George''s Surgery' THEN 'St. Georges Surgery'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ELSE PracNameCurrent END#(lf)#(tab),Derived_Age#(lf)#(tab),IMDcountyDecile#(lf)#(tab),[Number_of_ED_attendances] = [m].[EDonlyAETotal]#(lf)#(tab),[number_of_PC_appointments] = [m].[GPapptTotal]#(lf)#(tab),[number_of_SWAST_calls] = case when [number_of_SWAST_calls] is null then '0' else [number_of_SWAST_calls] END#(lf)#(tab),[number_of_111_calls] = [m].[111Total]#(lf)#(tab),[number_of_rapid_response] = case when [number_of_rapid_response] is null then '0' else [number_of_rapid_response] END#(lf)#(tab),[number_of_hospital_admissions] = [m].[EmergencyAdmTotal]#(lf)#(tab),[number_of_MIU_attendances] = [m].[EDonlyMIUTotal]#(lf)#(tab),[number_of_OOH_appointments] = case when [number_of_OOH_appointments] is null then '0' else [number_of_OOH_appointments] END#(lf)#(tab),[number_of_waiting_lists]#(lf)#(tab),[ObesityDerived]#(lf)    ,[SmokerDerived]#(lf)    ,[AsthmaDerived]#(lf)    ,[COPDDerived]#(lf)    ,[DementiaDerived]#(lf)    ,[DepressionDerived]#(lf)    ,[DiabetesDerived]#(lf)    ,[PalliativeCareDerived]#(lf)    ,[ChronicKidneyDiseaseDerived]#(lf)    ,[EpilepsyDerived]#(lf)    ,[HeartFailureDerived]#(lf)    ,[StrokeDerived]#(lf)    ,[AtrialFibrillationDerived]#(lf)    ,[CancerDerived]#(lf)    ,[CoronaryHeartDiseaseDerived]#(lf)    ,[HypertensionDerived]#(lf)    ,[HypothyroidismDerived]#(lf)    ,[LearningDisabilityDerived]#(lf)    ,[MentalIllnessDerived]#(lf)#(tab),Frailty_Type = CASE WHEN Frailty_Type IS NULL THEN 'No rockwood score recorded' else Frailty_Type END#(lf)#(lf)#(lf)  FROM #WL_tbl [W]#(lf)  #(lf)  LEFT JOIN [BIReports].[MPI].[MPI_current] [m] ON [m].[Derived_Pseudo_NHS] = [W].[Pseudo_NHS_Number]#(lf)#(lf)  LEFT JOIN #SWAST [S] ON [S].Pseudo_NHS_Number = [W].[Pseudo_NHS_Number]#(lf)  LEFT JOIN #Rapid_Response [RR] ON [RR].Pseudo_NHS_Number = [W].[Pseudo_NHS_Number]#(lf)  LEFT JOIN #OOH [O] ON [O].Pseudo_NHS_Number = [W].[Pseudo_NHS_Number]#(lf)#(lf)  LEFT JOIN #number_waiting_lists [N] ON [N].[Pseudo_NHS_Number] = [W].[Pseudo_NHS_Number]#(lf)  LEFT JOIN #rockwood [RW] ON [RW].PseudoNHSNumber = [W].[Pseudo_NHS_Number]#(lf)#(lf)  order by Pseudo_NHS_Number#(lf)#(lf)  "]),
