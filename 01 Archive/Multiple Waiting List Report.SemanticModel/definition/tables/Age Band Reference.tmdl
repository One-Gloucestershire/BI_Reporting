	partition 'Age Band Reference' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Reference", [Query="/****** Script for SelectTopNRows command from SSMS  ******/#(lf)SELECT [Age]#(lf)      ,[5YR_Age_Band]#(lf)      ,[10YR_Age_Band]#(lf)      ,[PBR_Age_Band]#(lf)      ,[Standard_Age_Band]#(lf)      ,[Risk_Strat_Age_Band]#(lf)      ,[Risk_Strat_Age_BandInt]#(lf)      ,[Adult_Age_Band]#(lf)      ,[5YR_Age_Band_Order]#(lf)#(tab)  ,[AgeBandFlag] = CASE WHEN [Age] BETWEEN 0 AND 17 THEN 'Children and Young People (0-17)'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [Age] BETWEEN 18 AND 64 THEN 'Working Age Adults (18-64)'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [Age] > 64 THEN 'Older Adults (65+)'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)END#(lf)  FROM [CCG_Reference].[Reference].[vw_AgeBand]"])
				in
				    Source

	annotation PBI_ResultType = Table

