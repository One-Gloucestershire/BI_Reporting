	partition Query1 = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "powerbi_reporting", [Query=" SELECT [Metric] = 'Population'#(lf)        ,[Value] = COUNT(*)#(lf)#(tab)#(tab),[POP].[Gender]#(lf)#(tab)#(tab),[Age] = [AGE].[5YR_Age_Band]#(lf)#(tab)#(tab),[AGE].[CYP_Flag]#(lf)#(tab)#(tab),[Deprivation] = [POP].[IMDNationalDecile]#(lf)#(tab)#(tab),[Ethnicity] = [ETH].[Ethnic Origin Grouped]#(lf)#(tab)#(tab),[Practice_Code] = [POP].[PrimaryCareProvider]#(lf)#(tab)#(tab),[YearMonth] = [DATE].[YearMonth]#(lf)#(tab)#(tab),[POP].[QOF_LD_Flag]#(lf)#(lf)  FROM [PowerBI_Reporting].[AgeingWell].[tbl02_Proactive_Whiteboard_Registered_Population_Over_Time] AS [POP]#(lf)#(lf)  LEFT JOIN (#(lf)             SELECT DISTINCT [Age]#(lf)             ,[5YR_Age_Band]#(lf)             ,[CYP_Flag] = CASE WHEN [Age] BETWEEN 0 AND 17 THEN '0-17'#(lf)                                WHEN [Age] >= 18 THEN '18+'#(lf)#(tab)#(tab)#(tab)  ELSE NULL END#(lf)             FROM [CCG_Reference].[Reference].[vw_AgeBand]#(lf)             WHERE [Age] BETWEEN 0 AND 120#(lf)#(tab)  ) AS [AGE]#(lf)  ON [AGE].[Age] = [POP].[Age_at_census] /* Joining in Age Banding */#(lf)#(lf)  LEFT JOIN (#(lf)             SELECT DISTINCT [Ethnic Origin]#(lf)#(tab)#(tab)#(tab)                ,[Ethnic Origin Grouped]#(lf)#(tab)#(tab)#(tab) FROM [BIReports].[MPI].[Ethnicity_Table]#(lf)#(tab)#(tab)#(tab) ) AS [ETH]#(lf)  ON [ETH].[Ethnic Origin] = [POP].[Ethnicity_code] /* Joining in Ethnicity grouping */#(lf)#(lf)  LEFT JOIN (#(lf)             SELECT DISTINCT [date]#(lf)#(tab)#(tab)#(tab)                ,[YearMonth]#(lf)#(tab)#(tab)#(tab) FROM [CCG_Reference].[Reference].[vw_DateLookup]#(lf)#(tab)#(tab)#(tab) ) AS [DATE]#(lf)  ON [DATE].[Date] = [POP].[Census_Date] /* Joining in YearMonth */#(lf)#(lf)  WHERE [POP].[Derived_Registered_CCG] = '11M'#(lf)  AND [POP].[Census_Date] >= '20190401'#(lf)#(lf)  GROUP BY [POP].[Gender], [AGE].[5YR_Age_Band], [AGE].[CYP_Flag], [POP].[IMDNationalDecile] #(lf)          ,[ETH].[Ethnic Origin Grouped], [POP].[PrimaryCareProvider], [DATE].[YearMonth], [POP].[QOF_LD_Flag]"])
				in
				    Source

	annotation PBI_ResultType = Table

