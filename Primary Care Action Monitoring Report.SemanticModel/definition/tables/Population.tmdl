table Population
	lineageTag: 82fa4a6b-efcc-4d3e-81b2-40895ef57983

	measure 'Total Population' =
			
			
			SUM('Population'[population])
		lineageTag: 67b25154-c919-4eaa-970f-4ce142e0f902

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Trendline Gap' =
			
			
			[Crude Rate per 1,000 Mean] - [Latest Trendline]
		lineageTag: f6e7ff3b-acfe-4062-8b59-90ac88394767

		annotation PBI_FormatHint = {"isGeneralNumber":true}

