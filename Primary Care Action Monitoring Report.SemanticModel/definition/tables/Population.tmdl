	column Week_Start
		dataType: dateTime
		formatString: General Date
		lineageTag: 5460a475-5c87-40d8-a4fe-0da8363d91a0
		summarizeBy: none
		sourceColumn: Week_Start

		annotation SummarizationSetBy = Automatic

	partition Population = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "PowerBI_Reporting", [Query="#(lf)SELECT DISTINCT [locality]#(lf)               ,[primary_care_network]#(lf)               ,[practice_name]#(lf)#(tab)#(tab)#(tab)   ,[practice_code]#(lf)               ,[age_band] = CASE WHEN [age_band] IN ('85-89', '90-94', '95+') THEN '85+' ELSE [age_band] END#(lf)#(tab)#(tab)#(tab)   ,[sex]#(lf)#(tab)#(tab)#(tab)   ,[population]#(lf)               ,[gp_longitude]#(lf)               ,[gp_latitude]#(lf)#(tab)#(tab)#(tab)   ,[DATE].[Week_Start]#(lf)#(lf)  FROM [PowerBI_Reporting].[dbo].[GP_Practice_Populations] AS [GPP]#(lf)#(lf)  LEFT JOIN (SELECT DISTINCT [MonthYearName] = CONCAT([Month_Short_Name], '-', LEFT([Date_112], 4))#(lf)                            ,[Year_Month]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab),[Week_Start] = CAST([Week_Start] AS DATE)#(lf)#(tab)#(tab)#(tab) FROM [DSCRO_NATIONAL_LOOKUPS].[dbo].[ref_Dates]#(lf)#(tab)#(tab)#(tab) WHERE [Week_Start] >= [Month_Start]) AS [DATE]#(lf)  ON [DATE].[Year_Month] = [GPP].[year_month]#(lf)#(lf)  WHERE [first_date_of_month] >= '20240401'"])
				in
				    Source

	annotation PBI_ResultType = Table

