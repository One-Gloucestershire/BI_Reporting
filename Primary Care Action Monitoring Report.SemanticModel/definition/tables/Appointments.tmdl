table Appointments
	lineageTag: b67f592e-8213-4457-ab0f-08e44adf3f3b

	measure 'Appointments Mean' = ```
			
			
			VAR _SUMMARYTABLE = 
			
			SUMMARIZE(
			    ALLSELECTED('Appointments'),
			    'Appointments'[Week_Start],
			    'Appointments'[Month_Name],
			    "Mean", CALCULATE(SUM('Appointments'[Total_Appointments]), 'Appointments'[Benchmark_Months] = 1)
			)
			
			VAR _AVG = 
			
			AVERAGEX(_SUMMARYTABLE, [Mean])
			
			RETURN
			
			_AVG
			    
			```
		formatString: #,0
		lineageTag: 413201d3-d726-4a24-bde9-a8ea7adf225a

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "AveragePerCategory"
				}

		changedProperty = FormatString

	measure 'Total Appointments' =
			
			
			SUM('Appointments'[Total_Appointments])
		formatString: #,0
		lineageTag: d75f2df2-88a6-41d5-af30-e36c4ab0d54c

	measure 'Appointments STDEV' = ```
			
			
			VAR _SUMMARYTABLE = 
			
			SUMMARIZE(
			    ALLSELECTED('Appointments'),
			    'Appointments'[Week_Start],
			    'Appointments'[Month_Name],
			    "Mean", CALCULATE(SUM('Appointments'[Total_Appointments]), 'Appointments'[Benchmark_Months] = 1)
			)
			
			VAR _STDV = 
			
			STDEVX.P(
			    _SUMMARYTABLE,
			    [Mean]
			)
			
			RETURN _STDV
			    
			```
		lineageTag: 4edb9a96-0129-4ade-b262-4070f08c64cf

