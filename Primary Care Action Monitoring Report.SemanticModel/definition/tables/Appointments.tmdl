			SUMMARIZE(
			    ALLSELECTED('Date Reference'),
			    'Date Reference'[Week_Start],
			    "Rate per 1,000", CALCULATE([Crude Rate per 1,000], 'Date Reference'[Benchmark_Months] = 1)
