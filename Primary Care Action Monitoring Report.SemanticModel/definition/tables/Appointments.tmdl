	measure 'Appointments - UCL' =
			
			
			IF(([Appointments Mean] + (3*[Appointments STDEV])) < 0, 0, ([Appointments Mean] + (3*[Appointments STDEV])))
		formatString: #,0
		lineageTag: eba63105-a206-43b0-8d72-9bcd833d8c51

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Appointments - LCL' =
			
			
			IF(([Appointments Mean] - (3*[Appointments STDEV])) < 0, 0, ([Appointments Mean] - (3*[Appointments STDEV])))
		formatString: #,0
		lineageTag: 4e36bf20-dc35-43a5-8944-2472230388b9

		annotation PBI_FormatHint = {"isDecimal":true}

	measure '% F2F' =
			
			
			VAR _F2F = CALCULATE(SUM('Appointments'[Total_Appointments]), 'Appointments'[Contact_Type] = "Face-to-Face")
			
			RETURN
			
			_F2F/[Total Appointments]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 1c9f4a81-aa23-4f63-8b32-aebb379d630d

	measure '% Telephone' =
			
			
			VAR _TELE = CALCULATE(SUM('Appointments'[Total_Appointments]), 'Appointments'[Contact_Type] = "Telephone")
			
			RETURN
			
			_TELE/[Total Appointments]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 3ca78e04-f8f0-4dd0-b988-282354454cd5

	measure 'Appointment % F2F Trendline' = ```
			
			
			VAR Temp_Table = 
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED( 'Appointments'[Month_Name], 'Appointments'[Week_Start], 'Appointments'[Week Number], 'Appointments'[financial_month] ),
			            "Value_x", 'Appointments'[Week Number],
			            "Value_y", 'Appointments'[% F2F]
			        ),
			        AND (
			            NOT ( ISBLANK ( "Value_x" ) ),
			            NOT ( ISBLANK ( "Value_y" ) )
			        )
			    )
			
			VAR LINESTX_Table = 
			    LINESTX(Temp_Table, [Value_y], [Value_x], TRUE)
			VAR Slope = 
			    MAXX ( LINESTX_Table, [Slope1] )
			VAR Intercept = 
			    MAXX ( LINESTX_Table, [Intercept] )
			
			RETURN
			    IF(SUMX (
			        DISTINCT ( 'Appointments'[Week Number] ),
			        Intercept + Slope * 'Appointments'[Week Number]
			    ) < 0, BLANK(), 
			    SUMX (
			        DISTINCT ( 'Appointments'[Week Number] ),
			        Intercept + Slope * 'Appointments'[Week Number]
			    )
			    )
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 7fc346a3-0ee2-4fd5-a5fc-b531d892f32c

