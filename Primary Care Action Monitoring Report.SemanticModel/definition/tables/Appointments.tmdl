	measure '% F2F Mean' =
			
			
			VAR _F2F = CALCULATE(SUM('Appointments'[Total_Appointments]), 'Appointments'[Contact_Type] = "Face-to-Face", ALL('Appointments'[Week_Start]), 'Appointments'[Benchmark_Months] = 1)
			
			VAR _TOTAL = CALCULATE(SUM('Appointments'[Total_Appointments]), ALL('Appointments'[Week_Start]), 'Appointments'[Benchmark_Months] = 1)
			
			VAR _MONTHS = CALCULATE(DISTINCTCOUNT('Appointments'[Week Number]), 'Appointments'[Benchmark_Months] = 1)
			
			RETURN
			
			_F2F/_TOTAL
		lineageTag: be2d4bd7-c746-4e97-8e59-a56c60e7f68f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% F2F Benchmark' =
			
			
