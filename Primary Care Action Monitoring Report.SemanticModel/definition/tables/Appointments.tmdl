	partition Appointments = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Current", [Query="#(lf)  SET NOCOUNT ON#(lf)  SET ANSI_WARNINGS OFF#(lf)  IF OBJECT_ID('TEMPDB..#TEMP_GPAPP') IS NOT NULL DROP TABLE #TEMP_GPAPP#(lf)  ;#(lf)#(lf)  SELECT DISTINCT [ID]#(lf)#(tab)#(tab)#(tab)#(tab) ,[Locality] = CASE WHEN [Locality] LIKE '%Cotswolds' THEN 'Cotswolds' #(lf)#(tab)#(tab)#(tab)#(tab)                    WHEN [Practice_Code] LIKE 'Y05212' THEN 'Tewkesbury'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ELSE [Locality] END#(lf)#(tab)#(tab)#(tab)#(tab) ,[PrimaryCareNetwork] = CASE WHEN [PrimaryCareNetwork] LIKE 'Tewkesbury, Newent and Staunton and West Cheltenham Medical' THEN 'TWNS'#(lf)#(tab)#(tab)#(tab)#(tab)                              WHEN [Practice_Code] LIKE 'Y05212' THEN 'TWNS'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)  ELSE [PrimaryCareNetwork] END#(lf)#(tab)#(tab)#(tab)#(tab) ,[Practice_Code]#(lf)#(tab)#(tab)#(tab)#(tab) ,[PracticeDescription]#(lf)#(tab)#(tab)#(tab)#(tab) ,[Benchmark_Months] = CASE WHEN CAST([Appointment_Date] AS DATE) BETWEEN '20240101' AND '20240731' THEN 1 ELSE 0 END#(lf)#(tab)#(tab)#(tab)#(tab) ,[Appointment_Date] = CAST([Appointment_Date] AS DATE)#(lf)#(tab)#(tab)#(tab)#(tab) ,[DATE].[Week_Start]#(lf)#(tab)#(tab)#(tab)#(tab) ,[MONTH].[Month_Name]#(lf)#(tab)#(tab)#(tab)#(tab) ,[DATE].[Working_Day_Calc]#(lf)#(tab)#(tab)#(tab)#(tab) ,[MONTH].[financial_month]#(lf)#(tab)#(tab)#(tab)#(tab) ,[Contact_Type] = CASE WHEN [Appointment_Status] LIKE 'Face to Face%' THEN 'Face-to-Face'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)            WHEN [Appointment_Status] LIKE 'Telephone%' THEN 'Telephone'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ELSE NULL END#(lf)#(lf)  INTO #TEMP_GPAPP#(lf)  FROM [CCG_Current].[PrimaryCare].[vw_Appointments] AS [GP]#(lf)#(lf)  LEFT JOIN (#(lf)             SELECT DISTINCT [Date] = CAST([D1].[Full_Date] AS DATE)#(lf)#(tab)#(tab)#(tab)#(tab)            ,[Week_Start] = CAST([D1].[Week_Start] AS DATE)#(lf)#(tab)#(tab)#(tab)#(tab)            ,[D2].[Working_Day_Calc]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab),[D1].[Month_Start]#(lf)             FROM [DSCRO_NATIONAL_LOOKUPS].[dbo].[ref_Dates] AS [D1]#(lf)#(tab)#(tab)#(tab) LEFT JOIN (#(lf)#(tab)#(tab)#(tab)            SELECT DISTINCT [Week_Start] = CAST([Week_Start] AS DATE)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)               ,[Working_Day_Calc] = SUM([Working_Day_Calc])#(lf)#(tab)#(tab)#(tab)            FROM [DSCRO_NATIONAL_LOOKUPS].[dbo].[ref_Dates]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHERE CAST([Full_Date] AS DATE) >= '20240401'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)GROUP BY [Week_Start]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)) AS [D2]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ON [D2].[Week_Start] = [D1].[Week_Start]#(lf)#(tab)#(tab)#(tab) WHERE CAST([Full_Date] AS DATE) >= '20240401'#(lf)            ) AS [DATE]#(lf)  ON [DATE].[Date] = CAST([GP].[Appointment_Date] AS DATE)#(lf)#(lf)  LEFT JOIN (SELECT DISTINCT [Full_Date]#(lf)                            ,[Month_Name] = LEFT([Month_Name], 3)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab),[financial_month] = [Fin_Month_No]#(lf)             FROM [DSCRO_NATIONAL_LOOKUPS].[dbo].[ref_Dates]) AS [MONTH]#(lf)#(tab)#(tab)#(tab) ON [MONTH].[Full_Date] = [DATE].[Week_Start]#(lf)#(lf)  WHERE [Is_Cancelled] = 'f'#(lf)  AND ([Appointment_Status] LIKE 'Face to Face%'#(lf)  OR [Appointment_Status] LIKE 'Telephone%')#(lf)  AND [Appointment_Status] NOT IN ('Face to Face - Did Not Attend', 'Face to Face - Booked', 'Face to Face - Patient Walked Out'#(lf)                                  ,'Face to Face - Waiting', 'Telephone - Booked', 'Telephone - Did Not Attend', 'Telephone - In Progress'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)  ,'Telephone - Patient Walked Out', 'Telephone - Waiting')#(lf)  AND CAST([Appointment_Date] AS DATE) >= '20240401'#(lf)  AND [Locality] IS NOT NULL#(lf)  ;#(lf)#(lf)  SELECT [Total_Appointments] = COUNT(DISTINCT([ID]))/[Working_Day_Calc]#(lf)        ,[Locality]#(lf)#(tab)#(tab),[PrimaryCareNetwork]#(lf)#(tab)#(tab),[Practice_Code]#(lf)#(tab)#(tab),[PracticeDescription]#(lf)#(tab)#(tab),[Benchmark_Months]#(lf)#(tab)#(tab),[Week_Start]#(lf)#(tab)#(tab),[Month_Name]#(lf)#(tab)#(tab),[financial_month]#(lf)#(tab)#(tab),[Contact_Type]#(lf)#(lf)  FROM #TEMP_GPAPP#(lf)#(lf)  GROUP BY [Locality]#(lf)#(tab)#(tab)  ,[PrimaryCareNetwork]#(lf)#(tab)#(tab)  ,[Practice_Code]#(lf)#(tab)#(tab)  ,[PracticeDescription]#(lf)#(tab)#(tab)  ,[Benchmark_Months]#(lf)#(tab)#(tab)  ,[Week_Start]#(lf)#(tab)#(tab)  ,[Month_Name]#(lf)#(tab)#(tab)  ,[financial_month]#(lf)#(tab)#(tab)  ,[Working_Day_Calc]#(lf)#(tab)#(tab)  ,[Contact_Type]#(lf)#(lf)  ORDER BY [Week_Start] DESC "])
				in
