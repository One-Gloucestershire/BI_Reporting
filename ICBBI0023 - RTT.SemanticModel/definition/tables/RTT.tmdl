	measure zTest = CALCULATE(STDEV.P([% < 18 Weeks]), DATESBETWEEN('RTT'[Period], "01 April 2018" , "01 December 2020"))
		lineageTag: d8fbafb5-4583-49d1-bf03-17a5b43e944b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ztestsumforavg = CALCULATE(average((RTT[% < 18 Weeks])), DATESBETWEEN('RTT'[Period],  DATE(2021, 04, 01) , DATE(2023, 03, 01)))
		lineageTag: f3bb4bd4-4f52-4b21-85bb-732e12249698

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Z Upper limit' = [ztestsumforavg]+(3*[zTest])
		formatString: 0.00
		lineageTag: c0b2fdd6-8620-4889-a720-61bf2506b5f9

