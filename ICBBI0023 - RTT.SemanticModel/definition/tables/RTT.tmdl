	measure Average =
			CALCULATE(SUM('RTT'[0-18 Weeks])/[Total RTT Waiting List],
			ALLSELECTED('Date Reference'))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d4e01aba-92d6-4b4b-817e-018b25fef9b4

	measure SD = ```
			CALCULATE(STDEVX.P(VALUES('Date Reference'[MonthName]), [< 18 Weeks Total]), ALLEXCEPT('Date Reference','Date Reference'[MonthName]))
			
			```
		formatString: 0
		lineageTag: 0a5be5b0-aad8-4f85-89e3-6aba0dd33997

	measure 'Upper Limit' = [Average]+(3*[SD])
		lineageTag: 5065fdb6-08ba-4b09-aebc-acb577953370

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Lower Limit' = CALCULATE([Average]-3*[sd])
		lineageTag: dcc1f105-5e21-4e21-8997-e66845b7f9e6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Breaches > 48 Weeks' = sum('RTT'[48-49 Weeks])+SUM('RTT'[49-50 Weeks])+sum('RTT'[50-51 Weeks])+sum('RTT'[51-52 Weeks])+sum('RTT'[> 52 Weeks])
		formatString: 0
		lineageTag: b9e52bfa-8068-44f3-8bd2-64ce568836db

