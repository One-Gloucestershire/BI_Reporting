	partition Population = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "select sum(1) as ""counter"", a.districtdescription as ""DistrictDescription"", b.lsoacode as ""LSOACode"" from data_mart_pls.vw_summary a left join data_mart_pls.vw_imd_and_geography b on a.pseudonhsnumber=b.pseudonhsnumber where a.icbofregistration='11M' and a.districtdescription in ('Cheltenham','Cotswold','Gloucester','Forest of Dean','Stroud','Tewkesbury') group by a.districtdescription, b.lsoacode order by 1", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

