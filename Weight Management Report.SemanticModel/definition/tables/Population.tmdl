table Population
	lineageTag: 3df6ed91-b5ad-4485-bb6e-34ce1132dc31

	column counter
		dataType: int64
		formatString: 0
		lineageTag: cee92d36-0836-433d-8141-f18f66fa2a56
		summarizeBy: none
		sourceColumn: counter

		annotation SummarizationSetBy = Automatic

	column DistrictDescription
		dataType: string
		lineageTag: 56122e61-f46d-43c0-bebb-1a625db0d603
		summarizeBy: none
		sourceColumn: DistrictDescription

		annotation SummarizationSetBy = Automatic

	column LSOACode
		dataType: string
		lineageTag: ef47a179-3e2e-4658-9663-088dfadb3449
		summarizeBy: none
		sourceColumn: LSOACode

		annotation SummarizationSetBy = Automatic

	partition Population = m
		mode: import
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "BIReports", [Query="SELECT sum(1) as [counter], [a].DistrictDescription ,[b].LSOACode#(lf)FROM [ICB_Products].[Patient].[vw_Summary] [a]#(lf)  LEFT JOIN ICB_Products.Patient.vw_IMD_and_Geography [b] on [a].PseudoNHSNumber = [b].PseudoNHSNumber#(lf)where ICBofRegistration = '11m' and [a].DistrictDescription IN (#(lf)'Cheltenham',#(lf)'Cotswold',#(lf)'Gloucester',#(lf)'Forest of Dean',#(lf)'Stroud',#(lf)'Tewkesbury')#(lf)group by [a].DistrictDescription,[b].LSOACode#(lf)ORDER BY [counter]"])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

