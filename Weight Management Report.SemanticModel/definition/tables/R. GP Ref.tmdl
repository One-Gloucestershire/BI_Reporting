		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "PowerBI_Reporting", [Query="WITH GP_CTE AS#(lf)#(lf)(#(lf)#(lf)SELECT [PCN] = CASE WHEN [ReportingOrganisationName] LIKE 'West Cheltenham Medical' THEN 'TWNS'#(lf)#(lf)#(tab)          WHEN [PrimaryCareNetwork] LIKE 'Tewkesbury, Newent and Staunton and West Cheltenham Medical' THEN 'TWNS'#(lf)#(lf)                    ELSE [PrimaryCareNetwork] END#(lf)#(lf)      ,[Locality] = CASE WHEN [ReportingOrganisationName] LIKE 'West Cheltenham Medical' THEN 'Tewkesbury Newent and Staunton'#(lf)#(lf)                         ELSE [Locality] END#(lf)#(lf)      ,[OrganisationCode]#(lf)#(lf)      ,[ReportingOrganisationCode] = CASE WHEN [ReportingOrganisationCode] LIKE 'L84073' THEN 'L84075' /*Acorn Practice*/#(lf)#(lf)#(tab)                                WHEN [ReportingOrganisationCode] LIKE 'L84017' THEN 'L84018' /*Cirencester Health Group*/#(lf)#(lf)#(tab)                                ELSE [ReportingOrganisationCode] END #(lf)#(lf)      ,[ReportingOrganisationName] = CASE WHEN [ReportingOrganisationName] LIKE 'Acorn Practice' THEN 'May Lane Surgery' #(lf)#(lf)#(tab)                                WHEN [ReportingOrganisationName] LIKE 'Regent Street Surgery' THEN 'The Willow Tree Practice'#(lf)#(lf)#(tab)                                WHEN [ReportingOrganisationName] LIKE 'Coleford Family Doctors' THEN 'Coleford Medical Practice'#(lf)#(lf)#(tab)                                ELSE [ReportingOrganisationName] END#(lf)#(tab)#(tab),[Population]#(lf) #(lf)FROM [CCG_Reference].[Reference].[vw_GPPractice] [a]#(lf)LEFT JOIN (select sum([Total]) as [Population], OrganisationCode as OrganisationCode2#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)from [CCG_Reference].[Reference].[vw_GPPracticePopulation] [a]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)left join [CCG_Reference].[Reference].[vw_DateLookup] [dat] on left([a].CensusDate,3) = left([dat].MonthYearName,3) and #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)right([a].CensusDate,2) = right([dat].[Year],2) and#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)[dat].[day] = 1#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)where AgeGroupType = 'Group 1' and [dat].[FirstDateofMonth] = #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)(select max([FirstDateofMonth]) #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)from [CCG_Reference].[Reference].[vw_GPPracticePopulation] [a]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)left join [CCG_Reference].[Reference].[vw_DateLookup] [dat] on left([a].CensusDate,3) = left([dat].MonthYearName,3) and #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)right([a].CensusDate,2) = right([dat].[Year],2) and#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)[dat].[day] = 1#(lf)#(tab)#(tab)#(tab)#(tab)#(tab))#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)group by OrganisationCode) [pop] on [a].OrganisationCode = [pop].OrganisationCode2#(lf)#(lf)WHERE [Commissioner] = '11M'#(lf)#(lf)AND [Locality] IS NOT NULL#(lf)#(lf))#(lf)#(lf)SELECT [GP].*#(lf)#(lf)      ,[COORD].[GPLatitude]#(lf)#(lf)      ,[COORD].[GPLongitude]#(lf) #(lf)FROM GP_CTE AS [GP]#(lf) #(lf)LEFT JOIN (#(lf)#(lf)           SELECT DISTINCT [GP_Practice_Code]#(lf)#(lf)                          ,[GPLatitude]#(lf)#(lf)#(tab)#(tab)      ,[GPLongitude]#(lf)#(lf)           FROM [PowerBI_Reporting