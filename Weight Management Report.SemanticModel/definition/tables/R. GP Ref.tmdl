	partition 'R. GP Ref' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db01_reference"), "with gp as (select case when reportingorganisationname='West Cheltenham Medical' then 'TWNS' when primarycarenetwork='Tewkesbury, Newent and Staunton and West Cheltenham Medical' then 'TWNS' else primarycarenetwork end as ""PCN"", case when reportingorganisationname='West Cheltenham Medical' then 'Tewkesbury Newent and Staunton' else locality end as ""Locality"", organisationcode as ""OrganisationCode"", case when reportingorganisationcode='L84073' then 'L84075' when reportingorganisationcode='L84017' then 'L84018' else reportingorganisationcode end as ""ReportingOrganisationCode"", case when reportingorganisationname='Acorn Practice' then 'May Lane Surgery' when reportingorganisationname='Regent Street Surgery' then 'The Willow Tree Practice' when reportingorganisationname='Coleford Family Doctors' then 'Coleford Medical Practice' else reportingorganisationname end as ""ReportingOrganisationName"", pop.""Population"" from icb_data_reference.vw_gppractice a left join (select practice_code, sum(population) as ""Population"" from db02_nopid.data_mart_primarycare.tbl01_gp_practice_populations where first_date_of_month=(select max(first_date_of_month) from db02_nopid.data_mart_primarycare.tbl01_gp_practice_populations) group by practice_code) pop on a.organisationcode=pop.practice_code where a.commissioner ilike '11m%' and a.locality is not null) select gp.*, c.gplatitude as ""GPLatitude"", c.gplongitude as ""GPLongitude"" from gp left join (select distinct gp_practice_code, gplatitude, gplongitude from db02_nopid.data_mart_powerbi_phm.tbl02_demographicsoverview) c on c.gp_practice_code=gp.""ReportingOrganisationCode""", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

