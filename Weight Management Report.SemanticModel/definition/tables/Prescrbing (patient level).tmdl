table 'Prescrbing (patient level)'
	lineageTag: 33fd7b68-5ced-400a-8740-e823d675bd01

	measure Items = if(sum('Prescrbing (patient level)'[Item_Count])=BLANK(),0,sum('Prescrbing (patient level)'[Item_Count]))
		formatString: 0
		lineageTag: 96e5d109-64f0-4d01-a8de-441e9ee0a3d7

	measure Cost = if(sum('Prescrbing (patient level)'[Item_Actual_Cost])=BLANK(),0,sum('Prescrbing (patient level)'[Item_Actual_Cost]))
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 47323277-ee3e-4813-92cc-8b3b9a0626ec

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure a1_Obese_Not_Diabetic =
			
			CALCULATE(
			    SUM('Prescrbing (patient level)'[Item_Actual_Cost]),
			    'Prescrbing (patient level)'[BMI Group] IN{"Obese (30+)","Obese (30-34.9)","Obese (35-39.9)","Severely Obese (40+)"},
			    'Prescrbing (patient level)'[Diabetes Type] = "Not Diabetic",
			    'Date table (month start)'[FinancialYear] = "2025/26"
			)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: ed4957de-b66e-46f3-b8aa-60ea7d8d9616

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure a2_Obese_Diabetic =
			
			CALCULATE(
			    SUM('Prescrbing (patient level)'[Item_Actual_Cost]),
			    'Prescrbing (patient level)'[BMI Group] IN{"Obese (30+)","Obese (30-34.9)","Obese (35-39.9)","Severely Obese (40+)"},
			    'Prescrbing (patient level)'[Diabetes Type] <> "Not Diabetic",
			    'Date table (month start)'[FinancialYear] = "2025/26"
			)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 2d2a0580-d7c2-4cfe-96b6-e5e64da3c19c

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure a3_Not_Obese_Diabetic =
			
			CALCULATE(
			    SUM('Prescrbing (patient level)'[Item_Actual_Cost]),
			    NOT'Prescrbing (patient level)'[BMI Group] IN{"Obese (30+)","Obese (30-34.9)","Obese (35-39.9)","Severely Obese (40+)"},
			    'Prescrbing (patient level)'[Diabetes Type] <> "Not Diabetic",
			    'Date table (month start)'[FinancialYear] = "2025/26"
			)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 09a8016b-5b38-4d7a-ae30-34c329c19e9c

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure a4_Not_Obese_Not_Diabetic =
			
			CALCULATE(
			    SUM('Prescrbing (patient level)'[Item_Actual_Cost]),
			    NOT'Prescrbing (patient level)'[BMI Group] IN{"Obese (30+)","Obese (30-34.9)","Obese (35-39.9)","Severely Obese (40+)"},
			    'Prescrbing (patient level)'[Diabetes Type] = "Not Diabetic",
			    'Date table (month start)'[FinancialYear] = "2025/26"
			)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 035b60f1-4788-442e-92a5-ee525cfd2ea7

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Cost per Patient' =
			
			VAR Total = CALCULATE(SUM('Prescrbing (patient level)'[Item_Actual_Cost]))
			VAR Pop = CALCULATE(SUM('R. GP Ref'[Population]))
			RETURN (Total/Pop)
		formatString: 0
		lineageTag: f07bf3b0-2f69-465e-9af7-7d2a11fe16a8

