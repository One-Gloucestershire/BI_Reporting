	partition 'Tirzepatide Cohorts' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "PowerBI_Reporting", [Query="select *#(lf)from [PowerBI_Reporting].[WeightManagement].[tbl05_Tirzepatide_Cohorts]#(lf)where [Cohort] is not null"]),
				    #"Replaced Value" = Table.ReplaceValue(Source,null,"Not Prescribed",Replacer.ReplaceValue,{"Already on WL Drug"})
				in
				    #"Replaced Value"

