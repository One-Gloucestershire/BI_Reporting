table 'Tirzepatide Cohorts'
	lineageTag: 4fade908-f43c-4203-98fc-119e0a040cd8

	measure PrescribingStartFlag
		lineageTag: 2fd64806-38ab-4848-b47d-70c6f5af6243

	measure %_Patients_Prescribed_Tirzep =
			
			VAR Numerator = calculate(count('Tirzepatide Cohorts'[Derived_NHS_Number]),'Tirzepatide Cohorts'[Already on WL Drug] = "Tirzepatide")+calculate(count('Tirzepatide Cohorts'[Derived_NHS_Number]),'Tirzepatide Cohorts'[Already on WL Drug] = "Tirzepatide  -National Programme")
			VAR Denominator = calculate(count('Tirzepatide Cohorts'[Derived_NHS_Number]))
			
			RETURN Numerator/Denominator
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 5ab88ba7-cad7-492b-b08b-3928b7fa8e78

	measure Title_Elidgible_TZ_Chart =
			
			VAR CohortSelected =
			    SELECTEDVALUE(
			        'Tirzepatide Cohorts'[Cohort],
			        "All Cohorts"
			    )
			RETURN
			"Total " & CohortSelected&" Patients: By Prescription Type"
		lineageTag: df1decd0-3392-4f89-aee9-169f24552bdc

	measure Patients = if(calculate(count('Tirzepatide Cohorts'[Derived_NHS_Number]))=0,0,calculate(count('Tirzepatide Cohorts'[Derived_NHS_Number])))
		formatString: 0
		lineageTag: fbe58403-ea11-4002-b62f-fd234dfa287a

