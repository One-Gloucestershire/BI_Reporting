	measure 'Cohort Condition %' =
			
			SWITCH(
			    SELECTEDVALUE(
			        Conditions[Condition]),
			    "Obesity",    DIVIDE(SUMX(FILTER('Cohort Analysis', 'Cohort Analysis'[Obesity] = 1), 'Cohort Analysis'[counter]), SUM('Cohort Analysis'[counter])),
			    "Smoker",    DIVIDE(SUMX(FILTER('Cohort Analysis', 'Cohort Analysis'[Smoker] = 1), 'Cohort Analysis'[counter]), SUM('Cohort Analysis'[counter])),
			    "Asthma",      DIVIDE(SUMX(FILTER('Cohort Analysis', 'Cohort Analysis'[Asthma] = 1), 'Cohort Analysis'[counter]), SUM('Cohort Analysis'[counter])),
			    "COPD",        DIVIDE(SUMX(FILTER('Cohort Analysis', 'Cohort Analysis'[COPD] = 1), 'Cohort Analysis'[counter]), SUM('Cohort Analysis'[counter])),
			    "Dementia",    DIVIDE(SUMX(FILTER('Cohort Analysis', 'Cohort Analysis'[Dementia] = 1), 'Cohort Analysis'[counter]), SUM('Cohort Analysis'[counter])),
			    "Depression",    DIVIDE(SUMX(FILTER('Cohort Analysis', 'Cohort Analysis'[Depression] = 1), 'Cohort Analysis'[counter]), SUM('Cohort Analysis'[counter])),
			    "Diabetes",    DIVIDE(SUMX(FILTER('Cohort Analysis', 'Cohort Analysis'[Diabetes] = 1), 'Cohort Analysis'[counter]), SUM('Cohort Analysis'[counter])),
			    "PalliativeCare",    DIVIDE(SUMX(FILTER('Cohort Analysis', 'Cohort Analysis'[PalliativeCare] = 1), 'Cohort Analysis'[counter]), SUM('Cohort Analysis'[counter])),
			    "ChronicKidneyDisease",    DIVIDE(SUMX(FILTER('Cohort Analysis', 'Cohort Analysis'[ChronicKidneyDisease] = 1), 'Cohort Analysis'[counter]), SUM('Cohort Analysis'[counter])),
			    "Epilepsy",    DIVIDE(SUMX(FILTER('Cohort Analysis', 'Cohort Analysis'[Epilepsy] = 1), 'Cohort Analysis'[counter]), SUM('Cohort Analysis'[counter])),
			    "HeartFailure",    DIVIDE(SUMX(FILTER('Cohort Analysis', 'Cohort Analysis'[HeartFailure] = 1), 'Cohort Analysis'[counter]), SUM('Cohort Analysis'[counter])),
			    "Stroke",    DIVIDE(SUMX(FILTER('Cohort Analysis', 'Cohort Analysis'[Stroke] = 1), 'Cohort Analysis'[counter]), SUM('Cohort Analysis'[counter])),
			    "AtrialFibrillation",    DIVIDE(SUMX(FILTER('Cohort Analysis', 'Cohort Analysis'[AtrialFibrillation] = 1), 'Cohort Analysis'[counter]), SUM('Cohort Analysis'[counter])),
			    "Cancer",    DIVIDE(SUMX(FILTER('Cohort Analysis', 'Cohort Analysis'[Cancer] = 1), 'Cohort Analysis'[counter]), SUM('Cohort Analysis'[counter])),
			    "CoronaryHeartDisease",    DIVIDE(SUMX(FILTER('Cohort Analysis', 'Cohort Analysis'[CoronaryHeartDisease] = 1), 'Cohort Analysis'[counter]), SUM('Cohort Analysis'[counter])),
			    "Hypertension",    DIVIDE(SUMX(FILTER('Cohort Analysis', 'Cohort Analysis'[Hypertension] = 1), 'Cohort Analysis'[counter]), SUM('Cohort Analysis'[counter])),
			    "LearningDisability",    DIVIDE(SUMX(FILTER('Cohort Analysis', 'Cohort Analysis'[LearningDisability] = 1), 'Cohort Analysis'[counter]), SUM('Cohort Analysis'[counter])),
			    "MentalIllness",    DIVIDE(SUMX(FILTER('Cohort Analysis', 'Cohort Analysis'[MentalIllness] = 1), 'Cohort Analysis'[counter]), SUM('Cohort Analysis'[counter])))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: dab77f03-1f84-47f9-929c-7ab91defac81

	measure 'ICB Condition %' =
			
			SWITCH(
			    SELECTEDVALUE(Conditions[Condition]),
			    "Obesity",
			        DIVIDE(
			            CALCULATE(SUM('Cohort Analysis'[counter]), 'Cohort Analysis'[Obesity] = 1, REMOVEFILTERS('Cohort Analysis')),
			            CALCULATE(SUM('Cohort Analysis'[counter]), REMOVEFILTERS('Cohort Analysis') )
			        ),
			    "Smoker",
			        DIVIDE(
			            CALCULATE(SUM('Cohort Analysis'[counter]), 'Cohort Analysis'[Smoker] = 1, REMOVEFILTERS('Cohort Analysis')),
			            CALCULATE(SUM('Cohort Analysis'[counter]), REMOVEFILTERS('Cohort Analysis'))
			        ),
			    "Asthma",
