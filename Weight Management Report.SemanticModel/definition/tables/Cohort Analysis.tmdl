	measure BMI_Within_5_Yr_% =
			
			VAR MaximumYear = YEAR(CALCULATE(MAX('Date Table (all dates)'[date]))) --2025
			RETURN
			DIVIDE(
			    CALCULATE(
			        SUM('Cohort Analysis'[counter]),
			        MaximumYear - YEAR('Cohort Analysis'[BMI Group Date]) < 5
			    ),
			    CALCULATE(
			        SUM('Cohort Analysis'[counter]),
			        REMOVEFILTERS('Cohort Analysis'[BMI Group Date])    // remove just this filter
			    )
			)
		formatString: #,0%;-#,0%;#,0%
		displayFolder: Measures for Graphs
		lineageTag: 4e3859f7-f67e-4078-a3c2-ddc005627fae

	measure LSOA_Rate_Per_1000 = ```
			
			VAR Numerator = sum('Cohort Analysis'[counter])
			VAR Denominator = CALCULATE(sum('Cohort Analysis'[counter]),ALL(Population))
			
			RETURN 
			(Numerator/Denominator)*1000
			```
		displayFolder: Measures for Graphs
		lineageTag: 181e9aa3-2222-4b62-b11a-f32a8535459e

