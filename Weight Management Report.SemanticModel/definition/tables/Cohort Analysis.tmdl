			        REMOVEFILTERS('Ref - Gender'),
			        REMOVEFILTERS('Cohort Analysis'[LearningDisability]),
			        REMOVEFILTERS('Cohort Analysis'[MentalIllness])          -- denominator = total population
			    )
			)
			
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Measures for Graphs
		lineageTag: 983912ab-4524-4a0a-905e-541ce02b5067

