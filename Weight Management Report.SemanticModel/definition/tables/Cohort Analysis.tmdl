	measure ICB_Ethnicity = ```
			
			DIVIDE(
			    CALCULATE(
			        SUM('Cohort Analysis'[counter]),
			        REMOVEFILTERS('R. BMI Group Ref'),
			        REMOVEFILTERS('R. GP Ref'),
			        REMOVEFILTERS('Ref - IMD'),
			        REMOVEFILTERS('Ref - Age'),
			        REMOVEFILTERS('Ref - Gender'),
			        REMOVEFILTERS('Cohort Analysis'[LearningDisability]),
			        REMOVEFILTERS('Cohort Analysis'[MentalIllness])
			    ),
			    CALCULATE(
			        SUM('Cohort Analysis'[counter]),
			        REMOVEFILTERS('R. BMI Group Ref'),
			        REMOVEFILTERS('R. GP Ref'),
			        REMOVEFILTERS('Ref - Ethnicity'),
			        REMOVEFILTERS('Ref - IMD'),
