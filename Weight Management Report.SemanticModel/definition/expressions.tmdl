expression Prescribing =
		let
		    Source = Sql.Database("grh-ccg-sql", "ccg_current", [Query="SELECT [YearMonth]#(lf)#(tab)  ,[BNFSection]#(lf)#(tab)  ,[BNFParagraph]#(lf)#(tab)  ,[BNFChemicalSubstance]#(lf)      ,[Items] = SUM([Items])#(lf)#(tab)  ,[ActualCost] = SUM([ActualCost])#(lf)      ,[FiveYearsAgeBand]#(lf)#(tab)  ,[HSPracticeCode]#(lf) #(lf)  FROM [CCG_Current].[ePACT2].[vw_Extract]#(lf)#(lf)  Where (bnfpresentation like '%Semaglutide%'#(lf)or bnfpresentation like '%Orlistat%' #(lf)or BNFPresentation like '%Liraglutide%') --NICE Guideline Weight Loss Drugs#(lf)  and YearMonth >=202104#(lf)  and HSCommissioner_or_ProviderCode like '11m%'#(lf)#(lf)  GROUP BY [YearMonth]#(lf)#(tab)#(tab)  ,[BNFSection]#(lf)#(tab)#(tab)  ,[BNFParagraph]#(lf)#(tab)#(tab)  ,[BNFChemicalSubstance]#(lf)#(tab)#(tab)  ,[FiveYearsAgeBand]#(lf)#(tab)#(tab)  ,[HSPracticeCode]#(lf)#(tab)#(tab)  #(lf)#(lf)  Order by YearMonth#(lf)#(lf)#(lf)"]),
		    #"Inserted Literal" = Table.AddColumn(Source, "Literal", each "2021/04", type text)
		in
		    #"Inserted Literal"
	lineageTag: 4ecc42e8-6c3b-4221-92c2-1975e2ee24d2

