table ElectiveArchive
	lineageTag: 522a43ca-8f4e-4957-91c2-a3571ebf4f89

	measure 'Average Length of Stay old' = ```
			SUM('ElectiveArchive'[total_bed_days])/CALCULATE(SUM('ElectiveArchive'[counter]),'ElectiveArchive'[patient_classification] = "Inpatient Admission") 
			```
