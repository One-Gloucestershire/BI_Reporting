	partition ElectiveArchive-8ba02957-f424-452d-a2df-51997f930402 = m
		mode: import
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "CCG_Current", [Query="/*=================================================================#(lf)Elective Admissions Local Flow#(lf)=================================================================*/#(lf)SELECT #(lf)[source] = 'GHFT (Gloucestershire Patients)',#(lf)[financial_year] = [D].[FinancialYear],#(lf)[financial_month] = [D].[FinancialMonth],#(lf)[month_name] = LEFT([D].[MonthName],3),#(lf)[year_month] = [D].[YearMonth],#(lf)1 AS [counter],#(lf)[practice_code] = [GP].[OrganisationCode],#(lf)[practice_name] = [GP].[ReportingOrganisationName],#(lf)[locality] = [GP].[Locality],#(lf)[primary_care_network] = [GP].[PrimaryCareNetwork],#(lf)[start_date] = CAST([Start_Date_Hospital_Provider_Spell] AS DATE),#(lf)[discharge_date] = CAST([Discharge_Date_Hospital_Provider_Spell] AS DATE),#(lf)[provider_code] = [Organisation_Code_Trust],#(lf)[provider_name] = [OT].[Name],#(lf)[provider_group] = CASE WHEN [Organisation_Code_Trust] like 'RTE%' then 'Gloucestershire Hospitals NHS Foundation Trust'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [I].[OrganisationCode] IS NOT NULL THEN 'Independent Sector Provider'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ELSE 'Other NHS Provider' END,#(lf)[site_code] = CASE WHEN [A].[admitting_ward] like '%CGH%' then 'RTE01'#(lf)                   WHEN [A].[admitting_ward] LIKE '%GRH%' THEN 'RTE03'#(lf)#(tab)#(tab)#(tab)#(tab)   ELSE NULL END,#(tab)#(tab)#(tab)   #(tab)#(tab)#(tab)#(tab)#(tab) #(lf)[site_name] = CASE WHEN [A].[admitting_ward] like '%CGH%' then 'Cheltenham General Hospital'#(lf)                   WHEN [A].[admitting_ward] LIKE '%GRH%' THEN 'Gloucester Royal Hosptial'#(lf)#(tab)#(tab)#(tab)#(tab)   ELSE NULL END,#(lf)[total_bed_days] = CASE WHEN DATEDIFF(dd,[START_DATE_HOSPITAL_PROVIDER_SPELL],[DISCHARGE_DATE_HOSPITAL_PROVIDER_SPELL]) < 0 THEN 0 ELSE DATEDIFF(dd,[START_DATE_HOSPITAL_PROVIDER_SPELL],[DISCHARGE_DATE_HOSPITAL_PROVIDER_SPELL]) END,#(lf)[treatment_function_code] = [A].[LOCAL_TREATMENT_FUNCTION_CODE_AT_ADMISSION],#(lf)[treatment_function_description] = [TFC].[TreatmentFunctionDescription],#(lf)[hrg_code] = [A].[DOMINANT_HRG_CODE],#(lf)[hrg_description] = [H].[HRGCodeDescription],#(lf)[hrg_sub_chapter_description] = [H].[HRG_SubChapter_Description],#(lf)[admission_method_code] = [ADMISSION_METHOD_HOSPITAL_PROVIDER_SPELL],#(lf)[admission_method_description] = [AM].[AdmissionMethodName],#(lf)[readmission_flag] = CASE WHEN [readmission_30_day] = 'N' THEN 0 ELSE 1 END,#(lf)--[MH Admission Flag] = case  WHEN [spellPDiag] LIKE 'F%'#(tab)#(tab) THEN 1 --- Mental Health chapter#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN [spellPDiag] LIKE 'X[67]%'#(tab) THEN 1  --- Intentional Self Harm#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN [spellPDiag] LIKE 'X8[01234]%' THEN 1 --- Intentional Self Harm#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN [spellPDiag] LIKE 'X[67]%'#(tab) THEN 1  --- Intentional Self Harm     ------- These codes are usually coded in the secondary position#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN [spellPDiag] LIKE 'X8[01234]%' THEN 1  --- Intentional Self Harm#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN [spellPDiag] LIKE 'T3[6789]%'  THEN 1 --- Poisoning by drugs, medicaments and biological substances *as per PHE these last 3 codes are not recognised. This is a local definition.#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN [spellPDiag] LIKE 'T4%'#(tab)#(tab) THEN 1 --- Poisoning by drugs, medicaments and biological substances *#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN [spellPDiag] LIKE 'T50%'#(tab)#(tab) THEN 1 --- Poisoning by drugs, medicaments and biological substances *#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) ELSE 0 END,#(lf)[patient_classification_code] = [patient_classification],#(lf)[patient_classification] = CASE WHEN [patient_classification] = '1' THEN 'Inpatient Admission'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [patient_classification] = '2' THEN 'Day Case Admission'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ELSE 'Other' END#(lf)#(lf)FROM [CCG_Current].[GHFT].[vw_APC_Hospital_Provider_Spell] [A]#(lf)#(lf)LEFT JOIN [CCG_Reference].[Reference].[vw_DateLookup] [D] #(lf)       ON CAST([A].[DISCHARGE_DATE_HOSPITAL_PROVIDER_SPELL] AS DATE) = [D].[Date]#(lf)#(lf)LEFT JOIN [CCG_Reference].[Reference].[vw_TreatmentFunction] AS [TFC]#(lf)#(tab)   ON [A].[LOCAL_TREATMENT_FUNCTION_CODE_AT_ADMISSION] = [TFC].[TreatmentFunctionCode]#(lf)#(lf)LEFT JOIN [CCG_Reference].[Reference].[vw_AdmissionMethod] AS [AM]#(lf)#(tab)   ON [AM].[AdmissionMethodCode] = [A].[ADMISSION_METHOD_HOSPITAL_PROVIDER_SPELL]#(lf)#(lf)LEFT JOIN [CCG_Reference].[Reference].[vw_OrganisationTrust] AS [OT]#(lf)       ON [OT].[OrganisationCode] = LEFT([A].[ORGANISATION_CODE_TRUST],3)#(lf)#(lf)LEFT JOIN [CCG_Reference].[Reference].[vw_IndependentProvider] AS [I] #(lf)       ON [A].[Organisation_Code_Trust] = [I].[OrganisationCode]#(lf)#(lf)LEFT JOIN [CCG_Reference].[Reference].[vw_HRG] [H] #(lf)   ON [A].[DOMINANT_HRG_CODE] = [H].[HRGCode]#(lf)#(lf)LEFT JOIN(SELECT DISTINCT#(lf)#(tab)#(tab)  [OrganisationCode],#(lf)#(tab)#(tab)  [ReportingOrganisationName],#(lf)#(tab)#(tab)  [Locality],#(lf)#(tab)#(tab)  [PrimaryCareNetwork]#(lf)#(tab)#(tab)  FROM [CCG_Reference].[Reference].[vw_GPPractice]#(lf)#(tab)#(tab)  WHERE [Locality] IS NOT NULL#(lf)#(tab)#(tab)  AND StatusDescription = 'ACTIVE') AS [GP]#(lf)#(tab)#(tab)  ON [A].[ORGANISATION_CODE_REGISTERED_GENERAL_MEDICAL_PRACTICE_AT_ADMISSION_DATE] = [GP].[OrganisationCode]#(lf)#(lf)#(lf)WHERE CAST([A].[DISCHARGE_DATE_HOSPITAL_PROVIDER_SPELL] AS DATE) >= '20190401'#(lf)AND [ORGANISATION_CODE_PCT_RESPONSIBLE_AT_ADMISSION_DATE] = '11M'#(lf)AND [A].[ADMISSION_METHOD_HOSPITAL_PROVIDER_SPELL] like '1%' --- All Elective Admissions#(lf)AND [spellHRG_TFC] NOT LIKE '%424%' --- Excludes well babies#(lf)#(lf)UNION ALL #(lf)#(lf)#(lf)/*=================================================================#(lf)Elective Admissions SEM Flow #(lf)#(lf)Excludes GHT activity#(lf)=================================================================*/#(lf)SELECT #(lf)[source] = 'National (Gloucestershire Patients)',#(lf)[financial_year] = [D].[FinancialYear],#(lf)[financial_month] = [D].[FinancialMonth],#(lf)[month_name] = LEFT([D].[MonthName],3),#(lf)[year_month] = [D].[YearMonth],#(lf)1 AS [counter],#(lf)[practice_code] = [GP].[OrganisationCode],#(lf)[practice_name] = [GP].[ReportingOrganisationName],#(lf)[locality] = [GP].[Locality],#(lf)[primary_care_network] = [GP].[PrimaryCareNetwork],#(lf)[start_date] = CAST([StartDate_HospitalProviderSpell] AS DATE),#(lf)[discharge_date] = CAST([DischargeDate_FromHospitalProviderSpell] AS DATE),#(lf)[provider_code] = [OrganisationCode_CodeOfProvider],#(lf)[provider_name] = COALESCE([OT].[Name], [I].[OrganisationName]),#(lf)[Provider_group] = CASE WHEN [OrganisationCode_CodeOfProvider] like 'RTE%' then 'Gloucestershire Hospitals NHS Foundation Trust'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [I].[OrganisationCode] IS NOT NULL THEN 'Independent Sector Provider'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ELSE 'Other NHS Provider' END,#(lf)[site_code] = [A].[SiteCode_ofTreatmentAtEpisodeStartDate],#(lf)[site_name] = COALESCE([OS].[Name],[IS].[Name]),#(lf)[total_bed_days] = CASE WHEN DATEDIFF(dd,[StartDate_HospitalProviderSpell],[DischargeDate_FromHospitalProviderSpell]) < 0 THEN 0 ELSE DATEDIFF(dd,[StartDate_HospitalProviderSpell],[DischargeDate_FromHospitalProviderSpell]) END,#(lf)[treatment_function_code] = [a].[TreatmentFunctionCode],#(lf)[treatment_function_description] = [TFC].[TreatmentFunctionDescription],#(lf)[hrg_code] = [A].[SpellCOREHRG],#(lf)[hrg_description] = [H].[HRGCodeDescription],#(lf)[hrg_sub_chapter_description] = [H].[HRG_SubChapter_Description],#(lf)[admission_method_code] = [AdmissionMethod_HospitalProviderSpell],#(lf)[admission_method_description] = [AM].[AdmissionMethodName],#(lf)[readmission_flag] = [Derived_Readmission_30_day],#(lf)--[MH_Admission_Flag] = CASE#(tab)#(tab)#(tab) WHEN [Derived_SEM_SpellPDiag] LIKE 'F%'#(tab)#(tab) THEN 1 --- Mental Health chapter#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN [Derived_SEM_SpellPDiag] LIKE 'X[67]%'#(tab) THEN 1  --- Intentional Self Harm#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN [Derived_SEM_SpellPDiag] LIKE 'X8[01234]%' THEN 1 --- Intentional Self Harm#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN [Derived_SEM_SpellPDiag] LIKE 'X[67]%'#(tab) THEN 1  --- Intentional Self Harm     ------- These codes are usually coded in the secondary position#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN [Derived_SEM_SpellPDiag] LIKE 'X8[01234]%' THEN 1  --- Intentional Self Harm#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN [Derived_SEM_SpellPDiag] LIKE 'T3[6789]%'  THEN 1 --- Poisoning by drugs, medicaments and biological substances *as per PHE these last 3 codes are not recognised. This is a local definition.#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN [Derived_SEM_SpellPDiag] LIKE 'T4%'#(tab)#(tab) THEN 1 --- Poisoning by drugs, medicaments and biological substances *#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN [Derived_SEM_SpellPDiag] LIKE 'T50%'#(tab)#(tab) THEN 1 --- Poisoning by drugs, medicaments and biological substances *#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) ELSE 0 END,#(lf)[patient_classification_code] = [PatientClassification],#(lf)[patient_classification] = CASE WHEN [PatientClassification] = '1' THEN 'Inpatient Admission'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [PatientClassification] = '2' THEN 'Day Case Admission'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ELSE 'Other' END#(lf)#(lf)#(lf)FROM [CCG_Current].[SEM].[vw_HospitalProviderSpell] [A]#(lf)#(lf)LEFT JOIN [CCG_Reference].[Reference].[vw_DateLookup] [D] #(lf)       ON CAST([DischargeDate_FromHospitalProviderSpell] AS DATE) = [D].[Date]#(lf)#(lf)LEFT JOIN [CCG_Reference].[Reference].[vw_TreatmentFunction] [TFC] #(lf)       ON [A].[TreatmentFunctionCode] = [TFC].[TreatmentFunctionCode]#(lf)#(lf)LEFT JOIN [CCG_Reference].[Reference].[vw_AdmissionMethod] [AM]#(lf)#(tab)   ON [AM].[AdmissionMethodCode] = [A].[AdmissionMethod_HospitalProviderSpell]#(lf)#(lf)LEFT JOIN [CCG_Reference].[Reference].[vw_OrganisationTrust] [OT]#(lf)#(tab)   ON [OT].[OrganisationCode] = LEFT([A].[OrganisationCode_CodeOfProvider],3)#(lf)#(lf)LEFT JOIN [CCG_Reference].[Reference].[vw_IndependentProviderSite] [OS] #(lf)       ON [A].[SiteCode_ofTreatmentAtEpisodeStartDate] = [OS].[OrganisationCode]#(lf)#(lf)LEFT JOIN [CCG_Reference].[Reference].[vw_IndependentProvider] [I]#(lf)    ON [I].[OrganisationCode] = LEFT([A].[OrganisationCode_CodeOfProvider],3)#(lf)#(lf)LEFT JOIN [CCG_Reference].[Reference].[vw_IndependentProviderSite] [IS] #(lf)       ON [A].[SiteCode_ofTreatmentAtEpisodeStartDate] = [IS].[OrganisationCode]#(lf)#(lf)LEFT JOIN [CCG_Reference].[Reference].[vw_HRG] [H] #(lf)   ON [A].[SpellCOREHRG] = [H].[HRGCode]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(lf)LEFT JOIN( SELECT DISTINCT#(lf)#(tab)#(tab)   [OrganisationCode],#(lf)#(tab)#(tab)   [ReportingOrganisationName],#(lf)#(tab)#(tab)   [Locality],#(lf)#(tab)#(tab)   [PrimaryCareNetwork]#(lf)#(tab)#(tab)   FROM [CCG_Reference].[Reference].[vw_GPPractice]#(lf)#(tab)#(tab)   WHERE [Locality] IS NOT NULL#(lf)#(tab)#(tab)   AND StatusDescription = 'ACTIVE') [GP]#(lf)#(tab)#(tab)   ON [A].[PracticeCodeOfRegisteredGP] = [GP].[OrganisationCode]#(lf)#(lf)WHERE CAST([A].[DischargeDate_FromHospitalProviderSpell] AS DATE) >= '20190401'#(lf)AND [A].[AdmissionMethod_HospitalProviderSpell] like '1%' --- All elective Admissions#(lf)AND [SpellCOREHRG] NOT LIKE '%424%' --- Excludes well babies#(lf)AND [OrganisationCode_CodeOfCommissioner] = '11M'#(lf)AND [OrganisationCode_CodeOfProvider] NOT LIKE 'RTE%'#(lf)"]),
