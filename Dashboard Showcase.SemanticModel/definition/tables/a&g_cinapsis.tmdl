	partition a&g_cinapsis-cf896602-d2ed-47c6-b16f-447f26e4d694 = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "ccg_current", [Query="/*=================================================================#(lf)ADVICE & GUIDANCE AND CINAPSIS DATA FLOW  --88,881#(lf)=================================================================*/#(lf)-- The following script counts all calls to A&G and cinapsis including when there are multiple calls ####(lf)-- for the same patient case. This occurs often when additional infromation is required. #(lf)-- THIS ONLY INCLUDES ROUTINE CINAPSIS ACTIVITY NOT TOTAL ACTIVITY#(lf)-- all referral data uses main specialty rather then TFC#(lf)#(lf)select distinct#(lf)     [type] = 'A&G'#(lf)    ,[a].[UBRN] [unique_id]#(lf)#(tab),cast([ActionDateTime] as date) [request_date]#(lf)#(tab)--,[Derived_ActionYearMonth] [request_year_month]#(lf)#(tab)--,[d].[FinancialYear] [financial_year]#(lf)#(tab)--,[d].[FinancialMonth] [financial_month]#(lf)#(tab)--,LEFT([d].[MonthName],3) as [month_name]#(lf)#(tab),1 as [counter]#(lf)#(tab),[Derived_ProviderOrganisationDescription] [provider_name]#(lf)    ,case when [Derived_ProviderOrganisationCode] like 'RTE%' then 'Gloucestershire Hospitals NHS Foundation Trust'#(lf)#(tab)#(tab)  when [I].[OrganisationCode] is not null then 'Independent Sector Provider'#(lf)#(tab)#(tab)  else 'Other NHS Provider'#(lf)#(tab)      end as [provider_group]#(lf)#(tab)--,[Derived_PriorityDescription] [Priority]#(lf)#(tab),[gp].[OrganisationCode] [practice_code]#(lf)#(tab),[gp].[ReportingOrganisationName] [practice_name]#(lf)#(tab),[gp].[Locality] [locality]#(lf)    ,[gp].[PrimaryCareNetwork] [primary_care_network]#(lf)--#(tab),[ServiceName]#(lf)    ,[Derived_MainSpecialtyCode] [main_specialty_code]#(lf)    ,coalesce([MS].[MainSpecialtyDescription], [Derived_MainSpecialtyDescription]) [main_specialty]#(lf)--#(tab),[Derived_TreatmentFunctionCode] [Treatment Function Code]#(lf)--#(tab),[Derived_TreatmentFunctionDescription] [Treatment Function Description]#(lf)  --  ,[F].[Outcome]#(lf)#(lf)from [CCG_Current].[EReferrals].[vw_Events] [a]#(lf)left join [CCG_Reference].[Reference].[vw_MainSpecialty] [ms] on [a].[Derived_MainSpecialtyCode] = [ms].[MainSpecialtyCode]#(lf)left join [CCG_Reference].[Reference].[vw_DateLookup] [d] on cast([a].[ActionDateTime] as date) = [d].[Date]#(lf)left join [CCG_Reference].[Reference].[vw_IndependentProvider] [i] ON [A].[Derived_ProviderOrganisationCode] = [i].[OrganisationCode]#(lf)--left join [CCG_Current].[EReferrals].[vw_AdviceAndGuidance_feed] [F] ON [A].[UBRN] = [F].[UBRN]#(lf)left join(select distinct#(lf)#(tab)#(tab)#(tab)#(tab) [OrganisationCode],#(lf)#(tab)#(tab)#(tab)#(tab) [ReportingOrganisationName],#(lf)#(tab)#(tab)#(tab)#(tab) [Locality],#(lf)#(tab)#(tab)#(tab)#(tab) [PrimaryCareNetwork]#(lf)#(tab)#(tab)#(tab)#(tab) from [CCG_Reference].[Reference].[vw_GPPractice]#(lf)#(tab)#(tab)#(tab)#(tab) where [Locality] is not null#(lf)#(tab)#(tab)#(tab)#(tab) and StatusDescription = 'active') as [gp]#(lf)#(tab)#(tab)#(tab)#(tab) on [a].[Derived_ReferringOrganisationCode] = [gp].[OrganisationCode]#(lf)#(lf)where [Derived_ReferringOrganisationParentCode] = '11M' -- Glos patients only #(lf)and cast([ActionDateTime] as date) >= '20190401'#(lf)and [ActionCode] = '1407'#(lf)#(lf)#(lf)union all#(lf)#(lf)select distinct #(lf)     [type] = 'Cinapsis'#(lf)    ,[CaseID] [unique_id]#(lf)#(tab),[DateofCallInitiated] [request_date]#(lf) --   ,[d].[YearMonth] [request_year_month]#(lf)#(tab)--,[d].[FinancialYear] [financial_year]#(lf)#(tab)--,[d].[FinancialMonth] [financial_month]#(lf)#(tab)--,LEFT([D].[MonthName],3) as [month_name]#(lf)#(tab),1 as [counter]#(lf)#(tab),[provider_name] =  'Gloucestershire Hospitals NHS Foundation Trust'#(lf)#(tab),[provider_group] = 'Gloucestershire Hospitals NHS Foundation Trust'#(lf)#(tab)--,[Priority] = 'Routine'#(lf)#(tab),[gp].[OrganisationCode] [practice_code]#(lf)#(tab),[gp].[ReportingOrganisationName] [practice_name]#(lf)#(tab),[gp].[Locality] [locality]#(lf)    ,[gp].[PrimaryCareNetwork] [primary_care_network]#(lf)#(tab),[main_specialty_code] = NULL#(lf)#(tab),[Service] [main_specialty]#(lf)#(tab)--,[A].[SpecialistOutcome]#(lf)#(lf)from [CCG_Current].[Cinapsis].[vw_ReferralManagement] [a]  #(lf)left join [CCG_Reference].[Reference].[vw_DateLookup] [d] ON [a].[DateofCallInitiated] = [d].[Date]#(lf)left join [CCG_Reference].[Reference].[vw_OrganisationSite] [s] ON [a].[OrganisationCodeofCaller] = [s].[OrganisationCode]#(lf)left join (select distinct #(lf)#(tab)#(tab)#(tab)[OrganisationCode],#(lf)#(tab)#(tab)#(tab)[ReportingOrganisationName],#(lf)#(tab)#(tab)#(tab)[Locality],#(lf)#(tab)#(tab)#(tab)[PrimaryCareNetwork]#(lf)#(tab)#(tab)#(tab)from [CCG_Reference].[Reference].[vw_GPPractice]#(lf)#(tab)#(tab)#(tab)where [Locality] is not null#(lf)#(tab)#(tab)#(tab)and [StatusDescription] = 'active') as [gp]#(lf)#(tab)#(tab)#(tab)on [a].[OrganisationCodeofCaller] = [gp].[OrganisationCode]#(lf)#(lf) where cast([DateofCallInitiated] as date) >= '20190401'#(lf) and ([Service] = 'Dermatology')#(lf) or ([Service] = 'Paediatrics e-Opinion')"])
				in
				    Source

	annotation PBI_DescriptionAtRefresh

	annotation PBI_ResultType = Table

