ng_pre] <> '' and [Anxiety_Q1_Confident_Noticing_post]  <> '' and [Anxiety_Q2_Knowing_what_helps_pre] <> '' and [Anxiety_Q2_Knowing_what_helps_post] <> '' then '1'  end as 'Anxiety both' ---- where both have a score#(lf)#(tab),case when cast([Anxiety_Q1_Confident_Noticing_post]as int) > cast([Anxiety_Q1_Confident_Noticing_pre]as int) or cast([Anxiety_Q2_Knowing_what_helps_post]as int) > cast([Anxiety_Q2_Knowing_what_helps_pre]as int) then '1'  end as 'Anxiety Improved' ----- how to ignore if blank#(lf)#(lf)#(tab)--------GAD#(lf) #(lf)#(tab),case when [GAD_7_Pre_score] <> '' then '1' end as 'GAD Initial'#(lf)#(tab),case when [GAD_7_Pre_score] <> '' or [GAD_7_Post_score]  <> '' then '1' end as 'GAD flag' ---- where there is a score for pre or post#(lf)#(tab),case when [GAD_7_Pre_score] <> '' and [GAD_7_Post_score]  <> '' then '1' end as 'GAD both' ---- where both have a score#(lf)#(tab),case when [GAD_7_Post_score] = '' then Null #(lf)#(tab)when cast([GAD_7_Post_score]as int)  < cast([GAD_7_Pre_score]as int)  then '1' end as 'GAD improved'   ----  where there is improvement #(lf)#(lf)---------Goal based --- Need to work out the improved section case statement #(lf)    #(lf)#(tab),case when ([Goal_Based_Outcomes_Goal_1_pre_score] <> '') or ([Goal_Based_Outcomes_Goal_2_pre_score] <> '') or ([Goal_Based_Outcomes_Goal_3_pre_score] <> '') then '1' end as 'Goal Initial'  #(lf)#(tab),case when [Goal_Based_Outcomes_Goal_1_pre_score]  <> '' or [Goal_Based_Outcomes_Goal_1_post_score] <> '' or [Goal_Based_Outcomes_Goal_2_pre_score]  <> '' or [Goal_Based_Outcomes_Goal_2_post_score] <> '' or [Goal_Based_Outcomes_Goal_3_pre_score]  <> '' or [Goal_Based_Outcomes_Goal_3_post_score] <> '' then '1' end as 'Goal flag' ---- where there is a score for pre or post#(lf)#(tab),case when ([Goal_Based_Outcomes_Goal_1_pre_score]  <> '' and [Goal_Based_Outcomes_Goal_1_post_score] <> '') or ([Goal_Based_Outcomes_Goal_2_pre_score]  <> '' and [Goal_Based_Outcomes_Goal_2_post_score] <> '') or ([Goal