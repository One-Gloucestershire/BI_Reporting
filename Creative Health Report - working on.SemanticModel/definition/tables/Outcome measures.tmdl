[ONS_Pre_Life_Satisfaction] ELSE '' END#(lf)      ,[ONS_Pre_Worthwhile] = CASE WHEN ISNUMERIC([ONS_Pre_Worthwhile]) = 1 THEN [ONS_Pre_Worthwhile] ELSE '' END#(lf)      ,[ONS_Pre_Happiness] = CASE WHEN ISNUMERIC([ONS_Pre_Happiness]) = 1 THEN [ONS_Pre_Happiness] ELSE '' END#(lf)      ,[ONS_Pre_Anxiety] = CASE WHEN ISNUMERIC([ONS_Pre_Anxiety]) = 1 THEN [ONS_Pre_Anxiety] ELSE '' END#(lf)      ,[ONS_Post_Life_Satisfaction] = CASE WHEN ISNUMERIC([ONS_Post_Life_Satisfaction]) = 1 THEN [ONS_Post_Life_Satisfaction] ELSE '' END#(lf)      ,[ONS_Post_Worthwhile] = CASE WHEN ISNUMERIC([ONS_Post_Worthwhile]) = 1 THEN [ONS_Post_Worthwhile] ELSE '' END#(lf)      ,[ONS_Post_Happiness] = CASE WHEN ISNUMERIC([ONS_Post_Happiness]) = 1 THEN [ONS_Post_Happiness] ELSE '' END#(lf)      ,[ONS_Post_Followup_Anxiety] = CASE WHEN ISNUMERIC([ONS_Post_Followup_Anxiety]) = 1 THEN [ONS_Post_Followup_Anxiety] ELSE '' END#(lf)#(lf)#(lf)--------Anxiety (1 is low and 10 is high) ******* broken #(lf)#(tab)  ,[Anxiety_Q1_Confident_Noticing_pre] = CASE WHEN ISNUMERIC([Anxiety_Q1_Confident_Noticing_pre]) = 1 THEN [Anxiety_Q1_Confident_Noticing_pre] ELSE '' END#(lf)      ,[Anxiety_Q1_Confident_Noticing_post] = CASE WHEN ISNUMERIC([Anxiety_Q1_Confident_Noticing_post]) = 1 THEN [Anxiety_Q1_Confident_Noticing_post] ELSE '' END#(lf)      ,[Anxiety_Q2_Knowing_what_helps_pre] = CASE WHEN ISNUMERIC([Anxiety_Q2_Knowing_what_helps_pre]) = 1 THEN [Anxiety_Q2_Knowing_what_helps_pre] ELSE '' END#(lf)      ,[Anxiety_Q2_Knowing_what_helps_post] = CASE WHEN ISNUMERIC([Anxiety_Q2_Knowing_what_helps_post]) = 1 THEN [Anxiety_Q2_Knowing_what_helps_post] ELSE '' END#(lf)#(lf)#(lf)--------GAD#(lf)#(tab) ,[GAD_7_Pre_score] = CASE WHEN ISNUMERIC([GAD_7_Pre_score]) = 1 THEN [GAD_7_Pre_score] ELSE '' END#(lf)#(tab),[GAD_7_Post_score] = CASE WHEN ISNUMERIC([GAD_7_Post_score]) = 1 THEN [GAD_7_Post_score] ELSE '' END#(lf)#(lf)#(lf)-----------Goal based --- Need to work out the improved section case statement #(lf)      ,[Goal_Based_O