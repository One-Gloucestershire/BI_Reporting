table 'Service Use'
	lineageTag: ab350d49-5331-4528-a2c5-2156dc147f47

	measure 'Distict patients' = ```
			DISTINCTCOUNT('Service Use'[Derived_Pseudo_NHS]) 
			```
		formatString: 0
		lineageTag: ea7a76b2-8a3e-40e3-b1a1-8fceb33af99c

	measure 'Total usage pre' = ```
			CALCULATE(sum('Service Use'[Count]), 'Service Use'[Pre/Post] = "pre") 
			```
		formatString: 0
		lineageTag: 81391497-c7a5-427e-8621-8cd2f9458d32

	measure 'Total usage post' = ```
			CALCULATE(sum('Service Use'[Count]), 'Service Use'[Pre/Post] = "post") 
			```
		formatString: 0
		lineageTag: 11942234-e071-4397-9000-e60bd5c5ace5

	measure 'Service use variation count' = [Total usage post]-[Total usage pre]
		formatString: 0
		lineageTag: 04acb7fb-462c-41ba-ba71-8e0845f25567

	measure 'Service use variation %' = ([Total usage post]-[Total usage pre])/[Total usage pre]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: a0702783-1f0a-439c-b5f3-299331a9939a

