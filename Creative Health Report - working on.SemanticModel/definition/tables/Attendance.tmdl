table Attendance
	lineageTag: 3b5269d1-f8cf-4797-a46c-97e587f75987

	measure 'Average Attended Sessions' = ```
			
			
			
			calculate(sum(Attendance[Attended])/sum(Attendance[count]),
			
			Attendance[Accept/Exclude] = "Accept", 
			
			Attendance[Completed_programme_flag] = 1,
			
			ALL(Attendance[Attended]))
			```
		formatString: 0
		lineageTag: 8871f982-d723-4070-bcbc-5785238fe078

	measure Number_of_referrals = calculate(sum('Attendance'[count]),'Attendance'[Accept/Exclude] = "Accept")
		formatString: 0
		lineageTag: 11e4b1c2-4d9f-4ec6-bc36-1e4c0849deda

	measure Number_of_Referrals_Suppressed = if([Number_of_referrals]<6,0,[Number_of_referrals])
		formatString: 0
		lineageTag: db9e97ee-1416-4080-8a1c-6a1b4abdcde5

	measure 'Percentage Attended' =
			
			
			SUM('Attendance'[Attended]) / SUM('Attendance'[Available])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 67c195af-a8c4-4c21-aaf9-7e9f8c620da7

