	measure ERCurrentFY =
			
			MAX('E-Referrals Date Table'[financial_year])  // Automatically detect the latest FY
		lineageTag: 638a91e5-2497-4577-862a-c4c4f7301b25

	measure ERPreviousFY =
			
			VAR CurrentYear = YEAR(MAX('E-Referrals Date Table'[date]))
			VAR CurrentMonth = MONTH(MAX('E-Referrals Date Table'[date]))
			RETURN
			    IF(
			        CurrentMonth >= 4,
			        FORMAT(CurrentYear - 1, "0000") & "/" & RIGHT(FORMAT(CurrentYear, "0000"), 2),
			        FORMAT(CurrentYear - 2, "0000") & "/" & RIGHT(FORMAT(CurrentYear - 1, "0000"), 2)
			    )
		lineageTag: 4aeb3189-35ed-4e5d-9408-eda5dcac752b

