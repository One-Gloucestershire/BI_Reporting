	measure 'KPI AG SameM LastY' = CALCULATE(SUM('A&G'[Counter]), 'A&G Date Table'[same_month_last_year_flag] = 1) +0
		formatString: 0
		lineageTag: ad461f23-1373-4e6b-8951-89c99943d9ea

	measure 'KPI AG Savings Calc' = ```
			
			VAR CurrentMonthCount = CALCULATE(
			    [KPI Monthly Count AG],
			    DATESMTD('A&G Date Table'[date])  // Focuses on the current month
			)
			VAR LastYearCount = CALCULATE(
			    [KPI Monthly Count AG],
			    DATEADD(DATESMTD('A&G Date Table'[date]), -1, YEAR)  // Same month last year
			)
			VAR YoYDiff = CurrentMonthCount - LastYearCount
			RETURN
			COALESCE((YoYDiff * 0.77 * 0.74 * 142), 0) 
			
			```
		formatString: 0
		lineageTag: c637d84e-abbd-4c6f-a849-2c1c344f3853

	measure 'KPI Monthly Count AG' = SUM('A&G'[Counter])
		formatString: 0
		lineageTag: 80dbe2ad-3f56-413b-8114-ed3bf97cca04

	measure 'KPI AG YTD Latest' = ```
			
			VAR _CurrentFY = 'A&G Date Table'[AGCurrentFY]
			RETURN 
			CALCULATE(
			    SUM('A&G'[Counter]),
			    'A&G Date Table'[ytd_flag] = 1,
			    'A&G Date Table'[Financial Year] = _CurrentFY ) +0
			
			```
		formatString: 0
		lineageTag: 903c2bd2-6765-4fef-9674-3b049c212ae5

	measure 'KPI AG YTD Previous' = ```
			
			VAR _PreviousFY = 'A&G Date Table'[AGPreviousFY]
			RETURN 
			CALCULATE(
			    SUM('A&G'[Counter]),
			    'A&G Date Table'[ytd_flag] = 1,
			    'A&G Date Table'[Financial Year] = _PreviousFY ) +0
			```
		formatString: 0
		lineageTag: 0fe88e2b-763a-4eef-84af-8f316e122e5a

	measure 'KPI AG Savings PreviousM' = ```
			
			VAR CurrentMonthCount = CALCULATE(
			    [KPI Monthly Count AG],
			    DATEADD(DATESMTD('A&G Date Table'[date]), -1, MONTH)  // Previous month
			)
			VAR LastYearCount = CALCULATE(
			    [KPI Monthly Count AG],
			    DATEADD(DATEADD(DATESMTD('A&G Date Table'[date]), -1, MONTH), -1, YEAR)
			)
			VAR YoYDiff = CurrentMonthCount - LastYearCount
			RETURN
			COALESCE((YoYDiff * 0.77 * 0.74 * 142), 0)
			
			```
		lineageTag: 49b41ad9-81cb-4de4-8901-13bf32b4208a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'KPI AG Savings YTD' =
			
			VAR _CurrentFY = 'A&G Date Table'[AGCurrentFY]
			VAR _PreviousFY = 'A&G Date Table'[AGPreviousFY]
			
			VAR _CurrentYTD = CALCULATE([KPI Monthly Count AG], 'A&G Date Table'[ytd_flag] = 1, 'A&G Date Table'[Financial Year] = _CurrentFY)
			VAR _PreviousYTD = CALCULATE([KPI Monthly Count AG], 'A&G Date Table'[ytd_flag] = 1, 'A&G Date Table'[Financial Year] = _PreviousFY)
			
			VAR _Difference = _CurrentYTD - _PreviousYTD
			RETURN COALESCE((_Difference * 0.77 * 0.74 * 142), 0)
		lineageTag: 6d7dea44-8cc0-444a-ab76-07784cbfd862

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'KPI AG Savings Last YTD' =
			
			VAR _PreviousPreviousFY = 'A&G Date Table'[AGPreviousPreviousFY]
			VAR _PreviousFY = 'A&G Date Table'[AGPreviousFY]
			
			VAR _PreviousPreviousYTD = CALCULATE([KPI Monthly Count AG], 'A&G Date Table'[ytd_flag] = 1, 'A&G Date Table'[Financial Year] = _PreviousPreviousFY)
			VAR _PreviousYTD = CALCULATE([KPI Monthly Count AG], 'A&G Date Table'[ytd_flag] = 1, 'A&G Date Table'[Financial Year] = _PreviousFY)
			
			VAR _Difference = _PreviousYTD - _PreviousPreviousYTD
			RETURN COALESCE((_Difference * 0.77 * 0.74 * 142),0)
		lineageTag: ccbfc85f-aacb-4731-80d5-f9851d1445a0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure PreviousFY = ```
			
			VAR CurrentFY = MAX('E-Referrals Date Table'[financial_year])
			VAR StartYear = LEFT(CurrentFY, 4)
			VAR EndYear = RIGHT(CurrentFY, 2)
			RETURN 
			FORMAT(VALUE(StartYear) - 1, "0000") & "/" & FORMAT(VALUE(EndYear) - 1, "00")
			```
		lineageTag: d83d5440-4a4c-4247-b7a7-6c0fd510678b

