table 'Population Overview'
	lineageTag: c06d2c64-290d-43c5-9cb3-9612a19f4100

	measure 'Total Unmoving Optom patients' = CALCULATE(COUNT('Population Overview'[Derived_Pseudo_NHS]), 'Population Overview'[Cohortflag] = 1, ALL('Population Overview') )
		formatString: 0
		lineageTag: 4339b772-81d0-4f6b-b711-97529e72626c

	measure 'Total Unmoving ICB patients' = CALCULATE(COUNTROWS('Population Overview'), ALL('Population Overview') )
		formatString: 0
		lineageTag: 451a217c-8823-44a4-af3b-4147de3f63ee

	measure '% ICB male' = ```
			DIVIDE(SUM('Population Overview'[Male Count]), [Total Unmoving ICB patients], 0 ) 
			```
		formatString: 0
		lineageTag: 152c50a6-e340-4aca-9901-500990e98502

	measure '% ICB female' = ```
			DIVIDE(SUM('Population Overview'[Female Count]), [Total Unmoving ICB patients], 0 ) 
			```
		formatString: 0
		lineageTag: 268bd4ec-e90a-4cb7-be2d-3c4631904494

	measure 'Total ICB patients' = CALCULATE(COUNTROWS('Population Overview'))
		formatString: 0
		lineageTag: 04dd4f4d-ce40-48e6-b2b6-2360468280df

	measure 'Total Optom patients' = CALCULATE(SUM('Population Overview'[Counter]), 'Population Overview'[Cohortflag] = 1 )
		formatString: 0
		lineageTag: 30d26705-3121-45fa-87c5-b0bc024e8ee4

	measure 'QOF Asthma rate' =
			
			DIVIDE(SUM('Population Overview'[AsthmaDerived]), COUNTROWS('Population Overview')) *1000
		lineageTag: 78b886b2-5249-4d85-aa03-7c6f73e32fff

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% EH' = ```
			
			VAR eyepatients = CALCULATE(COUNT('Population Overview'[Cohortflag]), 'Population Overview'[Cohortflag] = 1) 
			RETURN DIVIDE(eyepatients, [Total Unmoving Optom patients], 0 )
			```
		lineageTag: 9f3f158d-c5b3-4fbb-80c3-81a91c290513

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% ICB' = DIVIDE(COUNTROWS('Population Overview'), [Total Unmoving ICB patients], 0 )
		lineageTag: c5a9a360-cee4-4292-9944-9e7303c7e102

		annotation PBI_FormatHint = {"isGeneralNumber":true}

