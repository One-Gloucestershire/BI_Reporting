	column SPC_flag =
			
			IF(
			    AND('A&G Date Table'[date] >= DATE(2023,11,01),  'A&G Date Table'[date] <= DATE(2024,10,31)),  1, 0)
		formatString: 0
		lineageTag: 8fc3c9d6-8238-458e-ba9e-527e936a69e8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column YearMonthIndex = ```
			---this field orders months in your date table so the moving average calculates correctly. 
			
			RANKX(
			    ALL('A&G Date Table'[year_month]),
			    'A&G Date Table'[year_month],
			    ,
			    ASC,
			    DENSE
			) - 1
			```
		formatString: 0
		lineageTag: 38e99c88-bc7a-4c8e-bec9-da256ce38007
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

