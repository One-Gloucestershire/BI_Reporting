table 'A&G Date Table'
	lineageTag: 58efe30c-6a88-4169-a9e2-12b745294c27
	dataCategory: Time

	measure AGCurrentFY =
			
			MAX('A&G Date Table'[Financial Year])  // Automatically detect the latest FY
		lineageTag: 22856a76-6cb3-4abf-b062-f70390fa2d0d

	measure AGPreviousFY =
			
			VAR TodayDate = TODAY()
			VAR CurrentYear = YEAR(TodayDate)
			VAR CurrentMonth = MONTH(TodayDate)
			RETURN
			    IF(
			        CurrentMonth >= 4,
			        FORMAT(CurrentYear - 1, "0000") & "/" & RIGHT(FORMAT(CurrentYear, "0000"), 2),
			        FORMAT(CurrentYear - 2, "0000") & "/" & RIGHT(FORMAT(CurrentYear - 1, "0000"), 2)
			    )
		lineageTag: fe88fdef-2bec-451a-bb1e-8a0f08483448

	measure AGPreviousPreviousFY =
			
			VAR TodayDate = TODAY()
			VAR CurrentYear = YEAR(TodayDate)
			VAR CurrentMonth = MONTH(TodayDate)
			RETURN
			    IF(
			        CurrentMonth >= 4,
			        FORMAT(CurrentYear - 2, "0000") & "/" & RIGHT(FORMAT(CurrentYear -1, "0000"), 2),
			        FORMAT(CurrentYear - 3, "0000") & "/" & RIGHT(FORMAT(CurrentYear - 2, "0000"), 2)
			    )
		lineageTag: f7efad9b-eda7-47ca-99c3-385b5e14226d

