                      "fontSize": "12px",
                      "fontWeight": "normal",
                      "color": "#425563"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "4. Crude vs ASR cards: ASR (age-standardised, ESP 2013) removes differences in age profile so areas compare fairly.",
                    "textStyle": {
                      "fontSize": "12px",
                      "fontWeight": "normal",
                      "color": "#425563"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
