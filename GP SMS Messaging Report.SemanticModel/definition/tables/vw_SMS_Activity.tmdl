			VAR Num_Months = DISTINCTCOUNT('REF_DateRef'[Month_Start])
			RETURN ROUND(DIVIDE(1000*Total_Fragments/Num_Months,patient_count,BLANK()),2)
		lineageTag: b5ef5939-0b09-4d3b-a057-f5168fbedf41

