table vw_SMS_Activity
	lineageTag: 69db0a8e-45dc-4dfb-a160-76d6e9179e72

	measure 'Fragments per practice' =
			
			VAR Total_fragments = CALCULATE(SUM('vw_SMS_Activity'[TotalFragments]),'REF_SMSCostCentreCodeRef'[CostCentreType]="GP Practice")
			VAR GP_practice_count = CALCULATE(COUNT('vw_SMS_Activity'[CostCentre]),'REF_SMSCostCentreCodeRef'[CostCentreType]="GP Practice")/DISTINCTCOUNT('REF_DateRef'[Month_Start])
			RETURN ROUND(Total_fragments / GP_practice_count,2)
		formatString: #,0.00
		lineageTag: 6971020e-6fed-4635-9ab9-0db921e08ea6

	measure 'Spend per practice' =
			
			VAR Total_spend = CALCULATE(SUM('vw_SMS_Activity'[TotalCost]) ,'REF_SMSCostCentreCodeRef'[CostCentreType]="GP Practice")
			VAR GP_practice_count = CALCULATE(COUNT('vw_SMS_Activity'[CostCentre]),'REF_SMSCostCentreCodeRef'[CostCentreType]="GP Practice")/DISTINCTCOUNT('REF_DateRef'[Month_Start])
			RETURN ROUND(Total_spend / GP_practice_count,2)
		lineageTag: a070e649-1c56-41e8-800c-f5a661a66b02

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Fragments per 1000patient' =
			
			VAR Total_fragments = SUM('vw_SMS_Activity'[TotalFragments])
			VAR patient_count = SUM('GP Practice Populations'[Population]) / COUNTA('REF_DateRef'[Month_No])
			RETURN ROUND(DIVIDE(1000*Total_fragments,patient_count,BLANK()),2)
		formatString: #,0.00
		lineageTag: a45f4b80-b5c0-4caf-935b-c6d06b88864a

	measure 'Spend per 1000patient per month' =
			
			VAR Total_spend = SUM('vw_SMS_Activity'[TotalCost])
			VAR patient_count = SUM('GP Practice Populations'[Population]) / DISTINCTCOUNT('GP Practice Populations'[first_date_of_month])
			VAR Num_Months = DISTINCTCOUNT('REF_DateRef'[Month_Start])
			RETURN ROUND(DIVIDE(1000*Total_spend/Num_Months,patient_count,BLANK()),2)
		lineageTag: ef34b0de-0ef6-408f-bdae-fc74d30a5385

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Fragments per month' =
			
			VAR Total_Fragments = SUM('vw_SMS_Activity'[TotalFragments])
			VAR Num_Months = DISTINCTCOUNT('REF_DateRef'[Month_Start])
			RETURN ROUND(Total_Fragments / Num_Months,2)
		formatString: #,0.00
		lineageTag: 1c5de73f-a31e-4770-99b8-fef4c53f009a

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalDivision"
				}

		changedProperty = FormatString

	measure 'Annualised Fragments' =
			
			DIVIDE(
				12*SUM('vw_SMS_Activity'[TotalFragments]),
				DISTINCTCOUNT('REF_DateRef'[Month_Start])
			)
		formatString: #,0.00
		lineageTag: 61663dbd-1264-4029-bfa1-7f782676a688

	measure 'Spend per month' =
			
			VAR Total_spend = SUM('vw_SMS_Activity'[TotalCost])
			VAR Num_Months = DISTINCTCOUNT('REF_DateRef'[Month_Start])
			RETURN ROUND(Total_spend / Num_Months,2)
		lineageTag: eefb2f1d-6523-444b-93c5-3555b66af0c1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Annualised Spend' =
			
