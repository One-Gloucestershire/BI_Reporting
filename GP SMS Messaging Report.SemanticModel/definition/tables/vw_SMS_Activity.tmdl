	measure 'Annualised Fragments per 1000patient' =
			
			VAR Total_fragments = SUM('vw_SMS_Activity'[TotalFragments])
			VAR patient_count = SUM('GP Practice Populations'[Population]) / COUNTA('REF_DateRef'[Month_No])
