	partition 'GP Practice Populations' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "with tempsms as (select date, count(distinct costcentre) as gp_count from data_mart_powerbi_primarycare.tbl08_sms where left(costcentre,1) in ('L','Y') group by date) select practice_code, practice_name, primary_care_network, locality, first_date_of_month, sum(population) as ""Population"" from data_mart_primarycare.tbl01_gp_practice_populations where first_date_of_month >= (select min(date) from data_mart_powerbi_primarycare.tbl08_sms) and first_date_of_month <= (select max(date) from data_mart_powerbi_primarycare.tbl08_sms) group by practice_code, practice_name, primary_care_network, locality, first_date_of_month union select case when primary_care_network = 'Berkeley Vale' then 'U02669' when primary_care_network = 'Cheltenham Central' then 'U36833' when primary_care_network = 'Cheltenham St Paul''s' then 'U22020' when primary_care_network = 'North Cotswolds' then 'U09847' when primary_care_network = 'Severn Health' then 'U23710' when primary_care_network = 'Forest Green' then 'U16196' when primary_care_network = 'West Forest of Dean' then 'U29596' end, primary_care_network || ' PCN', primary_care_network, locality, first_date_of_month, sum(population) from data_mart_primarycare.tbl01_gp_practice_populations where first_date_of_month >= (select min(date) from data_mart_powerbi_primarycare.tbl08_sms) and first_date_of_month <= (select max(date) from data_mart_powerbi_primarycare.tbl08_sms) and primary_care_network in ('Berkeley Vale', 'Cheltenham Central', 'Cheltenham St Paul''s', 'North Cotswolds', 'Severn Health', 'Forest Green', 'West Forest of Dean') group by primary_care_network, locality, first_date_of_month union select 'RTE', 'RTE', NULL, NULL, first_date_of_month, sum(population) from data_mart_primarycare.tbl01_gp_practice_populations where first_date_of_month >= (select min(date) from data_mart_powerbi_primarycare.tbl08_sms) and first_date_of_month <= (select max(date) from data_mart_powerbi_primarycare.tbl08_sms) group by first_date_of_month union select '11M', '11M', NULL, NULL, first_date_of_month, sum(population) from data_mart_primarycare.tbl01_gp_practice_populations where first_date_of_month >= (select min(date) from data_mart_powerbi_primarycare.tbl08_sms) and first_date_of_month <= (select max(date) from data_mart_powerbi_primarycare.tbl08_sms) group by first_date_of_month union select 'Mean GP value', 'Mean GP value', NULL, NULL, pop.first_date_of_month, sum(pop.population)/avg(sms.gp_count) from data_mart_primarycare.tbl01_gp_practice_populations pop left join tempsms sms on pop.first_date_of_month = sms.date where pop.first_date_of_month >= (select min(date) from data_mart_powerbi_primarycare.tbl08_sms) and pop.first_date_of_month <= (select max(date) from data_mart_powerbi_primarycare.tbl08_sms) and pop.practice_code in (select distinct costcentre from data_mart_powerbi_primarycare.tbl08_sms) and left(pop.practice_code,1) in ('L','Y') group by pop.first_date_of_month", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

