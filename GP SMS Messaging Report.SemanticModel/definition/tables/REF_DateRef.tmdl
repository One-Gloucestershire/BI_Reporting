	partition REF_DateRef = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db01_reference"), "SELECT d.month_start as ""Month_Start"", d.year_month as ""Year_Month"", d.cal_year as ""Cal_Year"", concat('20',d.fin_year_yy_yy) as ""FinancialYear"", d.fin_year_first_part as ""Fin_Year_First_Part"", d.month_no as ""Month_No"", d.fin_month_no as ""Fin_Month_No"", d.month_name as ""Month_Name"", d.month_short_name as ""Month_Short_Name"", concat(concat(d.month_name,' '),d.cal_year) as ""MonthYearName"", concat(concat(rtrim(to_char(current_date,'Month')),' '),extract(year from current_date)) as ""RefreshMonthYear"" FROM dscro_national_lookups.ref_dates d WHERE d.full_date >= (select min(""date"") from db02_nopid.data_mart_powerbi_primarycare.tbl08_sms) AND d.full_date <= (select max(""date"") from db02_nopid.data_mart_powerbi_primarycare.tbl08_sms) AND d.full_date = d.month_start ORDER BY d.full_date", null, [EnableFolding=true])
				in
				    Source

