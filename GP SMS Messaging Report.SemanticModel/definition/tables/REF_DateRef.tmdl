	partition REF_DateRef = m
		mode: import
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "DSCRO_NATIONAL_LOOKUPS", [Query="DECLARE @startdate DATE = (SELECT MIN([Date]) FROM PowerBI_Reporting.primarycare.[tbl08_SMS]);#(lf)DECLARE @enddate DATE = (SELECT MAX([Date]) FROM PowerBI_Reporting.primarycare.[tbl08_SMS]);#(lf)#(lf)SELECT Month_Start, Year_Month, Cal_Year, CONCAT('20',Fin_Year_yy_yy) AS FinancialYear, Fin_Year_First_Part, Month_No, Fin_Month_No, Month_Name, Month_Short_Name, CONCAT(Month_Name,' ',Cal_Year) AS MonthYearName, CONCAT(DATENAME(MONTH,GETDATE()),' ',YEAR(GETDATE())) AS RefreshMonthYear#(lf)FROM [DSCRO_NATIONAL_LOOKUPS].[dbo].[ref_Dates]#(lf)WHERE Full_Date >= @startdate #(lf)AND Full_Date <= @enddate#(lf)AND Full_Date = Month_Start#(lf)ORDER BY Full_Date#(lf);"])
				in
				    Source

