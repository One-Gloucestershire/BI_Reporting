	measure MaxDischDate = LASTDATE(LoS[DischDate_HPS])
		formatString: General Date
		lineageTag: 4f6d0610-bc72-478e-95a2-013b8a0e90b9

	measure Avg_Los_8WkRolling = ```
			
			var LastSelDate = max(LoS[DischDate_HPS])   
			var period = DATESINPERIOD(LoS[DischDate_HPS], LastSelDate, -55 , DAY)
			var Result =
			    CALCULATE(
			                AVERAGEX    (
			                            VALUES(LoS[DischDate_HPS]),
			                            [Avg_LoS]
			        ),
			        period
			    )
			Return Result
			```
		lineageTag: 17355e59-2ac5-4f0e-9c0f-d992509bac38

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure maxdate = max(LoS[DischDate_HPS])
		formatString: General Date
		lineageTag: 1b5d930e-3595-46d6-afb0-19bdcfcc66a4

	measure Avglos =
			
			var LastSelDate = max(LoS[DischDate_HPS])
			var daterange = DATESINPERIOD(LoS[DischDate_HPS].[Date],LastSelDate,-55,day)
			var result = AVERAGEX(VALUES(LoS[DischDate_HPS].[Date])
			,[Avg_LoS])
			return LastSelDate
		formatString: General Date
		lineageTag: a7591a95-9327-4b0e-be6b-db9d86d33eb7

