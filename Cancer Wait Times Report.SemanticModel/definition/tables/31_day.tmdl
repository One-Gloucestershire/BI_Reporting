	column 'Month flag' = ```
			
			
			VAR max_month = MAX('31_day'[FirstDateofMonth])
			VAR current_month = '31_day'[FirstDateofMonth]
			
			VAR prior_month = EDATE(max_month, - 1)
			
			RETURN IF(max_month = current_month,"Current Month",if(prior_month = current_month, "Prior Month", "Other Month"))
			
			```
		lineageTag: 0da67bc7-cec6-4c33-83cc-36812b58d4c3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

