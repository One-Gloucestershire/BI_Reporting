table 31_day
	lineageTag: 794b62f0-56de-4339-ac87-1382054e72b2

	measure 31_day_performance = CALCULATE( (SUM('31_day'[total_treated])-SUM('31_day'[breaches]))/SUM('31_day'[total_treated]),'31_day'[Treatment_Type] <> "All Treatment")
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: b6500975-cfcc-4809-bd6f-2b94f810fabf

	measure 31_day_target_% = MIN('31_day'[target])
		lineageTag: d060d015-bdd8-4b5c-a5ab-2cfa2b5e19ce

	measure 31_day_target_checker = IF('31_day'[31_day_performance] >= '31_day'[31_day_target_%], "#63BE7B","#F8696B")
		lineageTag: b1700e92-3256-4d87-9674-fcd3ed36c13d

	measure '31 Day Combined Target' = 0.96
		formatString: 0%;-0%;0%
		lineageTag: da7deb46-fe9d-49ed-926d-8ad2236fabbf

	measure 31_day_performance_first = CALCULATE( (SUM('31_day'[total_treated])-SUM('31_day'[breaches]))/SUM('31_day'[total_treated]),'31_day'[Treatment_Type] = "First Treatment")
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 30fe5b39-41e0-4f24-9bf5-adcb7d1a0bd9

	measure 31_day_performance_subsequent = CALCULATE( (SUM('31_day'[total_treated])-SUM('31_day'[breaches]))/SUM('31_day'[total_treated]),'31_day'[Treatment_Type] = "Subsequent Treatment")
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 54955497-d6b4-407c-a65d-6e9380de41b1

	measure '31 Within Target' = CALCULATE(sum('31_day'[total_treated])-sum('31_day'[breaches]))
		formatString: 0
		lineageTag: 744fdb8e-b7cf-433a-93c7-510101fa0c9a

	measure 31_day_performance_current_month = CALCULATE([31_day_performance],'Month Flag Reference'[Month Flag] = "Current Month")
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e021b21b-6f3f-4f97-b7bd-968b56409f20

	measure 31_day_performance_prior_month = CALCULATE([31_day_performance],'Month Flag Reference'[Month Flag] = "Prior Month")
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0bfc3569-023a-491d-8122-6c48523122e6

	measure 31_day_performance_target_performance = IF([31_day_performance_current_month] >= 0.96, "hitting", "missing")
		lineageTag: 3f82345f-b7e7-41c6-91c9-55e3ac8ed1e9

	measure 31_day_breaches_current_month = CALCULATE(SUM('31_day'[breaches]),'Month Flag Reference'[Month Flag] = "Current Month", '31_day'[Treatment_Type] <> "All Treatment", '31_day'[report_name] = "27.4 - 31 Day Combined Tumour" || '31_day'[report_name] = "7.4 - 31 Day First Treatment")
		formatString: 0
		lineageTag: ecaeee96-5f9f-4854-9c57-4b7e2d8a93c8

	measure 31_day_performance_month_comparison =
			IF([31_day_performance_current_month] > [31_day_performance_prior_month], "up",
			                                        IF([31_day_performance_current_month] < [31_day_performance_prior_month], "down",
			                                        IF([31_day_performance_current_month] = [31_day_performance_prior_month], "equal",
			                                        "error")))
		lineageTag: 198af122-5e4e-44cd-91ce-8e4094f7d6d5

	measure 31_day_performance_month_improvement =
			IF([31_day_performance_current_month] > [31_day_performance_prior_month], "improved",
			                                        IF([31_day_performance_current_month] < [31_day_performance_prior_month], "deteriorated",
			                                        IF([31_day_performance_current_month] = [31_day_performance_prior_month], "remained unchanged",
			                                        "error")))
		lineageTag: 1318c189-7158-45ce-9925-efcd2167d142

