	column 'Month flag' = ```
			
			
			VAR max_month = MAX('62_day'[FirstDateofMonth])
			VAR current_month = '62_day'[FirstDateofMonth]
			
			VAR prior_month = EDATE(max_month, - 1)
			
			RETURN IF(max_month = current_month,"Current Month",if(prior_month = current_month, "Prior Month", "Other Month"))
			
			```
		lineageTag: 7d13537e-363e-4c61-9614-f7dc0d3604ee
