		lineageTag: 672fe3b4-dccc-457e-8236-98bcf6ed6622

	measure 62_day_performance_month_comparison =
			IF([62_day_performance_current_month] > [62_day_performance_prior_month], "up",
			                                        IF([62_day_performance_current_month] < [62_day_performance_prior_month], "down",
			                                        IF([62_day_performance_current_month] = [62_day_performance_prior_month], "equal",
			                                        "error")))
		lineageTag: 123623ed-fc5b-4d79-8851-950e61de6cac

	measure 62_day_performance_month_improvement =
			IF([62_day_performance_current_month] > [62_day_performance_prior_month], "improved",
			                                        IF([62_day_performance_current_month] < [62_day_performance_prior_month], "deteriorated",
			                                        IF([62_day_performance_current_month] = [62_day_performance_prior_month], "remained unchanged",
			                                        "error")))
		lineageTag: f24b061b-476c-422c-98e4-2035a6055c9d

	measure 62_day_performance_target_performance = IF([62_day_performance_current_month] >= 0.85, "hitting", "missing")
