	measure 62_day_breaches_current_month_gp_referred = CALCULATE(SUM('62_day'[breaches]),'Month Flag Reference'[Month Flag] = "Current Month", '62_day'[tumour_type] <> "All Tumour Types", '62_day'[Pathway_Name] = "GP Referred")
