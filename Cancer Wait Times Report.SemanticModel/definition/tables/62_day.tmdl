	measure 'Tumour type breach rankings gp referred' = RANKX(ALL('62_day'[tumour_type]),([62_day_breaches_for_ranking]),,DESC)
		formatString: 0
		lineageTag: c6bede17-4722-4c36-8e12-a5f8f7070281

	measure 62_day_breaches_for_ranking = CALCULATE(SUM('62_day'[breaches]),'Month Flag Reference'[Month Flag] = "Current Month", '62_day'[Pathway_Name] = "GP Referred")
		formatString: 0
		lineageTag: 0bedcb4a-4743-4f45-ac1f-49995eb8e87d

	measure '1st rank tumour type gp referred breach (old measure)' = ```
			
			
			VAR tumour = ALLSELECTED('62_day'[tumour_type])
			VAR RankedPosition = 2  
			RETURN CALCULATE(SELECTEDVALUE('62_day'[tumour_type]),
			FILTER('62_day',
			            RANKX(ALL('62_day'), 
			    RANKX (ALL('62_day'), '62_day'[62_day_breaches_for_ranking])
			        + DIVIDE( 
			            RANKX(ALL('62_day'), '62_day'[tumour_type]), 
			            (COUNTROWS(ALL('62_day')) + 1)
			        )
			, , ASC) = RankedPosition ))
			```
		lineageTag: 8b0f7b93-3b7a-4b6f-ab76-24f5fd825163

	measure '2nd rank tumour type gp referred breach' = ```
			
			
			VAR tumour = ALLSELECTED('62_day'[tumour_type])
			VAR RankedPosition = 3  
			RETURN CALCULATE(SELECTEDVALUE('62_day'[tumour_type]),
			FILTER('62_day',
			            RANKX(ALL('62_day'), 
			    RANKX (ALL('62_day'), '62_day'[62_day_breaches_for_ranking])
			        + DIVIDE( 
			            RANKX(ALL('62_day'), '62_day'[tumour_type]), 
			            (COUNTROWS(ALL('62_day')) + 1)
			        )
			, , ASC) = RankedPosition ))
			```
		lineageTag: 39f61a2b-f854-4424-9b9e-6990a33fc24f

	measure 'Ranking tumour type gp referred breach' = ```
			
			
			
			
			    CALCULATE(
			
			            RANKX(
			                ALL('62_day'),
			                [62_day_breaches_for_ranking],
			                ,
			                DESC
			            ) ) -1
			```
		formatString: 0
		lineageTag: d6d839c0-378a-4fb4-b1f4-1845c13dfacc

	measure '62 Day Breaches Ranking Title' =
			
			
			var month_name = FORMAT(MAX('62_day'[FirstDateofMonth]),"mmm")
			
			return CONCATENATE("62 Day Combined Breaches by Top 10 Tumour Type - ", month_name & " " & YEAR(MAX('two_week_wait'[report_date])))
		lineageTag: 7c8cb576-c5a6-4c61-ae70-092c7520c500

	measure ranking = ```
			
			            RANKX(
			                ALL('62_day'),
			                [62_day_breaches_for_ranking],
			                ,
			                DESC,Dense)
			```
		formatString: 0
		lineageTag: d929bfcc-8468-40d4-b4f0-fd27d1ae26e6

	measure '62 day current month name' = ```
			
			
			VAR max_month = MONTH(MAX('62_day'[FirstDateofMonth]))
			
			VAR month_name =
			SWITCH(TRUE(),
			max_month = 1, "January",
			max_month = 2, "February",
			max_month = 3, "March",
			max_month = 4, "April",
			max_month = 5, "May",
			max_month = 6, "June",
			max_month = 7, "July",
			max_month = 8, "August",
			max_month = 9, "September",
			max_month = 10, "October",
			max_month = 11, "November",
			max_month = 12, "December",
			"Error"
			)
			
			RETURN month_name
			
			```
		lineageTag: 11ec0e6a-b158-4114-abb8-51940998e8d3

	measure '62 day prior month name' = ```
			
			
			VAR max_month = MONTH(EDATE(MAX('62_day'[FirstDateofMonth]), - 1))
			
			VAR month_name =
			SWITCH(TRUE(),
			max_month = 1, "January",
			max_month = 2, "February",
			max_month = 3, "March",
			max_month = 4, "April",
			max_month = 5, "May",
			max_month = 6, "June",
			max_month = 7, "July",
			max_month = 8, "August",
			max_month = 9, "September",
			max_month = 10, "October",
			max_month = 11, "November",
			max_month = 12, "December",
			"Error"
			)
			
			RETURN month_name
			
			```
		lineageTag: a0cc417a-c5fe-4cd3-85d1-657076e9d7fb

	measure '62 day 1st rank tumour type gp referred breach' =
			
			
			VAR RankedPosition = 2
			VAR _RankTable =
			    ADDCOLUMNS (
			        VALUES ( '62_day'[tumour_type] ),
			        "@Breaches",
			            CALCULATE (
			                SUM ( '62_day'[breaches] ),
			                KEEPFILTERS ( 'Month Flag Reference'[Month Flag] = "Current Month" )
			            ),
			        "@Rank",
			            RANKX (
			                ALLSELECTED ( '62_day'[tumour_type] ),
			                CALCULATE (
			                    SUM ( '62_day'[breaches] ),
			                    KEEPFILTERS ( 'Month Flag Reference'[Month Flag] = "Current Month" )
			                ),
			                ,
			                DESC,
			                DENSE
			            )
			    )
			RETURN
			CONCATENATEX (
			    FILTER ( _RankTable, [@Rank] = RankedPosition ),
			    '62_day'[tumour_type],
			    ", "
			)
		lineageTag: 7dee9906-a744-4cdf-9905-db2dbed5a262

