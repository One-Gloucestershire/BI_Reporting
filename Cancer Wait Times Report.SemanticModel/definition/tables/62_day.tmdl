table 62_day
	lineageTag: 66b40863-174c-408b-9fbd-f3adaaa1216a

	measure 62_day_performance = CALCULATE((SUM('62_day'[total_treated])-SUM('62_day'[breaches]))/SUM('62_day'[total_treated]))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 54704af9-0542-4876-b628-a2dc71342a7e

	measure 62_day_target_% = MIN('62_day'[target])
		lineageTag: 4ab9bdff-21ea-47bc-a01c-29396ba41b52

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 62_day_target_checker = IF('62_day'[62_day_performance]>= '62_day'[62_day_target_%], "#63BE7B","#F8696B")
		lineageTag: 829d8292-280c-4414-bbec-fe5ac8099527

	measure '62 Day Combined Target' = 0.85
		formatString: 0%;-0%;0%
		lineageTag: 44dcb958-319c-4eac-bb4e-b6e5778f4328

	measure '62 Within Target' = CALCULATE(sum('62_day'[total_treated])-sum('62_day'[breaches]))
