	column 'Month flag' = ```
			
			
			VAR max_month = MAX('28_day'[FirstDateofMonth])
			VAR current_month = '28_day'[FirstDateofMonth]
			
			VAR prior_month = EDATE(max_month, - 1)
			
			RETURN IF(max_month = current_month,"Current Month",if(prior_month = current_month, "Prior Month", "Other Month"))
			
			```
		lineageTag: 943a73b4-9ce6-4004-80b7-0e882003a907
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

