table 28_day
	lineageTag: 82aa9b94-981a-4290-858c-1df5362a81e5

	measure 28_day_performance = (SUM('28_day'[total_patients])-SUM('28_day'[breaches]))/(SUM('28_day'[total_patients]))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: d877ca7f-871f-4f4a-a028-55c475a7648e

	measure 28_day_target_% = MIN('28_day'[target])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 2a39a535-b6e1-4925-8a58-e5215b136946

	measure 28_day_target_checker = IF('28_day'[28_day_performance] >= '28_day'[28_day_target_%], "#63BE7B","#F8696B")
		lineageTag: b9995869-98b7-4c04-888c-594bdda06dff

	measure 'Within Target' = CALCULATE(sum('28_day'[total_patients])-sum('28_day'[breaches]))
		formatString: 0
		lineageTag: de2a2456-5690-4958-bea7-b19dc68d426d

	measure 28_day_performance_current_month = CALCULATE([28_day_performance],'Month Flag Reference'[Month Flag] = "Current Month")
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: da0f0cf7-2b98-4d01-aec5-8ecdf91d43e0

	measure 28_day_performance_prior_month = CALCULATE([28_day_performance],'Month Flag Reference'[Month Flag] = "Prior Month")
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 588d0c96-568e-47ec-8b92-bf70e8746411

	measure 28_day_performance_month_comparison =
			IF([28_day_performance_current_month] > [28_day_performance_prior_month], "up",
			                                        IF([28_day_performance_current_month] < [28_day_performance_prior_month], "down",
			                                        IF([28_day_performance_current_month] = [28_day_performance_prior_month], "equal",
			                                        "error")))
		lineageTag: 5a090504-7f72-4e21-b398-ac3e9fce617d

	measure 28_day_performance_target_performance = IF([28_day_performance_current_month] >= 0.77, "hitting", "missing")
		lineageTag: 5e72617f-02ec-4451-96f8-7498a169d9f9

	measure 28_day_breaches_current_month = CALCULATE(SUM('28_day'[breaches]),'Month Flag Reference'[Month Flag] = "Current Month", '28_day'[report_name] <> "error")
		formatString: 0
		lineageTag: 67fd2c15-c4d1-4227-a3ff-8fc9032bc52c

	measure 28_day_performance_month_improvement =
			IF([28_day_performance_current_month] > [28_day_performance_prior_month], "improved",
			                                        IF([28_day_performance_current_month] < [28_day_performance_prior_month], "deteriorated",
			                                        IF([28_day_performance_current_month] = [28_day_performance_prior_month], "remained unchanged",
			                                        "error")))
		lineageTag: 928d32f1-0fa1-4ad3-bfca-a11b6240fe26

