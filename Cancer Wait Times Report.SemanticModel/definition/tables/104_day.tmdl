	column 'Month flag' = ```
			
			
			VAR max_month = MAX('104_day'[FirstDateofMonth])
			VAR current_month = '104_day'[FirstDateofMonth]
			
			VAR prior_month = EDATE(max_month, -1)
			
			RETURN IF(max_month = current_month,"Current Month",if(prior_month = current_month, "Prior Month", "Other Month"))
			
			```
		lineageTag: 9f67f179-3093-4ec6-9293-924a2ebfe401
		summarizeBy: none

