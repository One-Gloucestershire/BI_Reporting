table 104_day
	lineageTag: ea080d2a-1c9f-4d01-8aff-42d2cc342e93

	measure 104_day_performance_current_month = CALCULATE([104_day_waits],'Month Flag Reference'[Month Flag] = "Current Month")
		formatString: 0
		lineageTag: 64d1ccba-af7c-470a-820d-8c6a58916a0a

	measure 104_day_waits = CALCULATE(sum('104_day'[counter]))
		formatString: 0
		lineageTag: 6b2fae33-8c01-4fbd-b4da-8c9caf09a733

	measure 104_day_performance_prior_month = CALCULATE([104_day_waits],'Month Flag Reference'[Month Flag] = "Prior Month")
		formatString: 0
		lineageTag: 4a9a689a-e275-46b1-a734-fb8e7899dbca

	measure 104_day_performance_month_improvement =
			IF([104_day_performance_current_month] > [104_day_performance_prior_month], "increased",
			                                        IF([104_day_performance_current_month] < [104_day_performance_prior_month], "decreased",
			                                        IF([104_day_performance_current_month] = [104_day_performance_prior_month], "remained the same",
			                                        "error")))
		lineageTag: 6376138b-a2bb-4de3-9574-b42af18bc0a6

	measure 'Top Tumour Type for 104 Day Waits' =
			
			VAR RankedPosition = 1
			VAR _RankTable =
			    ADDCOLUMNS (
			        VALUES ( '104_day'[tumour_type] ),
			        "@Breaches",
			            CALCULATE (
			                SUM ( '104_day'[counter] ),
			                KEEPFILTERS ( 'Month Flag Reference'[Month Flag] = "Current Month" )
			            ),
			        "@Rank",
			            RANKX (
			                ALLSELECTED ( '104_day'[tumour_type] ),
			                CALCULATE (
			                    SUM ( '104_day'[counter] ),
			                    KEEPFILTERS ( 'Month Flag Reference'[Month Flag] = "Current Month" )
			                ),
			                ,
			                DESC,
			                DENSE
			            )
			    )
			RETURN
			CONCATENATEX (
			    FILTER ( _RankTable, [@Rank] = RankedPosition ),
			    '104_day'[tumour_type],
			    ", "
			)
		lineageTag: a77ad50b-f4e5-42bd-996a-f5879c3eab3f

	measure Rank =
			RANKX(
			                ALL('104_day'[tumour_type]),
			                [104_day_performance_current_month],
			                ,
			                DESC
			            )
		formatString: 0
		lineageTag: c9709742-91c8-4157-ab8f-2b7aa803f9ca

	measure TumourTypeWithHighestCounter_CurrentMonth =
			
			VAR MaxCounter =
			    CALCULATE(
			        MAX('104_day'[counter]),
			        '104_day'[Month flag] = "Current Month"
			    )
			RETURN
			    CALCULATE(
			        FIRSTNONBLANK('104_day'[tumour_type], 1),
			        '104_day'[counter] = MaxCounter,
			        '104_day'[Month flag] = "Current Month"
			    )
		lineageTag: 3a3545a9-066a-4a81-8d4c-893fc35b65e8

	measure 104_day_breaches_for_ranking = CALCULATE(SUM('104_day'[counter]),'Month Flag Reference'[Month Flag] = "Current Month")
		formatString: 0
		lineageTag: cd2db379-ef13-40df-bced-943169192880

	measure 'Ranking tumour type gp referred breach 104 days' = ```
			
			
			
			
			    CALCULATE(
			
			            RANKX(
			                ALL('104_day'),
			                [104_day_breaches_for_ranking],
			                ,
			                DESC
			            ) ) -1
			```
		formatString: 0
		lineageTag: ef6badb1-9d74-4c75-afe6-4d52728e1730

	measure 'Ranking tumour type gp referred breach 104 days 2' =
			
			
			RANKX('104_day',CALCULATE(SUM('104_day'[counter]),'Month Flag Reference'[Month Flag] = "Current Month"))
		formatString: 0
		lineageTag: 8c83671b-efbc-4208-8936-c65fd601d73d

	measure '104 Day Top Tumour Type Breaches (Current Month)' =
			
			VAR RankedPosition = 1
			VAR _RankTable =
			    ADDCOLUMNS (
			        VALUES ( '104_day'[tumour_type] ),
			        "@Breaches",
			            CALCULATE (
			                SUM ( '104_day'[counter] ),
			                KEEPFILTERS ( 'Month Flag Reference'[Month Flag] = "Current Month" )
			            ),
			        "@Rank",
			            RANKX (
			                ALLSELECTED ( '104_day'[tumour_type] ),
			                CALCULATE (
			                    SUM ( '104_day'[counter] ),
			                    KEEPFILTERS ( 'Month Flag Reference'[Month Flag] = "Current Month" )
			                ),
			                ,
			                DESC,
			                DENSE
			            )
			    )
			RETURN
			SUMX ( FILTER ( _RankTable, [@Rank] = RankedPosition ), [@Breaches] )
		formatString: 0
		lineageTag: 3f098a94-1ece-450a-9463-f920134f1d3f

	measure '104 Day Top Tumour Type Breach % (Current Month)' =
			
			VAR _TopBreaches = [104 Day Top Tumour Type Breaches (Current Month)]
			VAR _TotalBreaches =
			    CALCULATE (
			        SUM ( '104_day'[counter] ),
			        KEEPFILTERS ( 'Month Flag Reference'[Month Flag] = "Current Month" )
			    )
			RETURN
			DIVIDE ( _TopBreaches, _TotalBreaches )
		lineageTag: 26aeb879-cc98-40a1-a9a5-313c18a82fd3

