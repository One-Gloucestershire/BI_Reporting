		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "Data_Mart_Performance", [Query="#(lf)---------------------------------------------------------------------------#(lf)---------- CANCER WAIT TIMES PERFORMANCE METRICS TOTAL OVERVIEW ----------- #(lf)---------------------------------------------------------------------------#(lf)#(lf)------------------------------#(lf)--- TWO WEEK WAIT STANDARD ---#(lf)------------------------------#(lf)#(lf)SELECT [Type] = '2WW'#(lf)      ,[Provider_Code] [Provider Code]#(lf)#(tab)  ,CASE WHEN [Provider_Code] = 'RTE' THEN 'Gloucestershire Hospitals NHS Foundation Trust'#(lf)            ELSE 'Other Provider' END AS [Provider Group]#(lf)      ,[Tumour_Type] [Tumour Type]#(lf)#(tab)  ,CASE WHEN [Tumour_Type] = 'acute leukaemia' THEN 'Acute Leukaemia'#(lf)#(tab)        WHEN [Tumour_Type] LIKE '%brain%' THEN 'Brain / Central Nervous System'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%breast%' THEN 'Breast'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%children%' THEN 'Childrens Cancer'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%gynaecological%' THEN 'Gynaecological'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%Suspected haematological malignancies excluding acute leukaemia%' THEN 'Haematological'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%Head and Neck%' THEN 'Head and Neck'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%lower gastrointestinal%' THEN 'Lower Gastrointestinal'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%lung%' THEN 'Lung'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%other%' THEN 'Other'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%sarcoma%' THEN 'Sarcoma'#(tab)   #(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%skin%' THEN 'Skin'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%suspected testicular%' THEN 'Testicular'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%upper gastrointestinal%' THEN 'Upper Gastrointestinal'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%Suspected urological cancers (excluding testicular)%' THEN 'Urological'#(lf)#(tab)#(tab)#(tab)ELSE 'ERROR' END AS [Tumour Group]#(lf)#(tab)#(tab)#(lf)      ,[Total_Referrals_Seen_During_The_Period] [Total]#(lf)#(tab)  ,[Breaches] = ([Seen_15_To_16_Days]+[Seen_17_To_21_Days]+[Seen_22_To_28_Days]+[Seen_After_28_Days])#(lf)      ,[%_Meeting_Standard] [Performance]#(lf)      ,[Report_Number] [Report Number]#(lf)#(tab)  ,CASE WHEN [Report_Number] = '6.3' THEN '6.3 - Two Week Wait'#(lf)#(tab)        WHEN [Report_Number] = '6.4' THEN '6.4 - Breast Symptom Two Week Wait'#(lf)#(tab)#(tab)#(tab)ELSE 'ERROR' END AS [Report Name]#(lf)#(tab)  ,[B].[FinancialYear] [Financial Year]#(lf)      ,LEFT([Report_Month],3) as [Month]#(lf)#(tab)    ,[B].[FinancialMonth] [Financial Month]#(lf)      --,[Organisation_Type] [Organisation Type]#(lf)      --,[Organisation_Code] [Organisation Code]#(lf)  INTO #TEMP#(lf)  FROM [Data_Mart_Performance].[dbo].[Cancer_2_Week_Aggregate_Data] [A]#(lf)  LEFT JOIN  [CCG_Reference].[Reference].[vw_DateLookup] [B] on [A].[Report_Date] = [B].[Date]#(lf)  WHERE [Report_Date] > '20190331'#(lf)  AND [Extract_Type] = 'Monthly'#(lf)#(lf)  UNION ALL#(lf)#(lf)------------------------------------#(lf)--- 31 DAY TUMOUR GROUP STANDARD ---#(lf)------------------------------------#(lf)#(lf)SELECT [Type] = '31 Day Tumour'#(lf)      ,[Provider_Code] [Provider Code]#(lf)#(tab)  ,CASE WHEN [Provider_Code] = 'RTE' THEN 'Gloucestershire Hospitals NHS Foundation Trust'#(lf)            ELSE 'Other Provider' END AS [Provider Group]#(lf)      ,[Tumour_Type] [Tumour Type]#(lf)#(tab)  ,CASE WHEN [Tumour_Type] LIKE '%acute leukaemia%' THEN 'Acute Leukaemia'#(lf)#(tab)        WHEN [Tumour_Type] LIKE '%brain%' THEN 'Brain / Central Nervous System'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%breast%' THEN 'Breast'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%children%' THEN 'Childrens Cancer'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%gynaecological%' THEN 'Gynaecological'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%Haematological%' THEN 'Haematological'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%Head and Neck%' THEN 'Head and Neck'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%lower gastrointestinal%' THEN 'Lower Gastrointestinal'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%lung%' THEN 'Lung'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%other%' THEN 'Other'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%sarcoma%' THEN 'Sarcoma'#(tab)   #(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%skin%' THEN 'Skin'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%Testicular%' THEN 'Testicular'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%upper gastrointestinal%' THEN 'Upper Gastrointestinal'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%Urological%' THEN 'Urological'#(lf)#(tab)#(tab)#(tab)ELSE 'ERROR' END AS [Tumour Group]#(lf)#(tab)  ,[Total_Treated] [Total]#(lf)#(tab)  ,[Treated_After_31_Days] [Breaches]#(lf)      ,[%_Meeting_Standard] [Performance]#(lf)      ,[Report_Number] [Report Number]#(lf)#(tab)  ,CASE WHEN [Report_Number] = '7.4' THEN '7.4 - 31 Day First Treatment'#(lf)#(tab)#(tab)#(tab)ELSE 'ERROR' END AS [Report Name]#(lf)#(tab)  ,[B].[FinancialYear] [Financial Year]#(lf)      ,LEFT([Report_Month],3) as [Month]#(lf)#(tab)    ,[B].[FinancialMonth] [Financial Month]#(lf)      --,[Organisation_Type] [Organisation Type]#(lf)      --,[Organisation_Code] [Organisation Code]#(lf)      --,[Patients_Treated_Following_Urgent_Referral_Suspected_Cancer]#(lf)      --,[Patients_Treated_Following_Urgent_Referral_Breast_Symptoms]#(lf)      --,[Patients_Treated_Following_Urgent_Referral_NHS_Screening]#(lf)      --,[Patients_Treated_Following_Urgent_Referral_Another_Source_Or_Urgency]      #(lf) #(lf)  FROM [Data_Mart_Performance].[dbo].[Cancer_31_Day_Aggregate_Data] [A]#(lf)  LEFT JOIN  [CCG_Reference].[Reference].[vw_DateLookup] [B] ON [A].[Report_Date] = [B].[Date]#(lf)  WHERE [Report_Date] > '20190331'#(lf)  AND [Extract_Type] = 'Monthly'#(lf)#(lf)  UNION ALL