table 'Cancer Deep Dive'
	lineageTag: d1264c58-6239-4713-aa59-bb731ec88724

	measure 'Performance %' = (SUM('Cancer Deep Dive'[Total])-SUM('Cancer Deep Dive'[Breaches]))/SUM('Cancer Deep Dive'[Total])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 7309a620-7d17-4beb-80a9-b833acef2160

	measure 'Average Target' = AVERAGE('Cancer Deep Dive'[Target %])
