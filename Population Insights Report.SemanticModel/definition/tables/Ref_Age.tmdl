		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db01_reference"), "select age as ""Age"", ""5yr_age_band"" as ""5YR_Age_Band"", ""10yr_age_band"" as ""10YR_Age_Band"", case when age between 0 and 17 then '< 18' when age between 18 and 64 then '18-64' when age between 65 and 84 then '65-84' when age <= 85 then '85+' else null end as ""Wider_Age_Bands"", case when age between 0 and 17 then 1 when age between 18 and 64 then 2 when age between 65 and 84 then 3 when age <= 85 then 4 else null end as ""Wider_Age_Bands_Order"" from ccg_reference.vw_ageband where age between 0 and 120", null, [EnableFolding=true])
