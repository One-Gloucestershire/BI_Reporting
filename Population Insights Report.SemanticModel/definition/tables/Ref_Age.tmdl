	partition Ref_Age = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Reference", [Query="SELECT [Age]#(lf)      ,[5YR_Age_Band]#(lf)      ,[10YR_Age_Band]#(lf)      ,[Wider_Age_Bands] = CASE WHEN [Age] BETWEEN 0 AND 17 THEN '< 18'#(lf)                                WHEN [Age] BETWEEN 18 AND 64 THEN '18-64'#(lf)#(tab)#(tab)#(tab)  WHEN [Age] BETWEEN 65 AND 84 THEN '65-84'#(lf)#(tab)#(tab)#(tab)  WHEN [Age] <= 85 THEN '85+'#(lf)#(tab)#(tab)#(tab)  ELSE NULL END#(lf)      ,[Wider_Age_Bands_Order] = CASE WHEN [Age] BETWEEN 0 AND 17 THEN 1#(lf)                                      WHEN [Age] BETWEEN 18 AND 64 THEN 2#(lf)                                      WHEN [Age] BETWEEN 65 AND 84 THEN 3#(lf)                                      WHEN [Age] <= 85 THEN 4#(lf)                                      ELSE NULL END#(lf)#(lf)FROM [CCG_Reference].[Reference].[vw_AgeBand]#(lf)#(lf)WHERE [Age] BETWEEN 0 AND 120"])
				in
				    Source

