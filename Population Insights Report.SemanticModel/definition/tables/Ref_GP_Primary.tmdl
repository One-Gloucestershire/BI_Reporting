	partition Ref_GP_Primary = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db01_reference"), "with gp as (select case when reportingorganisationname='West Cheltenham Medical' then 'TWNS' when primarycarenetwork='Tewkesbury, Newent and Staunton and West Cheltenham Medical' then 'TWNS' else primarycarenetwork end as ""INT"", case when reportingorganisationname='West Cheltenham Medical' then 'Tewkesbury' when locality='Tewkesbury Newent and Staunton' then 'Tewkesbury' else locality end as ""Locality"", organisationcode as ""OrganisationCode"", case when reportingorganisationcode='L84073' then 'L84075' when reportingorganisationcode='L84017' then 'L84018' else reportingorganisationcode end as ""ReportingOrganisationCode"", case when reportingorganisationname='Acorn Practice' then 'May Lane Surgery' when reportingorganisationname='Regent Street Surgery' then 'The Willow Tree Practice' when reportingorganisationname='Coleford Family Doctors' then 'Coleford Medical Practice' else reportingorganisationname end as ""ReportingOrganisationName"" from icb_data_reference.vw_gppractice where commissioner ilike '11m%' and locality is not null) select gp.*, c.gplatitude as ""GPLatitude"", c.gplongitude as ""GPLongitude"" from gp left join (select distinct practice_code as gp_practice_code, gp_longitude as gplatitude, gp_latitude as gplongitude from db02_nopid.data_mart_primarycare.tbl01_gp_practice_populations where gp_latitude is not null) c on c.gp_practice_code=gp.""ReportingOrganisationCode""", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

