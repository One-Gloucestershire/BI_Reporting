table Ref_GP_Primary
	lineageTag: 9341d07f-865c-4e52-89e1-95c8c6271d4e

	measure 'Ref_GP_Primary Selected Option' =
			
			
			VAR LocalitySelected = SELECTEDVALUE('Ref_GP_Primary'[Locality])
			VAR PCNSelected = SELECTEDVALUE('Ref_GP_Primary'[INT])
			RETURN
			IF (
			    NOT ISBLANK(PCNSelected),
			        PCNSelected,
			    IF (
			        NOT ISBLANK(LocalitySelected),
			            LocalitySelected,
			            "Gloucestershire Registered"
			    )
			)
		lineageTag: 8266d6b6-4f8c-4465-ab26-5d49d034dd2b

