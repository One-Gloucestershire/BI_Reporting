table PLS_Geography_Secondary
	lineageTag: 42a6e54e-8532-4eb8-9c93-0eb350627b3b

	measure 'PLS_Geography Secondary Selected Option' =
			
			
			VAR DistrictSelected = SELECTEDVALUE('PLS_Geography_Secondary'[DistrictDescription])
			VAR WardSelected = SELECTEDVALUE('PLS_Geography_Secondary'[WardName])
			RETURN
			IF (
			    NOT ISBLANK(WardSelected),
			        WardSelected,
			    IF (
			        NOT ISBLANK(DistrictSelected),
			            DistrictSelected,
			            "Any Gloucestershire Residence"
			    )
			)
		lineageTag: f80109f4-9819-4175-9ade-3ac36b57823b

