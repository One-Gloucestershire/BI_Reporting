	partition PLS_Geography_Secondary = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "select distinct g.pseudonhsnumber as ""PseudoNHSNumber"", g.lsoacode as ""LSOACode"", g.wardname as ""WardName"", g.districtdescription as ""DistrictDescription"", g.ruralurbanclassification as ""RuralUrbanClassification"", g.ruralurbanflag as ""RuralurbanFlag"", g.imdnationaldecile as ""IMD_England_Decile"", l.derived_imdgloucestershiredecile as ""IMD_Gloucester_Decile"", g.core20flag as ""Core20Flag"", g.derivedislivingalone as ""DerivedIsLivingAlone"", g.derivedislivingincarehome as ""DerivedIsLivingInCareHome"", g.countyofresidence as ""CountyofResidence"" from data_mart_pls.vw_imd_and_geography g left join db01_reference.ccg_reference.vw_lsoa_imd l on l.lsoacode=g.lsoacode", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table

