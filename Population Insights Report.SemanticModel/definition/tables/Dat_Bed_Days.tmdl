	partition Dat_Bed_Days = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Current", [Query="/*=======================================================================================#(lf)STAGE 1 - SETTING TIME FRAMES#(lf)=======================================================================================*/#(lf)#(lf)/* Time frame to match PLS activity table to allow data to be comparable */#(lf)IF OBJECT_ID ('TEMPDB..#TEMP_TIME_RANGE') IS NOT NULL DROP TABLE #TEMP_TIME_RANGE#(lf);#(lf)#(lf)SELECT [Start_Date] = MIN([ActivityEndDate])#(lf)      ,[End_Date] = MAX([ActivityEndDate])#(lf)#(lf)INTO #TEMP_TIME_RANGE#(lf)FROM [ICB_Products].[Patient].[vw_Activity]#(lf)#(lf)WHERE [ActivityEndDate] <> '1900-01-01'#(lf);#(lf)#(lf)/*=======================================================================================#(lf)STAGE 2 - ADMISSIONS TABLE#(lf)=======================================================================================*/#(lf)#(lf)/* Gloucester ICB Registered admissions during the established time range */#(lf)IF OBJECT_ID ('TEMPDB..#TEMP_ADMISSIONS') IS NOT NULL DROP TABLE #TEMP_ADMISSIONS#(lf);#(lf)#(lf)SELECT [NHS_Number] = [HPS].[spell_patient_identity_nhs_number_value]#(lf)      ,[Admission_Date] = [HPS].[spell_admission_date]#(lf)      ,[Discharge_Date] = [HPS].[spell_discharge_date]#(lf)      ,[Site] = [HPS].[site_name_of_treatment_at_episode_end_date]#(lf)      ,[HPS].[spell_admission_method]#(lf)      ,[Patient_Age] = [HPS].[spell_patient_identity_age_at_cds_activity_date]#(lf)      ,[Spell_ID] = [spell_hospital_provider_spell_number]#(lf)#(lf)INTO #TEMP_ADMISSIONS#(lf)FROM [CCG_Current].[UnifiedSUS].[vw_HospitalProviderSpell] AS [HPS]#(lf)#(lf)CROSS JOIN #TEMP_TIME_RANGE AS [DATE]#(lf)#(lf)WHERE [HPS].[spell_discharge_date] BETWEEN [DATE].[Start_Date] AND [DATE].[End_Date]#(lf)AND LEFT([HPS].[spell_commissioning_service_agreement_commissioner], 3) IN ('11M', 'QR1')#(lf);#(lf)#(lf)/*=======================================================================================#(lf)STAGE 3 - ACG CATEGORY DURING PERIOD#(lf)=======================================================================================*/#(lf)#(lf)/* Using ACG census within the timeframe, the JOIN is using firstdateofmonth so it can correctly link to census dates */#(lf)IF OBJECT_ID ('TEMPDB..#TEMP_ACG') IS NOT NULL DROP TABLE #TEMP_ACG#(lf);#(lf)#(lf)SELECT [ACG].[Month]#(lf)      ,[ACG].[PseudoNHSNumber]#(lf)      ,[ACG].[Patient_Need_Group]#(lf)#(lf)INTO #TEMP_ACG#(lf)FROM [CCG_Current].[ACG].[vw_ACGResults] AS [ACG]#(lf)#(lf)CROSS JOIN (#(lf)            SELECT [Start_Date] = [DATE_START].[FirstDateofMonth]#(lf)#(tab)        ,[End_Date] = [DATE_END].[FirstDateofMonth]#(lf)#(tab)  #(lf)#(tab)  FROM #TEMP_TIME_RANGE AS [TIME_RANGE]#(lf)#(lf)#(tab)#(tab)LEFT JOIN (#(lf)#(tab)#(tab)           SELECT DISTINCT [Date]#(lf)#(tab)#(tab)#(tab)                ,[FirstDateofMonth]#(lf)#(tab)#(tab)           FROM [CCG_Reference].[Reference].[vw_DateLookup]#(lf)#(tab)#(tab)          ) AS [DATE_START]#(lf)#(tab)#(tab)ON [DATE_START].[Date] = [TIME_RANGE].[Start_Date]#(lf)#(lf)#(tab)#(tab)LEFT JOIN (#(lf)#(tab)#(tab)           SELECT DISTINCT [Date]#(lf)#(tab)#(tab)#(tab)                ,[FirstDateofMonth]#(lf)#(tab)#(tab)           FROM [CCG_Reference].[Reference].[vw_DateLookup]#(lf)#(tab)#(tab)          ) AS [DATE_END]#(lf)#(tab)#(tab)ON [DATE_END].[Date] = [TIME_RANGE].[End_Date]#(lf)#(tab) ) AS [DATE]#(lf)#(lf)WHERE [ACG].[Month] BETWEEN [DATE].[Start_Date] AND [DATE].[End_Date]#(lf);#(lf)#(lf)/*=======================================================================================#(lf)STAGE 4 - FINAL OUTPUT#(lf)=======================================================================================*/#(lf)#(lf)IF OBJECT_ID ('TEMPDB..#TEMP_OUTPUT') IS NOT NULL DROP TABLE #TEMP_OUTPUT#(lf);#(lf)#(lf)SELECT [ADM].[NHS_Number]#(lf)      ,[ADM].[Admission_Date]#(lf)      ,[ADM].[Discharge_Date]#(lf)      ,[ADM].[spell_admission_method]#(lf)      ,[ADM].[Site]#(lf)      ,[Patient_Need_Group] = COALESCE([ACG1].[Patient_Need_Group], [ACG2].[Patient_Need_Group])#(lf)      ,[ADM].[Patient_Age]#(lf)      ,[GP].[PracticeCode]#(lf)      ,[RN] = ROW_NUMBER () OVER (PARTITION BY [ADM].[NHS_Number], [ADM].[Spell_ID] ORDER BY [ADM].[Discharge_Date])#(lf)      ,[Admission_Counter] = 1#(lf)#(lf)INTO #TEMP_OUTPUT#(lf)FROM #TEMP_ADMISSIONS AS [ADM]#(lf)#(lf)OUTER APPLY (#(lf)             SELECT TOP 1 [ACG].[Patient_Need_Group]#(lf)#(tab)   FROM #TEMP_ACG AS [ACG]#(lf)#(tab)   WHERE [ACG].[PseudoNHSNumber] = [ADM].[NHS_Number]#(lf)#(tab)   AND [ACG].[Month] <= [ADM].[Discharge_Date]#(lf)#(tab)   ORDER BY [ACG].[Month] DESC#(lf)/* Finds closest record before the discharge date */#(lf)#(tab)  ) AS [ACG1]#(lf)#(lf)OUTER APPLY (#(lf)             SELECT TOP 1 [ACG].[Patient_Need_Group]#(lf)             FROM #TEMP_ACG AS [ACG]#(lf)             WHERE [ACG].[PseudoNHSNumber] = [ADM].[NHS_Number]#(lf)             AND [ACG].[Month] > [ADM].[Discharge_Date]#(lf)             ORDER BY [ACG].[Month] ASC#(lf)/* Finds the closest record after the discharge date, this is for if [ACG1] is NULL */#(lf)             ) AS [ACG2]#(lf)#(lf)LEFT JOIN (#(lf)           SELECT DISTINCT [PseudoNHSNumber]#(lf)#(tab)#(tab)      ,[PracticeCode]#(lf)#(tab)                ,[DateRegistration]#(lf)#(tab)#(tab)      ,[DateDeregistration] = ISNULL([DateDeregistration], CAST(GETDATE() AS DATE))#(lf)#(lf)           FROM [CCG_Current].[PrimaryCare].[vw_Patients]#(lf)          ) AS [GP]#(lf)ON [GP].[PseudoNHSNumber] = [ADM].[NHS_Number]#(lf)AND [ADM].[Discharge_Date] BETWEEN [GP].[DateRegistration] AND [GP].[DateDeregistration]#(lf)#(lf)WHERE [ADM].[NHS_Number] IS NOT NULL#(lf)AND COALESCE([ACG1].[Patient_Need_Group], [ACG2].[Patient_Need_Group]) IS NOT NULL#(lf);#(lf)#(lf)#(lf)SELECT [NHS_Number]#(lf)      ,[Bed_Days] = CASE WHEN DATEDIFF(DAY, [Admission_Date], [Discharge_Date]) < 0 THEN 0#(lf)                         ELSE DATEDIFF(DAY, [Admission_Date], [Discharge_Date]) END#(lf)      ,[Elective_Type] = CASE WHEN [spell_admission_method] LIKE '1%' THEN 'Elective'#(lf)                              ELSE 'Non-Elective' END#(lf)      ,[Admission_Type] = CASE WHEN [spell_admission_method] LIKE '1%' THEN 'Elective'#(lf)                               WHEN [spell_admission_method] LIKE '2%' THEN 'Emergency'#(lf)#(tab)#(tab)#(tab) WHEN [spell_admission_method] LIKE '3%' AND [Patient_Age] < 55 THEN 'Maternity'#(lf)#(tab)#(tab)#(tab) WHEN [spell_admission_method] LIKE '3%' AND [Patient_Age] >= 55 THEN 'Not Known'#(lf)#(tab)#(tab)#(tab) WHEN [spell_admission_method] IN ('98', '99') THEN 'Not Known'#(lf)#(tab)#(tab)#(tab) ELSE 'Non-Elective' END#(lf)      ,[Site_Type] = CASE WHEN [Site] IN ('GLOUCESTERSHIRE ROYAL HOSPITAL', 'CHELTENHAM GENERAL HOSPITAL') THEN 'Acute'#(lf)                          WHEN [Site] IN ('STROUD GENERAL HOSPITAL', 'CIRENCESTER HOSPITAL', 'TEWKESBURY COMMUNITY HOSPITAL'#(lf)#(tab)#(tab)                     ,'FOREST OF DEAN COMMUNITY HOSPITAL', 'NORTH COTSWOLD HOSPITAL', 'VALE HOSPITAL') THEN 'Community'#(lf)#(tab)#(tab)      ELSE 'Other Provider' END#(lf)      ,[Discharge_Date]#(lf)      ,[Patient_Need_Group]#(lf)      ,[Patient_Age]#(lf)      ,[PracticeCode]#(lf)      ,[Admission_Counter] = 1#(lf)#(lf)FROM #TEMP_OUTPUT#(lf)#(lf)WHERE [RN] = 1"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

