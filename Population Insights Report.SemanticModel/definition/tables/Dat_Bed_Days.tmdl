	measure 'Dat_Bed_Days Average LoS (No 0 LOS)' = ```
			
			
			VAR _BEDDAYS = 
			
			    CALCULATE(
			        SUM('Dat_Bed_Days'[Bed_Days]),
			        'Dat_Bed_Days'[Bed_Days] > 0
			    )
			
			VAR _ADMISSIONS =
			
			    CALCULATE(
			        SUM('Dat_Bed_Days'[Admission_Counter]),
			        'Dat_Bed_Days'[Bed_Days] > 0
			    )
			
			RETURN
			
			_BEDDAYS / _ADMISSIONS
			```
		lineageTag: 09fc1811-69ea-4c64-b7c9-5c2d495ea785

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Dat_Bed_Days Bed Days per Person ALIVE' =
			
			
