	partition Ref_GP_Secondary = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Reference", [Query="WITH GP_CTE AS#(lf)(#(lf)SELECT [INT] = CASE WHEN [ReportingOrganisationName] LIKE 'West Cheltenham Medical' THEN 'TWNS'#(lf)#(tab)          WHEN [PrimaryCareNetwork] LIKE 'Tewkesbury, Newent and Staunton and West Cheltenham Medical' THEN 'TWNS'#(lf)                    ELSE [PrimaryCareNetwork] END#(lf)      ,[Locality] = CASE WHEN [ReportingOrganisationName] LIKE 'West Cheltenham Medical' THEN 'Tewkesbury'#(lf)                         WHEN [Locality] = 'Tewkesbury Newent and Staunton' THEN 'Tewkesbury'#(lf)                         ELSE [Locality] END#(lf)      ,[OrganisationCode]#(lf)      ,[ReportingOrganisationCode] = CASE WHEN [ReportingOrganisationCode] LIKE 'L84073' THEN 'L84075' /*Acorn Practice*/#(lf)#(tab)                                WHEN [ReportingOrganisationCode] LIKE 'L84017' THEN 'L84018' /*Cirencester Health Group*/#(lf)#(tab)                                ELSE [ReportingOrganisationCode] END #(lf)      ,[ReportingOrganisationName] = CASE WHEN [ReportingOrganisationName] LIKE 'Acorn Practice' THEN 'May Lane Surgery' #(lf)#(tab)                                WHEN [ReportingOrganisationName] LIKE 'Regent Street Surgery' THEN 'The Willow Tree Practice'#(lf)#(tab)                                WHEN [ReportingOrganisationName] LIKE 'Coleford Family Doctors' THEN 'Coleford Medical Practice'#(lf)#(tab)                                ELSE [ReportingOrganisationName] END#(lf)#(lf)FROM [CCG_Reference].[Reference].[vw_GPPractice]#(lf)WHERE [Commissioner] = '11M'#(lf)AND [Locality] IS NOT NULL#(lf))#(lf)SELECT [GP].*#(lf)      ,[COORD].[GPLatitude]#(lf)      ,[COORD].[GPLongitude]#(lf)#(lf)FROM GP_CTE AS [GP]#(lf)#(lf)LEFT JOIN (#(lf)           SELECT DISTINCT [GP_Practice_Code]#(lf)                          ,[GPLatitude]#(lf)#(tab)#(tab)      ,[GPLongitude]#(lf)           FROM [PowerBI_Reporting].[PHM].[tbl02_DemographicsOverview]#(lf)#(tab)) AS [COORD] #(lf)ON [COORD].[GP_Practice_Code] = [GP].[ReportingOrganisationCode]"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

