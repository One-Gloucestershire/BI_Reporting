table Ref_GP_Secondary
	lineageTag: dfc88baa-e867-43cb-a77a-84e664859370

	measure 'Ref_GP_Secondary Selected Option' =
			
			
			VAR LocalitySelected = SELECTEDVALUE('Ref_GP_Secondary'[Locality])
			VAR PCNSelected = SELECTEDVALUE('Ref_GP_Secondary'[INT])
			RETURN
			IF (
			    NOT ISBLANK(PCNSelected),
			        PCNSelected,
			    IF (
			        NOT ISBLANK(LocalitySelected),
			            LocalitySelected,
			            "Gloucestershire Registered"
			    )
			)
		lineageTag: 5eb163c3-7895-4b24-80db-846e481ea661

