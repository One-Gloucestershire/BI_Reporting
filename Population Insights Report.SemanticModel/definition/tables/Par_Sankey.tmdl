		mode: import
		source =
				{
				    ("12 Month Period", NAMEOF('Dat_Sankey'[Middle_Health_Group]), 0),
				    ("24 Month Period", NAMEOF('Dat_Sankey'[End_Health_Group]), 1)
				}

	annotation PBI_Id = 60e3aca4c4214552a00c2e16cef3dff7

