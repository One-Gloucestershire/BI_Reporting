table Sankey_End
	lineageTag: bb79ade5-5854-469b-8695-95f72f0b3874

	measure 'Sankey Period' = ```
			
			
			VAR _START = MAX('Sankey_Start'[Sankey_Month])
			VAR _END = MAX('Sankey_End'[Sankey_Month])
			
			VAR _PERIOD = DATEDIFF(_START, _END, MONTH) + 1
			
			RETURN 
			
			CONCATENATE(_PERIOD, " Month Period")
			```
		lineageTag: eda63df2-e7e8-4bf3-a3c3-e17f27cc24cd

	measure 'Total Sankey Population - End' = ```
			
			
			    CALCULATE(
			    SUM('Sankey_End'[Counter]),
			    USERELATIONSHIP('Ref_Sankey_Group_Mapping'[Sankey_PNG], 'Sankey_End'[Sankey_PNG]),
			    USERELATIONSHIP('Ref_GP_Primary'[OrganisationCode], 'Sankey_End'[Practice_Code]),
			    NOT 'Ref_Sankey_Group_Mapping'[Sankey_Health_Group] IN {"New Patient", "Patient Died", "Left Population"}
			    )
			```
		formatString: #,0
		lineageTag: 58d838d6-e883-4790-a60d-c913fdf0c3c6

	measure 'Sankey Population Change' =
			
			
			SWITCH(
			    TRUE(),
			    [Total Sankey Population - Start Table] = BLANK(),
			    BLANK(),
			    [Total Sankey Population - End] - [Total Sankey Population - Start Table]
			)
		lineageTag: d92758c0-d64a-4dad-87b5-ad4c09bba9b8

		formatStringDefinition = "+,0;- ,0;0"

	measure 'Sankey Population Change - %' = ```
			
			
			IFERROR(
			    ([Total Sankey Population - End] - [Total Sankey Population - Start Table]) / [Total Sankey Population - Start Table]
			    , BLANK()
			)
			
			```
		lineageTag: 54459451-197b-4ac4-9bd7-5dce9f8ca69f

		formatStringDefinition = "+0.0%;-0.0%;0.0%"

	measure 'Total Sankey Population - End (From Start Group)' =
			
			
			CALCULATE(
			    SUM('Sankey_End'[Counter]),
			
			    -- Link people from start to end
			    TREATAS(
			        VALUES('Sankey_Start'[PseudoNHSNumber]),
			        'Sankey_End'[PseudoNHSNumber]
			    )
			)
		formatString: #,0
		lineageTag: 603aa819-93e5-43d4-8c01-537abe7713c7

