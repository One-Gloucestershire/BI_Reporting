	partition Sankey_End = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "select sankey_month as ""Sankey_Month"", pseudonhsnumber as ""PseudoNHSNumber"", practice_code as ""Practice_Code"", sankey_png as ""Sankey_PNG"", sankey_health_group as ""Sankey_Health_Group"", counter as ""Counter"", last_updated as ""Last_Updated"" from data_mart_powerbi_phm.tbl08_acg_sankey_populations", null, [EnableFolding=true])
				in
				    Source

