			        SUM('PLS_Summary'[Counter]),
			        ALL('Ref_GP_Primary'),
			        ALL('Ref_Age'),
			        ALL('Ref_LTC')
			    )),
			
			    CONTAINSSTRINGEXACT('Par_Activity_Switch'[Switch Selection], "Cost per Person per Year £ (PPPY)"),
			    (   CALCULATE(
			        SUM('PLS_Activity'[DerivedActivityCost]),
			        ALL('Ref_GP_Primary'),
			        ALL('Ref_Age'),
			        ALL('Ref_LTC')
			        )
			        /  
			        CALCULATE(
			        SUM('PLS_Summary'[Counter]),
			        ALL('Ref_GP_Primary'),
			        ALL('Ref_Age'),
			        ALL('Ref_LTC')
			    )),
			
			    CONTAINSSTRINGEXACT('Par_Activity_Switch'[Switch Selection], "% of Activity by PNG"),
			    (   CALCULATE(
			        SUM('PLS_Activity'[Counter]),
			        ALL('Ref_GP_Primary'),
			        ALL('Ref_Age'),
			        ALL('Ref_LTC')
			    )
			    /
			    (   CALCULATE(
			        SUM('PLS_Activity'[Counter]),
			        ALL('Ref_PNG'),
			        ALL('Ref_GP_Primary'),
			        ALL('Ref_Age'),
			        ALL('Ref_LTC')
			    ))
			    ),
			
			    CONTAINSSTRINGEXACT('Par_Activity_Switch'[Switch Selection], "% of Cost by PNG"),
			    (   CALCULATE(
			        SUM('PLS_Activity'[DerivedActivityCost]),
			        ALL('Ref_GP_Primary'),
			        ALL('Ref_Age'),
			        ALL('Ref_LTC')
			    )
			    /
			    (   CALCULATE(
			        SUM('PLS_Activity'[DerivedActivityCost]),
			        ALL('Ref_PNG'),
			        ALL('Ref_GP_Primary'),
			        ALL('Ref_Age'),
			        ALL('Ref_LTC')
			    ))
			    ),
			
			    CONTAINSSTRINGEXACT('Par_Activity_Switch'[Switch Selection], "Rate per 1,000 - Activity"),
			    (   CALCULATE(
			        SUM('PLS_Activity'[Counter]),
			        ALL('Ref_GP_Primary'),
			        ALL('Ref_Age'),
			        ALL('Ref_LTC')
			        )
			        /  
			        CALCULATE(
			        SUM('PLS_Summary'[Counter]),
			        ALL('Ref_GP_Primary'),
			        ALL('Ref_Age'),
			        ALL('Ref_LTC')
			    )) * 1000,
			
			    CONTAINSSTRINGEXACT('Par_Activity_Switch'[Switch Selection], "Rate per 1,000 - Cost"),
			    (   CALCULATE(
			        SUM('PLS_Activity'[DerivedActivityCost]),
			        ALL('Ref_GP_Primary'),
			        ALL('Ref_Age'),
			        ALL('Ref_LTC')
			        )
			        /  
			        CALCULATE(
			        SUM('PLS_Summary'[Counter]),
			        ALL('Ref_GP_Primary'),
			        ALL('Ref_Age'),
			        ALL('Ref_LTC')
			    )) * 1000
			)
