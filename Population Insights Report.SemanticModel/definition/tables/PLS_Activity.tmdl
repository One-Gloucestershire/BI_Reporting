	partition PLS_Activity = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "ICB_Products", [Query="#(lf)IF OBJECT_ID ('TEMPDB..#TEMP_ACTIVITY') IS NOT NULL DROP TABLE #TEMP_ACTIVITY#(lf);#(lf)#(lf)SELECT [ACT].[PseudoNHSNumber]#(lf)      ,[ACT].[ActivityType]#(lf)      ,[DATE].[FirstDateofMonth]#(lf)      ,[DerivedActivityCost] = CASE WHEN [ActivityType] = 'Community Care' THEN 83.20 /* Average Unit Cost for 2023/24 GHC */#(lf)                                    WHEN [ActivityType] = 'Mental Health' THEN 265 /* Average Unit Cost for 2023/24 GHC */#(lf)                                    WHEN [ActivityType] = '111' THEN 15.00 /* Average Unit Cost for 2023/24 GHC */#(lf)                                    ELSE [DerivedActivityCost] END#(lf)      ,[ACT].[Counter]#(lf)#(lf)INTO #TEMP_ACTIVITY#(lf)FROM [ICB_Products].[Patient].[vw_Activity] AS [ACT]#(lf)#(lf)LEFT JOIN (#(lf)           SELECT DISTINCT [Date]#(lf)#(tab)                ,[FirstDateofMonth]#(lf)           FROM [CCG_Reference].[Reference].[vw_DateLookup]#(lf)#(tab)) AS [DATE]#(lf)ON [DATE].[Date] = [ACT].[ActivityStartDate]#(lf)#(lf)WHERE [ActivityStartDate] BETWEEN (SELECT DISTINCT [ActivityPeriodStart] FROM  [ICB_Products].[Patient].[vw_Activity_Summary])#(lf)AND (SELECT DISTINCT [ActivityPeriodEnd] FROM  [ICB_Products].[Patient].[vw_Activity_Summary])#(lf);#(lf)#(lf)SELECT [PseudoNHSNumber]#(lf)      ,[ActivityType]#(lf)      ,[FirstDateofMonth]#(lf)      ,[DerivedActivityCost] = SUM([DerivedActivityCost])#(lf)      ,[Counter] = SUM([Counter])#(lf)#(lf)FROM #TEMP_ACTIVITY#(lf)#(lf)GROUP BY [PseudoNHSNumber]#(lf)        ,[ActivityType]#(lf)        ,[FirstDateofMonth]"])
				in
				    Source

