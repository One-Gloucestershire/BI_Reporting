	measure 'PNGs - Proportion of Costs' = ```
			
			
			VAR _NUMERATOR = SUM('PLS_Activity'[DerivedActivityCost])
			
			VAR _DENOMINATOR = 
			
			CALCULATE(
			    SUM('PLS_Activity'[DerivedActivityCost]),
			    ALL('Ref_PNG')
			)
			
			RETURN
			
			_NUMERATOR / _DENOMINATOR
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: b40f80e3-2848-4487-8dbc-0e95cab40f98

	measure 'Activity Period' = ```
			
			
			VAR _ACTIVITY_MIN =  
			
			FORMAT(
			    MIN('PLS_Activity'[FirstDateofMonth]),
			    "MMM-YYYY"
			)
			
			VAR _ACTIVITY_MAX =  
			
			FORMAT(
			    MAX('PLS_Activity'[FirstDateofMonth]),
			    "MMM-YYYY"
			)
			
			RETURN
			
			"Activity Period: " & _ACTIVITY_MIN & " to " & _ACTIVITY_MAX
			```
