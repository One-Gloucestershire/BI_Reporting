			)
		lineageTag: 189f0fb9-a5e3-4b56-b9db-5c5a2ba65f60

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Activity - Emergency Admissions Rate per 1,000' = ```
			
			
			VAR _ACTIVITY = 
			
			CALCULATE(
			    SUM('PLS_Activity'[Counter]),
			    'PLS_Activity'[ActivityType] = "Emergency Admission"
			)
			
			VAR _POPULATION = 
			
			SUM('PLS_Summary'[Counter])
			
			RETURN
			
			(_ACTIVITY / _POPULATION) * 1000
			```
		formatString: 0.0
		lineageTag: 9fc58d65-0a52-418a-b732-a01dedab9104

