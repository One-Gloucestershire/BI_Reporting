	measure 'Parameter Switch - Activity Metrics' = ```
			
			
			SWITCH(
			    TRUE(),
			
			    CONTAINSSTRINGEXACT('Par_Activity_Switch'[Switch Selection], "Total Activity"), 
			        CALCULATE(
			        SUM('PLS_Activity'[Counter])
			        ),
			
			    CONTAINSSTRINGEXACT('Par_Activity_Switch'[Switch Selection], "Total Cost £"),
			        CALCULATE(
			        SUM('PLS_Activity'[DerivedActivityCost])
			        ),
			    
			    CONTAINSSTRINGEXACT('Par_Activity_Switch'[Switch Selection], "Activity per Person per Year (PPPY)"), 
			    (   CALCULATE(
			        SUM('PLS_Activity'[Counter])
			        )
			        /  
			        SUM('PLS_Summary'[Counter])
			    ),
			
			    CONTAINSSTRINGEXACT('Par_Activity_Switch'[Switch Selection], "Cost per Person per Year £ (PPPY)"),
			    (   CALCULATE(
			        SUM('PLS_Activity'[DerivedActivityCost])
			        )
			        /  
			        SUM('PLS_Summary'[Counter])
			    ),
			
			    CONTAINSSTRINGEXACT('Par_Activity_Switch'[Switch Selection], "% of Activity by PNG"),
			    (   CALCULATE(
			        SUM('PLS_Activity'[Counter])
			    )
			    /
			    (   CALCULATE(
			        SUM('PLS_Activity'[Counter]),
			        ALL('Ref_PNG')
			    ))
			    ),
			
			    CONTAINSSTRINGEXACT('Par_Activity_Switch'[Switch Selection], "% of Cost by PNG"),
			    (   CALCULATE(
			        SUM('PLS_Activity'[DerivedActivityCost])
			    )
			    /
			    (   CALCULATE(
			        SUM('PLS_Activity'[DerivedActivityCost]),
			        ALL('Ref_PNG')
			    ))
			    ),
			
			    CONTAINSSTRINGEXACT('Par_Activity_Switch'[Switch Selection], "Rate per 1,000 - Activity"),
			    (   CALCULATE(
			        SUM('PLS_Activity'[Counter])
			        )
			        /  
			        SUM('PLS_Summary'[Counter])
			    ) * 1000,
			
			    CONTAINSSTRINGEXACT('Par_Activity_Switch'[Switch Selection], "Rate per 1,000 - Cost"),
			    (   CALCULATE(
			        SUM('PLS_Activity'[DerivedActivityCost])
			        )
			        /  
			        SUM('PLS_Summary'[Counter])
			    ) * 1000
			)
			```
		lineageTag: 3a11ef5e-8102-43ae-be0d-b6c92d66166d

		formatStringDefinition =
				
