table Par_Activity_Switch
	lineageTag: ad085903-c10a-4f2c-8687-eaae20d714a4

	measure 'Switch Selection' =
			
			
			MAX('Par_Activity_Switch'[Switch Column])
		lineageTag: 3562799d-dd44-4af4-b529-763150a6b9a2

	column 'Switch Column'
		dataType: string
		lineageTag: 36136bed-89fc-497a-a4d1-1381f8cf311c
		summarizeBy: none
		sourceColumn: Switch Column

		annotation SummarizationSetBy = Automatic

	partition Par_Activity_Switch = m
		mode: import
		source =
				let
				    Source = #table(
				    {"Switch Column"},
				    {
				        {"Total Activity"},
				        {"Activity per Person per Year (PPPY)"},
				        {"Total Cost £"},
				        {"Cost per Person per Year £ (PPPY)"},
				        {"% of Activity by PNG"},
				        {"% of Cost by PNG"},
				        {"Rate per 1,000 - Activity"},
				        {"Rate per 1,000 - Cost"}
				    }
				)
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

