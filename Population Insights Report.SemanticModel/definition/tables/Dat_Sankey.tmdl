	partition Dat_Sankey = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Current", [Query="#(lf)IF OBJECT_ID ('TEMPDB..#TEMP_ACG_START') IS NOT NULL DROP TABLE #TEMP_ACG_START#(lf)IF OBJECT_ID ('TEMPDB..#TEMP_ACG_MIDDLE') IS NOT NULL DROP TABLE #TEMP_ACG_MIDDLE#(lf)IF OBJECT_ID ('TEMPDB..#TEMP_ACG_END') IS NOT NULL DROP TABLE #TEMP_ACG_END#(lf)----#(lf)IF OBJECT_ID ('TEMPDB..#TEMP_DEATHS') IS NOT NULL DROP TABLE #TEMP_DEATHS#(lf);#(lf)#(lf)DECLARE @START DATE#(lf)SET @START = (SELECT DATEADD(MONTH, -24, MAX([Month])) FROM [CCG_Current].[ACG].[vw_ACGResults])#(lf)#(lf)DECLARE @MIDDLE DATE#(lf)SET @MIDDLE = (SELECT DATEADD(MONTH, -12, MAX([Month])) FROM [CCG_Current].[ACG].[vw_ACGResults])#(lf)#(lf)DECLARE @END DATE#(lf)SET @END = (SELECT MAX([Month]) FROM [CCG_Current].[ACG].[vw_ACGResults])#(lf);#(lf)#(lf)/*==== Starting Node ====*/#(lf)#(lf)SELECT [PseudoNHSNumber]#(lf)      ,[Start_Date] = [Month]#(lf)      ,[Start_Patient_Need_Group] = [Patient_Need_Group]#(lf)      ,[Start_Health_Group] = CASE WHEN LEFT([Patient_Need_Group], 2) IN ('01', '02', '03') THEN 'Healthy'#(lf)                                   WHEN LEFT([Patient_Need_Group], 2) IN ('04', '05') THEN 'Moderate Needs'#(lf)#(tab)#(tab)#(tab)     WHEN LEFT([Patient_Need_Group], 2) IN ('06', '07') THEN 'Pregnant'#(lf)#(tab)#(tab)#(tab)     WHEN LEFT([Patient_Need_Group], 2) IN ('08', '09') THEN 'Dominant Chronic'#(lf)#(tab)#(tab)#(tab)     WHEN LEFT([Patient_Need_Group], 2) IN ('10', '11') THEN 'High Complexity; Multi-Morbidity'#(lf)                                   ELSE 'Left Population' END#(lf)#(lf)INTO #TEMP_ACG_START#(lf)FROM [CCG_Current].[ACG].[vw_ACGResults]#(lf)#(lf)WHERE [Month] = @START#(lf);#(lf)#(lf)/*==== Middle Node ====*/#(lf)#(lf)SELECT [PseudoNHSNumber]#(lf)      ,[Middle_Date] = [Month]#(lf)      ,[Middle_Patient_Need_Group] = [Patient_Need_Group]#(lf)      ,[Middle_Health_Group] = CASE WHEN LEFT([Patient_Need_Group], 2) IN ('01', '02', '03') THEN 'Healthy'#(lf)                                    WHEN LEFT([Patient_Need_Group], 2) IN ('04', '05') THEN 'Moderate Needs'#(lf)#(tab)#(tab)#(tab)      WHEN LEFT([Patient_Need_Group], 2) IN ('06', '07') THEN 'Pregnant'#(lf)#(tab)#(tab)#(tab)      WHEN LEFT([Patient_Need_Group], 2) IN ('08', '09') THEN 'Dominant Chronic'#(lf)#(tab)#(tab)#(tab)      WHEN LEFT([Patient_Need_Group], 2) IN ('10', '11') THEN 'High Complexity; Multi-Morbidity'#(lf)                                    ELSE 'Left Population' END#(lf)#(lf)INTO #TEMP_ACG_MIDDLE#(lf)FROM [CCG_Current].[ACG].[vw_ACGResults]#(lf)#(lf)WHERE [Month] = @MIDDLE#(lf);#(lf)#(lf)/*==== End Node ====*/#(lf)#(lf)SELECT [PseudoNHSNumber]#(lf)      ,[End_Date] = [Month]#(lf)      ,[End_Patient_Need_Group] = [Patient_Need_Group]#(lf)      ,[End_Health_Group] = CASE WHEN LEFT([Patient_Need_Group], 2) IN ('01', '02', '03') THEN 'Healthy'#(lf)                                   WHEN LEFT([Patient_Need_Group], 2) IN ('04', '05') THEN 'Moderate Needs'#(lf)#(tab)#(tab)#(tab)     WHEN LEFT([Patient_Need_Group], 2) IN ('06', '07') THEN 'Pregnant'#(lf)#(tab)#(tab)#(tab)     WHEN LEFT([Patient_Need_Group], 2) IN ('08', '09') THEN 'Dominant Chronic'#(lf)#(tab)#(tab)#(tab)     WHEN LEFT([Patient_Need_Group], 2) IN ('10', '11') THEN 'High Complexity; Multi-Morbidity'#(lf)                                   ELSE 'Left Population' END#(lf)#(lf)INTO #TEMP_ACG_END#(lf)FROM [CCG_Current].[ACG].[vw_ACGResults]#(lf)#(lf)WHERE [Month] = @END#(lf);#(lf)#(lf)/*==== Deaths Reference ====*/#(lf)#(lf)SELECT DISTINCT [Derived_Pseudo_NHS]#(lf)               ,[REG_DATE_OF_DEATH]#(lf)#(lf)INTO #TEMP_DEATHS#(lf)FROM [Data_Mart_Civil_Registration].[dbo].[Mortality]#(lf)#(lf)WHERE [Derived_Pseudo_NHS] IS NOT NULL#(lf)AND [REG_DATE_OF_DEATH] <= (SELECT MAX([Month]) FROM [CCG_Current].[ACG].[vw_ACGResults])#(lf);#(lf)#(lf)/*=================================================================================================#(lf)Final Output #(lf)=================================================================================================*/#(lf)#(lf)WITH ACG_CTE AS#(lf)(#(lf)SELECT DISTINCT [PseudoNHSNumber]#(lf)FROM [CCG_Current].[ACG].[vw_ACGResults]#(lf))#(lf)SELECT [ACG].[PseudoNHSNumber]#(lf)      ,[START].[Start_Date]#(lf)      ,[START].[Start_Patient_Need_Group]#(lf)      ,[Start_Health_Group] = CASE WHEN [START].[Start_Health_Group] IS NULL THEN 'New Patient'#(lf)                                   ELSE [START].[Start_Health_Group] END#(lf)      ,[MIDDLE].[Middle_Date]#(lf)      ,[MIDDLE].[Middle_Patient_Need_Group]#(lf)      ,[Middle_Health_Group] = CASE WHEN ([START].[Start_Date] IS NULL AND [MIDDLE].[Middle_Date] IS NULL) THEN 'New Patient'#(lf)                                    WHEN [DEATH].[REG_DATE_OF_DEATH] <= @MIDDLE THEN 'Patient Died'#(lf)                                    WHEN ([START].[Start_Date] IS NOT NULL AND [MIDDLE].[Middle_Health_Group] IS NULL) THEN 'Left Population'#(lf)#(tab)#(tab)#(tab)      ELSE [MIDDLE].[Middle_Health_Group] END#(lf)      ,[END].[End_Date]#(lf)      ,[END].[End_Patient_Need_Group]#(lf)      ,[End_Health_Group] = CASE WHEN [DEATH].[REG_DATE_OF_DEATH] <= @END THEN  'Patient Died'#(lf)                                 WHEN [END].[End_Health_Group] IS NULL THEN 'Left Population' #(lf)#(tab)#(tab)#(tab)   ELSE [END].[End_Health_Group] END#(lf)      ,[Start_to_End_Flag] = CASE WHEN [START].[Start_Date] IS NOT NULL AND [END].[End_Date] IS NOT NULL THEN 1 ELSE 0 END#(lf)      ,[DEATH].[REG_DATE_OF_DEATH]#(lf)      ,[Counter] = 1#(lf)#(lf)FROM ACG_CTE AS [ACG]#(lf)#(lf)LEFT JOIN #TEMP_ACG_START AS [START]#(lf)ON [START].[PseudoNHSNumber] = [ACG].[PseudoNHSNumber]#(lf)#(lf)LEFT JOIN #TEMP_ACG_MIDDLE AS [MIDDLE]#(lf)ON [MIDDLE].[PseudoNHSNumber] = [ACG].[PseudoNHSNumber]#(lf)#(lf)LEFT JOIN #TEMP_ACG_END AS [END]#(lf)ON [END].[PseudoNHSNumber] = [ACG].[PseudoNHSNumber]#(lf)#(lf)LEFT JOIN #TEMP_DEATHS AS [DEATH]#(lf)ON [DEATH].[Derived_Pseudo_NHS] = [ACG].[PseudoNHSNumber]"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

