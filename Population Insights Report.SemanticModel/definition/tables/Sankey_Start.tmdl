table Sankey_Start
	lineageTag: 0c2cf78d-6775-4f1e-abce-c9b98e562876

	measure 'Total Sankey Population - Start' =
			
			CALCULATE(
			    SUM('Sankey_Start'[Counter]),
			    USERELATIONSHIP('Sankey_Start'[PseudoNHSNumber], 'Sankey_End'[PseudoNHSNumber])
			)
		formatString: #,0
		lineageTag: c67320be-98d6-4e7c-b364-248e46a5dfa3

	measure 'Total Sankey Population - Start Table' =
			
			
			CALCULATE(
			    SUM('Sankey_Start'[Counter]),
			    NOT 'Ref_Sankey_Group_Mapping'[Sankey_Health_Group] IN {"New Patient", "Patient Died", "Left Population"}
			)
		formatString: #,0
		lineageTag: fc08736e-652b-422a-aca4-1efe87b26629

