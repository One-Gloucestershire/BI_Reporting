	partition 'REF_GP Practice Populations' = m
		mode: import
		queryGroup: 'Reference Tables'
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "select derived_nhs_number as ""nhs_number"", primarycareprovider as ""Practice_Code"", case when locality in ('South Cotswolds','North Cotswolds') then 'Cotswolds' else locality end as ""Locality"", case when primarycarenetwork = 'Tewkesbury, Newent and Staunton and West Cheltenham Medical' then 'TWNS' else primarycarenetwork end as ""Primary Care Network"", census_date as ""Census_Date"", census_date as ""CensusDate_as_date"", age_at_census as ""Age"", case when gender='Male' then 1 when gender='Female' then 2 when gender is null then 9 end as ""Gender_Code"", gender as ""Gender"", ethnicity_code as ""Ethnicity_Code"", lsoa as ""LSOA"", efi_category as ""efi_frailty"", 1 as ""Total Population"" from data_mart_powerbi_ageingwell.tbl02_proactive_whiteboard_registered_population_over_time where census_date >= '2022-04-01' and derived_registered_ccg like '11M%'", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

