table 'REF_GP Practice Populations'
	lineageTag: 1cb7e4e0-d48c-4747-9940-abf21e52b2fa

	measure Current_Total_Population = ```
			
			
			VAR Latest_GP_Population_date = 
			        MAX('REF_GP Practice Populations'[Census_Date])
			
			VAR number_of_ghc_discharges = 
			    CALCULATE(
			        [Number_of_GHC_Discharges], 
			        FILTER('REF_GP_Reference_Table', 'REF_GP_Reference_Table'[PrimaryCareNetwork] <> BLANK())
			    )
			
			VAR population = 
			    CALCULATE(
			        SUM('REF_GP Practice Populations'[Total Population]), 
			        FILTER('REF_GP_Reference_Table', 'REF_GP_Reference_Table'[PrimaryCareNetwork] <> BLANK())
			        , Filter( 'REF_GP Practice Populations','REF_GP Practice Populations'[Census_Date] = Latest_GP_Population_date)
			    )
			
			
			RETURN
			
			  population
			
			```
		formatString: #,0
		lineageTag: b359a0f4-450b-4544-a4c2-f865564e1bef

	measure Current_Countywide_Total_Population = ```
			
			
			VAR Latest_GP_Population_date = 
			    MAX('REF_GP Practice Populations'[Census_Date])
			
			RETURN
			
			CALCULATE(
			    SUM('REF_GP Practice Populations'[Total Population]),
			    ALL('REF_GP_Reference_Table'),  -- Ignores all filters on REF_GP_Reference_Table
			    NOT(ISBLANK('REF_GP_Reference_Table'[PrimaryCareNetwork])),  -- Keeps the PrimaryCareNetwork filter where it's not blank
			    'REF_GP Practice Populations'[Census_Date] = Latest_GP_Population_date  -- Applies the latest census date filter
			)
			```
		formatString: #,0
		lineageTag: 39bd5144-e1af-494c-a208-ea3e649b7ed2

