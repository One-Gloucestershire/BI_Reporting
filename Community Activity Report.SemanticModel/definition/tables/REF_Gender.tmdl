				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Reference", [Query="#(lf)   IF OBJECT_ID ('tempdb..#TempGenderTable') IS NOT NULL DROP TABLE #TempGenderTable#(lf)CREATE TABLE #TempGenderTable (#(lf)    Gender_Code CHAR(1),#(lf)    Gender_Description VARCHAR(100)#(lf));#(lf)#(lf)INSERT INTO #TempGenderTable (Gender_Code, Gender_Description)#(lf)VALUES #(lf)    ('1', 'Male'),#(lf)    ('2', 'Female'),#(lf)    ('9', 'Indeterminate (unable to be classified as either male or female)'),#(lf)    ('X', 'Not Known (PERSON STATED GENDER CODE not recorded)');#(lf)#(lf)-- To verify the data#(lf)SELECT * FROM #TempGenderTable;"])
