table '3 - Community Hospital Admissons'
	lineageTag: d68e33ff-668e-47b4-80b7-b4d868f4ba19

	measure Only_Relevant_admissions_in_filter =
			
			
			var admission_row_count = countrows('3 - Community Hospital Admissons')
			
			
			RETURN
			
			admission_row_count
		formatString: 0
		lineageTag: 5fc77dd5-914e-44c4-87cb-6d1ef62d6fa0

	measure Number_of_GHC_Discharges = sum('3 - Community Hospital Admissons'[counter])
		formatString: #,0
		lineageTag: f41f877f-052e-4447-8e3c-618ab0a0c408

	measure 'Total GHC admissions' = calculate(sum('3 - Community Hospital Admissons'[counter]),USERELATIONSHIP(REF_Date_Ref[date],'3 - Community Hospital Admissons'[start_date]))
		formatString: #,0
		lineageTag: e1330bbc-f13c-4fd5-8eea-efed7d4344f0

	measure admission_to_discharge_ratio = iferror([Total GHC admissions]/[Number_of_GHC_Discharges],"")
		lineageTag: c38c7c6a-e7d0-4900-983c-122b4c18dd52

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Admission Discharge Ratio Total Across Period' = ```
			
			
			var min_date_in_period = calculate(min(REF_Date_Ref[date]),ALLEXCEPT(REF_Date_Ref,REF_Date_Ref[year_month]))
			Var max_date_in_period = calculate(MAX(REF_Date_Ref[date]),ALLEXCEPT(REF_Date_Ref,REF_Date_Ref[year_month]))
			
			Var Total_Admission_Discharge_Ratio = calculate([Total GHC admissions]/[Number_of_GHC_Discharges]
			,ALLEXCEPT(REF_Date_Ref,REF_Date_Ref[year_month])
			,REF_Date_Ref[date] >= min_date_in_period && REF_Date_Ref[date] <= max_date_in_period)
			
			RETURN 
			
			Total_Admission_Discharge_Ratio
			
			```
		lineageTag: 55312776-1adc-4ad5-9515-01f64d60c9e9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Admission_Discharge_Graph_Conditional_Formatting = ```
			
			
			IF([admission_to_discharge_ratio] > [Admission Discharge Ratio Total Across Period],"#ED8B00","#005EB8")  
			```
		lineageTag: 35987092-28b5-4bec-9b10-7fd75d9e062c

	measure Average_LoS = average('3 - Community Hospital Admissons'[total_bed_days])
		formatString: 0.0
		lineageTag: 6c515305-62e8-478c-b75d-6a2e0b30b671

	measure CountyWide_rate_per_1000_discharged_in_time_period_rate_per_1000_for_locality_graph = ```
			
			
			VAR Latest_GP_Population_date = 
			        MAX('REF_GP Practice Populations'[Census_Date])
			
			        var number_of_ghc_discharges = calculate([Number_of_GHC_Discharges],all('REF_GP_Reference_Table'),NOT(ISBLANK('REF_GP_Reference_Table'[PrimaryCareNetwork])))
			
			        var population= calculate(DISTINCTCOUNT('REF_GP Practice Populations'[nhs_number]),all('REF_GP_Reference_Table'),NOT(ISBLANK('REF_GP_Reference_Table'[PrimaryCareNetwork])))
			
			RETURN
			CALCULATE(
			    (number_of_ghc_discharges / population) * 1000,
			    
			    'REF_GP Practice Populations'[Census_Date] = Latest_GP_Population_date
			)
			
			```
		lineageTag: d9c90592-5c9f-4cf6-9fa0-6c1cdcaae8b6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Rate_per_1000_discharged_in_time_period_rate_per_1000_for_locality_graph = ```
			
			
			VAR Latest_GP_Population_date = 
			        MAX('REF_GP Practice Populations'[Census_Date])
			
			VAR number_of_ghc_discharges = 
			    CALCULATE(
			        [Number_of_GHC_Discharges], 
			        FILTER('REF_GP_Reference_Table', 'REF_GP_Reference_Table'[PrimaryCareNetwork] <> BLANK())
			    )
			
			
			VAR population = 
			    calculate(SUM('REF_GP Practice Populations'[Total Population])
			       ,FILTER(
			        'REF_GP Practice Populations',
			        'REF_GP Practice Populations'[Census_Date] = Latest_GP_Population_date))
			
			RETURN
			(number_of_ghc_discharges/population)*1000
			```
		lineageTag: 1cb62694-e9d1-4bb7-b9b1-0e740f3735e6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Conditional_Formatting_Rate_per_1000_discharged_in_time_period_rate_per_1000_for_locality_graph =
			
			SWITCH(
			    True(),
			    [Rate_per_1000_discharged_in_time_period_rate_per_1000_for_locality_graph] > [CountyWide_rate_per_1000_discharged_in_time_period_rate_per_1000_for_locality_graph],"#FE7A36"
			    ,"#3652AD"
			)
		lineageTag: 85216530-58be-419e-9506-ac69f6c57779

	measure TITLE_CoHo_discharges_per_1000_dynamic_title = ```
			
			VAR __SelectedValue =
			    SELECTCOLUMNS (
			        SUMMARIZE ('Parameter - Locality/PCN/Practice', 'Parameter - Locality/PCN/Practice'[Parameter], 'Parameter - Locality/PCN/Practice'[Parameter Fields] ),
			        'Parameter - Locality/PCN/Practice'[Parameter]
			        
			    )
			VAR Selection_name =  IF ( COUNTROWS ( __SelectedValue ) = 1, __SelectedValue )
			
			RETURN "Total GHC Community Hospital discharges by " & 
			Selection_name & 
			" per 1000 population"
			```
		lineageTag: 828213ab-59d8-496d-a248-b4ef441ba457

	measure 'Total Discharged Patients Bed Days' = CALCULATE(SUM('3 - Community Hospital Admissons'[total_bed_days]),NOT(ISBLANK('1 - Community_Referrals'[Service_Discharge_Date])))
