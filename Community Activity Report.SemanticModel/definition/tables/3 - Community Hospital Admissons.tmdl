	partition '3 - Community Hospital Admissons' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "PowerBI_Reporting", [Query="select *#(lf),[Gender_Code] = Case when gender = 'Male' then 1 #(lf)when gender = 'Female' then 2 end ,#(lf)#(lf)[Admission_day_order] = #(lf)    CASE #(lf)        WHEN admission_day = 'Monday' THEN 1#(lf)        WHEN admission_day = 'Tuesday' THEN 2#(lf)        WHEN admission_day = 'Wednesday' THEN 3#(lf)        WHEN admission_day = 'Thursday' THEN 4#(lf)        WHEN admission_day = 'Friday' THEN 5#(lf)        WHEN admission_day = 'Saturday' THEN 6#(lf)        WHEN admission_day = 'Sunday' THEN 7#(lf)    END#(lf)#(lf)from PowerBI_Reporting.SecondaryCare.tbl07_Inpatients#(lf)where provider_code like 'RTQ%'#(lf)#(lf)#(lf)and (treatment_function_code = '300' --- excludes MH #(lf)#(lf)OR treatment_function_code IS NULL and discharge_date between '20231101' and '20231130') -- accounts for missing TFC's in November 2023 from Unified SUS"])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

