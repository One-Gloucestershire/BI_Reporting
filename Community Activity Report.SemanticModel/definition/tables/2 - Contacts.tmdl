table '2 - Contacts'
	lineageTag: eeb47521-b090-44fe-8091-accbb6d637ad

	measure Only_Relevant_contacts_in_filter =
			
			
			var contacts_row_count = countrows('2 - Contacts')
			
			
			RETURN
			
			contacts_row_count
		formatString: 0
		lineageTag: a7ca04bc-c414-46b2-9e18-97d019cd37c8

	measure Number_of_attended_contacts = ```
			
			        CALCULATE(
			            DISTINCTCOUNT('2 - Contacts'[UniqueCareContactID]),
			            '2 - Contacts'[Attended_or_DNA_Code] IN {"5", "6"}
			        )
			 
			```
		formatString: #,0
		lineageTag: 90bb2fd7-df73-462c-9303-1086f76f6a30

	measure Number_of_DNA_Contacts = calculate(DISTINCTCOUNT('2 - Contacts'[UniqueCareContactID]),'2 - Contacts'[Attended_or_DNA_Code] IN {"3","7"}) // added in 7 - patient arrived late but could not be seen 02/01/2024
		formatString: #,0
		lineageTag: 63a196e7-7a94-4ce0-8e65-17cee5ed3a93

	measure 'DNA Rate' = [Number_of_DNA_Contacts]/ ([Number_of_DNA_Contacts] + [Number_of_attended_contacts])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c158eb46-fca0-4cf5-815c-dc76eade1d82

	measure 'DNA Rate Total Across Period' = ```
			
			
			var min_date_in_period = calculate(min(REF_Date_Ref[date]),ALLEXCEPT(REF_Date_Ref,REF_Date_Ref[year_month]))
			Var max_date_in_period = calculate(MAX(REF_Date_Ref[date]),ALLEXCEPT(REF_Date_Ref,REF_Date_Ref[year_month]))
			
			Var Total_DNAs = calculate([Number_of_DNA_Contacts]/([Number_of_attended_contacts] + [Number_of_DNA_Contacts])
			,ALLEXCEPT(REF_Date_Ref,REF_Date_Ref[year_month])
			,REF_Date_Ref[date] >= min_date_in_period && REF_Date_Ref[date] <= max_date_in_period)
			
			Return 
			
			Total_DNAs
			
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 46abf603-7595-44b6-b6c6-48de76dfac04

	measure First_Follow_up_ratio = iferror([Number_of_follow_up_attended_contacts]/[Number_of_first_attended_contacts],"")
		formatString: 0.0
		lineageTag: 852a2f32-98bb-4ac6-a964-bb471a27e2b6

	measure Number_of_first_attended_contacts = calculate(DISTINCTCOUNT('2 - Contacts'[UniqueCareContactID]),'2 - Contacts'[Consultation_Type_Code] = "01",'2 - Contacts'[Attended_or_DNA_Code] IN {"5","6"})
		formatString: #,0
		lineageTag: 1e9b7fd5-b6d5-4ca8-af6f-dd50fd489fe6

	measure Number_of_follow_up_attended_contacts = calculate(DISTINCTCOUNT('2 - Contacts'[UniqueCareContactID]),'2 - Contacts'[Consultation_Type_Code] = "02",'2 - Contacts'[Attended_or_DNA_Code] IN {"5","6"})
		formatString: #,0
		lineageTag: 239c60c9-2605-49be-9668-bb7628bb41d0

	measure 'First Follow Up Ratio Total Across Period' = ```
			
			
			var min_date_in_period = calculate(min(REF_Date_Ref[date]),ALLEXCEPT(REF_Date_Ref,REF_Date_Ref[year_month]))
			Var max_date_in_period = calculate(MAX(REF_Date_Ref[date]),ALLEXCEPT(REF_Date_Ref,REF_Date_Ref[year_month]))
			
			Var Total_F_Followup_Ratio = calculate([Number_of_follow_up_attended_contacts]/[Number_of_first_attended_contacts]
			,ALLEXCEPT(REF_Date_Ref,REF_Date_Ref[year_month])
			,REF_Date_Ref[date] >= min_date_in_period && REF_Date_Ref[date] <= max_date_in_period)
			
			Return 
			
			Total_F_Followup_Ratio
			
			```
		formatString: #,0.00
		lineageTag: 3370a8ca-1e37-46eb-87bc-77739850570a

	measure First_Follow_up_graph_conditional_formatting = ```
			
			
			IF([First_Follow_up_ratio] > [First Follow Up Ratio Total Across Period],"#ED8B00","#005EB8")  
			```
		lineageTag: d0feabdb-c135-44c1-8732-dd5a3a2c7a29

	measure Number_with_a_blank_consultation_type = calculate(DISTINCTCOUNT('2 - Contacts'[UniqueCareContactID]),'2 - Contacts'[Consultation_Type_Code] = BLANK(),'2 - Contacts'[Attended_or_DNA_Code] IN {"5","6"})
		formatString: #,0
		lineageTag: 8f392e30-aa3e-4cfd-b7af-f50db9f8f7e3

	measure Number_of_Contacts_missing_attendance_status = ```
			
			Calculate(
			DISTINCTCOUNT('2 - Contacts'[UniqueCareContactID]) 
			,'2 - Contacts'[Attended_or_DNA_Code] = blank())
			```
		formatString: 0
		lineageTag: d3331541-8b3b-4e1f-8209-667578a3a685

