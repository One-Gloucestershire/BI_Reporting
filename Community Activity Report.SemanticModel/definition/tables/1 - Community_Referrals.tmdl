table '1 - Community_Referrals'
	lineageTag: 30bc5c29-40d4-44c3-a03f-ac8c66d6c8e5

	measure Referral_Growth = ```
			
			VAR CY = [Number of referrals]
			VAR LY = CALCULATE(
			    [Number of referrals],
			    DATESBETWEEN(
			        REF_Date_Ref[date],
			        EDATE(MIN('REF_Date_Ref'[date]),-12),
			        EOMONTH(max(REF_Date_Ref[date]),-12)
			    )
			
			)
			VAR Check = CY  &&  LY && HASONEVALUE('REF_Date_Ref'[financial_year])
			Return 
			
			IF(Check,divide(CY,LY) -1)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 92cce4ad-da33-44e1-b353-eebe4afe2921

	measure TestA = EOMONTH(max(REF_Date_Ref[date]),-12)
		formatString: General Date
		lineageTag: a5b4cb82-484e-44f2-b05f-61830ab0b39c

	measure TestB = EDATE(MIN('REF_Date_Ref'[date]),-12)
		formatString: General Date
		lineageTag: 960db4c4-066a-44b3-b3e1-29798507a666

	measure 'Number of referrals' = ```
			distinctcount('1 - Community_Referrals'[UniqueServiceRequestID]) 
			```
		formatString: #,0
		lineageTag: f9bbbe47-fd5b-4b28-a4fa-64cb42bf8b41

	measure Number_of_countywide_referrals_per_1000_crude_rate = ```
			
			
			VAR Latest_GP_Population_date = 
			    MAX('REF_GP Practice Populations'[Census_Date])
			
			RETURN
			CALCULATE(
			    DIVIDE([Number of referrals],DISTINCTCOUNT('REF_GP Practice Populations'[nhs_number]), 0) * 1000
			    ,'REF_GP Practice Populations'[Census_Date] = Latest_GP_Population_date,
			      ALL('REF_GP_Reference_Table'),
			    NOT(ISBLANK('REF_GP_Reference_Table'[PrimaryCareNetwork]))
			    
			 
			)
			```
		formatString: #,0.00
		lineageTag: 72da5293-9280-45de-ba74-59f1e260b99d

	measure Number_of_referrals_per_1000_crude_rate = ```
			
			VAR Latest_GP_Population_date = 
			    MAX('REF_GP Practice Populations'[Census_Date])
			
			
			VAR Total_referrals = 
			    [Number of referrals]
			
			
			VAR population = 
			    calculate(SUM('REF_GP Practice Populations'[Total Population])
			       ,FILTER(
			        'REF_GP Practice Populations',
			        'REF_GP Practice Populations'[Census_Date] = Latest_GP_Population_date))
			
			RETURN
			(Total_referrals/population)*1000
			
			```
		formatString: #,0
		lineageTag: 884749ae-ec07-4327-beb0-427f45cf8711

	measure Referrals_Locality_Bars_Conditional_Formatting_compared_to_countywide_rate =
			
			SWITCH(
			    True(),
			    [Number_of_referrals_per_1000_crude_rate] > [Number_of_countywide_referrals_per_1000_crude_rate],"#FE7A36"
			    ,"#3652AD"
			)
		lineageTag: 15cf9d3a-41e5-4a86-883c-010785ec9eca

	measure Data_Table_Number_of_referrals_per_1000_crude_rate =
			
			VAR latest_date = MAX(REF_Date_Ref[date])
			VAR start_of_latest_month = DATE(YEAR(latest_date), MONTH(latest_date), 1)
			RETURN
			calculate(([Number of referrals]/sum('REF_GP Practice Populations'[Total Population]))*1000,'REF_GP Practice Populations'[CensusDate_as_date] = start_of_latest_month
			,not(isblank(REF_GP_Reference_Table[PrimaryCareNetwork]))
			,not(isblank(REF_GP_Reference_Table[Locality]))
			,REF_GP_Reference_Table[ReportingOrganisationCode] <> "Y00054"
			
			
			)
		lineageTag: 39d81cfe-6fae-4279-96a4-c7720ac1365b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Only_Relevant_refs_in_filter =
			
			
			var referral_row_count = countrows('1 - Community_Referrals')
			
			
			RETURN
			
			referral_row_count
		formatString: 0
		lineageTag: 99ae45e1-4836-4450-a9ae-f79393826fde

	measure Number_of_community_discharges = calculate(DISTINCTCOUNT('1 - Community_Referrals'[UniqueServiceRequestID]),USERELATIONSHIP('1 - Community_Referrals'[Service_Discharge_Date],REF_Date_Ref[date]))
		formatString: 0
		lineageTag: 246aabc1-021b-40d4-8cfb-cff4a2155f82

	measure Referral_to_discharge_rate = [number_of_community_discharges]/[Number of referrals]
		lineageTag: 53ca7fc0-bbad-4e3c-b745-75fa4494c4ad

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Community_discharges_growth = ```
			
			VAR CY = [number_of_community_discharges]
			VAR LY = CALCULATE(
			    [number_of_community_discharges],
			    DATESBETWEEN(
			        REF_Date_Ref[date],
			        EDATE(MIN('REF_Date_Ref'[date]),-12),
			        EOMONTH(max(REF_Date_Ref[date]),-12)
			    )
			
			)
			VAR Check = CY  &&  LY && HASONEVALUE('REF_Date_Ref'[financial_year])
			Return 
			
			IF(Check,divide(CY,LY) -1)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0d10eb62-e948-46bf-acf8-9e5f69d3882d

	measure Contacts_per_referral = ```
			
			
			
			VAR Attended_Contacts_Per_Unique_Ref = 
			    CALCULATETABLE(
			        SUMMARIZE(
			            '1 - Community_Referrals',
			            '1 - Community_Referrals'[UniqueServiceRequestID],
			            "Contacts_Per_Referral", MAX('1 - Community_Referrals'[Attended_Contacts_in_Referral])
			        ),
			        USERELATIONSHIP('1 - Community_Referrals'[Service_Discharge_Date], REF_Date_Ref[date])
			    )
			
			RETURN
			AVERAGEX(
			    Attended_Contacts_Per_Unique_Ref,
			    [Contacts_Per_Referral]
			)
			```
		formatString: #,0.00
		lineageTag: e5176336-a2da-40bd-b2ca-0291edef9182

	measure Number_of_countywide_referrals = ```
			
			
			VAR Latest_GP_Population_date = 
			    MAX('REF_GP Practice Populations'[Census_Date])
			
			RETURN
			CALCULATE(
			    [Number of referrals]
			    ,'REF_GP Practice Populations'[Census_Date] = Latest_GP_Population_date,
			      ALL('REF_GP_Reference_Table'),
			    NOT(ISBLANK('REF_GP_Reference_Table'[PrimaryCareNetwork]))
			    
			 
			)
			```
		formatString: #,0
		lineageTag: 138100f3-a46f-46b4-a8eb-53c9c6109ba4

	measure Average_Length_of_Referral = calculate(AVERAGE('1 - Community_Referrals'[Length_of_referral_days]),USERELATIONSHIP('1 - Community_Referrals'[Service_Discharge_Date],REF_Date_Ref[date]))
		formatString: 0.0
		lineageTag: 0e470617-e06a-4ab0-a2ff-0ddb2a2f7c0e

