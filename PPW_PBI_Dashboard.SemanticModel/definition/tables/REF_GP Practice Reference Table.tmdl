	partition 'REF_GP Practice Reference Table' = m
		mode: import
		queryGroup: 'Reference Tables'
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "CCG_Reference", [Query="SELECT DISTINCT [practice_code] = gp.OrganisationCode#(lf),[practice_name] = gp.ReportingOrganisationName#(lf),[primary_care_network] = gp.Reporting_PrimaryCareNetwork#(lf),[Locality] = gp.Reporting_Locality#(lf),[Using_Whiteboard_Flag] = case when gp.OrganisationCode in (#(lf)SELECT distinct Practice_Code FROM PowerBI_Reporting.dbo.Ref_PPW_Practice_List) then 'Yes' else 'No' end #(lf),pl.Practice_Evaluation_Status#(lf)#(lf)#(lf)FROM PowerBI_Reporting.dbo.GP_Practice_Ref as gp#(lf)left join PowerBI_Reporting.dbo.Ref_PPW_Practice_List as pl on gp.OrganisationCode = pl.Practice_Code#(lf)#(lf)where gp.OrganisationCode  IN (SELECT DISTINCT  p.practice_code FROM PowerBI_Reporting.dbo.Proactive_Whiteboard_Cohort as p) #(lf)#(lf)#(lf)"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

