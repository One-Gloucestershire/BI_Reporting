	partition '2.Died_In_Preferred_Place_of_Death' = m
		mode: import
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "PowerBI_Reporting", [Query=" #(lf) set nocount on #(lf) ----------------------------------------------------------------------------#(lf)/*obtains latest record that deceased patient appeared in census*/#(lf)----------------------------------------------------------------------------#(lf) IF OBJECT_ID ('tempdb..#deceased_last_appearance_in_census') IS NOT NULL DROP TABLE #deceased_last_appearance_in_census#(lf) #(lf) select nhs_number#(lf) ,[Last_apperance_in_census] = max(census_date)#(lf)#(lf) into #deceased_last_appearance_in_census#(lf)#(lf)#(lf)from [PowerBI_Reporting].[dbo].[Proactive_Whiteboard_Cohort] #(lf)#(lf)where deceased_flag = 1 #(lf)#(lf)GROUP BY nhs_number#(lf)#(lf)ORDER BY max(census_date)#(lf)#(lf)#(lf)----------------------------#(lf)------- FINAL OUTPUT ---#(lf)----------------------------#(lf)#(lf)select w.*#(lf)from [PowerBI_Reporting].[dbo].[Proactive_Whiteboard_Cohort]  as w#(lf)#(lf)inner join #deceased_last_appearance_in_census  as d on w.nhs_number = d.nhs_number#(lf)and d.Last_apperance_in_census = w.Census_Date#(lf)#(lf)and [In_Cohort_Flag] = 1#(lf)and Census_Date >= '20210701'#(lf)#(lf)and Date_of_Death <= (Select eomonth(max(census_date)) from [PowerBI_Reporting].[dbo].[Proactive_Whiteboard_Cohort])#(lf)#(lf)#(lf)order by Census_Date#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)"])
				in
				    Source

	changedProperty = IsHidden

	annotation PBI_ResultType = Table

