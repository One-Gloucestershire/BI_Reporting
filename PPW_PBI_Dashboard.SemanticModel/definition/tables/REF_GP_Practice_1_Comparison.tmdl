	partition REF_GP_Practice_1_Comparison = m
		mode: import
		queryGroup: 'Reference Tables'
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "CCG_Reference", [Query="SELECT DISTINCT [practice_code] = gp.OrganisationCode#(lf),[practice_name] = gp.ReportingOrganisationName#(lf),[primary_care_network] = gp.Reporting_PrimaryCareNetwork#(lf),[Locality] = gp.Reporting_Locality#(lf),[Using_Whiteboard_Flag] = case when gp.Reporting_PrimaryCareNetwork in (#(lf)'North and South Gloucester'#(lf),'Cheltenham Central'#(lf),'South Cotswolds'#(lf),'North Cotswolds'#(lf),'Berkeley Vale'#(lf),'Severn Health'#(lf),'TWNS'#(lf),'Aspen'#(lf),'Rosebank & Bartongate'#(lf),'Hadwen & Quedgeley'#(lf),'The Forest of Dean') then 'Yes' else 'No' end #(lf)#(lf)#(lf)FROM PowerBI_Reporting.dbo.GP_Practice_Ref as gp#(lf)#(lf)where gp.OrganisationCode  IN (SELECT DISTINCT  p.practice_code FROM PowerBI_Reporting.dbo.Proactive_Whiteboard_Cohort as p) #(lf)#(lf)#(lf)"])
				in
				    Source

	changedProperty = IsHidden

