	column latest_weekend_flag = ```
			
			IF('Date Table'[week_end_date] = MAX('Date Table'[week_end_date]), "Latest week", "0") 
			```
		lineageTag: b39cd9cc-88ee-42b9-adc0-028406981520
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column latest_4week_flag =
			
			VAR LatestWeek = MAX('Date Table'[week_end_date])
			VAR PreviousWeek = LatestWeek - 7
			VAR TwoWeeksAgo = LatestWeek - 14
			VAR ThreeWeeksAgo = LatestWeek - 21
			RETURN
			    IF (
			        'Date Table'[week_end_date] IN {LatestWeek, PreviousWeek, TwoWeeksAgo, ThreeWeeksAgo},
			        "Latest 4 weeks",
			        "0"
			    )
		dataType: string
		lineageTag: 4a2f132e-a620-4dc0-b50b-49761e570d3f
		summarizeBy: none

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	column latest_12week_flag =
			
			VAR LatestWeek = MAX('Date Table'[week_end_date])
			VAR PreviousWeek = LatestWeek - 7
			VAR TwoWeeksAgo = LatestWeek - 14
			VAR ThreeWeeksAgo = LatestWeek - 21
			VAR FourWeeksAgo = LatestWeek - 28
			VAR FiveWeeksAgo = LatestWeek - 35
			VAR SixWeeksAgo = LatestWeek - 42
			VAR SevenWeek = LatestWeek - 49
			VAR EightWeeksAgo = LatestWeek - 56
			VAR NineWeeksAgo = LatestWeek - 63
			VAR TenWeek = LatestWeek - 70
			VAR ElevenWeeksAgo = LatestWeek - 77
			
			RETURN
			    IF (
			        'Date Table'[week_end_date] IN {LatestWeek, PreviousWeek, TwoWeeksAgo, ThreeWeeksAgo, FourWeeksAgo, FiveWeeksAgo, SixWeeksAgo, SevenWeek, EightWeeksAgo, NineWeeksAgo, TenWeek, ElevenWeeksAgo},
			        "Latest 12 weeks",
			        "0"
			    )
		lineageTag: 2c980c28-9aa1-4950-87b5-73b658928d38
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

