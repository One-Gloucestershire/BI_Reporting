	partition 'Call Activity' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "ccg_current", [Query="IF OBJECT_ID ('tempdb..#ALL') IS NOT NULL DROP TABLE #ALL#(lf)IF OBJECT_ID ('tempdb..#FILTERED') IS NOT NULL DROP TABLE #FILTERED #(lf)#(lf)SELECT [NHSNumber]#(lf)#(tab)  ,[Patient_Registered_GP] = POP.[PrimaryCareProvider_description]#(lf)#(tab)  ,[Patient_Registered_PCN] = POP.[PrimaryCareNetwork]#(lf)#(tab)  ,[Patient_Registered_Locality] = POP.[Locality]#(lf)#(tab)  ,[Patient_Age_at_Call] = POP.Age_at_census#(lf)#(tab)  ,[Patient_Gender] = POP.Gender#(lf)#(tab)  ,[Patient_Ethnicity] = POP.Ethnicity_code#(lf)#(tab)  ,[Patient_eFi] = POP.efi_category#(lf)#(lf)      ,[LocalPatientIdentifier]#(lf)      ,[CaseID]#(lf)      ,[CaseType]#(lf)      ,[PCN_of_Caller] = CIN.[PrimaryCareNetwork]#(lf)      ,[Place_of_Caller] = CIN.[Place]#(lf)      ,[OrganisationCodeofCaller]#(lf)      ,[OrganisationNameofCaller]#(lf)#(tab)  ,[OrganisationGroupsofCaller] =#(lf)#(tab)#(tab)#(tab)CASE WHEN [OrganisationCodeofCaller] LIKE 'L%' THEN 'Primary Care'  #(lf)#(tab)#(tab)#(tab)#(tab) WHEN [OrganisationCodeofCaller] LIKE 'Y%' THEN 'Primary Care'#(lf)#(tab)#(tab)#(tab)#(tab) WHEN [OrganisationCodeofCaller] LIKE 'M8%' THEN 'Primary Care' #(lf)#(tab)#(tab)#(tab)#(tab) WHEN [OrganisationCodeofCaller] IN ('RTQ -1', 'RTQ - 2', 'NTPH9') THEN 'Out of Hours' #(lf)#(tab)#(tab)#(tab)#(tab) WHEN [OrganisationCodeofCaller] LIKE 'RTQ%' THEN 'GHC'#(lf)#(tab)#(tab)#(tab)#(tab) WHEN [OrganisationCodeofCaller] = 'RYF' THEN 'SWAST'#(lf)#(tab)#(tab)#(tab)#(tab) WHEN [OrganisationCodeofCaller] = 'RTW' THEN 'GHFT Cardiac Ward' #(lf)#(tab)#(tab) #(tab)#(tab) WHEN [OrganisationCodeofCaller] = 'R1J01' THEN 'MIIU' #(lf)#(tab)#(tab)#(tab)#(tab) WHEN [OrganisationCodeofCaller] = '567' THEN 'TESTING' #(lf)#(tab)#(tab)#(tab)#(tab) ELSE 'Unknown' END #(lf)#(lf)#(lf)#(lf)      ,[RegistrationCodeofCaller]#(lf)      ,[NameofCaller]#(lf)      ,[RegistrationCodeofSpecialist]#(lf)      ,[NameofSpecialist]#(lf)      ,[ReasonforCall]#(lf)      ,[Provider]#(lf)      ,[Service] = CASE WHEN [Service] = 'Chronic Heart Failure - eOpinion' THEN 'Chronic Heart Failure' #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)ELSE [Service] END #(lf)#(lf)#(tab)  ,[Service Type] = CASE WHEN ([Service] = 'Dermatology') THEN 'Routine'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)  WHEN ([Service] = 'Paediatrics e-Opinion') THEN 'Routine' #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)  WHEN [Service] IS NULL THEN 'Null' ELSE 'Acute' END#(lf)#(lf)      ,[Pathway]#(lf)      ,[TriageHub]#(lf)      ,[PresentingComplaingFreeText]#(lf)#(lf)#(tab)  ,[Call_Initiated_Datetime] = [DateofCallInitiated] + CAST([TimeofCallInitiated] AS DATETIME) #(lf)      ,[Call_Initiated_Date] = CAST([DateofCallInitiated] AS DATE)#(lf)      ,[Call_Initiated_Weekday] = [WeekdayofCallInitiated]#(lf)#(tab)  ,[Call_Initiated_Time] = [TimeofCallInitiated]#(lf)#(tab)  ,[Call_Initiated_Hour] = [HourofCallInitiated]#(lf)#(tab)  ,[Call_Initiated_Month] = DATEFROMPARTS(YEAR([DateofCallInitiated]), MONTH([DateofCallInitiated]), 1)  #(lf)#(tab)  #(lf)#(tab)  ,[TimeDifferenceDays] = CASE WHEN CallAnswered = 'yes' THEN DATEDIFF(DAY, [DateofCallInitiated], [DateofCallAswered]) #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   ELSE NULL END#(lf)#(lf)#(tab)  ,[TimeWaiting]#(lf)#(tab)  ,[TimeWaitingSeconds] = DATEDIFF(SECOND, 0 , TRY_CAST([TimeWaiting] AS TIME)) #(lf)#(tab)  ,[TimeWaitingMinutes] = CAST(DATEDIFF(SECOND, 0, TRY_CAST([TimeWaiting] AS TIME)) AS FLOAT) / 60 #(lf)#(tab)  ,[TimeWaitingHours] = CAST(DATEDIFF(SECOND, 0, TRY_CAST([TimeWaiting] AS TIME)) AS FLOAT) / 3600#(lf)#(tab)  ,[TimeWaitingDays] = CAST(DATEDIFF(SECOND, 0, TRY_CAST([TimeWaiting] AS TIME)) AS FLOAT) / 86400 #(lf)#(lf)#(tab)  ,[TimeWaitingGroups] =#(lf)        CASE WHEN DATEDIFF(SECOND, 0, TRY_CAST([TimeWaiting] AS TIME)) =   0 THEN 'Unanswered'#(lf)#(tab)#(tab)#(tab) WHEN DATEDIFF(SECOND, 0, TRY_CAST([TimeWaiting] AS TIME)) < 120 THEN '0–2 mins'#(lf)#(tab)#(tab)#(tab) WHEN DATEDIFF(SECOND, 0, TRY_CAST([TimeWaiting] AS TIME)) < 240 THEN '2–4 mins'#(lf)#(tab)#(tab)#(tab) WHEN DATEDIFF(SECOND, 0, TRY_CAST([TimeWaiting] AS TIME)) < 360 THEN '4–6 mins'#(lf)#(tab)#(tab)#(tab) WHEN DATEDIFF(SECOND, 0, TRY_CAST([TimeWaiting] AS TIME)) < 480 THEN '6-8 mins'#(lf)#(tab)#(tab)#(tab) WHEN DATEDIFF(SECOND, 0, TRY_CAST([TimeWaiting] AS TIME)) < 600 THEN '8-10 mins'#(lf)#(tab) #(lf)#(tab)#(tab)ELSE '10+ mins' END #(lf)#(lf)#(tab) ,[TimeWaitingeOpinion] = #(lf)#(tab)    CASE WHEN DATEDIFF(DAY, [DateofCallInitiated], [DateofCallAswered]) IS NULL THEN 'Currently Unanswered'#(lf)#(tab)#(tab)#(tab) WHEN DATEDIFF(DAY, [DateofCallInitiated], [DateofCallAswered]) = 0 THEN 'Less than a day' #(lf)#(tab)#(tab)#(tab) WHEN DATEDIFF(DAY, [DateofCallInitiated], [DateofCallAswered]) < 4 THEN '1 - 3 days' #(lf)#(tab)#(tab)#(tab) WHEN DATEDIFF(DAY, [DateofCallInitiated], [DateofCallAswered]) < 8 THEN '4 - 7 days' #(lf)#(tab)#(tab)#(tab) WHEN DATEDIFF(DAY, [DateofCallInitiated], [DateofCallAswered]) < 15 THEN '8 - 14 days' #(lf)#(tab)#(tab)#(tab) WHEN DATEDIFF(DAY, [DateofCallInitiated], [DateofCallAswered]) < 31 THEN '15 - 30 days' #(lf)#(tab)#(tab)#(tab) WHEN DATEDIFF(DAY, [DateofCallInitiated], [DateofCallAswered]) < 61 THEN '30 - 60 days' #(lf)#(tab)#(tab)#(tab) WHEN DATEDIFF(DAY, [DateofCallInitiated], [DateofCallAswered]) < 91 THEN '60 - 90 days' #(lf)#(tab)#(tab)#(tab) WHEN DATEDIFF(DAY, [DateofCallInitiated], [DateofCallAswered]) < 121 THEN '90 - 120 days' #(lf)#(tab)#(tab)#(tab) ELSE 'Over 120 days' END  #(lf)#(lf)#(tab) ,[TimeWaitingeOpinionOrder] = #(lf)#(tab)    CASE WHEN DATEDIFF(DAY, [DateofCallInitiated], [DateofCallAswered]) IS NULL THEN 0#(lf)#(tab)#(tab)#(tab) WHEN DATEDIFF(DAY, [DateofCallInitiated], [DateofCallAswered]) = 0 THEN 1#(lf)#(tab)#(tab)#(tab) WHEN DATEDIFF(DAY, [DateofCallInitiated], [DateofCallAswered]) < 4 THEN 2#(lf)#(tab)#(tab)#(tab) WHEN DATEDIFF(DAY, [DateofCallInitiated], [DateofCallAswered]) < 8 THEN 3#(lf)#(tab)#(tab)#(tab) WHEN DATEDIFF(DAY, [DateofCallInitiated], [DateofCallAswered]) < 15 THEN 4#(lf)#(tab)#(tab)#(tab) WHEN DATEDIFF(DAY, [DateofCallInitiated], [DateofCallAswered]) < 31 THEN 5 #(lf)#(tab)#(tab)#(tab) WHEN DATEDIFF(DAY, [DateofCallInitiated], [DateofCallAswered]) < 61 THEN 6 #(lf)#(tab)#(tab)#(tab) WHEN DATEDIFF(DAY, [DateofCallInitiated], [DateofCallAswered]) < 91 THEN 7#(lf)#(tab)#(tab)#(tab) WHEN DATEDIFF(DAY, [DateofCallInitiated], [DateofCallAswered]) < 121 THEN 8#(lf)#(tab)#(tab)#(tab) ELSE 9 END  #(lf)#(lf)#(tab)  ,[TimeWaitingGroupOrder] =#(lf)        CASE WHEN DATEDIFF(SECOND, 0, TRY_CAST([TimeWaiting] AS TIME)) =   0 THEN 0#(lf)#(tab)#(tab)#(tab) WHEN DATEDIFF(SECOND, 0, TRY_CAST([TimeWaiting] AS TIME)) < 120 THEN 1#(lf)#(tab)#(tab)#(tab) WHEN DATEDIFF(SECOND, 0, TRY_CAST([TimeWaiting] AS TIME)) < 240 THEN 2#(lf)#(tab)#(tab)#(tab) WHEN DATEDIFF(SECOND, 0, TRY_CAST([TimeWaiting] AS TIME)) < 360 THEN 3#(lf)#(tab)#(tab)#(tab) WHEN DATEDIFF(SECOND, 0, TRY_CAST([TimeWaiting] AS TIME)) < 480 THEN 4#(lf)#(tab)#(tab)#(tab) WHEN DATEDIFF(SECOND, 0, TRY_CAST([TimeWaiting] AS TIME)) < 600 THEN 5#(lf)#(lf)#(tab)#(tab)ELSE 6 END #(lf)#(lf)#(lf)#(lf)#(tab)  ,[CallAnswered]#(lf)#(tab)  ,[CallOutcome] = CASE WHEN [CallAnswered] = 'yes' then 'Answered Calls'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [CallAnswered] = 'no' THEN 'Missed Calls' ELSE NULL END #(lf)#(tab)  ,[Call_Answered_Datetime] =  CASE WHEN [DateofCallAswered] != '1900-01-01 00:00:00.000' THEN [DateofCallAswered] + CAST([TimeofCallAswered] AS DATETIME) #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ELSE NULL END#(lf)#(tab)  ,[Call_Answered_Date] = CAST([DateofCallAswered] AS DATE)#(lf)#(tab)  ,[Call_Answered_Time] = [TimeofCallAswered]#(lf)#(lf)      ,[Call_Ended_Datetime] = [DateofCallEnded] + CAST([TimeofCallEnded] AS DATETIME) #(lf)#(tab)  ,[Call_Ended_Date] = CAST([DateofCallEnded] AS DATE) #(lf)#(tab)  ,[Call_Ended_Time] = [TimeofCallEnded]#(lf)#(lf)#(tab)  ,[AnsweredCallLength]#(lf)#(lf)      ,[CallerCancelledCall]#(lf)#(lf)      ,[OutcomeCategory]#(lf)      ,[SpecialistOutcome]#(lf)      ,[CallerStarRating]#(lf)      ,[Patientsregisteredpractice]#(lf)      ,[Referrersreportdecision]#(lf)      ,[Reportsenttoreferrerchosendestination]#(lf)      ,[Reportsenttootheremailsautomatically]#(lf)      ,[Reportsenttootheremailsmanually]   #(lf)      ,[EROCtreatmentfunction]#(lf)      ,[SpecialtyCode]#(lf)#(tab)  ,[SpecialityDescription] = MS.[MainSpecialtyDescription]#(lf)      ,[EROCoutcome]#(lf)      #(lf)      ,[CommissionerOrganisationCode]#(lf)      ,[Completed_Call] = [Completed] #(lf)      ,[Age]#(lf)      ,[Derived_CallInitiatedDateTime]#(lf)#(lf)#(tab)  ,[ED_Arrival_Date] = [ED].[arrival_date]#(lf)#(tab)  ,[ED_Arrival_Time] = [ED].[arrival_time] #(lf)#(tab)  ,[Time_between_call_and_ED] = CASE WHEN #(lf)      CAST([ED].[arrival_date] AS DATETIME) + CAST([ED].[arrival_time] AS DATETIME) >= [DateofCallInitiated] + CAST([TimeofCallInitiated] AS DATETIME)#(lf)    THEN #(lf)      DATEDIFF(HOUR, [DateofCallInitiated] + CAST([TimeofCallInitiated] AS DATETIME), CAST([ED].[arrival_date] AS DATETIME) + CAST([ED].[arrival_time] AS DATETIME))#(lf)    ELSE #(lf)      NULL #(lf)  END#(lf)#(lf)--#(tab)  ,[Time_between_call_and_ED] = DATEDIFF(HH, [DateofCallInitiated] + CAST([TimeofCallInitiated] AS DATETIME), CAST([ED].[arrival_date] AS DATETIME) + CAST([ED].[arrival_time] AS DATETIME)  )#(lf)#(tab)  --,[ED_Rank] = ROW_NUMBER()OVER(PARTITION BY [CaseID] ORDER BY DATEDIFF(hh,CIN.[DateofCallInitiated],[ED].[arrival_date]))#(lf)#(tab)  ,[ED_Attendance_FLAG] = CASE WHEN [ED].[arrival_date] IS NOT NULL THEN 'Attended ED' ELSE 'Did Not Attend ED' END#(lf)#(lf)#(tab)  ,[ED_Attendance_Timing] =  CASE WHEN DATEDIFF(HH, CIN.[DateofCallInitiated], [ED].[arrival_date]) BETWEEN '0' AND '24' THEN 'Attended ED within 24 hours'#(lf)      WHEN DATEDIFF(HH, CIN.[DateofCallInitiated],[ED].[arrival_date]) BETWEEN '25' AND '72' THEN 'Attended ED between 25 and 72 hours'#(lf)      ELSE 'Did Not Attend ED' END #(lf)#(lf)#(tab)  ,[Admission_Date_Time] = [SUS].[spell_admission_date]#(lf)#(tab)  ,[Discharge_Date_Time] = [SUS].[spell_discharge_date]#(lf)#(tab)  ,[Admission_Method] = SUS.spell_admission_method#(lf)#(tab)  ,[Admission_or_Assessment] = CASE WHEN SUS.spell_admission_method IN ('81', '82') THEN 'Assessment' #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN SUS.spell_admission_method IS NULL THEN NULL#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ELSE 'Admission' END #(lf)#(lf)#(lf)#(tab)  ,[Inpatient_LOS_days] = DATEDIFF(DD, [SUS].[spell_admission_date] ,[SUS].[spell_discharge_date]) #(lf)#(tab)  ,[Time_between_Call_and_Admission] = DATEDIFF(hh,[DateofCallInitiated], [SUS].[spell_admission_date]) #(lf)#(lf)#(tab),[Admission_Timing] = CASE WHEN DATEDIFF(HH, CIN.[DateofCallInitiated], SUS.[spell_admission_date]) BETWEEN '0' AND '24' THEN 'Admitted within 24 hours'#(lf)      WHEN DATEDIFF(HH, CIN.[DateofCallInitiated], SUS.[spell_admission_date]) BETWEEN '25' AND '72' THEN 'Admitted between 25 and 72 hours'#(lf)      ELSE 'Not Admitted' END#(lf)#(lf)#(lf),CASE WHEN SpecialistOutcome IN ('Accepted as routine new referral into HF Service',#(lf)'Accepted for community nursing service',#(lf)'Accepted for Rapid Response service',#(lf)'Additional images required',#(lf)'Advice given but refer if not better',#(lf)'Advice given on management in the community',#(lf)'Advice given, no admission required',#(lf)'Advice only',#(lf)'Advice only - no review required',#(lf)'Advice only (no admission required)',#(lf)'Advise routine referral',#(lf)'Advise routine referral ',#(lf)'Advise urgent referral',#(lf)'Advised referral for outpatient appointment',#(lf)'Advised referral to Gloucestershire Respiratory Team for exacerbation support',#(lf)'Advised referral to Rapid Response for admission avoidance',#(lf)'Community management only',#(lf)'Continue to manage in primary care',#(lf)'Continue to manage in primary care by GP',#(lf)'Deferred Admission. Parents to call PAU Coordinator on 07