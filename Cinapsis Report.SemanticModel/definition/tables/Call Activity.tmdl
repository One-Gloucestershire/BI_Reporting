(lf)'CGH ED - Medically expected',#(lf)'Admit via Emergency Department at GRH' ) THEN 'ED Attendance' #(lf)#(lf)WHEN SpecialistOutcome = 'Call failed' THEN 'CaLl Failed' #(lf)WHEN SpecialistOutcome IN ('No Outcome',#(lf)'Not Recorded',#(lf)'Outcome not completed by specialist') THEN 'No Outcome Recorded' ELSE 'No Outcome Recorded' END AS [Grouped Outcome] #(lf)#(lf)INTO #ALL#(lf)FROM [CCG_Current].[Cinapsis].[vw_ReferralManagement] AS CIN#(lf)#(lf)#(lf)#(lf)  LEFT JOIN [PowerBI_Reporting].[AgeingWell].[tbl02_Proactive_Whiteboard_Registered_Population_Over_Time] AS POP#(lf)  ON CIN.NHSNumber = POP.[Derived_NHS_Number] #(lf)  AND DATEFROMPARTS(YEAR([DateofCallInitiated]), MONTH([DateofCallInitiated]), 1) = POP.Census_Date  #(lf)#(lf)  LEFT JOIN [CCG_Reference].[Reference].[vw_MainSpecialty] AS MS#(lf)  ON MS.[MainSpecialtyCode] = CIN.SpecialtyCode#(lf)#(lf)  LEFT JOIN [PowerBI_Reporting].[UrgentCare].[tbl01_ECDS] [ED] #(lf)  ON CIN.[NHSNumber] = [ED].[nhs_number] #(lf)  AND DATEDIFF(HOUR, #(lf)      CAST(CIN.[DateofCallInitiated] AS DATETIME) + CAST(CIN.[TimeofCallInitiated] AS DATETIME),#(lf)      CAST(ED.[arrival_date] AS DATETIME) + CAST(ED.[arrival_time] AS DATETIME)#(lf)    ) BETWEEN 0 AND 72#(lf)#(lf)  LEFT JOIN [CCG_Current].[UnifiedSUS].[vw_HospitalProviderSpell] AS SUS#(lf)  ON CIN.[NHSNumber] = [SUS].[spell_patient_identity_nhs_number_value]#(lf)  AND DATEDIFF(HH, CIN.[DateofCallInitiated], [SUS].[spell_admission_date]) BETWEEN '0' AND '72'#(lf)#(lf)#(lf)  WHERE [DateofCallInitiated] > '2023-01-01 00:00:00.000' #(lf)  AND OrganisationNameofCaller NOT LIKE 'Test%'#(lf)#(lf)  ORDER BY [TimeDifferenceDays] DESC --[OrganisationNameofCaller] --[LocalPatientIdentifier], [DateofCallInitiated] #(lf)#(lf)  ;#(lf)#(lf)#(lf)  SELECT ROW_NUMBER() OVER(#(lf)#(tab)#(tab)#(tab)PARTITION BY [NHSNumber], [Call_Initiated_Datetime] #(lf)#(tab)#(tab)#(tab)ORDER BY [ED_Arrival_Time] ) AS 'ED_Rank' #(lf)  ,*#(lf)#(lf)  INTO #FILTERED#(lf)  FROM #ALL #(lf)#(lf)  ;#(lf)#(lf)#(lf)  SELECT *#(lf)  FROM #FILTERED#(lf)  WHERE ED_Rank = 1 AND#(lf)#(tab)NHSNumber IS NOT NULL #(lf)"]),
