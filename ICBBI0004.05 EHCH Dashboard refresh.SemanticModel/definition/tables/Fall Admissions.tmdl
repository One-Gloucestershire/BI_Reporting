table 'Fall Admissions'
	lineageTag: 021e7bff-01d1-4fa0-88da-f4152ea0b381

	measure 'Admission Fall MH Yearly' =
			
			VAR ED = CALCULATE(
				SUM('Fall Admissions'[counter]),
				'Fall Admissions'[Care_home_status] IN { "mental health" }
			)
			VAR POP = CALCULATE ( [Care Home Population Per Month]  , ALLEXCEPT ('date table', 'date table'[financial_year] ), 'date table'[month_name] IN {"Nov"} )
			
			RETURN (ED/POP*1000)
		lineageTag: bbc75caa-e279-4456-bf55-248b5e56b98d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

