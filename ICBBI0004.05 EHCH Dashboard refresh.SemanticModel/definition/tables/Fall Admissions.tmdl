	column 'Falls admissions max financial month' = ```
			
			VAR currmonth = MONTH(MAX('Fall Admissions'[discharge_date]))
			VAR cal = SWITCH(TRUE(),
			currmonth = 4, 1,
			currmonth = 5, 2,
			currmonth = 6, 3,
			currmonth = 7, 4,
			currmonth = 8, 5,
			currmonth = 9, 6,
			currmonth = 10, 7,
			currmonth = 11, 8,
			currmonth = 12, 9,
			currmonth = 1, 10,
			currmonth = 2, 11,
			currmonth = 3, 12
			)
			return cal
			
			```
		formatString: 0
		lineageTag: dc7572b3-faa3-46b8-9724-c774b654a32e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Falls Admissions financial month' = ```
			
			VAR currmonth = MONTH('Fall Admissions'[discharge_date]
			)
			VAR cal = SWITCH(TRUE(),
			currmonth = 4, 1,
			currmonth = 5, 2,
			currmonth = 6, 3,
			currmonth = 7, 4,
			currmonth = 8, 5,
			currmonth = 9, 6,
			currmonth = 10, 7,
			currmonth = 11, 8,
			currmonth = 12, 9,
			currmonth = 1, 10,
			currmonth = 2, 11,
			currmonth = 3, 12
			)
			return cal
			
			```
		formatString: 0
		lineageTag: 37a7155c-b001-4b7d-8d6d-56b2eb2dd204
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Falls Admissions YTD' = ```
			if('Fall Admissions'[Falls Admissions financial month] <= 'Fall Admissions'[Falls admissions max financial month], "Year to Date", "Not Year to Date")
			
			```
		lineageTag: 25cbf3ca-be85-4b26-9b0f-d13440453012
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Falls Admissions current year' = ```
			
			VAR max_year = YEAR(MAX('Fall Admissions'[discharge_date]
			))
			VAR max_month = MONTH(MAX('Fall Admissions'[discharge_date]
			))
			VAR financial_month = SWITCH(TRUE(),
			max_month = 4, 1,
			max_month = 5, 2,
			max_month = 6, 3,
			max_month = 7, 4,
			max_month = 8, 5,
			max_month = 9, 6,
			max_month = 10, 7,
			max_month = 11, 8,
			max_month = 12, 9,
			max_month = 1, 10,
			max_month = 2, 11,
			max_month = 3, 12
			)
			VAR adjust_year = SWITCH(TRUE(),
			max_month = 1, max_year - 1,
			max_month = 2, max_year - 1,
			max_month = 3, max_year - 1,
			max_month = 4, max_year,
			max_month = 5, max_year,
			max_month = 6, max_year,
			max_month = 7, max_year,
			max_month = 8, max_year,
			max_month = 9, max_year,
			max_month = 10, max_year,
			max_month = 11, max_year,
			max_month = 12, max_year
			)
			return adjust_year
			
			```
		formatString: 0
