	partition Prescribing = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "PowerBI_Reporting", [Query="#(lf)select distinct#(lf)#(lf)[counter] = 1#(lf),[PM].[ID]#(lf),[Item_cost_in_pounds] = Item_Actual_Cost / 100#(lf),[Item_Count]#(lf),[NHS_Number]#(lf),[BNF].[BNFChemicalSubstance]#(lf),[pm].[PARTITION_KEY]#(lf),[PM].[patient_gp_ods] #(lf),Patient_Assessment_Number = RANK() OVER(PARTITION BY [PM].[ID]  ORDER BY [NHS_Number] ASC) #(lf),[Pm].[Processing_Period_Date] #(lf)#(lf)from [PowerBI_Reporting].[dbo].[Care_Home_Patients_PC_Data_v4] [F]#(lf)#(lf)left join data_mart_primary_care_meds.import.patient_medication [PM] ON [PM].[NHS_Number] = [F].[Pseudo_NHS_Number] and [Pm].[Processing_Period_Date] BETWEEN [Care_home_date] and [End_date]#(lf)#(lf)LEFT JOIN [PowerBI_Reporting].[Prescribing].[tbl_BNF_Reference] AS [BNF] ON [BNF].[BNFPresentationCode] = [PM].[Paid_BNF_Code]#(lf)#(lf)WHERE [PM].[Patient_Commissioner] = '11M'#(lf)--AND [PM].[Cost_Centre_Type] = 7#(lf)AND [PARTITION_KEY] >= 202104#(lf)#(lf)ORDER BY [PM].[ID]#(lf)"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

