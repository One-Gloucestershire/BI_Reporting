				    Source = Sql.Database("grh-ccg-sql", "CCG_Reference", [Query="#(lf)SET ANSI_WARNINGS OFF#(lf)SET NOCOUNT ON#(lf)if object_id ('tempdb..#Care_Home') is not null drop table #Care_Home#(lf)#(lf)SELECT DISTINCT#(lf) #(lf)#(tab)Derived_Pseudo_NHSNumber#(lf)    #(tab)  ,[Date_of_incident] = min([Time_Of_Incident]) #(lf)#(lf)#(tab)  INTO #Care_Home#(lf)#(lf)  FROM [CCG_Current].[SWASFT].[vw_AmbulanceServicePatient] [A]#(lf)#(lf)  LEFT JOIN bireports.dbo.Care_Home_Mapping_May23 [CH] ON [CH].[SWASFT Name] = [A].[Residential_or_Nursing_home_Location_Name]#(lf)   #(lf)  where #(lf)  #(lf)   [Residential_or_Nursing_home_Location] not like 'null'#(lf)#(lf)  and Derived_Pseudo_NHSNumber not like 'Null'#(lf)#(lf)  and [Broad Type (confirmed)] not like 'NULL'#(lf)#(lf)  GROUP BY#(lf)  Derived_Pseudo_NHSNumber#(lf)  #(lf)  order by [Date_of_incident]#(lf)#(lf)#(lf)IF OBJECT_ID ('TEMPDB..#table1') IS NOT NULL DROP TABLE #table1#(lf)#(lf)SELECT distinct #(lf)#(lf)[counter] = 1#(lf),[E].[Discharge_Status]#(lf),[dischargestatus] = DS.[preferredTerm]#(lf),[E].[Destination]#(lf),[destinationstatus] = Des.[preferredTerm]#(lf),[Patient_returned_home] = CASE WHEN [Des].[preferredTerm] LIKE 'Discharge to home' #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)  OR [Des].[preferredTerm] LIKE 'Discharge to nursing home' #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)  OR [Des].[preferredTerm] LIKE 'Discharge to residential home'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)  THEN 1 ELSE 0 END#(lf),[P].[Pseudo_NHS_Number]#(lf),[E].[NHS_Number]#(lf),[arrival_date]#(lf),[E].[General_Practice]#(lf),[P].[Current_patient_flag]#(lf),[rank] = RANK() OVER   #(lf)   (PARTITION BY CDS_Unique_Identifier ORDER BY case when arrival_date between [P].[Care_home_date] and [End_date] then 1 else 0 END DESC)#(lf)#(lf),[Care_home_patient_flag] = case when [E].arrival_date between [P].[Care_home_date] and [end_date] then 1 else 0 END#(lf),[Care_home_patient_description] = case when [E].arrival_date between [P].[Care_home_date] and [end_date] then 'Care Home' else 'Not Care Home' END#(lf),[CDS_Unique_Identifier]#(lf),[chief_complaint] = CASE WHEN [S1].[preferredTerm] LIKE 'Dyspnoea' THEN 'Difficulty breathing' ELSE [S1].[preferredTerm] END#(lf),[Treatment_Code] = [S2].[preferredTerm]#(lf),[non_injurious_attendance_flag] = case when [S2].[preferredTerm] like 'Patient given written advice' and [S3].[preferredTerm] IS NULL then 1 else 0 end#(lf),[non_injurious_attendance] = case when [S2].[preferredTerm] like 'Patient given written advice' and [S3].[preferredTerm] IS NULL then 'Non-Injurious' else 'Potentially Injurious' end#(lf),[non-null_treatment_attendances_flag] = case when [S2].[preferredTerm] is not null then 1 else 0 end#(lf),[ch_flag] = case when  arrival_date between [P].[Care_home_date] and [End_date] then 1 else 0 end#(lf)#(lf),[Death_date_diff] = DATEDIFF(DAY,[arrival_date],[D].[DateOfDeath])#(lf),[48_hour_date_diff] = CASE WHEN DATEDIFF(DAY,[arrival_date],[D].[DateOfDeath]) <= 2 THEN 1 ELSE 0 END#(lf),[D].[DateOfDeath]#(lf)#(lf),Care_home_status = case when [Date_of_incident] <= cast(Arrival_Date as date) then [CH_C].[Broad Type (confirmed)]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) when [Date_of_incident] > cast(Arrival_Date as date) then 'Unknown care home type'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) when cast([E].Arrival_Date as date) between [P].[Care_home_date] and [end_date] and [Date_of_incident] IS NULL THEN 'Unknown care home type'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) ELSE NULL#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) END#(lf)#(lf)#(lf)into #table1#(lf)FROM [CCG_Current].[SEM].[vw_ECDS]  [E]#(lf)#(lf)LEFT JOIN [PowerBI_Reporting].[dbo].[Care_Home_Patients_PC_Data_v4] [P] ON [Pseudo_NHS_Number] = [E].nhs_number#(lf)LEFT JOIN [CCG_Reference].[Population].[vw_PDS_Deaths] [D] ON [D].[Derived_NHS_Number] = [E].[NHS_Number]#(lf)#(lf)LEFT JOIN [BIReports].[dbo].[Snomed_Reference] [S1] ON [S1].[referencedComponentId] = [E].[Chief_Complaint]#(lf)LEFT JOIN [BIReports].[dbo].[Snomed_Reference] [S2] ON [S2].[referencedComponentId] = [E].[Treatment_Code_1]#(lf)LEFT JOIN [BIReports].[dbo].[Snomed_Reference] [S3] ON [S3].[referencedComponentId] = [E].[Treatment_Code_2]#(lf)LEFT JOIN [BIReports].[dbo].[Snomed_Reference] DS on [E].[discharge_status] = DS.[referencedComponentId]#(lf)LEFT JOIN [BIReports].[dbo].[Snomed_Reference] Des on [E].Destination = Des.[referencedComponentId]#(lf)#(lf)LEFT JOIN #Care_Home [CH_A] ON [CH_A].[Derived_Pseudo_NHSNumber] = [E].[NHS_Number]#(lf)LEFT JOIN [CCG_Current].[SWASFT].[vw_AmbulanceServicePatient] [CH_B] on [CH_B].Time_Of_Incident =  [CH_A].Date_of_incident and [CH_B].Derived_Pseudo_NHSNumber = [CH_A].Derived_Pseudo_NHSNumber#(lf)LEFT JOIN bireports.dbo.Care_Home_Mapping_May23 [CH_C] ON [CH_C].[SWASFT Name] = [CH_B].[Residential_or_Nursing_home_Location_Name]#(lf)#(lf)WHERE [E].arrival_date between '2021-04-01' and EOMONTH(DATEADD(MONTH, -1, GETDATE()))#(lf)#(lf)and [Organisation_Code_Commissioner] like '11m'#(lf)and [PROVIDER] like '%RTE%'#(lf)#(lf)order by CDS_Unique_Identifier, [rank]#(lf)#(lf)#(lf)select#(lf)*#(lf)from #table1#(lf)where [rank] = 1"]),
