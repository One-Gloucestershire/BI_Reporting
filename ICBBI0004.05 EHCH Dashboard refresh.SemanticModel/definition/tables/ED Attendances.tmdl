table 'ED Attendances'
	lineageTag: 9204ff2d-61b8-4d48-8338-992191a11d6e

	measure 'Total Last FY Attendances' =
			
			CALCULATE(
				SUM('ED Attendances'[Care Home ED Attendances]),
			    'Date Table'[financial_year] = 'Date Table'[Last_FY]
			)
		formatString: 0
		lineageTag: 6a1acf68-6eb7-446b-b622-ccdde90ed3ec

	measure 'CH Current FY YTD Attendances' =
			
			CALCULATE(
				SUM('ED Attendances'[Care Home ED Attendances]),
			   'ED Attendances'[ED attendances year adjusted] = 'ED Attendances'[ED attendances current year]
			)
		formatString: 0
		lineageTag: ce90a0e0-993e-4c6d-b3ca-6fc34fcf7add

	measure 'CH Last FY YTD Attendances' =
			
			CALCULATE(
				SUM('ED Attendances'[Care Home ED Attendances]),
			    'ED Attendances'[ED attendances year adjusted] = 'ED Attendances'[ED attendances previous year]
			)
		formatString: 0
		lineageTag: 7ba4013c-597a-49fb-b1ca-0d8c6c0a8cad

	measure '% Over/Under FY YTD Attendances' = CALCULATE(('ED Attendances'[CH Current FY YTD Attendances] - 'ED Attendances'[CH Last FY YTD Attendances]))/'ED Attendances'[CH Last FY YTD Attendances]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 8fc9da82-a14b-4c7b-872f-2dc9b3d26881

	measure '% non-injurious' = CALCULATE(sum('ED Attendances'[non_injurious_attendance_flag]),'ED Attendances'[Care Home ED Attendances] == 1) /sum('ED Attendances'[Care Home ED Attendances])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9561619f-7e7d-45a6-9b06-de6b83795bdc

	measure 'Non-CH Current FY YTD Attendances' =
			
			CALCULATE(
				SUM('ED Attendances'[counter]),
			    'Date Table'[ytd_flag] IN { 1 },
			    'Date Table'[Current_FY_Flag] in { 1 }
			)
		formatString: 0
		lineageTag: c1eae2f1-5c74-4a96-bc0c-5d112189c499

	measure 'Non-CH Last FY YTD Attendances' =
			
			CALCULATE(
				SUM('ED Attendances'[counter]),
			    'Date Table'[ytd_flag] IN { 1 },
			    'Date Table'[financial_year] = 'Date Table'[Last_FY]
			)
		formatString: 0
		lineageTag: 74169059-b027-4aea-a9ee-f3d982cd4715

	measure '% of attendances from CH year on year comparison' =
			CALCULATE(
			    ('ED Attendances'[CH Current FY YTD Attendances]/('ED Attendances'[All FY YTD Attendances]))
			    -
			    ('ED Attendances'[CH Last FY YTD Attendances]/('ED Attendances'[All LY YTD Attendances])))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4697cf10-db1e-456c-95a1-1cf981c44eba

	measure 'Current FY top 3 attendances codes' = ```
			
			CALCULATE (
			SUM ( 'ED Attendances'[Care Home ED Attendances] ),
			ALLEXCEPT ( 'ED Attendances', 'ED Attendances'[chief_complaint], 'Year to Date Reference'[YTD Reference] ),
			'ED Attendances'[ED attendances year adjusted] = 'ED Attendances'[ED attendances current year]
			)
			
			```
		formatString: 0
		lineageTag: 9e2eb1f1-6f9d-4135-adf2-1a897bdbcb44

	measure 'Last FY top 3 attendances codes' = ```
			
			CALCULATE (
			SUM ( 'ED Attendances'[Care Home ED Attendances] ),
			ALLEXCEPT ( 'ED Attendances', 'ED Attendances'[chief_complaint] ),
			'ED Attendances'[ED attendances year adjusted] = 'ED Attendances'[ED attendances previous year], 'ED Attendances'[ED attendances YTD] = "Year to Date"
			)
			
			```
		formatString: 0
		lineageTag: 1d98d12b-831d-43ab-abe7-cb3d16d7755a

	measure 'Measure 2'
