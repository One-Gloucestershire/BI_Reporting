	column 'ED attendances YTD' = ```
			if('ED Attendances'[ED attendances financial month] <= 'ED Attendances'[ED attendances max financial month], "Year to Date", "Not Year to Date")
			
			```
		lineageTag: 4f0475e9-17a5-451d-ad71-58b5ca8e287d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'ED attendances current year' = ```
			
			VAR max_year = YEAR(MAX('ED Attendances'[arrival_date]
			))
			VAR max_month = MONTH(MAX('ED Attendances'[arrival_date]
			))
			VAR financial_month = SWITCH(TRUE(),
			max_month = 4, 1,
			max_month = 5, 2,
			max_month = 6, 3,
			max_month = 7, 4,
			max_month = 8, 5,
			max_month = 9, 6,
			max_month = 10, 7,
			max_month = 11, 8,
			max_month = 12, 9,
			max_month = 1, 10,
			max_month = 2, 11,
			max_month = 3, 12
			)
			VAR adjust_year = SWITCH(TRUE(),
			max_month = 1, max_year - 1,
			max_month = 2, max_year - 1,
			max_month = 3, max_year - 1,
			max_month = 4, max_year,
			max_month = 5, max_year,
			max_month = 6, max_year,
			max_month = 7, max_year,
			max_month = 8, max_year,
			max_month = 9, max_year,
			max_month = 10, max_year,
			max_month = 11, max_year,
			max_month = 12, max_year
			)
			return adjust_year
			
			```
		formatString: 0
		lineageTag: cd5084a3-7e56-46b2-b638-e1ecb74f933f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'ED attendances year adjusted' = ```
			if(
			    'ED Attendances'[ED attendances financial month] = 10, YEAR('ED Attendances'[arrival_date]) -1, 
			    if('ED Attendances'[ED attendances financial month] = 11, YEAR('ED Attendances'[arrival_date]) -1, 
			    if('ED Attendances'[ED attendances financial month] = 12, YEAR('ED Attendances'[arrival_date]) -1, year('ED Attendances'[arrival_date]))))
			
			```
		formatString: 0
		lineageTag: 6af5b529-aa2d-4ad9-ba19-7a00bfa50458
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'ED attendances previous year' = ```
			'ED Attendances'[ED attendances current year] - 1
			
			```
		formatString: 0
