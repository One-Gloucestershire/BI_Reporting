table 'Care Home Staff'
	lineageTag: 751c75e8-b90f-440c-b2d3-878b1caf9418

	measure 'Nurse vacancy %' = ```
			CALCULATE(
			    (
			        sum('Care Home Staff'[NursesAbsentGeneral]) + SUM('Care Home Staff'[NursesAbsentCovid])
			        )
			    /
			    (
			        sum('Care Home Staff'[NursesEmployed])+sum('Care Home Staff'[NursesAbsentGeneral]) + SUM('Care Home Staff'[NursesAbsentCovid])
			        )
			        )
			
			
			 
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e5fde235-e40f-420b-8b1d-03cf2ac738d5

	measure 'Care worker vacancy %' =
			CALCULATE(
			    (
			        sum('Care Home Staff'[CareWorkersAbsentGeneral]) + sum('Care Home Staff'[CareWorkersAbsentCovid])
			        )
			    /
			    (
			        sum('Care Home Staff'[CareWorkersEmployed])+sum('Care Home Staff'[CareWorkersAbsentGeneral]) + sum('Care Home Staff'[CareWorkersAbsentCovid])
			        )
			        )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 652d0df1-2cbd-4d84-bb09-ff23c968f44d

