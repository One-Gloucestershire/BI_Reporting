		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Reference", [Query="#(lf)IF OBJECT_ID ('TEMPDB..#care_home') IS NOT NULL DROP TABLE #care_home#(lf);#(lf)#(lf)SELECT DISTINCT#(lf)#(lf)[Pseudo_NHS_Number]#(lf),[Care_home_date]#(lf)#(lf)--,[P].[PrimaryCareProvider]#(lf)#(lf)INTO #care_home#(lf)#(lf)FROM [PowerBI_Reporting].[dbo].[Care_Home_Patients_PC_Data_v4] [C]#(lf)#(lf)--LEFT JOIN [CCG_Reference].[Population].[vw_PDS_Current] [P] ON [P].[Derived_NHS_Number] = [C].[Pseudo_NHS_Number]#(lf)#(lf)WHERE #(lf)#(lf)[Current_patient_flag] like '1'#(lf)#(lf)#(lf)IF OBJECT_ID ('TEMPDB..#respect') IS NOT NULL DROP TABLE #respect#(lf);#(lf)#(lf)SELECT distinct#(lf)[C].[Pseudo_NHS_Number]#(lf),[Has_respect_form] = case when [C].[Pseudo_NHS_Number] is not null then 'Yes' else 'No' END#(lf),[Has_respect_form_flag] = case when [C].[Pseudo_NHS_Number] is not null then 1 else 0 END#(lf),[respect_coded_in_current_FY_flag] = case when#(lf)DATEPART(month,GETDATE()) in (1, 2, 3) and #(lf)DATEPART(month,Event_Date) in (4, 5, 6, 7, 8, 9, 10, 11, 12)#(lf)and#(lf)DATEPART(YEAR,Event_Date) = datepart(year,GETDATE()) -1 then 1#(lf)when DATEPART(month,GETDATE()) in (4, 5, 6, 7, 8, 9, 10, 11, 12)#(lf)and #(lf)DATEPART(month,Event_Date) in (4, 5, 6, 7, 8, 9, 10, 11, 12)#(lf)and DATEPART(YEAR,Event_Date) = datepart(year,GETDATE()) then 1 #(lf)when#(lf)DATEPART(month,GETDATE()) in (1, 2, 3) and #(lf)DATEPART(month,Event_Date) in (1, 2, 3)#(lf)and#(lf)DATEPART(YEAR,Event_Date) = datepart(year,GETDATE()) then 1#(lf)when#(lf)DATEPART(month,GETDATE()) in (4, 5, 6, 7, 8, 9, 10, 11, 12) and #(lf)DATEPART(month,Event_Date) in (1, 2, 3)#(lf)and#(lf)DATEPART(YEAR,Event_Date) -1 = datepart(year,GETDATE()) then 1#(lf)else 0 end#(lf)#(lf)#(lf)INTO #respect#(lf)#(lf)FROM#(lf)(SELECT#(lf)[C].[Pseudo_NHS_Number]#(lf),[event_date] = max([event_date])#(lf)FROM #care_home AS [C]#(lf)#(lf)LEFT JOIN [CCG_Current].PrimaryCare.vw_Events [E] ON [E].[Pseudo_NHS_Number] = [C].[Pseudo_NHS_Number]#(lf)#(lf)WHERE #(lf)[E].[snomed_code] like '1107891000000100' #(lf)or [E].[snomed_code] like '1382601000000100'#(lf)or [E].[Event_Code] like 'Y1fc1'#(lf)or [E].[Event_Code] like 'Y3bfa'#(lf)#(lf)GROUP BY [C].[Pseudo_NHS_Number]#(lf)#(lf)) AS [C]#(lf)#(lf)#(lf)#(lf)IF OBJECT_ID ('TEMPDB..#smr') IS NOT NULL DROP TABLE #smr#(lf);#(lf)#(lf)SELECT DISTINCT#(lf)[C].[Pseudo_NHS_Number]#(lf),[Has_SMR] = case when [C].[Pseudo_NHS_Number] is not null then 'Yes' else 'No' END#(lf),[Has_SMR_flag] = case when [C].[Pseudo_NHS_Number] is not null then 1 else 0 END#(lf),[SMR_coded_in_current_FY_flag] = case when#(lf)DATEPART(month,GETDATE()) in (1, 2, 3) and #(lf)DATEPART(month,Event_Date) in (4, 5, 6, 7, 8, 9, 10, 11, 12)#(lf)and#(lf)DATEPART(YEAR,Event_Date) = datepart(year,GETDATE()) -1 then 1#(lf)when DATEPART(month,GETDATE()) in (4, 5, 6, 7, 8, 9, 10, 11, 12)#(lf)and #(lf)DATEPART(month,Event_Date) in (4, 5, 6, 7, 8, 9, 10, 11, 12)#(lf)and DATEPART(YEAR,Event_Date) = datepart(year,GETDATE()) then 1 #(lf)when#(lf)DATEPART(month,GETDATE()) in (1, 2, 3) and #(lf)DATEPART(month,Event_Date) in (1, 2, 3)#(lf)and#(lf)DATEPART(YEAR,Event_Date) = datepart(year,GETDATE()) then 1#(lf)when#(lf)DATEPART(month,GETDATE()) in (4, 5, 6, 7, 8, 9, 10, 11, 12) and #(lf)DATEPART(month,Event_Date) in (1, 2, 3)#(lf)and#(lf)DATEPART(YEAR,Event_Date) -1 = datepart(year,GETDATE()) then 1#(lf)else 0 end#(lf)#(lf)INTO #smr#(lf)#(lf)FROM#(lf)(SELECT#(lf)[C].[Pseudo_NHS_Number]#(lf),[event_date] = max([event_date])#(lf)FROM #care_home [C]#(lf)#(lf)LEFT JOIN [CCG_Current].PrimaryCare.vw_Events [E] ON [E].[Pseudo_NHS_Number] = [C].[Pseudo_NHS_Number]#(lf)#(lf)WHERE [E].[snomed_code] like '1239511000000100'#(lf)#(lf)GROUP BY#(lf)[C].[Pseudo_NHS_Number]#(lf)#(lf)) AS [C]#(lf)#(lf)#(lf)#(lf)#(lf)IF OBJECT_ID ('TEMPDB..#MDT') IS NOT NULL DROP TABLE #MDT#(lf)#(lf)SELECT DISTINCT#(lf)[C].[Pseudo_NHS_Number]#(lf),[Has_MDT_review] = case when [C].[Pseudo_NHS_Number] is not null then 'Yes' else 'No' END#(lf),[Has_MDT_review_flag] = case when