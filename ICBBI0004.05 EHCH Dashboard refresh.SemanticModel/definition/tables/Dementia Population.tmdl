table 'Dementia Population'
	lineageTag: 6bbc8b87-7e03-474c-bcbc-7ce68f995168

	measure 'Current Dementia Population' = CALCULATE(SUM('Dementia Population'[dementia_register]), 'Dementia Population'[FirstDateofMonth] = 'Dementia Population'[Max Month])
		formatString: 0
		lineageTag: 877ac500-35c7-4a98-838f-c73c3f8f7f71

	measure '% of dementia patients in a care home' = [Current Dementia Care Home Population] / [Current Dementia Population]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: bbe7fa7c-c38d-4c9d-a216-9f5b53588fc5

