table 'Occupancy grouped'
	lineageTag: 54c4d6e4-5d83-4dc8-84e6-2020bc5e2756

	measure 'Total % Occupied' = calculate(sum('Occupancy grouped'[Occupied])/sum('Occupancy grouped'[Care homes beds]))
		formatString: 0%;-0%;0%
		lineageTag: 75e7fb5f-edde-4244-bdc7-e6c92e86a548

	measure 'Total Vacant Beds' = calculate(sum('Occupancy grouped'[Care homes beds]) - sum('Occupancy grouped'[Occupied]))
		formatString: 0
		lineageTag: f0294148-5deb-4aea-b5d5-7dbdd531bf72

	column Occupied
		dataType: int64
		formatString: 0
		lineageTag: a00038f4-81ba-4152-a62f-8461452e3b2e
		summarizeBy: sum
		sourceColumn: Occupied

		annotation SummarizationSetBy = Automatic

	column 'Care homes beds'
