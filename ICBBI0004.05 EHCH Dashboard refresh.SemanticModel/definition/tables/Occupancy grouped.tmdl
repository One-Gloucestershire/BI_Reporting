		summarizeBy: none
		sourceColumn: CqcId

		annotation SummarizationSetBy = Automatic

	partition 'Occupancy grouped' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "BIReports", [Query="--Table for getting the most up to date month for CQC data#(lf)SET NOCOUNT ON#(lf)IF OBJECT_ID ('TEMPDB..#max_date') IS NOT NULL DROP TABLE #max_date#(lf);#(lf)#(lf)SELECT#(lf)[max_published_date] = max(published_date)#(lf),[Current_up_to_date_month] = 'Yes'#(lf)INTO #max_date#(lf)FROM [BIReports].[dbo].[CQC_Monthly_List]#(lf)#(lf)--------------------------------------------------------#(lf)--------------------------------------------------------#(lf)#(lf)SELECT#(lf)#(lf)[Occupied] = sum([Occupied])#(lf),[Q].[Care homes beds]#(lf),[Q].[Location Name]#(lf),[CqcId]#(lf)#(lf)#(lf)FROM [BIReports].[dbo].[Capacity_Tracker_Monthly_List] [C]#(lf)#(lf)LEFT JOIN #(lf)(SELECT *#(lf)FROM [BIReports].[dbo].[CQC_Monthly_List]#(lf)LEFT JOIN #max_date [M] ON [M].[max_published_date] = Published_Date#(lf)WHERE [Current_up_to_date_month] like 'Yes') AS [Q] ON [Q].[location id] = [C].[CqcId]#(lf)#(lf)WHERE [Location Name]  IS NOT NULL#(lf)#(lf) group by #(lf) [Q].[Care homes beds]#(lf),[Q].[Location Name]#(lf),[CqcId]#(lf)#(lf)order by [Location Name]"])
				in
				    Source

	annotation PBI_ResultType = Table

