	partition 'Rockwood Score' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Current", [Query="#(lf)SET NOCOUNT ON#(lf)IF OBJECT_ID ('TEMPDB..#table1') IS NOT NULL DROP TABLE #table1#(lf);#(lf)#(lf)SELECT distinct#(lf)#(lf)[C].[Pseudo_NHS_Number]#(lf),[Practice_Code]#(lf),[Event_date]#(lf),[Value_1]#(lf),Event_code_rank = RANK() OVER(PARTITION BY [C].[Pseudo_NHS_Number] ORDER BY cast(event_date as date) desc) #(lf)#(lf)INTO #table1#(lf)#(lf)FROM [PowerBI_Reporting].[dbo].[Care_Home_Patients_PC_Data_v4] [C]#(lf)#(lf)LEFT JOIN [CCG_Current].[PrimaryCare].[vw_Events] [E] on [E].[Pseudo_NHS_Number] = [C].[Pseudo_NHS_Number]#(lf)#(lf)#(tab)WHERE ([Event_Code] COLLATE SQL_Latin1_General_CP1_CS_AS IN ('XaQik')#(lf)#(tab)OR [Snomed_Code] = '763264000')#(lf)#(lf)#(tab)AND [C].[Current_patient_flag] LIKE 1#(lf)#(lf)#(tab)order by [C].[Pseudo_NHS_Number], Event_Date#(lf)#(lf)#(lf)#(tab)SELECT DISTINCT *#(lf)#(tab)FROM #table1#(lf)#(tab)WHERE Event_code_rank LIKE 1"])
				in
