				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Reference", [Query="#(lf)SET ANSI_WARNINGS OFF#(lf)SET NOCOUNT ON#(lf)if object_id ('tempdb..#Care_Home') is not null drop table #Care_Home#(lf)#(lf)SELECT DISTINCT#(lf) #(lf)#(tab)Derived_Pseudo_NHSNumber#(lf)    #(tab)  ,[Date_of_incident] = min([Time_Of_Incident]) #(lf)#(lf)#(tab)  INTO #Care_Home#(lf)#(lf)  FROM [CCG_Current].[SWASFT].[vw_AmbulanceServicePatient] [A]#(lf)#(lf)  LEFT JOIN bireports.dbo.Care_Home_Mapping_May23 [CH] ON [CH].[SWASFT Name] = [A].[Residential_or_Nursing_home_Location_Name]#(lf)   #(lf)  where #(lf)  #(lf)   [Residential_or_Nursing_home_Location] not like 'null'#(lf)#(lf)  and Derived_Pseudo_NHSNumber not like 'Null'#(lf)#(lf)  and [Broad Type (confirmed)] not like 'NULL'#(lf)#(lf)  GROUP BY#(lf)  Derived_Pseudo_NHSNumber#(lf)  #(lf)  order by [Date_of_incident]#(lf)#(lf)IF OBJECT_ID ('TEMPDB..#table1') IS NOT NULL DROP TABLE #table1#(lf)#(lf)SELECT distinct R.ServiceRequestID#(lf),ReferralRequestReceivedDate#(lf),SourceOfReferralDescription#(lf),OrgIDReferring#(lf),ReferringStaffGroupDescription#(lf),PriorityTypeDescription#(lf),PrimaryReferralReasonDescription#(lf),DischargeDate#(lf),OrgIDProviderDescription#(lf),UniqueServiceRequestID#(lf),AgeYrReferralReceivedDate#(lf),DerivedPseudoNHS#(lf),TeamTypeDescription#(lf),ReferralClosureReasonDescription#(lf),ReferralRejectionReasonDescription#(lf)#(tab),d.FinancialYear#(lf)#(tab),d.FinancialMonth#(lf)#(tab),d.MonthName#(lf)#(tab),h.Team#(lf)#(tab),h.Service#(lf)#(tab),[Counter] = 1#(lf)#(tab),[Care_home_patient_flag] = case when ReferralRequestReceivedDate between [P].[Care_home_date] and end_date then 1 else 0 END#(lf)#(tab),p.[Pseudo_NHS_Number]#(lf)#(tab),Care_home_status = case when [Date_of_incident] <= cast(ReferralRequestReceivedDate as date) then [CH_C].[Broad Type (confirmed)]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) when [Date_of_incident] > cast(ReferralRequestReceivedDate as date) then 'Unknown care home type'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) when cast(ReferralRequestReceivedDate as date) between [P].[Care_home_date] and [end_date] and [Date_of_incident] IS NULL THEN 'Unknown care home type'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) ELSE NULL#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) END#(lf)#(lf)#(tab)#(lf)#(tab),[rank] = RANK() OVER   #(lf)    (PARTITION BY UniqueServiceRequestID ORDER BY case when ReferralRequestReceivedDate between [P].[Care_home_date] and [End_date] then 1 else 0 END DESC)#(lf)#(lf)#(lf)#(tab)  into #table1#(lf)#(tab)  FROM [CCG_Current].[CSDS].[vw_301_Referral] as r#(lf) #(lf)#(tab)  left join CCG_Reference.Reference.vw_DateLookup as d on d.Date = r.ReferralRequestReceivedDate#(lf)#(tab)  left join CCG_Reference.GHC.vw_Hierarchy as h on r.Current_CostCentre = H.Cost_Centre#(lf)#(tab)  LEFT JOIN [PowerBI_Reporting].[dbo].[Care_Home_Patients_PC_Data_v4] [P] ON P.[Pseudo_NHS_Number] = [r].DerivedPseudoNHS#(lf)#(lf)#(tab)  LEFT JOIN #Care_Home [CH_A] ON [CH_A].[Derived_Pseudo_NHSNumber] = [R].[DerivedPseudoNHS]#(lf)#(tab)  LEFT JOIN [CCG_Current].[SWASFT].[vw_AmbulanceServicePatient] [CH_B] on [CH_B].Time_Of_Incident =  [CH_A].Date_of_incident and [CH_B].Derived_Pseudo_NHSNumber = [CH_A].Derived_Pseudo_NHSNumber#(lf)#(tab)  LEFT JOIN bireports.dbo.Care_Home_Mapping_May23 [CH_C] ON [CH_C].[SWASFT Name] = [CH_B].[Residential_or_Nursing_home_Location_Name]#(lf)#(lf)#(lf)#(tab)  where OrgIDProvider in ('R1J','RTQ')#(lf)#(lf)#(lf)#(tab)  and r.ReferralRequestReceivedDate between '20220401' and EOMONTH(DATEADD(MONTH, -1, GETDATE()))#(lf)#(tab)#(lf)#(lf)#(tab)  and h.Cost_Centre in ('G15503', --Rapid Response#(lf)#(tab)  'G15503a', --Rapid Response - RR - ENDNS#(lf)#(tab) 'G15503b')--Rapid Response - RR - District Nursing#(lf)#(tab)#(tab)#(lf)#(tab) #(lf)#(tab)#(tab)select#(lf)#(tab)#(tab)*#(lf)#(tab)#(tab)from #table1#(lf)#(tab)#(tab)where [rank] = 1"]),
