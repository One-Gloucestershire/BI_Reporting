	column 'Rapid response current year' = ```
			
			VAR max_year = YEAR(MAX('Rapid Response'[ReferralRequestReceivedDate]
			))
			VAR max_month = MONTH(MAX('Rapid Response'[ReferralRequestReceivedDate]
			))
			VAR financial_month = SWITCH(TRUE(),
			max_month = 4, 1,
			max_month = 5, 2,
			max_month = 6, 3,
			max_month = 7, 4,
			max_month = 8, 5,
			max_month = 9, 6,
			max_month = 10, 7,
			max_month = 11, 8,
			max_month = 12, 9,
			max_month = 1, 10,
			max_month = 2, 11,
			max_month = 3, 12
			)
			VAR adjust_year = SWITCH(TRUE(),
			max_month = 1, max_year - 1,
			max_month = 2, max_year - 1,
			max_month = 3, max_year - 1,
			max_month = 4, max_year,
			max_month = 5, max_year,
			max_month = 6, max_year,
			max_month = 7, max_year,
			max_month = 8, max_year,
			max_month = 9, max_year,
			max_month = 10, max_year,
			max_month = 11, max_year,
			max_month = 12, max_year
			)
			return adjust_year
			
			```
		formatString: 0
		lineageTag: 77229f85-8ce6-4fa4-b351-a935a9b7ecc4
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Rapid response year adjusted' = ```
			if(
			    'Rapid Response'[Rapid response financial month] = 10, YEAR('Rapid Response'[ReferralRequestReceivedDate]) -1, 
			    if('Rapid Response'[Rapid response financial month] = 11, YEAR('Rapid Response'[ReferralRequestReceivedDate]) -1, 
			    if('Rapid Response'[Rapid response financial month]= 12, YEAR('Rapid Response'[ReferralRequestReceivedDate]) -1, year('Rapid Response'[ReferralRequestReceivedDate]))))
			
			```
		formatString: 0
		lineageTag: 3ada9122-1c82-43a6-8743-974948618bd5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Rapid response previous year' = ```
			'Rapid Response'[Rapid response current year] - 1
			
			```
		formatString: 0
