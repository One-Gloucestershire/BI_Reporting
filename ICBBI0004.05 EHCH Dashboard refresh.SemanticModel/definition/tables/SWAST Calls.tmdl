	measure 'YTD SWAST Rate per 1000 Yearly' =
			
			
			VAR SWAST = CALCULATE ( SUM ('SWAST Calls'[Care Home SWAST Calls] ), 'Date Table'[ytd_flag] IN { 1 }, ALLEXCEPT( 'date table', 'date table'[financial_year] )  )
			VAR POP = CALCULATE ( [Care Home Population Per Month]  , ALLEXCEPT ('date table', 'date table'[financial_year] ), 'date table'[month_name] IN {"Apr"} )
			
			RETURN (SWAST/POP*1000)
		lineageTag: 57ab5573-d80e-457f-8fba-a4a8f0551bbe

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SWAST Rate per 1000 Yearly' =
			
			
			VAR SWAST = CALCULATE ( SUM ('SWAST Calls'[Care Home SWAST Calls] ))
			VAR POP = CALCULATE ( [Care Home Population Per Month] , ALLEXCEPT ('date table', 'date table'[financial_year] ), 'date table'[month_name] IN {"Apr"} )
			
