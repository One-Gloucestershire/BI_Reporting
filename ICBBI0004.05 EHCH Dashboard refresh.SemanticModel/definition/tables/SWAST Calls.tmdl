	measure 'Data up to' =
			
			VAR currmonth = MONTH((MAX('SWAST Calls'[SWAST_call_date])))
			VAR year_name = CONCATENATE(" ",Year(MAX('SWAST Calls'[SWAST_call_date])))
			
			VAR month_name = SWITCH(TRUE(),
			currmonth = 4, "April",
			currmonth = 5, "May",
			currmonth = 6, "June",
			currmonth = 7, "July",
			currmonth = 8, "August",
			currmonth = 9, "September",
			currmonth = 10, "October",
			currmonth = 11, "November",
			currmonth = 12, "December",
			currmonth = 1, "January",
			currmonth = 2, "February",
			currmonth = 3, "March"
			)
			
			return CONCATENATE(month_name,year_name)
		lineageTag: e15498a5-156e-4f86-9f66-d10244bf3c9a

	measure 'SWAST activity y-axis' = ```
			
			
			VAR  rate_or_actual = 
			    if(SELECTEDVALUE('Actual or Rate'[Actual or Rate]) = "Actual Activity", "Actual"
			    ,if(SELECTEDVALUE('Actual or Rate'[Actual or Rate]) = "Rate per 1000", "Rate"))
			
			
			VAR x_axis =
			    SELECTCOLUMNS (
			        SUMMARIZE ( 'Month or Year Parameter', 'Month or Year Parameter'[Month or Year Parameter], 'Month or Year Parameter'[Month or Year Parameter Fields] ),
			        'Month or Year Parameter'[Month or Year Parameter])
			
			RETURN  if(rate_or_actual = "Rate" && x_axis = "Yearly", 'SWAST Calls'[SWAST Rate per 1000 Yearly]
			
			        ,if(rate_or_actual = "Rate" && x_axis = "Monthly", 'SWAST Calls'[SWAST Rate per 1000 Monthly]
			        
			        ,if(rate_or_actual = "Actual", CALCULATE(sum('SWAST Calls'[Care Home SWAST Calls])))))
			```
		lineageTag: 40d97865-577b-4f45-ba72-d9372e0cee2d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SWAST activity title' = ```
			
			
			VAR  rate_or_actual = 
			    if(SELECTEDVALUE('Actual or Rate'[Actual or Rate]) = "Actual Activity", "Actual"
			    ,if(SELECTEDVALUE('Actual or Rate'[Actual or Rate]) = "Rate per 1000", "Rate"))
			
			
			VAR x_axis =
			    SELECTCOLUMNS (
			        SUMMARIZE ( 'Month or Year Parameter', 'Month or Year Parameter'[Month or Year Parameter], 'Month or Year Parameter'[Month or Year Parameter Fields] ),
			        'Month or Year Parameter'[Month or Year Parameter])
			
			RETURN  if(rate_or_actual = "Rate", "SWAST Calls for Care Home Residents - Rate per 1000"
			        ,if(rate_or_actual = "Actual", "SWAST Calls for Care Home Residents - Actual Number of Calls"))
			```
		lineageTag: ec0e168f-4129-4c6b-8777-cbc2757006bb

