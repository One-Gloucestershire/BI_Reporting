S_Number and [E].[Time_Of_Incident] between b.AddressEffectiveDate and getdate() AND B.ResidentialNursingHomeFlag = 1#(lf)left join ccg_reference.reference.vw_GPPractice gp on b.PrimaryCareProvider = gp.OrganisationCode#(lf)LEFT JOIN [CCG_Reference].[Population].[vw_PDS_Deaths] [D] ON [D].[Derived_NHS_Number] = [E].[Derived_Pseudo_NHSNumber]#(lf)#(lf)WHERE#(lf)#(lf)cast(Time_Of_Incident as date) between '2021-04-01' and EOMONTH(DATEADD(MONTH, -1, GETDATE()))#(lf)#(lf)and [E].CCG like '11m'#(lf)#(lf)order by [Pseudo_NHS_Number], SWAST_call_date asc#(lf)#(lf)#(lf)select#(lf)*#(lf)from #table1#(lf)where [rank] = 1#(lf)and [duplicate] = 'Referral'"]),
