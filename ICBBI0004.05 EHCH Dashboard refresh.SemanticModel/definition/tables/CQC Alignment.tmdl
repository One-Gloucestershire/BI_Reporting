	partition 'CQC Alignment' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "BIReports", [Query="#(lf)--Table for getting the most up to date month for CQC data#(lf)SET NOCOUNT ON#(lf)IF OBJECT_ID ('TEMPDB..#max_date') IS NOT NULL DROP TABLE #max_date#(lf);#(lf)#(lf)SELECT#(lf)[max_published_date] = max(published_date)#(lf),[Current_up_to_date_month] = 'Yes'#(lf)INTO #max_date#(lf)FROM [BIReports].[dbo].[CQC_Monthly_List]#(lf)#(lf)#(lf)-------------------------------------------------------#(lf)-------------------------------------------------------#(lf)#(lf)#(lf)SELECT distinct#(lf)#(lf)[Aligned_PCN] = case when [p].[pcn] IS NULL then 'No aligned PCN' else [p].[pcn] END#(lf),[Bed_count] = CASE WHEN p.[total beds] IS NULL THEN 0 ELSE p.[total beds] END#(lf),[Latest_CQC_rating] = CASE WHEN q.[location latest overall rating] IS NULL THEN 'No known rating' ELSE q.[location latest overall rating]  END#(lf),[SWASFT Name]#(lf)--,[SWAST_aligned_name] = case when [location name] = 'The Lawns' and [pcn] = 'TWNS ' then null else [SWASFT Name] end#(lf),[Assigned_name] = CASE#(tab)WHEN [CQC_Care_Home_Name] IS NULL THEN UPPER(LEFT([SWASFT Name],1))+LOWER(SUBSTRING([SWASFT Name],2,LEN([SWASFT Name])))#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [location name] = 'The Lawns' AND [pcn] = 'TWNS ' THEN 'The Lawns (TWNS)'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [location name] = 'The Lawns' AND [pcn] = 'Rosebank & Bartongate 'THEN [CQC_Care_Home_Name]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [CQC_Care_Home_Name] IS NOT NULL THEN [CQC_Care_Home_Name]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)END#(lf)#(lf)FROM [BIReports].[dbo].[Care_Home_Mapping_May23] [M]#(lf)#(lf)LEFT JOIN [BIReports].[dbo].[PCN_CQC_Monthly_List] [P] ON [P].[CQC_Care_Home_Name] = [M].[CQC Name] #(lf)#(lf)LEFT JOIN #(lf)(SELECT *#(lf)FROM [BIReports].[dbo].[CQC_Monthly_List] [A]#(lf)LEFT JOIN #max_date [MD] ON [MD].max_published_date = [A].[Published_Date]#(lf)WHERE [Current_up_to_date_month] like 'Yes') AS [Q] ON [Q].[Location Name] = [P].[CQC_Care_Home_Name] and [Q].[Location Postal Code] = [P].[Postcode]#(lf)#(lf)#(lf)order by [Assigned_name]"])
				in
				    Source

	annotation PBI_ResultType = Table

