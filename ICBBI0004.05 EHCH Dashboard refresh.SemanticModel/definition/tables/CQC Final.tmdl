table 'CQC Final'
	lineageTag: 9bec2952-0012-4c8f-ac6e-8ececeb0aed1

	measure 'See & Convey' = CALCULATE(sum('SWAST Calls'[Care Home SWAST Calls]),'SWAST Calls'[Outcome] == "See & Convey")
		formatString: 0
		lineageTag: ccfbf0a9-12ea-47eb-86ec-e930c8e6ba1c

	measure 'Total Activity Rate per 100' = IFERROR(sum('SWAST Calls'[Care Home SWAST Calls])/sum('CQC Final'[Bed_count]) * 100, BLANK())
		lineageTag: a1cf0a12-9086-43d4-8093-97b78e0c8612

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'See & Convey Rate per 100' = IFERROR('CQC Final'[See & Convey]/sum('CQC Final'[Bed_count]) * 100, BLANK())
		formatString: 0.00
		lineageTag: e48b7985-e99a-46a4-bfb6-0f5c672ea92e

	measure 'See and Convey Rank' = CALCULATE(RANKX(ALL('CQC Final'[Assigned_name]),[See & Convey Rate per 100],,DESC,Skip) - 1)
		formatString: 0
		lineageTag: 291b94b7-e4a1-44d1-9b9a-8cd68b7bab5b

	measure 'Count of care homes' = CALCULATE(DISTINCTCOUNT('CQC Alignment'[Assigned_name]),ALL('CQC Alignment'))
		formatString: 0
		lineageTag: 5a3d063d-e8fa-461c-a562-819c14a665d3

	measure '20% of Care Homes' = [Count of care homes] * 0.2
		lineageTag: 4d43326c-2a6a-45a8-8c59-2db6b53d83cb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'See and Convey Top 20%' = IF([See and Convey Rank] <= [20% of Care Homes], "Yes", "No")
		lineageTag: 2cfe284b-6ab5-4ee9-b2ba-c62c5bc8c013

	measure 'Total Average Calls per Day pre Training' =
			
			var max_date = max('CQC Final'[Training date])
			var min_date = STARTOFMONTH('SWAST Calls'[SWAST_call_date])
			var diff = DATEDIFF(min_date, max_date, DAY)
			var total_hours = CALCULATE(sum('SWAST Calls'[counter]), 'SWAST Calls'[SWAST_call_date] < max_date)
			RETURN if(total_hours / diff = blank(), blank(), total_hours / diff)
		formatString: 0.0000
		lineageTag: a1e712a7-f9a6-4847-9ece-b47a4d321651

	measure 'Total Average Calls per Day post Training' = ```
			
			var max_date =  "31/03/2024"
			var min_date = max('CQC Final'[Training date])
			var diff = DATEDIFF(min_date, max_date, DAY)
			var total_hours = CALCULATE(sum('SWAST Calls'[counter]), 'SWAST Calls'[SWAST_call_date] > min_date)
			RETURN 
			IF(
			total_hours / diff 
			= blank(), 0, total_hours / diff)
			```
		lineageTag: 5b0a687e-1d56-483b-a6e4-c7244e1655a7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

