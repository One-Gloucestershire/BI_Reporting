	column 'Column Total Average Calls per Day pre Training' =
			
			var max_date = 'CQC Final'[Training date]
			var min_date = STARTOFMONTH('SWAST Calls'[SWAST_call_date])
			var diff = DATEDIFF(min_date, max_date, DAY)
			var total_hours = CALCULATE(sum('SWAST Calls'[Care Home SWAST Calls]), 'SWAST Calls'[SWAST_call_date] < max_date, 'SWAST Calls'[Symptom_Group_Chief_Complaint] = "Falls")
			RETURN if(total_hours / diff = blank(), blank(), total_hours / diff)
		formatString: 0.000
		lineageTag: 45098f4e-c71a-4d1f-b72c-9a7033b9736b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Column Total Average Calls per Day post Training' = ```
			
			var max_date =  MAX('SWAST Calls'[SWAST_call_date])
			var min_date = 'CQC Final'[Training date]
			var diff = DATEDIFF(min_date, max_date, DAY)
			var total_hours = CALCULATE(sum('SWAST Calls'[Care Home SWAST Calls]), 'SWAST Calls'[SWAST_call_date] > min_date, 'SWAST Calls'[Symptom_Group_Chief_Complaint] = "Falls")
			RETURN 
