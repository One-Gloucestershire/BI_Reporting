	column 'New Column Total Average Calls per Day pre Training' =
			
			var max_date = 'CQC Final'[Training date]
			var min_date_1 = STARTOFMONTH('SWAST Calls'[SWAST_call_date])
			var min_date_2 = [12 months pre training]
			var select_min_date = if(min_date_1 > min_date_2, min_date_1, min_date_2)
			var diff = DATEDIFF(select_min_date, max_date, DAY)
			var total_hours = CALCULATE(sum('SWAST Calls'[Care Home SWAST Calls]), 'SWAST Calls'[SWAST_call_date] < max_date, 'SWAST Calls'[Symptom_Group_Chief_Complaint] = "Falls", 'SWAST Calls'[SWAST_call_date] > select_min_date)
			RETURN if(total_hours / diff = blank(), 0, total_hours / diff)
		formatString: 0.000
		lineageTag: 645cb350-3983-4a49-8b22-e0adce69346c
		summarizeBy: sum

