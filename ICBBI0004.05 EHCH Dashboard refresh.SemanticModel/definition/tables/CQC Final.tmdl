	partition 'CQC Final' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "BIReports", [Query="#(lf)--Table for getting the most up to date month for CQC data#(lf)SET NOCOUNT ON#(lf)IF OBJECT_ID ('TEMPDB..#max_date') IS NOT NULL DROP TABLE #max_date#(lf);#(lf)#(lf)SELECT#(lf)[max_published_date] = max(published_date)#(lf),[Current_up_to_date_month] = 'Yes'#(lf)INTO #max_date#(lf)FROM [BIReports].[dbo].[CQC_Monthly_List]#(lf)#(lf)#(lf)-------------------------------------------------------#(lf)-------------------------------------------------------#(lf)#(lf)#(lf)#(lf)#(lf)SET NOCOUNT ON#(lf)IF OBJECT_ID ('TEMPDB..#Union_table') IS NOT NULL DROP TABLE #Union_table#(lf);#(lf)#(lf)#(lf)SELECT distinct#(lf)#(lf)[Aligned_PCN] = case when [p].[pcn] IS NULL then 'No aligned PCN' else [p].[pcn] END#(lf),[Bed_count] = CASE WHEN [p].[total beds] = [M].[Capacity Tracker Beds] THEN [p].[total beds]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [p].[total beds] IS NULL AND [M].[Capacity Tracker Beds] IS NOT NULL THEN [M].[Capacity Tracker Beds]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [p].[total beds] IS NULL AND [M].[Capacity Tracker Beds] IS NULL THEN 0#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [p].[total beds] != [M].[Capacity Tracker Beds] THEN [p].[total beds]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)END#(lf)#(lf),[Location ID] = cast([Location ID] as varchar)#(lf),[Latest_CQC_rating] = CASE WHEN q.[location latest overall rating] IS NULL THEN 'No known rating' ELSE q.[location latest overall rating]  END#(lf)--,[SWASFT Name]#(lf)--,[SWAST_aligned_name] = case when [location name] = 'The Lawns' and [pcn] = 'TWNS ' then null else [SWASFT Name] end#(lf),[M].[Capacity Tracker Beds]#(lf),[CQC_beds] = [p].[total beds]#(lf),[Assigned_name] = CASE#(tab)WHEN [CQC_Care_Home_Name] IS NULL THEN UPPER(LEFT([SWASFT Name],1))+LOWER(SUBSTRING([SWASFT Name],2,LEN([SWASFT Name])))#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [location name] = 'The Lawns' AND [pcn] = 'TWNS ' THEN 'The Lawns (TWNS)'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [location name] = 'The Lawns' AND [pcn] = 'Rosebank & Bartongate 'THEN [CQC_Care_Home_Name]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [CQC_Care_Home_Name] IS NOT NULL THEN [CQC_Care_Home_Name]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)END#(lf),[CQC_or_not] = CASE WHEN [p].[pcn] IS NULL THEN 'Not CQC' ELSE 'CQC' END #(lf),[SWAST_care_home_type] = m.[Broad Type (confirmed)]#(lf),[SWAST_care_home_type_rank] = RANK() OVER(PARTITION BY CASE#(tab)WHEN [CQC_Care_Home_Name] IS NULL THEN UPPER(LEFT([SWASFT Name],1))+LOWER(SUBSTRING([SWASFT Name],2,LEN([SWASFT Name])))#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [location name] = 'The Lawns' AND [pcn] = 'TWNS ' THEN 'The Lawns (TWNS)'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [location name] = 'The Lawns' AND [pcn] = 'Rosebank & Bartongate 'THEN [CQC_Care_Home_Name]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [CQC_Care_Home_Name] IS NOT NULL THEN [CQC_Care_Home_Name]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)END ORDER BY [Broad Type (confirmed)]  ASC) #(lf)#(lf)into #Union_table#(lf)#(lf)FROM [BIReports].[dbo].[Care_Home_Mapping_May23] AS [M] #(lf)#(lf)#(lf)LEFT JOIN [BIReports].[dbo].[PCN_CQC_Monthly_List] [P] ON [P].[CQC_Care_Home_Name] = [M].[CQC Name] #(lf)#(lf)LEFT JOIN #(lf)(SELECT *#(lf)FROM [BIReports].[dbo].[CQC_Monthly_List] [A]#(lf)LEFT JOIN #max_date [MD] ON [MD].max_published_date = [A].[Published_Date]#(lf)WHERE [Current_up_to_date_month] like 'Yes') AS [Q] ON [Q].[Location Name] = [P].[CQC_Care_Home_Name] and [Q].[Location Postal Code] = [P].[Postcode]#(lf)#(lf)#(lf)UNION#(lf)#(lf)#(lf)#(lf)#(lf)SELECT#(lf)[Aligned_PCN] = case when [p].[pcn] IS NULL then 'No aligned PCN' else [p].[pcn] END#(lf),[Bed_count] = CASE WHEN [p].[total beds] = [M].[Capacity Tracker Beds] THEN [p].[total beds]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [p].[total beds] IS NULL AND [M].[Capacity Tracker Beds] IS NOT NULL THEN [M].[Capacity Tracker Beds]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [p].[total beds] IS NULL AND [M].[Capacity Tracker Beds] IS NULL THEN 0#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [p].[total beds] != [M].[Capacity Tracker Beds] THEN [p].[total beds]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)END#(lf),[Location ID] = cast([Location ID] as varchar)#(lf),[Latest_CQC_rating] = CASE WHEN q.[location latest overall rating] IS NULL THEN 'No known rating' ELSE q.[location latest overall rating]  END#(lf),[M].[Capacity Tracker Beds]#(lf),[CQC_beds] = [p].[total beds]#(lf),[Assigned_name] =  [Location Name]#(lf),[CQC_or_not] = CASE WHEN [p].[pcn] IS NULL THEN 'Not CQC' ELSE 'CQC' END #(lf),[SWAST_care_home_type] = m.[Broad Type (confirmed)] #(lf),[SWAST_care_home_type_rank] = RANK() OVER(PARTITION BY [Location Name]ORDER BY [Broad Type (confirmed)]  ASC) #(lf)#(lf)#(lf)#(lf)FROM [BIReports].[dbo].[CQC_Monthly_List] [Q]#(lf)#(lf)LEFT JOIN [BIReports].[dbo].[Care_Home_Mapping_May23] [M] ON [M].[CQC Name] = [Q].[Location Name]#(lf)#(lf)LEFT JOIN [BIReports].[dbo].[PCN_CQC_Monthly_List] [P] ON [P].[CQC_Care_Home_Name] = [Q].[Location Name]#(lf)#(lf)LEFT JOIN #max_date [MD] ON [MD].max_published_date = [Q].[Published_Date]#(lf)#(lf)WHERE [SWASFT Name] IS NULL #(lf)AND [Current_up_to_date_month] like 'Yes'#(lf)ORDER BY Assigned_name#(lf)#(lf)#(lf)SELECT * #(lf)FROM #Union_table#(lf)WHERE [SWAST_care_home_type_rank] = 1"])
				in
				    Source

	annotation PBI_ResultType = Table

