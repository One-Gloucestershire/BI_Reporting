table 'ePact Prescribing'
	lineageTag: 91cfa9a3-8a52-4a40-80ce-464b81c03fd4

	measure Cost_per_patient = sum('ePact Prescribing'[Cost (£)])/distinctcount('NDA Diabetic Population'[Derived_Pseudo_NHS_Number])
		lineageTag: d9a82fbb-a112-45d3-b4cf-55fb45dc7369

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Current_YTD_Cost = calculate(sum('ePact Prescribing'[Cost (£)]),datesytd(date_table[date],"31/3"))
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: 241596a6-f169-4d9b-9bc4-5a5e160b9419

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure Previous_YTD_Cost = calculate(sum('ePact Prescribing'[Cost (£)]),datesytd(sameperiodlastyear(date_table[date]),"31/3"))
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: 39499a54-fad1-4dee-87a4-77177243cd01

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure Previous_YTD = totalytd(sum('ePact Prescribing'[Cost (£)]),DATESYTD(dateadd(date_table[date],-1,year),"31/03"))
		lineageTag: f8046b9b-3dae-4ee1-b45a-c6040980bf72

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Cost_per_1000 = (DIVIDE('ePact Prescribing'[Current_YTD_Cost],'NDA Diabetic Population'[Diabetic Population])) * 1000
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: 39e90335-24cf-4549-a47d-59090f08b3de

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure Current_YTD_quantity = calculate(sum('ePact Prescribing'[Quantity]),datesytd(date_table[date],"31/3"))
		formatString: 0
		lineageTag: 2d5361a0-e7c2-46ab-b8e4-909631102975

	measure Quantity_per_1000 = (DIVIDE([Current_YTD_quantity],'NDA Diabetic Population'[Diabetic Population])) * 1000
		lineageTag: 78847d45-767d-48b4-bed5-a20b014b27a0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

