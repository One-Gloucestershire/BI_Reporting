		sourceColumn: refresh_date

		variation Variation
			isDefault
			relationship: 752a04c7-c66f-4a3b-8c72-3a95fc4a9447
			defaultHierarchy: LocalDateTable_0b16caea-d962-4f84-b0bb-325c1740f37e.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	partition 'NDA Diabetic Population' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "Data_Mart_National_Diabetes_Audit", [Query="/****** Script for SelectTopNRows command from SSMS  ******/#(lf)SELECT distinct [Derived_Pseudo_NHS_Number]#(lf)      ,[Age]#(lf)#(tab)  ,[DiabetesType] = case when [Derived_Clean_Diabetes_Type] not in ('1','2') then 'Other/Unknown' else [Derived_Clean_Diabetes_Type] end#(lf)#(tab)  ,[adult/paeds] = case when [age] < '16' then '<16'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when [age] >= '16' then '16+' else null end#(lf)#(tab)  ,[P].[PrimaryCareProvider]#(lf)#(tab)  ,[PracticeName] = case when [G].[Commissioner] <> '11M' then 'Out of County' else [G].[ReportingOrganisationName] end#(lf)#(tab)  ,[PCN] = case when [G].[Commissioner] <> '11M' then 'Out of County' else [G].[PrimaryCareNetwork] end#(lf)#(tab)  ,[refresh_date] = getdate()#(lf)  FROM [Data_Mart_National_Diabetes_Audit].[NDA].[core_NDA][D]#(lf)#(lf)  left join [CCG_Reference].[population].[vw_PDS_Current][P]#(lf)  on [D].[Derived_Pseudo_NHS_Number] = [P].[Derived_NHS_Number]#(lf)#(lf)  left join [CCG_Reference].[Reference].[vw_GPPractice][G]#(lf)  on [P].[PrimaryCareProvider] = [G].[OrganisationCode]#(lf)#(lf)  where Derived_Pseudo_NHS_Number is not null "])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

