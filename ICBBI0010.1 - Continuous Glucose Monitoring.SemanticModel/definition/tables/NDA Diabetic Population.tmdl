table 'NDA Diabetic Population'
	lineageTag: f7444764-3174-4cd6-bfb9-1827ee8c7400

	measure 'Diabetic Population' = DISTINCTCOUNT('NDA Diabetic Population'[Derived_Pseudo_NHS_Number])
