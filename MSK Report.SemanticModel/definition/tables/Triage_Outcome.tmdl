table Triage_Outcome
	lineageTag: eae9435c-500c-4b40-bd0a-756270023f4b

	measure 'Number of Months Triage' = DISTINCTCOUNT('Triage_Outcome'[Year_Month])
		lineageTag: a0e4e00d-da3e-4591-8757-9363dccadbb2

	measure 'Triage Mean' = CALCULATE (SUM('Triage_Outcome'[TriageCounter])/[Number of Months Triage],ALLSELECTED('Date Table'))
		lineageTag: 32f4958d-aebf-4359-a636-89e5e58f0625

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'New Total Triage' = SUM('Triage_Outcome'[TriageCounter])
		formatString: 0
		lineageTag: 45a4434c-405c-4b4c-ad4c-77cf03b63905

	measure 'Triage STD DEV' =
			
			
			VAR STD_DEV = CALCULATE(STDEVX.P (VALUES ('Triage_Outcome'[Year_Month]),[New Total Triage]),ALLEXCEPT('Date Table','Date Table'[year_month]))
			
			RETURN IFERROR(STD_DEV,0)
		lineageTag: 0cd38fb2-e4b5-4b39-b73a-f2fa625cbb8c

	measure 'Triage LCL' = IF(([Triage Mean]-(3*[Triage STD DEV])) < 0, 0, ([Triage Mean]-(3*[Triage STD DEV])))
		lineageTag: 70dac87b-f2ff-4a53-ad3f-02467022ac42

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Triage UCL' = IF(([Triage Mean]+(3*[Triage STD DEV])) < 0, 0, ([Triage Mean]+(3*[Triage STD DEV])))
		lineageTag: 815636ad-3ee5-425d-bb6c-a5a70cb2ba8a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

