table 'GP Table'
	lineageTag: de201955-3e02-4d40-b34a-2781dcf89bc9

	column locality
		dataType: string
		lineageTag: 1888b80c-bb62-48ee-99ef-13a39a0b49ab
		summarizeBy: none
		sourceColumn: locality

		annotation SummarizationSetBy = Automatic

	column 'primary care network'
		dataType: string
		lineageTag: 5811ee8c-d487-4449-9cec-b8281cbd4bfa
		summarizeBy: none
		sourceColumn: primary care network

		annotation SummarizationSetBy = Automatic

	column 'practice code'
		dataType: string
		lineageTag: e5e1782a-73f6-4a45-a53c-19093d311943
		summarizeBy: none
		sourceColumn: practice code

		annotation SummarizationSetBy = Automatic

	column 'organisation name'
		dataType: string
		lineageTag: 98b777db-b14b-40d5-b549-3cbf5ddb1f9e
		summarizeBy: none
		sourceColumn: organisation name

		annotation SummarizationSetBy = Automatic

	partition 'GP Table' = m
		mode: import
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "CCG_Reference", [Query="select #(lf) Locality as [locality],#(lf) PrimaryCareNetwork as [primary care network],#(lf) OrganisationCode as [practice code],#(lf) OrganisationName as [organisation name]#(lf)#(lf)#(lf) FROM CCG_Reference.Reference.vw_GPPractice#(lf) where StatusCode = 'A' and Commissioner = '11M' #(lf) and Locality in ('Cheltenham', 'Gloucester City', 'North Cotswolds', 'South Cotswolds', 'Stroud and Berkeley Vale', 'Tewkesbury Newent and Staunton', 'The Forest of Dean')#(lf)"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

