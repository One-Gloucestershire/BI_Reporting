table 'GHC Outpatients All'
	lineageTag: 9be819e8-72b7-4efb-a61e-38b996a9605c

	measure 'Number of Months GHC OP All' = DISTINCTCOUNT('GHC Outpatients All'[YearMonth])
		formatString: 0
		lineageTag: a5988059-2b56-4dec-9c79-2212bb95685e

	measure 'GHC OP All Mean' = CALCULATE (SUM('GHC Outpatients All'[Counter])/[Number of Months GHC OP All],ALLSELECTED('Date Table'))
		lineageTag: e31f3b9f-5026-49ae-b46d-bfdd7ddeb9ed

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'New Total GHC OP All' = SUM('GHC Outpatients All'[Counter])
		formatString: 0
		lineageTag: eb12bbcd-e881-47cc-9fb4-b5eaa2993986

	measure 'GHC OP All STD DEV' =
			
			
			VAR STD_DEV = CALCULATE(STDEVX.P (VALUES ('GHC Outpatients All'[YearMonth]),[New Total GHC OP All]),ALLEXCEPT('Date Table','Date Table'[year_month]))
			
			RETURN IFERROR(STD_DEV,0)
		lineageTag: f8cfaa59-c49a-4fb8-ae58-1265181bed41

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'GHC OP All LCL' = IF(([GHC OP All Mean]-(3*[GHC OP All STD DEV])) < 0, 0, ([GHC OP All Mean]-(3*[GHC OP All STD DEV])))
		lineageTag: 2b7be246-9c4c-4b6e-aef5-57f4ed93ce09

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'GHC OP All UCL' = IF(([GHC OP All Mean]+(3*[GHC OP All STD DEV])) < 0, 0, ([GHC OP All Mean]+(3*[GHC OP All STD DEV])))
		lineageTag: 6c8a3504-aaa3-4d13-a81f-e8b35046b732

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure First_appointments_GHC_OP_All = CALCULATE(COUNT('GHC Outpatients All'[Counter]),FILTER('GHC Outpatients All','GHC Outpatients All'[New or FollowUp App]="First Appointment"), FILTER('GHC Outpatients All','GHC Outpatients All'[Attend_Or_Not_Group]="Attended"))
		formatString: 0
		lineageTag: f5351d10-3d6d-4b35-912a-90a352087dc1

	measure Follow_Up_appointments_GHC_OP_All = CALCULATE(COUNT('GHC Outpatients All'[Counter]),FILTER('GHC Outpatients All','GHC Outpatients All'[New or FollowUp App]="FollowUp Appointment"), FILTER('GHC Outpatients All','GHC Outpatients All'[Attend_Or_Not_Group]="Attended"))
		formatString: 0
		lineageTag: 136cd0fe-a28e-4159-9681-6d97a4c7e8e7

	measure First_to_follow_up_Appointments_ratio = [Follow_Up_appointments_GHC_OP_All]/[First_appointments_GHC_OP_All]
		lineageTag: 8ed66439-915a-4cdf-87c6-aa90cae3feec

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Seen_Within_2_Weeks_Count = CALCULATE(SUM('GHC Outpatients All'[Counter])-SUM('GHC Outpatients All'[2_Week_Breach_Flag]))
		formatString: 0
		lineageTag: 4169caa0-0207-4dbd-9d9a-b9e8622340c9

	measure Seen_Within_8_Weeks_Count = CALCULATE(SUM('GHC Outpatients All'[Counter])-SUM('GHC Outpatients All'[8_Week_Breach_Flag]))
		formatString: 0
		lineageTag: f586c4fd-0133-4584-b45b-227d53c20137

