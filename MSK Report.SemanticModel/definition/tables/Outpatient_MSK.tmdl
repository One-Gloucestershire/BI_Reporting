table Outpatient_MSK
	lineageTag: b4a694f4-6a8b-4a28-a1ac-eb45de6acf20

	measure first_attendances_MSK = CALCULATE(COUNT('Outpatient_MSK'[Counter]),FILTER('Outpatient_MSK','Outpatient_MSK'[First or Follow Up]="First"),FILTER('Outpatient_MSK','Outpatient_MSK'[Attendance Group]="Attended"),NOT 'Date Table'[year_month] IN {"202004","202005","202006"})
		formatString: 0
		lineageTag: cc715ece-db20-436e-b0d3-c84a67637652

	measure first_to_follow_up_ratio_MSK = [follow_up_attendances_MSK]/[first_attendances_MSK]
		formatString: 0.00
		lineageTag: 72fc7d91-603b-4068-a0eb-af6905f28ea0

	measure follow_up_attendances_MSK = ```
			
			 
			CALCULATE( COUNT ( 'Outpatient_MSK' [Counter] ),
			    CONTAINSSTRING('Outpatient_MSK'[First or Follow Up], "Follow Up" ),
			       'Outpatient_MSK'[Attendance Group] = "Attended", NOT 'Date Table'[year_month] IN {"202004","202005", "202006"})
			```
		formatString: 0
		lineageTag: c0620638-9d59-43a0-ab77-f53a09471a66

	measure 'Number of Months MSK' = DISTINCTCOUNT('Outpatient_MSK'[YearMonth])
		lineageTag: 2739a022-6a5e-4cf0-a5e0-30b6b8f238be

	measure 'OP MSK Mean' = CALCULATE (SUM('Outpatient_MSK'[Counter])/[Number of Months MSK],ALLSELECTED('Date Table'))
		lineageTag: 7749eac6-9ab6-4f2c-86f4-9595d27e5b3a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'New Total OP MSK' = SUM('Outpatient_MSK'[Counter])
		formatString: 0
		lineageTag: 07402e4d-cd13-4003-9d14-6ac9d0f29325

	measure 'OP MSK STD DEV' =
			
			
			VAR STD_DEV = CALCULATE(STDEVX.P (VALUES ('Outpatient_MSK'[YearMonth]),[New Total OP MSK]),ALLEXCEPT('Date Table','Date Table'[year_month]))
			
			RETURN IFERROR(STD_DEV,0)
		lineageTag: f8259a58-0376-4787-a0c7-eeafec6c0e4e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'OP MSK LCL' = IF(([OP MSK Mean]-(3*[OP MSK STD DEV])) < 0, 0, ([OP MSK Mean]-(3*[OP MSK STD DEV])))
		lineageTag: d3d0a498-b5fc-42fe-8f31-a30ea99477c1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'OP MSK UCL' = IF(([OP MSK Mean]+(3*[OP MSK STD DEV])) < 0, 0, ([OP MSK Mean]+(3*[OP MSK STD DEV])))
		lineageTag: fe259bc8-d046-4b31-9493-b7358db94402

		annotation PBI_FormatHint = {"isGeneralNumber":true}

