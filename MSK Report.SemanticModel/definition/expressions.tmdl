		  #"Reordered Columns" = Table.ReorderColumns(#"Kept Errors", {"Row Number", "Financial_Year", "Month", "Year_Month", "Service", "Local_Treatment_Function_Code", "Priority_Type", "Counter"})
		in
		  #"Reordered Columns"
