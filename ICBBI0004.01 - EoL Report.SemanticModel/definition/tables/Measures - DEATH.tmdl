	measure 'Small Number Suppression' = IF(COUNT(EOL_Query[pseudo_nhs_number])<6,0,COUNT(EOL_Query[pseudo_nhs_number]))
		formatString: 0
		lineageTag: 22a53f26-13b3-4110-99f5-aab9fd618985

	measure 'YTDSumOfPatients DeathDate' = TOTALYTD([Small Number Suppression],Death_Date[date],ALL(Death_Date[date]),"31/03")
		formatString: 0
		lineageTag: bc8e60f7-4268-4a70-a660-b538ec6e1b68

	measure 'Community Deaths Small Number Suppression' =
			
			VAR COMMUNITYDEATHS = CALCULATE(COUNT(EOL_Query[place_of_death]),EOL_Query[place_of_death] IN {"Care Home","Home","Hospice","Other Places","Unknown"})
			VAR COUNTOF =
			IF ( COMMUNITYDEATHS <6, 0, COMMUNITYDEATHS )
			
			RETURN
			COUNTOF
		formatString: 0
		lineageTag: ee490bf8-7c95-46b1-ae72-e4eb97004c02

	measure 'Rolling Average for Palliative Care' = ```
			
			VAR NUMMONTHS = 3
			VAR ROLLINGSUM = 
			    CALCULATE(
			        COUNT(EOL_Query[pseudo_nhs_number]),
			DATESINPERIOD(Palliative_Date[date], LASTDATE(Palliative_Date[date]), -NUMMONTHS,MONTH)
			    )
			RETURN
			IF(ROLLINGSUM/NUMMONTHS <6, 0, ROLLINGSUM/NUMMONTHS)
			```
		lineageTag: 9c367f3c-cae3-4ece-ab2d-62e26728b30e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Latest Month' = ```
			
			
			VAR MaxDate = MAX ( Death_Date[Date] )
			VAR SOMMaxDate = DATE ( YEAR ( MaxDate ) , MONTH ( MaxDate ) ,1 )
			VAR EOMMaxDate = EOMONTH( MaxDate , 0 )
			VAR Result =
			CALCULATE( SUM('EOL_Query'[counter]) ,  
			    FILTER (
			        ALL ( 'Death_Date'[Date] ),
			        'Death_Date'[Date] >= SOMMaxDate && 'Death_Date'[Date] <= EOMMaxDate) )
			
			RETURN
			    IF(Result <6, "<6", Result)
			```
		lineageTag: 21cbe071-1c81-43b9-a37b-ecfd3f495427

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Latest Month for Card' =
			
			
			MAX ( 'Death_Date'[month_year_name] )
		lineageTag: 5fb515d2-f583-4b7a-8d6c-775ae73b3929

	measure 'LAST 12 MONTHS - Deaths' =
			
			VAR EndDate =
			    MAX ( 'Death_Date'[date] ) -- Retrieves MAX Date
			VAR StartDate =
			    EDATE ( EndDate, -12 )
			VAR Result =
			    CALCULATE(
			        [Small Number Suppression],
			        DATESBETWEEN(
			            'Death_Date'[date],
			            StartDate,
			            EndDate
			        )
			    )
			VAR AverageResult = ((Result)/12)
			RETURN
			 IF(AverageResult <6, "<6", AverageResult)
		lineageTag: 043d1a70-93e6-4d90-af4c-afa3227e5f24

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'LAST 12 MONTHS (Previous Year) - Deaths' =
			
			VAR EndDateEdit =
			    MAX ( 'Death_Date'[date] ) -- Retrieves MAX Date
			VAR EndDate = EDATE (EndDateEdit, -12)
			VAR StartDate =
			    EDATE ( EndDate, -12 )
			VAR Result =
			    CALCULATE(
			        [Small Number Suppression],
			        DATESBETWEEN(
			            'Death_Date'[date],
			            StartDate,
			            EndDate
			        )
			    )
			VAR AverageResult = ((Result)/12)
			RETURN
			 IF(AverageResult <6, "<6", AverageResult)
		lineageTag: c9f9f5e7-2d10-46a7-9f96-ea0579afe12f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Deaths % Change' =
			
			
			([LAST 12 MONTHS - Deaths]-[LAST 12 MONTHS (Previous Year) - Deaths])/[LAST 12 MONTHS (Previous Year) - Deaths]
