table 'Measures - DEATH'
	lineageTag: b5e0632d-f0d8-4d64-8535-44aaf3db3925

	measure '% of Community Deaths' = [Community Deaths]/[All Places of Death]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 5f4feaf9-cc80-48b8-8125-ce31452b37a8

		annotation PBI_ChangedProperties = ["FormatString"]

	measure '% of Hospital Deaths' = [Hospital Deaths]/[All Places of Death]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 44228496-ac97-48ea-bdce-697647b0ea99

		annotation PBI_ChangedProperties = ["FormatString"]

	measure '12 Months Rolling Average' = ```
			
			VAR STARTDATE = DATE (2022, 01, 01)
			VAR ENDDATE = DATE ( 2022, 12, 31)
			VAR NUMMONTHS = 12
			VAR COMMUNITYDEATHS =
			    CALCULATE(COUNT(EOL_Query[place_of_death]),EOL_Query[place_of_death] IN {"Care Home","Home","Hospice","Other Places","Unknown"})
			VAR YEARTOTAL = 
			    CALCULATE(
			        COMMUNITYDEATHS,
			DATESBETWEEN(Death_Date[date].[Date], STARTDATE, ENDDATE))
			RETURN
			YEARTOTAL/NUMMONTHS
			```
		lineageTag: 774f3593-8d1a-4b7f-8cde-342de16f2300

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'All Places of Death' = CALCULATE(COUNT(EOL_Query[place_of_death]),EOL_Query[place_of_death] IN {"Care Home","Home","Hospice","Hospital","Other Places","Unknown"})
		formatString: 0
		lineageTag: e35a771d-93da-4b9f-bb7f-de5e428f4399

	measure 'Average of % of Community Deaths' =
			
			CALCULATE (
			    AVERAGEX ( VALUES ('Death_Date'[year_month]), [% of Community Deaths] ),
			    DATESINPERIOD( Death_Date[date], MAX (Death_Date[date] ), -3, MONTH)
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 5d39ad36-017c-4053-a5cd-eb1d0bebca55

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "AveragePerCategory"
				}

		annotation PBI_ChangedProperties = ["FormatString"]

	measure 'Community Deaths' = CALCULATE(COUNT(EOL_Query[place_of_death]),EOL_Query[place_of_death] IN {"Care Home","Home","Hospice","Other Places","Unknown"})
		formatString: 0
		lineageTag: 78727eb6-2d5b-4314-b4a8-34bfac7cc698

	measure 'Hospital Deaths' = CALCULATE ( COUNTROWS (EOL_Query), EOL_Query [place_of_death] = "Hospital")
		formatString: 0
		lineageTag: f1edadf1-d2d7-4151-940c-5a84407a0bd4

	measure 'Moving Average Number of Deaths' = CALCULATE(AVERAGEX('EOL_Query', 'EOL_Query'[death_flag]),DATESINPERIOD('EOL_Query'[death_date],LASTDATE('EOL_Query'[death_date]),-3,MONTH))
		formatString: 0
		lineageTag: b9791234-0c61-4981-b6a9-efa2ea7d98e8

	measure 'PCN Visual Invisible Filter' = CALCULATE(IF(ISFILTERED(EOL_Query[pcn]),1,0),ALLSELECTED(EOL_Query))
		formatString: 0
		lineageTag: 5e7bf3df-a3a9-442d-b369-ce274c15362c

	measure 'Practice Visual Invisible Filter' = CALCULATE(IF(ISFILTERED(EOL_Query[practice]),1,0),ALLSELECTED(EOL_Query))
		formatString: 0
		lineageTag: 261fbc38-abed-4f56-8744-feeed7c9f4fb

	measure 'Rolling Average for Deaths' = ```
			
			VAR NUMMONTHS = 3
			VAR ROLLINGSUM = 
			    CALCULATE(
			        COUNT(EOL_Query[pseudo_nhs_number]),
			DATESINPERIOD(Death_Date[date], LASTDATE(Death_Date[date]), -NUMMONTHS,MONTH)
			    )
			RETURN
			IF(ROLLINGSUM/NUMMONTHS <6, 0, ROLLINGSUM/NUMMONTHS)
			```
		lineageTag: 64ed321f-f4f8-41fb-b69f-4d1db95234cc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Rolling Average for Community Deaths' =
			
			CALCULATE(
				[Rolling Average for Deaths],
				'EOL_Query'[place_of_death]
					IN { "Care Home", "Home", "Hospice", "Other Places", "Unknown" }
			)
		lineageTag: 910c0ed1-2119-47fa-8699-113458d2c6ef

		extendedProperty MeasureTemplate =
