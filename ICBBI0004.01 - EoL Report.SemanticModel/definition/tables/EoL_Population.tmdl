table EoL_Population
	lineageTag: bdad417d-aa29-4b9c-ac5f-f2833e7e668f

	measure 'Small Number Suppression - EoL Population' = IF(SUM('EoL_Population'[eol_population])<6,0,SUM('EoL_Population'[eol_population]))
		formatString: 0
		lineageTag: 6d1fb284-59f2-4833-96f7-72279f1855f8

	measure 'Small Number Suppression - ReSPECT Population' = IF(SUM('EoL_Population'[palliative_respect_population])<6,0,SUM('EoL_Population'[palliative_respect_population]))
		formatString: 0
		lineageTag: 75ba5e27-7000-410f-9272-1a3893c84929

	measure '% ReSPECT' = CALCULATE ( [Small Number Suppression - ReSPECT Population] / [Small Number Suppression - EoL Population] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 1799b8bc-7dcc-4169-ae7d-fa9bf70452f6

		annotation PBI_ChangedProperties = ["FormatString"]

	measure '% No ReSPECT' = CALCULATE (1 - ( [Small Number Suppression - ReSPECT Population] / [Small Number Suppression - EoL Population] ))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: cd416d2b-50ca-4254-9e97-60043d33140c

		annotation PBI_ChangedProperties = ["FormatString"]

	measure 'Latest % ReSPECT' =
			
			
			CALCULATETABLE (
			    { 'EoL_Population'[% ReSPECT] } ,
			    'EoL_Population'[start_date] = MAX( 'EoL_Population'[start_date] ))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d1918202-0269-4b46-ba15-ce0896e9d66e

		annotation PBI_ChangedProperties = ["FormatString"]

	measure 'Latest Palliative Care Population' = ```
			
			
			CALCULATETABLE (
			    { 'EoL_Population'[Small Number Suppression - EoL Population] } , 
			    'EoL_Population'[start_date] = MAX ( 'EoL_Population'[start_date] ))
			```
		formatString: 0
		lineageTag: 49f25988-59a9-4a7b-a638-6149832cdea3

	measure 'Small Number Suppression - ReSPECT 65+ Population' = IF(SUM('EoL_Population'[respect_65+_population])<6,0,SUM('EoL_Population'[respect_65+_population]))
		formatString: 0
		lineageTag: 88b7d682-37c5-4482-9a09-09c6f248015e

	measure 'Small Number Suppression - PC&SP Population' = IF(SUM('EoL_Population'[palliative_pc&sp_population])<6,0,SUM('EoL_Population'[palliative_pc&sp_population]))
		formatString: 0
		lineageTag: ab731a74-6792-4f6a-b254-d89636a85e30

	measure 'LAST 12 MONTHS - EoL Population' =
			
			VAR EndDate =
			    MAX ( 'EoL_Population'[start_date] ) -- Retrieves MAX Date
			VAR StartDate =
			    EDATE ( EndDate, -11 )
			VAR Result =
			    CALCULATE(
			        [Small Number Suppression - EoL Population],
			        DATESBETWEEN(
			            'EoL_Population'[start_date],
			            StartDate,
			            EndDate
			        )
			    )
			VAR AverageResult = ((Result)/12)
			RETURN
			 IF(AverageResult <6, "<6", AverageResult)
		lineageTag: 90c0f0ef-7ccf-42ee-bc76-5b9a0e271501

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'LAST 12 MONTHS (Previous Year) - EoL Population' =
			
			VAR EndDateEdit =
			    MAX ( 'EoL_Population'[start_date] ) -- Retrieves MAX Date
			VAR EndDate = EDATE (EndDateEdit, -11)
			VAR StartDate =
			    EDATE ( EndDate, -11 )
			VAR Result =
			    CALCULATE(
			        [Small Number Suppression - EoL Population],
			        DATESBETWEEN(
			            'EoL_Population'[start_date],
			            StartDate,
			            EndDate
			        )
			    )
			VAR AverageResult = ((Result)/12)
			RETURN
			 IF(AverageResult <6, "<6", AverageResult)
		lineageTag: 7355c041-efc5-47d0-9e8e-d135d4b6e86a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Palliative Register % Change' =
			
			
			([LAST 12 MONTHS - EoL Population]-[LAST 12 MONTHS (Previous Year) - EoL Population])/[LAST 12 MONTHS (Previous Year) - EoL Population]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 2f362636-8666-443d-af68-ebfb065a8327

		annotation PBI_ChangedProperties = ["FormatString"]

	measure '% PC&SP' = CALCULATE ( 'EoL_Population'[Small Number Suppression - PC&SP Population] / 'EoL_Population'[Small Number Suppression - EoL Population] )
