table 'ED Attendances & Hospital Admissions'
	lineageTag: bdbe5064-7b06-4cb3-a4db-e805abc83ab5

	measure 'Rolling Average ED Attendances / Hospital Admissions' = ```
			
			VAR NUMMONTHS = 3
			VAR ROLLINGSUM = 
			    CALCULATE(
			        COUNT('ED Attendances & Hospital Admissions'[pseudo_nhs_number]),
			DATESINPERIOD('ED Attendances & Hospital Admissions'[attendance_date], LASTDATE('ED Attendances & Hospital Admissions'[attendance_date]), -NUMMONTHS,MONTH)
			    )
			RETURN
			IF(ROLLINGSUM/NUMMONTHS <6, 0, ROLLINGSUM/NUMMONTHS)
			```
		lineageTag: 16a7217d-b6f6-4ed2-9de9-e2a3f75fab0d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

