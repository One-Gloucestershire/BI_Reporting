	partition Gloucester_Census_Population-ef8e52ce-e3ee-4d33-a143-da4bd3ce24ed = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "PowerBI_Reporting", [Query="SELECT *#(lf)FROM [PowerBI_Reporting].[dbo].[GP_Practice_Populations]#(lf)WHERE [last_date_of_month] BETWEEN '20160401' AND EOMONTH(DATEADD(MONTH, -1, GETDATE()))  -- Means data always stops at end of the previous month at the latest"])
				in
				    Source

	annotation PBI_ResultType = Table

