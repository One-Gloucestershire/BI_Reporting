table Gloucester_Census_Population
	lineageTag: c80cc168-30a0-43d6-a6c8-d330091e0bc7

	measure 'Latest Census Month' = ```
			
			
			VAR MaxDate = MAX ( 'Gloucester_Census_Population'[last_date_of_month] )
			VAR SOMMaxDate = DATE ( YEAR ( MaxDate ) , MONTH ( MaxDate ) ,1 )
			VAR EOMMaxDate = EOMONTH( MaxDate , 0 )
			VAR Result =
			CALCULATE( SUM('Gloucester_Census_Population'[population]) ,  
			    FILTER (
			        ALL ( 'Gloucester_Census_Population'[last_date_of_month] ),
			        'Gloucester_Census_Population'[last_date_of_month] >= SOMMaxDate && 'Gloucester_Census_Population'[last_date_of_month] <= EOMMaxDate) )
			
			RETURN
			    IF(Result <6, "<6", Result)
			```
		lineageTag: a3f6da54-757b-493a-97df-541d194501fe

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Small Number Suppression - Gloucestershire Population' = IF(SUM('Gloucester_Census_Population'[population])<6,0,SUM('Gloucester_Census_Population'[population]))
		lineageTag: dc28469a-2b4c-4910-8fab-8b7a52ced2b4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Palliative Register of Whole Population' =
			
			
			CALCULATE ( [Small Number Suppression - EoL Population] / [Small Number Suppression - Gloucestershire Population] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8189786b-f696-4292-8c3e-4e7d8b2760fa

		annotation PBI_ChangedProperties = ["FormatString"]

	measure 'Latest % Palliative Care Population' = ```
			
			
			CALCULATETABLE (
			    { 'Gloucester_Census_Population'[% Palliative Register of Whole Population] } , 
			    'EoL_Population'[start_date] = MAX ( 'EoL_Population'[start_date] ))
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ba101cd0-b0e8-4284-81f1-6dda22ae9aac

		annotation PBI_ChangedProperties = ["FormatString"]

	measure 'Gloucester Population 65+ Small Number Suppression' =
			
			VAR GLOSPOPULATION = CALCULATE(SUM('Gloucester_Census_Population'[population]),'Gloucester_Census_Population'[age_band] IN {"65-69","70-74","75-79","80-84","85-89","90-94","95+"})
			VAR COUNTOF =
			IF ( GLOSPOPULATION <6, 0, GLOSPOPULATION )
			
			RETURN
			COUNTOF
		lineageTag: 8490b580-e824-48e6-b81f-5db966df3cdf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Latest % Palliative Care Population 65+' = ```
			
			
			CALCULATETABLE (
			    { 'Gloucester_Census_Population'[% Palliative Register of Whole Population 65+] } , 
			    'EoL_Population'[start_date] = MAX ( 'EoL_Population'[start_date] ))
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 23ad984d-7b9d-4fce-9731-f90bf6a05ea5

		annotation PBI_ChangedProperties = ["FormatString"]

	measure '% Palliative Register of Whole Population 65+' =
			
			
			CALCULATE ( [Small Number Suppression - EoL Population] / [Gloucester Population 65+ Small Number Suppression] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 160757d2-9ddf-4175-89e0-27edce8838f1

		annotation PBI_ChangedProperties = ["FormatString"]

	measure '% ReSPECT for 65%' = ( 7498 / 146339 )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 3de6f2dc-12bb-4517-a03e-5832f5b4801f

		annotation PBI_ChangedProperties = ["FormatString"]

	measure 'Latest % ReSPECT for 65+' =
			
			
			CALCULATETABLE (
			    { 'Gloucester_Census_Population'[% ReSPECT for 65%] } ,
			    'EoL_Population'[start_date] = MAX( 'EoL_Population'[start_date] ))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c0ce0192-f4e4-405a-8545-e1cfb8a49f96

		annotation PBI_ChangedProperties = ["FormatString"]

	measure 'Latest % Died in Place of Preference' = ```
			
			
			CALCULATETABLE (
			    { 'Measures - DEATH'[% Died in preferred place] } , 
			    'Death_Date'[year_month] = MAX ( 'Death_Date'[year_month] ))
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 9042de8c-2589-4e9b-a67a-085ee85dbd00

		annotation PBI_ChangedProperties = ["FormatString"]

