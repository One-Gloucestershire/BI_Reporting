table 'KPI Script v2'
	lineageTag: 463438e2-c23e-41ee-84a3-47be9c06ee47

	measure 'Arrow Colours' =
			
			VAR Latest_Value_High = CALCULATE(SUM('KPI Script v2'[Value]),'KPI Script v2'[Order Time] = 1,'KPI Script v2'[Good Is]="High")
			VAR Previous_Value_High = CALCULATE(SUM('KPI Script v2'[Value]),'KPI Script v2'[Order Time] = 2,'KPI Script v2'[Good Is]="High")
			VAR Latest_Value_Low = CALCULATE(SUM('KPI Script v2'[Value]),'KPI Script v2'[Order Time] = 1,'KPI Script v2'[Good Is]="Low")
			VAR Previous_Value_Low = CALCULATE(SUM('KPI Script v2'[Value]),'KPI Script v2'[Order Time] = 2,'KPI Script v2'[Good Is]="Low")
			
			RETURN
			
			IF(Latest_Value_High>Previous_Value_High,"#78BE20",
			IF(Latest_Value_High<Previous_Value_High,"#AE2424",
			IF(Latest_Value_Low>Previous_Value_Low,"#AE2424",
			IF(Latest_Value_Low<Previous_Value_Low,"#78BE20"))))
		lineageTag: 7111edcf-cbb0-4b69-851c-f38940e35be8

	measure Arrows =
			
			VAR Latest_Value_High = CALCULATE(SUM('KPI Script v2'[Value]),'KPI Script v2'[Order Time] = 1,'KPI Script v2'[Good Is]="High")
			VAR Previous_Value_High = CALCULATE(SUM('KPI Script v2'[Value]),'KPI Script v2'[Order Time] = 2,'KPI Script v2'[Good Is]="High")
			VAR Latest_Value_Low = CALCULATE(SUM('KPI Script v2'[Value]),'KPI Script v2'[Order Time] = 1,'KPI Script v2'[Good Is]="Low")
			VAR Previous_Value_Low = CALCULATE(SUM('KPI Script v2'[Value]),'KPI Script v2'[Order Time] = 2,'KPI Script v2'[Good Is]="Low")
			
			RETURN
			
			IF(Latest_Value_High>Previous_Value_High,UNICHAR(UNICODE("↑")),
			IF(Latest_Value_High<Previous_Value_High,UNICHAR(UNICODE("↓")),
			IF(Latest_Value_Low>Previous_Value_Low,UNICHAR(UNICODE("↑")),
			IF(Latest_Value_Low<Previous_Value_Low,UNICHAR(UNICODE("↓")),""))))
		lineageTag: 300bae45-403f-4e70-97c0-68ca7ad8c442

	measure 'Dial Colours' =
			
			VAR Target_Value_High = CALCULATE(SUM('KPI Script v2'[Target]),'KPI Script v2'[Order Time] = 1,'KPI Script v2'[Good Is]="High")
			VAR Current_Value_High = CALCULATE(SUM('KPI Script v2'[Value]),'KPI Script v2'[Order Time] = 1,'KPI Script v2'[Good Is]="High")
			VAR Target_Value_Low = CALCULATE(SUM('KPI Script v2'[Target]),'KPI Script v2'[Order Time] = 1,'KPI Script v2'[Good Is]="Low")
			VAR Current_Value_Low = CALCULATE(SUM('KPI Script v2'[Value]),'KPI Script v2'[Order Time] = 1,'KPI Script v2'[Good Is]="Low")
			
			RETURN
			
			IF(Current_Value_High>Target_Value_High,"#78BE20",
			IF(Current_Value_High<Target_Value_High,"#AE2424",
			IF(Current_Value_Low>Target_Value_Low,"#AE2424",
			IF(Current_Value_Low<Target_Value_Low,"#78BE20"))))
		lineageTag: ae12fb15-d9c5-4454-9897-d4698f5a189c

	measure 'Dial Colours Target Pop' =
			
			VAR Target_Value_High = CALCULATE(SUM('KPI Script v2'[Target Patients]),'KPI Script v2'[Order Time] = 1,'KPI Script v2'[Good Is]="High")
			VAR Current_Value_High = CALCULATE(SUM('KPI Script v2'[Numerator]),'KPI Script v2'[Order Time] = 1,'KPI Script v2'[Good Is]="High")
			VAR Target_Value_Low = CALCULATE(SUM('KPI Script v2'[Target Patients]),'KPI Script v2'[Order Time] = 1,'KPI Script v2'[Good Is]="Low")
			VAR Current_Value_Low = CALCULATE(SUM('KPI Script v2'[Numerator]),'KPI Script v2'[Order Time] = 1,'KPI Script v2'[Good Is]="Low")
			
			RETURN
			
			IF(Current_Value_High>Target_Value_High,"#78BE20",
			IF(Current_Value_High<Target_Value_High,"#AE2573",
			IF(Current_Value_Low>Target_Value_Low,"#AE2573",
			IF(Current_Value_Low<Target_Value_Low,"#78BE20"))))
		lineageTag: b0904488-7edf-44fb-831a-f7af8eb75993

	measure Target_Symbol =
			
			VAR Latest_Value_High = CALCULATE(SUM('KPI Script v2'[Value]),'KPI Script v2'[Order Time] = 1,'KPI Script v2'[Good Is]="High")
			VAR Latest_Value_Low = CALCULATE(SUM('KPI Script v2'[Value]),'KPI Script v2'[Order Time] = 1,'KPI Script v2'[Good Is]="Low")
			VAR Target_Value_High = CALCULATE(SUM('KPI Script v2'[Target]),'KPI Script v2'[Order Time] = 1,'KPI Script v2'[Good Is]="High")
			VAR Target_Value_Low = CALCULATE(SUM('KPI Script v2'[Target]),'KPI Script v2'[Order Time] = 1,'KPI Script v2'[Good Is]="Low")
			
			RETURN
			IF(Latest_Value_High>Target_Value_High,UNICHAR(UNICODE("✔")),
			IF(Latest_Value_High<Target_Value_High,UNICHAR(UNICODE("⨯")),
			IF(Latest_Value_Low>Target_Value_Low,UNICHAR(UNICODE("⨯")),
			IF(Latest_Value_Low<Target_Value_Low,UNICHAR(UNICODE("✔")),""))))
		lineageTag: 6a1f0623-5341-412e-b4c4-138d20f470c0

	measure 'Target Colours Prog' =
			
			VAR Latest_Value_High = CALCULATE(SUM('KPI Script v2'[Value]),'KPI Script v2'[Order Time] = 1,'KPI Script v2'[Good Is]="High")
			VAR Target_Value_High = CALCULATE(SUM('KPI Script v2'[Target]),'KPI Script v2'[Order Time] = 1,'KPI Script v2'[Good Is]="High")
			VAR Latest_Value_Low = CALCULATE(SUM('KPI Script v2'[Value]),'KPI Script v2'[Order Time] = 1,'KPI Script v2'[Good Is]="Low")
			VAR Target_Value_Low = CALCULATE(SUM('KPI Script v2'[Target]),'KPI Script v2'[Order Time] = 1,'KPI Script v2'[Good Is]="Low")
			
			RETURN
			
			IF(Latest_Value_High>Target_Value_High,"#78BE20",
			IF(Latest_Value_High<Target_Value_High,"#AE2424",
			IF(Latest_Value_Low>Target_Value_Low,"#AE2424",
			IF(Latest_Value_Low<Target_Value_Low,"#78BE20"))))
		lineageTag: 7d1240b8-5107-449b-a928-0663ff247b74

