	partition '5. Weekly Admissions' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "Data_Mart_Unified_Extract", [Query="SELECT [spell_patient_identity_nhs_number_value]#(lf)      ,[spell_admission_date]#(lf)      ,[spell_discharge_date]#(lf)      ,[spell_admission_admission_type]#(lf)      ,[spell_admission_admission_sub_type]#(lf)      ,[spell_discharge_ready_date]#(lf)      ,[spell_discharge_length_of_hospital_stay]#(lf)      ,[spell_discharge_pbr_delayed_discharge_days]#(lf)      #(lf)#(tab)  ,case when [spell_admission_date] BETWEEN DATEADD(dd,  0, DATEADD(ww, DATEDIFF(ww, 0, DATEADD(dd, -1, CURRENT_TIMESTAMP)) - 1, 0))#(lf)                 AND DATEADD(dd,  6, DATEADD(ww, DATEDIFF(ww, 0, DATEADD(dd, -1, CURRENT_TIMESTAMP)) - 1, 0)) then 'Latest Week'#(lf)#(tab)#(tab)    when [spell_admission_date] BETWEEN DATEADD(dd,  0, DATEADD(ww, DATEDIFF(ww, 0, DATEADD(dd, -1, CURRENT_TIMESTAMP)) - 2, 0))#(lf)                 AND DATEADD(dd,  6, DATEADD(ww, DATEDIFF(ww, 0, DATEADD(dd, -1, CURRENT_TIMESTAMP)) - 2, 0)) then 'Previous Week'#(lf)#(tab)#(tab)#(tab)#(tab) end as [Week] #(lf)#(tab) ,[spell_patient_identity_local_patient_identifier_issuer]#(lf)  FROM [Data_Mart_Unified_Extract].[dbo].[APC]#(lf)#(lf)  where #(lf)   --[spell_patient_identity_local_patient_identifier_issuer] like '%RTE%'#(lf)  [spell_commissioning_service_agreement_provider] like '%RTE%'#(lf)  AND [spell_admission_date] BETWEEN DATEADD(dd,  0, DATEADD(ww, DATEDIFF(ww, 0, DATEADD(dd, -1, CURRENT_TIMESTAMP)) - 2, 0))#(lf)  AND DATEADD(dd,  6, DATEADD(ww, DATEDIFF(ww, 0, DATEADD(dd, -1, CURRENT_TIMESTAMP)) - 1, 0))#(lf)  and spell_admission_admission_sub_type like 'EMR'#(lf)#(lf)  order by [spell_admission_date], [spell_admission_time]"])
				in
				    Source

	changedProperty = Name

	annotation PBI_ResultType = Table

