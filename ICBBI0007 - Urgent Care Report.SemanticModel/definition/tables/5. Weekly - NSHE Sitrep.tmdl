	measure Type3_Colour = if(sum('5. Weekly - NSHE Sitrep'[Number of A&E Attendances - Type 3])<sum('5. Weekly - NSHE Sitrep'[Type 3 A&E Attendances (Plan) (GHC)]),"#00cc00","#cc0000")
		displayFolder: Page 3
		lineageTag: 9a7aacde-b611-4844-8f92-07292d770f19

	measure Arrow_Type1 =
			
			VAR Latest_Value_High = CALCULATE(SUM('5. Weekly - NSHE Sitrep'[Number of A&E Attendances - Type 1]),'Date Table'[last_week] = 1)
			VAR Previous_Value_High = CALCULATE(SUM('5. Weekly - NSHE Sitrep'[Number of A&E Attendances - Type 1]),'Date Table'[last_week_minus_7] = 1)
			
			RETURN
			
			IF(Latest_Value_High>Previous_Value_High,UNICHAR(UNICODE("↑")),
			IF(Latest_Value_High<Previous_Value_High,UNICHAR(UNICODE("↓"))))
		lineageTag: 405e7ea0-f6ee-4a4a-90d8-b673d1e84193

	measure ArrowColour_Type1 =
			
			VAR Latest_Value_High = CALCULATE(SUM('5. Weekly - NSHE Sitrep'[Number of A&E Attendances - Type 1]),'Date Table'[last_week] = 1)
			VAR Previous_Value_High = CALCULATE(SUM('5. Weekly - NSHE Sitrep'[Number of A&E Attendances - Type 1]),'Date Table'[last_week_minus_7] = 1)
			RETURN
			
			IF(Latest_Value_High>Previous_Value_High,"#AE2424",
			IF(Latest_Value_High<Previous_Value_High,"#78BE20"))
		lineageTag: ec00f4d9-3a48-432c-9d55-a870ee9f3a58

