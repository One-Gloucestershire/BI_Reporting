	measure Type1_Colour = if(sum('5. Weekly - NSHE Sitrep'[Number of A&E Attendances - Type 1])<sum('5. Weekly - NSHE Sitrep'[Type 1 A&E Attendances (Plan) (GHFT)]),"#00cc00","#cc0000")
		displayFolder: Page 3
