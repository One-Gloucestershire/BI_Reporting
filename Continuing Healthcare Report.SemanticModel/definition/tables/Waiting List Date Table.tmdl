	column '2 year date filter' =
			
			
			VAR _2_year_date = EOMONTH(TODAY(), -25) +1
			
			RETURN IF('Waiting List Date Table'[Date] >= _2_year_date, 1, 0)
		formatString: 0
		lineageTag: b52275e9-c6e0-4156-93e5-164884e49a73
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'FY - Qr' =
			
			RIGHT (
			    CONVERT (
			        (
			            YEAR (
			                EDATE (
			                    'Waiting List Date Table'[Date],
			                    9
			                )
			            ) - 1
			        ),
			        STRING
			    ),
			    2
			) & "-"
			    & RIGHT (
			        CONVERT (
			            YEAR (
			                EDATE (
			                    'Waiting List Date Table'[Date],
			                    9
			                )
			            ),
			            STRING
			        ),
			        2
			    ) & " Q"
			    & QUARTER (
			        EDATE (
			                    'Waiting List Date Table'[Date],
			            9
			        )
			    )
		lineageTag: 94a5b4f0-e132-4258-8698-34b32a43c86a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'FY - Latest Quarter Description' = ```
			
			
			VAR max_fnc = max('Front_page'[negativechecklistdate])
			
			VAR a2 = max_fnc
			
			VAR a3 = EDATE(max_fnc, -3)
			
			VAR a4 = EDATE(max_fnc, -6)
			
			VAR c =       'Waiting List Date Table'[Quarter_End]
			
			VAR c2 =      'Waiting List Date Table'[Quarter_Start]
			
			VAR d =       EDATE('Waiting List Date Table'[Quarter_End],-6)
			
			VAR d2 =      EDATE('Waiting List Date Table'[Quarter_Start],-6)
			  
			RETURN
			
			    IF ( a2 >= c && a3 < c, "Latest Q",
			    IF ( a4 > c2 && a4 < c, "Previous Q",
			        "Other Q")
			    )
			
			```
		lineageTag: 454607d0-2791-494c-a71b-a08e750e59f4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

