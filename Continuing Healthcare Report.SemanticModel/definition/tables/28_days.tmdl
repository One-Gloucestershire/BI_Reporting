			            '28_days'[monitoringoutcome] = "Eligible" && '28_days'[fasttrack] = "N" && '28_days'[decisiondate] > '28_days'[Death_date], "Decision after Patient's Death",
			            
			            '28_days'[monitoringoutcome] = "Eligible" && '28_days'[fasttrack] = "N" && '28_days'[decisiondate] <= '28_days'[Death_date], "Decision before Patient's Death",
			            
