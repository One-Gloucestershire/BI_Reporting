	column 'Exceeding 28 days order' =
			
			
			VAR daysdiff =
			    DATEDIFF (
			        '28_days'[checklistdate],
			        TODAY (),
			        DAY
			    ) - 28
			RETURN
			    SWITCH (
			        TRUE,
			        NOT (
			            ISBLANK ( '28_days'[decisiondate] )
			        ), BLANK (),
			        daysdiff <= 0, 1,
			        daysdiff <= 14, 2,
			        daysdiff <= 28, 3,
			        daysdiff <= 84, 4,
			        daysdiff <= 182, 5,
			        6
			    )
		formatString: 0
		lineageTag: 9eb0df30-bb97-4947-9c2c-a1da3d130b34
		summarizeBy: sum

