			CALCULATE([12 Week Fast Track Death % 28], 'Date'[FY - Latest Quarter Description] = "Latest Q") - CALCULATE([12 Week Fast Track Death % 28], 'Date'[FY - Latest Quarter Description] = "Previous Q")
			
			
			```
		lineageTag: eeb15dab-7186-45c1-95ac-6d2e9eb4746f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Fast track 12 week deaths' = ```
			CALCULATE(DISTINCTCOUNT('28_days'[ref]), '28_days'[fasttrack] = "Y", '28_days'[monitoringoutcome] = "Eligible", '28_days'[Fast Track to Death Date Diff] < 13 && '28_days'[Fast Track to Death Date Diff] >= 0 && '28_days'[Fast Track to Death Date Diff] <> BLANK() , USERELATIONSHIP('28_days'[decisiondate], 'Date'[Date]))
			
			```
		formatString: 0
		lineageTag: 76de165f-c5bf-4cc4-8d0c-1b35277c5388

