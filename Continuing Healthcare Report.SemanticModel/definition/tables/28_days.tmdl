	measure '12 Week Fast Track Death % 28' =
			
			
			
			VAR all_fast_track = CALCULATE(DISTINCTCOUNT('28_days'[ref]), '28_days'[fasttrack] = "Y", '28_days'[monitoringoutcome] = "Eligible", USERELATIONSHIP('28_days'[decisiondate], 'Date'[Date]))
			
			VAR _12_week_deaths = CALCULATE(DISTINCTCOUNT('28_days'[ref]), '28_days'[fasttrack] = "Y", '28_days'[monitoringoutcome] = "Eligible", '28_days'[Fast Track to Death Date Diff] < 13 && '28_days'[Fast Track to Death Date Diff] >= 0 && '28_days'[Fast Track to Death Date Diff] <> BLANK() , USERELATIONSHIP('28_days'[decisiondate], 'Date'[Date]))
			
			RETURN CALCULATE(_12_week_deaths / all_fast_track, USERELATIONSHIP('28_days'[fasttrackdate], 'Date'[Date]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: bc3e01e7-6c08-4251-a1e1-c93e1bd7062b

	measure 'FT Submitted Cases (28)' = CALCULATE(DISTINCTCOUNT('28_days'[ref] ), '28_days'[fasttrack] = "Y" ,  USERELATIONSHIP ( '28_days'[decisiondate], 'Date'[Date] )     )
		formatString: 0
		lineageTag: 47150553-1bf7-4c66-845a-a875634bdc62

	measure '12 Week Fast Track Death % 28 Death Date' =
			
			
			
			VAR all_fast_track = CALCULATE(DISTINCTCOUNT('28_days'[ref]), '28_days'[fasttrack] = "Y", '28_days'[monitoringoutcome] = "Eligible", USERELATIONSHIP('28_days'[Death_date], 'Date'[Date]))
			
			VAR _12_week_deaths = CALCULATE(DISTINCTCOUNT('28_days'[ref]), '28_days'[fasttrack] = "Y", '28_days'[monitoringoutcome] = "Eligible", '28_days'[Fast Track to Death Date Diff] < 13 && '28_days'[Fast Track to Death Date Diff] >= 0 && '28_days'[Fast Track to Death Date Diff] <> BLANK() , USERELATIONSHIP('28_days'[Death_date], 'Date'[Date]))
			
			RETURN CALCULATE(_12_week_deaths / all_fast_track, USERELATIONSHIP('28_days'[Death_date], 'Date'[Date]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4ead8d30-937a-466a-b16f-fa2749036df7

	measure 'CHC Referral Conversion Rate' = ```
			
			
			VAR eligible_referrals = CALCULATE([Count of Distinct Ref (28)],
			                '28_days'[monitoringoutcome] = "Eligible",
			                '28_days'[fasttrack] = "N"
			                ,USERELATIONSHIP ( '28_days'[decisiondate], 'Date'[Date] )) 
			
			VAR all_referrals = CALCULATE([Count of Distinct Ref (28)],
			                '28_days'[fasttrack] = "N"
			                ,USERELATIONSHIP ( '28_days'[checklistdate], 'Date'[Date] )) 
			
			RETURN 
			eligible_referrals/all_referrals
			
			```
		formatString: 0.0%;-0.0%;0.0%
