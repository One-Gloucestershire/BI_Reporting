	column DST_Gloucestershire_Registered_Date = ```
			
			
			SWITCH(TRUE(),
			'28_days'[dstdate] = BLANK(), BLANK(),
			'28_days'[Gloucestershire_registered_date] = BLANK(), BLANK(),
			'28_days'[dstdate] <> BLANK() && '28_days'[Gloucestershire_registered_date] <> BLANK() && '28_days'[dstdate] <= '28_days'[Gloucestershire_registered_date], "Moved to Gloucestershire on date of or after DST",
			'28_days'[dstdate] <> BLANK() && '28_days'[Gloucestershire_registered_date] <> BLANK() && '28_days'[dstdate] > '28_days'[Gloucestershire_registered_date], "Moved to Gloucestershire before DST",
