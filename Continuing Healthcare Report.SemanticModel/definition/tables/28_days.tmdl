	column 'Completed days (28)' =
			
			DATEDIFF (
			    '28_days'[checklistdate],
			    '28_days'[decisiondate],
			    DAY
			)
		formatString: 0
		lineageTag: 1f50d8d9-a020-4a5e-b36f-3187f6951dd8
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Open Cases exceeding 28days breakdown dashview' =
			
			VAR daysdiff =
			    DATEDIFF (
			        '28_days'[checklistdate],
			        TODAY (),
			        DAY
			    ) - 28
			RETURN
			    SWITCH (
			        TRUE,
			        NOT (
			            ISBLANK ( '28_days'[decisiondate] )
			        ), BLANK (),
			        daysdiff <= 0, BLANK (),
			        daysdiff <= 14, "0-2 weeks",
			        daysdiff <= 28, "2-4 weeks",
			        daysdiff <= 84, "4-12 weeks",
			        daysdiff <= 182, "12-26 weeks",
			        "26+ weeks"
			    )
		lineageTag: 75c788c3-1087-40ef-9496-98fe4711a328
		summarizeBy: none
		sortByColumn: 'Exceeding 28 days order'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Open Cases exceeding 28days breakdown' =
			
			VAR daysdiff =
			    DATEDIFF (
			        '28_days'[checklistdate],
			        TODAY (),
			        DAY
			    ) - 28
			RETURN
			    SWITCH (
			        TRUE,
			        NOT (
			            ISBLANK ( '28_days'[decisiondate] )
			        ), BLANK (),
			        daysdiff <= 0, BLANK (),
			        daysdiff <= 14, "0-2 weeks (1-14 Days)",
			        daysdiff <= 28, "2-4 weeks (15-28 Days)",
			        daysdiff <= 84, "4-12 weeks (29-84 Days)",
			        daysdiff <= 182, "12-26 weeks (85-182 Days)",
			        "26+ weeks (183+ Days)"
			    )
		lineageTag: 302e8db6-ed3d-421c-819f-acc38121f91d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column '2 year filter 28 day decision date' =
			
			
			VAR max_date = MAX('28_days'[decisiondate])
			
			VAR _2_year_date = EOMONTH(max_date, -24) +1
			
			RETURN IF('28_days'[decisiondate] >= _2_year_date, 1, 0)
		formatString: 0
		lineageTag: 39130d61-8919-45a7-b84f-e6d0b525a352
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

