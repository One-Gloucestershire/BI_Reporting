table 28_days
	lineageTag: 75ce051a-5ce6-4fbf-88c9-6702fccd5ce4

	measure 'Completed in 28 days % (28)' = ```
			
			
			VAR referrals = CALCULATE([Count of Distinct Client IDs (28)],
			                '28_days'[Completed days (28)] <> BLANK(),
			                '28_days'[fasttrack] = "N",
			                '28_days'[carecategory] <> "cht")
			
			var _28_day = CALCULATE([Count of Distinct Client IDs (28)],
			                '28_days'[Completed days (28)] <= 28 && '28_days'[Completed days (28)] <> BLANK(),
			                '28_days'[fasttrack] = "N",
			                '28_days'[carecategory] <> "cht")
			
			RETURN 
			_28_day 
			/ 
			referrals
			
			
			```
		formatString: 0%;-0%;0%
		lineageTag: 473f751a-c85d-436f-b50f-6eb9e10d123b

