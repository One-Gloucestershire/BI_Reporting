	measure 'Fast track conversion rate %' =
			DIVIDE(
			    CALCULATE(COUNT ( '28_days'[clientid] ),'28_days'[monitoringoutcome] = "eligible", '28_days'[fasttrack] = "Y" , USERELATIONSHIP ( '28_days'[decisiondate], 'Date'[Date] )     ) ,
			    CALCULATE(COUNT ( '28_days'[clientid] ),'28_days'[fasttrack] = "Y",  USERELATIONSHIP ( '28_days'[decisiondate], 'Date'[Date] )     ) ,
			  0
			  )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3f6233af-cee9-4510-8dd3-e4eb66dbea77

	measure 'Completed in 28 days % performance arrow' = ```
			SWITCH(TRUE(),
			    CALCULATE([New completed in 28 days %], 'Date'[FY - Latest Quarter Description] = "Latest Q") > CALCULATE([New completed in 28 days %], 'Date'[FY - Latest Quarter Description] = "Previous Q"), UNICHAR(9650),
			    CALCULATE([New completed in 28 days %], 'Date'[FY - Latest Quarter Description] = "Latest Q") < CALCULATE([New completed in 28 days %], 'Date'[FY - Latest Quarter Description] = "Previous Q"), UNICHAR(9660),    
			    CALCULATE([New completed in 28 days %], 'Date'[FY - Latest Quarter Description] = "Latest Q") == CALCULATE([New completed in 28 days %], 'Date'[FY - Latest Quarter Description] = "Previous Q"), UNICHAR(61),
			    UNICHAR(33)    
			)
			```
		lineageTag: 793df8ea-3bcf-4fcf-8800-0f3171ed6c1a

