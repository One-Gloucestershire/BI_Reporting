	column Decision_Date_Gloucestershire_Registered_Date =
			
			
			SWITCH(TRUE(),
			'28_days'[decisiondate] = BLANK(), BLANK(),
			'28_days'[Gloucestershire_registered_date] = BLANK(), BLANK(),
			'28_days'[decisiondate] <> BLANK() && '28_days'[Gloucestershire_registered_date] <> BLANK() && '28_days'[decisiondate] <= '28_days'[Gloucestershire_registered_date], "Moved to Gloucestershire on date of or after decision date",
			'28_days'[decisiondate] <> BLANK() && '28_days'[Gloucestershire_registered_date] <> BLANK() && '28_days'[decisiondate] > '28_days'[Gloucestershire_registered_date], "Moved to Gloucestershire before decision date",
