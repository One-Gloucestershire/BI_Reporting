	column Fast_Track_Gloucestershire_Registered_Date =
			
			
			SWITCH(TRUE(),
			'28_days'[fasttrackdate] = BLANK(), BLANK(),
			'28_days'[Gloucestershire_registered_date] = BLANK(), BLANK(),
			'28_days'[fasttrackdate] <> BLANK() && '28_days'[Gloucestershire_registered_date] <> BLANK() && '28_days'[fasttrackdate] <= '28_days'[Gloucestershire_registered_date], "Moved to Gloucestershire on date of or after fast track",
			'28_days'[fasttrackdate] <> BLANK() && '28_days'[Gloucestershire_registered_date] <> BLANK() && '28_days'[fasttrackdate] > '28_days'[Gloucestershire_registered_date], "Moved to Gloucestershire before fast track",
