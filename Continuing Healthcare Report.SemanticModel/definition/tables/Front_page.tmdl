	measure 'Completed in 28 days % (FP)' = ```
			
			
			VAR referrals = CALCULATE([Distinct count Client ID (FP)],
			                'Front_page'[Completed days (FP)] <> BLANK(),
			                'Front_page'[fasttrack] = "N",
			                'Front_page'[carecategory] <> "cht")
			
			var _28_day = CALCULATE([Distinct count Client ID (FP)],
			                'Front_page'[Completed days (FP)] <= 28 && 'Front_page'[Completed days (FP)] <> BLANK(),
			                'Front_page'[fasttrack] = "N",
			                'Front_page'[carecategory] <> "cht")
			
			RETURN 
			_28_day 
			/ 
			referrals
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e2332882-9e3a-4174-9cd4-a35295e22c72

