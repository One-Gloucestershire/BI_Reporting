	measure 'FNC Funded' = ```
			
			
			 CALCULATE([Distinct count Client ID (FP)], Front_page[fundername] = "FNC Funded", USERELATIONSHIP ( Front_page[fundersince], 'Date'[Date] )     )
			```
		formatString: 0
		lineageTag: 0b118f99-edca-4d28-a00f-68c03dfce2a0

	measure 'FNC Funded Over Time' = ```
			
			
			VAR CurrentDate = MAX('Waiting List Date Table'[Date])
			
			 
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT('Front_page'[clientid]),
			        'Front_page'[fundername] = "FNC Funded",
			        'Front_page'[fundersince] <= CurrentDate &&
			        'Front_page'[fundersince] <> BLANK() &&
			        IF('Front_page'[funderend] = BLANK(), TODAY(), 'Front_page'[funderend]) > CurrentDate, ALL('Date')
			    )
			```
		formatString: 0
		lineageTag: 533a188b-d1c9-4564-b0a8-3497805a1420

	measure '12 Week Fast Track Death %' =
			
			
			VAR all_fast_track = CALCULATE(DISTINCTCOUNT('28_days'[ref]), '28_days'[fasttrack] = "Y", '28_days'[monitoringoutcome] = "Eligible", USERELATIONSHIP('28_days'[decisiondate], 'Date'[Date]))
			
			VAR _12_week_deaths = CALCULATE(DISTINCTCOUNT('28_days'[ref]), '28_days'[fasttrack] = "Y", '28_days'[monitoringoutcome] = "Eligible", 'Front_page'[Fast Track to Death Date Diff] < 13 && 'Front_page'[Fast Track to Death Date Diff] >= 0, USERELATIONSHIP(Front_page[fasttrackactivationdate], 'Date'[Date]))
			
			RETURN CALCULATE(_12_week_deaths / all_fast_track, USERELATIONSHIP('28_days'[fasttrackdate], 'Date'[Date]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: def03324-7b82-440c-9dd1-ffeecb905ea5

	measure 'Fast Track Funded Over Time' = ```
			
			
			VAR CurrentDate = MAX('Waiting List Date Table'[Date])
			
			
			
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT('Front_page'[clientid]),
			        'Front_page'[fasttrack] = "Y",
			        'Front_page'[monitoringoutcome] = "Eligible",
			        'Front_page'[decisiondate] <= CurrentDate &&
			        'Front_page'[decisiondate] <> BLANK() &&
			        'Front_page'[Fast track end date]  > CurrentDate)
			
			```
		formatString: 0
		lineageTag: cb62cb2f-6f30-4e1d-8282-f36090b1c2f7

	measure 'FNC funded performance arrow' = ```
			SWITCH(TRUE(),
			    CALCULATE([FNC Funded], 'Date'[FY - Latest Quarter Description] = "Latest Q") > CALCULATE([FNC Funded], 'Date'[FY - Latest Quarter Description] = "Previous Q"), UNICHAR(9650),
			    CALCULATE([FNC Funded], 'Date'[FY - Latest Quarter Description] = "Latest Q") < CALCULATE([FNC Funded], 'Date'[FY - Latest Quarter Description] = "Previous Q"), UNICHAR(9660),    
			    CALCULATE([FNC Funded], 'Date'[FY - Latest Quarter Description] = "Latest Q") == CALCULATE([FNC Funded], 'Date'[FY - Latest Quarter Description] = "Previous Q"), UNICHAR(61),
			    UNICHAR(33)    
			)
			```
		lineageTag: 69e229af-56e5-4b2c-8ed0-aea3b8a7fb44

