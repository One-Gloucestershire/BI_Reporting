	measure 'Checklists _ Pos' = ```
			CALCULATE (
			    DISTINCTCOUNT ( 'Front_page'[clientid] ),
			    'Front_page'[fasttrack] = "N",
			 'Front_page'[carecategory] <> "EOL",
