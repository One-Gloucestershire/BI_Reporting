	column 'Calculated Decision Date' = ```
			
			SWITCH(TRUE(),
			Front_page[negativechecklistdate] = BLANK(), Front_page[decisiondate],
			           Front_page[decisiondate] = BLANK() , Front_page[negativechecklistdate],
			           Front_page[negativechecklistdate] > Front_page[decisiondate] , Front_page[negativechecklistdate],
			           Front_page[decisiondate] > Front_page[negativechecklistdate] , Front_page[decisiondate],
			           BLANK())
			
			```
		formatString: General Date
		lineageTag: 52b4c183-f3bf-4b15-a042-4cf4fdddcc6a
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 48a2e7e1-6a84-48e5-bb2b-05f6d97e0a4a
			defaultHierarchy: LocalDateTable_c2228749-ddb1-4e15-80c7-d5a2d198a2d3.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column 'Completed days (FP)' =
			
			DATEDIFF (
			    'Front_page'[checklistdate],
			    'Front_page'[decisiondate],
			    DAY
			)
		formatString: 0
		lineageTag: de2e8560-fa0d-47d0-b621-393d7e82de07
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column greatest_date
		dataType: dateTime
		formatString: Long Date
		lineageTag: 5fa27ab5-166b-427b-8e2e-dd100b17f836
		summarizeBy: none
		sourceColumn: greatest_date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column greatest_date_column
		dataType: string
		lineageTag: 923a69fa-5df9-43f9-a9dc-a88083e0f06f
		summarizeBy: none
		sourceColumn: greatest_date_column

		annotation SummarizationSetBy = Automatic

	column '2 year filter Front Page greatest date' =
			
			
			VAR max_date = MAX('Front_page'[greatest_date])
			
			VAR _2_year_date = EOMONTH(max_date, -24) +1
			
			RETURN IF('Front_page'[greatest_date] >= _2_year_date, 1, 0)
		dataType: int64
		formatString: 0
		lineageTag: ebca3994-e658-4ae9-ba33-433e88e4761d
		summarizeBy: sum

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	column 'Fast Track to Death Date Diff' = ```
			IF('Front_page'[fasttrack] = "Y" && 'Front_page'[monitoringoutcome] = "Eligible", DATEDIFF('Front_page'[fasttrackactivationdate],'Front_page'[dateofdeath],WEEK), BLANK())
			
			
			```
		formatString: 0
		lineageTag: 6ce04605-c6f1-4604-83c5-9269e9b21149
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column '2 year filter Front Page fast track activation date' =
			
			
			VAR max_date = MAX('Front_page'[fasttrackactivationdate])
			
			VAR _2_year_date = EOMONTH(max_date, -24) +1
			
			RETURN IF('Front_page'[fasttrackactivationdate] >= _2_year_date, 1, 0)
		formatString: 0
		lineageTag: f6d6e0b5-f130-4542-8032-8c057be02d0c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Fast track funded' = IF('Front_page'[fasttrack] = "Y" && 'Front_page'[monitoringoutcome] = "Eligible", "Fast track funded", "Not fast track funded")
		lineageTag: e25ef76a-208f-4c17-b2bb-af2b5e54751f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Fast track end date' = ```
			
			
			VAR death_date = IF('Front_page'[dateofdeath] = BLANK(), TODAY(), 'Front_page'[dateofdeath])
			
			RETURN 
			
			SWITCH(TRUE(),
			'Front_page'[Fast track funded] = "Fast track funded" && 'Front_page'[funderend] >= 'Front_page'[decisiondate] && 'Front_page'[funderend] < death_date, 'Front_page'[funderend], 
			'Front_page'[Fast track funded] = "Fast track funded" && 'Front_page'[funderend] >= 'Front_page'[decisiondate] && 'Front_page'[funderend] >= death_date, Front_page[funderend],
			'Front_page'[Fast track funded] = "Fast track funded" && 'Front_page'[funderend] = BLANK() && 'Front_page'[dateofdeath] = BLANK(), TODAY(),
			'Front_page'[Fast track funded] = "Fast track funded" && 'Front_page'[funderend] = BLANK() && 'Front_page'[dateofdeath] <> BLANK(), 'Front_page'[dateofdeath],
			'Front_page'[Fast track funded] = "Fast track funded" && 'Front_page'[funderend] <> BLANK() && 'Front_page'[dateofdeath] = BLANK(), 'Front_page'[funderend],
			BLANK())
			```
		formatString: General Date
		lineageTag: f048476d-efff-401d-8215-d57dc268395f
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 9bfd10a7-fe29-4967-b8b7-2741cbbd246c
			defaultHierarchy: LocalDateTable_fd4bdf2c-3ba5-4f7f-8aaa-642f9238b113.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column '2 year filter Front Page negative checklist date' =
			
			
			VAR max_date = MAX('Front_page'[negativechecklistdate])
			
			VAR _2_year_date = EOMONTH(max_date, -24) +1
			
			RETURN IF('Front_page'[negativechecklistdate] >= _2_year_date, 1, 0)
		formatString: 0
		lineageTag: 8e7e50aa-c052-4a5f-976a-fa2fa53469c2
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'FNC Funded Type' =
			SWITCH(TRUE(),
			'Front_page'[fundername] = "FNC Funded" && 'Front_page'[negativechecklistdate] <> BLANK(), "Negative Checklist FNC",
			'Front_page'[fundername] = "FNC Funded" && 'Front_page'[negativechecklistdate] = BLANK(), "Positive Checklist FNC",
			BLANK()
			)
		lineageTag: b2b6579d-f045-42a8-84b4-3c0741534a1b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Age =
			
			
			VAR end_date = IF('Front_page'[dateofdeath] = BLANK(), TODAY(), 'Front_page'[dateofdeath])
			
			VAR age =
			    DATEDIFF (
			        'Front_page'[dateofbirth],
			        end_date,
			        YEAR
			    )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( 'Front_page'[dateofbirth]), "",
			        age < 18, "0-17",
			        age >= 65, "65+",
			        "18-64"
			    )
		lineageTag: 8ebf1258-c965-4d38-9cc7-4da13c1b367b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column '2 year filter Front Page decision date' =
			
			
			VAR max_date = MAX('Front_page'[decisiondate])
			
			VAR _2_year_date = EOMONTH(max_date, -24) +1
			
			RETURN IF('Front_page'[decisiondate] >= _2_year_date, 1, 0)
		formatString: 0
		lineageTag: ad351318-f198-4b3f-9a37-6e5a8c91470b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'review Outstanding' =
			
			IF (
			    'Front_page'[scheduledreviewdate]
			        < TODAY (),
			    1,
			    0
			)
		formatString: 0
		lineageTag: 6813c34f-00a4-44cb-bde9-e20836983978
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Fast Track Eligiblity Status' =
			SWITCH(TRUE(),
			'Front_page'[monitoringoutcome] = "eligible" && 'Front_page'[fasttrack] = "Y", "Eligible",
			'Front_page'[monitoringoutcome] <> "eligible" && 'Front_page'[fasttrack] = "Y", "Not Eligible",
			"Not FT")
		lineageTag: 62929cd5-99a7-4db4-97e8-c22599820aae
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column '2 year filter Front Page funder since date' =
			
			
			VAR max_date = MAX('Front_page'[fundersince])
			
			VAR _2_year_date = EOMONTH(max_date, -24) +1
			
			RETURN IF('Front_page'[fundersince] >= _2_year_date, 1, 0)
		formatString: 0
		lineageTag: 7d0cd7e5-fcf6-4668-a025-a78b9871d22b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Time Between Fast Track Received and Funder Date' =
			
			
			VAR _time = DATEDIFF('Front_page'[fasttrackactivationdate],'Front_page'[fundersince],DAY)
			
			RETURN IF(_time<0,BLANK(),_time)
		formatString: 0
		lineageTag: 97665e6c-fe52-4c5b-bb1d-48bd2e734b3d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Age at FNC Decision' =
			
			
			VAR DOB = LOOKUPVALUE('Unique ID'[dateofbirth],'Unique ID'[clientid],'Front_page'[clientid])
			
			RETURN DATEDIFF(DOB,'Front_page'[fundersince],YEAR)
		formatString: 0
		lineageTag: c823328e-3e2d-4a19-a95a-56a104709166
