	column Age =
			
			
			VAR end_date = IF('Unique ID'[dateofdeath] = BLANK(), TODAY(), 'Unique ID'[dateofdeath])
			
			VAR age =
			    DATEDIFF (
			        'Unique ID'[dateofbirth],
			        end_date,
			        YEAR
			    )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( 'Unique ID'[dateofbirth]), "",
			        age < 18, "0-17",
			        age >= 65, "65+",
			        "18-64"
			    )
		lineageTag: 9a8ce09e-59e5-45a3-818a-361e29da9bd8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

