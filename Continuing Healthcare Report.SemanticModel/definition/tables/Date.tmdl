	column 'FT Survivabilty FY - Latest Quarter Description' = ```
			
			
			VAR max_fnc = IF(max('Front_page'[fundersince]) > TODAY(), TODAY(), max('Front_page'[fundersince]) )
			
			VAR latest_date = max_fnc
			
			VAR _3_months_prior = EDATE(max_fnc, -3)
			
			VAR _6_months_prior = EDATE(max_fnc, -6)
			
			VAR _9_months_prior = EDATE(max_fnc, -9)
			
			VAR quarter_end =       'Date'[Quarter_End]
			
			VAR quarter_start =      'Date'[Quarter_Start]
			
			VAR d =       EDATE('Date'[Quarter_End],-6)
			
			VAR d2 =      EDATE('Date'[Quarter_Start],-6)
			  
			RETURN
			
			   
			    IF ( _6_months_prior > quarter_start && _6_months_prior < quarter_end, "FT Latest Survivability Q",
			    IF ( _9_months_prior > quarter_start && _9_months_prior < quarter_end, "FT Previous Survivability Q",
			        "Other Q")
			    )
			
			
			
			```
		lineageTag: 822257ed-c9c9-4788-854e-23f126a55e69
		summarizeBy: none

