	column 'FY - Qr' =
			
			RIGHT (
			    CONVERT (
			        (
			            YEAR (
			                EDATE (
			                    'Date'[Date],
			                    9
			                )
			            ) - 1
			        ),
			        STRING
			    ),
			    2
			) & "-"
			    & RIGHT (
			        CONVERT (
			            YEAR (
			                EDATE (
			                    'Date'[Date],
			                    9
			                )
			            ),
			            STRING
			        ),
			        2
			    ) & " Q"
			    & QUARTER (
			        EDATE (
			            'Date'[Date],
			            9
			        )
			    )
		lineageTag: 4ced4c7e-aced-4903-93f2-d4604b764f05
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'FY - Q filter' =
			
			VAR a =
			    RIGHT (
			        CONVERT (
			            (
			                YEAR (
			                    EDATE (
			                        'Date'[Date],
			                        9
			                    )
			                ) - 1
			            ),
			            STRING
			        ),
			        2
			    ) & "-"
			        & RIGHT (
			            CONVERT (
			                YEAR (
			                    EDATE (
			                        'Date'[Date],
			                        9
			                    )
			                ),
			                STRING
			            ),
			            2
			        ) & " Q"
			        & QUARTER (
			            EDATE (
			                'Date'[Date],
			                9
			            )
			        )
			VAR b =
			    RIGHT (
			        CONVERT (
			            (
			                YEAR (
			                    EDATE (
			                        TODAY (),
			                        6
			                    )
			                ) - 1
			            ),
			            STRING
			        ),
			        2
			    ) & "-"
			        & RIGHT (
			            CONVERT (
			                YEAR (
			                    EDATE (
			                        TODAY (),
			                        9
			                    )
			                ),
			                STRING
			            ),
			            2
			        ) & " Q"
			        & QUARTER (
			            EDATE (
			                TODAY (),
			                6
			            )
			        )
			RETURN
			    IF (
			        a = b,
			        "Last Q",
			        a
			    )
		lineageTag: 869e9355-47b5-4664-9f59-5a5dc87086dc
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'FY - Latest Quarter Description' = ```
			
			
			VAR max_fnc = IF(max('Front_page'[fundersince]) > TODAY(), TODAY(), max('Front_page'[fundersince]) )
			
			VAR a2 = max_fnc
			
			VAR a3 = EDATE(max_fnc, -3)
			
			VAR a4 = EDATE(max_fnc, -6)
			
			VAR c =       'Date'[Quarter_End]
			
			VAR c2 =      'Date'[Quarter_Start]
			
			VAR d =       EDATE('Date'[Quarter_End],-6)
			
			VAR d2 =      EDATE('Date'[Quarter_Start],-6)
			  
			RETURN
			
			    IF ( a2 >= c && a3 < c, "Latest Q",
			    IF ( a4 > c2 && a4 < c, "Previous Q",
			        "Other Q")
			    )
			
			
			
			```
