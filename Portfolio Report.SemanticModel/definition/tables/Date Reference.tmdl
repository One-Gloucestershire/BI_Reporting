	partition 'Date Reference' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "DSCRO_NATIONAL_LOOKUPS", [Query="select *#(lf)from DSCRO_NATIONAL_LOOKUPS.dbo.ref_Dates#(lf)#(lf)where cast(Full_Date as date) between '2023-04-01' and EOMONTH(getdate())#(lf)#(lf)order by Full_Date"]),
				    #"Filtered Rows" = Table.SelectRows(Source, each true)
				in
				    #"Filtered Rows"

