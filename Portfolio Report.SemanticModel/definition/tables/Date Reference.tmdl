	column YearMonthIndex =
			
			
			
			RANKX(
			    ALL('Date Reference'[year_month]),
			    'Date Reference'[year_month],
			    ,
			    ASC,
			    DENSE
			) - 1
		formatString: 0
		lineageTag: 33ffba3a-2947-4de6-8a54-8da7ec4673f0
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column SPC_flag = IF('Date Reference'[Fin_Year_yy_yy] = "23/24" || 'Date Reference'[Fin_Year_yy_yy] = "24/25", 1, 0)
		formatString: 0
		lineageTag: ba213a03-effc-4010-b406-b1d16b402c6c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

