	measure Hospital_admission_and_ED_attendances_colour = ```
			
			
			
			
			VAR FieldName = SELECTEDVALUE('Metric_Link_for_patient_level_ref'[Field Name])
			VAR LastAdmission =
			    SWITCH(
			        FieldName,
			        "Last Hospital Admission Date", MAX('PPW Daily Data'[Last Hospital Admission Date]),
			        "Last Emergency Department Date", MAX('PPW Daily Data'[Last Emergency Department Date]),
			        BLANK()
			    )
			VAR DataUpTo = MAX('PPW Daily Data'[PC_Data_up_to])
			VAR DaysBetween = DATEDIFF(LastAdmission, DataUpTo, DAY)
			
			RETURN
			IF(
			    FieldName IN { "Last Hospital Admission Date", "Last Emergency Department Date" },
			    SWITCH(
			        TRUE(),
			        ISBLANK(LastAdmission) || ISBLANK(DataUpTo), BLANK(),
			        DaysBetween <= 42, "#A3D9A5",  // Green
			        DaysBetween <= 182, "#FFD88A", // Amber
			        DaysBetween <= 365, "#F5A5A5" // Red
			       --"#D3D3D3" // Optional: default color if > 365
			    ),
			    BLANK() // No formatting for other field names
			)
			
			
			```
		lineageTag: 5f7fe585-4622-44ed-a170-792141f6b09f

	measure Frailty_colour = ```
			
			VAR FieldName = SELECTEDVALUE('Metric_Link_for_patient_level_ref'[Field Name])
			VAR Latest_Rockwood_code = MAX('PPW Daily Data'[Last Rockwood Score -grey the code is more recent])
			VAR Latest_frailty_code = MAX('PPW Daily Data'[Last Frailty Code -grey the value is more recent Date])
			VAR DataUpTo = MAX('PPW Daily Data'[PC_Data_up_to])
			VAR DaysBetween = DATEDIFF(Latest_Rockwood_code, DataUpTo, DAY)
			
			RETURN
			IF(
			    FieldName = "Last Rockwood Score -grey the code is more recent",
			    SWITCH(
			        TRUE(),
			        ISBLANK(Latest_frailty_code) || ISBLANK(DataUpTo) || ISBLANK(Latest_Rockwood_code), BLANK(),
			        Latest_Rockwood_code > Latest_frailty_code, "#D3D3D3", // Grey if Rockwood is more recent
			        DaysBetween <= 42, "#A3D9A5",  // Green
			        DaysBetween <= 182, "#FFD88A", // Amber
			        DaysBetween <= 365, "#F5A5A5" // Red
			      --  "#D3D3D3" // Optional: grey if > 365
			    ),
			    BLANK()
			)
			
			```
		lineageTag: c6d078e8-9670-4a66-9186-fb904adbfd72

