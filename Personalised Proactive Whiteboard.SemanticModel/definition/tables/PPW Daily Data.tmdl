			    DISTINCTCOUNT('PPW Daily Data'[NHS Number (Pseudo)]),
			    DATEDIFF('PPW Daily Data'[Last fall date], 'PPW Daily Data'[Census_Date], DAY) <= 28,
			    DATEDIFF('PPW Daily Data'[Last fall date], 'PPW Daily Data'[Census_Date], DAY) >= 0,
			    NOT ISBLANK('PPW Daily Data'[Last fall date])
			),0)
			
