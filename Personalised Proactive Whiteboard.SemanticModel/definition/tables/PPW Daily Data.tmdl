	partition 'PPW Daily Data' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "PowerBI_Reporting", [Query="select *#(lf)from PowerBI_Reporting.AgeingWell.tbl18_Daily_Proactive_Whiteboard_Cohort#(lf)#(lf)where in_cohort_flag = 1"]),
				    #"Renamed Columns" = Table.RenameColumns(Source,{{"nhs_number", "NHS Number (Pseudo)"}}),
				    #"Last Treatment Escalation Plan - replace null values for unpivoted data souce" = Table.ReplaceValue(#"Renamed Columns",null,#datetime(1900, 1, 1, 0, 0, 0),Replacer.ReplaceValue,{"Last Treatment Escalation Plan Date"})
				in
				    #"Last Treatment Escalation Plan - replace null values for unpivoted data souce"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

