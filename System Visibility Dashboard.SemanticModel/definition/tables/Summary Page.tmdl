table 'Summary Page'
	lineageTag: 698e6841-8c31-44a1-a1ce-dba343c42579

	measure 'Value - Dynamic' = CALCULATE(SUM('Summary Page'[Numerator])/sum('Summary Page'[Denominator]))
		displayFolder: Data
		lineageTag: c11cf7c3-ca04-4649-ad61-07204c6b5f2e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure AMB01_RAG_Red = if(CALCULATE(sum('Summary Page'[Value])/sum('Summary Page'[Target]),ALLSELECTED('Date Table'[Week_Start])) > 1.01,1,0)
		formatString: 0
		displayFolder: RAG
		lineageTag: 2bb0020b-04d7-48d4-b7d6-df4bfac041e7

	measure AMB01_RAG_Green = if(CALCULATE(sum('Summary Page'[Value])/sum('Summary Page'[Target]),ALLSELECTED('Date Table'[Week_Start])) < 0.99,1,0)
		formatString: 0
		displayFolder: RAG
		lineageTag: 5b31a03e-604e-4401-8624-7d81cb3a4af0

	measure AMB01_RAG_Amber = if(and(CALCULATE(sum('Summary Page'[Value])/sum('Summary Page'[Target]),ALLSELECTED('Date Table'[Week_Start])) >= 0.99,CALCULATE(sum('Summary Page'[Value])/sum('Summary Page'[Target]),ALLSELECTED('Date Table'[Week_Start])) <=1.01),1,0)
		formatString: 0
		displayFolder: RAG
		lineageTag: b3165807-79e4-45f1-beb7-f881427056f1

	measure 'Value - Dynamic%' = CALCULATE(SUM('Summary Page'[Numerator])/sum('Summary Page'[Denominator]))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Data
		lineageTag: 2016eafb-09c8-4738-a9dc-641b7af6e39a

	measure Target_% = calculate(AVERAGE('Summary Page'[Target]))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Data
		lineageTag: 4333eb09-f320-472d-8640-09c1e72d835b

	measure Value_Supressed =
			if(
			    ISBLANK(SUM('Summary Page'[Value])),"",
			    IF(
			        SUM('Summary Page'[Value])<5,0,sum('Summary Page'[Value])))
		displayFolder: Data
		lineageTag: 4ca37db4-7862-40af-84fe-5f0166eb6053

		annotation PBI_FormatHint = {"isGeneralNumber":true}

