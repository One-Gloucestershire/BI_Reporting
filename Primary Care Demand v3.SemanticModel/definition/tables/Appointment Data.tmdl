table 'Appointment Data'
	lineageTag: d0e11ef4-079f-43af-83ae-d8e9ea3d840c

	measure 'GP Appointments per Person - By Year - YTD' =
			
			
			VAR GPAPP = CALCULATE ( SUM ('Appointment Data'[Appointments] ) , ALLEXCEPT( 'Date Table', 'Date Table'[financial_year] ) , 'Date Table'[ytd_flag] = 1 )
			VAR POP = CALCULATE ( SUM ( Population[population] ) , ALLEXCEPT ('Date Table', 'Date Table'[financial_year] ), 'Date Table'[month_name] IN {"Apr"} )
			
			RETURN (GPAPP/POP)
		lineageTag: d5dadfca-5604-4be1-81ba-b81cd65cee99

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Appointments Mean' =
			
			
			CALCULATE ( SUM ( 'Appointment Data'[Appointments] ) / [Number of Months],
			            ALLSELECTED('Date Table') )
		lineageTag: 93312516-9ea7-4bd5-93b5-7c1bd31d8631

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Appointments UCL' = IF(([Appointments Mean]+(3*[Appointments STD DEV])) < 0, 0, ([Appointments Mean]+(3*[Appointments STD DEV])))
		lineageTag: e47a85ad-f658-4855-8c3c-1f8c3dccd166

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Appointments LCL' = IF(([Appointments Mean]-(3*[Appointments STD DEV])) < 0, 0, ([Appointments Mean]-(3*[Appointments STD DEV])))
		lineageTag: 7001a752-e79d-4ed5-ba9b-1efa2f73552e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Appointments STD DEV' = ```
			
			
			VAR STD_DEV = CALCULATE(STDEVX.P ( VALUES ( 'Appointment Data'[YearMonth]), [Total Appointments]), ALLEXCEPT('Date Table', 'Date Table'[year_month]))
			
			RETURN IFERROR(STD_DEV, 0)
			
			```
		lineageTag: 522e92e8-85b7-442d-bdec-cbcbc179a97f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Appointments' = SUM('Appointment Data'[Appointments])
		formatString: 0
		lineageTag: 1d60e8fb-c94c-4321-b969-9ddd4ff1eaac

	measure 'Total Appointments Static' = CALCULATE(SUM('Appointment Data Static'[Appointments]), ALLEXCEPT('Date Table', 'Date Table'[financial_year], 'Date Table'[month_name]))
		formatString: 0
		lineageTag: 8dadf841-ebe8-49ab-a49b-b507f97277cb

	measure 'GP Appointments per Person - By Month' =
			
			
			VAR GPAPP = CALCULATE ( SUM ('Appointment Data'[Appointments]) )
			VAR POP = CALCULATE ( SUM ( 'Population'[population] ) )
			
			RETURN (GPAPP/POP)
		lineageTag: 89f562fa-0490-48ae-bd47-8039f39c3587

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Static - GP Appointments per Person - By Month' =
			
			
			VAR GPAPP = CALCULATE ( SUM ('Appointment Data Static'[Appointments] ))
			VAR POP = CALCULATE ( SUM ( 'Population Static'[population] ) )
			
			RETURN (GPAPP/POP)
		lineageTag: 77ec95b7-098a-46ff-a4ec-2b5b164da78f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Static - GP Appointments per Person - By Year - YTD' =
			
			
			VAR GPAPP = CALCULATE ( SUM ('Appointment Data Static'[Appointments] ) , ALLEXCEPT( 'Date Table', 'Date Table'[financial_year] ) , 'Date Table'[ytd_flag] = 1 )
			VAR POP = CALCULATE ( SUM ( 'Population Static'[population] ) , ALLEXCEPT ('Date Table', 'Date Table'[financial_year] ), 'Date Table'[month_name] IN {"Apr"} )
			
			RETURN (GPAPP/POP)
		lineageTag: 555edacf-d444-47b8-853e-8b6bb3cb5f65

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Area Legend Categories'
		lineageTag: aa194464-0456-40fa-bf63-28ce144240c7

	measure 'Number of Months' =
			
			
			DISTINCTCOUNT('Appointment Data'[YearMonth])
		formatString: 0
		lineageTag: 8633dd28-92bf-413d-9f7a-1317c79a116c

	measure 'Previous Year Total Appointments' =
			
			
			CALCULATE ( SUM('Appointment Data'[Appointments]), (PREVIOUSYEAR('Date Table'[Date], "31/3")))
			
			//CALCULATE ( SUM ( 'Appointment Data'[Appointments] ) , PREVIOUSYEAR ('Date Table'[date])))
		formatString: 0
		lineageTag: cad3a6c3-ca4e-4cf0-8f3c-dcf60dd82c5c

	measure '% Change Appointments Previous Year' = IF((DIVIDE([Total Appointments],[Previous Year Total Appointments]) - 1) <= 0, BLANK(), (DIVIDE([Total Appointments],[Previous Year Total Appointments]) - 1))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 67580c47-95a9-498e-a83a-04f5960b6037

	measure 'GP Appointments per Person - By Year' =
			
			
			VAR GPAPP = CALCULATE ( SUM ('Appointment Data'[Appointments] ) , ALLEXCEPT( 'Date Table', 'Date Table'[financial_year] )  )
			VAR POP = CALCULATE ( SUM ( Population[population] ) , ALLEXCEPT ('Date Table', 'Date Table'[financial_year] ), 'Date Table'[month_name] IN {"Apr"} )
			
			RETURN (GPAPP/POP)
		lineageTag: ce7d8332-1e76-4fb9-8cf8-3ed2975bbdd7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Static - GP Appointments per Person - By Year' =
			
			
			VAR GPAPP = CALCULATE ( SUM ('Appointment Data Static'[Appointments] ) , ALLEXCEPT( 'Date Table', 'Date Table'[financial_year] ) )
			VAR POP = CALCULATE ( SUM ( 'Population Static'[population] ) , ALLEXCEPT ('Date Table', 'Date Table'[financial_year] ), 'Date Table'[month_name] IN {"Apr"} )
			
			RETURN (GPAPP/POP)
		lineageTag: b08528b4-faec-4895-a0b9-6311a9be38bf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Appointment Linear Regression' = ```
			
			
			VAR Temp_Table = 
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED( 'Date Table'[financial_year], 'Date Table'[financial_month],
			                         'Date Table'[month_name], 'Date Table'[month_number] ),
			            "Value_x", 'Date Table'[month_number],
			            "Value_y", 'Appointment Data'[Total Appointments]
			        ),
			        AND (
			            NOT ( ISBLANK ( "Value_x" ) ),
			            NOT ( ISBLANK ( "Value_y" ) )
			        )
			    )
			
			VAR LINESTX_Table = 
			    LINESTX(Temp_Table, [Value_y], [Value_x], TRUE)
			VAR Slope = 
			    MAXX ( LINESTX_Table, [Slope1] )
			VAR Intercept = 
			    MAXX ( LINESTX_Table, [Intercept] )
			
			RETURN
			    SUMX (
			        DISTINCT ( 'Date Table'[month_number] ),
			        Intercept + Slope * 'Date Table'[month_number]
			    )
			```
		lineageTag: cd56960c-a765-4f2f-972f-af5e30dd32cb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Appointment Linear Regression - Rate per 1000' = ```
			
			
			VAR Temp_Table = 
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED( 'Date Table'[financial_year], 'Date Table'[financial_month],
			                         'Date Table'[month_name], 'Date Table'[month_number] ),
			            "Value_x", 'Date Table'[month_number],
			            "Value_y", 'Appointment Data'[GP Appointments per Person - By Month]
			        ),
			        AND (
			            NOT ( ISBLANK ( "Value_x" ) ),
			            NOT ( ISBLANK ( "Value_y" ) )
			        )
			    )
			
			VAR LINESTX_Table = 
			    LINESTX(Temp_Table, [Value_y], [Value_x], TRUE)
			VAR Slope = 
			    MAXX ( LINESTX_Table, [Slope1] )
			VAR Intercept = 
			    MAXX ( LINESTX_Table, [Intercept] )
			
			RETURN
			    SUMX (
			        DISTINCT ( 'Date Table'[month_number] ),
			        Intercept + Slope * 'Date Table'[month_number]
			    )
			```
		lineageTag: d2dbcdd7-59c9-4b6d-9926-b10c7f4b03ed

		annotation PBI_FormatHint = {"isGeneralNumber":true}

