	partition Population = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "PowerBI_Reporting", [Query="  SELECT DISTINCT [practice_code]#(lf)               ,[practice_name] = CASE WHEN [practice_name] LIKE 'Cam and Uley Family Practice' THEN 'Cam & Uley Family Practice'#(lf)#(tab)#(tab)#(tab)                           WHEN [practice_name] LIKE 'Newent Doctors Practice' THEN 'Holts Health Centre'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN [practice_name] LIKE 'Painswick Surgery' THEN 'Hoyland House'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN [practice_name] LIKE 'Prestbury Park' THEN 'Prestbury Park Medical'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN [practice_name] LIKE 'Royal Crescent' THEN 'Royal Crescent Surgery'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN [practice_name] LIKE 'Gloucester City Health Centre' THEN 'Severnside Medical Practice'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN [practice_name] LIKE 'Stroud Valleys Medical Practice' THEN 'Five Valleys Medical Practice'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN [practice_name] LIKE 'Locking Hill Surgery' THEN 'Five Valleys Medical Practice'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   ELSE [practice_name] END#(lf)#(tab)#(tab)#(tab)   ,[primary_care_network]#(lf)#(tab)#(tab)#(tab)   ,[locality]#(lf)#(tab)#(tab)#(tab)   ,[age_band]#(lf)               ,[3_year_age_band]#(lf)#(tab)#(tab)#(tab)   ,[sex]#(lf)#(tab)#(tab)#(tab)   ,[population]#(lf)#(tab)#(tab)#(tab)   ,[census_date]#(lf)#(tab)#(tab)#(tab)   ,[year_month]#(lf)#(tab)#(tab)#(tab)   ,[last_date_of_month]#(lf)#(tab)#(tab)#(tab)   ,[financial_year]#(lf)                           ,[Legend_Helper] = 'Gloucestershire'#(lf)#(lf)FROM [PowerBI_Reporting].[dbo].[GP_Practice_Populations]#(lf)#(lf)where [last_date_of_month] BETWEEN '20190401' AND EOMONTH(DATEADD(MONTH, -1, GETDATE()))"]),
				    #"Filtered Rows" = Table.SelectRows(Source, each true)
				in
				    #"Filtered Rows"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

