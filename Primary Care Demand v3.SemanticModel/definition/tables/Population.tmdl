table Population
	lineageTag: 90d53e14-6f13-468d-a54b-4bd51c02fdf6

	measure 'Yearly Population' = CALCULATE ( SUM ( Population[population] ), 'Date Table'[month_name] IN {"Apr"} )
		lineageTag: 07491e5c-45c4-4403-8865-c2b160b59737

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Previous Month' =
			
			
			CALCULATE ( SUM('Population'[population]), PREVIOUSMONTH('Date Table'[date]))
		lineageTag: 58ffd1b2-8ba9-4da6-a41f-9cd87d3e133d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Current Month' = SUM('Population'[population])
		formatString: #,0
		lineageTag: 2f555280-51b6-4018-9d00-5f1d45a8f7b1

	measure 'Annual % Change' = IF(((1 - ([Previous Year]/[Current Month])) = 1), BLANK(), (1 - ([Previous Year]/[Current Month])))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 90aafe27-93c4-44ef-8ba1-c0e1b07848c3

	measure 'Previous Year' =
			
			
			CALCULATE ( SUM('Population'[population]), DATEADD('Date Table'[date], -12, MONTH))
		formatString: #,0
		lineageTag: 564b7aa0-af98-4d77-8de9-bfc281ad9b6a

