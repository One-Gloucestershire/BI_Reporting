	partition 'Different WL' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "Data_Mart_COVID19", [Query="SET ANSI_NULLS ON#(lf)SET QUOTED_IDENTIFIER ON#(lf)set nocount on#(lf)set ansi_warnings off #(lf)#(lf)IF OBJECT_ID('tempdb..#TEMP') IS NOT NULL DROP TABLE #TEMP;  #(lf)#(lf)/*=======================================================================#(lf)PARAMETERS#(lf)=======================================================================*/#(lf)#(lf)DECLARE @WEEKENDING DATETIME#(lf)SET @WEEKENDING = (SELECT DISTINCT MAX(#(lf)CASE WHEN DATENAME(DW,[week_ending_date]) = 'MONDAY' THEN DATEADD(DD,-1,[week_ending_date])#(lf)WHEN DATENAME(DW,[week_ending_date]) = 'TUESDAY' THEN DATEADD(DD,-2,[week_ending_date])  #(lf)WHEN DATENAME(DW,[week_ending_date]) = 'WEDNESDAY' THEN DATEADD(DD,-3,[week_ending_date]) #(lf)WHEN  DATENAME(DW,[week_ending_date]) = 'THURSDAY' THEN DATEADD(DD,-4,[week_ending_date])#(lf)WHEN DATENAME(DW,[week_ending_date]) = 'FRIDAY' THEN DATEADD(DD,-5,[week_ending_date])#(lf)WHEN DATENAME(DW,[week_ending_date]) = 'SATURDAY' THEN DATEADD(DD,-6,[week_ending_date])ELSE [week_ending_date] END)#(lf)#(lf)FROM [Data_Mart_COVID19].[dbo].[National_Wait_List_Open_Pathways] where week_ending_date <= GETDATE())#(lf)#(lf)DECLARE @WEEKENDING1 DATETIME#(lf)SET @WEEKENDING1 = (SELECT DISTINCT MAX(#(lf)CASE WHEN DATENAME(DW,[week_ending_date]) = 'MONDAY' THEN DATEADD(DD,-1,[week_ending_date])#(lf)WHEN DATENAME(DW,[week_ending_date]) = 'TUESDAY' THEN DATEADD(DD,-2,[week_ending_date])  #(lf)WHEN DATENAME(DW,[week_ending_date]) = 'WEDNESDAY' THEN DATEADD(DD,-3,[week_ending_date]) #(lf)WHEN  DATENAME(DW,[week_ending_date]) = 'THURSDAY' THEN DATEADD(DD,-4,[week_ending_date])#(lf)WHEN DATENAME(DW,[week_ending_date]) = 'FRIDAY' THEN DATEADD(DD,-5,[week_ending_date])#(lf)WHEN DATENAME(DW,[week_ending_date]) = 'SATURDAY' THEN DATEADD(DD,-6,[week_ending_date])ELSE [week_ending_date] END)#(lf)FROM [Data_Mart_COVID19].[dbo].[National_Wait_List_Open_Pathways] where week_ending_date <= '31-MAR-2022')#(lf)/*=======================================================================#(lf)CURRENT WAIT LIST#(lf)=======================================================================*/#(lf)#(lf)SELECT #(lf)[COUNT] = 1,#(lf)[Date_And_Time_Data_Set_Created],#(lf)[Week_Ending_Date],#(lf)[Days] = DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING),#(lf)[Weeks] = DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING) / 7.0,#(lf)[Weeks_Waiting_Banding] = CASE WHEN DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING) BETWEEN 0   AND 126 THEN '0 < 18 Weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING) BETWEEN 127 AND 182 THEN '18 < 26 Weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING) BETWEEN 183 AND 280 THEN '26 < 40 Weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING) BETWEEN 281 AND 364 THEN '40 <  52 Weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING) BETWEEN 365 AND 546 THEN '52 < 78 Weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING) BETWEEN 547 AND 728 THEN '78 < 104 Weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING) > 729               THEN '104+ Weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   ELSE 'NULL' END,#(lf)[Pseudo_NHS_Number],#(lf)[WL].[Organisation_Identifier_Code_Of_Provider],#(lf)[Provider] = CASE WHEN [TR].[Name] IS NOT NULL THEN [TR].[Name]#(lf)#(tab)#(tab)#(tab)#(tab)  WHEN [WL].[Organisation_Identifier_Code_Of_Provider] = 'R0D' THEN 'UNIVERSITY HOSPITALS DORSET NHS FOUNDATION TRUST'#(lf)#(tab)#(tab)#(tab)#(tab)  ELSE [IP].[Organisationname] END,#(lf)[Organisation_Site_Identifier_Of_Treatment],#(lf)[Activity_Treatment_Function_Code],#(lf)[Treatment Function] =[TF].[TreatmentFunctionDescription],#(lf)[Referral_To_Treatment_Period_Start_Date],#(lf)[Organisation_Identifier_Code_Of_Commissioner],#(lf)[WL].[Derived_Registered_CCG],#(lf)[Derived_GP_Registered_Practice_Code],#(lf)[Waiting_List_Type] = CASE WHEN [Waiting_List_Type] = 'IRTT' then 'Admitted PTL'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN [Waiting_List_Type] = 'ORTT' then 'Non-Admitted PTL' ELSE 'Other' END,#(lf)[Derived_Age_At_Activity],#(lf)[AgeBand5yr] = [ab].[5yr_age_band],#(lf)[AgeBand5yrs] = CASE WHEN [Derived_Age_At_Activity] BETWEEN 85 AND 89 then '85-89'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN [Derived_Age_At_Activity] >= 90 THEN '90+'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab) ELSE [AB].[5yr_age_band] END,#(lf)[AgeBand10yr] = [AB].[10yr_age_band], #(lf)[AB].[Adult_Age_Band],#(lf)[AgeBand] = CASE WHEN CAST([Derived_Age_At_Activity] AS INT) <18 THEN 'Children and Young People (0-17)'#(lf)#(tab)#(tab)#(tab)#(tab) WHEN CAST([Derived_Age_At_Activity] AS INT) BETWEEN 18 AND 64 THEN 'Working Age Adults (18-64)' #(lf)#(tab)#(tab)#(tab)#(tab) WHEN CAST([Derived_Age_At_Activity] AS INT) >64 THEN 'Older Adults (65+)' ELSE 'Unknown' END, #(lf)[Derived_LSOA],#(lf)[MPI Gender] = [MPI].[Gender],#(lf)[MPI Ethnic Description] = [MPI].[EthnicOriginDescription],#(lf)[MPI Deprivation] = [MPI].[IMDcountyDecile],#(lf)[MPI Learning Disability] = [MPI].[Learningdisabilityderived],#(lf)[MPI Core20] = [MPI].[Core20Flag],#(lf)[PDSGender] = CASE WHEN LEFT([PDS].[Gender_desc],1) IS NULL  THEN 'U'#(lf)#(tab)#(tab)#(tab)#(tab)   WHEN [PDS].[Gender_desc] = 'Spine code 9' THEN 'U'#(lf)#(tab)#(tab)#(tab)#(tab)   ELSE LEFT([PDS].[Gender_desc],1) END, #(lf)[PDS].[PrimaryCareProvider],#(lf)[Practice name] = [C].[ReportingOrganisationName],#(lf)[C].[PrimaryCareNetwork],#(lf)[ETHN].[Ethnic Origin Grouped],#(lf)[ETHN].[Ethnic Origin Wider Groups],#(lf)[POST].[IMDCountyDecile],#(lf)#(lf)[Core20Flag] = CASE WHEN [Derived_LSOA] in ('E01022120','E01022122','E01022131','E01022133','E01022147','E01022152','E01022160','E01022164','E01022238','E01022284',#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)'E01022285','E01022288','E01022289','E01022290','E01022291','E01022292','E01022311','E01022319','E01022320','E01022322',#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) 'E01022323','E01022324','E01022328','E01022329','E01022332','E01022333','E01022346','E01022347','E01022458','E01032932',#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) 'E01032937') THEN 1 ELSE 0#(tab)END,      #(lf)[WaitingList] = 'Current'#(lf)INTO #TEMP#(lf)FROM [Data_Mart_COVID19].[dbo].[National_Wait_List_Open_Pathways] [WL]#(lf)#(lf)#(tab)LEFT JOIN [CCG_Reference].[Reference].[vw_TreatmentFunction] [TF] #(lf)#(tab)ON WL.[Activity_Treatment_Function_Code] = [TF].[TreatmentFunctionCode]#(lf)#(lf)#(tab)#(tab)LEFT JOIN [CCG_Reference].[Reference].[vw_OrganisationTrust] TR #(lf)#(tab)#(tab)ON TR.[OrganisationCode] = [Organisation_Identifier_Code_Of_Provider]#(lf)#(lf)#(tab)#(tab)#(tab)LEFT JOIN [CCG_Reference].[Reference].[vw_IndependentProvider] IP #(lf)#(tab)#(tab)#(tab)ON IP.[OrganisationCode] = Left([Organisation_Identifier_Code_Of_Provider], 3) #(lf)#(lf)#(tab)#(tab)#(tab)#(tab)LEFT JOIN [BIReports].[MPI].[MPI_current] MPI#(lf)#(tab)#(tab)#(tab)#(tab)ON MPI.Derived_Pseudo_NHS = WL.Pseudo_NHS_Number#(lf)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)LEFT JOIN [CCG_Reference].[Population].[vw_NHAIS_Current] [NHAIS]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)ON [NHAIS].[Derived_Pseudo_NHS] = [WL].[Pseudo_NHS_Number]#(lf)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)LEFT JOIN [CCG_Reference].[Population].[vw_PDS_Current] [PDS]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ON pds.Derived_NHS_Number = WL.Pseudo_NHS_Number#(lf)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)LEFT JOIN [BIReports].[MPI].[Ethnicity_Table] [Ethn]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ON [ethn].[PseudoNHSNo] = [WL].[Pseudo_NHS_Number]#(lf)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)LEFT JOIN [ccg_reference].[reference].[vw_postcode_lookup] [post]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ON [NHAIS].[Derived_Pseudo_Postcode] = [post].[derived_Postcode_Key]#(lf)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)LEFT JOIN [CCG_Reference].[Reference].[vw_GPPractice] [C]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ON [pds].[PrimaryCareProvider] = [c].[OrganisationCode]#(lf)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(lf)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) LEFT JOIN [CCG_Reference].[Reference].[vw_AgeBand] [AB]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) ON [Derived_Age_At_Activity] = [AB].[Age]#(lf)#(lf)WHERE [Referral_To_Treatment_Period_End_Date] IS NULL#(lf)AND [Referral_To_Treatment_Period_Start_Date] IS NOT NULL#(lf)AND CASE WHEN DATENAME(DW,[week_ending_date]) = 'MONDAY'    THEN DATEADD(DD,-1,[week_ending_date])#(lf)#(tab)#(tab) WHEN DATENAME(DW,[week_ending_date]) = 'TUESDAY'   THEN DATEADD(DD,-2,[week_ending_date])  #(lf)#(tab)#(tab) WHEN DATENAME(DW,[week_ending_date]) = 'WEDNESDAY' THEN DATEADD(DD,-3,[week_ending_date]) #(lf)#(tab)#(tab) WHEN DATENAME(DW,[week_ending_date]) = 'THURSDAY'  THEN DATEADD(DD,-4,[week_ending_date])#(lf)#(tab)#(tab) WHEN DATENAME(DW,[week_ending_date]) = 'FRIDAY'    THEN DATEADD(DD,-5,[week_ending_date])#(lf)#(tab)#(tab) WHEN DATENAME(DW,[week_ending_date]) = 'SATURDAY'  THEN DATEADD(DD,-6,[week_ending_date]) ELSE [week_ending_date] END = @WEEKENDING#(lf)AND [Referral_To_Treatment_Period_Start_Date] <= @WEEKENDING#(lf)AND [WL].[Derived_Registered_CCG] = '11M'#(lf)#(lf)#(lf)#(lf)SET NOCOUNT ON#(lf)IF OBJECT_ID ('TEMPDB..#WL_tbl') IS NOT NULL DROP TABLE #WL_tbl#(lf)#(lf)SELECT DISTINCT #(lf)[T].[Pseudo_NHS_Number],#(lf)[T].[Treatment Function],#(lf)[T].[Weeks_Waiting_Banding],#(lf)[OtherSpecialty] = COUNT(distinct [T2].[Treatment Function])#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)INTO #WL_tbl#(lf)#(lf)FROM #TEMP [T]#(lf)#(lf)LEFT JOIN #TEMP AS [T2]#(lf)ON [T2].[Pseudo_NHS_Number] = [T].[Pseudo_NHS_Number]#(lf)#(lf)group by [T].[Pseudo_NHS_Number],#(lf)[T].[Treatment Function],#(lf)[T].[Weeks_Waiting_Banding]#(lf)#(lf)#(lf)order by [T].[Pseudo_NHS_Number]#(lf)#(lf)#(lf)SET NOCOUNT ON#(lf)IF OBJECT_ID ('TEMPDB..#ED_attendances') IS NOT NULL DROP TABLE #ED_attendances#(lf)#(lf)SELECT #(lf)#(lf)NHS_Number#(lf)#(lf),[number_of_attendances] = cast(count(distinct Attendance_Unique_Identifier) as numeric)#(lf)#(lf)  INTO #ED_attendances#(lf)#(lf)  FROM [CCG_Current].[SEM].[vw_ECDS]#(lf)#(lf)  where #(lf)#(lf)  Organisation_Code_Commissioner like '%11m%'#(lf)#(lf)  and Organisation_Code_Provider like '%RTE%'#(lf)#(lf)  and Arrival_Date >= '2022-09-01'#(lf)#(lf)  group by NHS_Number#(lf)#(lf)    SET NOCOUNT ON#(lf)IF OBJECT_ID ('TEMPDB..#demographics') IS NOT NULL DROP TABLE #demographics#(lf)#(lf)  SELECT distinct#(lf)#(lf)  [w].Pseudo_NHS_Number#(lf)  ,OtherSpecialty#(lf)  ,[Number_of_ED_attendances] = case when [e].number_of_attendances is null then '0' else [number_of_attendances] END#(lf)  ,[W].[Treatment Function]#(lf)  ,[Ranking] = rank() OVER(PARTITION BY Pseudo_NHS_Number ORDER BY [Treatment Function] ASC)#(lf)  ,[M].PracNameCurrent#(lf)  ,[M].[NetworkName]#(lf)  ,[M].[AgeBand]#(lf)  ,[M].[EthnicOriginDescription]#(lf)  ,[M].[IMDcountyDecile]#(lf)  ,[M].[Core20Flag]#(lf)  ,[M].[Gender]#(lf)  ,[M].[Current District Ward name]#(lf)  ,[M].[Derived_Age]#(lf)  ,[W].[Weeks_Waiting_Banding]#(lf)#(lf)  #(lf)  --INTO #demographics#(lf)#(lf)  FROM #WL_tbl [W]#(lf)#(lf)  LEFT JOIN #ED_attendances [E] ON [E].NHS_Number = [W].Pseudo_NHS_Number#(lf)#(lf)  LEFT JOIN [BIReports].[MPI].[MPI_current] [M] ON [M].[Derived_Pseudo_NHS] = [W].Pseudo_NHS_Number#(lf)#(lf)  order by [w].Pseudo_NHS_Number#(lf)#(lf)"])
				in
