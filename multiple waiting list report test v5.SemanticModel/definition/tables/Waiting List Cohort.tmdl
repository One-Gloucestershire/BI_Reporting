	partition 'Waiting List Cohort' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "powerbi_reporting", [Query="SET ANSI_NULLS ON#(lf)SET QUOTED_IDENTIFIER ON#(lf)set nocount on#(lf)set ansi_warnings off #(lf)#(lf)IF OBJECT_ID('tempdb..#TEMP') IS NOT NULL DROP TABLE #TEMP;  #(lf)#(lf)/*=======================================================================#(lf)PARAMETERS#(lf)=======================================================================*/#(lf)#(lf)DECLARE @WEEKENDING DATETIME#(lf)SET @WEEKENDING = (SELECT DISTINCT MAX(#(lf)CASE WHEN DATENAME(DW,[week_ending_date]) = 'MONDAY' THEN DATEADD(DD,-1,[week_ending_date])#(lf)WHEN DATENAME(DW,[week_ending_date]) = 'TUESDAY' THEN DATEADD(DD,-2,[week_ending_date])  #(lf)WHEN DATENAME(DW,[week_ending_date]) = 'WEDNESDAY' THEN DATEADD(DD,-3,[week_ending_date]) #(lf)WHEN  DATENAME(DW,[week_ending_date]) = 'THURSDAY' THEN DATEADD(DD,-4,[week_ending_date])#(lf)WHEN DATENAME(DW,[week_ending_date]) = 'FRIDAY' THEN DATEADD(DD,-5,[week_ending_date])#(lf)WHEN DATENAME(DW,[week_ending_date]) = 'SATURDAY' THEN DATEADD(DD,-6,[week_ending_date])ELSE [week_ending_date] END)#(lf)#(lf)FROM [Data_Mart_COVID19].[dbo].[National_Wait_List_Open_Pathways] where week_ending_date <= GETDATE())#(lf)#(lf)DECLARE @WEEKENDING1 DATETIME#(lf)SET @WEEKENDING1 = (SELECT DISTINCT MAX(#(lf)CASE WHEN DATENAME(DW,[week_ending_date]) = 'MONDAY' THEN DATEADD(DD,-1,[week_ending_date])#(lf)WHEN DATENAME(DW,[week_ending_date]) = 'TUESDAY' THEN DATEADD(DD,-2,[week_ending_date])  #(lf)WHEN DATENAME(DW,[week_ending_date]) = 'WEDNESDAY' THEN DATEADD(DD,-3,[week_ending_date]) #(lf)WHEN  DATENAME(DW,[week_ending_date]) = 'THURSDAY' THEN DATEADD(DD,-4,[week_ending_date])#(lf)WHEN DATENAME(DW,[week_ending_date]) = 'FRIDAY' THEN DATEADD(DD,-5,[week_ending_date])#(lf)WHEN DATENAME(DW,[week_ending_date]) = 'SATURDAY' THEN DATEADD(DD,-6,[week_ending_date])ELSE [week_ending_date] END)#(lf)FROM [Data_Mart_COVID19].[dbo].[National_Wait_List_Open_Pathways] where week_ending_date <= '31-MAR-2022')#(lf)/*=======================================================================#(lf)CURRENT WAIT LIST#(lf)=======================================================================*/#(lf)#(lf)SELECT #(lf)[COUNT] = 1,#(lf)[Date_And_Time_Data_Set_Created],#(lf)[Week_Ending_Date],#(lf)[Days] = DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING),#(lf)[Weeks] = DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING) / 7.0,#(lf)[Weeks_Waiting_Banding] = CASE WHEN DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING) BETWEEN 0   AND 126 THEN '0 < 18 Weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING) BETWEEN 127 AND 182 THEN '18 < 26 Weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING) BETWEEN 183 AND 280 THEN '26 < 40 Weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING) BETWEEN 281 AND 364 THEN '40 <  52 Weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING) BETWEEN 365 AND 546 THEN '52 < 78 Weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING) BETWEEN 547 AND 728 THEN '78 < 104 Weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN DATEDIFF(dd, [Referral_To_Treatment_Period_Start_Date], @WEEKENDING) > 729               THEN '104+ Weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   ELSE 'NULL' END,#(lf)[Pseudo_NHS_Number],#(lf)[WL].[Organisation_Identifier_Code_Of_Provider],#(lf)[Organisation_Site_Identifier_Of_Treatment],#(lf)[Activity_Treatment_Function_Code],#(lf)[Treatment Function] =[TF].[TreatmentFunctionDescription],#(lf)[Referral_To_Treatment_Period_Start_Date],#(lf)[Organisation_Identifier_Code_Of_Commissioner],#(lf)[WL].[Derived_Registered_CCG],#(lf)[Derived_GP_Registered_Practice_Code],#(lf)[Waiting_List_Type] = CASE WHEN [Waiting_List_Type] = 'IRTT' then 'Admitted PTL'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN [Waiting_List_Type] = 'ORTT' then 'Non-Admitted PTL' ELSE 'Other' END,#(lf)#(lf)[AgeBand] = CASE WHEN CAST([Derived_Age_At_Activity] AS INT) <18 THEN 'Children and Young People (0-17)'#(lf)#(tab)#(tab)#(tab)#(tab) WHEN CAST([Derived_Age_At_Activity] AS INT) BETWEEN 18 AND 64 THEN 'Working Age Adults (18-64)' #(lf)#(tab)#(tab)#(tab)#(tab) WHEN CAST([Derived_Age_At_Activity] AS INT) >64 THEN 'Older Adults (65+)' ELSE 'Unknown' END, #(lf)[Derived_LSOA],#(lf)#(lf)#(lf)[WaitingList] = 'Current'#(lf)INTO #TEMP#(lf)FROM [Data_Mart_COVID19].[dbo].[National_Wait_List_Open_Pathways] [WL]#(lf)#(lf)#(tab)LEFT JOIN [CCG_Reference].[Reference].[vw_TreatmentFunction] [TF] #(lf)#(tab)ON WL.[Activity_Treatment_Function_Code] = [TF].[TreatmentFunctionCode]#(lf)#(tab)#(tab)#(tab)#(tab)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(lf)WHERE [Referral_To_Treatment_Period_End_Date] IS NULL#(lf)AND [Referral_To_Treatment_Period_Start_Date] IS NOT NULL#(lf)AND CASE WHEN DATENAME(DW,[week_ending_date]) = 'MONDAY'    THEN DATEADD(DD,-1,[week_ending_date])#(lf)#(tab)#(tab) WHEN DATENAME(DW,[week_ending_date]) = 'TUESDAY'   THEN DATEADD(DD,-2,[week_ending_date])  #(lf)#(tab)#(tab) WHEN DATENAME(DW,[week_ending_date]) = 'WEDNESDAY' THEN DATEADD(DD,-3,[week_ending_date]) #(lf)#(tab)#(tab) WHEN DATENAME(DW,[week_ending_date]) = 'THURSDAY'  THEN DATEADD(DD,-4,[week_ending_date])#(lf)#(tab)#(tab) WHEN DATENAME(DW,[week_ending_date]) = 'FRIDAY'    THEN DATEADD(DD,-5,[week_ending_date])#(lf)#(tab)#(tab) WHEN DATENAME(DW,[week_ending_date]) = 'SATURDAY'  THEN DATEADD(DD,-6,[week_ending_date]) ELSE [week_ending_date] END = @WEEKENDING#(lf)AND [Referral_To_Treatment_Period_Start_Date] <= @WEEKENDING#(lf)AND [WL].[Derived_Registered_CCG] = '11M'#(lf)#(lf)#(lf)#(lf)SET NOCOUNT ON#(lf)IF OBJECT_ID ('TEMPDB..#WL_tbl') IS NOT NULL DROP TABLE #WL_tbl#(lf)#(lf)SELECT DISTINCT #(lf)[T].[Pseudo_NHS_Number]#(lf)#(lf)INTO #WL_tbl#(lf)#(lf)FROM #TEMP [T]#(lf)#(lf)order by [T].[Pseudo_NHS_Number]#(lf)#(lf)#(lf)SET NOCOUNT ON#(lf)IF OBJECT_ID ('TEMPDB..#number_waiting_lists') IS NOT NULL DROP TABLE #number_waiting_lists#(lf)#(lf)#(lf)SELECT DISTINCT #(lf)[T].[Pseudo_NHS_Number],#(lf)[T].[Treatment Function],#(lf)[T].[Weeks_Waiting_Banding],#(lf)[number_of_waiting_lists] = COUNT(distinct [T2].[Treatment Function])#(lf)#(lf)#(lf)INTO #number_waiting_lists#(lf)#(lf)FROM #TEMP [T]#(lf)#(lf)LEFT JOIN #TEMP AS [T2]#(lf)ON [T2].[Pseudo_NHS_Number] = [T].[Pseudo_NHS_Number]#(lf)#(lf)group by [T].[Pseudo_NHS_Number],#(lf)[T].[Treatment Function],#(lf)[T].[Weeks_Waiting_Banding]#(lf)#(lf)#(lf)order by [T].[Pseudo_NHS_Number]#(lf)#(lf)#(lf)#(lf)#(lf)/****** Script for SelectTopNRows command from SSMS  ******/#(lf)SET NOCOUNT ON#(lf)IF OBJECT_ID ('TEMPDB..#ED_attendances') IS NOT NULL DROP TABLE #ED_attendances#(lf)#(lf)SELECT #(lf)#(tab)[Number_of_ED_attendances] = sum(1),#(lf)#(tab)nhs_number#(lf)#(tab)#(lf)  INTO #ED_attendances#(lf)#(lf)  FROM [PowerBI_Reporting].[dbo].[ECDS_ED_Attendances]#(lf)#(lf)  where Arrival_Date >= EOMONTH(DATEADD(MONTH, -13, GETDATE()))#(lf)#(lf)  and provider_code like 'RTE'#(lf)#(lf)  GROUP BY nhs_number#(lf)#(lf)  ------------------#(lf)  --PC Appointments#(lf)  ------------------#(lf)#(lf)  IF OBJECT_ID ('TEMPDB..#PC_attendances') IS NOT NULL DROP TABLE #PC_attendances#(lf)#(lf)SELECT #(lf)#(lf)[Pseudo_NHS_Number]#(lf)#(lf),[number_of_PC_appointments] = sum(1)#(lf)#(lf)  INTO #PC_attendances#(lf)#(lf)  FROM [CCG_Current].[PrimaryCare].[vw_Appointments]#(lf)#(lf)  where #(lf)#(lf)#(tab)Appointment_Date >= EOMONTH(DATEADD(MONTH, -13, GETDATE()))#(lf)#(lf)  group by [Pseudo_NHS_Number]#(lf)#(lf)  ------------------#(lf)  --111 Calls#(lf)  ------------------#(lf)#(lf)    #(tab)SET NOCOUNT ON#(lf)#(tab)IF OBJECT_ID ('TEMPDB..#one') IS NOT NULL DROP TABLE #one#(lf)#(lf)#(tab)SELECT#(lf)#(tab)[Pseudo