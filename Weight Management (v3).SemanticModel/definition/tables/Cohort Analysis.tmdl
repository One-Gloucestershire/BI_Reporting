	column 'Year BMI' = year('Cohort Analysis'[BMI Group Date])
		formatString: 0
		lineageTag: 1b7a7de4-17ab-4535-8acc-ec16fcd13bb6
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition 'Cohort Analysis' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "bireports", [Query="SELECT distinct 1 as [counter],#(lf)#(tab)[Derived_Pseudo_NHS],#(lf)#(tab)[Gender] = CASE WHEN [Gender] = 'F' then 'Female' WHEN [Gender] = 'M' then 'Male' else NULL end#(lf),#(lf)     [Derived_Age],#(lf)     [AgeBand5yr],#(lf)     [AgeBand10yr],#(lf)     [AgeBand],#(lf)     [EthnicOriginDescription],#(lf)     [EthnicOriginWiderGroups],#(lf)     [PracNameCurrent],#(lf)     [LSOA code],#(lf)     [Current District Ward code 2021],#(lf)     [Current District Ward name 2021],#(lf)     [District],#(lf)     [IMDcountyDecile],#(lf)     [IMDcountyQuintile],#(lf)     [LocalityName],#(lf)     [NetworkName],#(lf)     [EDTotal],#(lf)     [EDCost],#(lf)     [EDonlyAETotal],#(lf)     [EDonlyAECost],#(lf)     [EDonlyMIUTotal],#(lf)     [EDonlyMIUCost],#(lf)     [ElectiveAdmTotal],#(lf)     [ElectiveBedDaysTotal],#(lf)     [ElectiveAdmTotalCost],#(lf)     [AdmTotalBedDays],#(lf)     [AdmAvgLOS],#(lf)     [EmergencyAdmTotal],#(lf)     [EmergencyBedDaysTotal],#(lf)     [EmergencyAdmTotalCost],#(lf)     [AdmTotal],#(lf)     [AdmTotalCost],#(lf)     [OPAttFirstTotal],#(lf)     [OPAttFUTotal],#(lf)     [OPProcTotal],#(lf)     [OPTotal],#(lf)     [OPTotalCost],#(lf)     [GPapptTotal],#(lf)     [GPapptTotalEstCost],#(lf)     [CCTotal],#(lf)     [CommAdsTotal],#(lf)     [MHAdmissionTotal],#(lf)     [MHContactTotal],#(lf)     [MHContactEmergencyAndComplex],#(lf)     [MHContactManagementAndSpecialist],#(lf)     [MHContactPreventativeAndStandard],#(lf)     [111Total],#(lf)     [eFI_Score_derived],#(lf)     [eFI_Catgory_derived],#(lf)     [LTCCountDerived],#(lf)     [ObesityDerived],#(lf)     [SmokerDerived],#(lf)     [AsthmaDerived],#(lf)     [COPDDerived],#(lf)     [DementiaDerived],#(lf)     [DepressionDerived],#(lf)     [DiabetesDerived],#(lf)     [PalliativeCareDerived],#(lf)     [ChronicKidneyDiseaseDerived],#(lf)     [EpilepsyDerived],#(lf)     [HeartFailureDerived],#(lf)     [StrokeDerived],#(lf)     [AtrialFibrillationDerived],#(lf)     [CancerDerived],#(lf)     [CoronaryHeartDiseaseDerived],#(lf)     [HypertensionDerived],#(lf)     [HypothyroidismDerived],#(lf)     [LearningDisabilityDerived],#(lf)     [MentalIllnessDerived],#(lf)#(tab) [bmi].*,#(lf)round([BMI].[BMI],0) as [BMI Rounded],#(lf)#(lf)case when (EthnicOriginDescription not like 'white' or EthnicOriginDescription != null) and ([BMI].[BMI] BETWEEN 23 AND 27.4999999999) THEN 'Overweight (25 - 30)'#(lf)#(tab)  when (EthnicOriginDescription not like 'white' or EthnicOriginDescription != null) and ([BMI].[BMI] >= 27.5) THEN 'Obese (30+)'#(lf)when [BMI].[BMI] >= 30 then 'Obese (30+)'#(lf)#(tab)  when [BMI Group] is null then 'Not Recorded'#(lf)#(tab)  else [BMI Group] END AS [BMI Group Adjusted],#(lf)#(lf)case when (EthnicOriginDescription not like 'white' or EthnicOriginDescription != null) and ([BMI].[BMI] BETWEEN 27.5 AND 32.49999999) THEN 1#(lf)#(tab)  when (EthnicOriginDescription like 'white%' or EthnicOriginDescription is null) and ([BMI].[BMI] BETWEEN 30 AND 34.99999999) THEN 1#(lf)#(tab)  else 0 end as [Obesity Class 1 - adjusted],#(lf)#(lf)case when (EthnicOriginDescription not like 'white' or EthnicOriginDescription != null) and ([BMI].[BMI] BETWEEN 32.5 AND 37.49999999) THEN 1#(lf)#(tab)  when (EthnicOriginDescription like 'white%' or EthnicOriginDescription is null) and ([BMI].[BMI] BETWEEN 35 AND 39.99999999) THEN 1#(lf)#(tab)  else 0 end as [Obesity Class 2 - adjusted],#(lf)#(lf)case when (EthnicOriginDescription not like 'white' or EthnicOriginDescription != null) and ([BMI].[BMI] >= 37.5) THEN 1#(lf)#(tab)  when (EthnicOriginDescription like 'white%' or EthnicOriginDescription is null) and ([BMI].[BMI] >= 40) THEN 1#(lf)#(tab)  else 0 end as [Obesity Class 3 - adjusted],#(lf)#(lf)#(tab)  case #(lf)#(tab)  when (EthnicOriginDescription not like 'white' or EthnicOriginDescription != null) and ([BMI].[BMI] BETWEEN 27.5 AND 32.49999999) THEN 'Obesity Class I'#(lf)#(tab)  when (EthnicOriginDescription like 'white%' or EthnicOriginDescription is null) and ([BMI].[BMI] BETWEEN 30 AND 34.99999999) THEN  'Obesity Class I'#(lf)#(tab) when (EthnicOriginDescription not like 'white' or EthnicOriginDescription != null) and ([BMI].[BMI] BETWEEN 32.5 AND 37.49999999) THEN  'Obesity Class II'#(lf)#(tab)  when (EthnicOriginDescription like 'white%' or EthnicOriginDescription is null) and ([BMI].[BMI] BETWEEN 35 AND 39.99999999) THEN 'Obesity Class II'#(lf)#(tab)  when (EthnicOriginDescription not like 'white' or EthnicOriginDescription != null) and ([BMI].[BMI] >= 37.5) THEN 'Obesity Class III'#(lf)#(tab)  when (EthnicOriginDescription like 'white%' or EthnicOriginDescription is null) and ([BMI].[BMI] >= 40) THEN 'Obesity Class III'#(lf)#(tab)  else NULL end as [Obesity Class - adjusted]#(lf)#(lf)#(lf)  FROM [BIReports].[mpi].[MPI_current] [a]#(lf)  LEFT JOIN [BIReports].[mpi].[BMI_Table] [BMI] on [a].Derived_Pseudo_NHS = [BMI].PseudoNHSNumber#(lf)  where [ccg_of_registration] = '11M' and cast(derived_age as int) >= 16#(lf)  order by EthnicOriginDescription, [BMI].[BMI]"]),
				    #"Replaced Value" = Table.ReplaceValue(Source,null,"Unknown",Replacer.ReplaceValue,{"Gender"}),
				    #"Replaced Value1" = Table.ReplaceValue(#"Replaced Value",null,"Unknown",Replacer.ReplaceValue,{"EthnicOriginDescription"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Replaced Value1",{{"IMDcountyDecile", type text}}),
				    #"Replaced Value2" = Table.ReplaceValue(#"Changed Type",null,"Out of County",Replacer.ReplaceValue,{"IMDcountyDecile"})
				in
				    #"Replaced Value2"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

