table 'Cohort Analysis'
	lineageTag: 448fb546-6c8b-452c-8997-9531deaf76d8

	measure 'Rate per 1,000 (CA)' = DIVIDE(sum('Cohort Analysis'[counter]),sum('population'[counter])) * 1000
		displayFolder: Measures for Graphs
		lineageTag: 7136b610-26e3-46a2-ba46-158b73a97182

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ICB_Data = calculate(sum('Cohort Analysis'[counter]),ALL('Cohort Analysis'[Obesity Class - adjusted],'Cohort Analysis'[BMI Group Adjusted]))/calculate(sum('Cohort Analysis'[counter]),ALL())
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Measures for Graphs
		lineageTag: 8d189cb2-8780-4049-8d12-332c7ccaa6d4

	measure Missing_BMI_% = calculate(sum('Cohort Analysis'[counter]),'Cohort Analysis'[BMI Group Adjusted] = "Not Recorded")/calculate(sum('Cohort Analysis'[counter]))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Measures for Graphs
		lineageTag: 5b8f21ab-7c3c-4ad2-b209-a5244fa9de63

	measure Counter_Excl_NR_% =
			
			calculate(sum('Cohort Analysis'[counter]),'Cohort Analysis'[BMI Group Adjusted]<>"Not Recorded")/
			calculate(sum('Cohort Analysis'[counter]),ALL('R. BMI Group Ref'),'Cohort Analysis'[BMI Group Adjusted]<>"Not Recorded")
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Measures for Graphs
		lineageTag: a1fd3711-1ee4-42d0-b516-ee342281343c

	measure BMI_Rounded_Measure = calculate(sum('Cohort Analysis'[BMI Rounded]))
		displayFolder: Measures for Graphs
		lineageTag: cdcac900-f7a9-4a46-91eb-5be9930669b8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Counter_Ethnicity_% =
			
			sum('Cohort Analysis'[counter])/
			calculate(sum('Cohort Analysis'[counter]),ALL('Ref - Ethnicity'))
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Measures for Graphs
		lineageTag: 12ddebe9-708a-4917-a7ea-e3cd569ad814

	measure ICB_Ethnicity = ```
			
			CALCULATE(sum('Cohort Analysis'[counter]),ALL('R. BMI Group Ref'))/
			calculate(sum('Cohort Analysis'[counter]),ALL('Ref - Ethnicity'),ALL('R. BMI Group Ref'))
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Measures for Graphs
		lineageTag: 983912ab-4524-4a0a-905e-541ce02b5067

	measure Counter_Locality_% =
			
			sum('Cohort Analysis'[counter])/
			calculate(sum('Cohort Analysis'[counter]),ALL('Ref - GP'))
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Measures for Graphs
		lineageTag: b98aa693-ac65-4297-acd0-2fe9f0f5ff5e

	measure ICB_Locality = ```
			
			CALCULATE(sum('Cohort Analysis'[counter]),ALL('R. BMI Group Ref'))/
			calculate(sum('Cohort Analysis'[counter]),ALL('Ref - GP'),ALL('R. BMI Group Ref'))
			
			```
		displayFolder: Measures for Graphs
		lineageTag: 7314eb92-789a-482d-ab27-0c885c459f2e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Counter_Sex_% =
			
			sum('Cohort Analysis'[counter])/
			calculate(sum('Cohort Analysis'[counter]),ALL('Ref - Gender'))
		displayFolder: Measures for Graphs
		lineageTag: 407c0219-2dd6-40a9-90c9-c616bc5371b5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ICB_Sex = ```
			
			CALCULATE(sum('Cohort Analysis'[counter]),ALL('R. BMI Group Ref'))/
			calculate(sum('Cohort Analysis'[counter]),ALL('Ref - Gender'),ALL('R. BMI Group Ref'))
			
			```
		displayFolder: Measures for Graphs
		lineageTag: a7924abb-4922-40f8-ba78-4408ecee1c17

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Counter_Age_% =
			
			sum('Cohort Analysis'[counter])/
			calculate(sum('Cohort Analysis'[counter]),ALL('Ref - Age'))
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Measures for Graphs
		lineageTag: 4d0456ef-223d-476a-aff2-2f57f9ae0169

	measure ICB_Age =
			
			CALCULATE(sum('Cohort Analysis'[counter]),ALL('R. BMI Group Ref'))/
			calculate(sum('Cohort Analysis'[counter]),ALL('Ref - Age'),ALL('R. BMI Group Ref'))
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Measures for Graphs
		lineageTag: 15335b42-52c8-4918-ba18-784f8667a58f

	measure Counter_Supressed = if(CALCULATE(sum('Cohort Analysis'[counter]))<5,0,CALCULATE(sum('Cohort Analysis'[counter])))
		formatString: 0
		displayFolder: Measures for Graphs
		lineageTag: e73fb186-d2ec-4a01-983d-13880b2128f3

	measure BMI_Within_5_Yr_% =
			
			VAR MaximumYear = YEAR(CALCULATE(MAX('Date Table (all dates)'[date]))) --2025
			RETURN
			
			CALCULATE(SUM('Cohort Analysis'[counter])
			,MaximumYear-YEAR('Cohort Analysis'[BMI Group Date])<5
			        )/calculate(sum('Cohort Analysis'[counter]),all())
		formatString: #,0%;-#,0%;#,0%
		displayFolder: Measures for Graphs
		lineageTag: 4e3859f7-f67e-4078-a3c2-ddc005627fae

	measure LSOA_Rate_Per_1000 = ```
			
			VAR Numerator = sum('Cohort Analysis'[counter])
			VAR Denominator = CALCULATE(sum('Cohort Analysis'[counter]),ALL(Population))
			
			RETURN 
			(Numerator/Denominator)*1000
			```
		displayFolder: Measures for Graphs
		lineageTag: 181e9aa3-2222-4b62-b11a-f32a8535459e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ICB_Deprivation = ```
			
			CALCULATE(sum('Cohort Analysis'[counter]),ALL('R. BMI Group Ref'))/
			calculate(sum('Cohort Analysis'[counter]),ALL('Ref - IMD'),ALL('R. BMI Group Ref'))
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Measures for Graphs
		lineageTag: 39df3a30-71b7-4868-8fed-91a47ffbdc4a

	measure Counter_Deprivation_% =
			
			sum('Cohort Analysis'[counter])/
			calculate(sum('Cohort Analysis'[counter]),ALL('Ref - IMD'))
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Measures for Graphs
		lineageTag: 02b3ad08-2352-4a0f-b039-4645a4143bf3

	measure BMI_Group_% = calculate(sum('Cohort Analysis'[counter]))/calculate(sum('Cohort Analysis'[counter]),all())
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c3008dac-44e3-484c-b73c-8307846bf2af

	measure Missing_BMI_No = calculate(sum('Cohort Analysis'[counter]),'Cohort Analysis'[BMI Group Adjusted] = "Not Recorded")
		formatString: #,0
		displayFolder: Measures for Graphs
		lineageTag: ac95f815-7f89-4e45-aa16-9f7cda8af597

	measure BMI_Group_No = calculate(sum('Cohort Analysis'[counter]))
		formatString: 0
		lineageTag: 4afdd325-42ff-47ed-a68e-bbe30e095eaa

	measure BMI_Within_5_Yr =
			
			VAR MaximumYear = YEAR(CALCULATE(MAX('Date Table (all dates)'[date]))) --2025
			RETURN
			
			CALCULATE(SUM('Cohort Analysis'[counter])
			,MaximumYear-YEAR('Cohort Analysis'[BMI Group Date])<5)
		formatString: #,0
		displayFolder: Measures for Graphs
		lineageTag: dea186c6-ab6f-4f02-8b7c-e1861cb8a9b1

