	partition 'Tier 3/4' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "ccg_current", [Query="SELECT#(lf)[Start Date] = StartDate_HospitalProviderSpell,#(lf)[End Date] = DischargeDate_FromHospitalProviderSpell,#(lf)[NHS Number] = Derived_Pseudo_NHS,#(lf)[Counter] = '1',#(lf)[Provider Code] = left(OrganisationCode_CodeOfProvider,3),#(lf)OrganisationName_NameOfProvider,#(lf)[Sector Flag] = case when OrganisationCode_CodeOfProvider like 'RTE%' then 'GHFT'#(lf)when OrganisationCode_CodeOfProvider like 'R%' then 'NHS Provider'#(lf)else 'Independent Sector Provider' end,#(lf)[TFC] = treatmentfunctioncode,#(lf)[Procedure Type] = case #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when PrimaryProcedure_OPCS in ('G281', 'G282', 'G283', 'G284', 'G285', 'G301', 'G302', 'G303', 'G304', 'G312', 'G321', 'G331', 'G716') then 'Primary Procedure'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when PrimaryProcedure_OPCS in ('G305', 'G315', 'G316', 'G322', 'G323', 'G324', 'G325', 'G332', 'G387', 'G717') then 'Revision Procedure'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when PrimaryProcedure_OPCS in ('G481', 'G485') then 'Gastric Bubble/Balloon'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)end,#(lf)[Procedure Description] = PrimaryProcedure_OPCS_Description,#(lf)[Attendance Flag] = NULL,#(lf)[Unique Patients] = row_number() over(partition by Derived_Pseudo_NHS order by StartDate_HospitalProviderSpell asc),#(lf)[Unique Patients (Per FY)] = row_number() over(partition by Derived_Pseudo_NHS, financialyear order by StartDate_HospitalProviderSpell asc),#(lf)[Unique Patients (Activity Type)] = row_number() over(partition by Derived_Pseudo_NHS, PrimaryProcedure_OPCS order by StartDate_HospitalProviderSpell asc),#(lf)[GP Practice] = PracticeCodeOfRegisteredGP,#(lf)[Locality] = CASE #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [E].[Locality] is null THEN 'Out of County'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when [e].Locality like '%cotswold%' then 'Cotswolds'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ELSE [E].[Locality] END,#(lf)[PrimaryCareNetwork] = CASE WHEN [E].[PrimaryCareNetwork] is null THEN 'Out of County'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ELSE [E].[PrimaryCareNetwork] END,#(lf)[Age at Event] = AgeatCDSActivityDate,#(lf)[Activity Type] = 'Tier 4 Weight Management',#(lf)[YTD] = case #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when cast(financialmonth as int) <= (select max(cast(financialmonth as int)) from ccg_reference.reference.vw_DateLookup [dat]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)inner join (select max(StartDate_HospitalProviderSpell) as [AptDate] from ccg_current.[SEM].[vw_HospitalProviderSpell]) [SEM] on [dat].[date] = [SEM].[AptDate])#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)then 1 else 0#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)end,#(lf)[Previous Year Flag] = case #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when left(financialyear,4)+right(financialyear,2) = (#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)select left(max(financialyear),4)+ right(max(financialyear),2)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)from ccg_reference.reference.vw_DateLookup [dat]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)inner join (select max(StartDate_HospitalProviderSpell) as [AptDate] from ccg_current.[SEM].[vw_HospitalProviderSpell]) [SEM] on [dat].[date] = [SEM].[AptDate]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)) #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)-101 --taking back to previous year#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)then 1 else 0#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(t