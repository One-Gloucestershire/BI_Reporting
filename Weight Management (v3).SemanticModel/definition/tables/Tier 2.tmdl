table 'Tier 2'
	lineageTag: b24ef8d3-5907-4e93-9dfa-1eb750bdd7ce

	measure Achieving_WL =
			
			CALCULATE(SUM('Tier 2'[Value]),'Tier 2'[Value Definition]="No. Losing 3%+",'Tier 2'[Additional Split] = "Sex")/
			CALCULATE(SUM('Tier 2'[Value]),'Tier 2'[Value Definition]="Pathways Finished",'Tier 2'[Additional Split] = "Sex")
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b5ec325b-79d2-4b17-9b37-d4327ad26cbb

	column Provider
		dataType: string
		lineageTag: 78dd2307-7759-4d2e-841c-1b588887e510
		summarizeBy: none
		sourceColumn: Provider

		annotation SummarizationSetBy = Automatic

	column Date
		dataType: dateTime
		formatString: Long Date
		lineageTag: 7cd2ac07-b061-4da0-b108-f8a751be1bd5
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

