		annotation UnderlyingDateTimeDataType = Date

	partition 'Date Table (First Day of Month)' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db01_reference"), "select * from ( select dc.*, case when current_date < dateadd(day,7,dc.""WeekEnd"") then 1 else 0 end as ""week_checker"", getdate() as ""Todays Date"" from ( SELECT DISTINCT cast(d.full_date as date) as ""date"" ,to_char(d.full_date,'DD/MM/YYYY') as ""daymonthyear"" ,d.day_of_fin_year as ""day"" ,d.weekday_no as ""weekday"" ,d.weekday_name as ""weekday_name"" ,d.month_no as ""month"" ,d.month_short_name as ""MonthName"" ,d.cal_quarter_no as ""quarter"" ,d.year_month as ""yearmonth"" ,case when d.weekday_no in (6,7) then 1 else 0 end as ""isweekend"" ,case when d.bank_holiday_desc is not null then 1 else 0 end as ""isholiday"" ,d.bank_holiday_desc as ""holidaydescription"" ,d.working_day_calc as ""isworkingday"" ,d.fin_week_no as ""financialweekofyear"" ,replace(d.fin_year_yyyy_dash_yy,' - ','/') as ""FinancialYear"" ,d.fin_quarter_no as ""financialquarter"" ,d.day_of_quarter as ""dayofquarter"" ,extract(day from cast(d.full_date as date)) as ""Day_Of_Month"" ,d.fin_week_no as ""Fin_Week_No"" ,dateadd(day, case ((extract(dow from cast(d.full_date as date))+6)%7)+1 when 1 then -4 when 2 then -5 when 3 then -6 when 4 then 0 when 5 then -1 when 6 then -2 when 7 then -3 end, cast(d.full_date as date)) as ""WeekStart"" ,dateadd(day, case ((extract(dow from cast(d.full_date as date))+6)%7)+1 when 1 then -4+6 when 2 then -5+6 when 3 then -6+6 when 4 then 0+6 when 5 then -1+6 when 6 then -2+6 when 7 then -3+6 end, cast(d.full_date as date)) as ""WeekEnd"" ,cast(d.quarter_start as date) as ""quarter_start_date"" ,cast(d.quarter_start as date) as ""quarter_end_date"" ,d.month_day_no as ""month_day_no"" ,d.fin_month_no as ""financialmonth"" ,concat(concat(d.month_short_name,'-'),left(d.date_112,4)) as ""monthyearname"" ,d.monthyear_mmmm_yyyyy as ""monthyear"" ,case when d.fin_month_no <= (select cast(fin_month_no as int) from dscro_national_lookups.ref_dates where full_date = last_day(add_months(current_date,-1))) then 1 else 0 end as ""ytdflag"" ,case when d.year_month in (select max(year_month) from dscro_national_lookups.ref_dates where full_date between '2019-04-01' and last_day(add_months(current_date,-1))) then 1 else 0 end as ""latest_month_flag"" ,case when d.year_month in (select max(year_month) from dscro_national_lookups.ref_dates where full_date between '2019-04-01' and last_day(add_months(current_date,-2))) then 1 else 0 end as ""previous_month_flag"" ,case when d.year_month in (select year_month from dscro_national_lookups.ref_dates where full_date between last_day(add_months(current_date,-12)) and last_day(add_months(current_date,-1))) then 1 else 0 end as ""latest_12_months_flag"" ,case when d.year_month in (select year_month from dscro_national_lookups.ref_dates where full_date between last_day(add_months(current_date,-24)) and last_day(add_months(current_date,-13))) then 1 else 0 end as ""previous_12_months_flag"" ,case when d.year_month in (select max(year_month) from dscro_national_lookups.ref_dates where full_date between '2019-04-01' and last_day(add_months(current_date,-13))) then 1 else 0 end as ""same_month_last_year_flag"" ,case when d.week_start_112 = (select max(previous_week_start_112) from dscro_national_lookups.ref_dates a where cast(a.full_date as date) = current_date) then 1 else 0 end as ""last_week"" ,case when d.week_start_112 = (select max(previous_week_start_112) from dscro_national_lookups.ref_dates a where cast(a.full_date as date) = dateadd(day,-7,current_date)) then 1 else 0 end as ""last_week_minus_7"" ,case when d.week_start_112 = (select max(previous_week_start_112) from dscro_national_lookups.ref_dates a where cast(a.full_date as date) = current_date) then 1 when d.week_start_112 = (select max(previous_week_start_112) from dscro_national_lookups.ref_dates a where cast(a.full_date as date) = dateadd(day,-7,current_date)) then 1 else 0 end as ""last_2_weeks"" FROM dscro_national_lookups.ref_dates d ) dc ) z where z.""date"" >= '2019-04-01' and z.""Day_Of_Month"" = 1 and z.""date"" <= '2026-03-31' order by z.""date"" desc", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

