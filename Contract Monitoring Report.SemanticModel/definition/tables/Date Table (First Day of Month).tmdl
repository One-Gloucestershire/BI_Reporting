	partition 'Date Table (First Day of Month)' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "DSCRO_NATIONAL_LOOKUPS", [Query="/*===============================================================================================================#(lf)New Date Reference Script#(lf)Created by: Ben Adams#(lf)Created Date: 27/12/2023#(lf)===============================================================================================================*/#(lf)#(lf)with date_cte as#(lf)(#(lf)SELECT DISTINCT [date] = CAST([Full_Date] AS DATE)#(lf)               ,[daymonthyear] = CONVERT(VARCHAR, [Full_Date], 103) --> 103 converts to DD/MM/YYYY format#(lf)#(tab)#(tab)#(tab)   ,[day] = [Day_Of_Fin_Year]#(lf)#(tab)#(tab)#(tab)   ,[weekday] = [Weekday_No]#(lf)#(tab)#(tab)#(tab)   ,[weekday_name] = [Weekday_Name]#(lf)#(tab)#(tab)#(tab)   ,[month] = [Month_No]#(lf)#(tab)#(tab)#(tab)   ,[MonthName] = [Month_Short_Name]#(lf)#(tab)#(tab)#(tab)   ,[quarter] = [Cal_Quarter_No]#(lf)#(tab)#(tab)#(tab)   ,[yearmonth] = [Year_Month]#(lf)#(tab)#(tab)#(tab)   ,[isweekend] = CASE WHEN [Weekday_No] IN (6,7) THEN 1 ELSE 0 END#(lf)#(tab)#(tab)#(tab)   ,[isholiday] = CASE WHEN [Bank_Holiday_Desc] IS NOT NULL THEN 1 ELSE 0 END#(lf)#(tab)#(tab)#(tab)   ,[holidaydescription] = [Bank_Holiday_Desc] --> Description of holiday type i.e., 'Bank Holiday'#(lf)#(tab)#(tab)#(tab)   ,[isworkingday] = [Working_Day_Calc]#(lf)#(tab)#(tab)#(tab)   ,[financialweekofyear] = [Fin_Week_No]#(lf)#(tab)#(tab)#(tab)   ,[FinancialYear] = REPLACE([Fin_Year_YYYY_dash_YY], ' - ', '/')#(lf)#(tab)#(tab)#(tab)   ,[financialquarter] = [Fin_Quarter_No]#(lf)#(tab)#(tab)#(tab)   ,[dayofquarter] = [Day_Of_Quarter]#(lf)#(tab)#(tab)#(tab)   ,day([Full_Date]) as [Day_Of_Month]#(lf)#(tab)#(tab)#(tab)   ,Fin_Week_No#(lf)#(tab)#(tab)#(tab) #(lf)#(tab)#(tab)#(tab)   ,[WeekStart] =    ---adjusted for Thursday #(lf)  DATEADD(DAY, #(lf)        CASE #(lf)            WHEN DATEPART(WEEKDAY, CAST([Full_Date] AS DATE)) = 1 THEN -4  #(lf)            WHEN DATEPART(WEEKDAY, CAST([Full_Date] AS DATE)) = 2 THEN -5  #(lf)            WHEN DATEPART(WEEKDAY, CAST([Full_Date] AS DATE)) = 3 THEN -6  #(lf)            WHEN DATEPART(WEEKDAY, CAST([Full_Date] AS DATE)) = 4 THEN 0  #(lf)            WHEN DATEPART(WEEKDAY, CAST([Full_Date] AS DATE)) = 5 THEN -1  #(lf)            WHEN DATEPART(WEEKDAY, CAST([Full_Date] AS DATE)) = 6 THEN -2  #(lf)            WHEN DATEPART(WEEKDAY, CAST([Full_Date] AS DATE)) = 7 THEN -3  #(lf)        END, #(lf)        CAST([Full_Date] AS DATE))#(lf)#(lf),[WeekEnd] = #(lf)#(tab)#(tab)   DATEADD(DAY, #(lf)        CASE #(lf)            WHEN DATEPART(WEEKDAY, CAST([Full_Date] AS DATE)) = 1 THEN -4 + 6  #(lf)            WHEN DATEPART(WEEKDAY, CAST([Full_Date] AS DATE)) = 2 THEN -5 + 6  #(lf)            WHEN DATEPART(WEEKDAY, CAST([Full_Date] AS DATE)) = 3 THEN -6 + 6  #(lf)            WHEN DATEPART(WEEKDAY, CAST([Full_Date] AS DATE)) = 4 THEN 0 + 6  #(lf)            WHEN DATEPART(WEEKDAY, CAST([Full_Date] AS DATE)) = 5 THEN -1 + 6  #(lf)            WHEN DATEPART(WEEKDAY, CAST([Full_Date] AS DATE)) = 6 THEN -2 + 6  #(lf)            WHEN DATEPART(WEEKDAY, CAST([Full_Date] AS DATE)) = 7 THEN -3 + 6  #(lf)        END, #(lf)        CAST([Full_Date] AS DATE))#(lf)#(lf)#(lf)#(lf)#(tab)#(tab)#(tab)   ,[quarter_start_date] = CAST([Quarter_Start] AS DATE)#(lf)#(tab)#(tab)#(tab)   ,[quarter_end_date] = CAST([Quarter_Start] AS DATE)#(lf)#(tab)#(tab)#(tab)   ,[month_day_no] = [Month_Day_No]#(lf)#(tab)#(tab)#(tab)   ,[financialmonth] = [Fin_Month_No]#(lf)#(tab)#(tab)#(tab)   ,[monthyearname] = CONCAT([Month_Short_Name], '-', LEFT([Date_112], 4))#(lf)#(tab)#(tab)#(tab)   ,[monthyear] = [MonthYear_MMMM_YYYYY]#(lf)#(tab)#(tab)#(tab)   ,[ytdflag] = CASE WHEN [Fin_Month_No] <= (#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)               SELECT#(lf)                                           CAST([Fin_Month_No] AS INT)#(lf)                                           FROM [DSCRO_NATIONAL_LOOKUPS].[dbo].[ref_Dates]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)               WHERE [Full_Date] = EOMONTH ( DATEADD ( MONTH, -1, GETDATE() ) )#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)               )#(lf)                                           THEN 1 ELSE 0 END --> Establishes whether the month is included in year to date calculations and reflects across all years#(lf)#(tab)#(tab)#(tab)   ,[latest_month_flag] = CASE WHEN [Year_Month] IN #(lf)#(tab)#(tab)#(tab)                         (SELECT DISTINCT MAX([Year_Month]) #(lf)#(tab)#(tab)#(tab)                          FROM [DSCRO_NATIONAL_LOOKUPS].[dbo].[ref_Dates]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)  WHERE [Full_Date] BETWEEN '20190401' AND EOMONTH ( DATEADD ( MONTH, -1, GETDATE() ) )) #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)  THEN 1 ELSE 0 END --> The latest month available within your date range#(lf)#(tab)#(tab)#(tab)   ,[previous_month_flag] = CASE WHEN [Year_Month] IN#(lf)#(tab)#(tab)#(tab)                         (SELECT DISTINCT MAX([Year_Month]) #(lf)#(tab)#(tab)#(tab)                          FROM [DSCRO_NATIONAL_LOOKUPS].[dbo].[ref_Dates]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)  WHERE [Full_Date] BETWEEN '20190401' AND EOMONTH ( DATEADD ( MONTH, -2, GETDATE() ) )) #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)  THEN 1 ELSE 0 END --> The month before the latest month available within your date range#(lf)#(tab)#(tab)#(tab)   ,[latest_12_months_flag] = CASE WHEN [Year_Month] IN#(lf)#(tab)#(tab)#(tab)                             (SELECT DISTINCT [Year_Month]#(lf)#(tab)#(tab)#(tab)                              FROM [DSCRO_NATIONAL_LOOKUPS].[dbo].[ref_Dates]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)      WHERE [Full_Date] BETWEEN EOMONTH ( DATEADD ( MONTH, -12, GETDATE() ) ) #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)  AND EOMONTH ( DATEADD ( MONTH, -1, GETDATE() ) )) #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)      THEN 1 ELSE 0 END --> The latest 12 months within your date range#(lf)#(tab)#(tab)#(tab)   ,[previous_12_months_flag] = CASE WHEN [Year_Month] IN#(lf)#(tab)#(tab)#(tab)                               (SELECT DISTINCT [Year_Month]#(lf)#(tab)#(tab)#(tab)                                FROM [DSCRO_NATIONAL_LOOKUPS].[dbo].[ref_Dates]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)        WHERE [Full_Date] BETWEEN EOMONTH ( DATEADD ( MONTH, -24, GETDATE() ) ) #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)    AND EOMONTH ( DATEADD ( MONTH, -13, GETDATE() ) )) #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)        THEN 1 ELSE 0 END --> The 12 months before the latest 12 months within your date range - allows comparing current to previous#(lf)#(tab)#(tab)#(tab)   ,[same_month_last_year_flag] = CASE WHEN [Year_Month] IN#(lf)#(tab)#(tab)#(tab)                                 (SELECT DISTINCT MAX([Year_Month]) #(lf)#(tab)#(tab)#(tab)                                 FROM [DSCRO_NATIONAL_LOOKUPS].[dbo].[ref_Dates]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)         WHERE [Full_Date] BETWEEN '20190401' AND EOMONTH ( DATEADD ( MONTH, -13, GETDATE() ) )) #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)         THEN 1 ELSE 0 END --> Same month last year as the latest month within the date range i.e., Nov-22 and Nov-23#(lf)#(tab)#(tab)#(tab),[last_week] = case when Week_Start_112 =#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)(SELECT DISTINCT MAX(Previous_Week_Start_112)#(lf)#(tab)#(tab)#(tab)                                 FROM [DSCRO_NATIONAL_LOOKUPS].[dbo].[ref_Dates] [a]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)         WHERE cast([Full_Date] as date) =cast(GETDATE()  as date))#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)         THEN 1 ELSE 0 END #(lf)#(tab)#(tab)#(tab),[last_week_minus_7] = case when Week_Start_112 =#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)(SELECT D