		variation Variation
			isDefault
			relationship: 4134b170-b74a-4771-852d-42bd2ca4a15f
			defaultHierarchy: LocalDateTable_a31dfd8f-cc11-4e57-a219-c7d0035c82e2.'Date Hierarchy'

