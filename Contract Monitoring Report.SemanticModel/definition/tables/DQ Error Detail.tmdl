	partition 'DQ Error Detail' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "select ""nhs number"" as ""NHS Number"", ""unique identifier"" as ""Unique Identifier"", ""unique id type"" as ""Unique ID Type"", pod as ""POD"", tfc as ""TFC"", hrg as ""HRG"", ""activity start date"" as ""Activity Start Date"", ""yearmonth activity"" as ""YearMonth Activity"", ""submitted financial month"" as ""Submitted Financial Month"", provider as ""Provider"", ""provider name"" as ""Provider Name"", ""site code"" as ""Site Code"", ""file name"" as ""File Name"", ""submitted cost"" as ""Submitted Cost"", missing_nhs_number as ""Counter"", 'Missing NHS Number' as ""Specific Error"", cast(null as varchar) as ""Specific Error Detail"", 'Missing Mandatory Data' as ""Error Group"" from data_mart_powerbi_contractmonitoring.tbl01_contractingdqlog where missing_nhs_number = 1 union all select ""nhs number"", ""unique identifier"", ""unique id type"", pod, tfc, hrg, ""activity start date"", ""yearmonth activity"", ""submitted financial month"", provider, ""provider name"", ""site code"", ""file name"", ""submitted cost"", missing_unique_id, 'Missing Unique ID', cast(null as varchar), 'Missing Mandatory Data' from data_mart_powerbi_contractmonitoring.tbl01_contractingdqlog where missing_unique_id = 1 union all select ""nhs number"", ""unique identifier"", ""unique id type"", pod, tfc, hrg, ""activity start date"", ""yearmonth activity"", ""submitted financial month"", provider, ""provider name"", ""site code"", ""file name"", ""submitted cost"", missing_start_date_of_activity, 'Missing Start Date', cast(null as varchar), 'Missing Mandatory Data' from data_mart_powerbi_contractmonitoring.tbl01_contractingdqlog where missing_start_date_of_activity = 1 union all select ""nhs number"", ""unique identifier"", ""unique id type"", pod, tfc, hrg, ""activity start date"", ""yearmonth activity"", ""submitted financial month"", provider, ""provider name"", ""site code"", ""file name"", ""submitted cost"", non_glos_commissioner_submitted, 'Non-Glos Commissioner Submitted', non_glos_commissioner_submitted_detail, 'Commissioning Error' from data_mart_powerbi_contractmonitoring.tbl01_contractingdqlog where non_glos_commissioner_submitted = 1 union all select ""nhs number"", ""unique identifier"", ""unique id type"", pod, tfc, hrg, ""activity start date"", ""yearmonth activity"", ""submitted financial month"", provider, ""provider name"", ""site code"", ""file name"", ""submitted cost"", non_glos_gp_submitted, 'Non-Glos GP Submitted', non_glos_gp_submitted_detail, 'Commissioning Error' from data_mart_powerbi_contractmonitoring.tbl01_contractingdqlog where non_glos_gp_submitted = 1 union all select ""nhs number"", ""unique identifier"", ""unique id type"", pod, tfc, hrg, ""activity start date"", ""yearmonth activity"", ""submitted financial month"", provider, ""provider name"", ""site code"", ""file name"", ""submitted cost"", non_glos_gp_derived, 'Non-Glos GP Submitted', non_glos_gp_derived_detail, 'Commissioning Error' from data_mart_powerbi_contractmonitoring.tbl01_contractingdqlog where non_glos_gp_derived = 1 union all select ""nhs number"", ""unique identifier"", ""unique id type"", pod, tfc, hrg, ""activity start date"", ""yearmonth activity"", ""submitted financial month"", provider, ""provider name"", ""site code"", ""file name"", ""submitted cost"", duplicate_op_att_id, 'Duplicate Outpatient Identifier', duplicate_op_att_id_detail, 'Duplicate Information' from data_mart_powerbi_contractmonitoring.tbl01_contractingdqlog where duplicate_op_att_id = 1 union all select ""nhs number"", ""unique identifier"", ""unique id type"", pod, tfc, hrg, ""activity start date"", ""yearmonth activity"", ""submitted financial month"", provider, ""provider name"", ""site code"", ""file name"", ""submitted cost"", duplicate_h_spell_id, 'Duplicate Hospital Provider Spell Identifier', duplicate_h_spell_id_detail, 'Duplicate Information' from data_mart_powerbi_contractmonitoring.tbl01_contractingdqlog where duplicate_h_spell_id = 1 union all select ""nhs number"", ""unique identifier"", ""unique id type"", pod, tfc, hrg, ""activity start date"", ""yearmonth activity"", ""submitted financial month"", provider, ""provider name"", ""site code"", ""file name"", ""submitted cost"", duplicate_activity, 'Duplicate Activity for same patient', cast(null as varchar), 'Duplicate Information' from data_mart_powerbi_contractmonitoring.tbl01_contractingdqlog where duplicate_activity = 1 union all select ""nhs number"", ""unique identifier"", ""unique id type"", pod, tfc, hrg, ""activity start date"", ""yearmonth activity"", ""submitted financial month"", provider, ""provider name"", ""site code"", ""file name"", ""submitted cost"", op_during_ip, 'Outpatient charged during inpatient spell', cast(null as varchar), 'Tariff Error' from data_mart_powerbi_contractmonitoring.tbl01_contractingdqlog where op_during_ip = 1 union all select ""nhs number"", ""unique identifier"", ""unique id type"", pod, tfc, hrg, ""activity start date"", ""yearmonth activity"", ""submitted financial month"", provider, ""provider name"", ""site code"", ""file name"", ""submitted cost"", non_contracted_specialty, 'Non-contracted specialty', non_contracted_specialty_detail, 'Tariff Error' from data_mart_powerbi_contractmonitoring.tbl01_contractingdqlog where non_contracted_specialty = 1 union all select ""nhs number"", ""unique identifier"", ""unique id type"", pod, tfc, hrg, ""activity start date"", ""yearmonth activity"", ""submitted financial month"", provider, ""provider name"", ""site code"", ""file name"", ""submitted cost"", incorrect_first_attendance, 'Incorrect first attendance', cast(null as varchar), 'Tariff Error' from data_mart_powerbi_contractmonitoring.tbl01_contractingdqlog where incorrect_first_attendance = 1 union all select ""nhs number"", ""unique identifier"", ""unique id type"", pod, tfc, hrg, ""activity start date"", ""yearmonth activity"", ""submitted financial month"", provider, ""provider name"", ""site code"", ""file name"", ""submitted cost"", diagnostics_charge_while_inpatient, 'Diagnostics charged during inpatient', cast(null as varchar), 'Tariff Error' from data_mart_powerbi_contractmonitoring.tbl01_contractingdqlog where diagnostics_charge_while_inpatient = 1 union all select ""nhs number"", ""unique identifier"", ""unique id type"", pod, tfc, hrg, ""activity start date"", ""yearmonth activity"", ""submitted financial month"", provider, ""provider name"", ""site code"", ""file name"", ""submitted cost"", unexpected_los, 'Unexpected LoS', cast(null as varchar), 'Tariff Error' from data_mart_powerbi_contractmonitoring.tbl01_contractingdqlog where unexpected_los = 1 union all select ""nhs number"", ""unique identifier"", ""unique id type"", pod, tfc, hrg, ""activity start date"", ""yearmonth activity"", ""submitted financial month"", provider, ""provider name"", ""site code"", ""file name"", ""submitted cost"", uncoded_cost, 'Charged for UZ10Z', cast(null as varchar), 'Tariff Error' from data_mart_powerbi_contractmonitoring.tbl01_contractingdqlog where uncoded_cost = 1 union all select ""nhs number"", ""unique identifier"", ""unique id type"", pod, tfc, hrg, ""activity start date"", ""yearmonth activity"", ""submitted financial month"", provider, ""provider name"", ""site code"", ""file name"", ""submitted cost"", mismatch_hrg, 'Incorrect HRG Applied', mismatch_hrg_detail, 'Tariff Error' from data_mart_powerbi_contractmonitoring.tbl01_contractingdqlog where mismatch_hrg = 1", null, [EnableFolding=true])
