				let
				    Source = Sql.Database("grh-ccg-sql", "PowerBI_Reporting", [Query="#(lf)select #(lf)sum(1) as [Referrals],#(lf)derived_treatmentfunctioncode, #(lf)Provider_Code_Der = isnull(isnull([Site].[Site Code],[Prov].[Organisation Code]), [Prov2].[Site Code]),#(lf)Provider_Code,#(lf)Location_Code,#(lf)Referral_Type,#(lf)[Provider Name] = isnull(isnull([Site].[Organisation Name], [Prov].[Organisation Name]), [Prov2].[Organisation Name]),#(lf)yearmonth,#(lf)[firstdateofmonth],#(lf)[MaxMonth - PLCM] = CASE WHEN [Yearmonth] = [Max].[Max] then 1 else 0 end,#(lf)case when yearmonth = (select max(yearmonth) as [Max] from PowerBI_Reporting.PlannedCare.tbl03_E_Referrals [a]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)LEFT JOIN CCG_Reference.Reference.vw_DateLookup [dat] on cast([a].[InitialReferralDate] as date) = [dat].[Date]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)) then 1 else 0 end as [Max Month]#(lf)from (#(lf)#(tab)SELECT [a].*,#(lf)#(tab)yearmonth,#(lf)#(tab)[firstdateofmonth],#(lf)#(tab)row_number() over(partition by UBRN order by [InitialReferralDate]) as [Distinct Referral]#(lf)#(tab)FROM PowerBI_Reporting.PlannedCare.tbl03_E_Referrals [a]#(lf)#(tab)#(tab)LEFT JOIN CCG_Reference.Reference.vw_DateLookup [dat] on cast([a].[InitialReferralDate] as date) = [dat].[Date]#(lf)#(tab)where Referral_Type = 'Directly Bookable'#(lf)#(tab)) [a]#(lf)#(tab)#(tab)LEFT JOIN [BIReports].[dbo].[Contracting_ContractedProviders_2526] [Prov] on#(lf)#(tab)#(tab)#(tab)[a].Provider_Code = ISNULL([Prov].[Site Code],[Prov].[Organisation Code])#(lf)#(tab)#(tab)left join [BIReports].[dbo].[Contracting_ContractedProviders_2526] [Prov2] on  #(lf)#(tab)#(tab)#(tab)[a].Provider_Code = [Prov2].[Site Code]#(lf)#(tab)#(tab)LEFT JOIN [BIReports].[dbo].[Contracting_ContractedProviders_2526] [Site] on #(lf)#(tab)#(tab)#(tab)[a].Location_Code = #(lf)#(tab)#(tab)#(tab)ISNULL([Site].[Site Code],[Site].[Organisation Code])#(lf)#(tab)#(tab)LEFT JOIN (select max(yearmonth) as [Max], organisation_code from [PowerBI_Reporting].[ContractMonitoring].[tbl02_PLCM_Patient_Level_2526] [a]#(lf)#(tab)#(tab)#(tab)LEFT JOIN (select distinct yearmonth, financialyear, financialmonth from CCG_Reference.Reference.vw_DateLookup) [dat] on #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)[a].[Derived_FinancialYear] = [dat].[FinancialYear] and#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)[a].financial_month = [dat].FinancialMonth#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)group by organisation_code) [Max] on isnull(isnull([Site].[Site Code],[Prov].[Organisation Code]), [Prov2].[Site Code]) = [max].organisation_code#(lf)#(tab)#(tab)#(lf)where [Distinct Referral] = 1 and cast(yearmonth as int) >= 202404 and [Provider_Code] is not null #(lf)group by derived_treatmentfunctioncode, #(lf) isnull(isnull([Site].[Site Code],[Prov].[Organisation Code]), [Prov2].[Site Code]),#(lf)Location_Code,#(lf)Referral_Type,#(lf)isnull(isnull([Site].[Organisation Name], [Prov].[Organisation Name]), [Prov2].[Organisation Name]),#(lf)[firstdateofmonth],#(lf)yearmonth,#(lf)Provider_Code,#(lf)CASE WHEN [Yearmonth] = [Max].[Max] then 1 else 0 end#(lf)#(lf)UNION#(lf)#(lf)select #(lf)sum(1) as [Referrals],#(lf)derived_treatmentfunctioncode, #(lf)Provider_Code_Der = isnull(isnull([Site].[Site Code],[Prov].[Organisation Code]), [Prov2].[Site Code]),#(lf)Provider_Code,#(lf)Location_Code,#(lf)Referral_Type,#(lf)[Provider Name] = isnull(isnull([Site].[Organisation Name], [Prov].[Organisation Name]), [Prov2].[Organisation Name]),#(lf)yearmonth,#(lf)[firstdateofmonth],#(lf)[MaxMonth - PLCM] = CASE WHEN [Yearmonth] = [Max].[Max] then 1 else 0 end,#(lf)case when yearmonth = (select max(yearmonth) as [Max] from PowerBI_Reporting.PlannedCare.tbl03_E_Referrals [a]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)LEFT JOIN CCG_Reference.Reference.vw_DateLookup [dat] on cast([a].[InitialReferralDate] as date) = [dat].[Date]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)) then 1 else 0 end as [Max Month]#(lf)from (#(lf)#(tab)SELECT [a].*,#(lf)#(tab)yearmonth,#(lf)#(tab)[firstdateofmonth],#(lf)#(tab)row_number() over(partition by UBRN order by [InitialReferralDate]) as [Distinct Referral]#(lf)#(tab)FROM PowerBI_Reporting.PlannedCare.tbl03_E_Referrals [a]#(lf)#(tab)#(tab)LEFT JOIN CCG_Reference.Reference.vw_DateLookup [dat] on cast([a].[InitialReferralDate] as date) = [dat].[Date]#(lf)#(tab)where RAS = 1#(lf)#(tab)) [a]#(lf)#(tab)#(tab)LEFT JOIN [BIReports].[dbo].[Contracting_ContractedProviders_2526] [Prov] on #(lf)#(tab)#(tab)#(tab)[a].Provider_Code = ISNULL([Prov].[Site Code],[Prov].[Organisation Code])#(lf)#(tab)#(tab)left join [BIReports].[dbo].[Contracting_ContractedProviders_2526] [Prov2] on  #(lf)#(tab)#(tab)#(tab)[a].Provider_Code = [Prov2].[Site Code]#(lf)#(tab)#(tab)LEFT JOIN [BIReports].[dbo].[Contracting_ContractedProviders_2526] [Site] on #(lf)#(tab)#(tab)#(tab)[a].Location_Code = #(lf)#(tab)#(tab)#(tab)ISNULL([Site].[Site Code],[Site].[Organisation Code])#(lf)#(tab)#(tab)LEFT JOIN (select max(yearmonth) as [Max], organisation_code from [PowerBI_Reporting].[ContractMonitoring].[tbl02_PLCM_Patient_Level_2526] [a]#(lf)#(tab)#(tab)#(tab)LEFT JOIN (select distinct yearmonth, financialyear, financialmonth from CCG_Reference.Reference.vw_DateLookup) [dat] on #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)[a].[Derived_FinancialYear] = [dat].[FinancialYear] and#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)[a].financial_month = [dat].FinancialMonth#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)group by organisation_code) [Max] on isnull(isnull([Site].[Site Code],[Prov].[Organisation Code]), [Prov2].[Site Code]) = [max].organisation_code#(lf)where [Distinct Referral] = 1 and cast(yearmonth as int) >= 202404 and [Provider_Code] is not null #(lf)group by derived_treatmentfunctioncode, #(lf) isnull(isnull([Site].[