	partition Referrals = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "with plcm_max as (select organisation_code, max(case when financial_month<=9 then cast(left(derived_financialyear,4) as int)*100+financial_month+3 else (cast(left(derived_financialyear,4) as int)+1)*100+financial_month-9 end) as max_ym from data_mart_powerbi_contractmonitoring.tbl02_plcm_patient_level_2526 group by organisation_code), ref_max as (select max(initialreferralyearmonth) as mx from data_mart_powerbi_plannedcare.tbl03_e_referrals) select sum(1) as ""Referrals"", derived_treatmentfunctioncode, coalesce(coalesce(site.site_code, prov.organisation_code), prov2.site_code) as ""Provider_Code_Der"", provider_code as ""Provider_Code"", location_code as ""Location_Code"", referral_type as ""Referral_Type"", coalesce(coalesce(site.organisation_name, prov.organisation_name), prov2.organisation_name) as ""Provider Name"", yearmonth as ""yearmonth"", firstdateofmonth as ""firstdateofmonth"", case when yearmonth = pm.max_ym then 1 else 0 end as ""MaxMonth - PLCM"", case when yearmonth = (select mx from ref_max) then 1 else 0 end as ""Max Month"" from (select a.*, a.initialreferralyearmonth as yearmonth, date_trunc('month', a.initialreferraldate)::date as firstdateofmonth, row_number() over(partition by ubrn order by initialreferraldate) as distinct_referral from data_mart_powerbi_plannedcare.tbl03_e_referrals a where referral_type = 'Directly Bookable') a left join data_mart_bireports_cm.contractedproviders_2526 prov on a.provider_code = coalesce(prov.site_code, prov.organisation_code) left join data_mart_bireports_cm.contractedproviders_2526 prov2 on a.provider_code = prov2.site_code left join data_mart_bireports_cm.contractedproviders_2526 site on a.location_code = coalesce(site.site_code, site.organisation_code) left join plcm_max pm on coalesce(coalesce(site.site_code, prov.organisation_code), prov2.site_code) = pm.organisation_code where distinct_referral = 1 and cast(yearmonth as int) >= 202404 and provider_code is not null group by derived_treatmentfunctioncode, coalesce(coalesce(site.site_code, prov.organisation_code), prov2.site_code), location_code, referral_type, coalesce(coalesce(site.organisation_name, prov.organisation_name), prov2.organisation_name), firstdateofmonth, yearmonth, provider_code, case when yearmonth = pm.max_ym then 1 else 0 end union select sum(1) as ""Referrals"", derived_treatmentfunctioncode, coalesce(coalesce(site.site_code, prov.organisation_code), prov2.site_code) as ""Provider_Code_Der"", provider_code as ""Provider_Code"", location_code as ""Location_Code"", referral_type as ""Referral_Type"", coalesce(coalesce(site.organisation_name, prov.organisation_name), prov2.organisation_name) as ""Provider Name"", yearmonth as ""yearmonth"", firstdateofmonth as ""firstdateofmonth"", case when yearmonth = pm.max_ym then 1 else 0 end as ""MaxMonth - PLCM"", case when yearmonth = (select mx from ref_max) then 1 else 0 end as ""Max Month"" from (select a.*, a.initialreferralyearmonth as yearmonth, date_trunc('month', a.initialreferraldate)::date as firstdateofmonth, row_number() over(partition by ubrn order by initialreferraldate) as distinct_referral from data_mart_powerbi_plannedcare.tbl03_e_referrals a where ras = 1) a left join data_mart_bireports_cm.contractedproviders_2526 prov on a.provider_code = coalesce(prov.site_code, prov.organisation_code) left join data_mart_bireports_cm.contractedproviders_2526 prov2 on a.provider_code = prov2.site_code left join data_mart_bireports_cm.contractedproviders_2526 site on a.location_code = coalesce(site.site_code, site.organisation_code) left join plcm_max pm on coalesce(coalesce(site.site_code, prov.organisation_code), prov2.site_code) = pm.organisation_code where distinct_referral = 1 and cast(yearmonth as int) >= 202404 and provider_code is not null group by derived_treatmentfunctioncode, coalesce(coalesce(site.site_code, prov.organisation_code), prov2.site_code), location_code, referral_type, coalesce(coalesce(site.organisation_name, prov.organisation_name), prov2.organisation_name), firstdateofmonth, yearmonth, provider_code, case when yearmonth = pm.max_ym then 1 else 0 end", null, [EnableFolding=true])
				in
				    Source

