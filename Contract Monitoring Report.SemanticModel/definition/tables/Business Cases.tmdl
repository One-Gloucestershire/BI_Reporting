table 'Business Cases'
	lineageTag: ffc34e18-3e8d-46f4-82c4-aeb2b3611b53

	measure BC_Mean = ```
			
			VAR TwoYearMonths =
			    FILTER (
			        ALL ( 'Date Table (First Day of Month)'),
			        'Date Table (First Day of Month)'[YearMonth] >= 202204 &&  -- start of your window
			        'Date Table (First Day of Month)'[YearMonth] <= 202503   -- end of your window
			    )
			RETURN
			AVERAGEX (
			    TwoYearMonths,
			    CALCULATE ( COUNTROWS (  'Business Cases' ) ) )
			
			```
		formatString: 0
		lineageTag: 4e47d44e-6382-44d7-aaa6-5dcf768c86cb

	measure BC_SD =
			
			VAR TwoYearMonths =
			    FILTER (
			        ALL ( 'Date Table (First Day of Month)' ),
			        'Date Table (First Day of Month)'[YearMonth] >= 202204 &&
			        'Date Table (First Day of Month)'[YearMonth] <= 202503
			    )
			RETURN
			STDEVX.S (
			    TwoYearMonths,
			    CALCULATE ( COUNTROWS ( 'Business Cases' ) )
			)
		lineageTag: 5a3a414d-6767-4545-b4af-33f87e91e8c8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure BC_UCL = [BC_Mean] + (3*[BC_SD])
		lineageTag: de2e20c3-52a4-4235-bf99-22de000bef6b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure BC_LCL = [BC_Mean] - (3*[BC_SD])
		lineageTag: 4999f4f8-a7da-445d-968d-37bd66b8a363

		annotation PBI_FormatHint = {"isGeneralNumber":true}

