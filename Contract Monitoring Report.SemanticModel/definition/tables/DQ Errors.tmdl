	partition 'DQ Errors' = m
		mode: import
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "PowerBI_Reporting", [Query="SELECT #(lf)      [POD]#(lf)      ,[IAP POD]#(lf)      ,[TFC]#(lf)      ,[HRG]#(lf)      ,[YearMonth Activity]#(lf)      ,[Provider]#(lf)      ,[Provider Name]#(lf)      ,[Site Code]#(lf)      ,sum([Submitted Cost]) as [Submitted Cost]#(lf)  FROM [PowerBI_Reporting].[ContractMonitoring].[tbl01_ContractingDQLog]#(lf)  WHERE#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) (MISSING_NHS_NUMBER + MISSING_UNIQUE_ID + MISSING_START_DATE_OF_ACTIVITY --MISSING_MANDATORY_DATA#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)+ NON_GLOS_COMMISSIONER_SUBMITTED + NON_GLOS_GP_SUBMITTED + NON_GLOS_GP_DERIVED --COMMISSIONING_ERROR#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)+ DUPLICATE_OP_ATT_ID + DUPLICATE_H_SPELL_ID + DUPLICATE_ACTIVITY --DUPLICATED_INFORMATION#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)+ OP_DURING_IP + NON_CONTRACTED_SPECIALTY + INCORRECT_FIRST_ATTENDANCE + DIAGNOSTICS_CHARGE_WHILE_INPATIENT + UNEXPECTED_LoS + UNCODED_COST + MISMATCH_HRG--TARIFF_ERRORS#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)) > 0#(lf)  GROUP BY #(lf)   [POD]#(lf)      ,[IAP POD]#(lf)      ,[TFC]#(lf)      ,[HRG]#(lf)      ,[YearMonth Activity]#(lf)      ,[Provider]#(lf)      ,[Provider Name]#(lf)      ,[Site Code]"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

