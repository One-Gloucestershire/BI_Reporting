	partition 'DQ Errors' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "select pod as ""POD"", ""iap pod"" as ""IAP POD"", tfc as ""TFC"", hrg as ""HRG"", ""yearmonth activity"" as ""YearMonth Activity"", provider as ""Provider"", ""provider name"" as ""Provider Name"", ""site code"" as ""Site Code"", sum(""submitted cost"") as ""Submitted Cost"" from data_mart_powerbi_contractmonitoring.tbl01_contractingdqlog where (missing_nhs_number + missing_unique_id + missing_start_date_of_activity + non_glos_commissioner_submitted + non_glos_gp_submitted + non_glos_gp_derived + duplicate_op_att_id + duplicate_h_spell_id + duplicate_activity + op_during_ip + non_contracted_specialty + incorrect_first_attendance + diagnostics_charge_while_inpatient + unexpected_los + uncoded_cost + mismatch_hrg) > 0 group by pod, ""iap pod"", tfc, hrg, ""yearmonth activity"", provider, ""provider name"", ""site code""", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

