	partition 'Loading Error' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "select sum(counter) as ""Loaded Files"", max(financial_month_orig) as ""Max Month"", ""Data Type"", organisation_name, ""Type"" from (select distinct filename, organisation_name, 'Non-Drug/Dev activity' as ""Data Type"", 1 as counter, financial_month_orig as financial_month_orig, ""sector flag 2"", processeddate, 'Provider Month' as ""Type"" from data_mart_powerbi_contractmonitoring.tbl02_plcm_summary_table_2526 where upper(point_of_delivery_code) not in ('DRUG','DEVICE','NAOTHER','OTHER','BLOCK','ADJUSTMENT') union select distinct filename, organisation_name, 'Drug activity' as ""Data Type"", 1 as counter, financial_month_orig as financial_month_orig, ""sector flag 2"", processeddate, 'Provider Month' as ""Type"" from data_mart_powerbi_contractmonitoring.tbl02_plcm_summary_table_2526 where upper(point_of_delivery_code) in ('DRUG') union select distinct filename, organisation_name, 'Device activity' as ""Data Type"", 1 as counter, financial_month_orig as financial_month_orig, ""sector flag 2"", processeddate, 'Provider Month' as ""Type"" from data_mart_powerbi_contractmonitoring.tbl02_plcm_summary_table_2526 where upper(point_of_delivery_code) in ('DEVICE') union select distinct filename, organisation_name, 'Non-Drug/Dev activity' as ""Data Type"", 1 as counter, financial_month as financial_month_orig, ""sector flag 2"", processeddate, 'DMS Month' as ""Type"" from data_mart_powerbi_contractmonitoring.tbl02_plcm_summary_table_2526 where upper(point_of_delivery_code) not in ('DRUG','DEVICE','NAOTHER','OTHER','BLOCK','ADJUSTMENT') union select distinct filename, organisation_name, 'Drug activity' as ""Data Type"", 1 as counter, financial_month as financial_month_orig, ""sector flag 2"", processeddate, 'DMS Month' as ""Type"" from data_mart_powerbi_contractmonitoring.tbl02_plcm_summary_table_2526 where upper(point_of_delivery_code) in ('DRUG') union select distinct filename, organisation_name, 'Device activity' as ""Data Type"", 1 as counter, financial_month as financial_month_orig, ""sector flag 2"", processeddate, 'DMS Month' as ""Type"" from data_mart_powerbi_contractmonitoring.tbl02_plcm_summary_table_2526 where upper(point_of_delivery_code) in ('DEVICE')) a group by ""Data Type"", organisation_name, ""Type""", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

