	partition 'Loading Error' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "PowerBI_Reporting", [Query="SELECT#(lf)SUM([Counter]) as [Loaded Files],#(lf)max([financial_month_orig]) as [Max Month],#(lf)[Data Type],#(lf)organisation_name,#(lf)[Type]#(lf)FROM (#(lf)#(tab)#(tab)select distinct#(lf)#(tab)#(tab)[filename],organisation_name, 'Non-Drug/Dev activity' as [Data Type], 1 as counter, financial_month_orig,[Sector Flag 2], processeddate#(lf)#(tab)#(tab),'Provider Month' as [Type]#(lf)#(lf)#(tab)#(tab)from PowerBI_Reporting.ContractMonitoring.tbl02_PLCM_Summary_Table_2526#(lf)#(tab)#(tab)where POINT_OF_DELIVERY_CODE not in ('DRUG','DEVICE','NAOTHER','OTHER','BLOCK','ADJUSTMENT')#(lf)#(tab)#(tab)UNION#(lf)#(tab)#(tab)select distinct#(lf)#(tab)#(tab)[filename],organisation_name, 'Drug activity', 1 as counter,financial_month_orig,[Sector Flag 2], processeddate#(lf)#(tab)#(tab),'Provider Month' as [Type]#(lf)#(tab)#(tab)from PowerBI_Reporting.ContractMonitoring.tbl02_PLCM_Summary_Table_2526#(lf)#(tab)#(tab)where POINT_OF_DELIVERY_CODE  in ('DRUG')#(lf)#(tab)#(tab)UNION#(lf)#(tab)#(tab)select distinct#(lf)#(tab)#(tab)[filename],organisation_name, 'Device activity', 1 as counter,financial_month_orig,[Sector Flag 2], processeddate#(lf)#(tab)#(tab),'Provider Month' as [Type]#(lf)#(tab)#(tab)from PowerBI_Reporting.ContractMonitoring.tbl02_PLCM_Summary_Table_2526#(lf)#(tab)#(tab)where POINT_OF_DELIVERY_CODE in ('DEVICE')#(lf)#(lf)#(tab)#(tab)UNION#(lf)#(tab)#(tab)select distinct#(lf)#(tab)#(tab)[filename],organisation_name, 'Non-Drug/Dev activity', 1 as counter, financial_month,[Sector Flag 2], processeddate#(lf)#(tab)#(tab),'DMS Month' as [Type]#(lf)#(tab)#(tab)from PowerBI_Reporting.ContractMonitoring.tbl02_PLCM_Summary_Table_2526#(lf)#(tab)#(tab)where POINT_OF_DELIVERY_CODE not in ('DRUG','DEVICE','NAOTHER','OTHER','BLOCK','ADJUSTMENT')#(lf)#(tab)#(tab)UNION#(lf)#(tab)#(tab)select distinct#(lf)#(tab)#(tab)[filename],organisation_name, 'Drug activity', 1 as counter,financial_month,[Sector Flag 2], processeddate#(lf)#(tab)#(tab),'DMS Month' as [Type]#(lf)#(tab)#(tab)from PowerBI_Reporting.ContractMonitoring.tbl02_PLCM_Summary_Table_2526#(lf)#(tab)#(tab)where POINT_OF_DELIVERY_CODE  in ('DRUG')#(lf)#(tab)#(tab)UNION#(lf)#(tab)#(tab)select distinct#(lf)#(tab)#(tab)[filename],organisation_name, 'Device activity', 1 as counter,financial_month,[Sector Flag 2], processeddate#(lf)#(tab)#(tab),'DMS Month' as [Type]#(lf)#(tab)#(tab)from PowerBI_Reporting.ContractMonitoring.tbl02_PLCM_Summary_Table_2526#(lf)#(tab)#(tab)where POINT_OF_DELIVERY_CODE in ('DEVICE')#(lf)#(tab)#(tab)) [a]#(lf)GROUP BY [Data Type],#(lf)organisation_name,#(lf)[Type]"])
				in
				    Source

