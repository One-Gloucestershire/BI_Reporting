	partition 'PLCM Data' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "PowerBI_Reporting", [Query="SELECT #(lf)case when ([Detailed Mapped POD] is null or [Detailed Mapped POD] = '(blank)') and#(lf)(TARIFF_CODE LIKE 'RD%' or TARIFF_CODE like 'RN%') then 'Diagnostic Imaging'#(lf)else [Detailed Mapped POD] end as [Detailed Mapped POD],#(lf)[Mapped POD Group],#(lf)case when [Mapped POD Group] in (#(lf)'Elective Daycase Spells',#(lf)'Elective Inpatient Spells',#(lf)'Excluded HRGs - Daycase',#(lf)'Excluded HRGs - Elective',#(lf)'Excluded Outpatient Procedures',#(lf)'Outpatient First Attendances',#(lf)'Outpatient Procedures') then 'Variable - Elective'#(lf)when [Mapped POD Group] in (#(lf)'Devices',#(lf)'Drugs') then 'Variable - Drugs & Devices'#(lf)when [Mapped POD Group] in (#(lf)'Accident & Emergency',#(lf)'Ambulatory Care',#(lf)'Emergency Spells',#(lf)'Excluded HRGs - Emergency',#(lf)'Assessments',#(lf)'Emergency Readmissions',#(lf)'Non-elective Spells') then 'Block - Non-Elective'#(lf)when TARIFF_CODE LIKE 'RD%' or TARIFF_CODE like 'RN%' then 'Variable - Diagnostics'#(lf)when [Mapped POD Group] in (#(lf)'Diagnostic Imaging',#(lf)'Diagnostic Imaging whilst Out-Patient',#(lf)'Direct Access',#(lf)'Direct Access Pathology Tests',#(lf)'Diagnostic Tests',#(lf)'Unbundled Outpatient Radiology',#(lf)'Unbundled radiology') then 'Variable - Diagnostics - old'#(lf)else 'Block - Other' end as [Grouped POD],#(lf)case when Organisation_Code like 'r%' then 'NHS' else 'IS' end as [Sector Flag],#(lf)[Total Actual Activity]#(lf)      ,[Total Actual Cost]#(lf)      ,[FC Activity based on YTD]#(lf)      ,[FC Cost based on YTD]#(lf)      ,[Contracted site flag]#(lf)      --,[Challenge Flag]#(lf)      ,[GP Practice Error Flag]#(lf)      ,[GP Practice Code]#(lf)      ,[Our Patients Flag]#(lf)      ,[Date Error Flag]#(lf)      ,[Patient ID Error Flag]#(lf)      ,[Error Group]#(lf)      ,[organisation_name]#(lf)      ,[Organisation_Code]#(lf)      ,[site_name]#(lf)      ,[site_code]#(lf)      ,[POD_Grp]#(lf)      ,[A].[PbR Flag]#(lf)#(tab)  ,[IAP POD Group]#(lf)      ,[TreatmentFunctionDescription] COLLATE Latin1_General_CI_AS AS [TreatmentFunctionDescription]#(lf)      ,[TARIFF_CODE]#(lf)      ,[HRGCodeDescription]#(lf)      ,[Latest_fin_month]#(lf)      ,[financial_month]#(lf)      ,[Derived_FinancialYear]#(lf)      ,[ORGANISATION_IDENTIFIER_CODE_OF_COMMISSIONER]#(lf)      ,[ORGANISATION_IDENTIFIER_CODE_OF_PROVIDER]#(lf)      ,[LOCAL_POINT_OF_DELIVERY_CODE]#(lf)      ,[LOCAL_CONTRACT_MONITORING_DESCRIPTION]#(lf)      ,[HRG Chapter]#(lf)      ,[HRG Sub Chapter]#(lf)      ,[Detailed Mapped POD]#(lf)      ,[Dental Flag]#(lf)      ,[Sector Flag 2]#(lf)      ,[FileName]#(lf)      ,[StartDate]#(lf)      ,[FinancialYear - Startdate]#(lf)      ,[MonthName - Startdate]#(lf)      ,[ERF Exclusion Flag]#(lf)#(tab)  ,CONCAT(Organisation_Code,[PbR Flag],[IAP POD Group],TreatmentFunctionDescription COLLATE Latin1_General_CI_AS,TARIFF_CODE) AS [IAP Join]#(lf)#(tab)  ,NULL as [Unique ID Join]#(lf)#(tab)  ,yearmonth#(lf)FROM [BIReports].dbo.[OOC_IPR_Summary_Table_2425] [a]#(lf)LEFT JOIN (select distinct yearmonth, financialyear, financialmonth from CCG_Reference.Reference.vw_DateLookup) [dat] on #(lf)#(tab)#(tab)#(tab)#(tab)[a].[Derived_FinancialYear] = [dat].[FinancialYear] and#(lf)#(tab)#(tab)#(tab)#(tab)[a].financial_month = [dat].FinancialMonth#(lf)#(lf)UNION ALL#(lf)#(lf)SELECT #(lf)case when ([Detailed Mapped POD] is null or [Detailed Mapped POD] = '(blank)') and#(lf)(TARIFF_CODE LIKE 'RD%' or TARIFF_CODE like 'RN%') then 'Diagnostic Imaging'#(lf)else [Detailed Mapped POD] end as [Detailed Mapped POD],#(lf)[Mapped POD Group],#(lf)case when [Mapped POD Group] in (#(lf)'Elective Daycase Spells',#(lf)'Elective Inpatient Spells',#(lf)'Excluded HRGs - Daycase',#(lf)'Excluded HRGs - Elective',#(lf)'Excluded Outpatient Procedures',#(lf)'Outpatient First Attendances',#(lf)'Outpatient Procedures') then 'Variable - Elective'#(lf)when [Mapped POD Group] in (#(lf)'Devices',#(lf)'Drugs') then 'Variable - Drugs & Devices'#(lf)when [Mapped POD Group] in (#(lf)'Accident & Emergency',#(lf)'Ambulatory Care',#(lf)'Emergency Spells',#(lf)'Excluded HRGs - Emergency',#(lf)'Assessments',#(lf)'Emergency Readmissions',#(lf)'Non-elective Spells') then 'Block - Non-Elective'#(lf)when TARIFF_CODE LIKE 'RD%' or TARIFF_CODE like 'RN%' then 'Variable - Diagnostics'#(lf)when [Mapped POD Group] in (#(lf)'Diagnostic Imaging',#(lf)'Diagnostic Imaging whilst Out-Patient',#(lf)'Direct Access',#(lf)'Direct Access Pathology Tests',#(lf)'Diagnostic Tests',#(lf)'Unbundled Outpatient Radiology',#(lf)'Unbundled radiology') then 'Variable - Diagnostics - old'#(lf)else 'Block - Other' end as [Grouped POD],#(lf)case when Organisation_Code like 'r%' then 'NHS' else 'IS' end as [Sector Flag],#(lf)[Total Actual Activity]#(lf)      ,[Total Actual Cost]#(lf)      ,[FC Activity based on YTD]#(lf)      ,[FC Cost based on YTD]#(lf)      ,[Contracted site flag]#(lf)      --,[Challenge Flag]#(lf)      ,[GP Practice Error Flag]#(lf)      ,[GP Practice Code]#(lf)      ,[Our Patients Flag]#(lf)      ,[Date Error Flag]#(lf)      ,[Patient ID Error Flag]#(lf)      ,NULL AS [Error Group]#(lf)      ,[organisation_name]#(lf)      ,[Organisation_Code]#(lf)      ,[site_name]#(lf)      ,NULL AS [site_code]#(lf)      ,[POD_Grp]#(lf)      ,[A].[PbR Flag]#(lf)#(tab)  ,[IAP POD Group]#(lf)      ,[TreatmentFunctionDescription] COLLATE Latin1_General_CI_AS#(lf)      ,[TARIFF_CODE]#(lf)      ,[HRGCodeDescription]#(lf)      ,[Latest_fin_month]#(lf)      ,[financial_month]#(lf)      ,[Derived_FinancialYear]#(lf)      ,[ORGANISATION_IDENTIFIER_CODE_OF_COMMISSIONER]#(lf)      ,[ORGANISATION_IDENTIFIER_CODE_OF_PROVIDER]#(lf)      ,[LOCAL_POINT_OF_DELIVERY_CODE]#(lf)      ,[LOCAL_CONTRACT_MONITORING_DESCRIPTION]#(lf)      ,[HRG Chapter]#(lf)      ,[HRG Sub Chapter]#(lf)      ,[Detailed Mapped POD]#(lf)      ,[Dental Flag]#(lf)      ,NULL AS [Sector Flag 2]#(lf)      ,[FileName]#(lf)      ,[StartDate]#(lf)      ,[FinancialYear - Startdate]#(lf)      ,[MonthName - Startdate]#(lf)      ,[ERF Exclusion Flag]#(lf)#(tab)  ,CONCAT(Organisation_Code,[PbR Flag],[IAP POD Group],TreatmentFunctionDescription COLLATE Latin1_General_CI_AS,TARIFF_CODE) AS [IAP Join]#(lf)#(tab)  ,CONCAT([Unique Identifier],[Unique Identifier Type])#(lf)#(tab)  ,yearmonth#(lf)FROM [PowerBI_Reporting].[ContractMonitoring].[tbl02_PLCM_Patient_Level_2526] [a]#(lf)LEFT JOIN (select distinct yearmonth, financialyear, financialmonth from CCG_Reference.Reference.vw_DateLookup) [dat] on #(lf)#(tab)#(tab)#(tab)#(tab)[a].[Derived_FinancialYear] = [dat].[FinancialYear] and#(lf)#(tab)#(tab)#(tab)#(tab)[a].financial_month = [dat].FinancialMonth"])
				in
				    Source

