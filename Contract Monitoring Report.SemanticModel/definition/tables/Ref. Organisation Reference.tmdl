	partition 'Ref. Organisation Reference' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "bireports", [Query="select distinct#(lf)ISNULL([Site Code],[Organisation Code]) as organisation_code,#(lf)[Organisation Name] as organisation_name,#(lf)CASE#(lf)WHEN [Organisation Code] like 'RTE%' then 'GHFT'#(lf)WHEN [Organisation Code] like 'R%' then 'OOC NHS'#(lf)ELSE 'IS' end as [Sector]#(lf)from [BIReports].[dbo].[Contracting_ContractedProviders_2526]#(lf)--order by [Organisation Code]#(lf)"])
				in
