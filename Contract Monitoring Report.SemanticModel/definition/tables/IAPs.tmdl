table IAPs
	lineageTag: 892e756a-613d-4e66-a331-e07c9bb7f872

	measure Monthly_IAP_Cost = ```
			
			VAR Monthly = calculate(sum(IAPs[2025/26 Total Cost + MFF (Post-Adjustment)]))/12
			
			RETURN 
			calculate(Monthly,
			    FILTER(ALL('Date Table (First Day of Month)'),
			                'Date Table (First Day of Month)'[FinancialYear] = "2025/26"))
			```
		lineageTag: 126ddfda-b264-43f1-b912-3e9c280bb603

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'YTD IAP' =
			
			(CALCULATE(SUM(IAPs[2025/26 Total Cost + MFF (Post-Adjustment)]))/12) * (CALCULATE(min('Aggregate Data'[Latest_fin_month])))
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 4a4044ad-e8dd-4d64-ba76-be97bdafd595

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure Monthly_IAP_Cost_AMP_Tolerance = ```
			if
			(calculate(sum(IAPs[2025/26 Total Cost + MFF (Post-Adjustment)]))<1000000,
			(calculate(sum(IAPs[2025/26 Total Cost + MFF (Post-Adjustment)]))/12)*1.05,
			if(and(
			calculate(sum(IAPs[2025/26 Total Cost + MFF (Post-Adjustment)]))>=1000000,calculate(sum(IAPs[2025/26 Total Cost + MFF (Post-Adjustment)]))<5000000),
			(calculate(sum(IAPs[2025/26 Total Cost + MFF (Post-Adjustment)]))/12)*1.025,
			(calculate(sum(IAPs[2025/26 Total Cost + MFF (Post-Adjustment)]))/12)*1.015))
			
			```
		lineageTag: 346228fd-cc5f-40bb-90e4-a90df7267702

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure YTD_IAP2 =
			
			VAR _TotalCost = CALCULATE(SUM(IAPs[2025/26 Total Cost + MFF (Post-Adjustment)]))
			VAR _LatestMonth = CALCULATE(MIN('Aggregate Data'[Latest_fin_month]))
			
			VAR _TotalCalc = (_TotalCost / 12) * _LatestMonth
			
			VAR _IS_Level_Calc =
			    VAR _TotalCost_IS = CALCULATE(
			        SUM(IAPs[2025/26 Total Cost + MFF (Post-Adjustment)]),
			        REMOVEFILTERS('Ref. Organisation Reference'[organisation_name]) // Remove provider filter to get full IS group
			    )
			    VAR _LatestMonth_IS = CALCULATE(
			        MIN('Aggregate Data'[Latest_fin_month]),
			        REMOVEFILTERS(IAPs[Provider Name])
			    )
			    RETURN
			    (_TotalCost_IS / 12) * _LatestMonth_IS
			
			RETURN
			SWITCH(
			    TRUE(),
			    ISINSCOPE('Ref. Organisation Reference'[organisation_name]), (_TotalCost / 12) * _LatestMonth,  // Row Level
			    ISINSCOPE('Ref. Organisation Reference'[Sector]), _IS_Level_Calc,                    // IS Subtotal
			    _TotalCalc                                                    // Grand Total
			)
		lineageTag: 75670e1c-fd4e-46ea-b1cd-b8966b8a6f37

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure YTD_IAP_Total = sumx(IAPs,[YTD IAP])
		lineageTag: 413d6093-7992-4cb1-b871-78ec72c646b7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

