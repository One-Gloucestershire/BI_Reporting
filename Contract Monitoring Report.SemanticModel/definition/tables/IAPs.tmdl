	column YTD_IAP_Col =
			
			DIVIDE([2025/26 Total Cost + MFF (Post-Adjustment)], 12, BLANK())
			    * CALCULATE(
			        MIN('Aggregate Data'[Latest_fin_month]),
			        FILTER(
			            'Aggregate Data',
			            'Aggregate Data'[Organisation_Code] = IAPs[Provider Code]
			        )
			    )
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: b8600fee-c702-4db0-9e7e-3fa81ce49af9
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	partition IAPs = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "BIReports", [Query="SELECT CONCAT([Provider Code],[Helper Column]) as [Helper Column],#(lf)CASE #(lf)WHEN [a].[Provider Code] like '%acg%' THEN 'L0D9W' #(lf)WHEN [a].[Provider Code] like '%NPG%' THEN 'A0C5S'#(lf)WHEN [a].[Provider Code] like '%DFY%' THEN 'DFY01'#(lf)else [a].[Provider Code] end as [Provider Code],#(lf)*#(lf)FROM BIReports.dbo.IAPs_IS_2526 [a]"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

