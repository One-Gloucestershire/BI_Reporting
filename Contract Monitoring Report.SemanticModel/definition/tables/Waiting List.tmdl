	partition 'Waiting List' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "PowerBI_Processing", [Query="select #(lf)sum([Number_of_pathways]) as [Wait List],#(lf)Waiting_List_Type,#(lf)Weeks_Waiting,#(lf)[TFC] = Activity_Treatment_Function_Code,#(lf)[Provider] = ORGANISATION_IDENTIFIER_CODE_OF_PROVIDER,#(lf)[Provider Name] = isnull(isnull([Site].[Organisation Name],[Prov].[Organisation Name]),[Prov2].[Organisation Name]),#(lf)Provider_Code_Der = isnull(isnull([Site].[Site Code],[Prov].[Organisation Code]), [Prov2].[Site Code]),#(lf)[Site Code] = NULLIF(ORGANISATION_SITE_IDENTIFIER_OF_TREATMENT, ''),#(lf)[Week] = Week_Ending_Date_CORR,#(lf)sum(Number_of_pathways_0to18_1st_Activity) as [0-18 Wait for 1st],#(lf)[MaxMonth - PLCM] = CASE WHEN [Yearmonth] = [Max].[Max] then 1 else 0 end,#(lf)YearMonth,#(lf)[Latest Flag] = #(lf)CASE #(lf)#(tab)WHEN Week_Ending_Date_CORR = (SELECT MAX(Week_Ending_Date_CORR) from [PowerBI_Processing].[PrimaryCare].[tbl05_RTTcounts] [a]#(lf)#(tab)#(tab)#(tab)LEFT JOIN (select distinct yearmonth, financialyear, financialmonth,[Date] from CCG_Reference.Reference.vw_DateLookup) [dat] on #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)[a].Week_Ending_Date_CORR = [dat].[Date] #(lf)#(tab)LEFT JOIN (select max(yearmonth) as [Max], organisation_code from [PowerBI_Reporting].[ContractMonitoring].[tbl02_PLCM_Patient_Level_2526] [a]#(lf)#(tab)#(tab)#(tab)LEFT JOIN (select distinct yearmonth, financialyear, financialmonth from CCG_Reference.Reference.vw_DateLookup) [dat] on #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)[a].[Derived_FinancialYear] = [dat].[FinancialYear] and#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)[a].financial_month = [dat].FinancialMonth#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)group by organisation_code) [Max]   on isnull(isnull([Site].[Site Code],[Prov].[Organisation Code]), [Prov2].[Site Code]) = [max].organisation_code#(lf)#(tab)#(tab)#(tab)WHERE yearmonth <= [Max].[Max])#(lf)#(tab)#(tab)THEN 1 else 0 #(lf)END#(lf)from [PowerBI_Processing].[PrimaryCare].[tbl05_RTTcounts] [a]#(lf)#(tab)#(tab)LEFT JOIN [BIReports].[dbo].[Contracting_ContractedProviders_2526] [Prov] on#(lf)#(tab)#(tab)#(tab)[a].ORGANISATION_IDENTIFIER_CODE_OF_PROVIDER = ISNULL([Prov].[Site Code],[Prov].[Organisation Code])#(lf)#(tab)#(tab)left join [BIReports].[dbo].[Contracting_ContractedProviders_2526] [Prov2] on  #(lf)#(tab)#(tab)#(tab)[a].ORGANISATION_IDENTIFIER_CODE_OF_PROVIDER = [Prov2].[Site Code]#(lf)#(tab)#(tab)LEFT JOIN [BIReports].[dbo].[Contracting_ContractedProviders_2526] [Site] on #(lf)#(tab)#(tab)#(tab)[a].organisation_site_identifier_of_treatment = #(lf)#(tab)#(tab)#(tab)ISNULL([Site].[Site Code],[Site].[Organisation Code])#(lf)#(tab)#(tab)LEFT JOIN CCG_Reference.Reference.vw_DateLookup [dat] on cast([a].Week_Ending_Date_CORR as date) = [dat].[Date]#(lf)#(tab)#(tab)LEFT JOIN (select max(yearmonth) as [Max], organisation_code from [PowerBI_Reporting].[ContractMonitoring].[tbl02_PLCM_Patient_Level_2526] [a]#(lf)#(tab)#(tab)#(tab)LEFT JOIN (select distinct yearmonth, financialyear, financialmonth from CCG_Reference.Reference.vw_DateLookup) [dat] on #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)[a].[Derived_FinancialYear] = [dat].[FinancialYear] and#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)[a].financial_month = [dat].FinancialMonth#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)group by organisation_code) [Max]  on isnull(isnull([Site].[Site Code],[Prov].[Organisation Code]), [Prov2].[Site Code]) = [max].organisation_code#(lf)WHERE (Organisation_Identifier_Code_Of_Commissioner like '%11M%' or Organisation_Identifier_Code_Of_Commissioner like '%QR1%')#(lf)#(tab)#(tab)#(tab)#(tab)AND YearMonth <= [Max].[Max]#(lf)GROUP BY Waiting_List_Type,#(lf)Weeks_Waiting,#(lf)Activity_Treatment_Function_Code,#(lf)ORGANISATION_IDENTIFIER_CODE_OF_PROVIDER,#(lf)isnull(isnull([Site].[Organisation Name],[Prov].[Organisation Name]),[Prov2].[Organisation Name]),#(lf)NULLIF(ORGANISATION_SITE_IDENTIFIER_OF_TREATMENT, ''),#(lf)Week_Ending_Date_CORR,#(lf)CASE WHEN [Yearmonth] = [Max].[Max] then 1 else 0 end,#(lf)isnull(isnull([Site].[Site Code],[Prov].[Organisation Code]), [Prov2].[Site Code]),#(lf)YearMonth#(lf)#(lf)"])
				in
				    Source

