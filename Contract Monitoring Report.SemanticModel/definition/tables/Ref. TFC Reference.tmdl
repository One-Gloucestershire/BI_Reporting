		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "select ""Distinct"", ""TFC"", ""TreatmentFunctionDescription"", ""Dental Flag"" from (select row_number() over(partition by ""TFC"" order by ""TreatmentFunctionDescription"" desc) as ""Distinct"", ""TFC"", ""TreatmentFunctionDescription"", ""Dental Flag"" from (select distinct left(treatmentfunctiondescription,3) as ""TFC"", treatmentfunctiondescription as ""TreatmentFunctionDescription"", case when left(treatmentfunctiondescription,3) in ('140','141','142','143','144','145','217','450','451') then 'Dental' else 'Other' end as ""Dental Flag"" from data_mart_bireports.ooc_ipr_summary_table_pl where treatmentfunctiondescription is not null union select distinct left(""treatment function code description"",3) as ""TFC"", ""treatment function code description"" as ""TreatmentFunctionDescription"", case when left(""treatment function code description"",3) in ('140','141','142','143','144','145','217','450','451') then 'Dental' else 'Other' end as ""Dental Flag"" from data_mart_bireports.iaps_is_2526 where ""treatment function code description"" is not null union select distinct left(treatmentfunctiondescription,3) as ""TFC"", treatmentfunctiondescription as ""TreatmentFunctionDescription"", case when left(treatmentfunctiondescription,3) in ('140','141','142','143','144','145','217','450','451') then 'Dental' else 'Other' end as ""Dental Flag"" from data_mart_powerbi_contractmonitoring.tbl02_plcm_patient_level_2526 where treatmentfunctiondescription is not null) a) b where ""Distinct"" = 1", null, [EnableFolding=true])
