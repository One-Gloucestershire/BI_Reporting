ab)#(tab)#(tab)from [PowerBI_Reporting].[ContractMonitoring].[tbl02_PLCM_Patient_Level_2526]#(lf)#(tab)#(tab)#(tab)where TreatmentFunctionDescription  COLLATE Latin1_General_CI_AS is not null#(lf)#(tab)#(tab) ) AS [a]#(lf)#(tab)#(tab)) as [b]#(lf)where [b].[Distinct] = 1"])
