				                                                    "0.0%",
				                                                    "##0,0"
				    ))))))

	measure 'Quality Performance Indicator - % Trend from Previous Month' = ```
			
			
			VAR _PREV_GLOS = CALCULATE(
			    [Quality Performance Indicator - Gloucester], 
			    SAMEPERIODLASTYEAR('Date Reference Script'[date])
			)
			
			VAR _PREV_ENG = CALCULATE(
			    [Quality Performance Indicator - England - For Cards],
			    SAMEPERIODLASTYEAR('Date Reference Script'[date])
			)
			
			RETURN
			
			IF(
			    CONTAINSSTRINGEXACT(
			        MAX('Quality Performance Indicator - Organisation Selection'[Organisation]), "Gloucestershire ICB"),
			        ([Quality Performance Indicator - Gloucester] - _PREV_GLOS) / [Quality Performance Indicator - Gloucester],
			        ([Quality Performance Indicator - England - For Cards] - _PREV_ENG) / [Quality Performance Indicator - England - For Cards]
			)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 20cffed3-8d52-4265-99b8-b64fd57e7a50

	measure 'QPI - Organisation Selection' =
			
			
			IF(
			    CONTAINSSTRINGEXACT(
			        MAX('Quality Performance Indicator - Organisation Selection'[Organisation]), "Gloucestershire ICB"),
			        [Quality Performance Indicator - Gloucester],
			        [Quality Performance Indicator - England - For Cards]
			)
		lineageTag: c9c41fbf-a181-4762-993e-7cafab5f9305

