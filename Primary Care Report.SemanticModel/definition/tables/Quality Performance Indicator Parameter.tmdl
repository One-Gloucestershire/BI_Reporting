table 'Quality Performance Indicator Parameter'
	lineageTag: 91f085ad-4d44-4d21-8793-61cccb483aa3

	measure 'Quality Performance Indicator Parameter Selection' =
			
			
			MAX('Quality Performance Indicator Parameter'[Parameter])
		lineageTag: e793852c-7e5b-495b-bbbb-0f8a65df026b

	measure 'Quality Performance Indicator - Gloucester' =
			
			
			IF(
			    CONTAINSSTRINGEXACT('Quality Performance Indicator Parameter'[Quality Performance Indicator Parameter Selection], "Total Appointments per Month"),
			        'National Appointments'[Total National Appointments - Gloucestershire],
			    IF(
			    CONTAINSSTRINGEXACT('Quality Performance Indicator Parameter'[Quality Performance Indicator Parameter Selection], "Appointments per 1,000 Patients"),
			        'National Category'[NC - Rate per 1,000 - Glos],
			        IF(
			            CONTAINSSTRINGEXACT('Quality Performance Indicator Parameter'[Quality Performance Indicator Parameter Selection], "Average Daily Appointments"),
			                'National Appointments'[Average Daily Appointments - Gloucestershire],
			                    IF(
			                        CONTAINSSTRINGEXACT('Quality Performance Indicator Parameter'[Quality Performance Indicator Parameter Selection], "Total Number of GP Appointments"),
			                            'National Appointments'[National Appointments - GP - Gloucestershire],
			                                IF(
			                                    CONTAINSSTRINGEXACT('Quality Performance Indicator Parameter'[Quality Performance Indicator Parameter Selection], "% F2F Appointments"),
			                                        'National Appointments'[National Appointments - % F2F Glos],
			                                            IF(
			                                                CONTAINSSTRINGEXACT('Quality Performance Indicator Parameter'[Quality Performance Indicator Parameter Selection], "% Appointments up to 14 Days"),
			                                                    'National Appointments'[National Appointments - % within 14 Days Glos],
			                                                    0
			    ))))))
		lineageTag: d2550acc-5ca6-4d44-b899-038ca6903b91

		formatStringDefinition =
				IF(
				    CONTAINSSTRINGEXACT('Quality Performance Indicator Parameter'[Quality Performance Indicator Parameter Selection], "Total Appointments per Month"),
				        "0,0",
				    IF(
				    CONTAINSSTRINGEXACT('Quality Performance Indicator Parameter'[Quality Performance Indicator Parameter Selection], "Appointments per 1,000 Patients"),
				        "0,0",
				        IF(
				            CONTAINSSTRINGEXACT('Quality Performance Indicator Parameter'[Quality Performance Indicator Parameter Selection], "Average Daily Appointments"),
				                "0,0",
				                    IF(
				                        CONTAINSSTRINGEXACT('Quality Performance Indicator Parameter'[Quality Performance Indicator Parameter Selection], "Total Number of GP Appointments"),
				                            "0,0",
				                                IF(
				                                    CONTAINSSTRINGEXACT('Quality Performance Indicator Parameter'[Quality Performance Indicator Parameter Selection], "% F2F Appointments"),
				                                        "0.0%",
				                                            IF(
				                                                CONTAINSSTRINGEXACT('Quality Performance Indicator Parameter'[Quality Performance Indicator Parameter Selection], "% Appointments up to 14 Days"),
				                                                    "0.0%",
				                                                    "0,0"
				    ))))))

	measure 'Quality Performance Indicator - England - Separate Axis' =
			
			
			IF(
			    CONTAINSSTRINGEXACT('Quality Performance Indicator Parameter'[Quality Performance Indicator Parameter Selection], "Total Appointments per Month"),
			        'National Appointments'[Total National Appointments - England],
			    IF(
			    CONTAINSSTRINGEXACT('Quality Performance Indicator Parameter'[Quality Performance Indicator Parameter Selection], "Appointments per 1,000 Patients"),
			        BLANK(),
			        IF(
			            CONTAINSSTRINGEXACT('Quality Performance Indicator Parameter'[Quality Performance Indicator Parameter Selection], "Average Daily Appointments"),
			                'National Appointments'[Average Daily Appointments - England],
			                    IF(
			                        CONTAINSSTRINGEXACT('Quality Performance Indicator Parameter'[Quality Performance Indicator Parameter Selection], "Total Number of GP Appointments"),
			                            'National Appointments'[National Appointments - GP - England],
			                                IF(
			                                    CONTAINSSTRINGEXACT('Quality Performance Indicator Parameter'[Quality Performance Indicator Parameter Selection], "% F2F Appointments"),
			                                        BLANK(),
			                                            IF(
			                                                CONTAINSSTRINGEXACT('Quality Performance Indicator Parameter'[Quality Performance Indicator Parameter Selection], "% Appointments up to 14 Days"),
			                                                    BLANK(),
			                                                    0
			    ))))))
		lineageTag: f81fe925-e6e0-4b7c-9df8-db5212a8dc14

		formatStringDefinition =
				IF(
				    CONTAINSSTRINGEXACT('Quality Performance Indicator Parameter'[Quality Performance Indicator Parameter Selection], "Total Appointments per Month"),
				        "##0,0",
				    IF(
				    CONTAINSSTRINGEXACT('Quality Performance Indicator Parameter'[Quality Performance Indicator Parameter Selection], "Appointments per 1,000 Patients"),
