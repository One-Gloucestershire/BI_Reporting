table 'National ICB Populations'
	lineageTag: 89980d00-36db-4084-8fb4-db8a8ef7d97c

	measure 'Rate per 1,000 - England' =
			
			
			VAR _APPOINTMENTS = SUM('National Appointments'[COUNT_OF_APPOINTMENTS])
			VAR _POPULATION = CALCULATE(SUM('National ICB Populations'[Population]), 'National ICB Populations'[MonthName] = "Apr")
			
			RETURN CALCULATE(DIVIDE(_APPOINTMENTS, _POPULATION) * 1000)
		formatString: #,0.0
		lineageTag: 43409d51-d0eb-4543-868f-200a988b4b51

	measure 'April Populations' =
			
			
			CALCULATE(SUM('National ICB Populations'[Population]), 'National ICB Populations'[MonthName] = "Apr")
		formatString: 0
		lineageTag: cd5ba2c9-1baf-4cb0-960d-b73a3c3b8b10

	measure 'Rate per 1,000 - South West Region' =
			
			
			VAR _APPOINTMENTS = CALCULATE(SUM('National Appointments'[COUNT_OF_APPOINTMENTS]), 'ICB Mapping'[Region Name] = "South West")
			VAR _POPULATION = CALCULATE(SUM('National ICB Populations'[Population]), 'National ICB Populations'[MonthName] = "Apr", 'ICB Mapping'[Region Name] = "South West")
			
			RETURN CALCULATE(DIVIDE(_APPOINTMENTS, _POPULATION) * 1000)
		formatString: #,0.0
		lineageTag: 547b7131-9231-4fb5-95d6-681f0d7e7654

	measure 'Rate per 1,000 - Gloucestershire' =
			
			
			VAR _APPOINTMENTS = CALCULATE(SUM('National Appointments'[COUNT_OF_APPOINTMENTS]), 'ICB Mapping'[ICB_Name] = "NHS Gloucestershire Integrated Care Board")
			VAR _POPULATION = CALCULATE(SUM('National ICB Populations'[Population]), 'National ICB Populations'[MonthName] = "Apr", 'ICB Mapping'[ICB_Name] = "NHS Gloucestershire Integrated Care Board")
			
			RETURN CALCULATE(DIVIDE(_APPOINTMENTS, _POPULATION) * 1000)
		formatString: #,0.0
		lineageTag: b11cc51d-ce56-457f-aa67-a17b0ce67d30

	measure 'Rate per 1,000 - ICBs' =
			
			
			VAR _APPOINTMENTS = SUM('National Appointments'[COUNT_OF_APPOINTMENTS])
			VAR _POPULATION = CALCULATE(SUM('National ICB Populations'[Population]), 'National ICB Populations'[MonthName] = "Apr")
			
			RETURN CALCULATE(DIVIDE(_APPOINTMENTS, _POPULATION) * 1000)
		lineageTag: f2260397-a20d-42db-9eba-1217808d67f3

