table 'Gloucester GP Appointments Detailed'
	lineageTag: e83d6e23-da72-4205-87ab-94bce9df35e4

	measure '% Clinically Urgent Patients seen Same Day' =
			
			
			[Clinically Urgent Appointments - Numerator] / [Clinically Urgent Appointments - Denominator]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 18dc3415-0c87-4cd8-a37f-744c6297a76e

	measure '% Clinically Urgent Patients - Title' =
			
			
			CONCATENATE("% Clinically Urgent Patients seen Same Day - ", MAX('Date Reference Script'[month_year_name]))
		lineageTag: a198559e-c74c-4832-beb3-7f54345e22fc

	measure 'Clinically Urgent Appointments - Denominator' =
			
			
			CALCULATE(
			    SUM('Gloucester GP Appointments Detailed'[COUNT_OF_APPOINTMENTS])
			    ,'Gloucester GP Appointments Detailed'[NATIONAL_CATEGORY] = "General Consultation Acute"
			)
		formatString: #,0
		lineageTag: d15e574b-131e-4f93-ad56-3d099beb3f6f

	measure 'Clinically Urgent Appointments - Numerator' =
			
			
			CALCULATE(
			    SUM('Gloucester GP Appointments Detailed'[COUNT_OF_APPOINTMENTS])
			    ,'Gloucester GP Appointments Detailed'[NATIONAL_CATEGORY] = "General Consultation Acute"
			    ,'Gloucester GP Appointments Detailed'[TIME_BETWEEN_BOOK_AND_APPT] = "Same Day"
			)
		formatString: #,0
		lineageTag: 25eacfb6-6b26-441a-a30f-bbdb0d9175f5

	column FinancialYear
		dataType: string
		lineageTag: 84bf0c95-5d86-4b8e-8000-9117efc3a9c5
		summarizeBy: none
		sourceColumn: FinancialYear

		annotation SummarizationSetBy = Automatic

	column MonthName
		dataType: string
		lineageTag: 0f242cb8-b11d-4f6d-ad30-f8f1d470c5cb
		summarizeBy: none
		sourceColumn: MonthName

		annotation SummarizationSetBy = Automatic

	column FirstDateofMonth
		dataType: dateTime
		formatString: General Date
		lineageTag: 1efd84f4-42f2-4ad5-912b-d853cfbc09a9
		summarizeBy: none
		sourceColumn: FirstDateofMonth

		annotation SummarizationSetBy = Automatic

	column GP_CODE
		dataType: string
		lineageTag: 3e34d29b-e6cc-4a07-97d8-2c81b043c8d4
		summarizeBy: none
		sourceColumn: GP_CODE

		annotation SummarizationSetBy = Automatic

	column HCP_TYPE
		dataType: string
		lineageTag: a0dc72bf-d1a4-4023-bdf9-b56e935a0a5c
		summarizeBy: none
		sourceColumn: HCP_TYPE

		annotation SummarizationSetBy = Automatic

