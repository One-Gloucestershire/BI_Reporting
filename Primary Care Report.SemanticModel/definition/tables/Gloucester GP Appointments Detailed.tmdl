	column COUNT_OF_APPOINTMENTS
		dataType: int64
		formatString: 0
		lineageTag: 8dbdf10c-57e0-4436-b8f7-9d4b85e25f69
		summarizeBy: sum
		sourceColumn: COUNT_OF_APPOINTMENTS

		annotation SummarizationSetBy = Automatic

	partition 'Gloucester GP Appointments Detailed' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Current", [Query="WITH GP_APP_CTE AS#(lf)(#(lf)SELECT [APPOINTMENT_MONTH_START_DATE] = CASE WHEN LEN(REPLACE([APPOINTMENT_MONTH_START_DATE], '-', '')) <= 7 #(lf)                                             THEN LOWER(REPLACE(STUFF([APPOINTMENT_MONTH_START_DATE], 8, 0, '20'), '-', ''))#(lf)                                             ELSE [APPOINTMENT_MONTH_START_DATE] END#(lf)      ,[GP_CODE]#(lf)      ,[GP_NAME]#(lf)      ,[SUPPLIER]#(lf)      ,[PCN_CODE]#(lf)      ,[PCN_NAME]#(lf)      ,[SUB_ICB_LOCATION_CODE]#(lf)      ,[SUB_ICB_LOCATION_NAME]#(lf)      ,[HCP_TYPE]#(lf)      ,[APPT_MODE]#(lf)      ,[NATIONAL_CATEGORY]#(lf)      ,[TIME_BETWEEN_BOOK_AND_APPT]#(lf)      ,[COUNT_OF_APPOINTMENTS]#(lf)      ,[APPT_STATUS]#(lf)#(lf)FROM [BIReports].[dbo].[Gloucestershire_GP_Appointments_All]#(lf))#(lf)SELECT [DATE].[FinancialYear]#(lf)      ,[DATE].[MonthName]#(lf)      ,[DATE].[FirstDateofMonth]#(lf)      ,[GP_APP].[GP_CODE]#(lf)      ,[GP_APP].[HCP_TYPE]#(lf)      ,[GP_APP].[APPT_MODE]#(lf)      ,[GP_APP].[NATIONAL_CATEGORY]#(lf)      ,[GP_APP].[TIME_BETWEEN_BOOK_AND_APPT]#(lf)      ,[GP_APP].[APPT_STATUS]#(lf)      ,[GP_APP].[COUNT_OF_APPOINTMENTS]#(lf)#(lf)FROM GP_APP_CTE AS [GP_APP]#(lf)#(lf)INNER JOIN (#(lf)            SELECT DISTINCT [MonthYearName] = LOWER(REPLACE([MonthYearName], '-', ''))#(lf)                           ,[FinancialYear]#(lf)#(tab)                 ,[MonthName] = LEFT([MonthName], 3)#(lf)#(tab)#(tab)       ,[FirstDateofMonth]#(lf)   #(lf)            FROM [CCG_Reference].[Reference].[vw_DateLookup]#(lf)            WHERE [FinancialYear] >= '2023/24'#(lf)           ) AS [DATE]#(lf)ON [DATE].[MonthYearName] = RIGHT([GP_APP].[APPOINTMENT_MONTH_START_DATE], 7)"])
				in
				    Source

	annotation PBI_ResultType = Table

