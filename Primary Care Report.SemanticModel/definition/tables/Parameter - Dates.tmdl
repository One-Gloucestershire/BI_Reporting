table 'Parameter - Dates'
	lineageTag: 1ae51e30-91f5-41e4-b2a8-adb8fe3f5527

	measure '% Same Day for Date Parameter' =
			
			
			VAR _SAMEDAY = IF(CONTAINSSTRING('Parameter - Dates'[Parameter 2 Selected Option], "Latest Month") = TRUE(),
			    CALCULATE(SUM('Glos Practice Appointments'[COUNT_OF_APPOINTMENTS]), 'Glos Practice Appointments'[TIME_BETWEEN_BOOK_AND_APPT] = "Same Day", 'Date Reference Script'[latest_month_flag] = 1),
			    IF(CONTAINSSTRING('Parameter - Dates'[Parameter 2 Selected Option], "Last 6 Months") = TRUE(),
			    CALCULATE(SUM('Glos Practice Appointments'[COUNT_OF_APPOINTMENTS]), 'Glos Practice Appointments'[TIME_BETWEEN_BOOK_AND_APPT] = "Same Day", 'Date Reference Script'[latest_6_months_flag] = 1),
			    IF(CONTAINSSTRING('Parameter - Dates'[Parameter 2 Selected Option], "Last 12 Months") = TRUE(),
			    CALCULATE(SUM('Glos Practice Appointments'[COUNT_OF_APPOINTMENTS]), 'Glos Practice Appointments'[TIME_BETWEEN_BOOK_AND_APPT] = "Same Day", 'Date Reference Script'[latest_12_months_flag] = 1),
			    CALCULATE(SUM('Glos Practice Appointments'[COUNT_OF_APPOINTMENTS]), 'Glos Practice Appointments'[TIME_BETWEEN_BOOK_AND_APPT] = "Same Day", 'Date Reference Script'[ytd_flag] = 1))))
			
			VAR _TOTAL = IF(CONTAINSSTRING('Parameter - Dates'[Parameter 2 Selected Option], "Latest Month") = TRUE(),
			    CALCULATE(SUM('Glos Practice Appointments'[COUNT_OF_APPOINTMENTS]), 'Date Reference Script'[latest_month_flag] = 1),
			    IF(CONTAINSSTRING('Parameter - Dates'[Parameter 2 Selected Option], "Last 6 Months") = TRUE(),
			    CALCULATE(SUM('Glos Practice Appointments'[COUNT_OF_APPOINTMENTS]), 'Date Reference Script'[latest_6_months_flag] = 1),
			    IF(CONTAINSSTRING('Parameter - Dates'[Parameter 2 Selected Option], "Last 12 Months") = TRUE(),
			    CALCULATE(SUM('Glos Practice Appointments'[COUNT_OF_APPOINTMENTS]), 'Date Reference Script'[latest_12_months_flag] = 1),
			    CALCULATE(SUM('Glos Practice Appointments'[COUNT_OF_APPOINTMENTS]), 'Date Reference Script'[ytd_flag] = 1))))
			
			RETURN DIVIDE(_SAMEDAY, _TOTAL)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 4fd084d1-2f76-419f-8f8f-5edfe9e2ecec

	measure 'Parameter 2 Selected Option' =
			
			
			MAX('Parameter - Dates'[Parameter])
		lineageTag: 808d10df-4aef-4094-87de-4d7403591fdd

	measure '% F2F for Date Parameter' =
			
			
