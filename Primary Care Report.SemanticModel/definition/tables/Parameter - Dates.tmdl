			    IF(CONTAINSSTRING('Parameter - Dates'[Parameter 2 Selected Option], "Last 6 Months") = TRUE(),
			    CALCULATE(SUM('Glos Practice Appointments'[COUNT_OF_APPOINTMENTS]), 'Glos Practice Appointments'[APPT_MODE] = "Face-to-Face", 'Date Reference Script'[latest_6_months_flag] = 1),
