table 'National Appointments'
	lineageTag: 71c12808-04dc-4f6a-9ed1-6d340d789f1c

	measure 'National Trendline - All Appointments' = ```
			
			
			VAR Temp_Table = 
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED( 'Date Reference Script'[financial_year], 'Date Reference Script'[financial_month],
			                         'Date Reference Script'[month_name], 'Date Reference Script'[month_number] ),
			            "Value_x", 'Date Reference Script'[month_number],
			            "Value_y", 'National Appointments'[Total National Appointments - Gloucestershire]
			        ),
			        AND (
			            NOT ( ISBLANK ( "Value_x" ) ),
			            NOT ( ISBLANK ( "Value_y" ) )
			        )
			    )
			
			VAR LINESTX_Table = 
			    LINESTX(Temp_Table, [Value_y], [Value_x], TRUE)
			VAR Slope = 
			    MAXX ( LINESTX_Table, [Slope1] )
			VAR Intercept = 
			    MAXX ( LINESTX_Table, [Intercept] )
			
			RETURN
			    SUMX (
			        DISTINCT ( 'Date Reference Script'[month_number] ),
			        Intercept + Slope * 'Date Reference Script'[month_number]
			    )
			```
		lineageTag: dc934802-dbcc-4731-8567-c2711b4fa34a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total National Appointments - Gloucestershire' =
			
			
			CALCULATE(SUM('National Appointments'[COUNT_OF_APPOINTMENTS]), 'National Appointments'[ICB_Name] = "NHS Gloucestershire Integrated Care Board")
		formatString: #,0
		lineageTag: 158e022f-e913-4083-829d-7c586f79f4e8

	measure 'National GP 19/20 Baseline' =
			
			
			VAR _1920B = CALCULATE(SUM('National Appointments'[COUNT_OF_APPOINTMENTS]), 'Date Reference Script'[financial_year] = "2019/20")
			
			RETURN _1920B/12
		formatString: #,0
		lineageTag: d54a7487-ef6c-455e-af10-f0fa9f82b5f2

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'National Latest Year Baseline' =
			
			
			VAR _YTDMONTHS = CALCULATE(DISTINCTCOUNT('Date Reference Script'[month]), 'Date Reference Script'[ytd_flag] = 1)
			VAR _LATESTYEARPOP = CALCULATE(SUM('National Appointments'[COUNT_OF_APPOINTMENTS]), 'Date Reference Script'[financial_year] = MAX('Date Reference Script'[financial_year]))
			
			RETURN _LATESTYEARPOP/_YTDMONTHS
		formatString: #,0
		lineageTag: d93f227d-322c-46bd-8670-c9e4e6dfe884

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'National Appointments - Latest Year Growth %' = ```
			
			
			VAR _YTDMONTHS = CALCULATE(DISTINCTCOUNT('Date Reference Script'[month]), 'Date Reference Script'[ytd_flag] = 1)
			VAR _LATESTYEARPOP = CALCULATE(SUM('National Appointments'[COUNT_OF_APPOINTMENTS]), 'Date Reference Script'[financial_year] = MAX('Date Reference Script'[financial_year]))
			
			RETURN 
			
			((_LATESTYEARPOP/_YTDMONTHS)-[National GP 19/20 Baseline])/[National GP 19/20 Baseline]
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e76f0f9c-ec60-4b27-aa47-8ddb34c4792b

