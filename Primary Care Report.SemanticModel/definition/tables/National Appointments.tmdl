	partition 'National Appointments' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "BIReports", [Query="SELECT DISTINCT [GP].*#(lf)             ,[DATE].[LastDateofMonth]#(lf)FROM [PowerBI_Reporting].[primarycare].[tbl09_National_GP_Appointments] AS [GP]#(lf)#(lf)LEFT JOIN (SELECT DISTINCT [LastDateofMonth], [MonthYearName] FROM [CCG_Reference].[Reference].[vw_DateLookup]) AS DATE ON [DATE].[MonthYearName] = [GP].[MONTH_YEAR]"])
				in
				    Source

	annotation PBI_ResultType = Table

