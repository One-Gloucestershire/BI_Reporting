		lineageTag: cb057693-6387-4f00-8a7d-4e7ee65e06b4

	measure 'Test Parameter Measure' =
			
			
			IF ( CONTAINSSTRING('Parameter - Total vs YTD'[Parameter 1 Selected Option], "Total Appointments"), SUM('Glos Practice Appointments'[COUNT_OF_APPOINTMENTS]), 0)
		formatString: 0
		lineageTag: 45ca182a-4780-415d-9d2c-fddfda932651

