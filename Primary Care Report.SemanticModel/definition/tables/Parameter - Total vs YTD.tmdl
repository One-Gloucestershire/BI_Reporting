table 'Parameter - Total vs YTD'
	lineageTag: bb2e18f2-e1bc-40f6-be8a-baf12138cb0b

	measure 'Parameter 2' = ```
			
			
			IF(CONTAINSSTRING('Parameter - Total vs YTD'[Parameter 1 Selected Option], "Total Appointments"), SUM('Glos Practice Appointments'[COUNT_OF_APPOINTMENTS]), 
			IF(CONTAINSSTRING('Parameter - Total vs YTD'[Parameter 1 Selected Option], "YTD Total Appointments"), CALCULATE(SUM('Glos Practice Appointments'[COUNT_OF_APPOINTMENTS]), 'Date Reference Script'[ytd_flag] = 1), 0))
			```
		formatString: #,0
		lineageTag: 01c72159-9273-4c64-a4db-ac738553c435

	measure 'Parameter 1 Selected Option' =
			
			
