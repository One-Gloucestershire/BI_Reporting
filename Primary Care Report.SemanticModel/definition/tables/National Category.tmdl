	measure 'NC - Rate per 1,000 - SW' =
			
			
			VAR _APP = CALCULATE(SUM('National Category'[Appointments]), 'National Category'[Region_Name] = "South West")
			VAR _POP = CALCULATE(SUM('National ICB Populations'[Population]), 'National ICB Populations'[MonthName] = "Apr", 'National ICB Populations'[Region_Name] = "South West")
			RETURN
			
			(_APP/_POP)*1000
		lineageTag: 0aa2b52b-a2e5-48b5-aab0-19c4bc303c34

