			    CALCULATE(SUM('National Category'[Appointments]), 'Date Reference Script'[ytd_flag] = 1, 'National Category'[Region_Name] = "South West") / CALCULATE(SUM('National Category'[Appointments]), ALL('National Category'[National_Category]), 'Date Reference Script'[ytd_flag] = 1, 'National Category'[Region_Name] = "South West"),
