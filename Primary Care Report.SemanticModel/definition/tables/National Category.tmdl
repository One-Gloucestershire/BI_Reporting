	measure 'NC - Card Measure - England' = ```
			
			
			IF ( 
			    AND ( CONTAINSSTRING ('Parameter - National Category'[Parameter NC Selected Option], "% of Total Appointments") = TRUE(), CONTAINSSTRING ('Parameter - Dates'[Parameter 2 Selected Option], "Latest Month") = TRUE()), 
			    CALCULATE(SUM('National Category'[Appointments]), 'Date Reference Script'[latest_month_flag] = 1) / CALCULATE(SUM('National Category'[Appointments]), ALL('National Category'[National_Category]), 'Date Reference Script'[latest_month_flag] = 1),
			IF (
			    AND ( CONTAINSSTRING ('Parameter - National Category'[Parameter NC Selected Option], "% of Total Appointments") = TRUE(), CONTAINSSTRING ('Parameter - Dates'[Parameter 2 Selected Option], "Last 6 Months") = TRUE()),
			    CALCULATE(SUM('National Category'[Appointments]), 'Date Reference Script'[latest_6_months_flag] = 1) / CALCULATE(SUM('National Category'[Appointments]), ALL('National Category'[National_Category]), 'Date Reference Script'[latest_6_months_flag] = 1),
			IF (
			    AND ( CONTAINSSTRING ('Parameter - National Category'[Parameter NC Selected Option], "% of Total Appointments") = TRUE(), CONTAINSSTRING ('Parameter - Dates'[Parameter 2 Selected Option], "Last 12 Months") = TRUE()),
			    CALCULATE(SUM('National Category'[Appointments]), 'Date Reference Script'[latest_12_months_flag] = 1) / CALCULATE(SUM('National Category'[Appointments]), ALL('National Category'[National_Category]), 'Date Reference Script'[latest_12_months_flag] = 1),
			IF (
			    AND ( CONTAINSSTRING ('Parameter - National Category'[Parameter NC Selected Option], "% of Total Appointments") = TRUE(), CONTAINSSTRING ('Parameter - Dates'[Parameter 2 Selected Option], "Current YTD") = TRUE()),
			    CALCULATE(SUM('National Category'[Appointments]), 'Date Reference Script'[ytd_flag] = 1, 'Date Reference Script'[financial_year] = MAX('Date Reference Script'[financial_year])) / CALCULATE(SUM('National Category'[Appointments]), ALL('National Category'[National_Category]), 'Date Reference Script'[ytd_flag] = 1, 'Date Reference Script'[financial_year] = MAX('Date Reference Script'[financial_year])),
			IF (
			    AND ( CONTAINSSTRING ('Parameter - National Category'[Parameter NC Selected Option], "Crude Rate per 1,000") = TRUE(), CONTAINSSTRING ('Parameter - Dates'[Parameter 2 Selected Option], "Latest Month") = TRUE()),
			    (CALCULATE(SUM('National Category'[Appointments]), 'Date Reference Script'[latest_month_flag] = 1) / CALCULATE([April Populations], 'National ICB Populations'[FinancialYear] = MAX('Date Reference Script'[financial_year])))*1000,
			IF (
			    AND ( CONTAINSSTRING ('Parameter - National Category'[Parameter NC Selected Option], "Crude Rate per 1,000") = TRUE(), CONTAINSSTRING ('Parameter - Dates'[Parameter 2 Selected Option], "Last 6 Months") = TRUE()),
			    ((CALCULATE(SUM('National Category'[Appointments]), 'Date Reference Script'[latest_6_months_flag] = 1)/6) / CALCULATE([April Populations], 'National ICB Populations'[FinancialYear] = MAX('Date Reference Script'[financial_year])))*1000,
			IF (
			    AND ( CONTAINSSTRING ('Parameter - National Category'[Parameter NC Selected Option], "Crude Rate per 1,000") = TRUE(), CONTAINSSTRING ('Parameter - Dates'[Parameter 2 Selected Option], "Last 12 Months") = TRUE()),
			    ((CALCULATE(SUM('National Category'[Appointments]), 'Date Reference Script'[latest_12_months_flag] = 1)/12) / CALCULATE([April Populations], 'National ICB Populations'[FinancialYear] = MAX('Date Reference Script'[financial_year])))*1000,
			IF (
			    AND ( CONTAINSSTRING ('Parameter - National Category'[Parameter NC Selected Option], "Crude Rate per 1,000") = TRUE(), CONTAINSSTRING ('Parameter - Dates'[Parameter 2 Selected Option], "Current YTD") = TRUE()),
			    ((CALCULATE(SUM('National Category'[Appointments]), 'Date Reference Script'[ytd_flag] = 1, 'Date Reference Script'[financial_year] = MAX('Date Reference Script'[financial_year]))/[Distinct Months]) / CALCULATE([April Populations], 'National ICB Populations'[FinancialYear] = MAX('Date Reference Script'[financial_year])))*1000, "There is an Error"))))))))
			```
		lineageTag: f7426e0c-0dd6-4715-9c0f-072caaaacf96

		formatStringDefinition = IF ( CONTAINSSTRING('Parameter - National Category'[Parameter NC Selected Option], "% of Total Appointments"), "#,0.0%", "#,0.0")

