			IF (
			    AND ( CONTAINSSTRING ('Parameter - National Category'[Parameter NC Selected Option], "Crude Rate per 1,000") = TRUE(), CONTAINSSTRING ('Parameter - Dates'[Parameter 2 Selected Option], "Last 12 Months") = TRUE()),
			    ((CALCULATE(SUM('National Category'[Appointments]), 'Date Reference Script'[latest_12_months_flag] = 1, 'National Category'[Region_Name] = "South West")/12) / CALCULATE([April Populations], 'National ICB Populations'[Extract_Date] = MAX('National ICB Populations'[Extract_Date]), 'National ICB Populations'[Region_Name] = "South West"))*1000,
			IF (
			    AND ( CONTAINSSTRING ('Parameter - National Category'[Parameter NC Selected Option], "Crude Rate per 1,000") = TRUE(), CONTAINSSTRING ('Parameter - Dates'[Parameter 2 Selected Option], "Current YTD") = TRUE()),
			    ((CALCULATE(SUM('National Category'[Appointments]), 'Date Reference Script'[ytd_flag] = 1, 'Date Reference Script'[financial_year] = MAX('Date Reference Script'[financial_year]), 'National Category'[Region_Name] = "South West")/[Distinct Months]) / CALCULATE([April Populations], 'National ICB Populations'[Extract_Date] = MAX('National ICB Populations'[Extract_Date]), 'National ICB Populations'[Region_Name] = "South West"))*1000, "There is an Error"))))))))
