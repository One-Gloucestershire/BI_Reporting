	measure 'NC - England Measure' =
			
			
			IF(CONTAINSSTRING([Parameter NC Selected Option], "% of Total Appointments"), [% of NC - England], [NC - Rate per 1,000 - England])
		lineageTag: cf8f89cb-3705-459d-bffd-ebec63adaa20

		formatStringDefinition = IF ( CONTAINSSTRING('Parameter - National Category'[Parameter NC Selected Option], "% of Total Appointments"), "#,0.0%", "#,0.0")

