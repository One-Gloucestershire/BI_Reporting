table 'National Category'
	lineageTag: ab430003-2bb3-4b8c-88e5-8847c2c4fe89

	measure 'NC - England Appointments Static' =
			
			
			CALCULATE(SUM('National Category'[Appointments]), ALL('National Category'[National_Category]))
		formatString: 0
		lineageTag: 630dbd2c-f984-40f1-ae82-b7da4adf418c

	measure 'NC - SW Appointments Static' =
			
			
			CALCULATE(SUM('National Category'[Appointments]), ALL('National Category'[National_Category]), 'National Category'[Region_Name] = "South West")
		formatString: 0
		lineageTag: f281e511-ff82-413f-a969-9cf6809a2e0a

	measure 'NC - Glos Appointments Static' =
			
			
			CALCULATE(SUM('National Category'[Appointments]), ALL('National Category'[National_Category]), 'National Category'[ICB_Name] = "NHS Gloucestershire Integrated Care Board")
		formatString: 0
		lineageTag: 8b4823ae-d5a6-4e4e-9491-f4aeb068a9dc

	measure '% of NC - Glos' =
			
			
			VAR _EVENTS = CALCULATE(SUM('National Category'[Appointments]), 'National Category'[ICB_Name] = "NHS Gloucestershire Integrated Care Board")
			
			RETURN
			
			_EVENTS/[NC - Glos Appointments Static]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 3ac96313-29c0-4a99-89e3-501b01578942

	measure 'NC - Rate per 1,000 - Glos' =
			
			
			VAR _APP = CALCULATE(SUM('National Category'[Appointments]), 'National Category'[ICB_Name] = "NHS Gloucestershire Integrated Care Board")
			VAR _POP = CALCULATE(SUM('National ICB Populations'[Population]), 'National ICB Populations'[MonthName] = "Apr", 'National ICB Populations'[ICB_Name] = "NHS Gloucestershire Integrated Care Board")
			
			RETURN
			
			(_APP/_POP)*1000
		lineageTag: 4f73e239-31fa-4723-a39f-0e76c560fdfe

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% of NC - SW' =
			
			
