	partition 'Gloucestershire Patients' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Reference", [Query="SET NOCOUNT ON#(lf)SET ANSI_WARNINGS OFF#(lf)#(lf)  /*===============================================================================================================#(lf)Section One - Establishing Attended GP Appointments#(lf)===============================================================================================================*/#(lf)#(lf)IF OBJECT_ID ('TEMPDB..#TEMP_GP_Appointments') IS NOT NULL DROP TABLE #TEMP_GP_Appointments#(lf);#(lf)#(lf)SELECT DISTINCT [APP].[PseudoNHSNumber]#(lf)               ,[12M].[appointment_in_last_12_months]#(lf)#(tab)#(tab)#(tab)   ,[number_of_appointments_12_months] = [12M].[Appointments]#(lf)#(tab)#(tab)#(tab)   ,[6M].[appointment_in_last_6_months]#(lf)#(tab)#(tab)#(tab)   ,[number_of_appointments_6_months] = [6M].[Appointments]#(lf)#(lf)INTO #TEMP_GP_Appointments#(lf)FROM [CCG_Current].[PrimaryCare].[vw_Appointments] AS [APP]#(lf)#(lf)LEFT JOIN#(lf)(#(lf)SELECT DISTINCT [PseudoNHSNumber]#(lf)               ,[appointment_in_last_12_months] = 'Yes'#(lf)               ,[Appointments] = COUNT(DISTINCT [ID])#(lf)FROM [CCG_Current].[PrimaryCare].[vw_Appointments]#(lf)WHERE [AppointmentStatus] IN ('Face to Face - Arrived', 'Face to Face - Finished', 'Face to Face - In Progress', #(lf)                               'Telephone - Arrived', 'Telephone - Finished', 'Telephone - In Progress')#(lf)AND CAST([AppointmentDate] AS DATE) BETWEEN EOMONTH ( DATEADD ( MONTH, -12, GETDATE() ) ) AND EOMONTH ( DATEADD ( MONTH, -1, GETDATE() ) ) #(lf)#(lf)GROUP BY [PseudoNHSNumber]#(lf)) AS [12M] ON [12M].[PseudoNHSNumber] = [APP].[PseudoNHSNumber]#(lf)#(lf)LEFT JOIN#(lf)(#(lf)SELECT DISTINCT [PseudoNHSNumber]#(lf)               ,[appointment_in_last_6_months] = 'Yes'#(lf)               ,[Appointments] = COUNT(DISTINCT [ID])#(lf)#(lf)FROM [CCG_Current].[PrimaryCare].[vw_Appointments]#(lf)WHERE [AppointmentStatus] IN ('Face to Face - Arrived', 'Face to Face - Finished', 'Face to Face - In Progress', #(lf)                               'Telephone - Arrived', 'Telephone - Finished', 'Telephone - In Progress')#(lf)AND CAST([AppointmentDate] AS DATE) BETWEEN EOMONTH ( DATEADD ( MONTH, -6, GETDATE() ) ) AND EOMONTH ( DATEADD ( MONTH, -1, GETDATE() ) ) #(lf)#(lf)GROUP BY [PseudoNHSNumber]#(lf)) AS [6M] ON [6M].[PseudoNHSNumber] = [APP].[PseudoNHSNumber]#(lf)#(lf)WHERE [AppointmentStatus] IN ('Face to Face - Arrived', 'Face to Face - Finished', 'Face to Face - In Progress', #(lf)                               'Telephone - Arrived', 'Telephone - Finished', 'Telephone - In Progress')#(lf)AND CAST([AppointmentDate] AS DATE) BETWEEN EOMONTH ( DATEADD ( MONTH, -12, GETDATE() ) ) AND EOMONTH ( DATEADD ( MONTH, -1, GETDATE() ) ) #(lf);#(lf)#(lf)  /*===============================================================================================================#(lf)Section Two - Final Table#(lf)===============================================================================================================*/#(lf)#(lf)SELECT DISTINCT [PDS].[Derived_NHS_Number]#(lf)               ,[Counter] = 1#(lf)#(tab)#(tab)#(tab)   ,[GP].[Locality]#(lf)#(tab)#(tab)#(tab)   ,[GP].[PrimaryCareNetwork]#(lf)#(tab)#(tab)#(tab)   ,[GP].[ReportingOrganisationName]#(lf)               ,[GP].[OrganisationCode]#(lf)#(tab)#(tab)#(tab)   ,[COORD].[gp_latitude]#(lf)#(tab)#(tab)#(tab)   ,[COORD].[gp_longitude]#(lf)#(tab)#(tab)#(tab)   ,[PDS].[Derived_Age]#(lf)#(tab)#(tab)#(tab)   ,[Broad_Age_Banding] = CASE WHEN [PDS].[Derived_Age] BETWEEN 0 AND 17 THEN '0-17 - Children and Young Adults'#(lf)#(tab)#(tab)#(tab)                               WHEN [PDS].[Derived_Age] BETWEEN 18 AND 64 THEN '18-64 - Working Age'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN [PDS].[Derived_Age] >= 65 THEN '65+ - Older Adults'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   ELSE 'Unknown' END#(lf)#(tab)#(tab)#(tab)   ,[5YR_Age_Band] = CASE WHEN [Age].[5YR_Age_Band] LIKE '0-4' THEN '00-04'#(lf)#(tab)#(tab)#(tab)                          WHEN [Age].[5YR_Age_Band] LIKE '5-9' THEN '05-09' ELSE [Age].[5YR_Age_Band] END#(lf)#(tab)#(tab)#(tab)   ,[PDS].[Gender_Desc]#(lf)#(tab)#(tab)#(tab)   ,[Ethnic Origin Grouped] = CASE WHEN [Ethnicity].[DerivedEthnicityGroup] IS NULL THEN 'Not Recorded' ELSE [Ethnicity].[DerivedEthnicityGroup] END#(lf)#(tab)#(tab)#(tab)   ,[IMD].[Derived_IMDGloucestershireDecile]#(lf)#(tab)#(tab)#(tab)   ,[PreferredLanguage] = CASE WHEN [PDS].[PreferredLanguage] IS NULL THEN 'Not Recorded' ELSE [PDS].[PreferredLanguage] END#(lf)#(tab)#(tab)#(tab)   ,[PDS].[InterpreterRequired]#(lf)#(tab)#(tab)#(tab)   ,[appointment_in_last_12_months] = CASE WHEN [GPAPP].[appointment_in_last_12_months] IS NULL THEN 'No' ELSE [GPAPP].[appointment_in_last_12_months] END#(lf)#(tab)#(tab)#(tab)   ,[number_of_appointments_12_months] = CASE WHEN [GPAPP].[number_of_appointments_12_months] IS NULL THEN 0 ELSE [GPAPP].[number_of_appointments_12_months] END#(lf)#(tab)#(tab)#(tab)   ,[appointment_in_last_6_months] = CASE WHEN [GPAPP].[appointment_in_last_6_months] IS NULL THEN 'No' ELSE [GPAPP].[appointment_in_last_6_months] END#(lf)#(tab)#(tab)#(tab)   ,[number_of_appointments_6_months] = CASE WHEN [GPAPP].[number_of_appointments_6_months] IS NULL THEN 0 ELSE [GPAPP].[number_of_appointments_6_months] END#(lf)#(tab)#(tab)#(tab)   ,[Last_Updated] = CAST(GETDATE() AS DATE)#(lf)#(lf)FROM [CCG_Reference].[Population].[vw_PDS_Current] AS [PDS]#(lf)#(lf)LEFT JOIN (SELECT DISTINCT [OrganisationCode], [ReportingOrganisationName], [Locality], [PrimaryCareNetwork] #(lf)           FROM [CCG_Reference].[Reference].[vw_GPPractice]) AS [GP]#(lf)#(tab)#(tab)   ON [GP].[OrganisationCode] = [PDS].[PrimaryCareProvider]#(lf)#(lf)LEFT JOIN (SELECT DISTINCT [PseudoNHSNumber], [DerivedEthnicityGroup] FROM [ICB_Products].[Patient].[vw_Ethnicity]) AS [Ethnicity]#(lf)           ON [Ethnicity].[PseudoNHSNumber] = [PDS].[Derived_NHS_Number]#(lf)#(lf)LEFT JOIN (SELECT DISTINCT [Age], [5YR_Age_Band], [10YR_Age_Band] FROM [CCG_Reference].[Reference].[vw_AgeBand]) AS [Age] #(lf)           ON [Age].[Age] = [PDS].[Derived_Age]#(lf)#(lf)LEFT JOIN (SELECT DISTINCT [AIMTC_Postcode_Key], [LSOA_2021] FROM [CCG_Reference].[Reference].[vw_Postcode]) AS [PC]#(lf)           ON [PC].[AIMTC_Postcode_Key] = [PDS].[Derived_Postcode]#(lf)#(lf)LEFT JOIN (SELECT DISTINCT [LSOACode], [Derived_IMDGloucestershireDecile] FROM [CCG_Reference].[Reference].[vw_LSOA_IMD]) AS [IMD]#(lf)           ON [IMD].[LSOACode] = [PC].[LSOA_2021]#(lf)#(lf)LEFT JOIN (SELECT DISTINCT [practice_code], [gp_longitude], [gp_latitude] FROM [PowerBI_Reporting].[primarycare].[tbl01_GP_Practice_Populations]) AS [COORD]#(lf)           ON [COORD].[practice_code] = [PDS].[PrimaryCareProvider]#(lf)#(lf)LEFT JOIN #TEMP_GP_Appointments AS [GPAPP] ON [GPAPP].[PseudoNHSNumber] = [PDS].[Derived_NHS_Number]#(lf)#(lf)WHERE [PDS].[Derived_Registered_CCG] = '11M'"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

