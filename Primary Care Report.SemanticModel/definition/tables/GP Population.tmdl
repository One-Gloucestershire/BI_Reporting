	partition 'GP Population' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "select distinct locality, primary_care_network, practice_name, practice_code, case when age_band in ('85-89','90-94','95+') then '85+' else age_band end as ""age_band"", sex, financial_year, left(census_date,3) as ""month_name"", population, gp_longitude, gp_latitude, census_date from data_mart_primarycare.tbl01_gp_practice_populations where census_date like '%Apr%'", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

