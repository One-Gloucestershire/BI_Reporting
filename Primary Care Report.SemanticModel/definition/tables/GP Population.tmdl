table 'GP Population'
	lineageTag: 0518a087-c342-4f23-b746-5ce692e9948f

	measure '65 + Population' =
			
			
			CALCULATE(SUM('GP Population'[population]), 'Age Band Reference'[age_banding] IN {"65-69", "70-74", "75-79", "80-84", "85+"})
		formatString: #,0
		lineageTag: 9edf6870-8a27-4395-87db-4fe1d2e7b89e

		annotation PBI_FormatHint = {"isDecimal":true}

	measure '65 + Population - ICB' =
			
			
			CALCULATE(SUM('GP Population'[population]), 'Age Band Reference'[age_banding] IN {"65-69", "70-74", "75-79", "80-84", "85+"}, ALLSELECTED('Age Band Reference'), ALLSELECTED('GP Reference'))
		lineageTag: 2ab18e41-531a-472a-bad3-c6746ed94e87

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Population 65+' =
			
			
			VAR _65POP = CALCULATE(SUM('GP Population'[population]), 'Age Band Reference'[age_banding] IN {"65-69", "70-74", "75-79", "80-84", "85+"})
			VAR _TOTALPOP = SUM('GP Population'[population])
			
			RETURN
			
			DIVIDE (_65POP, _TOTALPOP)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 02468367-fc5d-4d23-b10c-30a96950ae0e

	measure 'GP Pop Growth from 19/20' = ```
			
			
			VAR _BASELINEPOP = CALCULATE(SUM('GP Population'[population]), 'Date Reference Script'[financial_year] = "2019/20")
			VAR _LATESTYEARPOP = CALCULATE(SUM('GP Population'[population]), 'Date Reference Script'[latest_12_months_flag] = 1)
			
			RETURN 
			
			(_LATESTYEARPOP-_BASELINEPOP)/_BASELINEPOP
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 08f045b2-d375-4f35-80d2-abd2893f74dd

	measure 'GP Pop Growth from 19/20 65+' = ```
			
			
			VAR _BASELINEPOP = CALCULATE([65 + Population], 'Date Reference Script'[financial_year] = "2019/20")
			VAR _LATESTYEARPOP = CALCULATE([65 + Population], 'Date Reference Script'[latest_12_months_flag] = 1)
			
			RETURN 
			
			(_LATESTYEARPOP-_BASELINEPOP)/_BASELINEPOP
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 8b8f122a-8d58-4cc0-a5f7-a9b6546f7d69

	measure '0-18 Population' =
			
			
			CALCULATE(SUM('GP Population'[population]), 'Age Band Reference'[age_banding] IN {"00-04", "05-09", "10-14", "15-19"})
		formatString: #,0
		lineageTag: 5b22914a-89e7-4685-a4d6-247d27a0d35f

	measure 'GP Pop Growth from 19/20 0-18' = ```
			
			
			VAR _BASELINEPOP = CALCULATE([0-18 Population], 'Date Reference Script'[financial_year] = "2019/20")
			VAR _LATESTYEARPOP = CALCULATE([0-18 Population], 'Date Reference Script'[latest_12_months_flag] = 1)
			
			RETURN 
			
			(_LATESTYEARPOP-_BASELINEPOP)/_BASELINEPOP
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 51755000-235b-4353-a43f-58c7dcb2a62a

	measure '% Population 0-18' =
			
			
			VAR _018POP = CALCULATE(SUM('GP Population'[population]), 'Age Band Reference'[age_banding] IN {"00-04", "05-09", "10-14", "15-19"})
			VAR _TOTALPOP = SUM('GP Population'[population])
			
			RETURN
			
			DIVIDE (_018POP, _TOTALPOP)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: d60e5b30-d3fb-40a9-a48d-51489658660e

