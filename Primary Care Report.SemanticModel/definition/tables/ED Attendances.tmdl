table 'ED Attendances'
	lineageTag: 0acced4d-44f3-4783-b340-4d7d55a52d1f

	measure 'ED Rate per 1,000 - ICB' =
			
			
			VAR _ED = CALCULATE(SUM('ED Attendances'[counter]), ALL('GP Reference'))
			VAR POP = CALCULATE(SUM('GP Population (Duplicate)'[population]), ALL('GP Reference'))
			
			RETURN
			
			(_ED/POP)*1000
		lineageTag: d37a22eb-682a-498b-bee0-04225dd0dd42

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ED Rate per 1,000' =
			
			
			VAR _ED = CALCULATE(SUM('ED Attendances'[counter]))
			VAR POP = SUM('GP Population (Duplicate)'[population])
			
			RETURN
			
