	measure 'National Gloucestershire % GP' =
			
			
			VAR _SAMEDAY = CALCULATE(SUM('Glos Practice Appointments'[COUNT_OF_APPOINTMENTS]), 'Glos Practice Appointments'[HCP_TYPE] = "GP")
			
