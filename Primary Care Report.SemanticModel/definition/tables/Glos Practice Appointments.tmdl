	measure 'National Gloucestershire Trendline  - % Same Day' = ```
			
			
			VAR Temp_Table = 
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED( 'Date Reference Script'[financial_year], 'Date Reference Script'[financial_month],
			                         'Date Reference Script'[month_name], 'Date Reference Script'[month_number] ),
			            "Value_x", 'Date Reference Script'[month_number],
			            "Value_y", 'Glos Practice Appointments'[National Gloucestershire % Same Day]
			        ),
			        AND (
			            NOT ( ISBLANK ( "Value_x" ) ),
			            NOT ( ISBLANK ( "Value_y" ) )
			        )
			    )
			
			VAR LINESTX_Table = 
			    LINESTX(Temp_Table, [Value_y], [Value_x], TRUE)
			VAR Slope = 
			    MAXX ( LINESTX_Table, [Slope1] )
			VAR Intercept = 
			    MAXX ( LINESTX_Table, [Intercept] )
			
			RETURN
			    SUMX (
			        DISTINCT ( 'Date Reference Script'[month_number] ),
			        Intercept + Slope * 'Date Reference Script'[month_number]
			    )
			```
		lineageTag: 941b83f6-ec25-4cb7-8a85-7907dc7154aa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

