		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Measure
		lineageTag: 99913394-3a3d-4e99-8b38-8fe324209ef1

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	measure Forecast =
			
			
			VAR LastActualDate = CALCULATE(MAX('Forecast Date Reference'[date]), ALL('Forecast Date Reference'[date]))
			VAR FuturePeriod = DATEDIFF(LastActualDate, MAX('Forecast Date Reference'[date]), MONTH)
			VAR FutureValue = CALCULATE(
			    AVERAGEX(
			        DATESINPERIOD(
			            'Forecast Date Reference'[date],
			            LastActualDate,
			            -3,  -- Change the period as needed
			            MONTH
			        ),
			        [Total Glos Appointments]
			    )
			)
			RETURN
			IF (
			    MAX('Forecast Date Reference'[date]) > LastActualDate,
			    FutureValue,
			    [Total Glos Appointments]
			)
		lineageTag: 0896510d-378a-4f33-ac82-640e93abc7c2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Appointments average per year_month' =
			
			AVERAGEX(
				KEEPFILTERS(VALUES('Date Reference Script'[year_month])),
				CALCULATE(SUM('Glos Practice Appointments'[COUNT_OF_APPOINTMENTS])
			)
			)
		formatString: #,0
		lineageTag: d67904b0-24de-4934-9d05-bb2ba41e6566

		annotation PBI_FormatHint = {"isDecimal":true}

