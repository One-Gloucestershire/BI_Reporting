	measure '% of Parameter Totals - No Area Filter' =
			
			
			IF(CONTAINSSTRING('Parameter - Totals'[Current Selection], "Total F2F"),
			CALCULATE([Total F2F], ALL('GP Reference'))/[Total Static - No Area Filter],
			IF(CONTAINSSTRING('Parameter - Totals'[Current Selection], "Total Attended"),
			CALCULATE([Total Attended], ALL('GP Reference'))/[Total Static - No Area Filter],
			IF(CONTAINSSTRING('Parameter - Totals'[Current Selection], "Total GP"),
			CALCULATE([Total GP], ALL('GP Reference'))/[Total Static - No Area Filter],
			IF(CONTAINSSTRING('Parameter - Totals'[Current Selection], "Total Same Day"),
