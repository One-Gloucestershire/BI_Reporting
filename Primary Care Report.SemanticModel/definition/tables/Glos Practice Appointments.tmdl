	measure 'Total Static' =
			
			
			CALCULATE(SUM('Glos Practice Appointments'[COUNT_OF_APPOINTMENTS]), REMOVEFILTERS('Glos Practice Appointments'[APPT_MODE], 'Glos Practice Appointments'[APPT_STATUS], 'Glos Practice Appointments'[HCP_TYPE], 'Glos Practice Appointments'[TIME_BETWEEN_BOOK_AND_APPT]))
		formatString: 0
		lineageTag: ee9a499f-7573-45e4-b3cd-d09f8e69ace8

