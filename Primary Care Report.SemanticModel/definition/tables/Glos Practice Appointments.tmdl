	measure '% of Parameter Totals' =
			
			
			IF(CONTAINSSTRING('Parameter - Totals'[Current Selection], "Total F2F"),
			[Total F2F]/[Total Static],
			IF(CONTAINSSTRING('Parameter - Totals'[Current Selection], "Total Attended"),
			[Total Attended]/[Total Static],
			IF(CONTAINSSTRING('Parameter - Totals'[Current Selection], "Total GP"),
			[Total GP]/[Total Static],
			IF(CONTAINSSTRING('Parameter - Totals'[Current Selection], "Total Same Day"),
			[Total Same Day]/[Total Static],
			IF(CONTAINSSTRING('Parameter - Totals'[Current Selection], "Total Telephone"),
			[Total Telephone]/[Total Static],
			IF(CONTAINSSTRING('Parameter - Totals'[Current Selection], "Total Within 21 Days"),
			[Total Within 21 Days]/[Total Static], 0
			))))))
		lineageTag: ed9c6081-26ee-478b-990c-6a7e9cdf6714

		formatStringDefinition = IF ( CONTAINSSTRING('Parameter - Totals'[Current Selection], "Rate per 1,000"), "#0.0", "#,0.0%")

	measure '% of Parameter STD DEV' =
			
			
			CALCULATE(STDEVX.P(VALUES('Glos Practice Appointments'[FirstDateofMonth]), [% of Parameter Totals]), ALLSELECTED( 'Date Reference Script'))
		lineageTag: 526ace18-eedc-4ad9-b7fa-ecdd213e07c4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% of Parameter Mean' =
			
			IF(CONTAINSSTRING('Parameter - Totals'[Current Selection], "Rate per 1,000"),
			CALCULATE([% of Parameter Totals], 'Date Reference Script'[SPC_Flag] = 1),
			CALCULATE(([% of Parameter Totals]), 'Date Reference Script'[SPC_Flag] = 1, ALL('Date Reference Script')))
		lineageTag: f6b8c0ed-c121-4641-970d-be32e41e7b21

		formatStringDefinition = IF ( CONTAINSSTRING('Parameter - Totals'[Current Selection], "Rate per 1,000"), "#0.0", "#,0.0%")

	measure '% of Parameter LCL' =
			
			
			IF(([% of Parameter Mean] - (3*[% of Parameter STD DEV])) < 0, 0, ([% of Parameter Mean] - (3*[% of Parameter STD DEV])))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c35f898b-eeac-4636-9780-6a5848c98ad3

	measure '% of Parameter UCL' =
			
			
			IF(([% of Parameter Mean] + (3*[% of Parameter STD DEV])) < 0, 0, ([% of Parameter Mean] + (3*[% of Parameter STD DEV])))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c0c6eb6c-9cb5-4af6-9f82-5a69b509adac

	measure '% of parameter - Outlier Indicator' =
			
			
			IF(OR([% of Parameter Totals] < [% of Parameter LCL], [% of Parameter Totals] > [% of Parameter UCL]), [% of Parameter Totals], BLANK())
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 73cc6337-f631-45a8-9ddb-0aa67f9c3ed3

	measure 'Total Static - No Area Filter' =
			
			
			CALCULATE(SUM('Glos Practice Appointments'[COUNT_OF_APPOINTMENTS]), REMOVEFILTERS('Glos Practice Appointments'[APPT_MODE], 'Glos Practice Appointments'[APPT_STATUS], 'Glos Practice Appointments'[HCP_TYPE], 'Glos Practice Appointments'[TIME_BETWEEN_BOOK_AND_APPT]), ALL('GP Reference'))
