			IF(CONTAINSSTRING('Parameter - Dates'[Parameter 2 Selected Option], "Last 12 Months"), ((CALCULATE(SUM('Glos Practice Appointments'[COUNT_OF_APPOINTMENTS]), 'Date Reference Script'[latest_12_months_flag] = 1, ALL('GP Reference'))/_POPULATION)*1000)/12,
			IF(CONTAINSSTRING('Parameter - Dates'[Parameter 2 Selected Option], "Current YTD"), ((CALCULATE(SUM('Glos Practice Appointments'[COUNT_OF_APPOINTMENTS]), 'Date Reference Script'[ytd_flag] = 1, 'Date Reference Script'[financial_year] = MAX('Date Reference Script'[financial_year]), ALL('GP Reference'))/_POPULATION)*1000)/_YTD, 0))))
