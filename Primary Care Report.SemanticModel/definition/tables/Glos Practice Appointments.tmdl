	partition 'Glos Practice Appointments' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "BIReports", [Query="SELECT DISTINCT [DATE].[FirstDateofMonth] #(lf)      ,[GP_CODE]#(lf)      ,[GP_NAME]#(lf)      ,[SUPPLIER]#(lf)      ,[HCP_TYPE]#(lf)      ,[APPT_MODE]#(lf)      ,[TIME_BETWEEN_BOOK_AND_APPT]#(lf)      ,[APPT_STATUS]#(lf)      ,[COUNT_OF_APPOINTMENTS]#(lf)  FROM [BIReports].[dbo].[Gloucester_GP_Appointments] AS [GPA]#(lf)#(lf)  LEFT JOIN [CCG_Reference].[Reference].[vw_DateLookup] AS [DATE]#(lf)  ON [DATE].[MonthYearName] = IIF([APPOINTMENT_MONTH_START_DATE] LIKE '%-%',#(lf)#(tab)                                    STUFF((RIGHT([GPA].[APPOINTMENT_MONTH_START_DATE], 6)), 5, 0, '20'),#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)(STUFF((RIGHT([GPA].[APPOINTMENT_MONTH_START_DATE],7)), 4, 0, '-')))#(lf)"]),
				    #"Filtered Rows" = Table.SelectRows(Source, each true)
				in
				    #"Filtered Rows"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

