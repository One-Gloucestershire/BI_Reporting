table 'Glos Practice Appointments'
	lineageTag: dcf0fdbe-7a45-4524-9a24-4d4a7e6aea27

	measure 'National Gloucestershire GP 19/20 Baseline' =
			
			
			VAR _1920B = CALCULATE(SUM('Glos Practice Appointments'[COUNT_OF_APPOINTMENTS]), 'Date Reference Script'[financial_year] = "2021/22")
			
			VAR _1920M = CALCULATE(DISTINCTCOUNT('Glos Practice Appointments'[FirstDateofMonth]), 'Date Reference Script'[financial_year] = "2021/22")
			
			RETURN _1920B/_1920M
		formatString: #,0
		lineageTag: b9a8f760-f4a7-47a1-968a-bc96d236c007

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'National Gloucestershire Latest Year Baseline' =
			
			
			VAR _YTDMONTHS = CALCULATE(DISTINCTCOUNT('Date Reference Script'[month]), 'Date Reference Script'[ytd_flag] = 1)
			VAR _LATESTYEARPOP = CALCULATE(SUM('Glos Practice Appointments'[COUNT_OF_APPOINTMENTS]), 'Date Reference Script'[financial_year] = MAX('Date Reference Script'[financial_year]))
			
			RETURN _LATESTYEARPOP/_YTDMONTHS
		formatString: #,0
		lineageTag: 79a9fb03-f839-4018-b717-7f74a31232d8

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'National Gloucestershire Appointments - Latest Year Growth % - Cards' =
			
			
			VAR _CALC = IFERROR(([National Gloucestershire Latest Year Baseline]-[National Gloucestershire GP 19/20 Baseline])/[National Gloucestershire GP 19/20 Baseline], 0)
			
			RETURN
			
			FORMAT(_CALC, "+0.0%;-0.0%")
		lineageTag: 2d3b49c7-f445-4aaa-a1b2-5a7e3cb65d22

	measure 'Total Glos Appointments' = SUM('Glos Practice Appointments'[COUNT_OF_APPOINTMENTS])
		formatString: #,0
		lineageTag: b4991b2a-d907-45ac-9132-680d89dfa2f7

	measure 'YTD Glos Total Appointments' =
			
			
			CALCULATE(SUM('Glos Practice Appointments'[COUNT_OF_APPOINTMENTS]), 'Date Reference Script'[ytd_flag] = 1)
		formatString: #,0
		lineageTag: 3b2fdc39-a262-43d3-8fbc-57d054ed6feb

	measure 'National Gloucestershire Trendline' = ```
			
			
			VAR Temp_Table = 
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED( 'Date Reference Script'[financial_year], 'Date Reference Script'[financial_month],
			                         'Date Reference Script'[month_name], 'Date Reference Script'[month_number] ),
			            "Value_x", 'Date Reference Script'[month_number],
			            "Value_y", 'Glos Practice Appointments'[Total Glos Appointments]
			        ),
			        AND (
			            NOT ( ISBLANK ( "Value_x" ) ),
			            NOT ( ISBLANK ( "Value_y" ) )
			        )
			    )
			
			VAR LINESTX_Table = 
			    LINESTX(Temp_Table, [Value_y], [Value_x], TRUE)
			VAR Slope = 
			    MAXX ( LINESTX_Table, [Slope1] )
			VAR Intercept = 
			    MAXX ( LINESTX_Table, [Intercept] )
			
			RETURN
			    SUMX (
			        DISTINCT ( 'Date Reference Script'[month_number] ),
			        Intercept + Slope * 'Date Reference Script'[month_number]
			    )
			```
		lineageTag: 62d50d68-e7d8-4337-85aa-ea5be985d545

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Latest Year Title - Appointments' =
			
			
			VAR _LATESTYEAR = MAX('Date Reference Script'[financial_year])
			
			RETURN
			
			CONCATENATE(_LATESTYEAR, " Monthly Average")
		lineageTag: 6a8cdea2-acba-4000-b686-3f43319dc937

	measure 'National Gloucestershire % Same Day' =
			
			
			VAR _SAMEDAY = CALCULATE(SUM('Glos Practice Appointments'[COUNT_OF_APPOINTMENTS]), 'Glos Practice Appointments'[TIME_BETWEEN_BOOK_AND_APPT] = "Same Day")
			
			RETURN DIVIDE(_SAMEDAY, [Total Glos Appointments])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e29e5695-97e5-4ecd-9c41-1dcb533a19c9

	measure 'National Gloucestershire % F2F' =
			
			
			VAR _SAMEDAY = CALCULATE(SUM('Glos Practice Appointments'[COUNT_OF_APPOINTMENTS]), 'Glos Practice Appointments'[APPT_MODE] = "Face-to-Face")
			
			RETURN DIVIDE(_SAMEDAY, [Total Glos Appointments])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 9b930edb-0c95-44de-866e-a7b5e92bd370

	measure 'National Gloucestershire % Telephone' =
			
			
			VAR _SAMEDAY = CALCULATE(SUM('Glos Practice Appointments'[COUNT_OF_APPOINTMENTS]), 'Glos Practice Appointments'[APPT_MODE] = "Telephone")
			
