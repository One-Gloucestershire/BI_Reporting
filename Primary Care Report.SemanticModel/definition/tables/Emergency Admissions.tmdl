table 'Emergency Admissions'
	lineageTag: 935691f8-90b7-4a61-b7ca-98b4a275afe0

	measure 'Emergency Admissions Rate per 1,000' =
			
			
			VAR _ADM = CALCULATE(SUM('Emergency Admissions'[counter]))
			VAR POP = SUM('GP Population (Duplicate)'[population])
			
			RETURN
			
			(_ADM/POP)*1000
		lineageTag: 5a7ef98a-eb76-4ab6-8b58-cd91a6999c4e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Emergency Admissions Rate per 1,000 - ICB' =
			
			
			VAR _ADM = CALCULATE(SUM('Emergency Admissions'[counter]), ALL('GP Reference'))
			VAR POP = CALCULATE(SUM('GP Population (Duplicate)'[population]), ALL('GP Reference'))
			
			RETURN
			
			(_ADM/POP)*1000
		lineageTag: c55c487b-df37-490f-8568-9c39b2095d75

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'National Trendline - Emergency Admissions' = ```
			
			
			VAR Temp_Table = 
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED( 'Date Reference Script'[financial_year], 'Date Reference Script'[financial_month],
			                         'Date Reference Script'[month_name], 'Date Reference Script'[month_number] ),
			            "Value_x", 'Date Reference Script'[month_number],
			            "Value_y", 'Emergency Admissions'[Emergency Admissions Rate per 1,000]
			        ),
			        AND (
			            NOT ( ISBLANK ( "Value_x" ) ),
			            NOT ( ISBLANK ( "Value_y" ) )
			        )
			    )
			
			VAR LINESTX_Table = 
			    LINESTX(Temp_Table, [Value_y], [Value_x], TRUE)
			VAR Slope = 
			    MAXX ( LINESTX_Table, [Slope1] )
			VAR Intercept = 
			    MAXX ( LINESTX_Table, [Intercept] )
			
			RETURN
			    SUMX (
			        DISTINCT ( 'Date Reference Script'[month_number] ),
			        Intercept + Slope * 'Date Reference Script'[month_number]
			    )
			```
		lineageTag: e62acb9b-b4da-4b16-a4ff-797ac7f9c258

		annotation PBI_FormatHint = {"isGeneralNumber":true}

