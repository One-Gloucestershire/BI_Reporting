	measure 'Emergency Admissions Rate per 1,000 average per year_month' =
			
			AVERAGEX(
				KEEPFILTERS(VALUES('Date Reference Script'[year_month])),
				CALCULATE([Emergency Admissions Rate per 1,000])
			)
		lineageTag: 389aae5a-7a3e-437d-bc1b-78239fe22d57

