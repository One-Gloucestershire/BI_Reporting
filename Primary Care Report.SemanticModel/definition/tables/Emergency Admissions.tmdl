		lineageTag: fda0ea8e-81cf-4bcf-930d-99bfa1a20810

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Variance from ICB - Emergency Admissions' = ```
			
			
			 [Emergency Admissions Rate per 1,000] - [Emergency Admissions Rate per 1,000 - ICB]
