table 'Date Reference Script'
	lineageTag: 16504fe6-9994-48f4-89f0-4aee22ad8ab0

	measure 'Distinct Months' =
			
			
			CALCULATE(DISTINCTCOUNT('Date Reference Script'[month_year_name]), 'Date Reference Script'[ytd_flag] = 1, 'Date Reference Script'[financial_year] = MAX('Date Reference Script'[financial_year]))
		formatString: 0
		lineageTag: c53b903a-85b7-4104-8251-a430e9f51ab4

	measure 'Earliest Month' =
			
			
			CALCULATE(SELECTEDVALUE('Date Reference Script'[month_year]), 'Date Reference Script'[year_month] = MIN('Date Reference Script'[year_month]))
		lineageTag: c4c045f0-477b-412d-830e-93c5f055f169

	measure 'YTD Blank Colour' =
			
			
			VAR _TOTALYTD = CALCULATE(DISTINCTCOUNT('Date Reference Script'[year_month]), 'Date Reference Script'[ytd_flag] = 1, 'Date Reference Script'[financial_year] = MAX('Date Reference Script'[financial_year]))
			
			RETURN
			
			IF(_TOTALYTD = 1, "#FFFFFF", "#00FF0000")
		lineageTag: e95be696-96d9-43ac-b149-fea9b7ce22d4

	measure 'Last Updated Date' =
			
			
			TODAY()
		formatString: mmmm yyyy
		lineageTag: 919bcfca-d6a3-4f41-9f2e-61f8c0d54330

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

