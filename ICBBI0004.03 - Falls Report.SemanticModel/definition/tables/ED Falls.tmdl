				    Source = Sql.Database("grh-ccg-sql", "CCG_current", [Query="--==--==--==--==--==--==--==--==--==--==--==--==--==--==#(lf)-- GHFT ED Attendances for Falls -- #(lf)--==--==--==--==--==--==--==--==--==--==--==--==--==--==#(lf)--Created by: Kyran Witney#(lf)--Created on: #(lf)--Updated by: Alex Davey#(lf)--Updated on: 31/01/2023#(lf)#(lf)#(lf)SET ANSI_WARNINGS OFF#(lf)SET NOCOUNT ON#(lf)if object_id ('tempdb..#Temp_Dementia') is not null drop table #Temp_Dementia#(lf)#(lf)--- DEMENTIA TEMP#(lf)#(lf)SELECT DISTINCT [PseudoNHSNo],#(lf)[Dementia]#(lf)INTO #Temp_Dementia#(lf)FROM [CCG_Current].[PrimaryCare].[vw_LongTermConditionsQOFPatients]#(lf)WHERE [Dementia] = '1'#(lf)#(lf)#(lf)--Care home temp table, pulling in care home name and type#(lf)#(lf)SET ANSI_WARNINGS OFF#(lf)SET NOCOUNT ON#(lf)if object_id ('tempdb..#Care_Home') is not null drop table #Care_Home#(lf)#(lf)SELECT DISTINCT#(lf) #(lf)#(tab)Derived_Pseudo_NHSNumber#(lf)      ,[Residential_or_Nursing_home_Location_Name]#(lf)#(tab)  ,[Nursing Care Homes ]#(lf)#(tab)  ,[Care Home Type]#(lf)#(tab)  ,[Date_of_incident] = cast([Time_Of_Incident] as date)#(lf)#(lf)#(tab)  INTO #Care_Home#(lf)#(lf)  FROM [CCG_Current].[SWASFT].[vw_AmbulanceServicePatient] [A]#(lf)#(lf)  LEFT JOIN [BIReports].[dbo].[CHLookup2022_Oct] [CH] ON [CH].[SWASFT Care Home Name] = [A].[Residential_or_Nursing_home_Location_Name]#(lf)   #(lf)  where #(lf)  #(lf)   [Residential_or_Nursing_home_Location] not like 'null'#(lf)#(lf)  and Derived_Pseudo_NHSNumber not like 'Null'#(lf)#(lf)  and [Care Home Type] not like 'NULL'#(lf)#(lf)#(lf)#(lf)-- MAIN SCRIPT #(lf)#(lf)#(lf)SELECT  distinct 'ED Attendance' [type]#(lf),Gender#(lf)        ,[ae_attendance_number] [ed_attendance_number]#(lf)        ,[ED].[Derived_Pseudo_NHS] [nhs_number]#(lf)#(tab)#(tab),[mpi].[Derived_IsLivingAlone]#(lf)#(lf)#(tab)#(tab),case  #(lf)#(tab)#(tab)when [mpi].Derived_IsLivingInCareHome like '1' then 'Not Living Alone'#(lf)#(tab)#(tab)when [Care Home Type] not like 'null' then 'Not Living Alone'#(lf)#(tab)#(tab)when [mpi].[Derived_IsLivingAlone] like '0' then 'Not Living Alone'#(lf)#(tab)#(tab)when [mpi].[Derived_IsLivingAlone] is null  then 'Not Living Alone'#(lf)#(lf)#(tab)#(tab)else 'Living Alone'#(lf)#(tab)#(tab)end as 'living_alone_status'#(lf)#(lf)#(tab)#(tab),[mpi].Derived_IsLivingInCareHome#(lf)#(tab)#(tab),[CH].[Care Home Type]#(lf)#(lf)#(tab)#(tab),[Care_home_status] = case when [mpi].Derived_IsLivingInCareHome like '1' and [CH].[Care Home Type] IS NULL then 'Unknown Care Home Type'#(lf)#(tab)#(tab)when ([CH].[Care Home Type] not like 'NULL') then [CH].[Care Home Type]#(lf)#(tab)#(tab)when ([mpi].Derived_IsLivingInCareHome IS NULL and [CH].[Care Home Type] not like 'null') then [CH].[Care Home Type]#(lf)#(tab)#(tab)when  ([mpi].Derived_IsLivingInCareHome IS NULL and [CH].[Care Home Type]  IS NULL) then 'Not Living in a Care Home'#(lf)#(tab)#(tab)when  ([mpi].Derived_IsLivingInCareHome like '0' and [CH].[Care Home Type]  IS NULL) then 'Not Living in a Care Home'#(lf)#(lf)#(tab)#(tab)end#(lf)#(tab)#(lf)#(lf)        ,[organisation_code_of_provider] [provider_code]#(lf)        ,CASE WHEN [organisation_code_of_provider] = 'RTE01' THEN 'Cheltenham General Hospital'#(lf)              WHEN [organisation_code_of_provider] = 'RTE03' THEN 'Gloucester Royal Hospital'#(lf)              END [site]#(lf)        ,CAST([arrival_date] AS DATE) [arrival_date]#(lf)#(tab)#(tab),[arrival_date] [arrival_date_time]#(lf)#(tab)#(tab),CASE WHEN CAST([arrival_date] AS TIME) BETWEEN '08:00:00' AND '20:00:00' THEN '8am - 8pm'#(lf)              WHEN CAST([arrival_date] AS TIME) IS NULL THEN 'NULL'#(lf)              ELSE 'Night Attendance' END AS 'arrival_time_flag'#(lf)        ,[D].[YearMonth] [year_month]#(lf)        ,LEFT([D].[MonthName],3) [month_name]#(lf)        ,[D].[FinancialYear] [financial_year]#(lf)        ,[A].[5yr_age_band] [5yr_age_band]#(lf)        ,[code_of_gp_practice_registered_gmp] [practice_code]#(lf)#(lf)#(tab)#(tab),[correct_practice_code] = case when [code_of_gp_practice_registered_gmp]  like 'L84001' then 'L84050'#(lf)#(tab)#(tab)when [code_of_gp_practice_registered_gmp]  like 'L84002' then 'L84606'#(lf)#(tab)#(tab)when [code_of_gp_practice_registered_gmp]  like 'L84020' then 'L84012'#(lf)#(tab)#(tab)when [code_of_gp_practice_registered_gmp]  like 'L84044' then 'L84027'#(lf)#(tab)#(tab)when [code_of_gp_practice_registered_gmp]  like 'L84056' then 'L84033'#(lf)#(tab)#(tab)when [code_of_gp_practice_registered_gmp]  like 'L84032' then 'L84077'#(lf)#(tab)#(tab)else [code_of_gp_practice_registered_gmp]#(lf)#(tab)#(tab)end#(lf)#(lf)#(tab)#(tab),ReportingOrganisationName#(lf)#(tab)#(tab)#(lf)        ,[GP].OrganisationName [practice_name]#(lf)        ,[GP].primarycarenetwork [primary_care_network]#(lf)        ,CASE WHEN [GP].Locality LIKE '%Cotswold%' THEN 'Cotswolds' ELSE [GP].Locality END AS [locality]#(lf)        ,[EM_HRG] [hrg_code] -- neeeds review and potentially join to HRG ref table if needed#(lf)        ,[HRGCodeDescription] [hrg_description] -- neeeds review and potentially join to HRG ref table if needed#(lf)#(tab)#(tab), 1 AS [counter]#(lf)#(tab)    ,[ae_arrival_mode_code] [arrival_mode_code]#(lf)#(tab)#(tab),[local_ae_arrival_mode] [arrival_mode_description]#(lf)        ,[ae_source_of_referral_for_ae_code] [source_of_referral_code]#(lf)#(tab)#(tab),[SOR].[AESourceOfReferralName] [source_of_referral_description]#(lf)#(tab)    ,[ae_attendance_category_code] [attendance_category_code]#(lf)        ,[ae_attendance_disposal_code] [disposal_code]#(lf)#(tab)#(tab),[DC].[DisposalDescription] [disposal_description] #(lf)#(tab)#(tab),CASE WHEN [ae_attendance_disposal_code] = '01' THEN 'Admitted'#(lf)#(tab)#(tab)      ELSE 'Not admitted' END AS [admitted_flag_description]#(lf)#(tab)#(tab),CASE WHEN [ae_attendance_disposal_code] = '01' THEN '1'#(lf)#(tab)#(tab)      ELSE '0' END AS [admitted_flag]#(lf)#(tab)#(tab),[ae_department_type_code] [ed_department_type] -- ED or MIU attendance#(lf)#(tab)#(tab)#(tab),[MPI].[eFI_Score_derived] [frailty_score]#(lf)        ,[MPI].[eFI_Catgory_derived] [frailty_category]#(lf)#(tab)#(tab)--,[DP].[Derived_Pseudo_NHS] [deceased_nhs_number]#(lf)--,CASE WHEN [ED].[Derived_Pseudo_NHS] = [DP].[Derived_Pseudo_NHS] THEN 'Deceased'#(lf)--ELSE 'Alive' END AS [mortality_flag]#(lf)--,[DP].[Date_Of_Death] [date_of_death]#(lf)--,DATEDIFF(week,[arrival_date], [Date_Of_Death]) AS [death_in_weeks]#(lf),presenting_complaint#(lf),[10_year_age_band] = case when([A].[Age] between '65' and '74') THEN '65 to 74' #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when ([A].[Age]between '75' and '84') THEN '75 to 84'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when ([A].[Age] between '85' and '94') THEN '85 to 94'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when ([A].[Age] > '94') THEN '95+'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)else 'Under 65'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)end#(lf) ,case when [DM].[Dementia] like '1' then 'Dementia'#(lf)#(tab)#(tab)when [DM].[Dementia] like 'null' then 'No Dementia'#(lf)#(tab)#(tab)when [DM].[Dementia] like '0' then 'No dementia'#(lf)#(tab)#(tab)else 'No dementia'#(lf)#(tab)#(tab)end as 'dementia_status'#(lf)#(lf) #(lf)#(tab)#(tab)#(lf)#(tab)#(tab),[Care_home_status] = case when [mpi].Derived_IsLivingInCareHome like '1' and [CH].[Care Home Type] IS NULL then 'Unknown Care Home Type'#(lf)#(tab)#(tab)when ([CH].[Care Home Type] not like 'NULL') then [CH].[Care Home Type]#(lf)#(tab)#(tab)when ([mpi].Derived_IsLivingInCareHome IS NULL and [CH].[Care Home Type] not like 'null') then [CH].[Care Home Type]#(lf)#(tab)#(tab)when  ([mpi].Derived_IsLivingInCareHome IS NULL and [CH].[Care Home Type]  IS NULL) then 'Not Living in a Care Home'#(lf)#(tab)#(tab)when  ([mpi].Derived_IsLivingInCareHome like '0' and [CH].[Care Home Type]  IS NULL) then 'Not Living in a Care Home'#(lf)#(lf)#(tab)#(tab)end#(lf)#(tab)#(lf)#(lf)#(tab),case when [local_ae_arrival_mode]  like 'ambulance' then 'Ambulance'#(lf)#(tab)when [local_ae_arrival_mode]  like 'air ambulance' then 'Ambulance'#(lf)#(tab)else 'Non-Ambulance'#(lf)#(tab)end as 'grouped_ed_arrival_method'#(lf)#(lf)#(tab),case when [SOR].[AESourceOfReferralName] like 'Emergency services' then 'Emergency services' #(lf)#(tab)when [SOR].[AESourceOfReferralName] like 'Self referral' then 'Self referral'#(lf)#(tab)else  'Other'#(lf)#(tab)end as 'grouped_source_of_referral'#(lf)      #(tab)#(tab)#(lf)#(tab)#(lf)FROM [CCG_Current].[GHFT].[vw_ED_Attendance] [ED]#(lf)#(lf)LEFT JOIN [CCG_Reference].[Reference].[vw_AgeBand] [A] ON [ED].[age_at_CDS_activity_date] = [A].[Age]#(lf)LEFT JOIN [CCG_Reference].[Reference].[vw_DateLookup] [D] ON CAST([ED].[arrival_date] AS DATE) = [D].[date]#(lf)LEFT JOIN [CCG_Reference].[Reference].[vw_GPPractice] [GP] ON [ED].[code_of_gp_practice_registered_gmp] = [GP].OrganisationCode#(lf)LEFT JOIN [CCG_Reference].[Reference].[vw_HRG] [HRG] ON [ED].[EM_HRG] = [HRGCode]#(lf)LEFT JOIN [CCG_Reference].[Reference].[vw_aesourceofreferral] [SOR] on [ED].ae_source_of_referral_for_ae_code = [SOR].[AESourceOfReferralCode]#(lf)LEFT JOIN [CCG_Reference].[Reference].[vw_aearrivalmode] [AM] on [ED].[ae_arrival_mode_code] = [AM].[AEArrivalModeCode]#(lf)LEFT JOIN [CCG_Reference].[Reference].[vw_aeattendancedisposal] [DC] on [ED].ae_attendance_disposal_code = [DC].[DisposalCode]#(lf)LEFT JOIN #Temp_Dementia [DM] ON [ED].[Derived_Pseudo_NHS] = [DM].[PseudoNHSNo]#(lf)LEFT JOIN [BIReports].[MPI].[MPI_current] [MPI] ON [ED].[Derived_Pseudo_NHS] = [MPI].[Derived_Pseudo_NHS]#(lf)--LEFT JOIN [CCG_Reference].[Population].[vw_NHAIS_Deaths] [DP] ON [ED].[Derived_Pseudo_NHS] = [DP].[Derived_Pseudo_NHS]#(lf)--LEFT JOIN [CCG_Reference].[Reference].[vw_aediagnosis] g on left([ED].diagnosis_code_01,3) = g.[Diagnosis Code]#(lf)LEFT JOIN #Care_Home [CH] ON [CH].Derived_Pseudo_NHSNumber = [ED].Derived_Pseudo_NHS#(lf)#(lf)#(lf)WHERE [presenting_complaint] LIKE '%f[ae]ll%'#(lf)#(lf)and [locality] not like 'null'#(lf)#(lf)AND [ED].[age_at_CDS_activity_date] >= 65#(lf)AND CAST([ED].[arrival_date] AS DATE) >= '20190401'#(lf)and CAST([ED].[arrival_date] AS DATE) < '20230101'#(lf)AND CCG_Of_Registration like '%11M%'#(lf)#(lf)order by arrival_date#(lf)#(lf)#(lf)#(lf)"]),
