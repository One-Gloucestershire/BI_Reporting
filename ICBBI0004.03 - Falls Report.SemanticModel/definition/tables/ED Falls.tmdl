				    #"Changed Type1" = Table.TransformColumnTypes(#"Renamed Columns",{{"admitted_flag", Int64.Type}}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Changed Type1",{{"admitted_flag", Int64.Type}})
				in
				    #"Changed Type"

