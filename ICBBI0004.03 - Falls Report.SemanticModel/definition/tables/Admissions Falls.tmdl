 [emergency_admission_fnof_flag]#(lf) ,case when [DM].[Dementia] like '1' then 'Dementia'#(lf)#(tab)#(tab)when [DM].[Dementia] like 'null' then 'No Dementia'#(lf)#(tab)#(tab)when [DM].[Dementia] like '0' then 'No dementia'#(lf)#(tab)#(tab)else 'No dementia'#(lf)#(tab)#(tab)end as 'dementia_status'#(lf)#(tab)#(tab)#(lf)#(tab)   #(tab),case  #(lf)#(tab)#(tab)when [mpi].Derived_IsLivingInCareHome like '1' then 'Not Living Alone'#(lf)#(tab)#(tab)when [Care Home Type] not like 'null' then 'Not Living Alone'#(lf)#(tab)#(tab)when [mpi].[Derived_IsLivingAlone] like '0' then 'Not Living Alone'#(lf)#(tab)#(tab)when [mpi].[Derived_IsLivingAlone] is null  then 'Not Living Alone'#(lf)#(lf)#(tab)#(tab)else 'Living Alone'#(lf)#(tab)#(tab)end as 'living_alone_status'#(lf)#(lf)#(tab)#(tab)#(lf)#(lf)#(lf)#(lf)       #(tab),[CH].[Care Home Type]#(lf)#(tab)#(tab),[MPI].Derived_IsLivingInCareHome#(lf)#(lf)#(tab)#(tab),[Care_home_status] = case when [mpi].Derived_IsLivingInCareHome like '1' and [CH].[Care Home Type] IS NULL then 'Unknown Care Home Type'#(lf)#(tab)#(tab)when ([CH].[Care Home Type] not like 'NULL') then [CH].[Care Home Type]#(lf)#(tab)#(tab)when ([mpi].Derived_IsLivingInCareHome IS NULL and [CH].[Care Home Type] not like 'null') then [CH].[Care Home Type]#(lf)#(tab)#(tab)when  ([mpi].Derived_IsLivingInCareHome IS NULL and [CH].[Care Home Type]  IS NULL) then 'Not Living in a Care Home'#(lf)#(tab)#(tab)when  ([mpi].Derived_IsLivingInCareHome like '0' and [CH].[Care Home Type]  IS NULL) then 'Not Living in a Care Home'#(lf)#(lf)#(tab)#(tab)end#(lf)#(tab)#(lf)#(tab)#(tab)  ,[DP].[Derived_NHS_Number] [deceased_nhs_number]#(lf)#(tab)#(tab)  ,CASE WHEN [HPS].[Derived_Pseudo_NHS] = [DP].[Derived_NHS_Number] THEN 'Deceased'#(lf)#(tab)#(tab)        ELSE 'Alive' END AS [mortality_flag]#(lf)#(tab)#(tab)  ,[DP].[DateOfDeath] [date_of_death]#(lf)#(tab)#(tab)  ,DATEDIFF(week,[StartDate_HospitalProviderSpell], [DateOfDeath]) AS [death_in_weeks]#(lf),[10_year_age_band] = case when([A].[Age] between '65' and '74') THEN '65 to 74' #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when ([A].[Age]between '75' and '84') THEN '75 to 84'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when ([A].[Age] between '85' and '94') THEN '85 to 94'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when ([A].[Age] > '94') THEN '95+'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)else 'Under 65'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)end#(lf)#(tab),[MPI].[eFI_Score_derived] [frailty_score]#(lf)        , case when [MPI].[eFI_Catgory_derived]  like 'Fit' then 'Fit' #(lf)#(tab)#(tab)when [MPI].[eFI_Catgory_derived] like 'mild frailty' then 'Mild Frailty'#(lf)#(tab)#(tab)when [MPI].[eFI_Catgory_derived] like 'moderate frailty' then 'Moderate Frailty'#(lf)#(tab)#(tab)when [MPI].[eFI_Catgory_derived] like 'severe frailty' then 'Severe Frailty'#(lf)#(tab)#(tab)when [MPI].[eFI_Catgory_derived] like 'unknown' then 'Unknown'#(lf)#(tab)#(tab)else 'Unknown'#(lf)#(tab)#(tab)end as [frailty_category]#(lf)#(tab)#(tab),case when(cast([Derived_SEM_SpellLOS] AS INT) between '0' and '1') then cast([Derived_SEM_SpellLOS] AS INT)#(lf)#(tab)#(tab)else '0'#(lf)#(tab)#(tab)end as '0-1_days_los'#(lf)#(tab)#(tab),case when(cast([Derived_SEM_SpellLOS] AS INT) > '1') then cast([Derived_SEM_SpellLOS] AS INT)#(lf)#(tab)#(tab)else '0'#(lf)#(tab)#(tab)end as '2+_days_los'#(lf)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(lf)FROM [CCG_Current].[SEM].[vw_HospitalProviderSpell] [HPS]#(lf)LEFT JOIN [CCG_Reference].[Reference].[vw_AgeBand] [A] ON [HPS].[AgeatCDSActivityDate] = [A].[Age]#(lf)LEFT JOIN [CCG_Reference].[Reference].[vw_DateLookup] [D] ON CAST([HPS].DischargeDate_FromHospitalProviderSpell AS DATE) = [D].[date]#(lf)LEFT JOIN [CCG_Reference].[Reference].[vw_GPPractice] [GP] ON [gppractice_derived] = [GP].OrganisationCode#(lf)LEFT JOIN [CCG_Reference].[Reference].[vw_HRG] [HRG] ON [HPS].[SpellCOREHRG] = [HRGCode]#(lf)LEFT JOIN [CCG_Reference].[Reference].[vw_ICD10] [ICD] ON LEFT([HPS].[Derived_SEM_SpellPDiag],4) = [ICD].ICD10Code#(lf)LEFT JOIN #Temp_Dementia [DM] ON [HPS].[Derived_Pseudo_NHS] = [DM].[PseudoNHSNo]#(lf)LEFT JOIN [BIReports].[MPI].[MPI_current] [MPI] ON [HPS].[Derived_Pseudo_NHS] = [MPI].[Derived_Pseudo_NHS]#(lf)--LEFT JOIN [CCG_Reference].[Population].[vw_NHAIS_Deaths] [DP] ON [HPS].[Derived_Pseudo_NHS] = [DP].[Derived_Pseudo_NHS]#(lf)#(lf)LEFT JOIN [CCG_Reference].[Population].[vw_PDS_Deaths] [DP] ON [HPS].[Derived_Pseudo_NHS] = [DP].[Derived_NHS_Number]#(lf)#(lf)LEFT JOIN #Care_Home [CH] ON [CH].Derived_Pseudo_NHSNumber = [HPS].Derived_Pseudo_NHS#(lf)#(lf)WHERE CAST([HPS].DischargeDate_FromHospitalProviderSpell AS DATE) between '20190401'   AND EOMONTH(DATEADD(MONTH, -1, GETDATE()))#(lf)#(lf)#(lf)AND LEFT([HPS].[AdmissionMethod_HospitalProviderSpell],1) = '2'#(lf)AND [HPS].[OrganisationCode_CodeOfCommissioner] LIKE '11M%'#(lf)AND [HPS].[AgeatCDSActivityDate] >= 65#(lf)AND (CONCAT(ISNULL(Diagnosis1stSecondary_ICD ,0) , ISNULL(Diagnosis2ndSecondary_ICD ,0) , ISNULL(Diagnosis3rdSecondary_ICD ,0) , ISNULL(Diagnosis4thSecondary_ICD,0), #(lf)           ISNULL(Diagnosis5thSecondary_ICD ,0) , ISNULL(Diagnosis6thSecondary_ICD ,0) , ISNULL(Diagnosis7thSecondary_ICD ,0) , ISNULL(Diagnosis8thSecondary_ICD,0), #(lf)#(tab)       ISNULL(Diagnosis9thSecondary_ICD ,0) , ISNULL(Diagnosis10thSecondary_ICD ,0) , ISNULL(Diagnosis11thSecondary_ICD ,0) , ISNULL(Diagnosis12thSecondary_ICD,0), #(lf)#(tab)       ISNULL( [Derived_SEM_SpellPDiag],0) ) LIKE '%W[00-19]%' AND [ICD].[ICD10_Chapter_Description] = 'Injury, poisoning and certain other consequences of external causes')#(lf)#(lf)#(tab)and Locality not like 'null'#(lf)#(lf)#(tab)#(lf)#(tab)#(tab)  order by DischargeDate_FromHospitalProviderSpell asc"]),
