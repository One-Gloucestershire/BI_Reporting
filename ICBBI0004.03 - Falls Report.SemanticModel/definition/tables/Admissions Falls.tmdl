				let
				    Source = Sql.Database("grh-ccg-sql", "ccg_current", [Query="--==--==--==--==--==--==--==--==--==--==--==--==--==--==#(lf)-- GHFT ED Attendances for Falls -- #(lf)--==--==--==--==--==--==--==--==--==--==--==--==--==--==#(lf)--Created by: Kyran Witney#(lf)--Created on: #(lf)--Updated by: Alex Davey#(lf)--Updated on: 28/02/2023#(lf)#(lf)SET ANSI_WARNINGS OFF#(lf)SET NOCOUNT ON#(lf)if object_id ('tempdb..#Temp_Dementia') is not null drop table #Temp_Dementia#(lf)#(lf)--- DEMENTIA TEMP#(lf)#(lf)SELECT DISTINCT [PseudoNHSNo],#(lf)[Dementia]#(lf)INTO #Temp_Dementia#(lf)FROM [CCG_Current].[PrimaryCare].[vw_LongTermConditionsQOFPatients]#(lf)WHERE [Dementia] = '1'#(lf)#(lf)#(lf)--Care home temp table, pulling in care home name and type#(lf)#(lf)SET ANSI_WARNINGS OFF#(lf)SET NOCOUNT ON#(lf)if object_id ('tempdb..#Care_Home') is not null drop table #Care_Home#(lf)#(lf)SELECT DISTINCT#(lf) #(lf)#(tab)Derived_Pseudo_NHSNumber#(lf)      ,[Residential_or_Nursing_home_Location_Name]#(lf)#(tab)  ,[Nursing Care Homes ]#(lf)#(tab)  ,[Care Home Type]#(lf)#(tab)  ,[Date_of_incident] = cast([Time_Of_Incident] as date)#(lf)#(lf)#(tab)  INTO #Care_Home#(lf)#(lf)  FROM [CCG_Current].[SWASFT].[vw_AmbulanceServicePatient] [A]#(lf)#(lf)  LEFT JOIN [BIReports].[dbo].[CHLookup2022_Oct] [CH] ON [CH].[SWASFT Care Home Name] = [A].[Residential_or_Nursing_home_Location_Name]#(lf)   #(lf)  where #(lf)  #(lf)   [Residential_or_Nursing_home_Location] not like 'null'#(lf)#(lf)  and Derived_Pseudo_NHSNumber not like 'Null'#(lf)#(lf)  and [Care Home Type] not like 'NULL'#(lf)#(lf)#(lf)---- MAIN SCRIPT#(lf)#(lf)SELECT   distinct#(lf)          'Hospital Admission' [type]#(lf)#(tab)#(tab)  #(lf)#(tab)#(tab),[Grouped_Discharge_Destination] = case when DischargeDestination_HospitalProviderSpell like '19' then 'Usual Place of Residence'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when DischargeDestination_HospitalProviderSpell like '29' then 'Temporary Place of Residence'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when DischargeDestination_HospitalProviderSpell like '30' then 'Psychiatric Accomodation'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when DischargeDestination_HospitalProviderSpell like '37' then 'Court/Prison/Police Station'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when DischargeDestination_HospitalProviderSpell like '38' then 'Court/Prison/Police Station'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when DischargeDestination_HospitalProviderSpell like '48' then 'Psychiatric Accomodation'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when DischargeDestination_HospitalProviderSpell like '49' then 'Psychiatric Accomodation'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when DischargeDestination_HospitalProviderSpell like '50' then 'Psychiatric Accomodation'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when DischargeDestination_HospitalProviderSpell like '51' then 'Other Hospital Provider'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when DischargeDestination_HospitalProviderSpell like '52' then 'Other Hospital Provider'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when DischargeDestination_HospitalProviderSpell like '53' then 'Other Hospital Provider'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when DischargeDestination_HospitalProviderSpell like '54' then 'Care Home'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when DischargeDestination_HospitalProviderSpell like '65' then 'Local Authority Care'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when DischargeDestination_HospitalProviderSpell like '66' then 'Local Authority Care'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when DischargeDestination_HospitalProviderSpell like '79' then 'Patient Died'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when DischargeDestination_HospitalProviderSpell like '84' then 'Psychiatric Accomodation'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when DischargeDestination_HospitalProviderSpell like '85' then 'Care Home'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when DischargeDestination_HospitalProviderSpell like '87' then 'Non-NHS Hospital'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)when DischargeDestination_HospitalProviderSpell like '88' then 'Hospice'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)else 'Not Coded'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)END#(lf)#(lf)#(tab)#(tab),DischargeDestination_HospitalProviderSpell#(lf)#(tab)#(tab),DischargeMethod_HospitalProviderSpell_Description#(lf)#(lf)          ,[hospital_provider_spell_number] = [HospitalProviderSpellNumber]#(lf)          ,[HPS].[Derived_Pseudo_NHS] [nhs_number]#(lf)#(tab)#(tab)  #(lf)#(tab)#(tab)  ,Sex = case when [sex] like '1' then 'Male' #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)when [Sex] like '2' then 'Female'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)end#(lf)          ,[OrganisationCode_CodeOfProvider] [provider_code]#(lf)#(tab)#(tab)  ,CASE WHEN [SiteCode_ofTreatmentAtEpisodeStartDate] = 'RTE01' THEN 'Cheltenham General Hospital'#(lf)                WHEN [SiteCode_ofTreatmentAtEpisodeStartDate] = 'RTE03' THEN 'Gloucester Royal Hospital'#(lf)#(tab)#(tab)#(tab)#(tab)else 'Out of County Hospital'#(lf)                END AS [site]#(lf)          ,CAST(DischargeDate_FromHospitalProviderSpell AS DATE) [discharge_date]#(lf)#(tab)#(tab)  --,[DP].[Date_Of_Death] [date_of_death]#(lf)#(tab)#(tab)  ,[DischargeDestination_HospitalProviderSpell]#(lf)#(tab)#(tab)  ,[DischargeDate_FromHospitalProviderSpell] [discharge_date_time]#(lf)#(tab)#(tab)  ,DischargeDestination_HospitalProviderSpell_Description#(lf)#(tab)#(tab)  ,case when DischargeDestination_HospitalProviderSpell like '79' then 'Died in Hospital'#(lf)