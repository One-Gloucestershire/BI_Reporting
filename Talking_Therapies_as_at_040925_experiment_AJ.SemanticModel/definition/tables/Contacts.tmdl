table Contacts
	lineageTag: 7cc10f5c-090d-47e6-8579-430b5cc11900

	measure AverageContacts = AVERAGE(Contacts[CARE_CONTACT_COUNT])
		lineageTag: 658b0724-7e5f-46ff-91bd-d08be08c17e0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Column1
		dataType: int64
		formatString: 0
		lineageTag: bc88c54a-bc27-4c37-a124-6a843f38fe1a
		summarizeBy: sum
		sourceColumn: Column1

		annotation SummarizationSetBy = Automatic

	partition Contacts = m
		mode: import
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "CCG_Current", [Query="select 1#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)--IF OBJECT_ID('tempdb..#IAPT_ReferralsTempTable') is not null#(lf)--BEGIN#(lf)--       drop table #IAPT_ReferralsTempTable#(lf)--END#(lf)----Referrals Table#(lf)--  ---copy of script - less fields#(lf)#(lf)#(lf)------Temp table#(lf)#(lf)----------------------------------------------------------------------------------------------------------#(lf)------- Create Gender Temp Table (From PDS, gets the latest gender entry)#(lf)-----------------------------------------------------------------------------------------------------------#(lf)-----First create gender reference table from PDS#(lf)--IF OBJECT_ID('TEMPDB..#gender_ref') IS NOT NULL DROP TABLE #gender_ref#(lf)#(lf)--select  p.Derived_NHS_Number#(lf)--,p.Gender_Code#(lf)--,p.Gender_Desc#(lf)#(lf)--into #gender_ref#(lf)#(lf)--from CCG_Reference.Population.vw_PDS_All  as p#(lf)#(lf)--Inner join#(lf)#(lf)--(select Derived_NHS_Number,[Latest_update] = max(SerialChangeNo)#(lf)--from CCG_Reference.Population.vw_PDS_All#(lf)--where Gender_Code is not null#(lf)--group by Derived_NHS_Number#(lf)#(lf)--) AS m on m.Latest_update = p.SerialChangeNo AND m.Derived_NHS_Number = p.Derived_NHS_Number#(lf)----------------------------------------------------------------------------------------------------------#(lf)--IF OBJECT_ID('tempdb..#CTSnomedTempTable') is not null#(lf)--BEGIN#(lf)--       drop table #CTSnomedTempTable#(lf)--END#(lf)--Select Distinct [ConceptID], [PreferredTerm]#(lf)--  into #CTSnomedTempTable#(lf)--From [CCG_Reference].[SNOMED].[vw_PreferredSynonym]#(lf)#(lf)--/*==========================================================================================#(lf)--PRIMARY CARE LTC'S temp table - Taken from MPI logic #(lf)--==========================================================================================*/#(lf)--IF OBJECT_ID('TEMPDB..#TempLTC2') IS NOT NULL DROP TABLE #TempLTC2 --20/08 AJ added this in. If you don't include this if you run the script twice it will fail as the table already exists. #(lf)#(lf)--PRINT 'LTC Table'#(lf)--SELECT DISTINCT [LTC].[PseudoNHSNumber],#(lf)--[LTCCount] = MAX(CASE  WHEN [LTCCODE] = 'QOF48_AST_REG' THEN 1 ELSE 0 END)+#(lf)--#(tab)#(tab)#(tab) MAX(CASE  WHEN [LTCCODE] = 'QOF48_AF_REG' THEN 1 ELSE 0 END)+#(lf)--#(tab)#(tab)#(tab) MAX(CASE  WHEN [LTCCODE] = 'QOF48_CAN_REG' THEN 1 ELSE 0 END)+#(lf)--#(tab)#(tab)#(tab) MAX(CASE  WHEN [LTCCODE] IN ('QOF48_CKD_COD') THEN 1 ELSE 0 END)+#(lf)--#(tab)#(tab)#(tab) MAX(CASE  WHEN [LTCCODE] = 'QOF48_COPD_COD' THEN 1 ELSE 0 END)+#(lf)--#(tab)#(tab)#(tab) MAX(CASE  WHEN [LTCCODE] = 'QOF48_CHD_REG' THEN 1 ELSE 0 END)+#(lf)--#(tab)#(tab)#(tab) MAX(CASE  WHEN [LTCCODE] = 'QOF48_DEM_REG' THEN 1 ELSE 0 END)+#(lf)--#(tab)#(tab)#(tab) MAX(CASE  WHEN [LTCCODE] = 'QOF48_DEP_REG' THEN 1 ELSE 0 END)+#(lf)--#(tab)#(tab)#(tab) MAX(CASE  WHEN [LTCCODE] = 'QOF48_DM_REG' THEN 1 ELSE 0 END)+#(lf)--#(tab)#(tab)#(tab) MAX(CASE  WHEN [LTCCODE] = 'QOF48_EPIL_REG' THEN 1 ELSE 0 END)+#(lf)--#(tab)#(tab)#(tab) MAX(CASE  WHEN [LTCCODE] = 'QOF48_HF_REG' THEN 1 ELSE 0 END)+ #(lf)--#(tab)#(tab)#(tab) MAX(CASE  WHEN [LTCCODE] = 'QOF48_HYP_REG' THEN 1 ELSE 0 END)+#(lf)--#(tab)#(tab)#(tab) MAX(CASE  WHEN [LTCCODE] = 'QOF48_LD_REG' THEN 1 ELSE 0 END)+#(lf)--#(tab)#(tab)#(tab) MAX(CASE  WHEN [LTCCODE] = 'QOF48_MH_REG' THEN 1 ELSE 0 END)+#(lf)--#(tab)#(tab)#(tab) MAX(CASE  WHEN [LTCCODE] = 'QOF48_BMIVAL_COD' THEN 1 ELSE 0 END)+#(lf)--#(tab)#(tab)#(tab) MAX(CASE  WHEN [LTCCODE] = 'QOF48_PALCARE_REG' THEN 1 ELSE 0 END)+#(lf)--#(tab)#(tab)#(tab) MAX(CASE  WHEN [LTCCODE] in ('QOF48_STRK_COD','QOF48_TIA_COD') THEN 1 ELSE 0 END),#(lf)--[Asthma] = MAX(CASE  WHEN [LTCCODE] = 'QOF48_AST_REG' THEN 1 ELSE 0 END),#(lf)--[AtrialFibrillation] = MAX(CASE  WHEN [LTCCODE] = 'QOF48_AF_REG' THEN 1 ELSE 0 END),#(lf)--[Cancer] = MAX(CASE  WHEN [LTCCODE] = 'QOF48_CAN_REG' THEN 1 ELSE 0 END),#(lf)--[ChronicKidneyDisease] = MAX(CASE  WHEN [LTCCODE] IN ('QOF48_CKD_COD') THEN 1 ELSE 0 END),#(lf)--[ChronicObstructivePulmonaryDisease] = MAX(CASE  WHEN [LTCCODE] = 'QOF48_COPD_COD' THEN 1 ELSE 0 END),#(lf)--[CoronaryHeartDisease] = MAX(CASE  WHEN [LTCCODE] = 'QOF48_CHD_REG' THEN 1 ELSE 0 END),#(lf)--[Dementia] = MAX(CASE  WHEN [LTCCODE] = 'QOF48_DEM_REG' THEN 1 ELSE 0 END),#(lf)--[Depression] = MAX(CASE  WHEN [LTCCODE] = 'QOF48_DEP_REG' THEN 1 ELSE 0 END),#(lf)--[Diabetes] = MAX(CASE  WHEN [LTCCODE] = 'QOF48_DM_REG' THEN 1 ELSE 0 END),#(lf)--[Epilepsy] = MAX(CASE  WHEN [LTCCODE] = 'QOF48_EPIL_REG' THEN 1 ELSE 0 END),#(lf)--[HeartFailure] = MAX(CASE  WHEN [LTCCODE] = 'QOF48_HF_REG' THEN 1 ELSE 0 END), #(lf)--[Hypertension] = MAX(CASE  WHEN [LTCCODE] = 'QOF48_HYP_REG' THEN 1 ELSE 0 END),#(lf)--[Hypothyroidism] = Null,#(lf)--[LearningDisability] = MAX(CASE  WHEN [LTCCODE] = 'QOF48_LD_REG' THEN 1 ELSE 0 END),#(lf)--[MentalIllness] = MAX(CASE  WHEN [LTCCODE] = 'QOF48_MH_REG' THEN 1 ELSE 0 END),#(lf)--[Obesity] = NULL,#(lf)--[PalliativeCare] = MAX(CASE  WHEN [LTCCODE] = 'QOF48_PALCARE_REG' THEN 1 ELSE 0 END),#(lf)--[Stroke] = MAX(CASE  WHEN [LTCCODE] IN ('QOF48_STRK_COD','QOF48_TIA_COD') THEN 1 ELSE 0 END),#(lf)--[Smoker] = NULL #(lf)#(lf)--into #TempLTC2#(lf)#(lf)--FROM [CCG_Current].[PrimaryCare].[vw_LongTermConditions] [LTC]#(lf)--GROUP BY [LTC].[PseudoNHSNumber]#(lf)--ORDER BY [LTC].[PseudoNHSNumber]#(lf)#(lf)--;#(lf)#(lf)----Obesity Logic#(lf)----IF OBJECT_ID('TEMPDB..#ObesityLTC1') IS NOT NULL DROP TABLE #ObesityLTC1#(lf)--SELECT [PseudoNHSNumber],#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)[ltccode],#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)cast(Value1 as float)  as [Value],#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)row_number() over(partition by [PseudoNHSNumber] order by #(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)--If a BMI value within 6 months, grab this instead. #(tab)#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)CASE #(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN cast(Value1 as float) IS NOT NULL AND eventdate >= DATEADD(MONTH, -6, GETDATE()) THEN 1#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ELSE 2#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)END,#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)eventdate DESC) as [Distinct]#(lf)--INTO #ObesityLTC1#(lf)--FROM [CCG_Current].[PrimaryCare].[vw_LongTermConditionsEvents]#(lf)--#(tab)#(tab)--WHERE [ltccode] in ('QOF48_BMI30_COD','QOF48_BMIVAL_COD')#(lf)--#(tab)#(tab)--AND [eventdate] between ('2022-APR-01') AND ('2023-MAR-31'))#(lf)--#(tab)#(tab)WHERE ([ltccode] = 'QOF48_BMI30_COD' or#(lf)--#(tab)#(tab)[ltccode] = 'QOF48_BMIVAL_COD')#(lf)--;#(lf)#(lf)----update obesity flag#(lf)#(lf)--UPDATE #TempLTC2 #(lf)--SET [Obesity] = 1#(lf)--FROM #TempLTC2 [a]#(lf)--LEFT JOIN #ObesityLTC1 [b] on [a].[PseudoNHSNumber] = [b].[PseudoNHSNumber]#(lf)--WHERE #(lf)--[Distinct] = 1 and#(lf)--([b].LTCCode = 'QOF48_BMI30_COD' or#(lf)--([b].LTCCode = 'QOF48_BMIVAL_COD' and cast([Value] as float) >= 30 AND cast([Value] as float) <75))#(lf)--;#(lf)----update Smoker flag#(lf)#(lf)--UPDATE #TempLTC2#(lf)--SET [Smoker] = 1 #(lf)--WHERE [PseudoNHSNumber] IN (SELECT [E].[PseudoNHSNumber]#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)FROM [CCG_Current].[PrimaryCare].[vw_Events] [E]#(lf) #(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)LEFT JOIN (SELECT * #(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)FROM [CCG_Current].[PrimaryCare].[vw_Events] #(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHERE [SnomedCode] IN ('1092031000000108','1092091000000109','1092131000000107','160617001','160620009','160621008','266921000',#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)'266922007','266923002','281018007','360890004','53896009','8517006','1092041000000104','1092071000000105','1092111000000104',#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)'160625004','228486009','266924008','266925009','266928006','360900008','48031000119106','492191000000103','735112005','735128000')#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)/*ex smoker codes*/) AS [E2]#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ON [E].[PseudoNHSNumber] = [E2].[PseudoNHSNumber]#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)AND [E].[EventDate] < [E2].[EventDate]#(lf) #(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHERE [E].[SnomedCode] IN ('134406006','160604004','160606002','160612007','160616005','225934006','230056004','230059006','230063004',#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)'230064005','266920004','266929003','308438006','394871007','394872000','401159003','428041000124106',#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)'446172000','449868002','77176002','82302008','836001000000109','160603005','160605003','160613002',#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)'160619003','203191000000107','230057008','230058003','230060001','230062009','230065006',#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)'394873005','413173009','56578002','56771006','59978006','65568007')#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)AND [E2].[SnomedCode] IS NULL)#(lf)#(lf)--;#(lf)-----------------------------------------------------------------------------------------------------------#(lf)------- Main query  ---#(lf)-----------------------------------------------------------------------------------------------------------#(lf)--SELECT #(lf)--      r.[UNIQUE_SERVICE_REQUEST_IDENTIFIER] #(lf)--      ,PRESENTING_COMPLAINT_HIGHER_CATEGORY#(lf)--    ,CASE SOURCE_OF_REFERRAL_FOR_IMPROVING_ACCESS_TO_PSYCHOLOGICAL_THERAPIES#(lf)--    WHEN 'NULL' THEN 'No source recorded' -- AJ 13/08 this won't find nulls as you're searching for a string here and not actual null values. You could change SOURCE_OF_REFERRAL_FOR_IMPROVING_ACCESS_TO_PSYCHOLOGICAL_THERAPIES to isnull(SOURCE_OF_REFERRAL_FOR_IMPROVING_ACCESS_TO_PSYCHOLOGICAL_THERAPIES,'')  . This will change all nulls to blanks. Then instead of 'NULL' here you would change it too ''.#(lf)--    WHEN 'A1' THEN 'Primary Health Care: General Medical Practitioner Practice'#(lf)--    WHEN 'A2' THEN 'Primary Health Care: Health Visitor'#(lf)--    WHEN 'A3' THEN 'Other Primary Health Care'#(lf)--    WHEN 'A4' THEN 'Primary Health Care: Maternity Service'#(lf)--    WHEN 'B1' THEN 'Self-Referral: Self'#(lf)--    WHEN 'C1' THEN 'Social Services'#(lf)--    WHEN 'C2' THEN 'Education Service / Educational Establishment'#(lf)--    WHEN 'D1' THEN 'Employer'#(lf)--    WHEN 'E3' THEN 'Probation Service'#(lf)--    WHEN 'E5' THEN 'Court Liaison and Diversion Service'#(lf)--    WHEN 'F3' THEN 'Community-based Paediatrics'#(lf)--    WHEN 'G3' THEN 'Other Independent Sector Mental Health Services'#(lf)--    WHEN 'H1' THEN 'Emergency Care Department'#(lf)--    WHEN 'H2' THEN 'Other Secondary Care Specialty'#(lf)--    WHEN 'I2' THEN 'Permanent transfer from another Mental Health NHS Trust'#(lf)--    WHEN 'M1' THEN 'Asylum Services'#(lf)--    WHEN 'M2' THEN 'Telephone or Electronic Access Service'#(lf)--    WHEN 'M4' THEN 'Drug Action Team / Drug Misuse Agency'#(lf)--    WHEN 'M5' THEN 'Jobcentre Plus'#(lf)--    WHEN 'M6' THEN 'Other Service or Agency'#(lf)--    WHEN 'M7' THEN 'Single Point of Access Service'#(lf)--    WHEN 'N1' THEN 'Stepped up from low intensity IAPT Service'#(lf)--    WHEN 'N4' THEN 'Other IAPT Service'#(lf)--    WHEN 'P1' THEN 'Internal Referral'#(lf)--   -- ELSE 'Unknown code'#(lf)--               END AS ReferralSourceDescription#(lf)--      ,[REFERRAL_REQUEST_RECEIVED_DATE]#(lf)--      ,[SERVICE_DISCHARGE_DATE]#(lf)--      ,CARE_CONTACT_COUNT#(lf)--      ,[GP_Code]#(lf)--      ,a.[Age_Band_5_YRS]#(lf)--      ,a.[Age_Band_10_YRS]#(lf)--                 ,Locality#(lf)--                 ,PrimaryCareNetwork#(lf)--                 ,1 as Counter --number of Referrals#(lf)--                 ,CASE WHEN [DISCHARGE_FROM_IMPROVING_ACCESS_TO_PSYCHOLOGICAL_THERAPIES_SERVICE_REASON] = '5' then 'Referred but not seen'#(lf)--                                  WHEN [DISCHARGE_FROM_IMPROVING_ACCESS_TO_PSYCHOLOGICAL_THERAPIES_SERVICE_REASON] in ('10','11',         '12','13','14',        '16','17','95') then 'Seen but not taken on for a course of treatment'#(lf)--                                             WHEN [DISCHARGE_FROM_IMPROVING_ACCESS_TO_PSYCHOLOGICAL_THERAPIES_SERVICE_REASON] in ('46','47','48','49','96') then 'Seen and taken on for a course of treatment'#(lf)--                                             ELSE 'Not Categorised' END AS 'Discharge_Reason_Group'#(lf)#(lf)--,CASE [DISCHARGE_FROM_IMPROVING_ACCESS_TO_PSYCHOLOGICAL_THERAPIES_SERVICE_REASON]#(lf)--    WHEN 50 THEN 'Not assessed'#(lf)--    WHEN 10 THEN 'Not suitable for IAPT service - no action taken or directed back to referrer'#(lf)--    WHEN 11 THEN 'Not suitable for IAPT service - signposted elsewhere with mutual agreement of patient'#(lf)--    WHEN 12 THEN 'Discharged by mutual agreement following advice and support'#(lf)--    WHEN 13 THEN 'Referred to another therapy service by mutual agreement'#(lf)--    WHEN 14 THEN 'Suitable for IAPT service, but patient declined treatment that was offered'#(lf)--    WHEN 16 THEN 'Incomplete Assessment (Patient dropped out)'#(lf)--    WHEN 17 THEN 'Deceased (Seen but not taken on for a course of treatment)'#(lf)--    WHEN 95 THEN 'Not Known (Seen but not taken on for a course of treatment)'#(lf)--    WHEN 46 THEN 'Mutually agreed completion of treatment'#(lf)--    WHEN 47 THEN 'Termination of treatment earlier than Care Professional planned'#(lf)--    WHEN 48 THEN 'Termination of treatment earlier than patient requested'#(lf)--    WHEN 49 THEN 'Deceased (Seen and taken on for a course of treatment)'#(lf)--    WHEN 96 THEN 'Not Known (Seen and taken on for a course of treatment)'#(lf)--    ELSE 'Unknown'#(lf)--END AS DischargeReasonDescription#(lf)--       ,Derived_Postcode#(lf)--                  ,i.Derived_IMDGloucestershireDecile#(lf)--                  ,[Ethnicity] = e.[Ethnic Origin Grouped]#(lf)--                  ,d.Fin_Year#(lf)--                  ,d.Month_Name#(lf)--                  ,d.Month_Short_Name#(lf)#(lf)--   ,CASE #(lf)--    WHEN i.IndexOfMultipleDeprivation_EnglandDecile IN (1, 2) THEN 'Quintile 1 - Most deprived areas'#(lf)--    WHEN i.IndexOfMultipleDeprivation_EnglandDecile IN (3, 4) THEN 'Quintile 2 - More deprived than average'#(lf)--    WHEN i.IndexOfMultipleDeprivation_EnglandDecile IN (5, 6) THEN 'Quintile 3 - Mid-range deprivation'#(lf)--    WHEN i.IndexOfMultipleDeprivation_EnglandDecile IN (7, 8) THEN 'Quintile 4 - Less deprived than average'#(lf)--    WHEN i.IndexOfMultipleDeprivation_EnglandDecile IN (9, 10) THEN 'Quintile 5 - Least deprived areas'#(lf)--    END AS DeprivationQuintileLabel#(lf)#(lf)#(lf)--   ,g.Gender_Desc#(lf)--               --AJ below added into LTC data from PC (Current recorded LTC's)#(lf)--  ,[LTC_Count] = [C].LTCCount#(lf)--,[C].[Smoker]#(lf)--,[C].[Obesity]#(lf)--,[C].[Asthma]#(lf)--,[C].[ChronicObstructivePulmonaryDisease]#(lf)--,[C].[Dementia]#(lf)--,[C].[Depression]#(lf)--,[C].[Diabetes]#(lf)--,[C].[PalliativeCare]#(lf)--,[C].[ChronicKidneyDisease]#(lf)--,[C].[Epilepsy]#(lf)--,[C].[HeartFailure]#(lf)--,[C].[Stroke]#(lf)--,[C].[MentalIllness]#(lf)--,[C].[AtrialFibrillation]#(lf)--,[C].[Cancer]#(lf)--,[C].[CoronaryHeartDisease]#(lf)--,[C].[Hypertension]#(lf)--,[C].[Hypothyroidism]#(lf)--,[C].[LearningDisability]#(lf)                  #(lf)--into #IAPT_ReferralsTempTable#(lf)#(lf)                           #(lf)--  FROM [CCG_Current].[IAPT].[vw_101_Referral] as r #(lf)--LEFT JOIN #TempLTC2 as c ON r.Derived_Pseudo_NHS = c.PseudoNHSNumber  -- AJ added in 12/08  from PC data.#(lf)#(lf)--LEFT JOIN [DSCRO_NATIONAL_LOOKUPS].[dbo].[ref_Age] as a ON cast(r.AGE_AT_REFERRAL_REQUEST_RECEIVED_DATE as int) = a.[pk_Age]#(lf)--LEFT JOIN [CCG_Reference].[Reference].[vw_GPPractice] as gp on gp.OrganisationCode =  r.GP_Code#(lf)--LEFT JOIN [DSCRO_NATIONAL_LOOKUPS].[dbo].[ref_Dates] as d ON cast(d.Full_Date as date) = r.[REFERRAL_REQUEST_RECEIVED_DATE]#(lf)--LEFT JOIN CCG_Reference.Reference.vw_Postcode as p on p.POSTCODE_PKEY = r.Derived_Postcode#(lf)--LEFT JOIN CCG_Reference.Reference.vw_LSOA_IMD AS i on i.LSOACode = p.LSOA_2011#(lf)--LEFT JOIN BIReports.MPI.Ethnicity_Table as e on e.PseudoNHSNo = r.Derived_Pseudo_NHS#(lf)--left join #gender_ref as g on g.Derived_NHS_Number = r.Derived_Pseudo_NHS -- gender from pds table#(lf)----left join #CTSnomedTempTable as b ON c.[LONG_TERM_PHYSICAL_HEALTH_CONDITION_CODED_CLINICAL_ENTRY] = b.[ConceptID]#(lf)#(lf)--Where  REFERRAL_REQUEST_RECEIVED_DATE >= '20220401'#(lf)----AND ORGANISATION_IDENTIFIER_CODE_OF_COMMISSIONER like'11M%'#(lf)--AND r.ORGANISATION_IDENTIFIER_CODE_OF_PROVIDER like 'RTQ%'#(lf)--AND r.Is_Active_Record = '1'#(lf)--order by r.UNIQUE_SERVICE_REQUEST_IDENTIFIER#(lf)-----------------------------------------------------------------------------#(lf)----Care_Contacts_Table#(lf)--IF OBJECT_ID('tempdb..#IAPT_ContactsTempTable') is not null#(lf)--BEGIN#(lf)--       drop table #IAPT_ContactsTempTable#(lf)--END#(lf)#(lf)--SELECT #(lf)-- c.UNIQUE_SERVICE_REQUEST_IDENTIFIER#(lf)--,UNIQUE_CARE_CONTACT_IDENTIFIER#(lf)--,C.CARE_CONTACT_DATE#(lf)--,[Date_Order] = ROW_NUMBER() OVER(PARTITION BY c.UNIQUE_SERVICE_REQUEST_IDENTIFIER ORDER BY CARE_CONTACT_DATE ASC) #(lf)--,APPOINTMENT_TYPE_IMPROVING_ACCESS_TO_PSYCHOLOGICAL_THERAPIES,#(lf)--[APPOINTMENT_TYPE_IMPROVING_ACCESS_TO_PSYCHOLOGICAL_THERAPIES_Desc] = CASE#(lf)--    WHEN APPOINTMENT_TYPE_IMPROVING_ACCESS_TO_PSYCHOLOGICAL_THERAPIES = '01' THEN 'Assessment'#(lf)--    WHEN APPOINTMENT_TYPE_IMPROVING_ACCESS_TO_PSYCHOLOGICAL_THERAPIES = '02' THEN 'Treatment'#(lf)--    WHEN APPOINTMENT_TYPE_IMPROVING_ACCESS_TO_PSYCHOLOGICAL_THERAPIES = '03' THEN 'Assessment and treatment'#(lf)--    WHEN APPOINTMENT_TYPE_IMPROVING_ACCESS_TO_PSYCHOLOGICAL_THERAPIES = '04' THEN 'Review only'#(lf)--    WHEN APPOINTMENT_TYPE_IMPROVING_ACCESS_TO_PSYCHOLOGICAL_THERAPIES = '05' THEN 'Review and treatment'#(lf)--    WHEN APPOINTMENT_TYPE_IMPROVING_ACCESS_TO_PSYCHOLOGICAL_THERAPIES = '06' THEN 'Follow-up appointment after treatment end'#(lf)--    WHEN APPOINTMENT_TYPE_IMPROVING_ACCESS_TO_PSYCHOLOGICAL_THERAPIES = '10' THEN 'Employment Support'#(lf)--    WHEN APPOINTMENT_TYPE_IMPROVING_ACCESS_TO_PSYCHOLOGICAL_THERAPIES = '98' THEN 'Other (not listed)'#(lf)--    WHEN APPOINTMENT_TYPE_IMPROVING_ACCESS_TO_PSYCHOLOGICAL_THERAPIES = '99' THEN 'Not Known (Not Recorded)'#(lf)--    ELSE 'Unknown appointment type' END#(lf)#(lf)--,ATTENDED_OR_DID_NOT_ATTEND_CODE#(lf)--,[ATTENDED_OR_DID_NOT_ATTEND_Desc] = #(lf)--CASE#(lf)--    WHEN ATTENDED_OR_DID_NOT_ATTEND_CODE = 5 THEN 'Attended on time or, if late, before the relevant professional was ready to see the patient'#(lf)--    WHEN ATTENDED_OR_DID_NOT_ATTEND_CODE = 6 THEN 'Arrived late, after the relevant professional was ready to see the patient, but was seen'#(lf)--    WHEN ATTENDED_OR_DID_NOT_ATTEND_CODE = 7 THEN 'Patient arrived late and could not be seen'#(lf)--    WHEN ATTENDED_OR_DID_NOT_ATTEND_CODE = 2 THEN 'Appointment cancelled by, or on behalf of the patient'#(lf)--    WHEN ATTENDED_OR_DID_NOT_ATTEND_CODE = 3 THEN 'Did not attend, no advance warning given'#(lf)--    WHEN ATTENDED_OR_DID_NOT_ATTEND_CODE = 4 THEN 'Appointment cancelled or postponed by the health care provider'#(lf)--    ELSE 'Unknown status'#(lf)--END#(lf)#(lf)--,C.CONSULTATION_MECHANISM_MENTAL_HEALTH#(lf)#(lf)--into #IAPT_ContactsTempTable#(lf)#(lf)--from CCG_Current.IAPT.vw_201_Care_Contact AS C#(lf)--WHERE ORGANISATION_IDENTIFIER_CODE_OF_PROVIDER = 'RTQ'#(lf)----AND ORGANISATION_IDENTIFIER_CODE_OF_COMMISSIONER = '11M'#(lf)--AND CARE_CONTACT_DATE >= '2022-04-01'#(lf)----AND [ATTENDED_OR_DID_NOT_ATTEND_CODE] in ('5', '6')#(lf)----Think need the DNA's#(lf)--order by C.CARE_CONTACT_DATE asc#(lf)--------------------------------------#(lf)--Select#(lf)#(lf)--r.UNIQUE_SERVICE_REQUEST_IDENTIFIER#(lf)--,r.REFERRAL_REQUEST_RECEIVED_DATE#(lf)--,C.[APPOINTMENT_TYPE_IMPROVING_ACCESS_TO_PSYCHOLOGICAL_THERAPIES_Desc]#(lf)--,C.[Date_Order]#(lf)--,C.CARE_CONTACT_DATE#(lf)--,C.ATTENDED_OR_DID_NOT_ATTEND_Desc#(lf)--,C.[APPOINTMENT_TYPE_IMPROVING_ACCESS_TO_PSYCHOLOGICAL_THERAPIES_Desc]#(lf)--,r.[CARE_CONTACT_COUNT]#(lf)--,'1' as Counter#(lf)--,CASE WHEN C.[ATTENDED_OR_DID_NOT_ATTEND_CODE] in ('5', '6') then 'Attended' #(lf)--      WHEN C.[ATTENDED_OR_DID_NOT_ATTEND_CODE] = '3' then 'Did not Attend'#(lf)--#(tab)  WHEN C.[ATTENDED_OR_DID_NOT_ATTEND_CODE] = '2' then C.[ATTENDED_OR_DID_NOT_ATTEND_Desc]#(lf)--#(tab)  WHEN C.[ATTENDED_OR_DID_NOT_ATTEND_CODE] = '4' then C.[ATTENDED_OR_DID_NOT_ATTEND_Desc]#(lf)--          WHEN C.[ATTENDED_OR_DID_NOT_ATTEND_CODE] = '7' then C.[ATTENDED_OR_DID_NOT_ATTEND_Desc]#(lf)--#(tab)  WHEN C.[ATTENDED_OR_DID_NOT_ATTEND_CODE] is NULL then 'Dropped_Out_Before_Assessment'#(lf)--#(tab)  END AS 'Attended_or_Not'#(lf)----CASE statement to flag referrals seen only once#(lf)----CARE_CONTACT_COUNT is based upon attended apppointments only as this field from Referrals table#(lf)--,CASE WHEN ContactCounts.TotalContacts IS NULL OR ContactCounts.TotalContacts = 0 THEN 'Referred but not assessed'#(lf)--      WHEN ContactCounts.TotalContacts = 1 THEN 'Seen_Once' ELSE '2_Plus_Contacts' END AS Seen_Status#(lf)--,r.[DeprivationQuintileLabel]#(lf)--,r.Gender_Desc#(lf)--,r.[Age_Band_5_YRS]#(lf)--,r.Locality#(lf)--,r.PrimaryCareNetwork#(lf)--,r.Ethnicity#(lf)#(lf)--From #IAPT_ReferralsTempTable as r#(lf)--left join #IAPT_ContactsTempTable as C ON #(lf)--r.[UNIQUE_SERVICE_REQUEST_IDENTIFIER] = C.[UNIQUE_SERVICE_REQUEST_IDENTIFIER]#(lf)--LEFT JOIN (#(lf)--    SELECT UNIQUE_SERVICE_REQUEST_IDENTIFIER, COUNT(*) AS TotalContacts#(lf)--    FROM #IAPT_ContactsTempTable#(lf)--    GROUP BY UNIQUE_SERVICE_REQUEST_IDENTIFIER#(lf)--) AS ContactCounts #(lf)--    ON r.UNIQUE_SERVICE_REQUEST_IDENTIFIER = ContactCounts.UNIQUE_SERVICE_REQUEST_IDENTIFIER#(lf)--Where r.REFERRAL_REQUEST_RECEIVED_DATE >= '2022-04-01' #(lf)--Order by r.UNIQUE_SERVICE_REQUEST_IDENTIFIER, CARE_CONTACT_DATE#(lf)#(lf)#(lf)#(lf)#(lf)"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

