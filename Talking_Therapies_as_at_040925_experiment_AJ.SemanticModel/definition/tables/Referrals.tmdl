table Referrals
	lineageTag: 244000dd-be49-4800-ac5f-38c3b28e2292

	measure 'Total Referrals' = ```
			CALCULATE(
			DISTINCTCOUNT(Referrals[UNIQUE_SERVICE_REQUEST_IDENTIFIER])
			
			)  
			```
		formatString: 0
		lineageTag: 3ab10392-7855-429e-9027-028930175f02

	measure 'Referred but not Assessed' = CALCULATE(distinctcount(Referrals[UNIQUE_SERVICE_REQUEST_IDENTIFIER]), ISBLANK(Referrals[Care_Contact_Count]) || Referrals[CARE_CONTACT_COUNT] = 0)
		formatString: 0
		lineageTag: bdefc161-4808-4492-872f-be1944e013d0

	measure 'Seen Once' = CALCULATE(distinctcount(Referrals[UNIQUE_SERVICE_REQUEST_IDENTIFIER]), Referrals[CARE_CONTACT_COUNT] = 1)
		formatString: 0
		lineageTag: ad573dbb-659f-40bc-9b84-a28d27f5aac0

	measure '2 Plus Contacts' = CALCULATE(DISTINCTCOUNT(Referrals[UNIQUE_SERVICE_REQUEST_IDENTIFIER]), Referrals[CARE_CONTACT_COUNT] >= 2)
		formatString: 0
		lineageTag: be8e15d8-45fa-4b48-a15b-bdddfbb36542

	measure FunnelCount = ```
			
			SWITCH(
			    SELECTEDVALUE(FunnelStages[Stage]),
			    "Total Referrals", [Total Referrals],
			    "Referred but not Assessed", [Referred but not Assessed],
			    "Seen Once", [Seen Once],
			    "2 Plus Contacts", [2 Plus Contacts]
			)
			
			```
		formatString: 0
		lineageTag: fee8765f-a3de-4c16-8955-b2bd98b96bb4

