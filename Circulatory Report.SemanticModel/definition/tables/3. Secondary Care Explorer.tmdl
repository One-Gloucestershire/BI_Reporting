table '3. Secondary Care Explorer'
	lineageTag: 87f3a580-50a2-425f-9efb-a8a7b59b8255

	measure MonthlyTotal_SCE_Activity =
			SUMX (
			    VALUES ( '3. Secondary Care Explorer'[Year Month] ),
			    CALCULATE ( SUM ( '3. Secondary Care Explorer'[Counter] ),
			    '3. Secondary Care Explorer'[SPC Flag] = 1 )
			)
		displayFolder: SPC
		lineageTag: 22736ca8-6188-4ce6-97ef-cd94d2b24b8e

	measure NumberOfMonths_SCE_Activity = CALCULATE(DISTINCTCOUNT('3. Secondary Care Explorer'[Year Month]),ALLSELECTED('3. Secondary Care Explorer'),'3. Secondary Care Explorer'[SPC Flag]=1)
		displayFolder: SPC
		lineageTag: f2c1b62f-2eb6-4320-a74c-10f4cf9341a4

	measure TotalPerMonth_SCE_Activity =
			
			calculate(SUM('3. Secondary Care Explorer'[Counter]),ALLSELECTED('3. Secondary Care Explorer'),'3. Secondary Care Explorer'[SPC Flag]=1)
		formatString: 0
		displayFolder: SPC
		lineageTag: 04ab4877-d735-4083-ace4-da4a7a7b9f05

	measure Mean_SCE_Activity =
			
			[TotalPerMonth_SCE_Activity]/[NumberOfMonths_SCE_Activity]
		displayFolder: SPC
		lineageTag: 84c49df3-8f75-4ccc-a3b0-699b50a401d8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure StdDev_SCE_Activity = ```
			
			VAR STD_DEV = CALCULATE(STDEVX.P ( VALUES ( '3. Secondary Care Explorer'[Year Month]), [MonthlyTotal_SCE_Activity]), ALLEXCEPT('Date Table', 'Date Table'[year_month]))
			 
			RETURN IFERROR(STD_DEV, 0)
			```
		displayFolder: SPC
		lineageTag: 15973588-e3bb-4909-84d7-ff35a2aa6137

	measure UCL_SCE_Activity = [Mean_SCE_Activity]+(3*[StdDev_SCE_Activity])
		displayFolder: SPC
		lineageTag: 59c05230-c068-4d96-8f94-61fa44f65347

	measure LCL_SCE_Activity = [Mean_SCE_Activity]-(3*[StdDev_SCE_Activity])
		displayFolder: SPC
		lineageTag: daf04cca-cba6-4ee6-b4f4-037e43c0c658

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure NumberOfMonths_SCE_Cost = CALCULATE(DISTINCTCOUNT('3. Secondary Care Explorer'[Year Month]),ALLSELECTED('3. Secondary Care Explorer'),'3. Secondary Care Explorer'[SPC Flag]=1)
		displayFolder: SPC
		lineageTag: 1cd00d77-9947-4109-9b8a-4ce4a81ea74b

	measure MonthlyTotal_SCE_Cost =
			SUMX (
			    VALUES ( '3. Secondary Care Explorer'[Year Month] ),
			    CALCULATE ( SUM ( '3. Secondary Care Explorer'[Total Cost] ),
			    '3. Secondary Care Explorer'[SPC Flag] = 1 )
			)
		displayFolder: SPC
		lineageTag: fcb7b512-ba72-46c0-bba5-7634f7efbf80

	measure TotalPerMonth_SCE_Cost =
			
			calculate(SUM('3. Secondary Care Explorer'[Total Cost]),ALLSELECTED('3. Secondary Care Explorer'),'3. Secondary Care Explorer'[SPC Flag]=1)
		displayFolder: SPC
		lineageTag: 003b7617-db99-4b1c-aa92-0825002b1020

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Mean_SCE_Cost =
			
			[TotalPerMonth_SCE_Cost]/[NumberOfMonths_SCE_Cost]
		displayFolder: SPC
		lineageTag: 74ebce25-5a2f-47e7-b8b5-d2a50a2334e8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure StdDev_SCE_Cost = ```
			
			VAR STD_DEV = CALCULATE(STDEVX.P ( VALUES ( '3. Secondary Care Explorer'[Year Month]), [MonthlyTotal_SCE_Cost]), ALLEXCEPT('Date Table', 'Date Table'[year_month]))
			 
			RETURN IFERROR(STD_DEV, 0)
			```
		displayFolder: SPC
		lineageTag: f63a929b-bfc8-44c5-9f62-60e48f2403f2

	measure LCL_SCE_Cost = [Mean_SCE_Cost]-(3*[StdDev_SCE_Cost])
		displayFolder: SPC
		lineageTag: a8641ed7-51fa-4fb4-b17e-3674a23bfc7a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure UCL_SCE_Cost = [Mean_SCE_Cost]+(3*[StdDev_SCE_Cost])
		displayFolder: SPC
		lineageTag: 4cd0db08-aa25-4409-b64f-23c2e239953b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

