	partition '3. Secondary Care Explorer' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "select 'Inpatients' as ""Data"", nhs_number as ""NHS Number"", uniquecdsidentifier as ""CDS Unique ID"", hospital_provider_spell_number as ""HPSN"", gender as ""Gender"", ""10yr_age_band"" as ""Age Band"", deprivation as ""Deprivation"", ethnic_origin_group as ""Ethnic Origin"", locality as ""Locality"", primary_care_network as ""PCN"", practice_name as ""GP Practice"", provider_group as ""Provider Group"", provider_name as ""Provider Name"", site_name as ""Site Name"", icd10_chapter as ""ICD10 Chapter"", icd10_subchapter as ""ICD10 SubChapter"", icd10_description as ""ICD10 Description"", treatment_function_description as ""TFC"", primaryprocedure_opcs_description as ""Primary Procedure"", hrg_code as ""HRG Code"", admission_method_group_grouped as ""Admission Method Group"", admission_method_group as ""Admission Method Description"", assessment_flag as ""Assessment Flag"", sdec_flag as ""SDEC Flag"", nctr_flag as ""NCTR Flag"", readmission_flag as ""ReAdmission Flag"", los_bands as ""LoS Bands"", los_bands_order as ""LoS Bands - Order"", NULL as ""Department Type"", NULL as ""Arrival Mode"", counter as ""counter"", total_bed_days as ""Total Beddays"", total_tariff_plus_mff as ""Total Cost"", discharge_date as ""Date"", year_month as ""Year Month"", ytd_flag as ""YTD Flag"", latest_month_flag as ""Latest Month Flag"", ""spc flag"" as ""SPC Flag"" from data_mart_powerbi_secondarycare.tbl07_inpatients where (icd10_code ilike 'i%' or icd10_code ilike 'r07%') and (commissioner_code ilike '11m%' or commissioner_code ilike 'qr1%') and year_month >= 202304 union select 'ECDS', nhs_number, cds_unique_identifier, NULL, gender, ""10yr_age_band"", deprivation_decile, ethnic_origin_group, locality, primary_care_network, practice_name, provider_group, provider_name, site_name, ecds_diagnosis_icd10_equivalent_chapter, ecds_diagnosis_icd10_equivalent_subchapter, ecds_diagnosis_icd10_equivalent_description, NULL, NULL, hrg_code, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, department_type, arrival_mode_grouped, counter, NULL, total_tariff_plus_mff, arrival_date, year_month, ytd_flag, latest_month_flag, spc_flag from data_mart_powerbi_urgentcare.tbl01_ecds where (ecds_diagnosis_icd10_equivalent ilike 'i%' or ecds_diagnosis_icd10_equivalent ilike 'r07%' or ecds_diagnosis_group1 ilike '%cardio%') and (code_of_commissioner ilike '11m%' or code_of_commissioner ilike 'qr1%') and year_month >= 202304", null, [EnableFolding=true]),
				    #"Renamed Columns" = Table.RenameColumns(Source,{{"Data", "Data Source"}})
				in
				    #"Renamed Columns"

	changedProperty = Name

