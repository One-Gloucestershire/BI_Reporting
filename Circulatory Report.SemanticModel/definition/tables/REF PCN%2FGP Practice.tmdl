	partition 'REF PCN/GP Practice' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "ccg_reference", [Query="SELECT [Locality]#(lf)      ,[PrimaryCareNetwork]#(lf)      ,[OrganisationCode]#(lf)      ,[OrganisationName]#(lf)      ,[ReportingOrganisationCode]#(lf)      ,[ReportingOrganisationName]#(lf)  FROM [CCG_Reference].[Reference].[vw_GPPractice]#(lf)  where Commissioner like '11m%'#(lf)  and StatusCode = 'active'#(lf)  and PrimaryCareNetwork is not null#(lf)"])
				in
				    Source

	changedProperty = Name

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

