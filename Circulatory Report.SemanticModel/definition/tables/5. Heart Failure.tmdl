			    SUM('5. Heart Failure'[Counter]), 
			    DATESINPERIOD('5. Heart Failure'[LastDateOfMonth], max('5. Heart Failure'[LastDateOfMonth]), -SELECTEDVALUE('YTD Month Adjustment'[YTD Month Adjustment]), MONTH))
