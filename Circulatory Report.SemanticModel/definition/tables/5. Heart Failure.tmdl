table '5. Heart Failure'
	lineageTag: d9132df8-d52c-4c23-9912-3c73e19c3c05

	measure TotalPerMonth = ```
			
			calculate(SUM('5. Heart Failure'[Counter]),ALLSELECTED('5. Heart Failure'),'5. Heart Failure'[SPC Flag]=1)
			
			```
		formatString: 0
		displayFolder: SPC
		lineageTag: df02ba08-72e2-4545-9528-931cf848dda0

	measure UCL = [Mean]+(3*[StdDev])
		displayFolder: SPC
		lineageTag: b87d3290-ead3-4229-8287-b7601b933cc0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure LCL = IF([Mean]-(3*[StdDev])<0,"",[Mean]-(3*[StdDev]))
		displayFolder: SPC
		lineageTag: 11f05d8c-fc85-4c0b-b6eb-fcf678f17164

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure NumberOfMonths = CALCULATE(DISTINCTCOUNT('5. Heart Failure'[YearMonth]),ALLSELECTED('5. Heart Failure'),'5. Heart Failure'[SPC Flag]=1)
		formatString: 0
		displayFolder: SPC
		lineageTag: 81b56ad0-397f-4a83-8637-d74de59f3e99

	measure Mean = [TotalPerMonth]/[NumberOfMonths]
		displayFolder: SPC
		lineageTag: 84b0547e-04c7-4be1-9cf9-efea167f4ca9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure MonthlyTotal =
			SUMX (
			    VALUES ( '5. Heart Failure'[yearmonth] ),
			    CALCULATE ( SUM ( '5. Heart Failure'[Counter] ),
			    '5. Heart Failure'[SPC Flag] = 1 )
			)
		formatString: 0
		displayFolder: SPC
		lineageTag: 6cf85d77-177d-4e49-99bd-f1f8a05e608f

	measure SPLY =
			CALCULATE(SUM(
			    '5. Heart Failure'[Counter]),SAMEPERIODLASTYEAR('Date Table'[date]))
		formatString: 0
		isHidden
		lineageTag: 711b699f-dd2e-41b2-8d8d-e172ed3809cd

		changedProperty = IsHidden

	measure StdDev = ```
			
			VAR STD_DEV = CALCULATE(STDEVX.P ( VALUES ( '5. Heart Failure'[yearmonth]), [MonthlyTotal]), ALLEXCEPT('Date Table', 'Date Table'[year_month]))
			 
			RETURN IFERROR(STD_DEV, 0)
			```
		displayFolder: SPC
		lineageTag: c5f494d9-cf1d-4b45-9561-e03198379672

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure GraphTitle =
			SELECTEDVALUE('5. Heart Failure'[Cohort])&
			if(isfiltered('5. Heart Failure'[Locality]),if(HASONEVALUE('5. Heart Failure'[Locality])," - "&SELECTEDVALUE('5. Heart Failure'[Locality])," - "&[List-Locality]))&
			if(isfiltered('5. Heart Failure'[PCN]),if(HASONEVALUE('5. Heart Failure'[PCN])," - "&SELECTEDVALUE('5. Heart Failure'[PCN])," - "&[List-PCN]))&
			if(isfiltered('5. Heart Failure'[GP Practice Name]),if(HASONEVALUE('5. Heart Failure'[GP Practice Name])," - "&SELECTEDVALUE('5. Heart Failure'[GP Practice Name])," - "&[List-GPName]))
		displayFolder: Dynamic Selections
		lineageTag: 5f466f7b-91a4-4091-baf3-26f6277bb317

	measure List-Locality =
			
			VAR __DISTINCT_VALUES_COUNT = DISTINCTCOUNT('5. Heart Failure'[Locality])
			VAR __MAX_VALUES_TO_SHOW = 3
			RETURN
				IF(
					__DISTINCT_VALUES_COUNT > __MAX_VALUES_TO_SHOW,
					CONCATENATE(
						CONCATENATEX(
							TOPN(
								__MAX_VALUES_TO_SHOW,
								VALUES('5. Heart Failure'[Locality]),
								'5. Heart Failure'[Locality],
								ASC
							),
							'5. Heart Failure'[Locality],
							", ",
							'5. Heart Failure'[Locality],
							ASC
						),
						", etc."
					),
					CONCATENATEX(
						VALUES('5. Heart Failure'[Locality]),
						'5. Heart Failure'[Locality],
						", ",
						'5. Heart Failure'[Locality],
						ASC
					)
				)
		displayFolder: Dynamic Selections
		lineageTag: 4d2e346c-3e13-4f46-8501-dea665755beb

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "ConcatenateValues"
				}

		changedProperty = FormatString

