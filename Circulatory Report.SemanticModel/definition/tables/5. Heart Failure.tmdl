		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "PowerBI_Processing", [Query="select a.*, b.yearmonth#(lf)from [PowerBI_Processing].[dbo].[Heart_Failure] [A]#(lf)left join ccg_reference.reference.vw_DateLookup [b] on a.[date] = b.[date]"]),
