	measure 'Dynamic YTD Calculation Start Month' = ```
			
			SWITCH([MinMonthNumber],
			1,"Apr",
			2,"May",
			3,"Jun",
			4,"Jul",
			5,"Aug",
			6,"Sep",
			7,"Oct",
			8,"Nov",
			9,"Dec",
			10,"Jan",
			11,"Feb",
			12,"Mar")
			
			```
		lineageTag: 6174584b-9eac-48a8-83fb-79400be574cf

	measure MinMonthNumber =
			calculate(max('5. Heart Failure'[Financial Month]),
			'5. Heart Failure'[Financial Year] = max('5. Heart Failure'[Financial Year]))-
			('YTD Month Adjustment'[YTD Month Adjustment Value]-1)
		formatString: 0
		lineageTag: a3c87806-59ca-4405-81f8-71e9c21a3e63

	measure 'Dynamic YTD Calculation End Month' =
			
