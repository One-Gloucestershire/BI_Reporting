	partition Deliveries = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Current", [Query="SELECT distinct Del.[UniqPregID]#(lf),Del.[MotherNHSNo]  #(lf)#(lf)--demographics --------------------------------------------------------------------------#(lf),Del.[CCGFromFile]    #(lf) #(lf) ,Del.[CountyMother]  #(lf),C.[County_Name]#(lf)#(lf), case when Del.[CountyMother] = 'E10000013' then 'Gloucestershire'#(lf)when Del.[CountyMother] IS NULL then 'Unknown'#(lf)else 'Out of County'#(lf)END as [County_Mother_group]#(lf)#(lf) #(lf),Del.[LSOAMother2011] #(lf),LSOA.[LSOA_Name]#(lf)#(lf),Del.[LAD_UAMother]   --LOCAL AUTHORITY DISTRICT/UNITARY AUTHORITY#(lf),Del.[ElectoralWardMother]#(lf)#(lf), M.[LocalityName] as [Locality_current]#(lf),M.[NetworkName] as  [PCN_current]#(lf)#(tab)  #(lf),[AgeAtLabourMother]    as [Age_At_Labour_Mother]#(lf),case when [AgeAtLabourMother] < '16' then '<16'#(lf)when [AgeAtLabourMother] between '16' and '19' then '16-19'#(lf)when [AgeAtLabourMother] between '20' and '24' then '20-24'#(lf)when [AgeAtLabourMother] between '25' and '29' then '25-29'#(lf)when [AgeAtLabourMother] between '30' and '34' then '30-34'#(lf)when [AgeAtLabourMother] between '35' and '39' then '35-39'#(lf)when [AgeAtLabourMother] between '40' and '44' then '40-44'#(lf)when [AgeAtLabourMother]between '45' and '49' then '45-49'#(lf)when [AgeAtLabourMother] between '50' and '54' then '50-54'#(lf)when [AgeAtLabourMother] > '54' then '55+'#(lf)END as [Age_at_Labour_AgeBand5yr]#(lf)#(lf),Del.[EthnicCategoryMother]  as [Ethnic_Category_Code]#(lf),Del.[EthnicCategoryMotherDescription] as [Ethnic_Category_Desc] #(lf),Del.[Rank_IMD_Decile_2015]     as [IMD_Decile]#(lf)#(lf) #(lf)  --Admissions ------------------------------------------------------------------------------------------#(lf)  ,[SourceAdmCodeHospProvSpell]      #(lf)      ,[SourceAdmCodeHospProvSpellDescription]    #(lf)      ,[PatientClassCode]    #(lf)      ,[PatientClassCodeDescription] as [Admission_Type]         --   (type of admission - ordinary / etc)#(lf)      ,[AdmMethCodeHospProvSpell]           #(lf)      ,[AdmMethCodeHospProvSpellDescription]   #(lf)    #(lf)      ,[OrgSiteIDOfTreat]       #(lf)      ,[OrgSiteIDOfTreatDescription] #(lf)      ,[MSD301_ID]       #(lf)      ,Del.[RecordNumber]       #(lf)      ,Del.[UniqSubmissionID]                  #(lf)      ,Del.[OrgCodeProvider]  as [Org_Provider_Code]#(lf)      ,Del.[OrgCodeProviderDescription] as [Org_Provider_Desc]#(lf)      ,Del.[MSDS_ID_Mother]        #(lf)      ,[PregnancyID]           #(lf)      ,[OrgSiteIDIntra]        as [Org_Site_Intra_Code]#(lf)      ,[OrgSiteIDIntraDescription]   as [Org_Site_Intra_Desc]  #(lf)      ,[SettingIntraCare]     as [Setting_Type_Intra_Code]#(lf)      ,[SettingIntraCareDescription]      as [Setting_Type_Intra_Desc]#(lf)      ,[ReasonChangeDelSettingLab]      as [Reason_Change_Del_Setting_Code]#(lf)      ,[ReasonChangeDelSettingLabDescription]      as [Reason_Change_Del_Setting_Desc]      #(lf)      ,[LabourOnsetMethod] as [Labour_Onset_Method_Code]#(lf)      ,[LabourOnsetMethodDescription]      as [Labour_Onset_Method_Desc]#(lf)#(lf)#(tab)    ,Del.[Period]#(lf)#(tab)#(lf),[AdmMethCodeMothDelHospProvSpell]     as [Admission_Method_Hospital_Provider_Spell_Code]     #(lf)      ,[AdmMethCodeMothDelHospProvSpellDescription] [Admission_Method_Hospital_Provider_Spell_Desc]  #(lf)#(lf) ,[StartDateMotherDeliveryHospProvSpell]     as [Start_Date_Delivery_Provider_Spell]  --start date when admitted for either labour / caesar#(lf),[StartTimeMotherDeliveryHospProvSpell]     as [Start_Time_Delivery_Provider_Spell]     --start time when admitted for either labour / caesar#(lf)#(lf)    #(lf) --------------------------------------------------------------- #(lf)  -- to get various Fin Year and YearMonths#(lf) #(lf),[Start_Date_Delivery_Provider_Spell_YearMonth] = STUFF(DS.[Year_Month], 5,0,'/')  -- start date when admitted for either labour / caesar   --new reference table formatted for forward slash#(lf),[Start_Date_Delivery_Provider_Spell_FinYr] = REPLACE(DS.[Fin_Year_YYYY_dash_YY], ' - ', '/')  -- new reference table formatted as 2022/23 not with hyphen in#(lf)#(lf) ,[LabourOnsetDate]      as [Labour_Onset_Date]         -- incl caesareans     -- date labour confirmed as having started  #(lf)      ,[LabourOnsetTime]     as [Labour_Onset_Time]     -- incl caesareans      -- time labour confirmed as having started            #(lf)#(lf),[Labour_Onset_Date_YearMonth]  = STUFF(D.[Year_Month], 5,0,'/')  -- new reference table formatted for forward slash#(lf),[Labour_Onset_FinYr] = REPLACE(D.[Fin_Year_YYYY_dash_YY], ' - ', '/') -- new reference table formatted as 2022/23 not with hyphen in#(lf)#(tab)#(lf)#(tab),[CaesareanDate]    as [Casesarean_Date]                            --    All Caesarians only (even if spontaneous birth started intially)#(lf)   ,[CaesareanTime]     as [Caesarean_Time]                             --   All Caesarians only#(lf)  #(lf)  ,[Caesarian_Date_YearMonth] = STUFF(Dt.[Year_Month], 5,0,'/') -- new reference table formatted for forward slash#(lf)  ,[Caesarian_Date_FinYr] = REPLACE(Dt.[Fin_Year_YYYY_dash_YY], ' - ', '/') -- new reference table formatted as 2022/23 not with hyphen in#(lf)     #(lf) ,[Year_Month_Lab_Caesar_start] = STUFF(Del.[Period], 5,0,'/')                   -- use this for YearMonth (start of all types of labour/caesarean)#(lf) ,[Fin_yr_Lab_Caesar_start] = REPLACE(Dp.[Fin_Year_YYYY_dash_YY], ' - ', '/')   -- use this for Fin_yr (start of all types of labour/caesarean)#(lf)#(lf)#(lf) --------------------------------------------------------#(lf)--Delivery -----------------------------------------------------------------#(tab)#(lf)#(tab),[DecisionToDeliverDate]    as [Decision_to_Deliver_Date]   -- seems to be if nothing happens, after labour starts, they decide to intervene (induce) but some of these spontaneous too/ #(lf)#(tab),[DecisionToDeliverTime]    as [Decision_to_Deliver_Time]   #(lf) #(lf) #(tab),Del.[LabourDeliveryID]  as [Labour_Delivery_ID]        #(lf)      ,[OrgCodePPLC]    --????y#(lf)      ,[OrgCodePPLCDescription]        #(lf)#(lf)#(lf) ----- To exclude deliveries which are appearing as [BirthsPerLabandDel] = 0, and are not in Births table (the few who are in Births are not excluded#(lf)      ,[BirthsPerLabandDel] as [No_Births_per_Delivery_DQ issues]    -- some appear as 0 and are not in Births table  DONT USE THIS COLUMN#(lf)#(lf)#(tab)#(lf)#(tab), case when (Del.[BirthsPerLabandDel] = '0' and B.[PregOutcome] is NOT NULL) then '1'#(lf)#(tab)  else Del.[BirthsPerLabandDel]#(lf)#(tab)  END As  [No_Births_per_Delivery_fix]#(lf)#(tab)  #(tab)   #(lf) --------#(lf)#(lf)      ,[RobsonGroup]   as [Robson_Group]#(lf)#(lf)#(tab)  #(lf) --Discharges----------------------------------------------------------------------------#(lf)     ,[DischDateHospProvSpell]   #(lf)      ,[DischTimeHospProvSpell]      #(lf)      ,[DischMethCodeHospProvSpell]     #(lf)      ,[DischMethCodeHospProvSpellDescription]      #(lf)      ,[DischDestCodeHospProvSpell]     #(lf)      ,[DischDestCodeHospProvSpellDescription]   #(lf)   ,[DischargeDateMotherHosp]     as [Discharge_Date_Mother_Hospital] #(lf)      ,[DischargeTimeMotherHosp]  as [Discharge_Time_Mother_Hospital]    #(lf)      ,[DischMethCodeMothPostDelHospProvSpell]     as [Discharge_Method_Mother_Post_Delivery_Code]#(lf)      ,[DischMethCodeMothPostDelHospProvSpellDescription] as [Discharge_Method_Mother_Post_Delivery_Desc]      #(lf)      ,[DischDestCodeMothPostDelHospProvSpell] as [Discharge_Destination_Code]               #(lf)      ,[DischDestCodeMothPostDelHospProvSpellDescription] as [Discharge_Destination_Desc] #(lf)  #(lf)  --Deaths-----------------------------------------------------------------------------------#(lf)  ,Del.[PersonDeathDateMother]  #(lf)      ,Del.[PersonDeathTimeMother]       #(lf)      ,Del.[AgeAtDeathMother] as [Age_at_Death_Mother]#(lf)      ,Del.[YearOfDeathMother]  #(lf)      ,Del.[MonthOfDeathMother]   #(lf)      ,Del.[DayOfWeekOfDeathMother] #(lf)      ,Del.[MeridianOfDeathMother]    #(lf) #(lf) -- Postnatal-------------------------------------------------------------------------#(lf) ,[OrgIDPostnatalPathLeadProvider]  as [Org_Postnatal_Lead_Provider_Code]#(lf)      ,[OrgIDPostnatalPathLeadProviderDescription] as [Org_Postnatal_Lead_Provider_Desc]          #(lf)     ,[LeadPostProvider]                --??#(lf)      ,[LeadPostProviderDescription]      --???  #(lf)      ,[PostPathLevel]    #(lf)      ,[PostPathLevelDescription] #(lf)#(tab)#(tab) #(lf)      ,Del.[RPStartDate]                          -- 1st day of Month of RP  (???Reporting Period)#(lf)      ,Del.[RPEndDate]                           -- 1st day of Month of RP (???Reporting Period)#(lf)      , [counter] = 1#(lf)#(tab) #(lf)#(tab) ,Del.[ProcessedDate]  as [Processed_Date]#(lf)#(tab) ,[Data_Updated] = GETDATE() #(lf)  FROM [CCG_Current].[MSDS].[vw_102_Delivery] as Del#(lf)  LEFT JOIN [DSCRO_NATIONAL_LOOKUPS].[dbo].[ref_Dates] as D#(lf)  on Del.[LabourOnsetDate] = D.[Full_Date]#(lf)#(lf)  LEFT JOIN [DSCRO_NATIONAL_LOOKUPS].[dbo].[ref_Dates] as Dt#(lf)  on Del.[CaesareanDate] = Dt.[Full_Date]#(lf)#(lf)    LEFT JOIN [DSCRO_NATIONAL_LOOKUPS].[dbo].[ref_Dates] as Dp#(lf)  on Del.[Period] = Dp.[YearMonth_YYYYMM]#(lf)#(lf)    LEFT JOIN [DSCRO_NATIONAL_LOOKUPS].[dbo].[ref_Dates] as DS#(lf)  on Del.[StartDateMotherDeliveryHospProvSpell] = DS.[Full_Date]#(lf)#(lf)     LEFT JOIN [BIReports].[MPI].[MPI_Current] AS M                                  #(lf)  ON Del.[MotherNHSNo] = M.Derived_Pseudo_NHS#(lf)  #(lf)LEFT JOIN  [DSCRO_NATIONAL_LOOKUPS].[ODS].[Counties_England_SCD] AS C#(lf)ON Del.[CountyMother] COLLATE SQL_Latin1_General_CP1_CS_AS = C.[County_Code2]  #(lf)#(lf)left join [DSCRO_NATIONAL_LOOKUPS].[ODS].[LSOA_2001_Names_And_Codes_England_Wales_NI_SCD] as LSOA#(lf)on Del.[LSOAMother2011] COLLATE SQL_Latin1_General_CP1_CS_AS = LSOA.[LSOA_Code]#(lf)#(lf)left join [CCG_Current].[MSDS].[vw_103_Birth] AS B#(lf)on Del.[UniqPregID] = B.[UniqPregID]#(lf)#(lf)where Del.[Period] > '201903'   #(lf)and (Del.[BirthsPerLabandDel] <> '0' OR Del.[BirthsPerLabandDel] = '0' and B.[PregOutcome] is not NULL)   --to exclude deliveries not in births table#(lf)"])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

