model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Demographics","Practice","Geography","Map Layer","LSOAMap","Risk","Appointments","Prescribing","PracticeKPI","EDAttendances","Ambulance","NELAdmissions","WaitingList","Diagnostics","OPAppointments","Targets","CVDPrevent","Immunisations","EndOfLife","Contract","Cohorts","Reach %","Avertable %","Projection","Interventions","Access Lens","Condition Lens","Inequality Lens","Mortality Lens","Risk Lens","Spend Lens","Target Lens","UEC Lens","Waiting Lens","AE","Mortality","RTT","PrescribingTrend","ESP","AgeingWell","CareHomes","CHC","IAPT","LDandA","Maternity","MentalHealth","WeightMgmt","WeightMgmtTrend","Narrative","LTCTrend","Date","ActionTracker","Claimants","Schools","Amb999IMD","Amb999Trend","Crime","CrimeIMD","Housing","Education",]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

