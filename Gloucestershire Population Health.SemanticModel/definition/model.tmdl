model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Demographics","Practice","Geography","Date"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table Demographics
ref table Practice
ref table Geography
ref table Date

ref cultureInfo en-GB
