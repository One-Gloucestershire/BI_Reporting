model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Demographics","Practice","Geography","Map Layer","LSOAMap","Risk","Appointments","Prescribing","PracticeKPI","EDAttendances","Ambulance","NELAdmissions","WaitingList","Diagnostics","OPAppointments","Targets","CVDPrevent","Immunisations","EndOfLife","Contract","Cohorts","Reach %","Avertable %","Projection","Interventions","AgeingWell","CareHomes","CHC","IAPT","LDandA","Maternity","MentalHealth","WeightMgmt","WeightMgmtTrend","Narrative","LTCTrend","Date"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table Demographics
ref table Practice
ref table Geography
ref table 'Map Layer'
ref table LSOAMap
ref table Risk
ref table Appointments
ref table Prescribing
ref table PracticeKPI
ref table EDAttendances
ref table Ambulance
ref table NELAdmissions
ref table WaitingList
ref table Diagnostics
ref table OPAppointments
ref table Targets
ref table CVDPrevent
ref table Immunisations
ref table EndOfLife
ref table Contract
ref table Cohorts
ref table 'Reach %'
ref table 'Avertable %'
ref table Projection
ref table Interventions
ref table AgeingWell
ref table CareHomes
ref table CHC
ref table IAPT
ref table LDandA
ref table Maternity
ref table MentalHealth
ref table WeightMgmt
ref table WeightMgmtTrend
ref table Narrative
ref table LTCTrend
ref table Date

ref cultureInfo en-GB

