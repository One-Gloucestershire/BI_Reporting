model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Demographics","Practice","Geography","LSOAMap","Risk","Appointments","Prescribing","PracticeKPI","LTCTrend","Date"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table Demographics
ref table Practice
ref table Geography
ref table LSOAMap
ref table Risk
ref table Appointments
ref table Prescribing
ref table PracticeKPI
ref table LTCTrend
ref table Date

ref cultureInfo en-GB

