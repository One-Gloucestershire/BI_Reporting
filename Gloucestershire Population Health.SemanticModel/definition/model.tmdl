model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Demographics", "Practice", "Geography", "Map Layer", "LSOAMap", "Risk", "Appointments", "Prescribing", "PracticeKPI", "EDAttendances", "Ambulance", "NELAdmissions", "WaitingList", "Diagnostics", "OPAppointments", "Targets", "CVDPrevent", "Immunisations", "EndOfLife", "Contract", "Cohorts", "Reach %", "Avertable %", "Projection", "Narrative", "LTCTrend", "Date", "Inequality Lens", "Condition Lens", "Risk Lens", "Access Lens", "UEC Lens", "Waiting Lens", "Target Lens", "Mortality Lens", "Spend Lens"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table Demographics
ref table Practice
ref table Geography
ref table 'Map Layer'
ref table LSOAMap
ref table Risk
ref table Appointments
ref table Prescribing
ref table PracticeKPI
ref table EDAttendances
ref table Ambulance
ref table NELAdmissions
ref table WaitingList
ref table Diagnostics
ref table OPAppointments
ref table Targets
ref table CVDPrevent
ref table Immunisations
ref table EndOfLife
ref table Contract
ref table Cohorts
ref table 'Reach %'
ref table 'Avertable %'
ref table Projection
ref table Narrative
ref table LTCTrend
ref table Date

ref table 'Inequality Lens'
ref table 'Condition Lens'
ref table 'Risk Lens'
ref table 'Access Lens'
ref table 'UEC Lens'
ref table 'Waiting Lens'
ref table 'Target Lens'
ref table 'Mortality Lens'
ref table 'Spend Lens'

ref cultureInfo en-GB

