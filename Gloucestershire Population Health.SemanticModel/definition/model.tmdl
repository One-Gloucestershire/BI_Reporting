model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Demographics","Practice","Geography","LSOAMap","Risk","LTCTrend","AE","RTT","Mortality","Prescribing","Date"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table Demographics
ref table Practice
ref table Geography
ref table LSOAMap
ref table Risk
ref table LTCTrend
ref table AE
ref table RTT
ref table Mortality
ref table Prescribing
ref table Date

ref cultureInfo en-GB

