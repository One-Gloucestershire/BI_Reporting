table Narrative
	lineageTag: 1f9c0a00-0000-4b00-9c00-13208828452412

	measure 'Exec Headline' = "Gloucestershire serves " & FORMAT ( [Population], "#,0" ) & " residents across " & FORMAT ( [GP Practices], "0" ) & " practices and " & FORMAT ( [PCNs], "0" ) & " PCNs — and the need is not yet met equally."
		lineageTag: 1f9c0a00-0000-4b00-9c00-235683883033389

	measure 'Deprivation Insight' = "The most deprived neighbourhoods are " & FORMAT ( [Deprivation Gap (x)], "0.0" ) & "× more likely to live with 2+ long-term conditions than the least deprived."
		lineageTag: 1f9c0a00-0000-4b00-9c00-16450759660144

	measure 'Risk Insight' = FORMAT ( [High Risk (CMS Q5)], "#,0" ) & " patients (" & FORMAT ( DIVIDE ( [High Risk (CMS Q5)], [Patients] ), "0%" ) & ") sit in the top risk quintile — a small group driving most admissions and cost. Target them first."
		lineageTag: 1f9c0a00-0000-4b00-9c00-166881290708949

	measure 'Frailty Insight' = FORMAT ( [% Frail (eFI mod/severe)], "0.0%" ) & " live with moderate-to-severe frailty; " & FORMAT ( [Anticoag Gap], "#,0" ) & " with AF are eligible but untreated — an actionable gap."
		lineageTag: 1f9c0a00-0000-4b00-9c00-191446511330092

	measure 'Targets Insight' = "Gloucestershire meets " & FORMAT ( [Indicators Met], "0" ) & " of " & FORMAT ( [Indicators Total], "0" ) & " national screening & cancer targets — closing the rest is a clear commissioning goal."
		lineageTag: 1f9c0a00-0000-4b00-9c00-250951739437225

	measure 'Mortality Insight' = "Only " & FORMAT ( [Preferred Place Rate], "0%" ) & " die in their preferred place; just " & FORMAT ( [Palliative Care %], "0%" ) & " are on a palliative register at death."
		lineageTag: 1f9c0a00-0000-4b00-9c00-252751880014037

	measure 'Priority Insight' = "In the most deprived neighbourhoods, " & FORMAT ( CALCULATE ( [High-risk (LSOA)], Geography[imd_decile] <= 2 ), "#,0" ) & " people are already high-risk — concentrated, named and reachable. Start here."
		lineageTag: 1f9c0a00-0000-4b00-9c00-261689103073613

	measure 'Cohorts Insight' = "Older people are the largest cohort (" & FORMAT ( CALCULATE ( [Cohort Size], Cohorts[cohort] = "Older people (65+)" ), "#,0" ) & "), but the SMI and learning-disability cohorts skew most deprived — the steepest inequality sits in the smallest groups."
		lineageTag: 1f9c0a00-0000-4b00-9c00-100542448505829

	measure 'Opportunity Insight' = "MODELLED: reaching " & FORMAT ( [Reach % Value], "0" ) & "% of high-risk patients in the most deprived neighbourhoods and averting " & FORMAT ( [Avertable % Value], "0" ) & "% of their activity could free up about £" & FORMAT ( [Avertable Spend (deprived)] / 1000000, "0.0" ) & "m a year. Inaction compounds: the high-risk population is projected to grow ~3.5% a year."
		lineageTag: 1f9c0a00-0000-4b00-9c00-35506848794978

	column Key
		isHidden
		dataType: int64
		lineageTag: 1f9c0a00-0000-4b00-9c00-157977613212290
		summarizeBy: none
		sourceColumn: [Key]

		annotation SummarizationSetBy = Automatic

	partition Narrative = calculated
		mode: import
		source = ROW ( "Key", 1 )

	annotation PBI_ResultType = Table
