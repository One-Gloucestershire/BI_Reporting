table Narrative
	lineageTag: 1f9c0a00-0000-4b00-9c00-13208828452412

	measure 'Exec Headline' = "Gloucestershire serves " & FORMAT ( [Population], "#,0" ) & " residents across " & FORMAT ( [GP Practices], "0" ) & " practices and " & FORMAT ( [PCNs], "0" ) & " PCNs — and the need is not yet met equally."
		lineageTag: 1f9c0a00-0000-4b00-9c00-235683883033389

	measure 'Deprivation Insight' = "The most deprived fifth carry Gloucestershire's highest PHM risk and frailty burden."
		lineageTag: 1f9c0a00-0000-4b00-9c00-16450759660144

	measure 'Risk Insight' = FORMAT ( [High Risk (CMS Q5)], "#,0" ) & " patients are in the top risk quintile — target them first."
		lineageTag: 1f9c0a00-0000-4b00-9c00-166881290708949

	measure 'Frailty Insight' = FORMAT ( [Anticoag Gap], "#,0" ) & " people with AF are eligible for anticoagulation but untreated — an actionable gap."
		lineageTag: 1f9c0a00-0000-4b00-9c00-191446511330092

	measure 'Targets Insight' = "Gloucestershire meets " & FORMAT ( [Indicators Met], "0" ) & " of " & FORMAT ( [Indicators Total], "0" ) & " national screening & cancer targets."
		lineageTag: 1f9c0a00-0000-4b00-9c00-250951739437225

	measure 'Mortality Insight' = "Only " & FORMAT ( [Preferred Place Rate], "0%" ) & " die in their preferred place; just " & FORMAT ( [Palliative Care %], "0%" ) & " are on a palliative register at death."
		lineageTag: 1f9c0a00-0000-4b00-9c00-252751880014037

	measure 'Priority Insight' = FORMAT ( CALCULATE ( [High-risk (LSOA)], Geography[imd_decile] <= 2 ), "#,0" ) & " high-risk people live in the most deprived neighbourhoods — start here."
		lineageTag: 1f9c0a00-0000-4b00-9c00-261689103073613

	measure 'Cohorts Insight' = "SMI and learning-disability cohorts skew most deprived — inequality hides in the smallest groups."
		lineageTag: 1f9c0a00-0000-4b00-9c00-100542448505829

	measure 'Opportunity Insight' = "MODELLED: reaching " & FORMAT ( [Reach % Value], "0" ) & "% of high-risk patients in deprived areas could free up ~£" & FORMAT ( [Avertable Spend (deprived)] / 1000000, "0.0" ) & "m a year (illustrative)."
		lineageTag: 1f9c0a00-0000-4b00-9c00-35506848794978

	measure 'Equity Insight' = "Inverse care law: the most deprived practices often have the fewest GPs per head relative to need."
		lineageTag: 1f9c0a00-0000-4b00-9c00-177748399837717

	measure 'Brief Action 1' = "1. Proactively case-manage the " & FORMAT ( CALCULATE ( [High-risk (LSOA)], Geography[imd_decile] <= 2 ), "#,0" ) & " high-risk patients in the most deprived neighbourhoods (owner: PHM team + PCNs; ~12 months)."
		lineageTag: 1f9c0a00-0000-4b00-9c00-172514203253456

	measure 'Brief Action 2' = "2. Close clinical gaps in deprived practices: " & FORMAT ( [Anticoag Gap], "#,0" ) & " untreated AF patients and " & FORMAT ( [Indicators Total] - [Indicators Met], "0" ) & " missed national targets (owner: Primary Care; 6-12 months)."
		lineageTag: 1f9c0a00-0000-4b00-9c00-6261205829588

	measure 'Brief Action 3' = "3. Rebalance GP provision toward the highest-need practices to break the inverse care law (owner: Commissioning; 12-24 months)."
		lineageTag: 1f9c0a00-0000-4b00-9c00-226996358815808

	measure 'Risk of Inaction' = "Risk of inaction: the high-risk population is projected to grow ~3.5% a year. Doing nothing adds avoidable demand and cost, and widens the inequality gap — a modelled £" & FORMAT ( [Avertable Spend (deprived)] / 1000000, "0.0" ) & "m/yr opportunity goes unrealised."
		lineageTag: 1f9c0a00-0000-4b00-9c00-38885064255295

