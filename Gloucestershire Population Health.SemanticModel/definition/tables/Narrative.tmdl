table Narrative
	lineageTag: 1f9c0a00-0000-4b00-9c00-13208828452412

	measure 'Exec Headline' = "Gloucestershire serves " & FORMAT ( [Population], "#,0" ) & " residents across " & FORMAT ( [GP Practices], "0" ) & " GP practices and " & FORMAT ( [PCNs], "0" ) & " primary care networks. This is where the need is greatest — and where it is not yet being met equally."
		lineageTag: 1f9c0a00-0000-4b00-9c00-235683883033389

	measure 'Deprivation Insight' = "People in the most deprived neighbourhoods are " & FORMAT ( [Deprivation Gap (x)], "0.0" ) & "× more likely to live with two or more long-term conditions than those in the least deprived — inequality compounds with every decile."
		lineageTag: 1f9c0a00-0000-4b00-9c00-16450759660144

	measure 'Risk Insight' = FORMAT ( [High Risk (CMS Q5)], "#,0" ) & " patients sit in the top risk quintile (" & FORMAT ( DIVIDE ( [High Risk (CMS Q5)], [Patients] ), "0%" ) & " of those scored) — a small group that drives a large share of admissions and cost. Target them first."
		lineageTag: 1f9c0a00-0000-4b00-9c00-166881290708949

	measure 'Frailty Insight' = FORMAT ( [% Frail (eFI mod/severe)], "0.0%" ) & " of registered patients live with moderate-to-severe frailty, and " & FORMAT ( [Anticoag Gap], "#,0" ) & " people with atrial fibrillation are untreated despite being eligible — a clear, actionable gap."
		lineageTag: 1f9c0a00-0000-4b00-9c00-191446511330092

	measure 'Targets Insight' = "Against national mandate, Gloucestershire meets " & FORMAT ( [Indicators Met], "0" ) & " of " & FORMAT ( [Indicators Total], "0" ) & " screening & cancer targets. Closing the rest is a measurable, time-bound commissioning goal."
		lineageTag: 1f9c0a00-0000-4b00-9c00-250951739437225

	measure 'Mortality Insight' = "Only " & FORMAT ( [Preferred Place Rate], "0%" ) & " of people with a recorded preference die in their preferred place, and just " & FORMAT ( [Palliative Care %], "0%" ) & " are on a palliative register at death — the end-of-life experience is unequal too."
		lineageTag: 1f9c0a00-0000-4b00-9c00-252751880014037

	column Key
		isHidden
		dataType: int64
		lineageTag: 1f9c0a00-0000-4b00-9c00-157977613212290
		summarizeBy: none
		sourceColumn: [Key]

		annotation SummarizationSetBy = Automatic

	partition Narrative = calculated
		mode: import
		source = ROW ( "Key", 1 )

	annotation PBI_ResultType = Table
