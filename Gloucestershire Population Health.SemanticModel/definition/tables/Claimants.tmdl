		lineageTag: 1f9c0a00-0000-4b00-9c00-9000757387333
		summarizeBy: sum
		sourceColumn: total_population

		annotation SummarizationSetBy = Automatic

	partition Claimants = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "select lad19nm, period_yyyymm, (period_yyyymm || '-01')::date as period_date, claimants, claimant_rate_pct, total_population from db03_pid.data_mart_l050_phm_rpt.lad_claimants where is_glos = true and lad19nm <> 'Gloucestershire'", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table
