table Claimants
	lineageTag: 1f9c0a00-0000-4b00-9c00-9000000000401

	measure 'Total Claimants' = ```
			VAR lp = CALCULATE ( MAX ( Claimants[period_date] ), ALL ( Claimants ) )
			RETURN CALCULATE ( SUM ( Claimants[claimants] ), Claimants[period_date] = lp )
			```
		formatString: #,0
		lineageTag: 1f9c0a00-0000-4b00-9c00-9000000000402

	measure 'Claimant Rate %' = ```
			VAR lp = CALCULATE ( MAX ( Claimants[period_date] ), ALL ( Claimants ) )
			RETURN CALCULATE ( DIVIDE ( SUM ( Claimants[claimants] ), SUM ( Claimants[total_population] ) ), Claimants[period_date] = lp )
			```
		formatString: 0.0%
		lineageTag: 1f9c0a00-0000-4b00-9c00-9000000000403

	measure 'Claimant Rate (by period)' = DIVIDE ( SUM ( Claimants[claimants] ), SUM ( Claimants[total_population] ) )
		formatString: 0.0%
		lineageTag: 1f9c0a00-0000-4b00-9c00-9000000000404

