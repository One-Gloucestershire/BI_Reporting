	partition Risk = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db03_pid_reporting"), "select r.patient_id,#(lf)    r.multimorbidity_count,#(lf)    case when r.multimorbidity_count >= 4 then '4+' else r.multimorbidity_count::varchar end as mm_group,#(lf)    least(r.multimorbidity_count, 4) as mm_group_sort,#(lf)    r.cms_mortality_score, r.cms_admissions_score, r.cms_consultations_score,#(lf)    ntile(5) over (order by r.cms_mortality_score) as cms_quintile,#(lf)    'Q' || ntile(5) over (order by r.cms_mortality_score)::varchar as cms_band,#(lf)    r.efi_score, r.efi_deficit_count,#(lf)    case when r.efi_score < 0.12 then '1 Fit' when r.efi_score < 0.24 then '2 Mild'#(lf)         when r.efi_score < 0.36 then '3 Moderate' else '4 Severe' end as efi_band,#(lf)    r.charlson_cci_score, r.charlson_cci_age_adjusted,#(lf)    case when r.charlson_cci_score = 0 then '0' when r.charlson_cci_score <= 2 then '1-2'#(lf)         when r.charlson_cci_score <= 4 then '3-4' else '5+' end as charlson_band,#(lf)    r.cvd_risk_proxy_score, r.cha2ds2_vasc_score, r.anticoag_candidate, r.bleed_risk_concern,#(lf)    a.rub, a.risk_pct, a.risk_level, a.patient_need_group, a.is_frailty,#(lf)    p.practice_code, p.pcn_code,#(lf)    coalesce(la.imd_decile, 0) as practice_imd_decile,#(lf)    f.has_diabetes, f.has_copd, f.has_chd, f.has_ckd, f.has_dementia, f.has_smi,#(lf)    f.has_cancer, f.has_asthma, f.has_depression, f.has_palliative#(lf)from data_mart_l050_phm_rpt.patient_risk_scores r#(lf)left join data_mart_l050_phm_rpt.acg_snapshot a on a.patient_id = r.patient_id#(lf)left join data_mart_l050_phm_rpt.patient_practice p on p.patient_id = r.patient_id#(lf)left join data_mart_l050_phm_rpt.patient_cohort_flags f on f.patient_id = r.patient_id#(lf)left join data_mart_l050_phm_rpt.practice_locations pl on pl.practice_code = p.practice_code#(lf)left join data_mart_l050_phm_rpt.lsoa_aggregates la on la.lsoa11cd = pl.lsoa11cd", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table

