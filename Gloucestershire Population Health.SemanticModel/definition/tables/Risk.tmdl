table Risk
	lineageTag: 1f9c0a00-0000-4b00-9c00-98726416199912

	measure Patients = COUNTROWS ( Risk )
		formatString: #,0
		lineageTag: 1f9c0a00-0000-4b00-9c00-171670012869591

	measure 'Avg CMS (mortality)' = AVERAGE ( Risk[cms_mortality_score] )
		formatString: 0.00
		lineageTag: 1f9c0a00-0000-4b00-9c00-191545727922940

	measure 'Avg eFI' = AVERAGE ( Risk[efi_score] )
		formatString: 0.000
		lineageTag: 1f9c0a00-0000-4b00-9c00-111134178443748

	measure 'Avg Charlson' = AVERAGE ( Risk[charlson_cci_score] )
		formatString: 0.00
		lineageTag: 1f9c0a00-0000-4b00-9c00-72615514476435

	measure 'Avg ACG Risk %' = AVERAGE ( Risk[risk_pct] )
		formatString: 0.0
		lineageTag: 1f9c0a00-0000-4b00-9c00-91722678355313

	measure '% Multimorbid (2+ conditions)' = DIVIDE ( CALCULATE ( COUNTROWS ( Risk ), Risk[multimorbidity_count] >= 2 ), [Patients] )
		formatString: 0.0%
		lineageTag: 1f9c0a00-0000-4b00-9c00-41072916849894

	measure '% Frail (eFI mod/severe)' = DIVIDE ( CALCULATE ( COUNTROWS ( Risk ), Risk[efi_band] IN { "3 Moderate", "4 Severe" } ), [Patients] )
		formatString: 0.0%
		lineageTag: 1f9c0a00-0000-4b00-9c00-272120431884371

	measure 'High Risk (CMS Q5)' = CALCULATE ( COUNTROWS ( Risk ), Risk[cms_quintile] = 5 )
		formatString: #,0
		lineageTag: 1f9c0a00-0000-4b00-9c00-278497288854018

	measure '% High ACG (RUB 4-5)' = DIVIDE ( CALCULATE ( COUNTROWS ( Risk ), Risk[rub] IN { "4", "5" } ), [Patients] )
		formatString: 0.0%
		lineageTag: 1f9c0a00-0000-4b00-9c00-5236112904597

	measure 'Anticoag Gap' = CALCULATE ( COUNTROWS ( Risk ), Risk[anticoag_candidate] = TRUE (), Risk[bleed_risk_concern] = FALSE () )
		formatString: #,0
		lineageTag: 1f9c0a00-0000-4b00-9c00-50711956287820

	measure 'Patients (Diabetes)' = CALCULATE ( COUNTROWS ( Risk ), Risk[has_diabetes] = TRUE () )
		formatString: #,0
		lineageTag: 1f9c0a00-0000-4b00-9c00-99934201316841

	measure 'Patients (COPD)' = CALCULATE ( COUNTROWS ( Risk ), Risk[has_copd] = TRUE () )
		formatString: #,0
		lineageTag: 1f9c0a00-0000-4b00-9c00-141260770436449

	measure 'Patients (CHD)' = CALCULATE ( COUNTROWS ( Risk ), Risk[has_chd] = TRUE () )
		formatString: #,0
		lineageTag: 1f9c0a00-0000-4b00-9c00-12061936115102

	measure 'Patients (CKD)' = CALCULATE ( COUNTROWS ( Risk ), Risk[has_ckd] = TRUE () )
		formatString: #,0
		lineageTag: 1f9c0a00-0000-4b00-9c00-277932815820903

	measure 'Patients (Dementia)' = CALCULATE ( COUNTROWS ( Risk ), Risk[has_dementia] = TRUE () )
		formatString: #,0
		lineageTag: 1f9c0a00-0000-4b00-9c00-153989129572540

	measure 'Patients (SMI)' = CALCULATE ( COUNTROWS ( Risk ), Risk[has_smi] = TRUE () )
		formatString: #,0
		lineageTag: 1f9c0a00-0000-4b00-9c00-143344398732309

