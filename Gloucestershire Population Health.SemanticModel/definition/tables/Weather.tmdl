table Weather
	lineageTag: f8dd4fb6-929e-425b-92bf-09b1887c953b

	measure 'Heatwave Days' = SUM ( Weather[is_heatwave_day] )
		formatString: #,0
		lineageTag: 585eb85f-e425-44e7-99ef-fb289873ceb5

	measure 'Cold-snap Days' = SUM ( Weather[is_cold_snap_day] )
		formatString: #,0
		lineageTag: 21ba5533-b1ee-490e-8d62-56ffe4d0d14a

	measure 'Avg Max Temp' = AVERAGE ( Weather[temp_max_c] )
		formatString: 0.0
		lineageTag: 1c3d2793-4186-48d9-ac0d-62ec4c0397e5

	measure 'Total Rainfall (mm)' = SUM ( Weather[rainfall_mm] )
		formatString: #,0
		lineageTag: f4b5a911-a51c-4d04-82b8-5845e12ff75a

	column weather_date
		dataType: dateTime
		formatString: dd mmm
		lineageTag: af09731a-3851-46d7-aa02-e72a8f16a5ea
		summarizeBy: none
		sourceColumn: weather_date

		annotation SummarizationSetBy = Automatic

	column location
		dataType: string
		lineageTag: 1e022ff8-4020-4646-ac2b-ed765737890a
		summarizeBy: none
		sourceColumn: location

		annotation SummarizationSetBy = Automatic

	column temp_max_c
		dataType: double
		formatString: 0.0
		lineageTag: e62c8303-900c-4d4c-9553-21ce91b5b91c
		summarizeBy: average
		sourceColumn: temp_max_c

		annotation SummarizationSetBy = Automatic

	column temp_mean_c
		dataType: double
		formatString: 0.0
		lineageTag: 3411dd80-c425-4392-806f-8804fc06ef51
		summarizeBy: average
		sourceColumn: temp_mean_c

		annotation SummarizationSetBy = Automatic

	column rainfall_mm
		dataType: double
		formatString: 0.0
		lineageTag: d5d39a1c-765c-4621-a199-0c16d931d831
		summarizeBy: sum
		sourceColumn: rainfall_mm

		annotation SummarizationSetBy = Automatic

	column is_heatwave_day
		dataType: int64
		formatString: 0
		lineageTag: 11e79a44-833b-43d1-b1b7-1f4e16cb6cba
		summarizeBy: sum
		sourceColumn: is_heatwave_day

		annotation SummarizationSetBy = Automatic

	column is_cold_snap_day
		dataType: int64
		formatString: 0
		lineageTag: a5890d47-2370-42df-970f-4eebcd23c081
		summarizeBy: sum
		sourceColumn: is_cold_snap_day

		annotation SummarizationSetBy = Automatic

	partition Weather = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db03_pid_reporting"), "select weather_date, location, temp_max_c, temp_mean_c, rainfall_mm, is_heatwave_day, is_cold_snap_day from data_mart_l050_phm_rpt.weather_daily", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table
