	column practice_imd_decile
		dataType: int64
		formatString: 0
		lineageTag: 1f9c0a00-0000-4b00-9c00-62856259007879
		summarizeBy: none
		sourceColumn: practice_imd_decile

		annotation SummarizationSetBy = Automatic

	partition PracticeKPI = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db03_pid_reporting"), "with glos as (#(lf)    select pl.practice_code, max(la.imd_decile) as practice_imd_decile#(lf)    from data_mart_l050_phm_rpt.practice_locations pl#(lf)    left join data_mart_l050_phm_rpt.lsoa_aggregates la on la.lsoa11cd = pl.lsoa11cd#(lf)    where pl.is_glos = true#(lf)    group by pl.practice_code#(lf)),#(lf)wf as (select practice_code, total_patients, total_gp_fte, nurse_fte, total_fte,#(lf)    row_number() over (partition by practice_code order by extract_date desc) rn#(lf)    from data_mart_l050_phm_rpt.kpi_practice_workforce),#(lf)gp as (select practice_code, overall_exp_pct, gp_contact_overall_pct, phone_access_pct,#(lf)    row_number() over (partition by practice_code order by survey_year desc) rn#(lf)    from data_mart_l050_phm_rpt.kpi_practice_gpps),#(lf)st as (select practice_code, count(*) as cvd_patients,#(lf)    sum(case when is_gap then 1 else 0 end) as statin_gap#(lf)    from data_mart_l050_phm_rpt.statin_compliance group by 1)#(lf)select w.practice_code, w.total_patients, w.total_gp_fte, w.nurse_fte, w.total_fte,#(lf)    gp.overall_exp_pct, gp.gp_contact_overall_pct, gp.phone_access_pct,#(lf)    st.cvd_patients, st.statin_gap,#(lf)    coalesce(gl.practice_imd_decile, 0) as practice_imd_decile#(lf)from wf w#(lf)join glos gl on gl.practice_code = w.practice_code#(lf)left join gp on gp.practice_code = w.practice_code and gp.rn = 1#(lf)left join st on st.practice_code = w.practice_code#(lf)where w.rn = 1", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table
