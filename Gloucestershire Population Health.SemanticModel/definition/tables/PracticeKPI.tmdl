		lineageTag: 1f9c0a00-0000-4b00-9c00-150269045952286
		summarizeBy: sum
		sourceColumn: total_fte

		annotation SummarizationSetBy = Automatic

	column overall_exp_pct
		dataType: double
		lineageTag: 1f9c0a00-0000-4b00-9c00-76089812836511
		summarizeBy: average
		sourceColumn: overall_exp_pct

