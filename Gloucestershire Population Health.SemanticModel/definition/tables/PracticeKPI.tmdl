		lineageTag: 1f9c0a00-0000-4b00-9c00-99603593511651
		summarizeBy: sum
		sourceColumn: total_gp_fte

		annotation SummarizationSetBy = Automatic

	column nurse_fte
		dataType: double
		formatString: 0.0
		lineageTag: 1f9c0a00-0000-4b00-9c00-167601114234367
		summarizeBy: sum
