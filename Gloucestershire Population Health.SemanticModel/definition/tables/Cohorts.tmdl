table Cohorts
	lineageTag: 1f9c0a00-0000-4b00-9c00-171607425956946

	measure 'Cohort Size' = SUM ( Cohorts[n] )
		formatString: #,0
		lineageTag: 1f9c0a00-0000-4b00-9c00-45232919178114

	measure 'Cohort in Deprived' = SUM ( Cohorts[deprived_n] )
		formatString: #,0
		lineageTag: 1f9c0a00-0000-4b00-9c00-141352017416345

	measure 'Cohort Deprived %' = DIVIDE ( SUM ( Cohorts[deprived_n] ), SUM ( Cohorts[n] ) )
		formatString: 0.0%
		lineageTag: 1f9c0a00-0000-4b00-9c00-153686139172010

	column cohort
		dataType: string
		lineageTag: 1f9c0a00-0000-4b00-9c00-170761418181082
		summarizeBy: none
		sourceColumn: cohort

		annotation SummarizationSetBy = Automatic

	column n
