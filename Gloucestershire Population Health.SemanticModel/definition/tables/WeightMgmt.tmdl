table WeightMgmt
	lineageTag: 340c6e2f-6a0e-05ad-714a-0a5cbca89677

	measure 'WM Cohort' = SUM ( WeightMgmt[patients] )
		formatString: #,0
		lineageTag: 6b1a0ff6-eff0-0099-6506-99f09387a89d

	measure 'WM % Obese' = DIVIDE ( SUM ( WeightMgmt[obese_patients] ), SUM ( WeightMgmt[patients] ) )
		formatString: 0.0%
		lineageTag: be2729b4-ebe6-137f-cd23-5913c4dd1871

	measure 'WM Avg BMI' = DIVIDE ( SUM ( WeightMgmt[bmi_sum] ), SUM ( WeightMgmt[bmi_n] ) )
		formatString: 0.00
		lineageTag: 4574390e-0678-a14d-1e5f-10185a23b9b9

	measure 'WM % Most Deprived' = DIVIDE ( CALCULATE ( SUM ( WeightMgmt[patients] ), WeightMgmt[england_imd_decile] <= 2 ), SUM ( WeightMgmt[patients] ) )
		formatString: 0.0%
		lineageTag: b7be33e0-5f09-bcd0-323a-83bd7c8cf4cc

	column england_imd_decile
