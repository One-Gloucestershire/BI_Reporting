	partition WeightMgmt = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "select imdnationaldecile as england_imd_decile, coalesce(bmigroup,'Unknown') as bmi_group, coalesce(eficategoryderived,'Unknown') as efi_category, coalesce(localityname,'Unknown') as locality, coalesce(gender,'Unknown') as gender, coalesce(ethnicoriginwidergroups,'Unknown') as ethnicity, count(distinct derived_pseudo_nhs) as patients, count(distinct case when obesity=1 then derived_pseudo_nhs end) as obese_patients, sum(bmi) as bmi_sum, count(bmi) as bmi_n from data_mart_powerbi_weightmanagement.tbl01_cohort group by 1,2,3,4,5,6", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table
