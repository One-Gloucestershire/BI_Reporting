	partition CVDPrevent = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "select timeperioddate as period_date,#(lf)    regexp_replace(indicatorshortname, '[^ -~]', '') as indicator, case when len(trim(split_part(replace(replace(areaname,'NHS ',''),'Nhs ',''),' Integrated Care Board',1)))<=20 then trim(split_part(replace(replace(areaname,'NHS ',''),'Nhs ',''),' Integrated Care Board',1)) else rtrim(left(trim(split_part(replace(replace(areaname,'NHS ',''),'Nhs ',''),' Integrated Care Board',1)),18),' ,')||'..' end as area,#(lf)    metriccategorytypename as cat_type, metriccategoryname as cat,#(lf)    nullif(value,'')::numeric as value,#(lf)    nullif(numerator,'')::numeric as numerator,#(lf)    nullif(denominator,'')::numeric as denominator#(lf)from data_mart_l049_nhse_cvdprevent.tbl_circulatoryprevent_201_load#(lf)where timeperioddate = (select max(timeperioddate) from data_mart_l049_nhse_cvdprevent.tbl_circulatoryprevent_201_load)#(lf)  and (metriccategoryname = 'Persons' or metriccategorytypename = 'Deprivation quintile')", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table
