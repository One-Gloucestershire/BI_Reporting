	partition Schools = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db03_pid"), "select school_phase, school_name, lad19nm, lsoa11cd, total_pupils, fsm_pct, eal_pct from data_mart_l050_phm_rpt.school_locations where is_glos = true", null, [EnableFolding=true])
