table Schools
	lineageTag: 1f9c0a00-0000-4b00-9c00-9000000000411

	measure 'Schools' = COUNTROWS ( Schools )
		formatString: #,0
		lineageTag: 1f9c0a00-0000-4b00-9c00-9000000000412

	measure 'Total Pupils' = SUM ( Schools[total_pupils] )
		formatString: #,0
		lineageTag: 1f9c0a00-0000-4b00-9c00-9000000000413

	measure 'Avg FSM %' = DIVIDE ( SUMX ( Schools, Schools[total_pupils] * Schools[fsm_pct] ), SUM ( Schools[total_pupils] ) )
		formatString: 0.0\%
		lineageTag: 1f9c0a00-0000-4b00-9c00-9000000000414

	measure 'Avg EAL %' = DIVIDE ( SUMX ( Schools, Schools[total_pupils] * Schools[eal_pct] ), SUM ( Schools[total_pupils] ) )
		formatString: 0.0\%
		lineageTag: 1f9c0a00-0000-4b00-9c00-9000000000415

