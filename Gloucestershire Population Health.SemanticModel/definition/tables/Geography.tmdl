table Geography
	lineageTag: 1f9c0a00-0000-4b00-9c00-145363923956272


	measure 'Mean Risk %' = AVERAGE ( Geography[mean_risk_pct] )
		formatString: 0.0
		lineageTag: 1f9c0a00-0000-4b00-9c00-268860782514141

	measure 'Polypharmacy rate' = DIVIDE ( SUM ( Geography[Polypharmacy] ), SUM ( Geography[patient_count] ) )
		formatString: 0.0%
		lineageTag: 1f9c0a00-0000-4b00-9c00-700000000001
	measure 'Diabetes rate' = DIVIDE ( SUM ( Geography[Diabetes] ), SUM ( Geography[patient_count] ) )
		formatString: 0.0%
		lineageTag: 1f9c0a00-0000-4b00-9c00-700000000002
	measure 'Hypertension rate' = DIVIDE ( SUM ( Geography[Hypertension] ), SUM ( Geography[patient_count] ) )
		formatString: 0.0%
		lineageTag: 1f9c0a00-0000-4b00-9c00-700000000003
	measure 'Frailty rate' = DIVIDE ( SUM ( Geography[Frailty] ), SUM ( Geography[patient_count] ) )
		formatString: 0.0%
		lineageTag: 1f9c0a00-0000-4b00-9c00-700000000004
	measure 'High-risk rate' = DIVIDE ( SUM ( Geography[High-risk count] ), SUM ( Geography[patient_count] ) )
		formatString: 0.0%
		lineageTag: 1f9c0a00-0000-4b00-9c00-700000000005

	measure 'Avg IMD Decile' = AVERAGE ( Geography[imd_decile] )
		formatString: 0.0
		lineageTag: 1f9c0a00-0000-4b00-9c00-144550842041690

	measure 'LSOA Patients' = SUM ( Geography[patient_count] )
		formatString: #,0
		lineageTag: 1f9c0a00-0000-4b00-9c00-88026271891514

	measure '% Most Deprived LSOAs' = DIVIDE ( CALCULATE ( DISTINCTCOUNT ( Geography[lsoa] ), Geography[imd_decile] <= 2 ), DISTINCTCOUNT ( Geography[lsoa] ) )
		formatString: 0.0%
		lineageTag: 1f9c0a00-0000-4b00-9c00-156581669398779

	measure 'Frailty (LSOA)' = SUM ( Geography[Frailty] )
		formatString: #,0
		lineageTag: 1f9c0a00-0000-4b00-9c00-253473605313880

	measure 'Polypharmacy (LSOA)' = SUM ( Geography[Polypharmacy] )
		formatString: #,0
		lineageTag: 1f9c0a00-0000-4b00-9c00-81613178335087

	measure 'Diabetes (LSOA)' = SUM ( Geography[Diabetes] )
		formatString: #,0
		lineageTag: 1f9c0a00-0000-4b00-9c00-237440067620394

	measure 'Hypertension (LSOA)' = SUM ( Geography[Hypertension] )
		formatString: #,0
		lineageTag: 1f9c0a00-0000-4b00-9c00-87922185855611

	measure 'High-risk (LSOA)' = SUM ( Geography[High-risk count] )
		formatString: #,0
		lineageTag: 1f9c0a00-0000-4b00-9c00-247131230334144

	measure 'Priority Index' = AVERAGE ( Geography[mean_risk_pct] ) * ( 11 - AVERAGE ( Geography[imd_decile] ) )
		formatString: 0.0
		lineageTag: 1f9c0a00-0000-4b00-9c00-164383702702221

	measure 'High-risk Annual Cost' = [High-risk (LSOA)] * 3500
		formatString: \£#,0
		lineageTag: 1f9c0a00-0000-4b00-9c00-160393624316054

	measure 'Avertable Spend' = [High-risk Annual Cost] * ( [Reach % Value] / 100 ) * ( [Avertable % Value] / 100 )
		formatString: \£#,0
		lineageTag: 1f9c0a00-0000-4b00-9c00-141809499658237

	measure 'Avertable Spend (deprived)' = CALCULATE ( [Avertable Spend], Geography[imd_decile] <= 2 )
		formatString: \£#,0
		lineageTag: 1f9c0a00-0000-4b00-9c00-188114641829210

