				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db03_pid_reporting"), "select lsoa11cd as lsoa, lsoa11nm as lsoa_name, lad19nm as lad,#(lf)    imd_decile, imd_score, patients, mean_risk_pct, frailty_n, poly_n, diabetes_n, htn_n, top_risk_n#(lf)from data_mart_l050_phm_rpt.lsoa_aggregates", null, [EnableFolding=true])
