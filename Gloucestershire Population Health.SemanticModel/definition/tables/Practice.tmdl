		sourceColumn: pcn_code

		annotation SummarizationSetBy = Automatic

	column lad
		dataType: string
		lineageTag: 1f9c0a00-0000-4b00-9c00-187986307515779
		summarizeBy: none
		sourceColumn: lad

		annotation SummarizationSetBy = Automatic

	partition Practice = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db03_pid_reporting"), "select practice_code, max(practice_name) as practice_name,#(lf)    max(lat) as latitude, max(lon) as longitude, max(pcn_code) as pcn_code, max(lad19nm) as lad#(lf)from data_mart_l050_phm_rpt.practice_locations where is_glos = true group by practice_code", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table
