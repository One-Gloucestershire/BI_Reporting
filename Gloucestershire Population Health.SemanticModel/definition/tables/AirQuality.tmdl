table AirQuality
	lineageTag: 4a17b900-0000-4d00-aq00-100000000001

	measure 'Mean concentration' = AVERAGE ( AirQuality[mean_value] )
		formatString: #,0.0
		lineageTag: 4a17b900-0000-4d00-aq00-100000000002

	measure 'WHO guideline' = MAX ( AirQuality[who_annual_guideline] )
		formatString: #,0.0
		lineageTag: 4a17b900-0000-4d00-aq00-100000000003

	measure 'Latest 12m mean' =
			VAR maxm = CALCULATE ( MAX ( AirQuality[month_start] ), ALL ( AirQuality[month_start] ) )
			RETURN
			    CALCULATE ( AVERAGE ( AirQuality[mean_value] ), AirQuality[month_start] > EDATE ( maxm, -12 ) )
		formatString: #,0.0
		lineageTag: 4a17b900-0000-4d00-aq00-100000000004

	measure 'vs WHO guideline' = DIVIDE ( [Latest 12m mean], [WHO guideline] )
		formatString: 0.0"x"
		lineageTag: 4a17b900-0000-4d00-aq00-100000000005

	measure 'Glos PM2.5 (12m)' = CALCULATE ( [Latest 12m mean], AirQuality[pollutant_code] = "PM2.5", AirQuality[is_glos] = TRUE )
		formatString: #,0.0
		lineageTag: 4a17b900-0000-4d00-aq00-100000000006

	measure 'Glos PM10 (12m)' = CALCULATE ( [Latest 12m mean], AirQuality[pollutant_code] = "PM10", AirQuality[is_glos] = TRUE )
		formatString: #,0.0
		lineageTag: 4a17b900-0000-4d00-aq00-100000000007

	measure 'NO2 ref (12m)' = CALCULATE ( [Latest 12m mean], AirQuality[pollutant_code] = "NO2" )
		formatString: #,0.0
		lineageTag: 4a17b900-0000-4d00-aq00-100000000008

	measure 'PM2.5 mean' = CALCULATE ( AVERAGE ( AirQuality[mean_value] ), AirQuality[pollutant_code] = "PM2.5" )
		formatString: #,0.0
		lineageTag: 4a17b900-0000-4d00-aq00-100000000009

