		summarizeBy: sum
		sourceColumn: hours_measured

		annotation SummarizationSetBy = Automatic

	column who_annual_guideline
		dataType: double
		formatString: #,0.0
		lineageTag: 4a17b900-0000-4d00-aq00-100000000021
