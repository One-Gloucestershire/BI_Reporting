		sourceColumn: who_annual_guideline

		annotation SummarizationSetBy = Automatic

	partition AirQuality = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "select station_code, station_name, site_type, is_glos, pollutant_code, pollutant_label, units, month_start, mean_value, max_hourly, hours_measured, who_annual_guideline from db03_pid.data_mart_l050_phm_rpt.air_quality_station", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table
