	partition Demographics = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "select#(lf)    actual_age as age,#(lf)    case when actual_age is null then 'Unknown' when actual_age>=90 then '90+'#(lf)         else lpad(cast(floor(actual_age/5)*5 as int)::varchar,2,'0')||'-'||lpad(cast(floor(actual_age/5)*5+4 as int)::varchar,2,'0') end as age_band,#(lf)    case when actual_age is null then 999 when actual_age>=90 then 90 else cast(floor(actual_age/5)*5 as int) end as age_band_sort,#(lf)    gender, ethnicity, ethnicminority,#(lf)    imd_decile_england, imd_decile_gloucester, core20,#(lf)    gp_practice_code, gp_practice_name, primarycarenetwork as pcn, locality,#(lf)    lsoa_code, ward_name, district_name, age_65_and_over, care_home#(lf)from data_mart_powerbi_phm.tbl02_demographicsoverview", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table
