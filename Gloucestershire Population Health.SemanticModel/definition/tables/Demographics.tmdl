table Demographics
	lineageTag: 1f9c0a00-0000-4b00-9c00-236355568406895

	measure 'ASR % Hypertension' = VAR tot = SUM ( ESP[esp_weight] ) RETURN DIVIDE ( SUMX ( ESP, ESP[esp_weight] * DIVIDE ( CALCULATE ( COUNTROWS ( Demographics ), Demographics[qof_hypertension] = TRUE () ), CALCULATE ( COUNTROWS ( Demographics ) ) ) ), tot )
		formatString: 0.0%
		displayFolder: Statistics (credibility)
		lineageTag: 1f9c0a00-0000-4b00-9c00-930000000001
	measure 'ASR % Diabetes' = VAR tot = SUM ( ESP[esp_weight] ) RETURN DIVIDE ( SUMX ( ESP, ESP[esp_weight] * DIVIDE ( CALCULATE ( COUNTROWS ( Demographics ), Demographics[qof_diabetes] = TRUE () ), CALCULATE ( COUNTROWS ( Demographics ) ) ) ), tot )
		formatString: 0.0%
		displayFolder: Statistics (credibility)
		lineageTag: 1f9c0a00-0000-4b00-9c00-930000000002
	measure 'ASR % CHD' = VAR tot = SUM ( ESP[esp_weight] ) RETURN DIVIDE ( SUMX ( ESP, ESP[esp_weight] * DIVIDE ( CALCULATE ( COUNTROWS ( Demographics ), Demographics[qof_coronaryheartdisease] = TRUE () ), CALCULATE ( COUNTROWS ( Demographics ) ) ) ), tot )
		formatString: 0.0%
		displayFolder: Statistics (credibility)
		lineageTag: 1f9c0a00-0000-4b00-9c00-930000000003

	measure Population = COUNTROWS ( Demographics )
		formatString: #,0
		lineageTag: 1f9c0a00-0000-4b00-9c00-170167946795447

	measure PCNs = DISTINCTCOUNT ( Demographics[pcn] )
		formatString: 0
		lineageTag: 1f9c0a00-0000-4b00-9c00-13912530034322

	measure Localities = DISTINCTCOUNT ( Demographics[locality] )
		formatString: 0
		lineageTag: 1f9c0a00-0000-4b00-9c00-63222527873090

	measure '% Aged 65+' = DIVIDE ( CALCULATE ( COUNTROWS ( Demographics ), Demographics[age_65_and_over] = TRUE () ), [Population] )
		formatString: 0.0%
		lineageTag: 1f9c0a00-0000-4b00-9c00-171388276891129

	measure '% Most Deprived' = DIVIDE ( CALCULATE ( COUNTROWS ( Demographics ), Demographics[imd_decile_england] <= 2 ), [Population] )
		formatString: 0.0%
		lineageTag: 1f9c0a00-0000-4b00-9c00-210874039539377

	measure '% CORE20' = DIVIDE ( CALCULATE ( COUNTROWS ( Demographics ), Demographics[core20] = TRUE () ), [Population] )
		formatString: 0.0%
		lineageTag: 1f9c0a00-0000-4b00-9c00-170530377365315

	measure '% Ethnic Minority' = DIVIDE ( CALCULATE ( COUNTROWS ( Demographics ), Demographics[ethnicminority] = TRUE () ), [Population] )
		formatString: 0.0%
		lineageTag: 1f9c0a00-0000-4b00-9c00-179573655860675

	measure '% in Care Home' = DIVIDE ( CALCULATE ( COUNTROWS ( Demographics ), Demographics[care_home] = TRUE () ), [Population] )
		formatString: 0.0%
		lineageTag: 1f9c0a00-0000-4b00-9c00-35589802627757

	measure 'Patients (Female)' = CALCULATE ( COUNTROWS ( Demographics ), Demographics[gender] = "F" )
		formatString: #,0
		lineageTag: 1f9c0a00-0000-4b00-9c00-256802583344039

	measure 'Patients (Male)' = CALCULATE ( COUNTROWS ( Demographics ), Demographics[gender] = "M" )
		formatString: #,0
		lineageTag: 1f9c0a00-0000-4b00-9c00-57608628494262

	measure 'Pyramid Female' = -1 * [Patients (Female)]
		formatString: #,0
		lineageTag: 1f9c0a00-0000-4b00-9c00-58992066317492

	measure 'Avg Conditions' = AVERAGE ( Demographics[multimorbidity_count] )
		formatString: 0.00
		lineageTag: 1f9c0a00-0000-4b00-9c00-149362740318257

	measure '% Multimorbid (2+)' = DIVIDE ( CALCULATE ( COUNTROWS ( Demographics ), Demographics[multimorbidity_count] >= 2 ), [Population] )
		formatString: 0.0%
		lineageTag: 1f9c0a00-0000-4b00-9c00-8515943342740

	measure '% Hypertension' = DIVIDE ( CALCULATE ( COUNTROWS ( Demographics ), Demographics[qof_hypertension] = TRUE () ), [Population] )
		formatString: 0.0%
		lineageTag: 1f9c0a00-0000-4b00-9c00-181500947926352

	measure '% Diabetes' = DIVIDE ( CALCULATE ( COUNTROWS ( Demographics ), Demographics[qof_diabetes] = TRUE () ), [Population] )
		formatString: 0.0%
		lineageTag: 1f9c0a00-0000-4b00-9c00-83451068310000

	measure '% COPD' = DIVIDE ( CALCULATE ( COUNTROWS ( Demographics ), Demographics[qof_copd] = TRUE () ), [Population] )
		formatString: 0.0%
		lineageTag: 1f9c0a00-0000-4b00-9c00-40688400952055

	measure '% SMI' = DIVIDE ( CALCULATE ( COUNTROWS ( Demographics ), Demographics[qof_mentalhealth] = TRUE () ), [Population] )
		formatString: 0.0%
		lineageTag: 1f9c0a00-0000-4b00-9c00-29910608562056

	measure '% Cancer' = DIVIDE ( CALCULATE ( COUNTROWS ( Demographics ), Demographics[qof_cancer] = TRUE () ), [Population] )
		formatString: 0.0%
		lineageTag: 1f9c0a00-0000-4b00-9c00-206447575717697

	measure 'Selected Lens Metric' =
			SWITCH (
			    SELECTEDVALUE ( 'Inequality Lens'[Inequality Lens], "% Multimorbid (2+)" ),
			    "% Multimorbid (2+)", [% Multimorbid (2+)],
			    "Avg Conditions", [Avg Conditions],
			    "% Hypertension", [% Hypertension],
			    "% Diabetes", [% Diabetes],
			    "% COPD", [% COPD],
			    "% SMI", [% SMI],
			    "% Cancer", [% Cancer],
			    [% Multimorbid (2+)]
			)
		lineageTag: 1f9c0a00-0000-4b00-9c00-9000000000201

	measure 'Multimorbid Most Deprived' = CALCULATE ( [% Multimorbid (2+)], Demographics[imd_decile_england] <= 2 )
		formatString: 0.0%
		lineageTag: 1f9c0a00-0000-4b00-9c00-164376679765062

	measure 'Multimorbid Least Deprived' = CALCULATE ( [% Multimorbid (2+)], Demographics[imd_decile_england] >= 9 )
		formatString: 0.0%
		lineageTag: 1f9c0a00-0000-4b00-9c00-156032084383869

	measure 'Deprivation Gap (x)' = DIVIDE ( [Multimorbid Most Deprived], [Multimorbid Least Deprived] )
		formatString: 0.00
		lineageTag: 1f9c0a00-0000-4b00-9c00-266543032946679

