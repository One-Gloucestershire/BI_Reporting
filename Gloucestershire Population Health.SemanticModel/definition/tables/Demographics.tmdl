	partition Demographics = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "select#(lf)    actual_age as age,#(lf)    case when actual_age is null then 'Unknown' when actual_age>=90 then '90+'#(lf)         else lpad(cast(floor(actual_age/5)*5 as int)::varchar,2,'0')||'-'||lpad(cast(floor(actual_age/5)*5+4 as int)::varchar,2,'0') end as age_band,#(lf)    case when actual_age is null then 999 when actual_age>=90 then 90 else cast(floor(actual_age/5)*5 as int) end as age_band_sort,#(lf)    gender, case when ethnicity ilike '%english%' or (ethnicity ilike '%british%' and ethnicity ilike '%white%') then 'White British' when ethnicity ilike '%irish%' then 'White Irish' when ethnicity ilike '%white%' then 'White' when ethnicity ilike '%mixed%' or ethnicity ilike '%multiple%' then 'Mixed' when ethnicity ilike '%asian%' then 'Asian' when ethnicity ilike '%black%' or ethnicity ilike '%african%' or ethnicity ilike '%caribbean%' then 'Black' when ethnicity ilike '%refused%' or ethnicity ilike '%not stated%' then 'Not stated' when ethnicity ilike '%not known%' or ethnicity ilike '%unknown%' then 'Not known' when ethnicity ilike '%other%' then 'Other' else left(initcap(trim(ethnicity)),20) end as ethnicity, ethnicminority,#(lf)    imd_decile_england, imd_decile_gloucester, core20,#(lf)    gp_practice_code, gp_practice_name, primarycarenetwork as pcn, locality,#(lf)    lsoa_code, ward_name, district_name, age_65_and_over, care_home,#(lf)    qof_hypertension, qof_diabetes, qof_copd, qof_asthma, qof_mentalhealth,#(lf)    qof_cancer, qof_coronaryheartdisease, qof_chronickidneydisease, qof_dementia, qof_depression,#(lf)    (case when qof_diabetes then 1 else 0 end + case when qof_hypertension then 1 else 0 end#(lf)     + case when qof_copd then 1 else 0 end + case when qof_asthma then 1 else 0 end#(lf)     + case when qof_coronaryheartdisease then 1 else 0 end + case when qof_atrialfibrilation then 1 else 0 end#(lf)     + case when qof_heartfailure then 1 else 0 end + case when qof_strokeandtia then 1 else 0 end#(lf)     + case when qof_chronickidneydisease then 1 else 0 end + case when qof_dementia then 1 else 0 end#(lf)     + case when qof_depression then 1 else 0 end + case when qof_mentalhealth then 1 else 0 end#(lf)     + case when qof_cancer then 1 else 0 end + case when qof_epilepsy then 1 else 0 end#(lf)     + case when qof_osteoporosis then 1 else 0 end + case when qof_peripheralarterialdisease then 1 else 0 end#(lf)     + case when qof_rheumatoidarthritis then 1 else 0 end + case when qof_learningdisability then 1 else 0 end) as multimorbidity_count#(lf)from data_mart_powerbi_phm.tbl02_demographicsoverview", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table

