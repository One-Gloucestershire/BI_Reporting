table Prescribing
	lineageTag: 1f9c0a00-0000-4b00-9c00-168246975042290

	measure 'Rx Items' = SUM ( Prescribing[items] )
		formatString: #,0
		lineageTag: 1f9c0a00-0000-4b00-9c00-279197768727697

	measure 'Rx Cost (£)' = DIVIDE ( SUM ( Prescribing[nic_pence] ), 100 )
		formatString: \£#,0
		lineageTag: 1f9c0a00-0000-4b00-9c00-231919543723615

	column month_date
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 1f9c0a00-0000-4b00-9c00-215323527866570
		summarizeBy: none
		sourceColumn: month_date

		annotation SummarizationSetBy = Automatic

	column practice_code
		dataType: string
		lineageTag: 1f9c0a00-0000-4b00-9c00-177580610354773
		summarizeBy: none
		sourceColumn: practice_code

		annotation SummarizationSetBy = Automatic

	column 'BNF chapter'
		dataType: string
		lineageTag: 1f9c0a00-0000-4b00-9c00-124060957888756
		summarizeBy: none
		sourceColumn: bnf_chapter

		annotation SummarizationSetBy = Automatic

	column practice_imd_decile
		dataType: int64
		formatString: 0
		lineageTag: 1f9c0a00-0000-4b00-9c00-62856259007879
		summarizeBy: none
		sourceColumn: practice_imd_decile

		annotation SummarizationSetBy = Automatic

	column items
		dataType: int64
		formatString: #,0
		lineageTag: 1f9c0a00-0000-4b00-9c00-261016027751036
		summarizeBy: sum
		sourceColumn: items

		annotation SummarizationSetBy = Automatic

	column nic_pence
		dataType: int64
		formatString: #,0
		lineageTag: 1f9c0a00-0000-4b00-9c00-24047307249218
		summarizeBy: sum
		sourceColumn: nic_pence

		annotation SummarizationSetBy = Automatic

	partition Prescribing = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db03_pid_reporting"), "with glos as (#(lf)    select pl.practice_code, max(la.imd_decile) as practice_imd_decile#(lf)    from data_mart_l050_phm_rpt.practice_locations pl#(lf)    left join data_mart_l050_phm_rpt.lsoa_aggregates la on la.lsoa11cd = pl.lsoa11cd#(lf)    where pl.is_glos = true#(lf)    group by pl.practice_code#(lf))#(lf)select (r.year_month || '-01')::date as month_date, r.practice_code, case r.bnf_chapter when 'Ga' then 'Gastro-intestinal' when 'Ca' then 'Cardiovascular' when 'Re' then 'Respiratory' when 'Ce' then 'CNS' when 'In' then 'Infections' when 'En' then 'Endocrine' when 'Ob' then 'Obstetrics & gynae' when 'Ma' then 'Malignant disease' when 'Nu' then 'Nutrition & blood' when 'Mu' then 'Musculoskeletal' when 'Ey' then 'Eye' when 'Ea' then 'Ear, nose & throat' when 'Sk' then 'Skin' when 'Im' then 'Vaccines & immunology' when 'An' then 'Anaesthesia' else r.bnf_chapter end as bnf_chapter,#(lf)    coalesce(g.practice_imd_decile, 0) as practice_imd_decile,#(lf)    sum(r.items) as items, sum(r.nic_pence) as nic_pence#(lf)from data_mart_l050_phm_rpt.prescribing_cost_practice r#(lf)join glos g on g.practice_code = r.practice_code#(lf)group by 1,2,3,4", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table
