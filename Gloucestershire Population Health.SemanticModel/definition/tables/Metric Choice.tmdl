table 'Metric Choice'
	lineageTag: 1f9c0a00-0000-4b00-9c00-7e0000000000

	measure 'Selected metric' = ```
			SWITCH (
			    SELECTEDVALUE ( 'Metric Choice'[Metric], "Mean risk %" ),
			    "Mean risk %", [Mean Risk %],
			    "IMD decile (1=most deprived)", [Avg IMD Decile],
			    "Polypharmacy %", [Polypharmacy rate] * 100,
			    "Diabetes %", [Diabetes rate] * 100,
			    "Hypertension %", [Hypertension rate] * 100,
			    "Frailty %", [Frailty rate] * 100,
			    "High-risk %", [High-risk rate] * 100,
			    "Crime rate /1000", [Crime rate /1000],
			    "Social housing %", [Avg Social Rented %],
			    "Overcrowding %", [Avg Overcrowded %],
			    "No central heating %", [Avg No Central Heating %],
			    "ACG cohort prevalence %", [Cohort prevalence %] * 100,
			    [Mean Risk %]
			)
			```
		formatString: 0.0
		lineageTag: 1f9c0a00-0000-4b00-9c00-7e0000000001

