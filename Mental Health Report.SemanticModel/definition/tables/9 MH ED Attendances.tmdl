	measure MH_ED_reattendance_within_30_days_Rate_Per_1000_MH_ED_Attendances_Crude_Rate = ```
			
			
			
			VAR latest_date = MAX(REF_Date_Ref[date])
			VAR start_of_latest_month = DATE(YEAR(latest_date), MONTH(latest_date), 1)
			
			VAR total_mh_ed_reattendances = calculate(sum('9 MH ED Attendances'[counter])
