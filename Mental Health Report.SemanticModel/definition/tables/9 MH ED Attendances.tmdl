table '9 MH ED Attendances'
	lineageTag: f0e5e5da-5208-421a-89be-aaea729eed46

	measure MH_Graph_Header_3_Text = ```
			MAX('9 MH_ED_Metric_Parameter'[Parameter]) & " by " & MAX('9 MH_ED_Parameter_Dimensions'[Parameter])
			
			
			```
		lineageTag: 13ef0b4e-1964-4dcc-863c-02cc8a5dcc95

	measure MH_ED_Attendances_Rate_Per_1000_Population_Crude_Rate = ```
			
			
			
			VAR latest_date = MAX(REF_Date_Ref[date])
			VAR start_of_latest_month = DATE(YEAR(latest_date), MONTH(latest_date), 1)
			
			VAR total_mh_ed_attendances = sum('9 MH ED Attendances'[counter])
			
			Var total_reg_population = calculate(DISTINCTCOUNT('REF_GP Practice Populations'[nhs_number])
			,'REF_GP Practice Populations'[CensusDate_as_date] = start_of_latest_month,
			 ALL(REF_GP_Reference_Table)
			)
			
			RETURN
			
			 (total_mh_ed_attendances/total_reg_population)*1000
			
			
			
			```
		lineageTag: e7f8e3b8-6774-4312-af0b-5b7c1a8ff200

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Total_MH_ED_Attendances = sum('9 MH ED Attendances'[counter])
		formatString: 0
		lineageTag: 2ab2f27d-5029-4e84-8323-c7407eae152f

	measure Only_Relevant_MH_ED_Attendances_in_filter =
			
			
			var MH_ED_row_count = countrows('9 MH ED Attendances')
			
			RETURN
			
			MH_ED_row_count
		formatString: 0
		lineageTag: 4087ac56-1383-420d-b14f-6d55a394f9d0

	measure Number_of_MH_ED_Att_current_FY_in_reporting =
			
			
			var latest_reporting_month = calculate(max(REF_Date_Ref[financial_month]),REF_Date_Ref[Reporting_Month_Flag] = 1,all(REF_Date_Ref))
			var latest_financial_year_order_in_range = calculate(max(REF_Date_Ref[Date_Order_Financial_Year]),all(REF_Date_Ref))
			Var final_calc = calculate([Total_MH_ED_Attendances],REF_Date_Ref[financial_month] <= latest_reporting_month,REF_Date_Ref[Date_Order_Financial_Year] = latest_financial_year_order_in_range,all(REF_Date_Ref)
			)
			
			return
			
			if(isblank(final_calc),0,final_calc)
		formatString: 0
		lineageTag: 913df7ca-9cd7-4719-9962-7ac58aade9e7

	measure Number_of_MH_ED_Att_previous_FY_in_reporting =
			
			
			var latest_reporting_month = calculate(max(REF_Date_Ref[financial_month]),REF_Date_Ref[Reporting_Month_Flag] = 1,all(REF_Date_Ref))
			var latest_financial_year_order_in_range = calculate(max(REF_Date_Ref[Date_Order_Financial_Year]),all(REF_Date_Ref))
			
			return
			
			calculate([Total_MH_ED_Attendances],REF_Date_Ref[financial_month] <= latest_reporting_month,REF_Date_Ref[Date_Order_Financial_Year] = latest_financial_year_order_in_range -1,all(REF_Date_Ref)
			)
		formatString: 0
		lineageTag: dbca6e3d-d976-4557-835b-664a91d9a0fd

	measure Number_of_MH_ED_Att_%_variance_current_reporting_period_current_FY_Vs_Previous = ([Number_of_MH_ED_Att_current_FY_in_reporting] - [Number_of_MH_ED_Att_previous_FY_in_reporting])/[Number_of_MH_ED_Att_previous_FY_in_reporting]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 6eff9323-8f74-4e55-95f2-8036b62a6ee2

