	measure Parameter_Trendline = ```
			
			
			VAR SelectedMetric =
			    // ← your existing slicer-backed parameter measure
			    
			    SELECTEDVALUE(
			        '9 MH_ED_Metric_Parameter'[Parameter Fields],
			        BLANK()
			    )
			
			 
			VAR Temp_Table=
			    FILTER(
			        SELECTCOLUMNS(
			            ALLSELECTED( 'REF_Date_Ref'[financial_year], 'REF_Date_Ref'[financial_month],
			                         'REF_Date_Ref'[month_name], 'REF_Date_Ref'[month_number] ),
			            "Value_x", 'REF_Date_Ref'[month_number],
			            "Value_y", SelectedMetric
			        ),
			        AND(
			            NOT ( ISBLANK( "Value_x") ),
			            NOT ( ISBLANK( "Value_y") )
			        )
			    )
			 
			VAR LINESTX_Table=
			    LINESTX(Temp_Table, [Value_y], [Value_x], TRUE)
			VAR Slope=
			    MAXX( LINESTX_Table, [Slope1] )
			VAR Intercept=
			    MAXX( LINESTX_Table, [Intercept] )
			 
			RETURN
			    SUMX(
			        DISTINCT( 'REF_Date_Ref'[month_number] ),
			        Intercept+ Slope* 'REF_Date_Ref'[month_number]
			    )
			
			```
		lineageTag: 9f0395e7-0109-4c9a-acfc-6bcc77e12aa3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

