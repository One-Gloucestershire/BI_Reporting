	partition REF_Provider_Ref = m
		mode: import
		queryGroup: 'Reference Tables'
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db01_reference"), "select p.code as ""Provider_Code"", p.name as ""Provider_Description"", p.ods_api_role_name as ""Provider_Type"", case when p.code like 'RTQ%' then p.name when p.ods_api_role_name = 'NHS TRUST' then 'OTHER NHS TRUSTS' when p.ods_api_role_name = 'INDEPENDENT SECTOR H/C PROVIDER SITE' then 'INDEPENDENT SECTOR HEALTHCARE PROVIDER' else p.ods_api_role_name end as ""Provider_Group"", case when p.code in ('11M','QR1') then 'NHS GLOUCESTERSHIRE ICB - 11M' when p.code is null then null else 'All Other Commissioners' end as ""Commissioner_Group"" from dscro_national_lookups.ods_all_codes as p", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

