	partition REF_ED_Department_Type = m
		mode: import
		queryGroup: 'Reference Tables'
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db01_reference"), "select distinct right(mct,1) as ""department_type_code"", case when right(mct,1) in ('1','2') then 'A&E Department' when right(mct,1)='3' then 'Minor Injury Unit' when right(mct,1)='4' then 'NHS Walk In Centre' when right(mct,1)='5' then 'Same Day Emergency Care (no longer used)' end as ""department_type"" from (select '01' mct union all select '02' union all select '03' union all select '04' union all select '05') v order by 1", null, [EnableFolding=true])
				in
				    Source

