	partition '10 MH Acute Admissions' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "select *, case when gender='Male' then '1' when gender='Female' then '2' when gender='Not Known' then 'X' when gender not in ('Male','Female','Not Known') and gender is not null then '4' when gender='Not Specified' then '4' when gender is null then null end as ""Gender_Code"" from data_mart_powerbi_secondarycare.tbl07_inpatients where mh_related_admission = 1", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

