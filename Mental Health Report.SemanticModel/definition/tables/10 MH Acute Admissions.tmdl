table '10 MH Acute Admissions'
	lineageTag: 5043d503-a1de-454c-9a41-d74932cb8fa3

	measure Total_MH_Acute_Admissions = sum('10 MH Acute Admissions'[counter])
		formatString: 0
		lineageTag: f45e1f4a-5f2e-4808-9c60-41f7b9550376

	measure MH_Acute_Admissions_Rate_Per_1000_Population_Crude_Rate = ```
			
			
			
			VAR latest_date = MAX(REF_Date_Ref[date])
			VAR start_of_latest_month = DATE(YEAR(latest_date), MONTH(latest_date), 1)
			
			VAR total_mh_emg_admissions = sum('10 MH Acute Admissions'[counter])
			
			Var total_reg_population = calculate(DISTINCTCOUNT('REF_GP Practice Populations'[nhs_number])
			,'REF_GP Practice Populations'[CensusDate_as_date] = start_of_latest_month,
			 ALL(REF_GP_Reference_Table)
			)
			
			RETURN
			
			 (total_mh_emg_admissions/total_reg_population)*1000
			
			```
		lineageTag: 520e2aec-657f-40ab-bec5-5bbfcdb8d18f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure MH_Acute_readmission_within_30_days =
			
			
			calculate(sum('10 MH Acute Admissions'[counter])
			,'10 MH Acute Admissions'[MH_Related_Admission] = 1
			,'10 MH Acute Admissions'[MH_acute_readmission_within_30_days_flag] = 1
			)
		formatString: 0
		lineageTag: 4b4991ac-de00-4331-a388-8826f9d9e9aa

	measure MH_Acute_Readmission_within_30_days_Rate_Per_1000_MH_Acute_Admissions_Crude_Rate = ```
			
			
			
			VAR latest_date = MAX(REF_Date_Ref[date])
			VAR start_of_latest_month = DATE(YEAR(latest_date), MONTH(latest_date), 1)
			
			VAR total_MH_Acute_readmissions = calculate(sum('10 MH Acute Admissions'[counter])
			,'10 MH Acute Admissions'[MH_Related_Admission] = 1
			,'10 MH Acute Admissions'[MH_acute_readmission_within_30_days_flag] = 1) 
			
			Var total_mh_acute_admissions =  calculate(sum('10 MH Acute Admissions'[counter])
			,'10 MH Acute Admissions'[MH_Related_Admission] = 1
			)
			RETURN
			
			 (total_MH_Acute_readmissions/total_mh_acute_admissions)*1000
			
			```
		lineageTag: 56490c50-452a-4c1c-83f3-49677d47c5ea

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure MH_Acute_Readmission_within_6_months_Rate_Per_1000_MH_Acute_Admissions_Crude_Rate = ```
			
			
			VAR latest_date = MAX(REF_Date_Ref[date])
			VAR start_of_latest_month = DATE(YEAR(latest_date), MONTH(latest_date), 1)
			
			VAR total_MH_Acute_readmissions = calculate(sum('10 MH Acute Admissions'[counter])
			,'10 MH Acute Admissions'[MH_Related_Admission] = 1
			,'10 MH Acute Admissions'[MH_acute_readmission_within_6_months_flag] = 1) 
			
			Var total_mh_acute_admissions =  calculate(sum('10 MH Acute Admissions'[counter])
			,'10 MH Acute Admissions'[MH_Related_Admission] = 1
			)
			RETURN
			
			 (total_MH_Acute_readmissions/total_mh_acute_admissions)*1000
			
			```
		lineageTag: 67fcfab6-659e-4254-819b-85c36a85274e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure MH_Acute_Readmission_within_12_months_Rate_Per_1000_MH_Acute_Admissions_Crude_Rate = ```
			
			
			VAR latest_date = MAX(REF_Date_Ref[date])
			VAR start_of_latest_month = DATE(YEAR(latest_date), MONTH(latest_date), 1)
			
			VAR total_MH_Acute_readmissions = calculate(sum('10 MH Acute Admissions'[counter])
			,'10 MH Acute Admissions'[MH_Related_Admission] = 1
			,'10 MH Acute Admissions'[MH_acute_readmission_within_12_months_flag] = 1) 
			
			Var total_mh_acute_admissions =  calculate(sum('10 MH Acute Admissions'[counter])
			,'10 MH Acute Admissions'[MH_Related_Admission] = 1
			)
			RETURN
			
			 (total_MH_Acute_readmissions/total_mh_acute_admissions)*1000
			
			```
		lineageTag: da9311e7-67d3-4e42-8da0-9666d85c8616

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure MH_Acute_readmission_within_6_months =
			
			
