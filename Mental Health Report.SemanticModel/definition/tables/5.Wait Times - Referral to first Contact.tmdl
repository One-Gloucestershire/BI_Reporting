table '5.Wait Times - Referral to first Contact'
	lineageTag: 79dac839-b5fd-4853-a26e-e1b80fa2eb6c

	measure Number_of_referrals_having_first_contact_each_month = distinctcount('5.Wait Times - Referral to first Contact'[UniqServReqID])
		formatString: 0
		lineageTag: d059a942-0055-46b8-8f07-c674cdeff5ab

	measure Proportion_of_referrals_having_contact_within_4_weeks = ```
			1
			
			--VAR Number_of_referrals_having_first_contact_within_4_weeks = calculate(distinctcount('5.Wait Times - Referral to first Contact'[UniqServReqID])
			--,'5.Wait Times - Referral to first Contact'[Time_Between_Referral_and_first_contact_days]  >= 0 
			--,'5.Wait Times - Referral to first Contact'[Time_Between_Referral_and_first_contact_days] <=28
			--)
			
			--RETURN
			
			--divide(IF(ISBLANK(Number_of_referrals_having_first_contact_within_4_weeks),0,Number_of_referrals_having_first_contact_within_4_weeks),[Number_of_referrals_having_first_contact_each_month])
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 5fae6544-046b-4424-9c87-80ee0664e788

	measure Only_Relevant_wait_times_in_filter =
			
			
			var Wait_times_referral_to_first_contact_row_count = countrows('5.Wait Times - Referral to first Contact')
			var Wait_times_waiting_for_first_contact_row_count = countrows('6.Wait Times -Still waiting for first contact at month end')
			
			
			RETURN
			
			Wait_times_referral_to_first_contact_row_count + Wait_times_waiting_for_first_contact_row_count
		formatString: 0
		lineageTag: 2156add6-7b12-4fd2-81ed-d37fce5939d9

	measure number_of_referrals_having_first_contact_within_4_weeks = ```
			1
			
			--VAR Number_of_referrals_having_first_contact_within_4_weeks = calculate(distinctcount('5.Wait Times - Referral to first Contact'[UniqServReqID])
			--,'5.Wait Times - Referral to first Contact'[Time_Between_Referral_and_first_contact_days]  >= 0 
			--,'5.Wait Times - Referral to first Contact'[Time_Between_Referral_and_first_contact_days] <=28
			--)
			
			--RETURN
			--Number_of_referrals_having_first_contact_within_4_weeks
			```
		formatString: 0
		lineageTag: 6b1c9dde-007f-4552-80f2-35a396cfc1b6

	measure Difference_in_proportion_of_referrals_with_a_contact_within_28_days_financial_year = ```
			
			
			
			VAR latest_financial_year = calculate(MAX('REF_Date_Ref'[financial_year])
			,all(REF_Date_Ref))
			
			
			VAR previous_financial_year
			 =CALCULATE(
			    MAX('REF_Date_Ref'[financial_year]),
			    ALL(REF_Date_Ref),
			    'REF_Date_Ref'[financial_year] <> latest_financial_year
			)
			
			Var latest_year_proportion_within_4_weeks = calculate([number_of_referrals_having_first_contact_within_4_weeks]
			,all(REF_Date_Ref)
			,REF_Date_Ref[financial_year] = latest_financial_year
			,REF_Date_Ref[Reporting_Month_Flag] = 1)
			
			Var latest_year_proportion_having_first_contact = calculate([Number_of_referrals_having_first_contact_each_month]
			,all(REF_Date_Ref)
			,REF_Date_Ref[financial_year] = latest_financial_year
			,REF_Date_Ref[Reporting_Month_Flag] = 1)
			
			var proportion_having_a_contact_within_28_days_latest_fy = divide(latest_year_proportion_within_4_weeks,latest_year_proportion_having_first_contact,"")
			--PREVIOUS YEAR VARIABLES 
			
			Var previous_year_proportion_within_4_weeks = calculate([number_of_referrals_having_first_contact_within_4_weeks]
			,all(REF_Date_Ref)
			,REF_Date_Ref[financial_year] = previous_financial_year
			,REF_Date_Ref[Reporting_Month_Flag] = 1)
			
			Var previous_year_proportion_having_first_contact = calculate([Number_of_referrals_having_first_contact_each_month]
			,all(REF_Date_Ref)
			,REF_Date_Ref[financial_year] = previous_financial_year
			,REF_Date_Ref[Reporting_Month_Flag] = 1)
			
			var proportion_having_a_contact_within_28_days_previous_fy = divide(previous_year_proportion_within_4_weeks,previous_year_proportion_having_first_contact,"")
			
			
			
			RETURN 
			
			IF(ISBLANK(proportion_having_a_contact_within_28_days_latest_fy - proportion_having_a_contact_within_28_days_previous_fy),"",proportion_having_a_contact_within_28_days_latest_fy - proportion_having_a_contact_within_28_days_previous_fy)
			
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 79db7449-2e16-4cfe-97b8-ace2498278d0

	measure Number_of_contacts_within_28_days_of_referral_%_variance_current_reporting_period_current_FY_Vs_Previous_Arrow = ```
			
			    IF(
			        [Difference_in_proportion_of_referrals_with_a_contact_within_28_days_financial_year] > 0, UNICHAR(9650),
			        IF(
			            [Difference_in_proportion_of_referrals_with_a_contact_within_28_days_financial_year] < 0, UNICHAR(9660), 
			            ""
			        )
			    )
			```
		lineageTag: 7cf009cc-02c4-48cd-8477-cddbaf68dc35

	measure Number_of_contacts_within_28_days_of_referral_%_variance_current_reporting_period_current_FY_Vs_Previous_Arrow_Colour = ```
			
			    IF(
			        [Difference_in_proportion_of_referrals_with_a_contact_within_28_days_financial_year] > 0, "Green",
			        IF(
			            [Difference_in_proportion_of_referrals_with_a_contact_within_28_days_financial_year] < 0, "Orange", BLANK()
			            
			        )
			    )
			
			```
		lineageTag: f66e89ee-f2be-4527-b54a-0ca8ccd041e7

