	partition REF_Age_Band_Ref = m
		mode: import
		queryGroup: 'Reference Tables'
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db01_reference"), "select age as ""Age"", ""5yr_age_band"" as ""5YR_Age_Band"", ""10yr_age_band"" as ""10YR_Age_Band"", pbr_age_band as ""PBR_Age_Band"", standard_age_band as ""Standard_Age_Band"", risk_strat_age_band as ""Risk_Strat_Age_Band"", risk_strat_age_bandint as ""Risk_Strat_Age_BandInt"", adult_age_band as ""Adult_Age_Band"", ""5yr_age_band_order"" as ""5YR_Age_Band_Order"", case when ""5yr_age_band"" = '5-9' then '05-9' else ""5yr_age_band"" end as ""5YR_Age_Band_Revised"", case when age between 0 and 17 then '0-17' when age between 18 and 64 then '18-64' when age>=65 then '65+' end as ""Age_group_for_Average_LOS"", case when age between 0 and 17 then 'CAMHS(0-17)' when age between 18 and 200 then 'Adults(18+)' end as ""Age_Group_CAMHS_Adults"" from ccg_reference.vw_ageband where age <= 200 and age <> -1 order by age", null, [EnableFolding=true])
				in
				    Source

