table '4.Inpatient Discharges'
	lineageTag: 86ee3b75-e8a4-4001-9a36-9598bead20d3

	measure 'Number of IP discharges' = DISTINCTCOUNT('4.Inpatient Discharges'[Unique_Hospital_Provider_SpellID])
		formatString: #,0
		displayFolder: Current IP Discharges FY vs Last FY Card Measures
		lineageTag: 1f07a007-f820-4962-a566-9862b64fbe53

	measure 'Admission to discharge ratio' = ```
			[Number of IP discharges]/[Number of admissions] 
			```
		lineageTag: 6d0fd5f0-a7c4-44ad-a633-3246c7b6cda8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Admission_Discharge_Ratio_Colour_Conditioning =
			
			IF([Admission to discharge ratio] > 1, "#488f31", "#FFB14E")
		lineageTag: 46ef6f76-70ed-4558-a2d8-86e93e0ce288

	measure Average_LoS = AVERAGE('4.Inpatient Discharges'[LoS_of_Admission])
		formatString: 0.0
		lineageTag: 74e84231-2266-44a3-9759-eb249fe55ed6

	measure Median_LoS = median('4.Inpatient Discharges'[LoS_of_Admission])
		formatString: 0.0
		lineageTag: 4fb73f92-9cea-46bd-8c9c-15efab46449a

	measure Total_Discharges_with_60+_days_LoS = sum('4.Inpatient Discharges'[Los_60+_days_flag])
		formatString: 0
		lineageTag: e42a96b4-9df7-44f2-8c96-10774f465cca

	measure Total_Discharges_with_90+_days_LoS = sum('4.Inpatient Discharges'[Los_90+_days_flag])
		formatString: 0
		lineageTag: eaf15178-0f3c-4be1-9d9e-bd9348e4eaf6

	measure proportion_of_60+_Los_discharges = ```
			divide([Total_Discharges_with_60+_days_LoS],[Number of IP discharges]) 
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 314355d5-2b25-407e-aa6e-c1673c13ef74

	measure proportion_of_90+_Los_discharges = ```
			divide([Total_Discharges_with_90+_days_LoS],[Number of IP discharges]) 
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e6782bf2-c186-43b5-be3f-231b4ce91162

	measure Number_of_inpatient_discharges_latest_FY_in_reporting =
			
			
			var latest_reporting_month = calculate(max(REF_Date_Ref[financial_month]),REF_Date_Ref[Reporting_Month_Flag] = 1,all(REF_Date_Ref))
			var latest_financial_year_order_in_range = calculate(max(REF_Date_Ref[Date_Order_Financial_Year]),all(REF_Date_Ref))
			
			return
			
			calculate([Number of IP discharges],REF_Date_Ref[financial_month] <= latest_reporting_month,REF_Date_Ref[Date_Order_Financial_Year] = latest_financial_year_order_in_range -1 ,all(REF_Date_Ref)
			)
		formatString: 0
		displayFolder: Current IP Discharges FY vs Last FY Card Measures
		lineageTag: 127da2fb-b361-4aca-9d29-8325675c1415

	measure Number_of_inpatient_discharges_current_FY_in_reporting = ```
			
			
			var latest_reporting_month = calculate(max(REF_Date_Ref[financial_month]),REF_Date_Ref[Reporting_Month_Flag] = 1,all(REF_Date_Ref))
			var latest_financial_year_order_in_range = calculate(max(REF_Date_Ref[Date_Order_Financial_Year]),all(REF_Date_Ref))
			Var final_calc = calculate([Number of IP discharges],REF_Date_Ref[financial_month] <= latest_reporting_month,REF_Date_Ref[Date_Order_Financial_Year] = latest_financial_year_order_in_range,all(REF_Date_Ref)
			)
			
			return
			
			if(isblank(final_calc),0,final_calc)
			
			
			```
		formatString: 0
		displayFolder: Current IP Discharges FY vs Last FY Card Measures
		lineageTag: 22267a71-8745-4d2c-89b3-ba0387c51970

	measure Number_of_discharges_%_variance_current_reporting_period_current_FY_Vs_Previous = ([Number_of_inpatient_discharges_current_FY_in_reporting] - [Number_of_inpatient_discharges_latest_FY_in_reporting])/[Number_of_inpatient_discharges_latest_FY_in_reporting]
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Current IP Discharges FY vs Last FY Card Measures
		lineageTag: 62c7712f-8df5-4613-b7c6-247c83749f3a

	measure Number_of_discharges_%_variance_current_reporting_period_current_FY_Vs_Previous_Arrow = ```
			
			    IF(
			        [Number_of_discharges_%_variance_current_reporting_period_current_FY_Vs_Previous] > 0, UNICHAR(9650),
			        IF(
			            [Number_of_discharges_%_variance_current_reporting_period_current_FY_Vs_Previous] < 0, UNICHAR(9660), 
			            ""
			        )
			    )
			```
		displayFolder: Current IP Discharges FY vs Last FY Card Measures
		lineageTag: 0f8521ed-b38f-4ae5-948c-6d4d6cae63ef

	measure Number_of_discharges_%_variance_current_reporting_period_current_FY_Vs_Previous_Arrow_Colour = ```
			
			    IF([Number_of_discharges_%_variance_current_reporting_period_current_FY_Vs_Previous] > 0, "Green",
			        IF([Number_of_discharges_%_variance_current_reporting_period_current_FY_Vs_Previous] < 0, "Red", BLANK())
			    )
			```
		displayFolder: Current IP Discharges FY vs Last FY Card Measures
		lineageTag: b3a9cb21-19e4-48da-8a45-a93fa4e0f68a

	measure Average_LoS_of_inpatient_discharges_current_FY_in_reporting =
			
			
			var latest_reporting_month = calculate(max(REF_Date_Ref[financial_month]),REF_Date_Ref[Reporting_Month_Flag] = 1,all(REF_Date_Ref))
			var latest_financial_year_order_in_range = calculate(max(REF_Date_Ref[Date_Order_Financial_Year]),all(REF_Date_Ref))
			var final_calc = calculate([Average_LoS],REF_Date_Ref[financial_month] <= latest_reporting_month,REF_Date_Ref[Date_Order_Financial_Year] = latest_financial_year_order_in_range,all(REF_Date_Ref)
			)
			return
			final_calc
		formatString: 0.0
		lineageTag: d4906196-1f2d-4561-899d-e2c980d8cb70

	measure Average_LoS_of_inpatient_discharges_previous_FY_in_reporting =
			
			
			var latest_reporting_month = calculate(max(REF_Date_Ref[financial_month]),REF_Date_Ref[Reporting_Month_Flag] = 1,all(REF_Date_Ref))
			var latest_financial_year_order_in_range = calculate(max(REF_Date_Ref[Date_Order_Financial_Year]),all(REF_Date_Ref))
			
			return
			
			calculate([Average_LoS],REF_Date_Ref[financial_month] <= latest_reporting_month,REF_Date_Ref[Date_Order_Financial_Year] = latest_financial_year_order_in_range -1,all(REF_Date_Ref)
			)
		lineageTag: 607ee622-051b-4a41-b36b-48f94a937ec5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Average_LoS_%_variance_current_reporting_period_current_FY_Vs_Previous = ```
			
			 
			 VAR final_calc = ([Average_LoS_of_inpatient_discharges_current_FY_in_reporting] - [Average_LoS_of_inpatient_discharges_previous_FY_in_reporting])/[Average_LoS_of_inpatient_discharges_previous_FY_in_reporting]
			
			 RETURN 
			final_calc
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 7910329f-78ab-4944-86e8-79b26db4d219

	measure Average_LoS_%_variance_current_reporting_period_current_FY_Vs_Previous_Arrow = ```
			
			    IF(
			        [Average_LoS_%_variance_current_reporting_period_current_FY_Vs_Previous] > 0, UNICHAR(9650),
			        IF(
			            [Average_LoS_%_variance_current_reporting_period_current_FY_Vs_Previous] < 0, UNICHAR(9660), 
			            ""   )
			    )
			```
		lineageTag: 6e32757e-c3ad-4568-80bb-42b6c31c44f5

	measure Average_LoS_%_variance_current_reporting_period_current_FY_Vs_Previous_Arrow_Colour = ```
			
			    IF([Average_LoS_%_variance_current_reporting_period_current_FY_Vs_Previous] > 0, "Orange",
			        IF([Average_LoS_%_variance_current_reporting_period_current_FY_Vs_Previous] < 0, "Green", BLANK())
			    )
			```
		lineageTag: b2bca6c8-4504-42b8-8f74-4dd72d25b241

	measure Average_LoS_of_inpatient_discharges_up_to_latest_reporting_month =
			
			
			var latest_reporting_month = calculate(max(REF_Date_Ref[financial_month]),REF_Date_Ref[Reporting_Month_Flag] = 1,all(REF_Date_Ref))
			
			var final_calc = calculate([Average_LoS],REF_Date_Ref[financial_month] <= latest_reporting_month
			)
			return
			final_calc
		lineageTag: 3c05a512-f22f-4892-8c5b-75fae1816627

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total discharged patients bed days' = sum('4.Inpatient Discharges'[LoS_of_Admission])
		formatString: #,0
		lineageTag: c663f0fa-055a-4571-9ab2-5ed0cd66c80c

