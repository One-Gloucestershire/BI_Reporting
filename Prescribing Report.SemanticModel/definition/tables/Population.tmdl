	partition Population-b5c5c83e-0f3d-44b2-92d8-4774c148a6fb = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "select practice_code as ""OrganisationCode"", case when practice_name='Acorn Practice' then 'May Lane Surgery' when practice_name='Regent Street Surgery' then 'The Willow Tree Practice' when practice_name='Coleford Family Doctors' then 'Coleford Medical Practice' else practice_name end as ""OrganisationName"", primary_care_network as ""PrimaryCareNetwork"", place as ""Place"", case when locality in ('North Cotswolds','South Cotswolds') then 'Cotswolds' else locality end as ""Locality"", census_date as ""CensusDate"", 'All' as ""AgeGroupType"", sum(population) as ""Total"", year_month as ""YearMonth"", census_date as ""Year-MonthName"" from data_mart_primarycare.tbl01_gp_practice_populations where to_date(census_date,'Mon-YYYY')=(select max(to_date(census_date,'Mon-YYYY')) from data_mart_primarycare.tbl01_gp_practice_populations) group by practice_code, practice_name, primary_care_network, place, locality, census_date, year_month", null, [EnableFolding=true]),
