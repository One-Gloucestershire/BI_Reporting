	measure '% of DOACs as Apixaban or Rivaroxaban' =
			
			
			VAR _NUMERATOR =
			
			CALCULATE(
			    SUM('EPACT'[Items]),
			    LEFT('EPACT'[BNFPresentationCode], 9) = "698090000"
			        && MID('EPACT'[BNFPresentationCode], 10, 2) <> "AA"
			)
			
			RETURN
			
			_NUMERATOR
		formatString: 0
		lineageTag: 24f91956-767a-4598-b24d-65f8a499ea4b

	measure '% 5 Day Doxycycline 100mg 6 Capsules' = ```
			
			
			VAR _NUMERATOR = 
			
			CALCULATE(
			    SUM('EPACT'[Items]),
			    LEFT('EPACT'[BNFPresentationCode], 9) = "0501030I0" && RIGHT ('EPACT'[BNFPresentationCode], 2) = "AB"
			    || LEFT('EPACT'[BNFPresentationCode], 9) = "0501030Z0" && RIGHT ('EPACT'[BNFPresentationCode], 2) = "AB",
			    'EPACT'[QuantityXItems] > 6
			)
			
			VAR _DENOMINATOR = 
			
			CALCULATE(
			    SUM('EPACT'[Items]),
			    LEFT('EPACT'[BNFPresentationCode], 9) = "0501030I0" && RIGHT ('EPACT'[BNFPresentationCode], 2) = "AB"
			    || LEFT('EPACT'[BNFPresentationCode], 9) = "0501030Z0" && RIGHT ('EPACT'[BNFPresentationCode], 2) = "AB"
			)
			
			RETURN
			
			_NUMERATOR / _DENOMINATOR
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 2c697aad-7184-415d-b60d-f834176f83ba

