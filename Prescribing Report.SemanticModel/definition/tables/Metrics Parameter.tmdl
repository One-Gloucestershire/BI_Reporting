	measure 'Metrics Parameters - Bar Colours' =
			
			
			VAR _SELECTION = MAX('Metrics Parameter'[Metrics Parameter])
			
			RETURN
			
			SWITCH(
			    TRUE(),
			    CONTAINSSTRING(_SELECTION, "Rate per 1,000 Costs") && [Metrics Parameter - Values] >= [Metrics Parameter ICB], "#749A54",
			    CONTAINSSTRING(_SELECTION, "YTD Costs Growth") && [Metrics Parameter - Values] >= [Metrics Parameter ICB], "#749A54",
			    CONTAINSSTRING(_SELECTION, "YTD Items Growth") && [Metrics Parameter - Values] >= [Metrics Parameter ICB], "#749A54",
			    CONTAINSSTRING(_SELECTION, "% Sitagliptin of Gliptins") && [Metrics Parameter - Values] >= [Metrics Parameter Target - Bars], "#749A54", -- TARGET BASED
			    CONTAINSSTRING(_SELECTION, "% Colecalciferol Valupak Brand") && [Metrics Parameter - Values] >= [Metrics Parameter Target - Bars], "#749A54", -- TARGET BASED
			
			    CONTAINSSTRING(_SELECTION, "% Amoxicillin 15 Capsules") && [Metrics Parameter - Values] >= [Metrics Parameter Target - Bars], "#749A54", -- TARGET BASED
			    CONTAINSSTRING(_SELECTION, "% 5 Day Doxycycline 100mg 6 Capsules") && [Metrics Parameter - Values] >= [Metrics Parameter Target - Bars], "#749A54", -- TARGET BASED
			    "#EF5B5B"
			)
		lineageTag: 1dac8699-9d93-4376-a342-4d98ad6341c0

	measure 'Metrics Parameter Target - Bars' =
			
			
			VAR _SELECTION = MAX('Metrics Parameter'[Metrics Parameter])
			
			RETURN
			
			IF(CONTAINSSTRING(_SELECTION, "Rate per 1,000 Costs"), [Rate per 1,000 Costs - ICB],
			IF(CONTAINSSTRING(_SELECTION, "YTD Costs Growth"), [YTD Costs Growth - ICB],
			IF(CONTAINSSTRING(_SELECTION, "YTD Items Growth"), [YTD Items Growth - ICB],
			IF(CONTAINSSTRING(_SELECTION, "% Sitagliptin of Gliptins"), 0.8,
			IF(CONTAINSSTRING(_SELECTION, "% Colecalciferol Valupak Brand"), 0.8,
			IF(CONTAINSSTRING(_SELECTION, "% Switched to Fobumix"), [Fostair MDI to Fobumix - ICB],
			IF(CONTAINSSTRING(_SELECTION, "% Amoxicillin 15 Capsules"), 0.6,
			IF(CONTAINSSTRING(_SELECTION, "% 5 Day Doxycycline 100mg 6 Capsules"), 0.6,
			BLANK()
			))))))))
