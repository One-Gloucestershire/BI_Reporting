	measure 'Metrics Parameter LCL' = ```
			
			
			VAR _SELECTION = MAX('Metrics Parameter'[Metrics Parameter])
			
			VAR _IF =
			
			IF(CONTAINSSTRING(_SELECTION, "Rate per 1,000 Costs"), 
			[Rate per 1,000 Costs - Mean] - (3*[Rate per 1,000 Costs - STD DEV]),
			IF(CONTAINSSTRING(_SELECTION, "YTD Costs Growth"), 
			[YTD Costs Growth - Mean] - (3*[YTD Costs Growth - STD DEV]),
			IF(CONTAINSSTRING(_SELECTION, "YTD Items Growth"),
			[YTD Items Growth - Mean] - (3*[YTD Items Growth - STD DEV]),
			IF(CONTAINSSTRING(_SELECTION, "% Apixaban Growth"),
			[% Apixaban Growth - Mean] - (3*[% Apixaban Growth - STD DEV]),
			IF(CONTAINSSTRING(_SELECTION, "% Sitagliptin Growth"),
			BLANK(),
			IF(CONTAINSSTRING(_SELECTION, "% Colecalciferol Valupak Brand"),
			BLANK(),
			IF(CONTAINSSTRING(_SELECTION, "% Formulary Needles"),
			[% Formulary Needles - Mean] - (3*[% Formulary Needles - STD DEV]),
			IF(CONTAINSSTRING(_SELECTION, "% Melatonin Ceyesto Liquid"),
			BLANK(),
			IF(CONTAINSSTRING(_SELECTION, "% Swtiched to Fobumix"),
			BLANK(),
			IF(CONTAINSSTRING(_SELECTION, "% Amoxicillin 15 Capsules"),
			[% Amoxicillin 15 Capsules - Mean] - (3*[% Amoxicillin 15 Capsules - STD DEV]),
			BLANK()
			))))))))))
			
			RETURN
			
			_IF
			```
