table 'Metrics Parameter'
	lineageTag: d0e70855-31d9-4a10-8652-17f9b3b523d0

	measure 'Metrics Parameter Mean' = ```
			
			
			VAR _SELECTION = MAX('Metrics Parameter'[Metrics Parameter])
			
			RETURN
			
			IF(CONTAINSSTRING(_SELECTION, "Rate per 1,000 Costs"), [Rate per 1,000 Costs - Mean],
			IF(CONTAINSSTRING(_SELECTION, "YTD Costs Growth"), [YTD Costs Growth - Mean],
			IF(CONTAINSSTRING(_SELECTION, "YTD Items Growth"), [YTD Items Growth - Mean],
			IF(CONTAINSSTRING(_SELECTION, "% Sitagliptin of Gliptins"), [% Sitagliptin of Gliptins - Mean],
			IF(CONTAINSSTRING(_SELECTION, "% Colecalciferol Valupak Brand"), [% Colecalciferol Valupak Brand - Mean],
			IF(CONTAINSSTRING(_SELECTION, "% Switched to Fobumix"), [Fostair MDI to Fobumix - Mean], 
			IF(CONTAINSSTRING(_SELECTION, "% Amoxicillin 15 Capsules"), [% Amoxicillin 15 Capsules - Mean],
			IF(CONTAINSSTRING(_SELECTION, "% 5 Day Doxycycline 100mg 6 Capsules"), [% 5 Day Doxycycline 100mg 6 Capsules - Mean],
			BLANK()
			))))))))
			```
		lineageTag: bc72e5d2-a6b6-4c32-8d0e-86aa3ddd2ad4

		formatStringDefinition =
				VAR _STRING = MAX('Metrics Parameter'[Metrics Parameter])
				
				RETURN
				
				IF(CONTAINSSTRING(_STRING, "Rate per 1,000 Costs"), "£,0.00;-£,0.00","0.0%;-0.0%;0.0%")

	measure 'Metrics Parameter UCL' = ```
			
			
			VAR _SELECTION = MAX('Metrics Parameter'[Metrics Parameter])
			
			RETURN
			
			IF(CONTAINSSTRING(_SELECTION, "Rate per 1,000 Costs"), 
			[Rate per 1,000 Costs - Mean] + (3*[Rate per 1,000 Costs - STD DEV]),
			IF(CONTAINSSTRING(_SELECTION, "YTD Costs Growth"), 
			[YTD Costs Growth - Mean] + (3*[YTD Costs Growth - STD DEV]),
			IF(CONTAINSSTRING(_SELECTION, "YTD Items Growth"),
			[YTD Items Growth - Mean] + (3*[YTD Items Growth - STD DEV]),
			IF(CONTAINSSTRING(_SELECTION, "% Apixaban Growth"),
			[% Apixaban Growth - Mean] + (3*[% Apixaban Growth - STD DEV]),
			IF(CONTAINSSTRING(_SELECTION, "% Sitagliptin Growth"),
			BLANK(),
			IF(CONTAINSSTRING(_SELECTION, "% Colecalciferol Valupak Brand"),
			BLANK(),
			IF(CONTAINSSTRING(_SELECTION, "% Melatonin Ceyesto Liquid"),
			BLANK(),
			 IF(CONTAINSSTRING(_SELECTION, "% Swtiched to Fobumix"),
			BLANK(),
			 IF(CONTAINSSTRING(_SELECTION, "% Amoxicillin 15 Capsules"),
			 [% Amoxicillin 15 Capsules - Mean] + (3*[% Amoxicillin 15 Capsules - STD DEV]),
			 IF(CONTAINSSTRING(_SELECTION, "% Formulary Needles"),
			[% Formulary Needles - Mean] + (3*[% Formulary Needles - STD DEV]),
			 BLANK()
			))))))))))
			```
