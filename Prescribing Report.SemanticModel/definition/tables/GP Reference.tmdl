	partition 'GP Reference' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Reference", [Query="WITH PRACTICE_CTE AS#(lf)(#(lf)SELECT [Locality] = CASE WHEN [Locality] = 'Tewkesbury Newent and Staunton' THEN 'Tewkesbury'#(lf)                         WHEN [ReportingOrganisationName] = 'West Cheltenham Medical' THEN 'Tewkesbury'#(lf)#(tab)#(tab)     ELSE [Locality] END#(lf)      ,[PrimaryCareNetwork] = CASE WHEN [PrimaryCareNetwork] = 'Tewkesbury, Newent and Staunton and West Cheltenham Medical' THEN 'TWNS'#(lf)                                   WHEN [ReportingOrganisationName] = 'West Cheltenham Medical' THEN 'TWNS'#(lf)                                   ELSE [PrimaryCareNetwork] END#(lf)      ,[OrganisationCode]#(lf)      ,[ReportingOrganisationCode] = CASE WHEN [ReportingOrganisationCode] = 'L84073' THEN 'L84075' /* Acorn Practice merged into May Lane Surgery */#(lf)                                          WHEN [ReportingOrganisationCode] = 'L84017' THEN 'L84018' /* St. Peter's Road Surgery merged into Cirencester Health Group*/#(lf)#(tab)#(tab)#(tab)#(tab)  WHEN [ReportingOrganisationCode] = 'L84069' THEN 'L84029' /* Brunston Practice merged into Coleford Family Doctors, then merged into Dean Medical Practice' */#(lf)                                          ELSE [ReportingOrganisationCode] END#(lf)      ,[ReportingOrganisationName] = CASE WHEN [ReportingOrganisationCode] = 'L84073' THEN 'May Lane Surgery' /* Acorn Practice merged into May Lane Surgery */#(lf)                                          WHEN [ReportingOrganisationCode] = 'L84069' THEN 'Dean Medical Practice' /* Brunston Practice merged into Coleford Family Doctors, then merged into Dean Medical Practice' */#(lf)#(tab)#(tab)#(tab)#(tab)  WHEN [ReportingOrganisationCode] = 'L84052' THEN 'Severnside Medical Practice' /* Gloucester City Health Centre now Severnside Medical Practice */#(lf)#(tab)#(tab)#(tab)#(tab)  WHEN [ReportingOrganisationCode] ='L84080' THEN 'The Willow Tree Practice' /* Code is The Willow Tree Practice */#(lf)                                          ELSE [ReportingOrganisationname] END#(lf)#(lf)FROM [CCG_Reference].[Reference].[vw_GPPractice]#(lf)#(lf)WHERE [Commissioner] = '11M'#(lf)AND [Locality] IS NOT NULL#(lf))#(lf)SELECT [GP].*#(lf)      ,[COORD].[GPLatitude]#(lf)      ,[COORD].[GPLongitude]#(lf)#(lf)FROM PRACTICE_CTE AS [GP]#(lf)#(lf)LEFT JOIN (#(lf)           SELECT DISTINCT [GP_Practice_Code]#(lf)#(tab)                ,[GPLatitude]#(lf)#(tab)#(tab)      ,[GPLongitude]#(lf)#(tab) FROM [PowerBI_Reporting].[PHM].[tbl02_DemographicsOverview]#(lf)          ) AS [COORD]#(lf)ON [COORD].[GP_Practice_Code] = [GP].[ReportingOrganisationCode]"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

