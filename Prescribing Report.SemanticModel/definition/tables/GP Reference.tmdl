	partition 'GP Reference' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "select case when g.locality='Tewkesbury Newent and Staunton' then 'Tewkesbury' when g.reportingorganisationname='West Cheltenham Medical' then 'Tewkesbury' else g.locality end as ""Locality"", case when g.primarycarenetwork='Tewkesbury, Newent and Staunton and West Cheltenham Medical' then 'TWNS' when g.reportingorganisationname='West Cheltenham Medical' then 'TWNS' else g.primarycarenetwork end as ""PrimaryCareNetwork"", g.organisationcode as ""OrganisationCode"", case when g.reportingorganisationcode='L84073' then 'L84075' when g.reportingorganisationcode='L84017' then 'L84018' when g.reportingorganisationcode='L84069' then 'L84029' else g.reportingorganisationcode end as ""ReportingOrganisationCode"", case when g.reportingorganisationcode='L84073' then 'May Lane Surgery' when g.reportingorganisationcode='L84069' then 'Dean Medical Practice' when g.reportingorganisationcode='L84052' then 'Severnside Medical Practice' when g.reportingorganisationcode='L84080' then 'The Willow Tree Practice' else g.reportingorganisationname end as ""ReportingOrganisationName"", c.gp_latitude as ""GPLatitude"", c.gp_longitude as ""GPLongitude"" from db01_reference.icb_data_reference.vw_gppractice g left join (select distinct practice_code, gp_latitude, gp_longitude from data_mart_primarycare.tbl01_gp_practice_populations) c on c.practice_code=g.reportingorganisationcode where g.commissioner='11M' and g.locality is not null", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

