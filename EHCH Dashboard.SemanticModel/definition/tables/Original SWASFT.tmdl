	partition 'Original SWASFT-076c1f81-ec8e-42a7-ab27-9442e2207d60' = m
		mode: import
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "BIreports", [Query="--SWASFT Care Home Data + link to acute--#(lf)/****** Script for SelectTopNRows command from SSMS  ******/#(lf)SET ANSI_NULLS ON#(lf)SET QUOTED_IDENTIFIER ON#(lf)set nocount on#(lf)set ansi_warnings off #(lf)#(lf)set dateformat dmy#(lf)#(lf)IF OBJECT_ID('tempdb..#AllData') IS NOT NULL#(lf)    DROP TABLE #AllData#(lf)#(lf)IF OBJECT_ID('tempdb..#AllData2') IS NOT NULL#(lf)    DROP TABLE #AllData2#(lf)#(lf)#(tab)IF OBJECT_ID('tempdb..#AllData3') IS NOT NULL#(lf)    DROP TABLE #AllData3#(lf)#(lf)--SWASFT Data (patient)#(lf)SELECT#(lf)--Patient data#(lf)     [NHS Number] = [Derived_Pseudo_NHSNumber]#(lf)#(tab),[Incident_Number]#(lf)#(tab),[Acute Distinct] =  row_number() over(partition by [Incident_Number] order by #(lf)#(tab)isnull(isnull(datediff(hh,time_of_handover_at_first_hospital_attended,ed.arrivaldate),datediff(dd,time_of_handover_at_first_hospital_attended,ad.startdate_hospitalproviderspell)),1) asc,#(lf)#(tab)case when a.[First_Hospital_Attended] = isnull(ed.OrganisationCode_CodeOfProvider,ad.OrganisationCode_CodeOfProvider) then 1 else 0 end desc)#(lf)--Dates/times of SWASFT activity#(lf),[SWASFT Call Time] = case when cast(t0_time_of_call as time) between '00:00:00.0000000' and '00:59:59.0000000' then '00'#(lf)when cast(t0_time_of_call as time) between '01:00:00.0000000' and '01:59:59.0000000' then '01'#(lf)when cast(t0_time_of_call as time) between '02:00:00.0000000' and '02:59:59.0000000' then '02'#(lf)when cast(t0_time_of_call as time) between '03:00:00.0000000' and '03:59:59.0000000' then '03'#(lf)when cast(t0_time_of_call as time) between '04:00:00.0000000' and '04:59:59.0000000' then '04'#(lf)when cast(t0_time_of_call as time) between '05:00:00.0000000' and '05:59:59.0000000' then '05'#(lf)when cast(t0_time_of_call as time) between '06:00:00.0000000' and '06:59:59.0000000' then '06'#(lf)when cast(t0_time_of_call as time) between '07:00:00.0000000' and '07:59:59.0000000' then '07'#(lf)when cast(t0_time_of_call as time) between '08:00:00.0000000' and '08:59:59.0000000' then '08'#(lf)when cast(t0_time_of_call as time) between '09:00:00.0000000' and '09:59:59.0000000' then '09'#(lf)when cast(t0_time_of_call as time) between '10:00:00.0000000' and '10:59:59.0000000' then '10'#(lf)when cast(t0_time_of_call as time) between '11:00:00.0000000' and '11:59:59.0000000' then '11'#(lf)when cast(t0_time_of_call as time) between '12:00:00.0000000' and '12:59:59.0000000' then '12'#(lf)when cast(t0_time_of_call as time) between '13:00:00.0000000' and '13:59:59.0000000' then '13'#(lf)when cast(t0_time_of_call as time) between '14:00:00.0000000' and '14:59:59.0000000' then '14'#(lf)when cast(t0_time_of_call as time) between '15:00:00.0000000' and '15:59:59.0000000' then '15'#(lf)when cast(t0_time_of_call as time) between '16:00:00.0000000' and '16:59:59.0000000' then '16'#(lf)when cast(t0_time_of_call as time) between '17:00:00.0000000' and '17:59:59.0000000' then '17'#(lf)when cast(t0_time_of_call as time) between '18:00:00.0000000' and '18:59:59.0000000' then '18'#(lf)when cast(t0_time_of_call as time) between '19:00:00.0000000' and '19:59:59.0000000' then '19'#(lf)when cast(t0_time_of_call as time) between '20:00:00.0000000' and '20:59:59.0000000' then '20'#(lf)when cast(t0_time_of_call as time) between '21:00:00.0000000' and '21:59:59.0000000' then '21'#(lf)when cast(t0_time_of_call as time) between '22:00:00.0000000' and '22:59:59.0000000' then '22'#(lf)when cast(t0_time_of_call as time) between '23:00:00.0000000' and '23:59:59.0000000' then '23'#(lf)else null end #(lf)#(tab),[SWASFT Month Number] = FinancialMonth#(lf)#(tab),[SWASFT Month - Short] = #(lf)#(tab)case when b.monthname = 'April' then 'Apr'#(lf)#(tab)        when b.monthname = 'May' then 'May'#(lf)#(tab)#(tab)#(tab)when b.monthname = 'June' then 'Jun'#(lf)#(tab)#(tab)#(tab)when b.monthname = 'July' then 'Jul'#(lf)#(tab)#(tab)#(tab)when b.monthname = 'August' then 'Aug'#(lf)#(tab)#(tab)#(tab)when b.monthname = 'September' then 'Sep'#(lf)#(tab)#(tab)#(tab)when b.monthname = 'October' then 'Oct'#(lf)#(tab)#(tab)#(tab)when b.monthname = 'November' then 'Nov'#(lf)#(tab)#(tab)#(tab)when b.monthname = 'December' then 'Dec'#(lf)#(tab)#(tab)#(tab)when b.monthname = 'January' then 'Jan'#(lf)#(tab)#(tab)#(tab)when b.monthname = 'February' then 'Feb'#(lf)#(tab)#(tab)#(tab)when b.monthname = 'March' then 'Mar'#(lf)#(tab)#(tab)#(tab)else b.monthname end#(lf)#(tab)#(tab)#(tab),[SWASFT Day of Week] = WeekDayName#(lf)#(tab)  ,[SWASFT Financial Year] = [b].financialyear#(lf)      ,[DateTime of Incident] = [Time_Of_Incident]#(lf)#(tab)  ,[Date of Incident] = cast([Time_Of_Incident] as date)#(lf)#(tab)  --SWASFT Diagnosis#(lf)      ,[Symptom_Group_Chief_Complaint_grouped] = case#(lf)when symptom_group_chief_complaint like '%abdo%' then 'Abdo Pain/Problems'#(lf)when symptom_group_chief_complaint like'Allerg%' then 'Allergy/Envenomations'#(lf)when symptom_group_chief_complaint like '%cardiac%' then 'Cardiac/Respiratory Arrest'#(lf)when symptom_group_chief_complaint like '%Fall%' then 'Falls'#(lf)when symptom_group_chief_complaint like '%assault%' then 'Assault/Domestic/Sexual Assault'#(lf)when symptom_group_chief_complaint like '%back pain%' then 'Back Pain'#(lf)when symptom_group_chief_complaint like '%building fire%' then 'Building Fire, persons reported'#(lf)when symptom_group_chief_complaint like '%drown%' then 'Drowning'#(lf)when symptom_group_chief_complaint like '%overdose%' then 'Overdose/Poisoning'#(lf)when symptom_group_chief_complaint like '%psyc%' then 'Mental Health'#(lf)when symptom_group_chief_complaint like '%unconscious%' then 'Unconscious'#(lf)when symptom_group_chief_complaint like '%COVID%' then 'COVID'#(lf)when symptom_group_chief_complaint like '%Escalation%' then 'Cat Escalation'#(lf)when symptom_group_chief_complaint like '%111%' then '111 Referred'#(lf)when symptom_group_chief_complaint like '%hcp adm%' then 'HCP Admission'#(lf)when symptom_group_chief_complaint like '%trauma%' and symptom_group_chief_complaint not like '%chest pain%'then 'Trauma/Traumatic Injuries'#(lf)when symptom_group_chief_complaint like '%pregnan%' or symptom_group_chief_complaint like '%maternity%' then 'Maternity'#(lf)else  symptom_group_chief_complaint  end#(lf),symptom_group_chief_complaint#(lf)#(tab)  --SWASFT Categories#(lf)      ,[Incident_Colour]#(lf)#(tab)  ,[Category Flag] = #(tab)  #(lf)#(tab)  case#(tab)#(lf)#(tab)#(tab)when incident_colour = 'Category 1' then 'Category 1'#(lf)#(tab)#(tab)when incident_colour = 'Category 2' then 'Category 2'#(lf)#(tab)#(tab)when incident_colour in ('Category 3','IFT Level 3','HCP Level 3') then 'Category 3'#(lf)#(tab)#(tab)when incident_colour in ('Category 4','Category 4 999','Category 4 HCP','Category 4 HCP 060','Category 4 HCP 120','Category 4 HCP 240','IFT Level 4','HCP Level 4') then 'Category 4'#(lf)#(tab)#(tab)when incident_colour = 'Category 5' then  'Category 5'#(lf)#(tab)#(tab)else 'Unknown' #(lf)#(tab)end#(lf)#(tab)--Outcome of call#(lf)      ,[Outcome]#(lf)      ,[Conveyed_To_Ward_Type]#(lf)      ,[First_Hospital_Attended]#(lf)      ,[First_Ward_Attended]#(lf)      ,[Time_of_Handover_at_First_Hospital_Attended]#(lf)      ,[First_MIU_Attended]#(lf)#(tab)  --Care home category#(lf)      ,[Residential_or_Nursing_home_Location]#(lf)      ,[Residential_or_Nursing_home_Location_Name]#(lf)#(tab)  ,[Care Home Name] = d.[CQC Name]#(lf)#(tab)  ,[Number of Beds] = isnull(CAST(d.[CQC Beds] AS int),cast(d.[Capacity Tracker Beds] as int)) #(lf)#(tab)  ,[Care Home Type] =   case #(lf)when d.[Broad Type (confirmed)] = 'LD' then 'Learning Disability Home' #(lf)when d.[Broad Type (confirmed)] = 'Residential' then 'Residential Care Home' #(lf)when d.[Broad Type (confirmed)] = 'Nursing' then 'Nursing Home' #(lf)ELSE d.[Broad Type (confirmed)] #(lf)end#(lf)#(tab)--Location#(lf)      ,[Local_Authority]#(lf)      ,[Ward]#(lf)#(tab)  --A&E#(lf)#(tab)  ,[ED Arrival Date Time] = DATEADD(DAY,DATEDIFF(DAY, 0, [ed].arrivaldate),CAST([ed].ArrivalTime AS DATETIME))#(lf)#(tab)  ,[ED Flag] = case when ed.ArrivalDate is not null then 1 else 0 end#(lf)#(tab)  ,[Avoidable ED Conveyance] = case when ed.Derived_Current_EM_HRG = 'VB11Z' then 1 else 0 end --No investigations or treatments done#(lf)#(tab)  --Admission#(lf)#(tab)  ,[Admission Arrival Date Time] = [ad].StartDate_HospitalProviderSpell#(lf)#(tab)  ,[Admission Flag] = case when [ad].StartDate_HospitalProviderSpell is not null then 1 #(lf)#(tab)  when ed.AEattendanceDisposal = '01' then 1 else 0 end#(lf)#(tab)  ,[Admission Diagnosis] = ad.DiagnosisPrimary_ICD_Description#(lf)   INTO #AllData#(lf)  FROM [CCG_Current].[SWASFT].[vw_AmbulanceServicePatient] as a #(lf)#(tab)   left join [CCG_Reference].[Reference].[vw_DateLookup] as b on cast(a.time_of_incident as date) = b.[Date]#(lf)left join bireports.dbo.Care_Home_Mapping_May23 d on a.Residential_or_Nursing_home_Location_Name = d.[SWASFT Name] --and d.[Capacity Tracker Beds] != 'NULL'#(lf)#(tab)   left join ccg_current.sem.vw_EDAttendance [ed] on #(lf)#(tab)   a.Derived_Pseudo_NHSNumber = ed.Derived_Pseudo_NHS and #(lf)#(tab)   --case when a.First_Hospital_Attended = 'RTQ88' then 'RTE'#(lf)#(tab)   --when a.First_Hospital_Attended = 'RTQ03' then 'RTE' #(lf)#(tab)   --when a.First_Hospital_Attended = 'RVNCD' then 'RN3' else#(lf)#(tab)   --left(First_Hospital_Attended,3) end = left(ed.OrganisationCode_CodeOfProvider,3) and#(lf)#(tab)   datediff(hh,time_of_handover_at_first_hospital_attended, DATEADD(DAY,DATEDIFF(DAY, 0, [ed].arrivaldate),CAST([ed].ArrivalTime AS DATETIME))) between -12 and 12 and#(lf)#(tab)   Conveyed_To_Ward_Type is not null and #(lf)#(tab)   ed.AEarrivalMode = '1'#(lf)#(tab)   left join ccg_current.sem.vw_HospitalProviderSpell [ad] on #(lf)#(tab)   a.Derived_Pseudo_NHSNumber = [ad].Derived_Pseudo_NHS and #(lf)#(tab)   --case when a.First_Hospital_Attended = 'RTQ88' then 'RTE'#(lf)#(tab)   --when a.First_Hospital_Attended = 'RTQ03' then 'RTE' #(lf)#(tab)   --when a.First_Hospital_Attended = 'RVNCD' then 'RN3' else#(lf)#(tab)   --left(First_Hospital_Attended,3) end = left([ad].OrganisationCode_CodeOfProvider,3) and#(lf)#(tab)   datediff(dd,time_of_handover_at_first_hospital_attended, [ad].StartDate_HospitalProviderSpell) in (0,1) and#(lf)#(tab)   Conveyed_To_Ward_Type is not null#(lf)#(lf)#(tab)   where Residential_or_Nursing_home_Location is not null#(lf)#(tab)   and CCG = '11M'#(lf)#(lf)#(tab)   UNION#(lf)--SWASFT Data (NON PATIENT)#(lf)#(tab)   SELECT#(lf)--Patient data#(lf)     NULL AS [Derived_Pseudo_NHSNumber]#(lf)#(tab),[IncidentNumber]#(lf)#(tab),[Acute Distinct] = 1-- row_number() over(partition by [IncidentNumber] order by ed.arrivaldate)#(lf)--Dates/times of SWASFT activity#(lf),[SWASFT Call Time] = case when cast(t0_time_of_call as time) between '00:00:00.0000000' and '00:59:59.0000000' then '00'#(lf)when cast(t0_time_of_call as time) between '01:00:00.0000000' and '01:59:59.0000000' then '01'#(lf)when cast(t0_time_of_call as time) between '02:00:00.0000000' and '02:59:59.0000000' then '02'#(lf)when cast(t0_time_of_call as time) between '03:00:00.0000000' and '03:59:59.0000000' then '03'#(lf)when cast(t0_time_of_call as time) between '04:00:00.0000000' and '04:59:59.0000000' then '04'#(lf)when cast(t0_time_of_call as time) between '05:00:00.0000000' and '05:59:59.0000000' then '05'#(lf)when cast(t0_time_of_call as time) between '06:00:00.0000000' and '06:59:59.0000000' then '06'#(lf)when cast(t0_time_of_call as time) between '07:00:00.0000000' and '07:59:59.0000000' then '07'#(lf)when cast(t0_time_of_call as time) between '08:00:00.0000000' and '08:59:59.0000000' then '08'#(lf)when cast(t0_time_of_call as time) between '09:00:00.0000000' and '09:59:59.0000000' then '09'#(lf)when cast(t0_time_of_call as time) between '10:00:00.0000000' and '10:59:59.0000000' then '10'#(lf)when cast(t0_time_of_call as time) between '11:00:00.0000000' and '11:59:59.0000000' then '11'#(lf)when cast(t0_time_of_call as time) between '12:0