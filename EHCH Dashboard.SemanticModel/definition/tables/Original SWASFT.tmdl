table 'Original SWASFT'
	lineageTag: e128bfcc-ce1a-4d6c-b2b8-ad87ab289e02

	measure SeeConveyPercentage = ```
			
			VAR SeeConveyTotal = 
			CALCULATE(SUM('Original SWASFT'[Counter]),
			'Original SWASFT'[Outcome] in {"See & Convey"})
			VAR SWASFTTotal = 
			CALCULATE(SUM('Original SWASFT'[Counter]))
			RETURN
			SeeConveyTotal/SWASFTTotal
			```
		formatString: 0%;-0%;0%
		lineageTag: cb7d3efd-080c-434d-b15a-bed7f210a7d9

	measure 'Small Number Suppression' = IF(SUM('Original SWASFT'[Counter])<6,0,SUM('Original SWASFT'[Counter]))
		formatString: 0
		lineageTag: 06c757c3-411e-4c61-b010-aa67d5ab1386

