areorNursingHomeLocationName = d.[SWASFT Name]-- and d.[Capacity Tracker Beds] != 'NULL'#(lf)#(tab)   --left join ccg_current.sem.vw_EDAttendance [ed] on #(lf)#(tab)   --a.Derived_Pseudo_NHSNumber = ed.Derived_Pseudo_NHS and #(lf)#(tab)   --left(First_Hospital_Attended,3) = left(ed.OrganisationCode_CodeOfProvider,3) and#(lf)#(tab)   --datediff(hh,time_of_handover_at_first_hospital_attended, DATEADD(DAY,DATEDIFF(DAY, 0, [ed].arrivaldate),CAST([ed].ArrivalTime AS DATETIME))) between -1 and 2 and#(lf)#(tab)   --a.Conveyed_To_Ward_Type = 'A&E'#(lf)#(lf)#(tab)   where CareorNursingHomeLocationName is not null#(lf)#(tab)   and CareorNursingHomeLocation <> ''#(lf)#(tab)   and CCG = 'Gloucestershire'#(lf)#(lf)#(tab)   select row_number() over(partition by [Incident_Number] order by case when [NHS Number] is not null then 1 else 2 end, [DateTime of Incident] desc, case when [Acute Distinct] = 1 then 1 else 0 end desc) as [Distinct] ,*#(lf)into #AllData2#(lf)from #AllData#(lf)#(lf)select a.*, case when [ED Flag] = 1 and [Admission Flag] = 1 then 'ED'#(lf)when [ED Flag] = 1 and [Admission Flag] = 0 then 'ED'#(lf)when [ED Flag] = 0 and [Admission Flag] = 1 then 'Admission'#(lf)else 'No Data' end as [First Activity Flag],#(lf)[YTD Flag] = #(lf)case when #(lf)dat.FinancialMonth#(lf)<= #(lf)(select#(lf)MAX(cast(dat.FinancialMonth as int))#(lf)from  [CCG_Current].[SWASFT].[vw_AmbulanceServicePatient]  SWASFT #(lf)left join ccg_reference.reference.vw_DateLookup dat on cast(SWASFT.time_of_incident as date) = dat.date#(lf)where dat.FinancialYear = (#(lf)select max(dat.financialyear) from  [CCG_Current].[SWASFT].[vw_AmbulanceServicePatient]  SWASFT #(lf)left join ccg_reference.reference.vw_DateLookup dat on cast(SWASFT.time_of_incident as date) = dat.date#(lf))#(lf))#(lf)and #(lf)dat.[Day] #(lf)<= #(lf)(select#(lf)MAX(cast(dat.[day] as int))#(lf)from  [CCG_Current].[SWASFT].[vw_AmbulanceServicePatient]  SWASFT #(lf)left join ccg_reference.reference.vw_DateLookup dat on cast(SWASFT.time