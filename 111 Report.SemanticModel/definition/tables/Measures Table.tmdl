		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 41fe4bc2-886e-4a13-9801-7e8118cdbab5

	measure '% of other provider calls' = sum('111 Data'[OOC_Flag])/sum('111 Data'[Value])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a3a6d2ff-1a54-4d9f-ad24-d57ca79169a7

	measure 'Percentage Change' = ```
			
			VAR CY = SUM('111 Data'[Value])
			VAR LY = CALCULATE(
			    sum('111 Data'[Value]),
			    DATESBETWEEN(
			        'Date Ref'[date],
			        EDATE(MIN('Date Ref'[date]),-12),
			        EOMONTH(max('111 Data'[DateOfCase]),-12)
			    )
			
			)
			VAR Check = CY  &&  LY && HASONEVALUE('Date Ref'[financial_year])
			Return 
			
			IF(Check,divide(CY,LY) -1)
			
			
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ebfbd1d1-36bc-4d67-9546-2b351f09c90f

	measure 'Last year total' =
			CALCULATE(
			    sum('111 Data'[Value]),
			    DATESBETWEEN(
			        'Date Ref'[date],
			        EDATE(MIN('Date Ref'[date]),-12),
			        EOMONTH(max('111 Data'[DateOfCase]),-12)
			    ))
		formatString: 0
		lineageTag: 9f6c1a91-cf89-4d20-8128-ed4da42127da

	measure '% Ambulance validation proportions' = SUM('111 Data'[Ambulance validations done])/SUM('111 Data'[Ambulance validations required])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8d091d55-5c2a-49bd-925f-b088f5726779

	measure '% ED validation proportions' = SUM('111 Data'[ED validations done])/SUM('111 Data'[ED validations required])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4c05cb47-4f3d-4439-894e-936d9bcbae77

	measure '% of Ambulance Redirections' = SUM('111 Data'[Ambulance Redirections])/SUM('111 Data'[Ambulance validations done])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d4e9bd5a-69ee-4cd7-90f8-fca260a6db4c

	measure '% of ED Redirections' = SUM('111 Data'[ED Redirections])/SUM('111 Data'[ED validations done])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4753c6d6-7d05-45ac-aa0d-c3d3d2ecb93e

	measure 'Total Ambulance Validations Done' = SUM('111 Data'[Ambulance validations done])
		formatString: 0
		lineageTag: d8508db3-eaff-491e-af69-e36646505e23

	measure 'Total ED Validations Done' = sum('111 Data'[ED validations done])
		formatString: 0
		lineageTag: fd92711e-20ff-4e7b-a5f3-b3cb385aa136

	measure 'Value (show blanks as 0)' = ```
			sum('111 Data'[Value]) + 0 
			```
		formatString: #,0
		lineageTag: b9cfc2bf-e23d-4fcc-bc26-9240a1e47c10

	measure 'Latest date in 111 data' = MAX('111 Data'[DateOfCase])
		formatString: mmmm yyyy
		lineageTag: 9bfe331e-ac1b-4012-afba-06fff61588d4

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	measure 'Total 111 calls by column' = DIVIDE(SUM('111 Data'[Value]),CALCULATE(SUM('111 Data'[Value]),ALLEXCEPT('111 Data','111 Data'[Call_Handler])))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c08d47b2-5d22-4cf7-8dfe-590c6133f87e

	measure Final_Disposition_Proportion_of_RowTotal = ```
			
			DIVIDE(
			    sum('111 Data'[Value]),
			    CALCULATE(
			        sum('111 Data'[Value])
			        ,ALL('111 Data'[Derived_PPG_Final_Disposition_Group],'111 Data'[DispositionGroup(PPG)])
			       
			    )
			)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 315e0460-e35c-46cf-a67e-ec516e443a4e

	column ID
