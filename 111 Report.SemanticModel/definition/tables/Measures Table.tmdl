	measure '% of Primary Care Contact' = ```
			sum('111 Data'[Primary_Care_Contact_Flag])/sum('111 Data'[Value]) 
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e6cddb41-75ef-4219-8768-0e6589f26999

	measure '% of Primary Care Speak to' = ```
			sum('111 Data'[Primary_Care_Speak_To_Flag])/sum('111 Data'[Value]) 
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 25725a49-6c72-4df1-ad41-7f9239ad5e36

	measure '% of Speak to CA' = ```
			sum('111 Data'[Speak_to_CA_Flag])/sum('111 Data'[Value]) 
