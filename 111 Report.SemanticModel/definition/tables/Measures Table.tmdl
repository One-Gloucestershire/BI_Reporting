table 'Measures Table'
	lineageTag: 85ab202e-4bab-4ad9-9c5b-329586e00688

	measure '% of Calls Closed' = SUM('111 Data'[Call_Closed_Flag])/sum('111 Data'[Value])
		formatString: 0.00%;-0.00%;0.00%
