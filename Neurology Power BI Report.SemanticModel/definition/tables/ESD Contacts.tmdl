)#(tab)#(tab)#(tab)#(tab)WHEN [TIME_BETWEEN_REFERRAL_AND_CARE_CONTACT] BETWEEN 57 AND 70 then '8-10 weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [TIME_BETWEEN_REFERRAL_AND_CARE_CONTACT] BETWEEN 71 AND 84 then '10-12 weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [TIME_BETWEEN_REFERRAL_AND_CARE_CONTACT] BETWEEN 85 AND 98 then '12-14 weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [TIME_BETWEEN_REFERRAL_AND_CARE_CONTACT] BETWEEN 99 AND 112 then '14-16 weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [TIME_BETWEEN_REFERRAL_AND_CARE_CONTACT] BETWEEN 113 AND 126 then '16-18 weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [TIME_BETWEEN_REFERRAL_AND_CARE_CONTACT] > 126 then '18+ weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ELSE 'No time recorded'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)END#(lf)#(lf)#(tab)#(tab),[Consultation_Mechanism] = CASE#(tab)WHEN [CONSULTATION_MECHANISM_COMMUNITY_CARE] LIKE '01' THEN 'Face to Face'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [CONSULTATION_MECHANISM_COMMUNITY_CARE] LIKE '02' THEN 'Telephone'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [CONSULTATION_MECHANISM_COMMUNITY_CARE] LIKE '04' THEN 'Talk type for a person unable to speak'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [CONSULTATION_MECHANISM_COMMUNITY_CARE] LIKE '05' THEN 'Email'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [CONSULTATION_MECHANISM_COMMUNITY_CARE] LIKE '09' THEN 'Text Message (Asynchronous)'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [CONSULTATION_MECHANISM_COMMUNITY_CARE] LIKE '10' THEN 'Instant messaging (Synchronous)'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [CONSULTATION_MECHANISM_COMMUNITY_CARE] LIKE '11' THEN 'Video consultation'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [CONSULTATION_MECHANISM_COMMUNITY_CARE] LIKE '12' THEN 'Message Board (Asynchronous)'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [CONSULTATION_MECHANISM_COMMUNITY_CARE] LIKE '13' THEN 'Chat Room (Synchronous)'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [CONSULTATION_MECHANISM_COMMUNITY_CARE] LIKE '98' THEN 'Other (not listed)'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ELSE [CONSULTATION_MECHANISM_COMMUNITY_CARE]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)END#(lf)#(lf)#(tab)#(tab),[Staff_type] = CASE#(tab)WHEN [CARE_PROFESSIONAL_STAFF_GROUP_COMMUNITY_CARE] LIKE 'N32' THEN 'Staff Nurse'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [CARE_PROFESSIONAL_STAFF_GROUP_COMMUNITY_CARE] LIKE 'A08' THEN 'Physiotherapist'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ELSE 'No matching staff type in national data'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)END#(lf)#(lf)#(tab)#(tab)INTO #table1#(lf)#(lf)#(tab)#(tab)FROM [CCG_Current].[CSDS].[vw_302_CareContact] [C] #(lf)#(tab)#(tab)#(lf)#(tab)#(tab)LEFT JOIN [CCG_Current].[CSDS].[vw_301_Referral] [R] ON [C].[ServiceRequestID] = [R].[ServiceRequestID]#(lf)#(lf)#(tab)#(tab)LEFT JOIN [Data_Mart_CSDS].[dbo].[CYP201_Care_Contact] [CC] ON [CC].[UNIQUE_CARE_CONTACT_IDENTIFIER] = [C].[UniqueCareContactID]#(lf)#(lf)#(tab)#(tab)LEFT JOIN [Data_Mart_CSDS].[dbo].[CYP202_Care_Activity] [CA] ON [CA].[CARE_CONTACT_IDENTIFIER] = [CC].[CARE_CONTACT_IDENTIFIER]#(lf)#(lf)#(tab)#(tab)LEFT JOIN [Data_Mart_CSDS].[dbo].[CYP901_Staff_Details] [S] ON [S].[CARE_PROFESSIONAL_LOCAL_IDENTIFIER] = [CA].[CARE_PROFESSIONAL_LOCAL_IDENTIFIER]#(lf)#(lf)#(lf)#(tab)#(tab)WHERE [R].[TeamIDLocal] like 'E11800[ed]%'#(lf)#(tab)#(tab)AND [R].[Current_CostCentre] like 'E11800[ed]%'#(lf)#(lf)#(tab)#(tab)order by [C].[Derived_Pseudo_NHS], [CareContactID]#(lf)#(lf)#(tab)#(