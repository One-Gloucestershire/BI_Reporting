		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Current", [Query="/****** Script for SelectTopNRows command from SSMS  ******/#(lf)#(lf)#(tab)#(tab)SET NOCOUNT ON#(lf)#(tab)#(tab)IF OBJECT_ID ('TEMPDB..#table1') IS NOT NULL DROP TABLE #table1#(lf)#(tab)#(tab);#(lf)#(lf)#(tab)#(tab)SELECT  distinct#(lf)#(tab)#(tab)ReferralRequestReceivedDate = cast(ReferralRequestReceivedDate as datetime)#(lf)#(tab)#(tab)#(lf)#(tab)#(tab),[CONSULTATION_MECHANISM_COMMUNITY_CARE]#(lf)#(tab)#(tab)-- ,Contact_duplicates = CASE WHEN ROW_NUMBER()OVER(PARTITION BY carecontactID,  contactdate  ORDER BY contacttime desc)= 1 THEN 'Contact' ELSE 'Duplicate contact' END#(lf)#(tab)#(tab),[counter] = 1#(lf)#(tab)#(tab),[R].[LocalPatientID]#(lf)#(tab)#(tab),ContactDate#(lf)#(tab)#(tab),[C].[Derived_Pseudo_NHS]#(lf)#(tab)#(tab),[CareContactID]#(lf)#(tab)#(tab),Referral_duplicates = CASE WHEN ROW_NUMBER()OVER(PARTITION BY   carecontactid, [C].[Derived_Pseudo_NHS]  ORDER BY carecontactid ASC)= 1 THEN 'Referral' ELSE 'Duplicate referral' END#(lf)#(tab)#(tab),[referral_teamIDlocal] = r.TeamIDLocal#(lf)#(tab)#(tab),[referral_teamIDlocaldescription] = CASE#(tab)WHEN r.TeamIDLocal like 'E11800a' then 'CSSN Cheltenham and Tewkesbury'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN r.TeamIDLocal like 'E11800b' then 'CSSN Gloucester'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN r.TeamIDLocal like 'E11800d' then 'Chelt ESD'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN r.TeamIDLocal like 'E11800e' then 'Glos ESD'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)END#(lf)#(tab)#(tab),[C].[ServiceRequestID]#(lf)#(tab)#(tab),[C].[TeamIDLocal]#(lf)#(tab)#(tab),[C].[TeamIDLocalDescription]#(lf)#(tab)#(tab),[ContactTime]#(lf)#(tab)#(tab),[C].[OrgIDCommissioner]#(lf)#(tab)#(tab),[C].[OrgIDCommissionerDescription]#(lf)#(tab)#(tab),[AdminCategory]#(lf)#(tab)#(tab),[