	partition 'Care Contact' = m
		mode: import
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "CCG_Current", [Query="/****** Script for SelectTopNRows command from SSMS  ******/#(lf)#(lf)#(tab)#(tab)SET NOCOUNT ON#(lf)#(tab)#(tab)IF OBJECT_ID ('TEMPDB..#table1') IS NOT NULL DROP TABLE #table1#(lf)#(tab)#(tab);#(lf)#(lf)#(tab)#(tab)SELECT  distinct#(lf)#(tab)#(tab)ReferralRequestReceivedDate = cast(ReferralRequestReceivedDate as datetime)#(lf)#(tab)#(tab)#(lf)#(tab)#(tab)--,Referral_duplicates = CASE WHEN ROW_NUMBER()OVER(PARTITION BY carecontactID,  [CONSULTATION_MECHANISM_COMMUNITY_CARE]  ORDER BY [CONSULTATION_MECHANISM_COMMUNITY_CARE] ASC)= 1 THEN 'Referral' ELSE 'Duplicate referral' END#(lf)#(tab)#(tab)--,Contact_ID_Rank = RANK() OVER(PARTITION BY carecontactID ORDER BY c.servicerequestid DESC) #(lf)#(tab)#(tab),[CONSULTATION_MECHANISM_COMMUNITY_CARE]#(lf)#(tab)#(tab) ,Referral_duplicates = CASE WHEN ROW_NUMBER()OVER(PARTITION BY carecontactID,  contactdate  ORDER BY contacttime desc)= 1 THEN 'Referral' ELSE 'Duplicate referral' END#(lf)#(tab)#(tab),[counter] = 1#(lf)#(tab)#(tab),[R].[LocalPatientID]#(lf)#(tab)#(tab),ContactDate#(lf)#(tab)#(tab),[CareContactID]#(lf)#(tab)#(tab),[C].[ServiceRequestID]#(lf)#(tab)#(tab),[C].[TeamIDLocal]#(lf)#(tab)#(tab),[C].[TeamIDLocalDescription]#(lf)#(tab)#(tab),[ContactTime]#(lf)#(tab)#(tab),[C].[OrgIDCommissioner]#(lf)#(tab)#(tab),[C].[OrgIDCommissionerDescription]#(lf)#(tab)#(tab),[AdminCategory]#(lf)#(tab)#(tab),[AdminCategoryDescription]#(lf)#(tab)#(tab),[CareContactDuration]#(lf)#(tab)#(tab),[ConsultationType]#(lf)#(tab)#(tab),[ConsultationTypeDescription]#(lf)#(tab)#(tab),[CareContactSubject]#(lf)#(tab)#(tab),[CareContactSubjectDescription]#(lf)#(tab)#(tab),[ConsultationMediumUsed]#(lf)#(tab)#(tab),[ConsultationMediumUsedDescription]#(lf)#(tab)#(tab),[ActivityLocationType]#(lf)#(tab)#(tab),[ActivityLocationTypeDescription]#(lf)#(tab)#(tab),[TreatmentOrgSiteID]#(lf)#(tab)#(tab),[TreatmentOrgSiteIDDescription]#(lf)#(tab)#(tab),[GroupTherapyIndicator]#(lf)#(tab)#(tab),[AttendOrNot]#(lf)#(tab)#(tab),[AttendOrNotDescription]#(lf)#(tab)#(tab),[ReasonableOfferDate]#(lf)#(tab)#(tab),[ClinicallyAppropriateDate]#(lf)#(tab)#(tab),[ContactCancellationDate]#(lf)#(tab)#(tab),[ContactCancellationReason]#(lf)#(tab)#(tab),[ContactCancellationReasonDescription]#(lf)#(tab)#(tab),[ReplacementAppointmentOfferedDate]#(lf)#(tab)#(tab),[ReplacementAppointmentBookedDate]#(lf)#(tab)#(tab),[RecordNumber]#(lf)#(tab)#(tab),[C].[OrgIDProvider]#(lf)#(tab)#(tab),[C].[OrgIDProviderDescription]#(lf)#(tab)#(tab),[C].[UniqueServiceRequestID]#(lf)#(tab)#(tab),[UniqueTeamIDLocal]#(lf)#(tab)#(tab),[UniqueTeamIDLocalDescription]#(lf)#(tab)#(tab),[UniqueCareContactID]#(lf)#(tab)#(tab),[AgeYrContactDate]#(lf)#(tab)#(tab),[C].[ProcessedDate]#(lf)#(tab)#(tab),[C].[Derived_Pseudo_NHS]#(lf)#(tab)#(tab),[C].[Current_CostCentre]#(lf)#(tab)#(tab),[CC].[TIME_BETWEEN_REFERRAL_AND_CARE_CONTACT] #(lf)#(tab)#(tab),[Waiting_time_band] = CASE#(tab)WHEN [TIME_BETWEEN_REFERRAL_AND_CARE_CONTACT] BETWEEN 0 AND 14 then '0-2 weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [TIME_BETWEEN_REFERRAL_AND_CARE_CONTACT] BETWEEN 15 AND 28 then '2-4 weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [TIME_BETWEEN_REFERRAL_AND_CARE_CONTACT] BETWEEN 29 AND 42 then '4-6 weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [TIME_BETWEEN_REFERRAL_AND_CARE_CONTACT] BETWEEN 43 AND 56 then '6-8 weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [TIME_BETWEEN_REFERRAL_AND_CARE_CONTACT] BETWEEN 57 AND 70 then '8-10 weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [TIME_BETWEEN_REFERRAL_AND_CARE_CONTACT] BETWEEN 71 AND 84 then '10-12 weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [TIME_BETWEEN_REFERRAL_AND_CARE_CONTACT] BETWEEN 85 AND 98 then '12-14 weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [TIME_BETWEEN_REFERRAL_AND_CARE_CONTACT] BETWEEN 99 AND 112 then '14-16 weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [TIME_BETWEEN_REFERRAL_AND_CARE_CONTACT] BETWEEN 113 AND 126 then '16-18 weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [TIME_BETWEEN_REFERRAL_AND_CARE_CONTACT] > 126 then '18+ weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ELSE 'No time recorded'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)END#(lf)#(lf)#(tab)#(tab),[Consultation_Mechanism] = CASE#(tab)WHEN [CONSULTATION_MECHANISM_COMMUNITY_CARE] LIKE '01' THEN 'Face to Face'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [CONSULTATION_MECHANISM_COMMUNITY_CARE] LIKE '02' THEN 'Telephone'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [CONSULTATION_MECHANISM_COMMUNITY_CARE] LIKE '04' THEN 'Talk type for a person unable to speak'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [CONSULTATION_MECHANISM_COMMUNITY_CARE] LIKE '05' THEN 'Email'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [CONSULTATION_MECHANISM_COMMUNITY_CARE] LIKE '09' THEN 'Text Message (Asynchronous)'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [CONSULTATION_MECHANISM_COMMUNITY_CARE] LIKE '10' THEN 'Instant messaging (Synchronous)'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [CONSULTATION_MECHANISM_COMMUNITY_CARE] LIKE '11' THEN 'Video consultation'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [CONSULTATION_MECHANISM_COMMUNITY_CARE] LIKE '12' THEN 'Message Board (Asynchronous)'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [CONSULTATION_MECHANISM_COMMUNITY_CARE] LIKE '13' THEN 'Chat Room (Synchronous)'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [CONSULTATION_MECHANISM_COMMUNITY_CARE] LIKE '98' THEN 'Other (not listed)'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(