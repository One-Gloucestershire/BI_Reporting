	partition 'Care Activity' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "ccg_current", [Query="/****** Script for SelectTopNRows command from SSMS  ******/#(lf)SELECT DISTINCT [CC].[CareContactID]#(lf)      ,[CareActivityID]#(lf)      ,[ActivityType]#(lf)      ,[ActivityTypeDescription]#(lf)      ,[CareProfessionalIDLocal]#(lf)#(tab)  ,[S].CARE_PROFESSIONAL_LOCAL_IDENTIFIER#(lf)#(tab)  ,[Staff_type] = CASE#(tab)WHEN [CARE_PROFESSIONAL_STAFF_GROUP_COMMUNITY_CARE] LIKE 'N32' THEN 'Staff Nurse'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [CARE_PROFESSIONAL_STAFF_GROUP_COMMUNITY_CARE] LIKE 'A08' THEN 'Physiotherapist'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ELSE 'No matching staff type in national data'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)END#(lf)#(lf)      ,[ProcedureScheme]#(lf)      ,[CodedProcedure]#(lf)      ,[CodedProcedureDescription]#(lf)      ,[FindingScheme]#(lf)      ,[CodedFinding]#(lf)      ,[CodedFindingDescription]#(lf)      ,[ObservationScheme]#(lf)      ,[CodedObservation]#(lf)      ,[CodedObservationDescription]#(lf)      ,[ObservationValue]#(lf)      ,[UCUnitOfMeasurement]#(lf)#(tab)  #(lf)#(lf)  FROM [CCG_Current].[CSDS].[vw_303_CareActivity] [CA]#(lf)#(lf)  LEFT JOIN [CCG_Current].[CSDS].[vw_302_CareContact] [CC] ON [CA].[CareContactID] = [CC].[CareContactID]#(lf)#(lf)  LEFT JOIN [CCG_Current].[CSDS].[vw_301_Referral] [R] ON [CC].[ServiceRequestID] = [R].[ServiceRequestID]#(lf)#(lf)  LEFT JOIN [Data_Mart_CSDS].[dbo].[CYP901_Staff_Details] [S] ON [S].[CARE_PROFESSIONAL_LOCAL_IDENTIFIER] = [CA].[CareProfessionalIDLocal]#(lf)#(lf)  WHERE [R].[TeamIDLocal] like 'G14604%'#(lf)#(lf)  order by [CA].[CareProfessionalIDLocal]"])
				in
				    Source

	annotation PBI_ResultType = Table

