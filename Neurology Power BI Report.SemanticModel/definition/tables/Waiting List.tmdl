	partition 'Waiting List' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "ccg_current", [Query="#(tab)#(lf)#(tab)SET NOCOUNT ON#(lf)#(tab)IF OBJECT_ID ('TEMPDB..#monthly_WL') IS NOT NULL DROP TABLE #monthly_WL#(lf)#(tab);#(lf)#(lf)#(tab)SELECT DISTINCT #(lf)#(tab)[R].[ServiceRequestID]#(lf)#(tab),[R].[DerivedPseudoNHS]#(lf)#(tab),[counter] = 1#(lf)#(tab),[R].[ReferralRequestReceivedDate]#(lf)#(tab),[contactdate]#(lf)#(tab),[DischargeDate]#(lf)#(tab)#(lf)#(tab),[Oct-23_Waiting_List] = CASE WHEN [R].[ReferralRequestReceivedDate] <= '2023-10-31' AND ([R].[DischargeDate] >= '2023-11-01' or [R].[DischargeDate]  IS NULL) AND ([ContactDate] >= '2023-11-01' OR [ContactDate] IS NULL)#(lf)#(tab)THEN DATEDIFF(DAY, [R].[ReferralRequestReceivedDate],'2023-10-31')#(lf)#(tab)ELSE NULL#(lf)#(tab)END#(lf)#(lf)#(tab),[Nov-23_Waiting_List] = CASE WHEN [R].[ReferralRequestReceivedDate] <= '2023-11-30' AND ([R].[DischargeDate] >= '2023-12-01' or [R].[DischargeDate]  IS NULL) AND ([ContactDate] >= '2023-12-01' OR [ContactDate] IS NULL)#(lf)#(tab)THEN DATEDIFF(DAY, [R].[ReferralRequestReceivedDate],'2023-11-30')#(lf)#(tab)ELSE NULL#(lf)#(tab)END#(lf)#(lf)#(tab),[Dec-23_Waiting_List] = CASE WHEN [R].[ReferralRequestReceivedDate] <= '2023-12-31' AND ([R].[DischargeDate] >= '2024-01-01' or [R].[DischargeDate]  IS NULL) AND ([ContactDate] >= '2024-01-01' OR [ContactDate] IS NULL)#(lf)#(tab)THEN DATEDIFF(DAY, [R].[ReferralRequestReceivedDate],'2023-12-31')#(lf)#(tab)ELSE NULL#(lf)#(tab)END#(lf)#(lf)#(tab),[Jan-24_Waiting_List] = CASE WHEN [R].[ReferralRequestReceivedDate] <= '2024-01-31' AND ([R].[DischargeDate] >= '2024-02-01' or [R].[DischargeDate]  IS NULL) AND ([ContactDate] >= '2024-02-01' OR [ContactDate] IS NULL)#(lf)#(tab)THEN DATEDIFF(DAY, [R].[ReferralRequestReceivedDate],'2024-01-31')#(lf)#(tab)ELSE NULL#(lf)#(tab)END#(lf)#(lf)#(tab),[Feb-24_Waiting_List] = CASE WHEN [R].[ReferralRequestReceivedDate] <= '2024-02-19' AND ([R].[DischargeDate] >= '2024-03-01' or [R].[DischargeDate]  IS NULL) AND ([ContactDate] >= '2024-03-01' OR [ContactDate] IS NULL)#(lf)#(tab)THEN DATEDIFF(DAY, [R].[ReferralRequestReceivedDate],'2024-02-29')#(lf)#(tab)ELSE NULL#(lf)#(tab)END#(lf)#(lf)#(tab)INTO #monthly_WL#(lf)#(tab)#(lf)#(lf)#(tab)FROM [CCG_Current].[CSDS].[vw_301_Referral] [R]#(lf)#(tab)#(tab)#(lf)#(tab)LEFT JOIN #(lf)#(tab)(SELECT DISTINCT#(lf)#(tab)[C1].[ServiceRequestID]#(lf)#(tab),[C1].[ContactDate]#(lf)#(tab)FROM [CCG_Current].[CSDS].[vw_302_CareContact] AS [C1]#(lf)#(tab)WHERE [ConsultationTypeDescription] LIKE 'Initial consultation') AS [C2]#(lf)#(tab)ON [C2].[ServiceRequestID] = [R].[ServiceRequestID]#(lf)#(lf)#(tab)WHERE [R].[TeamIDLocal] like 'G14604%'#(lf)#(tab)AND [R].[ReferralRequestReceivedDate] NOT LIKE '2023-10-02' --excludes the patients which were brough from old ICT #(lf)#(lf)#(tab)ORDER BY [R].[DerivedPseudoNHS]#(lf)#(lf)#(lf)#(tab)SELECT#(lf)#(tab)[Number_on_Waiting_List] = SUM(1)#(lf)#(tab),[Month_Year] = 'October-2023'#(lf)#(tab),[Weeks] = CASE#(tab)WHEN [Oct-23_Waiting_List] BETWEEN 0 AND 14 then '0-2 weeks' #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [Oct-23_Waiting_List] BETWEEN 15 AND 28 then '2-4 weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [Oct-23_Waiting_List] BETWEEN 29 AND 42 then '4-6 weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [Oct-23_Waiting_List] BETWEEN 43 AND 56 then '6-8 weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [Oct-23_Waiting_List] BETWEEN 57 AND 70 then '8-10 weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [Oct-23_Waiting_List] BETWEEN 71 AND 84 then '10-12 weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [Oct-23_Waiting_List] BETWEEN 85 AND 98 then '12-14 weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [Oct-23_Waiting_List] BETWEEN 99 AND 112 then '14-16 weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [Oct-23_Waiting_List] BETWEEN 113 AND 126 then '16-18 weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [Oct-23_Waiting_List] > 126 then '18+ weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)END#(lf)#(lf)#(tab)FROM #monthly_WL#(lf)#(lf)#(tab)GROUP BY#(lf)#(tab)CASE WHEN [Oct-23_Waiting_List] BETWEEN 0 AND 14 then '0-2 weeks' #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [Oct-23_Waiting_List] BETWEEN 15 AND 28 then '2-4 weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [Oct-23_Waiting_List] BETWEEN 29 AND 42 then '4-6 weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [Oct-23_Waiting_List] BETWEEN 43 AND 56 then '6-8 weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [Oct-23_Waiting_List] BETWEEN 57 AND 70 then '8-10 weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [Oct-23_Waiting_List] BETWEEN 71 AND 84 then '10-12 weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [Oct-23_Waiting_List] BETWEEN 85 AND 98 then '12-14 weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [Oct-23_Waiting_List] BETWEEN 99 AND 112 then '14-16 weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [Oct-23_Waiting_List] BETWEEN 113 AND 126 then '16-18 weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [Oct-23_Waiting_List] > 126 then '18+ weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)END#(lf)#(tab)#(lf)#(tab)UNION#(lf)#(lf)#(tab)SELECT#(lf)#(tab)[Number_on_Waiting_List] = SUM(1)#(lf)#(tab),[Month_Year] = 'November-2023'#(lf)#(lf)#(tab),[Nov-23_Waiting_List] = CASE#(tab)WHEN [Nov-23_Waiting_List] BETWEEN 0 AND 14 then '0-2 weeks' #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [Nov-23_Waiting_List] BETWEEN 15 AND 28 then '2-4 weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [Nov-23_Waiting_List] BETWEEN 29 AND 42 then '4-6 weeks'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [Nov-