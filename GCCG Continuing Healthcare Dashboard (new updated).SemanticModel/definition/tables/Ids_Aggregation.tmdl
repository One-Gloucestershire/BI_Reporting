	column Age =
			
			VAR age =
			    DATEDIFF (
			        Ids_Aggregation[A_ Main data.dateofbirth],
			        TODAY (),
			        YEAR
			    )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( Ids_Aggregation[A_ Main data.dateofbirth] ), "",
			        age < 18, "0-17",
			        age >= 65, "65+",
			        "18-64"
			    )
