table Ids_Aggregation
	lineageTag: 6b864f10-cd48-4af4-b4b6-33389faaae4c

	measure DumpFilters =
			VAR MaxFilters = 2
			RETURN
			    IF (
			        ISFILTERED ( '28days_Referrals'[clientid] ),
			        VAR ___f =
			            FILTERS ( '28days_Referrals'[clientid] )
			        VAR ___r =
			            COUNTROWS ( ___f )
			        VAR ___t =
			            TOPN ( MaxFilters, ___f, '28days_Referrals'[clientid] )
			        VAR ___d =
			            CONCATENATEX ( ___t, '28days_Referrals'[clientid], ", " )
			        VAR ___x =
			            "'28days_Referrals'[clientid] = " & ___d
			                & IF ( ___r > MaxFilters, ", ... [" & ___r & " items selected]" ) & " "
			        RETURN
			            ___x & UNICHAR ( 13 )
			                & UNICHAR ( 10 )
