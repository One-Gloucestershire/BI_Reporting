	measure MOM_PREVIOUSMonth =
			VAR SV =
			    SELECTEDVALUE ( 'CHC & FNC Measure selection'[Parameter Order], 99 )
			VAR SV2 =
			    SELECTEDVALUE ( 'Fast Track Measure Selection'[Parameter Order], 99 )
			RETURN
			    SWITCH (
			        TRUE (),
			        SV = 0, CALCULATE ( [Checklists _ Pos], PREVIOUSMONTH ( 'Date'[Date] ) ),
			        SV2 = 0 , CALCULATE ( [FT Newly Eligible Cases], PREVIOUSMONTH ( 'Date'[Date] ) ),
			        SV = 1, CALCULATE ( [Newly Eligible Cases], PREVIOUSMONTH ( 'Date'[Date] ) ),
			        SV = 2,
			            FORMAT (
			                CALCULATE ( [Completed in 28days%], PREVIOUSMONTH ( 'Date'[Date] ) ),
			                "###.#%"
			            ),
			        SV = 3,
			            FORMAT (
			                CALCULATE ( [Referral Conversion Rate], PREVIOUSMONTH ( 'Date'[Date] ) ),
			                "###.#%"
			            ),
			        SV = 4, CALCULATE ( [3 Month Reviews Completed], PREVIOUSMONTH ( 'Date'[Date] ) ),
			        SV = 5,
			            CALCULATE (
			                [12 Month & Other Reviews Completed],
			                PREVIOUSMONTH ( 'Date'[Date] )
			            ),
			        SV = 6,
			            FORMAT (
			                CALCULATE ( [Cases Completed in hospital (%)], PREVIOUSMONTH ( 'Date'[Date] ) ),
			                "###.#%"
			            ),
			        SV = 7,
			            FORMAT (
			                CALCULATE ( [Assessments Conversion Rate (%)], PREVIOUSMONTH ( 'Date'[Date] ) ),
			                "###.#%"
			            ),
			        SV2 = 1,
			            FORMAT (
			                CALCULATE ( [Current Conversion rate FT (%)], PREVIOUSMONTH ( 'Date'[Date] ) ),
			                "###.#%"
			            ),
			        SV2 = 2,
			            FORMAT (
			                CALCULATE (
			                    [Fast track % RIP of Ref (12 weeks)],
			                    PREVIOUSMONTH ( 'Date'[Date] )
			                ),
			                "###.#%"
			            ),
			        SV = 9,
			            CALCULATE (
			                [FNC Patient Count],
			                PREVIOUSMONTH ( 'Date'[Date] )
			            )
			    )
		displayFolder: QoQ/MoM
		lineageTag: 3e21ab94-391d-4165-be6f-25e2e50fb702

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'MOM_PREVIOUSMonth Numberonly' =
			VAR SV =
			    SELECTEDVALUE ( 'CHC & FNC Measure selection'[Parameter Order], 99 )
			VAR SV2 =
			    SELECTEDVALUE ( 'Fast Track Measure Selection'[Parameter Order], 99 )
			RETURN
			    SWITCH (
			        TRUE (),
			        SV = 0, CALCULATE ( [Checklists _ Pos], PREVIOUSMONTH ( 'Date'[Date] ) ),
			        SV2 = 0 , CALCULATE ( [FT Newly Eligible Cases], PREVIOUSMONTH ( 'Date'[Date] ) ),
			        SV = 1, CALCULATE ( [Newly Eligible Cases], PREVIOUSMONTH ( 'Date'[Date] ) ),
			        SV = 2, CALCULATE ( [Completed in 28days%], PREVIOUSMONTH ( 'Date'[Date] ) ),
			        SV = 3, CALCULATE ( [Referral Conversion Rate], PREVIOUSMONTH ( 'Date'[Date] ) ),
			        sv = 4, CALCULATE ( [3 Month Reviews Completed], PREVIOUSMONTH ( 'Date'[Date] ) ),
			        SV = 5,
			            CALCULATE (
			                [12 Month & Other Reviews Completed],
			                PREVIOUSMONTH ( 'Date'[Date] )
			            ),
			        sv = 6, CALCULATE ( [Cases Completed in hospital (%)], PREVIOUSMONTH ( 'Date'[Date] ) ),
			        sv = 7, CALCULATE ( [Assessments Conversion Rate (%)], PREVIOUSMONTH ( 'Date'[Date] ) ),
			        sv2 = 1, CALCULATE ( [Current Conversion rate FT (%)], PREVIOUSMONTH ( 'Date'[Date] ) ),
			        sv2 = 2,
			            CALCULATE (
			                [Fast track % RIP of Ref (12 weeks)],
			                PREVIOUSMONTH ( 'Date'[Date] )
			            ),
			        SV = 9,
			            CALCULATE (
			                [FNC Patient Count],
