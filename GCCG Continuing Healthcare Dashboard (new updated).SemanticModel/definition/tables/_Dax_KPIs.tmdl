	measure 'Cases Completed in hospital (%)' =
			VAR a =
			    DIVIDE (
			        CALCULATE (
			            '_Dax_KPIs'[Patient Count],
			            '28days_Referrals'[dstsetting] = "acute"
			        ),
			        '_Dax_KPIs'[Patient Count],
			        0
			    )
			RETURN
			    IF ( ISBLANK ( a ), 0, a )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: CHC
		lineageTag: fe9c905f-74c6-4095-98de-fcf86746c692

