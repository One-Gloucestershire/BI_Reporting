	measure 'Completed in 28days%' = ```
			DIVIDE (
			    CALCULATE (
			        [Patient Count],
			        '28days_Referrals'[Completed days] <= 28
			            && '28days_Referrals'[Completed days] <> BLANK () ,'28days_Referrals'[fasttrack] = "N"
			,'28days_Referrals'[carecat] <> "cht"
			
			    ),
			    CALCULATE (
			        [Patient Count],
			        
			             '28days_Referrals'[Completed days] <> BLANK () ,'28days_Referrals'[fasttrack] = "N" ,'28days_Referrals'[carecat] <> "cht"
			    ) ,
			    0
			)
