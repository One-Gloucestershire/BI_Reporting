	measure 'M on M Change' =
			VAR SV =
			    SELECTEDVALUE ( 'CHC & FNC Measure selection'[Parameter Order], 99 )
			VAR SV2 =
			    SELECTEDVALUE ( 'Fast Track Measure Selection'[Parameter Order], 99 )
			RETURN
			    SWITCH (
			        TRUE (),
			        OR ( sv IN { 0, 1, 4, 5, 9 }, SV2 IN { 0 } ),
			            IFERROR (
			                ( [QOQ_ CurrentQUARTER/Month] / [MoM_PREVIOUSMonth Numberonly] ) - 1,
			                0
			            ),
			        OR ( sv IN { 2, 3, 6, 7 }, SV2 IN { 1, 2 } ), ( [QOQ_ CurrentQUARTER/Month] - [MoM_PREVIOUSMonth Numberonly] )
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: QoQ/MoM
		lineageTag: bb710b74-73ac-4ea5-bf88-055c8a79bb6b

		changedProperty = FormatString

