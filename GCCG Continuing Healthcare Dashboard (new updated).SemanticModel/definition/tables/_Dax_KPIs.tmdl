	measure 'Q on Q Change' =
			VAR SV =
			    SELECTEDVALUE ( 'CHC & FNC Measure selection'[Parameter Order], 99 )
			VAR SV2 =
			    SELECTEDVALUE ( 'Fast Track Measure Selection'[Parameter Order], 99 )
			RETURN
			    SWITCH (
			        TRUE (),
			        OR ( sv IN { 0, 1, 4, 5, 9 }, SV2 IN { 0 } ),
			            IFERROR (
			                ( [QOQ_ CurrentQUARTER/Month] / [QOQ_PREVIOUSQUARTER Numberonly] ) - 1,
			                0
			            ),
			        OR ( sv IN { 2, 3, 6, 7 }, SV2 IN { 1, 2 } ), ( [QOQ_ CurrentQUARTER/Month] - [QOQ_PREVIOUSQUARTER Numberonly] )
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: QoQ/MoM
		lineageTag: 8784adb2-966a-40f0-9c39-00444263b7c9

		changedProperty = FormatString

	measure 'CHC Title' = "CHC - " & SELECTEDVALUE ( 'CHC & FNC Measure selection'[CHC Selection] )
		displayFolder: Titles
		lineageTag: 961f06f5-4e1b-47c4-aa85-71ede4949d5c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure QOQ_PREVIOUSQUARTER =
			VAR SV =
			    SELECTEDVALUE ( 'CHC & FNC Measure selection'[Parameter Order], 99 )
			VAR SV2 =
			    SELECTEDVALUE ( 'Fast Track Measure Selection'[Parameter Order], 99 )
			RETURN
			    SWITCH (
			        TRUE (),
			        SV = 0, CALCULATE ( [Checklists _ Pos], PREVIOUSQUARTER ( 'Date'[Date] ) ),
			        SV2 = 0 , CALCULATE ( [FT Newly Eligible Cases], PREVIOUSQUARTER ( 'Date'[Date] ) ),
			        SV = 1, CALCULATE ( [Newly Eligible Cases], PREVIOUSQUARTER ( 'Date'[Date] ) ),
			        SV = 2,
			            FORMAT (
			                CALCULATE ( [Completed in 28days%], PREVIOUSQUARTER ( 'Date'[Date] ) ),
			                "###.#%"
			            ),
			        SV = 3,
			            FORMAT (
			                CALCULATE ( [Referral Conversion Rate], PREVIOUSQUARTER ( 'Date'[Date] ) ),
			                "###.#%"
			            ),
			        SV = 4, CALCULATE ( [3 Month Reviews Completed], PREVIOUSQUARTER ( 'Date'[Date] ) ),
			        SV = 5,
			            CALCULATE (
			                [12 Month & Other Reviews Completed],
			                PREVIOUSQUARTER ( 'Date'[Date] )
			            ),
			        SV = 6,
			            FORMAT (
			                CALCULATE (
			                    [Cases Completed in hospital (%)],
			                    PREVIOUSQUARTER ( 'Date'[Date] )
			                ),
			                "###.#%"
			            ),
			        SV = 7,
			            FORMAT (
			                CALCULATE (
			                    [Assessments Conversion Rate (%)],
			                    PREVIOUSQUARTER ( 'Date'[Date] )
			                ),
			                "###.#%"
			            ),
			        SV2 = 1,
			            FORMAT (
			                CALCULATE ( [Current Conversion rate FT (%)], PREVIOUSQUARTER ( 'Date'[Date] ) ),
			                "###.#%"
			            ),
			        SV2 = 2,
			            FORMAT (
			                CALCULATE (
			                    [Fast track % RIP of Ref (12 weeks)],
			                    PREVIOUSQUARTER ( 'Date'[Date] )
			                ),
			                "###.#%"
			            ),
			        SV = 9,
			            CALCULATE (
			                [FNC Patient Count],
			                PREVIOUSQUARTER ( 'Date'[Date] )
			            )
			    )
		formatString: 0
		displayFolder: QoQ/MoM
		lineageTag: 851dd105-d6dd-43f4-b283-91ceca3df2b6

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isDecimal":true}

