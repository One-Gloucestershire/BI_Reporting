		isNameInferred
		sourceColumn: [Axis Date]

		variation Variation
			isDefault
			relationship: facdbf7f-5e32-4963-bc66-368cb8c2838a
			defaultHierarchy: LocalDateTable_e7d3571b-e3e4-461f-81fe-19b6ec22da9f.'Date Hierarchy'

