table Date
	lineageTag: 6e58ccf6-d687-4b25-8a03-0154f5b8acc4
	dataCategory: Time

	measure 'Date Range' =
			FORMAT ( MIN ( 'Date'[Date] ), "DD/MM/YYYY" ) & " - "
			    & FORMAT ( MAX ( 'Date'[Date] ), "DD/MM/YYYY" )
		lineageTag: 5a01de51-ce64-4b0a-ae6b-590ea7c1b294

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure PageFilter_2yearfilter = ```
			EDATE( Date(
			     Year(Now()),     
			     (RoundUp(Month(Now())/3,0) * 3) - 2
			    ,1
			), -24)
			```
		lineageTag: 47d47665-f2e3-4142-a088-2f0fd37a1183

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Current Q format flag' = sum('Date'[Current Q])
		lineageTag: ce4d87c4-1ee5-46cc-8e88-4409906aa1e4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Date
		isKey
		formatString: General Date
