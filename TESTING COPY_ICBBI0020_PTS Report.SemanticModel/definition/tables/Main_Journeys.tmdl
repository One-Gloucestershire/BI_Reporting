table Main_Journeys
	lineageTag: 41022937-0cae-4bcd-903b-dbdf39436343

	measure 'Main + GHT'
		lineageTag: 5492224e-8b49-4f35-8110-696c0d1b3871

	measure 'All Journeys_Main + GHT' =
			
			SUM('Main_Journeys'[Counter (Main)]) + SUM('GHT_OntheDay'[Counter (GHT)])
		formatString: 0
		lineageTag: 1830b3c5-a162-45da-b789-7bb4b2f2917d

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalAddition"
				}

		changedProperty = FormatString

	measure 'passengerID divided by Counter (Main)' =
			
			DIVIDE(
				COUNTA('Dialysis Distinct Patients'[passengerID]),
				SUM('Main_Journeys'[Counter (Main)])
			)
		formatString: #,0
		lineageTag: a2487087-9c9d-424b-ae11-b63fe3323dcf

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalDivision"
				}

		changedProperty = FormatString

	measure 'Completed: Counter (Main) minus Aborts or Cancel Flag' =
			
			SUM('Main_Journeys'[Counter (Main)]) - SUM('Main_Journeys'[Aborts or Cancel Flag])
		formatString: #,0
		lineageTag: 13344722-cae2-4492-8b14-783da00abe70

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalSubtraction"
				}

		changedProperty = FormatString

	measure 'Proportion Completed out of Booked (Main)' =
			
			DIVIDE(
				[Completed: Counter (Main) minus Aborts or Cancel Flag],
				SUM('Main_Journeys'[Counter (Main)])
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 0eafe2c2-8cf2-4cc5-a4b9-d7a267ea58b0

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalDivision"
				}

		changedProperty = FormatString

	measure 'KPI_2a_Achieved percentage' =
			
			DIVIDE(
				SUM('Main_Journeys'[KPI_2a_Achieved_Numerator]),
				SUM('Main_Journeys'[KPI_2a_Denominator])
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 17b76c1b-74ec-4ab9-96c8-739181c0b59d

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalDivision"
				}

		changedProperty = FormatString

	measure 'KPI_2b_Achieved Percentage' =
			
			DIVIDE(
				SUM('Main_Journeys'[KPI_2b_Achieved_Numerator]),
				SUM('Main_Journeys'[KPI_2b_Denominator])
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e949a8ed-576f-47fe-a523-c299bb9c4369

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalDivision"
				}

		changedProperty = FormatString

	measure KPI_3a_Achieved_Percentage =
			
			DIVIDE(
				SUM('Main_Journeys'[KPI_3a_Achieved_Numerator]),
				SUM('Main_Journeys'[KPI_3a_Denominator])
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 46aea29f-f7e7-4dbe-86ef-43e46bebd339

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalDivision"
				}

		changedProperty = FormatString

	measure 'KPI_5 Achieved Percentage' =
			
			DIVIDE(
				SUM('Main_Journeys'[KPI_5_Numerator]),
				SUM('Main_Journeys'[Counter (Main)])
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ad997d90-756b-40ed-9de7-a81656db4f0b

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalDivision"
				}

		changedProperty = FormatString

	measure 'Proportion (Main): Aborts out of Booked' =
			
			DIVIDE(
				SUM('Main_Journeys'[Aborts only Flag]),
				SUM('Main_Journeys'[Counter (Main)])
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: bb10c138-3af9-4739-828c-2e8ac2a329ee

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalDivision"
				}

		changedProperty = FormatString

	measure 'Proportion (Main): Cancelled out of Booked Main)' =
			
			DIVIDE(
				SUM('Main_Journeys'[Cancelled only Flag]),
				SUM('Main_Journeys'[Counter (Main)])
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 1b669016-081b-4172-8361-b822f7923de8

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalDivision"
				}

		changedProperty = FormatString

	measure 'Complete + Aborts (Main)' =
			
			SUM('Main_Journeys'[Counter (Main)]) - SUM('Main_Journeys'[Cancelled only Flag])
		formatString: #,0
		lineageTag: f8b237b2-6297-441b-a1b2-5c890165055b

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalSubtraction"
				}

		changedProperty = FormatString

