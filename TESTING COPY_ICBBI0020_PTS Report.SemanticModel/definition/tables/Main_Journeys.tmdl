	partition Main_Journeys = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "PowerBI_Processing", [Query="EXEC [dbo].[SP_PTS_main]#(lf);#(lf)#(lf)SELECT *#(lf)FROM [PowerBI_Reporting].[dbo].[PTS_Main]"]),
				    #"Renamed Columns" = Table.RenameColumns(Source,{{"Counter", "Counter (Main)"}, {"Cancel_Reason_Description", "Cancelled (Main)"}, {"Abort_Reason_Description", "Aborts (Main)"}, {"Contract_Description", "Contract Main"}}),
				    #"Replaced Value2" = Table.ReplaceValue(#"Renamed Columns","Hospital Outpatient","Outpatient",Replacer.ReplaceValue,{"Category_Mapped_Description"}),
				    #"Renamed Columns1" = Table.RenameColumns(#"Replaced Value2",{{"KPI 3a timebands", "KPI_3a_timebands"}, {"KPI 5 Abort/Cancel Avoidance", "KPI_5 Abort/Cancel Avoidance"}, {"KPI_2b_Denominator", "KPI_2b_Denominator"}, {"KPI_3a_Denominator", "KPI_3a_Denominator"}}),
				    #"Replaced Value" = Table.ReplaceValue(#"Renamed Columns1",null,"Non-Covid-19",Replacer.ReplaceValue,{"Speciality_Description"}),
				    #"Renamed Columns2" = Table.RenameColumns(#"Replaced Value",{{"Covid_sus_or_conf_journeys", "Speciality_Covid_sus_or_conf_journeys"}}),
				    #"Replaced Value1" = Table.ReplaceValue(#"Renamed Columns2","Canceled","Cancelled",Replacer.ReplaceText,{"Cancelled (Main)"}),
				    #"Added Custom Column" = Table.AddColumn(#"Replaced Value1", "Custom", each Text.Combine({Date.ToText(Date.From([Activity_Month]), "MMMM"), " ", Date.ToText(Date.From([Activity_Month]), "yyyy")}), type text),
				    #"Renamed Columns3" = Table.RenameColumns(#"Added Custom Column",{{"Custom", "Join Month"}})
				in
				    #"Renamed Columns3"

	changedProperty = IsHidden

	annotation PBI_ResultType = Table

