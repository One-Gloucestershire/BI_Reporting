table 'Main Journeys_distinct RATE'
	lineageTag: cf5eef4f-e384-46f6-bebe-7dee21a72e9e

	measure 'Counter_Passenger divided by population' =
			
			DIVIDE(
				SUM('Main Journeys_distinct RATE'[Counter_Passenger]),
				SUM('Main Journeys_distinct RATE'[population])
			)
		formatString: 0
		lineageTag: 09f85e2d-2dc0-427b-97a3-3b726864f67d

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalDivision"
				}

		changedProperty = FormatString

	measure 'Rate per 1000 pop' = (sum('Main Journeys_distinct RATE'[Counter_Passenger])/sum('Main Journeys_distinct RATE'[population]))*1000
