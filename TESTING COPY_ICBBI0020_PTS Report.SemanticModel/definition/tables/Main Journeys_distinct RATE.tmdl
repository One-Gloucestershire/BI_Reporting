	partition 'Main Journeys_distinct RATE' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "PowerBI_Reporting", [Query="SELECT #(lf)[Patient_Practice_Code] = [P].[practice_code],#(lf)[Patient_Practice_Description] = [P].[practice_name],#(lf)[Counter_Passenger] = COALESCE([Counter_Passenger],0),#(lf)[Counter_Patient] = COALESCE([Counter_Patient],0),#(lf)[population] = SUM([P].[population]),#(lf)[NetworkName] = [P].[primary_care_network],#(lf)[localityname] = [P].[locality],#(lf)[P].[sex],#(lf)[ageband_5yr_ordered] = CASE WHEN [P].[age_band] IN  ('85-89','90-94','95+') THEN '85+' ELSE [P].[age_band] END#(lf)FROM [PowerBI_Reporting].[dbo].[GP_Practice_Populations] [P]#(lf) #(lf)LEFT JOIN (SELECT #(lf)[Counter_Passenger] = Count(DISTINCT [passengerID]),#(lf)[Counter_Patient] = COUNT(DISTINCT [Pseudo_NHS_Number]),#(lf)[Gender] = CASE WHEN [Gender] IS NULL THEN 'Unknown'#(lf)#(tab)#(tab)#(tab)#(tab)WHEN [PTS].[Gender] = 'F' THEN 'Female'#(lf)#(tab)#(tab)#(tab)#(tab)WHEN [PTS].[Gender] = 'M' THEN 'Male' #(lf)#(tab)#(tab)#(tab)#(tab)ELSE [PTS].[Gender] END,#(lf)[Patient_Practice_Code],#(lf)[ageband_5yr_ordered]#(lf)FROM [PowerBI_Reporting].[dbo].[PTS_Main] AS [PTS]#(lf)WHERE [Activity_Month] in (SELECT DISTINCT TOP 12 [Activity_Month] #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)       FROM [PowerBI_Reporting].[dbo].[PTS_Main] ORDER BY [Activity_Month] DESC)#(lf)GROUP BY CASE WHEN [Gender] IS NULL THEN 'Unknown'#(lf)#(tab)#(tab)#(tab)  WHEN [PTS].[Gender] = 'F' THEN 'Female'#(lf)#(tab)#(tab)#(tab)  WHEN [PTS].[Gender] = 'M' THEN 'Male' #(lf)#(tab)#(tab)#(tab)  ELSE [PTS].[Gender] END,#(lf)[Patient_Practice_Code],#(lf)[ageband_5yr_ordered])[PTS]#(lf)ON CASE WHEN [PTS].[Gender] IS NULL THEN 'Unknown'#(lf)#(tab)#(tab)WHEN [PTS].[Gender] = 'F' THEN 'Female'#(lf)#(tab)#(tab)WHEN [PTS].[Gender] = 'M' THEN 'Male' #(lf)#(tab)#(tab)ELSE [PTS].[Gender] END = [P].[SEX]#(lf)AND [PTS].[AgeBand_5yr_ordered] = CASE WHEN [P].[age_band] IN  ('85-89','90-94','95+') THEN '85+' ELSE [P].[age_band] END#(lf)AND [PTS].[Patient_Practice_Code] = [P].[practice_code]#(lf) #(lf)WHERE [P].[year_month] IN (SELECT MAX([year_month])                                                                        -- this subquery will select the latest census data#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)FROM [PowerBI_Reporting].[dbo].[GP_Practice_Populations])#(lf) #(lf)GROUP BY #(lf)[P].[practice_code],#(lf)[P].[practice_name],#(lf)[Counter_Passenger],#(lf)[Counter_Patient],#(lf)[P].[primary_care_network],#(lf)[P].[locality],#(lf)[P].[sex],#(lf)CASE WHEN [P].[age_band] IN  ('85-89','90-94','95+') THEN '85+' ELSE [P].[age_band] END"])
				in
				    Source

	annotation PBI_ResultType = Table

