	partition DAT_PLS_Summary = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "ICB_Products", [Query="SELECT [PseudoNHSNumber]#(lf)      ,[Gender] = CASE WHEN [Gender] = 'F' THEN 'Female'#(lf)                       WHEN [Gender] = 'M' THEN 'Male'#(lf)#(tab)#(tab)   ELSE 'Not Recorded' END#(lf)      ,[DerivedAge]#(lf)      ,[Ethnicity] = [DerivedEthnicityGroup]#(lf)      ,[England_Deprivation] = [IMDNationalDecile]#(lf)      ,[Gloucester_Deprivation] = [IMDCountyDecile]#(lf)      ,[eFICategoryDerived]#(lf)      ,[ACGPatientNeedsGroup]#(lf)      ,[Last_Updated] = CAST([ProcessedDate] AS DATE)#(lf)      ,[Counter] = 1#(lf)#(lf)FROM [ICB_Products].[Patient].[vw_Summary]#(lf)#(lf)WHERE [ICBofRegistration] = '11M'"])
				in
				    Source

	annotation PBI_ResultType = Table

