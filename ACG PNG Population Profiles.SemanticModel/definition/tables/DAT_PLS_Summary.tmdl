table DAT_PLS_Summary
	lineageTag: c8ddb53b-4f70-49fb-b6bd-0b5a7d0ee3be

	measure 'Total Population' =
			
			
			SUM('DAT_PLS_Summary'[Counter])
		formatString: #,0
		lineageTag: e00109a4-353b-48fa-a312-334dd1a78d64

		annotation PBI_FormatHint = {"isDecimal":true}

	measure '% PNG of Overall ICB Population' =
			
			
			[Total Population]
			/
			CALCULATE(
			    [Total Population],
			    ALL('REF_PNG')
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 5d6b8c6b-ca7d-49a0-bb8b-ad92bf2fb9e3

	measure 'Value for 100% Bar' = 1
		formatString: 0%;-0%;0%
		lineageTag: 17ca9566-5cde-495a-9088-81b79a28955f

	measure 'Median Age' =
			
			
			MEDIAN('DAT_PLS_Summary'[DerivedAge])
		formatString: 0
		lineageTag: b00cfba4-c91a-4817-9d15-6026ceafacf4

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Selected PNG' = MAX('REF_PNG'[ACGPatientNeedsGroup])
		lineageTag: eb54b4d4-8d03-496e-a342-1c1796192693

	measure 'Latest Date' = ```
			
			
			VAR _PLS_SUMMARY_DATE = 
			
			FORMAT(
			    MAX('DAT_PLS_Summary'[Last_Updated]),
			    "MMM-YYYY"
			)
			
			RETURN
			
			CONCATENATE("Data taken: ", _PLS_SUMMARY_DATE)
			```
		lineageTag: 7253accc-ad43-4704-beba-85815fbfd663

	measure 'Most Common Deprivation' =
			
			VAR IMDSummary =
			    ADDCOLUMNS(
			        VALUES(DAT_PLS_Summary[Gloucester_Deprivation]),
			        "IMDCount", CALCULATE(COUNT(DAT_PLS_Summary[Gloucester_Deprivation]))
			    )
			
			VAR TopRow =
			    TOPN(1, IMDSummary, [IMDCount], DESC)
			
			VAR TotalCohort =
			    COUNT(DAT_PLS_Summary[Gloucester_Deprivation])
			
			VAR CountOfTop =
			    MAXX(TopRow, [IMDCount])
			
			VAR IMDName =
			    MAXX(TopRow, DAT_PLS_Summary[Gloucester_Deprivation])
			
			VAR Pct =
			    DIVIDE(CountOfTop, TotalCohort)
			
			RETURN
			    IMDName
			        & " ("
			        & FORMAT(Pct, "0%")
			        & ")"
		lineageTag: b653c359-e1c8-4849-bb8d-86a89861ec2c

	measure 'Most Common Gender' =
			
			VAR GenderSummary =
			    ADDCOLUMNS(
			        VALUES(DAT_PLS_Summary[Gender]),
			        "GenderCount", CALCULATE(COUNT(DAT_PLS_Summary[Gender]))
			    )
			
			VAR TopRow =
			    TOPN(1, GenderSummary, [GenderCount], DESC)
			
			VAR TotalCohort =
			    COUNT(DAT_PLS_Summary[Gender])
			
			VAR CountOfTop =
			    MAXX(TopRow, [GenderCount])
			
			VAR GenderName =
			    MAXX(TopRow, DAT_PLS_Summary[Gender])
			
			VAR Pct =
			    DIVIDE(CountOfTop, TotalCohort)
			
			RETURN
			    GenderName
			        & " ("
			        & FORMAT(Pct, "0%")
			        & ")"
		lineageTag: ca1bb736-eca0-4974-a2bf-aaef0d58e29c

	measure 'Median High Service Use Risk' =
			
			
			MEDIAN(
			    'DAT_ACG'[High_User_Risk]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: d3c4ac6a-8440-47e8-bd55-675afd31e2d6

	measure 'Median Emergency Admission Risk' =
			
			
			MEDIAN(
			    'DAT_ACG'[Emergency_Admission_Risk]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: fc36eb91-6dd2-41ef-9a78-beb58bbbd834

	measure 'Median High Prescription Risk' =
			
			
			MEDIAN(
			    'DAT_ACG'[High_Pharmacy_Risk]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 71f28630-6818-4031-b3ec-b2f9e188166b

	measure 'Median Long Stay Risk' =
			
			
			MEDIAN(
			    'DAT_ACG'[Long_Stay_Risk]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 925fb91f-a098-41c3-828a-f2a6c890f422

	measure 'Total Population (% Card)' =
			
			VAR FilteredPop =
			    SUM('DAT_PLS_Summary'[Counter])
			
			VAR AllPop =
			    CALCULATE(
			        SUM('DAT_PLS_Summary'[Counter]),
			        ALL(REF_PNG[ACGPatientNeedsGroup])
			    )
			
			RETURN
			FORMAT(FilteredPop, "#,##0")
			    & " ("
			    & FORMAT(DIVIDE(FilteredPop, AllPop), "0%")
			    & ")"
		lineageTag: b5649c87-27e1-4e32-bee5-71a2e54118ab

	measure 'Median Emergency Admission Risk ''1''' =
			
			
			1 - [Median Emergency Admission Risk]
		lineageTag: cf308a7e-1cfb-4bcd-88a5-aff97f04d63e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Median High Service Use Risk ''1''' =
			
			
			1 - [Median High Service Use Risk]
		lineageTag: bc84d7e6-beff-4783-8029-2b8d6af73f3f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Median High Prescription Risk ''1''' =
			
			
			1 - [Median High Prescription Risk]
		lineageTag: 5166f3be-ebc2-4245-b95f-086c1b1ec16b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Median Long Stay Risk ''1''' =
			
			
			1 - [Median Long Stay Risk]
		lineageTag: b896b720-c3bc-4c18-93e1-b0ea2df002b7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

