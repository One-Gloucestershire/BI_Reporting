	measure 'Selected Cohort Activity Referrals (Yearly or Monthly Population)' = ```
			
			
			VAR Referral_Monthly_AS_Rate = [Local Monthly Age Standardised Rate per 1000 (Referrals)]
			VAR Referral_Yearly_AS_Rate = [Local Yearly Age Standardised Rate per 1000 (Referrals)]
			VAR Referral_Monthly_Crude_Rate = [Crude Monthly Local Rate per 1000 (Referrals)]
			VAR Referral_Yearly_Crude_Rate = [Crude Yearly Local Rate per 1000 (Referrals)]
			VAR Referral_Actual_Activity = [Number of Referrals]
			
			VAR Treatment_Monthly_AS_Rate = [Local Monthly Age Standardised Rate per 1000 (Treatments)]
			VAR Treatment_Yearly_AS_Rate = [Local Yearly Age Standardised Rate per 1000 (Treatments)]
			VAR Treatment_Monthly_Crude_Rate = [Crude Monthly Local Rate per 1000 (Treatments)]
			VAR Treatment_Yearly_Crude_Rate = [Crude Yearly Local Rate per 1000 (Treatments)]
			VAR Treatment_Actual_Activity = [Number of Treatments]
			
			VAR Deaths_Monthly_AS_Rate = [Local Monthly Age Standardised Rate per 1000 (Deaths)]
			VAR Deaths_Yearly_AS_Rate = [Local Yearly Age Standardised Rate per 1000 (Deaths)]
			VAR Deaths_Monthly_Crude_Rate = [Crude Monthly Local Rate per 1000 (Deaths)]
			VAR Deaths_Yearly_Crude_Rate = [Crude Yearly Local Rate per 1000 (Deaths)]
			VAR Deaths_Actual_Activity = [Local Events (Cancer Deaths)]
			
			
			VAR activity_type = SELECTEDVALUE('Activity Type Ref'[Locality Slicer Activity Type])
			
			VAR referral_or_treatment = SELECTEDVALUE('Referral or Treatment'[Referral or Treatment])
			
			VAR time_frame = 
			    SELECTCOLUMNS (
			        SUMMARIZE ( 'Locality Time X-Axis', 'Locality Time X-Axis'[Locality Time X-Axis], 'Locality Time X-Axis'[Time X-Axis Fields] ),
			        'Locality Time X-Axis'[Locality Time X-Axis])
			
			
			VAR final = IFERROR(if(activity_type = "Actual Activity" && referral_or_treatment = "Referral"
			        ,Referral_Actual_Activity,
			
			        if(activity_type = "Age Standardised Rate per 1000" && time_frame = "Monthly" && referral_or_treatment = "Referral"
			        ,Referral_Monthly_AS_Rate, 
			
			        if(activity_type = "Age Standardised Rate per 1000" && time_frame = "Yearly" && referral_or_treatment = "Referral"
			        ,Referral_Yearly_AS_Rate, 
			
			        if(activity_type = "Crude Rate per 1000" && time_frame = "Monthly" && referral_or_treatment = "Referral"
			        ,Referral_Monthly_Crude_Rate, 
			
			        if(activity_type = "Crude Rate per 1000" && time_frame = "Yearly" && referral_or_treatment = "Referral"
			        ,Referral_Yearly_Crude_Rate,
			
			        if(activity_type = "Actual Activity" && referral_or_treatment = "Treatment"
			        ,Treatment_Actual_Activity,
			
			        if(activity_type = "Age Standardised Rate per 1000" && time_frame = "Monthly" && referral_or_treatment = "Treatment"
			        ,Treatment_Monthly_AS_Rate, 
			
			        if(activity_type = "Age Standardised Rate per 1000" && time_frame = "Yearly" && referral_or_treatment = "Treatment"
			        ,Treatment_Yearly_AS_Rate, 
			
			        if(activity_type = "Crude Rate per 1000" && time_frame = "Monthly" && referral_or_treatment = "Treatment"
			        ,Treatment_Monthly_Crude_Rate, 
			
			        if(activity_type = "Crude Rate per 1000" && time_frame = "Yearly" && referral_or_treatment = "Treatment"
			        ,Treatment_Yearly_Crude_Rate,
			
			        if(activity_type = "Actual Activity" && referral_or_treatment = "Deaths"
			        ,Deaths_Actual_Activity,
			
			        if(activity_type = "Age Standardised Rate per 1000" && time_frame = "Monthly" && referral_or_treatment = "Deaths"
			        ,Deaths_Monthly_AS_Rate, 
			
			        if(activity_type = "Age Standardised Rate per 1000" && time_frame = "Yearly" && referral_or_treatment = "Deaths"
			        ,Deaths_Yearly_AS_Rate, 
			
			        if(activity_type = "Crude Rate per 1000" && time_frame = "Monthly" && referral_or_treatment = "Deaths"
			        ,Deaths_Monthly_Crude_Rate, 
			
			        if(activity_type = "Crude Rate per 1000" && time_frame = "Yearly" && referral_or_treatment = "Deaths"
			        ,Deaths_Yearly_Crude_Rate
			       
			        ,0))))))))))))))),0)
			
			RETURN IF(final<0.000000001,0,final)
			```
		lineageTag: d25d785a-2a1d-4b2c-94f0-7dd16ab560ca

