	measure 'Selected Cohort Activity (Current Population)' = ```
			
			
			VAR Referral_AS_Rate = [Local Age Standardised Rate per 1000 (Referrals)]
			VAR Referral_Crude_Rate = [Crude Local Rate per 1000 (Referrals)]
			VAR Referral_Actual_Activity = [Number of Referrals]
			
			VAR Treatment_AS_Rate = CALCULATE([Local Age Standardised Rate per 1000 (Treatments)], USERELATIONSHIP('Referrals & Treatments'[Diagnosed Cancer Type (Unknowns Removed)],'Cancer Type Ref'[Cancer Type (Fixed)]))
			VAR Treatment_Crude_Rate = CALCULATE([Crude Local Rate per 1000 (Treatments)], USERELATIONSHIP('Referrals & Treatments'[Diagnosed Cancer Type (Unknowns Removed)],'Cancer Type Ref'[Cancer Type (Fixed)]))
			VAR Treatment_Actual_Activity = CALCULATE([Number of Treatments], USERELATIONSHIP('Referrals & Treatments'[Diagnosed Cancer Type (Unknowns Removed)],'Cancer Type Ref'[Cancer Type (Fixed)]))
			
			VAR Deaths_AS_Rate = [Local Age Standardised Rate per 1000 (Cancer Deaths)]
			VAR Deaths_Crude_Rate = [Crude Local Rate per 1000 (Cancer Deaths)]
			VAR Deaths_Actual_Activity = SUM('Cancer Deaths'[counter])
			
			VAR activity_type = SELECTEDVALUE('Activity Type Ref'[Demographics Slicer Activity Type])
			
			VAR referral_or_treatment = SELECTEDVALUE('Referral or Treatment'[Referral or Treatment])
			
			
			
			RETURN IFERROR(if(activity_type = "Actual Activity" && referral_or_treatment = "Referral"
			        ,Referral_Actual_Activity,
			
			        if(activity_type = "Age Standardised Rate per 1000" && referral_or_treatment = "Referral"
			        ,Referral_AS_Rate, 
			
			        if(activity_type = "Crude Rate per 1000" && referral_or_treatment = "Referral"
			        ,Referral_Crude_Rate, 
			
			        if(activity_type = "Actual Activity" && referral_or_treatment = "Treatment"
			        ,Treatment_Actual_Activity,
			
			        if(activity_type = "Age Standardised Rate per 1000" && referral_or_treatment = "Treatment"
			        ,Treatment_AS_Rate, 
			
			        if(activity_type = "Crude Rate per 1000" && referral_or_treatment = "Treatment"
			        ,Treatment_Crude_Rate, 
			
			        if(activity_type = "Actual Activity" && referral_or_treatment = "Deaths"
			        ,Deaths_Actual_Activity,
			
			        if(activity_type = "Age Standardised Rate per 1000" && referral_or_treatment = "Deaths"
			        ,Deaths_AS_Rate, 
			
			        if(activity_type = "Crude Rate per 1000" && referral_or_treatment = "Deaths"
			        ,Deaths_Crude_Rate
			
			
			        ,BLANK()))))))))),BLANK())
			```
		lineageTag: 52d788da-bd13-4ecf-a610-ced60c90342a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Time Series Graph Title with Legend' = ```
			
			
			VAR activity_type = SELECTEDVALUE('Activity Type Ref'[Demographics Slicer Activity Type])
			
			VAR time_frame = 
			    SELECTCOLUMNS (
			        SUMMARIZE ( 'Locality Time X-Axis', 'Locality Time X-Axis'[Locality Time X-Axis], 'Locality Time X-Axis'[Time X-Axis Fields] ),
			        'Locality Time X-Axis'[Locality Time X-Axis])
			
			VAR legend_selected = 
			    SELECTCOLUMNS (
			        SUMMARIZE ( 'Demographics Legend Parameter', 'Demographics Legend Parameter'[Legend Parameter], 'Demographics Legend Parameter'[Legend Parameter Fields]),
			        'Demographics Legend Parameter'[Legend Parameter])
			
			VAR metric = IF(SELECTEDVALUE('Referral or Treatment'[Referral or Treatment]) = "Referral", "Cancer Referrals - ", IF(SELECTEDVALUE('Referral or Treatment'[Referral or Treatment]) = "Treatment", "Cancer Treatments - ",BLANK()))
			
			RETURN CONCATENATE(metric, CONCATENATE(activity_type, CONCATENATE(" by ", CONCATENATE(legend_selected, CONCATENATE(" - ", time_frame)))))
			```
		lineageTag: 69c4025a-10c0-4b0b-a96e-fda6fa0127de

