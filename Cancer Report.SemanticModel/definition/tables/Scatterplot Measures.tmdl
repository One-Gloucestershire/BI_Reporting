table 'Scatterplot Measures'
	lineageTag: 2c3b6819-95b6-4ab0-acb2-eae839bc0966

	measure 'Higher than Average Flag' = IF([Scatterplot ICB Treatments] < [Scatterplot Treatments],1,0)
		formatString: 0
		displayFolder: Non-Age Standardised
		lineageTag: 490ac9f0-25b6-495a-bb0a-efefedaa60f9

	measure 'Low Referrals & High Treatments - All Cancer Priority Types' =
			IF(
			    [Low Referrals & High Treatments Flag - Breast Cancer] = 1 &&
			    [Low Referrals & High Treatments Flag - Gynaecological cancers] = 1 &&
			    [Low Referrals & High Treatments Flag - Lung cancer] = 1 &&
			    [Low Referrals & High Treatments Flag - Gynaecological cancers] = 1 &&
			    [Low Referrals & High Treatments Flag - Urological cancers (excluding testicular)] = 1 &&
			    [Low Referrals & High Treatments Flag - Skin cancers] = 1,
			    1,0)
		formatString: 0
		displayFolder: Non-Age Standardised
		lineageTag: e34323ea-6422-4898-a92f-9bd027927703

	measure 'Low Referrals & High Treatments - All Cancer Priority Types Score' = ```
			
			    [Low Referrals & High Treatments Flag - Breast Cancer]+
			    [Low Referrals & High Treatments Flag - Gynaecological cancers]+
			    [Low Referrals & High Treatments Flag - Lung cancer]+
			    [Low Referrals & High Treatments Flag - Gynaecological cancers]+
			    [Low Referrals & High Treatments Flag - Urological cancers (excluding testicular)]+
			    [Low Referrals & High Treatments Flag - Skin cancers]
			    
			```
		formatString: 0
		displayFolder: Non-Age Standardised
		lineageTag: 8165a99c-fcaa-4da8-84e2-84b76a675f97

	measure 'Low Referrals & High Treatments Flag' = IF([Lower than Average Flag] = 1 && [Higher than Average Flag] = 1, 1, 0)
		formatString: 0
		displayFolder: Non-Age Standardised
		lineageTag: 5fe271b0-0584-4740-9666-e718b31e62fa

	measure 'Low Referrals & High Treatments Flag Description' = IF([Lower than Average Flag] = 1 && [Higher than Average Flag] = 1, "Highlted Practices", "Non-Highlighted Practices")
		displayFolder: Non-Age Standardised
		lineageTag: ee384824-40ce-46f6-92c0-4c7d5e6589a3

	measure 'Lower than Average Flag' = IF([Scatterplot ICB Referrals] > [Scatterplot Referrals],1,0)
		formatString: 0
		displayFolder: Non-Age Standardised
		lineageTag: 30aa16ef-3db8-4d21-9ece-492762a6d9ba

	measure 'Low Referrals & High Treatments Flag - Breast Cancer' = IF(CALCULATE([Lower than Average Flag], 'Referrals & Treatments'[Referral_Suspected_Cancer_Type] = "Breast cancer") = 1 && CALCULATE([Higher than Average Flag], 'Referrals & Treatments'[Referral_Suspected_Cancer_Type] = "Breast cancer") = 1, 1, 0)
		formatString: 0
		displayFolder: Non-Age Standardised
		lineageTag: 0d6481ae-271c-46d4-acfa-4b40254b3ba8

	measure 'Low Referrals & High Treatments Flag - Lower-Gastrointestinal Cancers' = IF(CALCULATE([Lower than Average Flag], 'Referrals & Treatments'[Referral_Suspected_Cancer_Type] = "Lower-Gastrointestinal Cancers") = 1 && CALCULATE([Higher than Average Flag], 'Referrals & Treatments'[Referral_Suspected_Cancer_Type] = "Lower-Gastrointestinal Cancers") = 1, 1, 0)
		formatString: 0
		displayFolder: Non-Age Standardised
		lineageTag: e4240f92-cc10-4857-835d-d7e1f1550b43

	measure 'Low Referrals & High Treatments Flag - Lung cancer' = IF(CALCULATE([Lower than Average Flag], 'Referrals & Treatments'[Referral_Suspected_Cancer_Type] = "Lung cancer") = 1 && CALCULATE([Higher than Average Flag], 'Referrals & Treatments'[Referral_Suspected_Cancer_Type] = "Lung cancer") = 1, 1, 0)
		formatString: 0
		displayFolder: Non-Age Standardised
		lineageTag: 58e7f8df-9f79-4818-9ab4-531629c03b46

	measure 'Low Referrals & High Treatments Flag - Gynaecological cancers' = IF(CALCULATE([Lower than Average Flag], 'Referrals & Treatments'[Referral_Suspected_Cancer_Type] = "Gynaecological cancers") = 1 && CALCULATE([Higher than Average Flag], 'Referrals & Treatments'[Referral_Suspected_Cancer_Type] = "Gynaecological cancers") = 1, 1, 0)
		formatString: 0
		displayFolder: Non-Age Standardised
		lineageTag: 2568ca08-cdf3-465a-a676-c6d73fbbc01d

	measure 'Low Referrals & High Treatments Flag - Urological cancers (excluding testicular)' = IF(CALCULATE([Lower than Average Flag], 'Referrals & Treatments'[Referral_Suspected_Cancer_Type] = "Urological cancers (excluding testicular)") = 1 && CALCULATE([Higher than Average Flag], 'Referrals & Treatments'[Referral_Suspected_Cancer_Type] = "Urological cancers (excluding testicular)") = 1, 1, 0)
		formatString: 0
		displayFolder: Non-Age Standardised
		lineageTag: 73d3bc13-8b72-40d2-8a54-3bf57bda1e2c

	measure 'Low Referrals & High Treatments Flag - Skin cancers' = IF(CALCULATE([Lower than Average Flag], 'Referrals & Treatments'[Referral_Suspected_Cancer_Type] = "Skin cancers") = 1 && CALCULATE([Higher than Average Flag], 'Referrals & Treatments'[Referral_Suspected_Cancer_Type] = "Skin cancers") = 1, 1, 0)
		formatString: 0
		displayFolder: Non-Age Standardised
		lineageTag: 85a09f2a-0463-4009-a676-7e81261bd9f3

	measure 'Lower than Average Flag Description' = IF([Scatterplot ICB Referrals] > [Scatterplot Referrals],"Yes","No")
		lineageTag: 5104b709-9f4a-49dd-b0b0-6649ae0a1e01

	measure 'Higher than Average Description' = IF([Scatterplot ICB Treatments] < [Scatterplot Treatments],"Yes","No")
		lineageTag: 13035917-2b10-42c6-bafe-81f289d09633

	measure 'Low Referrals & High Treatments Description' = IF([Lower than Average Flag] = 1 && [Higher than Average Flag] = 1, "Yes", "No")
		lineageTag: 51208106-6fee-41ee-9b45-489df5d74408

	measure 'Y-Axis Title' =
			
			
			VAR activity_type = SELECTEDVALUE('Activity Type Ref'[Demographics Slicer Activity Type])
			
			VAR referral_or_treatment = SELECTEDVALUE('Referral or Treatment'[Referral or Treatment])
			
			RETURN CONCATENATE(referral_or_treatment, CONCATENATE(" - ", activity_type))
		lineageTag: fa360c66-e391-4921-b3cc-a560efa70daa

	measure Scatterplot_X-Axis_Measure = ```
			
			
			VAR x_axis = SELECTEDVALUE('Scatterplot X-Axis'[Scatterplot_X-Axis])
			
			
			RETURN 
			SWITCH(TRUE(),
			x_axis = "Ethnicity", CALCULATE(CALCULATE(SUM('New Practice Population'[Ethnic_Minority_Flag]),'New Practice Population'[Current_Month_Flag] = "Current Month") / [Current_Pop],REMOVEFILTERS('Date Reference'[financial_year])),
			x_axis = "Core20", CALCULATE(CALCULATE(SUM('New Practice Population'[Core20_Flag]),'New Practice Population'[Current_Month_Flag] = "Current Month") / [Current_Pop],REMOVEFILTERS('Date Reference'[financial_year])),
			x_axis = "LD Status", CALCULATE(CALCULATE(SUM('New Practice Population'[LD_Flag]),'New Practice Population'[Current_Month_Flag] = "Current Month") / [Current_Pop],REMOVEFILTERS('Date Reference'[financial_year])),
			x_axis = "MH Status", CALCULATE(CALCULATE(SUM('New Practice Population'[MH_Flag]),'New Practice Population'[Current_Month_Flag] = "Current Month") / [Current_Pop],REMOVEFILTERS('Date Reference'[financial_year])),
			BLANK())
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4d0ce092-e82c-4651-8fc6-d2776c6ac8bc

	measure Scatterplot_X-Axis_Title = ```
			
			
			VAR x_axis = SELECTEDVALUE('Scatterplot X-Axis'[Scatterplot_X-Axis])
			
			
			RETURN 
			SWITCH(TRUE(),
			x_axis = "Ethnicity", "% of Current Population which is Known Non-White",
			x_axis = "Core20", "% of Current Population which is Core20",
			x_axis = "LD Status", "% of Current Population which has a Learning Disability",
			x_axis = "MH Status", "% of Current Population which has a Mentall Health Condition",
			BLANK())
			```
		lineageTag: b79e03f2-4a53-4455-93bc-d2d01ce4da6c

