		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'New yearly age standardisation measure (Treatments)' = ```
			
			
			 // =========================================================================
			// Stage 1: Create your base table to house your virtual pivot table 
			// =========================================================================   
			
			VAR SummaryTable =
			    SUMMARIZE(
			        'Age Band Ref',
			        'Age Band Ref'[5YR_Age_Band], -- set your age bands 
			        "Total_Local_Observed_Events", 'Referrals & Treatments'[Number of Treatments], -- set you local observed measure 
			        "Total_Local_Population", CALCULATE([Local Yearly Population (Gloucestershire)]), -- set your local population figure
			        "Reference_Events",  -- set you number of reference events i.e total Gloucestershire events
			            CALCULATE(
			                'Referrals & Treatments'[Number of Treatments], 'Referrals & Treatments'[Amended_5yr_age_band] <> BLANK(),
			                REMOVEFILTERS('GP Reference'),REMOVEFILTERS('Ethnicity Ref'),REMOVEFILTERS('Core20 Ref'),REMOVEFILTERS('LD Ref'),REMOVEFILTERS('Mental Health Ref'),REMOVEFILTERS('IMD') -- remove filters from your GP practice reference table 
			            ),
			        "Reference_Population",   ---set your number for reference population i.e. total Gloucestershire population 
			            CALCULATE(
			                [Reference Yearly Population],
			                REMOVEFILTERS('GP Reference'),REMOVEFILTERS('Ethnicity Ref'),REMOVEFILTERS('Core20 Ref'),REMOVEFILTERS('LD Ref'),REMOVEFILTERS('Mental Health Ref'),REMOVEFILTERS('IMD')-- remove filters from your GP practice reference table 
			            )
			    )
			    
			 // =========================================================================
			// Stage 2: Add in fields for reference events 
			// =========================================================================   
			
			VAR SummaryTable_with_reference_rates =
			    ADDCOLUMNS(
			        SummaryTable,
			        "Reference_Rates", DIVIDE([Reference_Events], [Reference_Population], 0)
			    )
			
			 // =========================================================================
			// Stage 3: Add in field for local expected events per age group 
			// =========================================================================   
			
			VAR SummaryTable_with_reference_rates_and_local_expected_events =
			    ADDCOLUMNS(
			        SummaryTable_with_reference_rates,
			        "Local_Expected_Events", [Reference_Rates] * [Total_Local_Population]
			    )
			
			 // ==============================================================================================================================
			// Stage 4: Obtain totals for observed and expected results (local population & reference population i.e. Gloucestershire
			// ================================================================================================================================
			
			VAR total_observed = 
			    SUMX(SummaryTable_with_reference_rates_and_local_expected_events, [Total_Local_Observed_Events])
			
			VAR total_expected = 
			    SUMX(SummaryTable_with_reference_rates_and_local_expected_events, [Local_Expected_Events])
			
			VAR total_reference_events = 
			    SUMX(SummaryTable_with_reference_rates_and_local_expected_events, [Reference_Events])
			
			VAR total_reference_population = 
			    SUMX(SummaryTable_with_reference_rates_and_local_expected_events, [Reference_Population])
			
			  // ==============================================================================================================================
			// Stage 5: Calculate the reference crude rate 
			// ================================================================================================================================
			   
			VAR reference_crude_rate = 
			    DIVIDE(total_reference_events, total_reference_population, 0) * 1000
			
			// ==============================================================================================================================
			// Stage 6: Calculate the age standarised rate
			// ================================================================================================================================
			
			VAR age_standardised_rate = 
			    DIVIDE(total_observed, total_expected, 0) * reference_crude_rate
			
			RETURN
			age_standardised_rate
			
			```
		lineageTag: 6d04887a-4ea6-4781-95de-ef960799d281

		annotation PBI_FormatHint = {"isGeneralNumber":true}

