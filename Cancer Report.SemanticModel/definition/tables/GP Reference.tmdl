table 'GP Reference'
	lineageTag: 2f0a865d-a82f-4f2d-bec2-8213a9f79637

	measure 'Number of Practices' = DISTINCTCOUNT([ReportingOrganisationName])
		formatString: 0
		lineageTag: a89c0a44-58d0-4f98-a2c7-a89634dd4efe

