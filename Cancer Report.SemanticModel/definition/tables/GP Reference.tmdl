	column OrganisationName
		dataType: string
		lineageTag: 927e40d9-dcf1-4a15-98b1-9c3e56f1430f
		summarizeBy: none
		sourceColumn: OrganisationName

		annotation SummarizationSetBy = Automatic

	hierarchy 'Locality Hierarchy'
		lineageTag: 53637824-2e5f-4ee9-a3e8-97926d785f3a

		level Locality
			lineageTag: c9802d49-a744-4ca4-875a-a3bb2a94e6a7
			column: Locality

		level PrimaryCareNetwork_2
			lineageTag: bc91eb29-726a-4258-99b6-4792fff579e4
			column: PrimaryCareNetwork_2

		level ReportingOrganisationName
			lineageTag: 73a0f9d8-0d4a-42e5-8952-4d108afb1953
			column: ReportingOrganisationName

	partition 'GP Reference' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db01_reference"), "with gp as (select case when locality='North Cotswolds' then 'Cotswolds' when locality='South Cotswolds' then 'Cotswolds' when locality='Tewkesbury Newent and Staunton' then 'Tewkesbury' when reportingorganisationname='West Cheltenham Medical' then 'Tewkesbury' else locality end as ""Locality"", case when reportingorganisationname='West Cheltenham Medical' then 'TWNS' when primarycarenetwork='Tewkesbury, Newent and Staunton and West Cheltenham Medical' then 'TWNS' else primarycarenetwork end as ""PrimaryCareNetwork"", case when reportingorganisationcode='L84073' then 'L84075' when reportingorganisationcode='L84017' then 'L84018' else reportingorganisationcode end as ""ReportingOrganisationCode"", case when reportingorganisationname='Acorn Practice' then 'May Lane Surgery' when reportingorganisationname='Regent Street Surgery' then 'The Willow Tree Practice' when reportingorganisationname='Coleford Family Doctors' then 'Coleford Medical Practice' else reportingorganisationname end as ""ReportingOrganisationName"", organisationname as ""OrganisationName"", organisationcode as ""OrganisationCode"" from icb_data_reference.vw_gppractice where commissioner ilike '11m%' and locality is not null) select distinct gp.""Locality"", gp.""ReportingOrganisationCode"", gp.""ReportingOrganisationName"", gp.""OrganisationCode"", gp.""OrganisationName"", case when gp.""ReportingOrganisationName""='Culverhay Surgery' then 'Berkeley Vale' else gp.""PrimaryCareNetwork"" end as ""PrimaryCareNetwork_2"", 'Localities' as ""Hierachy_slicer_top"" from gp where gp.""ReportingOrganisationName"" not like 'St.Luke''s Medical Centre' order by gp.""ReportingOrganisationCode"", gp.""ReportingOrganisationName""", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Exception

	annotation PBI_NavigationStepName = Navigation

