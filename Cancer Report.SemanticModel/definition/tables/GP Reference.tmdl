	partition 'GP Reference' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Reference", [Query="#(lf)SELECT [Locality] = CASE WHEN [Locality] LIKE 'North Cotswolds' THEN 'Cotswolds'#(lf)#(lf)                         WHEN [Locality] LIKE 'South Cotswolds' THEN 'Cotswolds'#(lf)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN [Locality] LIKE 'Tewkesbury Newent and Staunton' THEN 'Tewkesbury'#(lf)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN [ReportingOrganisationName] LIKE 'West Cheltenham Medical' THEN 'Tewkesbury'#(lf)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) ELSE [Locality] END#(lf)#(lf)      ,[PrimaryCareNetwork] = CASE WHEN [ReportingOrganisationName] LIKE 'West Cheltenham Medical' THEN 'TWNS'#(lf)#(lf)#(tab)                               WHEN [PrimaryCareNetwork] LIKE 'Tewkesbury, Newent and Staunton and West Cheltenham Medical' THEN 'TWNS'#(lf)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   ELSE [PrimaryCareNetwork] END#(lf)#(lf)#(lf)#(tab)  ,[ReportingOrganisationCode] = CASE WHEN [ReportingOrganisationCode] LIKE 'L84073' THEN 'L84075' /*Acorn Practice*/#(lf)#(lf)#(tab)                                      WHEN [ReportingOrganisationCode] LIKE 'L84017' THEN 'L84018' /*Cirencester Health Group*/#(lf)#(lf)#(tab)                                      ELSE [ReportingOrganisationCode] END #(lf)#(lf)#(tab)  ,[ReportingOrganisationName] = CASE WHEN [ReportingOrganisationName] LIKE 'Acorn Practice' THEN 'May Lane Surgery' #(lf)#(lf)#(tab)                                      WHEN [ReportingOrganisationName] LIKE 'Regent Street Surgery' THEN 'The Willow Tree Practice'#(lf)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)  WHEN [ReportingOrganisationName] LIKE 'Coleford Family Doctors' THEN 'Coleford Medical Practice'#(lf)#(lf)#(tab)                                      ELSE [ReportingOrganisationName] END#(lf)#(lf)#(lf)#(tab)#(tab),OrganisationName#(lf)#(tab)#(tab),OrganisationCode#(lf)#(lf)INTO #TEMP#(lf)#(lf)FROM [CCG_Reference].[Reference].[vw_GPPractice]#(lf) #(lf)WHERE [Commissioner] = '11M'#(lf)#(lf)AND [Locality] IS NOT NULL#(lf)#(lf);#(lf) #(lf)SELECT distinct [GP].Locality#(lf),ReportingOrganisationCode#(lf),ReportingOrganisationName#(lf),OrganisationCode#(lf),OrganisationName#(lf)#(lf)#(tab) --,[COORD].[GPLatitude]#(lf)#(lf)#(tab)  ,PrimaryCareNetwork_2 = case when ReportingOrganisationName like 'Culverhay Surgery' then 'Berkeley Vale' else PrimaryCareNetwork end#(lf)#(lf)#(tab)  --,[COORD].[GPLongitude]#(lf)#(tab)  ,[Hierachy_slicer_top] = 'Localities'#(lf) #(lf)FROM #TEMP AS [GP]#(lf) #(lf)--LEFT JOIN (SELECT DISTINCT [GP_Practice_Code], [GPLatitude], [GPLongitude]#(lf)#(lf)--           FROM [PowerBI_Reporting].[dbo].[tbl_Demographics_Population_Overview]) [COORD] ON [COORD].[GP_Practice_Code] = [GP].[ReportingOrganisationCode]#(lf)#(lf)where reportingorganisationname not like 'St.Luke''s Medical Centre'#(lf)#(lf)#(tab)#(tab)   order by ReportingOrganisationCode, ReportingOrganisationName"])
				in
				    Source

	annotation PBI_ResultType = Exception

	annotation PBI_NavigationStepName = Navigation

