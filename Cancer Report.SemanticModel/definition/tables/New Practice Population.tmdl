	column 'Population YTD' = ```
			
			VAR current_month = MONTH('New Practice Population'[Census_Date])
			VAR f_current_month = SWITCH(TRUE(),
			current_month = 4, 1,
			current_month = 5, 2,
			current_month = 6, 3,
			current_month = 7, 4,
			current_month = 8, 5,
			current_month = 9, 6,
			current_month = 10, 7,
			current_month = 11, 8,
			current_month = 12, 9,
			current_month = 1, 10,
			current_month = 2, 11,
			current_month = 3, 12
			)
			VAR max_month = MONTH(MAX('New Practice Population'[Census_Date]))
			VAR f_max_month = SWITCH(TRUE(),
			max_month = 4, 1,
			max_month = 5, 2,
			max_month = 6, 3,
			max_month = 7, 4,
			max_month = 8, 5,
			max_month = 9, 6,
			max_month = 10, 7,
			max_month = 11, 8,
			max_month = 12, 9,
			max_month = 1, 10,
			max_month = 2, 11,
			max_month = 3, 12
			)
			return if(f_current_month <= f_max_month, "Year to Date", "Not Year to Date")
			
			```
		lineageTag: adbfc3ac-c3dd-4f2a-9044-23d929a2d43b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Current Year Flag' = ```
			
			VAR max_year = YEAR(MAX('New Practice Population'[Census_Date]
			))
			VAR max_month = MONTH(MAX('New Practice Population'[Census_Date]
			))
			VAR financial_month = SWITCH(TRUE(),
			max_month = 4, 1,
			max_month = 5, 2,
			max_month = 6, 3,
			max_month = 7, 4,
			max_month = 8, 5,
			max_month = 9, 6,
			max_month = 10, 7,
			max_month = 11, 8,
			max_month = 12, 9,
			max_month = 1, 10,
			max_month = 2, 11,
			max_month = 3, 12
			)
			VAR current_year = SWITCH(TRUE(),
			max_month = 1, max_year - 1,
			max_month = 2, max_year - 1,
			max_month = 3, max_year - 1,
			max_month = 4, max_year,
			max_month = 5, max_year,
			max_month = 6, max_year,
			max_month = 7, max_year,
			max_month = 8, max_year,
			max_month = 9, max_year,
			max_month = 10, max_year,
			max_month = 11, max_year,
			max_month = 12, max_year
			
			)
			VAR adjusted_year = if(
			    MONTH('New Practice Population'[Census_Date])= 1, YEAR('New Practice Population'[Census_Date]
			) -1, 
			    if(MONTH('New Practice Population'[Census_Date]) = 2, YEAR('New Practice Population'[Census_Date]
			) -1, 
			    if(MONTH('New Practice Population'[Census_Date]) = 3, YEAR('New Practice Population'[Census_Date]
			) -1, year('New Practice Population'[Census_Date]
			))))
			
			var year_flag = IF(adjusted_year = current_year, "Current Year", IF(adjusted_year = current_year - 1, "Previous Year", "Other Year"))
			
			RETURN year_flag
			```
		lineageTag: 45a1b8fc-d6a3-4b42-8239-9c8407eb1238
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

