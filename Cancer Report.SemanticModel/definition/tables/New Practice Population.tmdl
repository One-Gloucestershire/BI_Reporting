table 'New Practice Population'
	lineageTag: 7a74d62d-45a1-437f-b359-d5fbb8c9bc7b

	measure Pop = CALCULATE(SUM('New Practice Population'[population]))
		formatString: 0
		lineageTag: 3d1fcc3e-64a5-4590-9c3c-0d372ebcafeb

	measure Current_Pop =
			
			
			VAR max_date = MAX('New Practice Population'[Census_Date])
			
			RETURN CALCULATE(SUM('New Practice Population'[population]),'New Practice Population'[Census_Date] = max_date)
		formatString: 0
		lineageTag: ad94920a-6963-47d7-b489-c93977599da5

	measure April_Pop =
			
			
			CALCULATE(SUM('New Practice Population'[population]),'Date Reference'[month_name] = "Apr")
		formatString: 0
		lineageTag: eec7c44c-5784-4b5e-854b-e5a1c835a67a

	measure '% Current Population is Asian' = CALCULATE([Current_Pop],'New Practice Population'[Ethnicity]="Asian or Asian British") / [Current_Pop]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: fab7f9f6-9712-45f4-82d1-85a4ba47d1dc

	measure '% Current Population is Black' = CALCULATE([Current_Pop],'New Practice Population'[Ethnicity]="Black or Black British") / [Current_Pop]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ed24999b-5ff9-495e-b635-1ad59f959f51

	measure '% Current Population is Mixed Race' = CALCULATE([Current_Pop],'New Practice Population'[Ethnicity]="Mixed") / [Current_Pop]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4f9ff1b7-f820-4637-b82c-fbfe8756200e

	measure '% Current Population is Other Ethnic Groups' = CALCULATE([Current_Pop],'New Practice Population'[Ethnicity]="Other Ethnic Groups") / [Current_Pop]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 2a1a686d-0d2b-49ce-89e8-c43978c60158

	measure '% Current Population is Unknown Ethnicity' = CALCULATE([Current_Pop],'New Practice Population'[Ethnicity]="Unknown") / [Current_Pop]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 1276edd5-49c4-4c69-9a2f-d9090767d758

	measure '% Current Population is White' = CALCULATE([Current_Pop],'New Practice Population'[Ethnicity]="White") / [Current_Pop]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 986f2334-446e-4376-a758-90ce95ea6253

	measure '% Current Population is Core20' = CALCULATE([Current_Pop],'New Practice Population'[Core20_Status] = "Core20") / [Current_Pop]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 5888ce2a-d4ce-4ae2-9aa9-39df9d5958bc

	measure '% Current Population is Non-Core20' = CALCULATE([Current_Pop],'New Practice Population'[Core20_Status] = "Not Core20") / [Current_Pop]
		lineageTag: 9b3674c7-07c3-4c06-94fb-f854e09bcc40

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Current Population is LD' = CALCULATE([Current_Pop],'New Practice Population'[LD_Status] = "Learning Disability Patients") / [Current_Pop]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d1b227cb-242d-4e42-8831-cebb48c56052

	measure '% Current Population is Non-LD' = CALCULATE([Current_Pop],'New Practice Population'[LD_Status] = "Non-Learning Disability Patients") / [Current_Pop]
		lineageTag: cb2a6dab-f46a-43e3-9cd8-3bc59f3453fb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Current Population is MH' = CALCULATE([Current_Pop],'New Practice Population'[MH_Status] = "Mental Health Patients") / [Current_Pop]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 44a89435-d1bc-47c7-bcd8-4a777c76e4a7

	measure '% Current Population is Non-MH' = CALCULATE([Current_Pop],'New Practice Population'[MH_Status] = "Non-Mental Health Patients") / [Current_Pop]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9fd88dd5-43de-4798-95cf-d46accc945b4

	measure '% Current Population is Female' = CALCULATE([Current_Pop],'New Practice Population'[Sex] = "Female") / [Current_Pop]
		lineageTag: 8c295d2f-b743-4f70-a7f5-3f4a3a1977cd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Current Population is Male' = CALCULATE([Current_Pop],'New Practice Population'[Sex] = "Male") / [Current_Pop]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: fb75f1c0-75dc-4f28-93a9-12071c848a8f

	measure '% of Current Population is Known Non-White' = [% Current Population is Asian] + [% Current Population is Black] + [% Current Population is Mixed Race] + [% Current Population is Other Ethnic Groups]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 2211b1e1-4a3b-42ec-b2b4-152474cf6e4c

