	column 'Referral Current Financial Year Flag Description' = ```
			
			
			VAR currmonth = MONTH('Referrals & Treatments'[Cancer_Referral_To_Treatment_Period_Start_Date])
			VAR fin_month = SWITCH(TRUE(),
			currmonth = 4, 1,
			currmonth = 5, 2,
			currmonth = 6, 3,
			currmonth = 7, 4,
			currmonth = 8, 5,
			currmonth = 9, 6,
			currmonth = 10, 7,
			currmonth = 11, 8,
			currmonth = 12, 9,
			currmonth = 1, 10,
			currmonth = 2, 11,
			currmonth = 3, 12
			)
			
			
			VAR year_adjusted = if(
			    fin_month = 10, YEAR('Referrals & Treatments'[Cancer_Referral_To_Treatment_Period_Start_Date]) -1, 
			    if(fin_month = 11, YEAR('Referrals & Treatments'[Cancer_Referral_To_Treatment_Period_Start_Date]) -1, 
			    if(fin_month = 12, YEAR('Referrals & Treatments'[Cancer_Referral_To_Treatment_Period_Start_Date]) -1, year('Referrals & Treatments'[Cancer_Referral_To_Treatment_Period_Start_Date]))))
			
			
			
			VAR max_year = YEAR(MAX('Referrals & Treatments'[Cancer_Referral_To_Treatment_Period_Start_Date]
			))
			VAR max_month = MONTH(MAX('Referrals & Treatments'[Cancer_Referral_To_Treatment_Period_Start_Date]
			))
			
			VAR max_adjust_year = SWITCH(TRUE(),
			max_month = 1, max_year - 1,
			max_month = 2, max_year - 1,
			max_month = 3, max_year - 1,
			max_month = 4, max_year,
			max_month = 5, max_year,
			max_month = 6, max_year,
			max_month = 7, max_year,
			max_month = 8, max_year,
			max_month = 9, max_year,
			max_month = 10, max_year,
			max_month = 11, max_year,
			max_month = 12, max_year
			)
			
			RETURN IF(year_adjusted = max_adjust_year, "Current year", "Not current year")
			
			
			```
		lineageTag: 725e632d-e5ed-4464-bba4-b5f874d2c384
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Treatment Current Financial Year Flag Description' = ```
			
			
			VAR currmonth = MONTH('Referrals & Treatments'[Cancer_Treatment_Period_Start_Date])
			VAR fin_month = SWITCH(TRUE(),
			currmonth = 4, 1,
			currmonth = 5, 2,
			currmonth = 6, 3,
			currmonth = 7, 4,
			currmonth = 8, 5,
			currmonth = 9, 6,
			currmonth = 10, 7,
			currmonth = 11, 8,
			currmonth = 12, 9,
			currmonth = 1, 10,
			currmonth = 2, 11,
			currmonth = 3, 12
			)
			
			
			VAR year_adjusted = if(
			    fin_month = 10, YEAR('Referrals & Treatments'[Cancer_Treatment_Period_Start_Date]) -1, 
			    if(fin_month = 11, YEAR('Referrals & Treatments'[Cancer_Treatment_Period_Start_Date]) -1, 
			    if(fin_month = 12, YEAR('Referrals & Treatments'[Cancer_Treatment_Period_Start_Date]) -1, year('Referrals & Treatments'[Cancer_Treatment_Period_Start_Date]))))
			
			
			
			VAR max_year = YEAR(MAX('Referrals & Treatments'[Cancer_Treatment_Period_Start_Date]
			))
			VAR max_month = MONTH(MAX('Referrals & Treatments'[Cancer_Treatment_Period_Start_Date]
			))
			
			VAR max_adjust_year = SWITCH(TRUE(),
			max_month = 1, max_year - 1,
			max_month = 2, max_year - 1,
			max_month = 3, max_year - 1,
			max_month = 4, max_year,
			max_month = 5, max_year,
			max_month = 6, max_year,
			max_month = 7, max_year,
