table 'Referrals & Treatments'
	lineageTag: 1e6c1203-5f26-410d-ab27-c849e6041b06

	measure 'Rate per 1000 All Referrrals Current Year' =
			
			VAR total_referrals = CALCULATE ([Number of Referrals], 'Referrals & Treatments'[Referral Current Financial Year Flag Description] = "Current year")
			VAR pop =  CALCULATE([April_Pop], 'New Practice Population'[Current Year Flag] = "Current year")
			RETURN CALCULATE(total_referrals/pop * 1000)
		lineageTag: 32fd5871-b0f2-40d7-ab4c-16a0632a853e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Number of Referrals' = CALCULATE(SUM('Referrals & Treatments'[Cancer_Referral_Flag]),USERELATIONSHIP ( 'Referrals & Treatments'[Cancer_Referral_To_Treatment_Period_Start_Date], 'Date Reference'[Date] )     )
		formatString: 0
		lineageTag: 32035359-a3ff-4a26-a306-4cff6082365e

	measure 'Number of Treatments' = CALCULATE(SUM('Referrals & Treatments'[Cancer_Treatment_Flag]),USERELATIONSHIP ( 'Referrals & Treatments'[Cancer_Treatment_Period_Start_Date], 'Date Reference'[Date] ) ,USERELATIONSHIP('Referrals & Treatments'[Diagnosed Cancer Type (Unknowns Removed)],'Cancer Type Ref'[Cancer Type (Fixed)])    )
		formatString: 0
		lineageTag: a02fb387-5360-4c20-aa82-47d1b4001ac4

	measure 'Rate per 1000 Treatments Current Year' =
			
			VAR total_referrals = CALCULATE ([Number of Treatments], 'Referrals & Treatments'[Treatment Current Financial Year Flag Description] = "Current year")
			VAR pop =  CALCULATE([April_Pop], 'New Practice Population'[Current Year Flag]  = "Current year")
			RETURN CALCULATE(total_referrals/pop * 1000)
		lineageTag: 6ca4a5af-77b1-4919-9263-95970238f60c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Diagnosed Cancer Type Filter Selected' = SELECTEDVALUE('Referrals & Treatments'[Diagnosed_Cancer_Type])
		lineageTag: 0ddadccd-37f4-421a-951f-0dbffa2c3f4c

	measure 'Cancer Treatments Title' = CONCATENATE("Number of Cancer Treatments - ", [Diagnosed Cancer Type Filter Selected])
		lineageTag: 9a41312b-4494-4fe5-97bf-bc2b533c4a33

	measure 'Survivability for 1 Year' = ```
			
			
			var treatments = CALCULATE(COUNT('Referrals & Treatments'[Cancer_Treatment_Flag]),'Referrals & Treatments'[Pseudo_NHS_Number] <> BLANK(),USERELATIONSHIP ( 'Referrals & Treatments'[Cancer_Treatment_Period_Start_Date], 'Date Reference'[Date] )     )
			
			var figure = CALCULATE
			(
			    (
			        treatments - (SUM('Referrals & Treatments'[Death_from_treatment_within_one_year])))
			     / treatments
			     
			     ,USERELATIONSHIP('Referrals & Treatments'[Cancer_Treatment_Period_Start_Date],'Date Reference'[date]))
			
			RETURN IF(figure < 0, BLANK(), figure)
			```
		formatString: #,0.00%;-#,0.00%;#,0.00%
		lineageTag: 4730c132-a8fd-4fc6-b25d-e5eb7814ab5c

