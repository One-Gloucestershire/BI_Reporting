	column 'Current Year Flag (Referral)' = ```
			
			VAR max_year = YEAR(MAX('Referrals & Treatments'[Cancer_Referral_To_Treatment_Period_Start_Date]
			))
			VAR max_month = MONTH(MAX('Referrals & Treatments'[Cancer_Referral_To_Treatment_Period_Start_Date]
			))
			VAR financial_month = SWITCH(TRUE(),
			max_month = 4, 1,
			max_month = 5, 2,
			max_month = 6, 3,
			max_month = 7, 4,
			max_month = 8, 5,
			max_month = 9, 6,
			max_month = 10, 7,
			max_month = 11, 8,
			max_month = 12, 9,
			max_month = 1, 10,
			max_month = 2, 11,
			max_month = 3, 12
			)
			VAR current_year = SWITCH(TRUE(),
			max_month = 1, max_year - 1,
			max_month = 2, max_year - 1,
			max_month = 3, max_year - 1,
			max_month = 4, max_year,
			max_month = 5, max_year,
			max_month = 6, max_year,
			max_month = 7, max_year,
			max_month = 8, max_year,
			max_month = 9, max_year,
			max_month = 10, max_year,
			max_month = 11, max_year,
			max_month = 12, max_year
			
			)
			VAR adjusted_year = if(
			    MONTH('Referrals & Treatments'[Cancer_Referral_To_Treatment_Period_Start_Date])= 1, YEAR('Referrals & Treatments'[Cancer_Referral_To_Treatment_Period_Start_Date]
			) -1, 
			    if(MONTH('Referrals & Treatments'[Cancer_Referral_To_Treatment_Period_Start_Date]) = 2, YEAR('Referrals & Treatments'[Cancer_Referral_To_Treatment_Period_Start_Date]
			) -1, 
			    if(MONTH('Referrals & Treatments'[Cancer_Referral_To_Treatment_Period_Start_Date]) = 3, YEAR('Referrals & Treatments'[Cancer_Referral_To_Treatment_Period_Start_Date]
			) -1, year('Referrals & Treatments'[Cancer_Referral_To_Treatment_Period_Start_Date]
			))))
			
			var year_flag = IF(adjusted_year = current_year, "Current Year", IF(adjusted_year = current_year - 1, "Previous Year", "Other Year"))
			
			RETURN year_flag
			```
		lineageTag: c30c3e8a-9153-4e5a-9e8e-9c9f44756829
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Last 12 Months Flag' =
			
			
			var max_date = MAX('Referrals & Treatments'[Cancer_Referral_To_Treatment_Period_Start_Date])
			var year_prior = EDATE(max_date,-12)
			
			RETURN IF('Referrals & Treatments'[Cancer_Referral_To_Treatment_Period_Start_Date] > year_prior, 1,0)
		formatString: 0
		lineageTag: 9c492221-404f-4283-9a7b-7a3a2cac618a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

