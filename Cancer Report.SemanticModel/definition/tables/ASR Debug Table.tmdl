		sourceColumn: [Local_Expected_Events]

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition 'ASR Debug Table' = calculated
		mode: import
		source = ```
				
				
				VAR max_date = MAX('New Practice Population'[Census_Date])
				
				VAR SummaryTable =
				    SUMMARIZE(
				        'Age Band Ref',
				        'Age Band Ref'[5YR_Age_Band], -- set your age bands 
				        "Total_Local_Observed_Events", 'Referrals & Treatments'[Number of Treatments], -- set you local observed measure 
				        "Total_Local_Population", CALCULATE(SUM('New Practice Population'[population]),'New Practice Population'[Census_Date] = max_date), -- set your local population figure
				        "Reference_Events",  -- set you number of reference events i.e total Gloucestershire events
				            CALCULATE(
				                'Referrals & Treatments'[Number of Treatments], 'Referrals & Treatments'[Amended_5yr_age_band] <> BLANK(),
				                REMOVEFILTERS('GP Reference'),REMOVEFILTERS('Ethnicity Ref'),REMOVEFILTERS('Core20 Ref'),REMOVEFILTERS('LD Ref'),REMOVEFILTERS('Mental Health Ref'),REMOVEFILTERS('IMD') -- remove filters from your GP practice reference table 
				            ),
				        "Reference_Population",   ---set your number for reference population i.e. total Gloucestershire population 
				            CALCULATE(
				                CALCULATE(SUM('New Practice Population'[population]),'New Practice Population'[Census_Date] = max_date),
				                REMOVEFILTERS('GP Reference'),REMOVEFILTERS('Ethnicity Ref'),REMOVEFILTERS('Core20 Ref'),REMOVEFILTERS('LD Ref'),REMOVEFILTERS('Mental Health Ref'),REMOVEFILTERS('IMD')-- remove filters from your GP practice reference table 
				            )
				    )
				    
				VAR SummaryTable_with_reference_rates =
				    ADDCOLUMNS(
				        SummaryTable,
				        "Reference_Rates",
				            DIVIDE([Reference_Events], [Reference_Population], 0)
				    )
				
				VAR FinalTable =
				    ADDCOLUMNS(
				        SummaryTable_with_reference_rates,
				        "Local_Expected_Events",
				            [Reference_Rates] * [Total_Local_Population]
				    )
				
				RETURN
				FinalTable
				
				```

	annotation PBI_Id = 40777072b2844aef841438fc72e36b55

