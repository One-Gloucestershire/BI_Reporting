				let
				    Source = Sql.Database("grh-ccg-sql", "PowerBI_Reporting", [Query="select * from [PowerBI_Reporting].[Cancer].[tbl05_Screening]#(lf)", CommandTimeout=#duration(4, 4, 0, 0)])
				in
