table Screening
	lineageTag: 6dbb2677-0f4b-472e-845b-e32ab28fb405

	measure 'Bowel Screenings for Targeted Practices' = CALCULATE(DISTINCTCOUNT('Screening'[PseudoNHSNumber]),'Screening'[screening_flag] = "Bowel Screening",'Screening'[PracticeCode] IN {"L84026","L84084","L84060","L84047","Y02519","L84009","L84014","L84081","L84067","L84034","L84617","L84050","L84606"})
		formatString: 0
		lineageTag: 4cc06fef-935a-42f3-b34f-3a16aa2ad4e8

	measure 'Bowel 2WW Referrals for Targeted Practices' = CALCULATE(DISTINCTCOUNT('2WW Referrals'[UBRN]),'2WW Referrals'[Combined_TreatmentFunctionDescription] = "Gastroenterology",'2WW Referrals'[Practice_Code] IN {"L84026","L84084","L84060","L84047","Y02519","L84009","L84014","L84081","L84067","L84034","L84617","L84050","L84606"})
		formatString: 0
		lineageTag: a47a58c5-f359-4d0b-a41e-74bcd6778720

	measure 'Bowel Screening Targeted Practices' = CALCULATE(DISTINCTCOUNT('Screening'[PseudoNHSNumber]),'Screening'[screening_flag] = "Bowel Screening",'Screening'[PracticeCode] IN {"L84026","L84084","L84060","L84047","Y02519","L84009","L84014","L84081","L84067","L84034","L84617","L84050","L84606"})
		formatString: 0
		lineageTag: 2f7701d1-dc64-437a-ae15-fced42c75dc3

	measure 'Bowel Screening Rate per 1000 current year' =
			
			VAR bowel_screenings = CALCULATE (DISTINCTCOUNT('Screening'[PseudoNHSNumber]), 'Screening'[screening_flag] = "Bowel Screening", 'Screening'[EventDate] >= DATE(2024,01,01), 'Screening'[EventDate] <= DATE(2024,12,31))
			VAR pop =  CALCULATE([April_Pop],'New Practice Population'[5yr_age_band] in {"55-59", "60-64", "65-69", "70-74"}, 'Year Ref'[Current Year Flag] = "Current Year")
			RETURN CALCULATE(bowel_screenings/pop * 1000)
		lineageTag: 15453e67-3889-4051-ae02-3736c3102b6a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

