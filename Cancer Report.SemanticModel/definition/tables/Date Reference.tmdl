	column 'Current Data Dates' = IF('Date Reference'[date] <= MAX('Referrals & Treatments'[Total max date]), TRUE(), FALSE())
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 5e0ab06f-f5c4-43b8-93a5-194988543617
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'Date Reference' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db01_reference"), "select a.date as ""date"", dense_rank() over(order by a.yearmonth) as ""month_number"", a.daymonthyear as ""day_month_year"", a.day as ""day"", a.weekday as ""weekday"", a.weekdayname as ""weekday_name"", a.month as ""month"", left(a.monthname,3) as ""month_name"", a.quarter as ""quarter"", a.yearmonth as ""year_month"", a.isweekend as ""is_weekend"", a.isholiday as ""is_holiday"", a.financialweekofyear as ""financial_week_of_year"", a.financialyear as ""financial_year"", a.financialquarter as ""financial_quarter"", a.financialmonth as ""financial_month"", a.monthyearname as ""month_year_name"", case when a.financialmonth <= (select cast(financialmonth as int) from ccg_reference.vw_datelookup where date = last_day(dateadd(month,-2,current_date))) then 1 else 0 end as ""ytd_flag"", case when a.financialmonth <= (select cast(financialmonth as int) from ccg_reference.vw_datelookup where date = last_day(dateadd(month,-2,current_date))) then 'Year to Date' else '' end as ""ytd_description"", (select financialyear from ccg_reference.vw_datelookup where date = current_date) as ""Current_FY"", (select max(financialyear) from ccg_reference.vw_datelookup where left(financialyear,4) = cast((select left(financialyear,4)::int from ccg_reference.vw_datelookup where date=current_date) - 1 as varchar)) as ""Last_FY"", case when (select financialyear from ccg_reference.vw_datelookup where date = current_date) = a.financialyear then 1 else 0 end as ""Current_FY_Flag"", case when (select max(financialyear) from ccg_reference.vw_datelookup where left(financialyear,4) = cast((select left(financialyear,4)::int from ccg_reference.vw_datelookup where date=current_date) - 1 as varchar)) = a.financialyear then 1 else 0 end as ""Last_FY_Flag"", a.datekey as ""DateKey"", left(right(a.financialyear, len(a.financialyear)-2),2) as ""Financial_year_order_column"" from ccg_reference.vw_datelookup a where a.date > '2016-04-01'", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

