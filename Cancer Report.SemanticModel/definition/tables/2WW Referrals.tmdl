table '2WW Referrals'
	lineageTag: 3b2e9274-afcc-4a88-890c-268145209b37

	measure 'Rate per 1000 per year' =
			
			VAR total_referrals = [Number_of_referrals]
			VAR pop =  [April_Pop]
			RETURN total_referrals/pop * 1000
		lineageTag: ed197d91-4552-4401-b0b5-bb2a3b40b801

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '19/20 vs Current Year' =
			
			VAR base_2019 = CALCULATE([Rate per 1000 per year], 'Date Reference'[financial_year] = "2019/20")
			VAR current_year = CALCULATE([Rate per 1000 per year], 'Date Reference'[Current_FY_Flag] = 1)
			RETURN IFERROR(CALCULATE((current_year - base_2019) / base_2019,ALLSELECTED('2WW Referrals'[AgeBand])),BLANK())
		lineageTag: f7e9f5df-289d-48f5-b9f3-9b9c024b8ef0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '19/20 vs 20/21' =
			
			VAR base_2019 = CALCULATE([Rate per 1000 per year], 'Date Reference'[financial_year] = "2019/20")
			VAR base_2020 = CALCULATE([Rate per 1000 per year], 'Date Reference'[financial_year] = "2020/21")
			RETURN IFERROR(
			    (base_2020 - base_2019) / base_2019,BLANK()
			    )
		lineageTag: 9323c237-97c5-47f7-a325-408664dd04bb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '20/21 vs 21/22' =
			
			VAR base_2020 = CALCULATE([Rate per 1000 per year], 'Date Reference'[financial_year] = "2020/21")
			VAR base_2021 = CALCULATE([Rate per 1000 per year], 'Date Reference'[financial_year] = "2021/22")
			RETURN IFERROR((base_2021 - base_2020) / base_2020,BLANK())
		lineageTag: 8bde7750-d79e-41af-b162-6ee1f265d144

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '21/22 vs 22/23' =
			
			VAR base_2021 = CALCULATE([Rate per 1000 per year], 'Date Reference'[financial_year] = "2021/22")
			VAR base_2022 = CALCULATE([Rate per 1000 per year], 'Date Reference'[financial_year] = "2022/23")
			RETURN IFERROR((base_2022 - base_2021) / base_2021,BLANK())
		lineageTag: 526a843a-8869-4303-94af-176d216b48e7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '22/23 vs 23/24' =
			
			VAR base_2022 = CALCULATE([Rate per 1000 per year], 'Date Reference'[financial_year] = "2022/23")
			VAR base_2023 = CALCULATE([Rate per 1000 per year], 'Date Reference'[financial_year] = "2023/24")
			RETURN IFERROR((base_2023 - base_2022) / base_2022,BLANK())
		lineageTag: bf1d6a50-c778-48ad-b087-b7e4fc83c086

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '23/24 vs 24/25' =
			
			VAR base_2023 = CALCULATE([Rate per 1000 per year], 'Date Reference'[financial_year] = "2023/24")
			VAR base_2024 = CALCULATE([Rate per 1000 per year], 'Date Reference'[financial_year] = "2024/25")
			RETURN IFERROR((base_2024 - base_2023) / base_2023,BLANK())
		lineageTag: 220c46a8-f909-4c52-a778-3959c30fcbdc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average change per year' =
			IFERROR(
			    CALCULATE(
			    ([19/20 vs 20/21] + [20/21 vs 21/22] + [21/22 vs 22/23] + [22/23 vs 23/24] + [23/24 vs 24/25]) / (DISTINCTCOUNT('2WW Referrals'[InitialReferralFinancialYear]) - 1),
			    ALLSELECTED('2WW Referrals'[AgeBand])),
			    BLANK())
		lineageTag: d19c6ef8-90d5-4518-94e4-8621675ce019

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Rank of 19/20 vs Current Year' =
			
			
			
			RANKX(ALL('GP Reference'[ReportingOrganisationName]),CALCULATE([19/20 vs Current Year],ALLSELECTED('2WW Referrals'[AgeBand])),,ASC)
		formatString: 0
		lineageTag: 32ed2dd6-929f-42e3-a33d-33449831742a

	measure 'Rank of Rate per 1000 of Referrals Current Year' = ```
			
			 //RANKX( ALLSELECTED( 'GP Reference'[ReportingOrganisationName] ) , CALCULATE( ( 'Referrals'[Rate per 1000 per year]) ),,ASC )
			
			 IF(
			                                    NOT(ISBLANK([Rate per 1000 current year]))
			                                    , RANKX(
			                                        FILTER(ALLSELECTED('GP Reference'),NOT(ISBLANK([Rate per 1000 current year]))),
			                                        [Rate per 1000 current year],,ASC))
			```
		formatString: 0
		lineageTag: 5ea39633-d00f-4f7d-b7de-5945890fdb77

