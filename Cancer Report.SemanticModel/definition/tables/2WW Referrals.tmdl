	column 'Current Year Flag' = ```
			
			VAR max_year = YEAR(MAX('2WW Referrals'[InitialReferralDate]
			))
			VAR max_month = MONTH(MAX('2WW Referrals'[InitialReferralDate]
			))
			VAR financial_month = SWITCH(TRUE(),
			max_month = 4, 1,
			max_month = 5, 2,
			max_month = 6, 3,
			max_month = 7, 4,
			max_month = 8, 5,
			max_month = 9, 6,
			max_month = 10, 7,
			max_month = 11, 8,
			max_month = 12, 9,
			max_month = 1, 10,
			max_month = 2, 11,
			max_month = 3, 12
			)
			VAR current_year = SWITCH(TRUE(),
			max_month = 1, max_year - 1,
			max_month = 2, max_year - 1,
			max_month = 3, max_year - 1,
			max_month = 4, max_year,
			max_month = 5, max_year,
			max_month = 6, max_year,
			max_month = 7, max_year,
			max_month = 8, max_year,
			max_month = 9, max_year,
			max_month = 10, max_year,
			max_month = 11, max_year,
			max_month = 12, max_year
			
			)
			VAR adjusted_year = if(
			    MONTH('2WW Referrals'[InitialReferralDate])= 1, YEAR('2WW Referrals'[InitialReferralDate]
			) -1, 
			    if(MONTH('2WW Referrals'[InitialReferralDate]) = 2, YEAR('2WW Referrals'[InitialReferralDate]
			) -1, 
			    if(MONTH('2WW Referrals'[InitialReferralDate]) = 3, YEAR('2WW Referrals'[InitialReferralDate]
			) -1, year('2WW Referrals'[InitialReferralDate]
			))))
			
			var year_flag = IF(adjusted_year = current_year, "Current Year", IF(adjusted_year = current_year - 1, "Previous Year", "Other Year"))
			
			RETURN year_flag
			```
		lineageTag: 5e988cc1-b28e-4616-81e7-a64fbd406082
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

