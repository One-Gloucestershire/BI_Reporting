lation"", bookingreferralpopulation as ""BookingReferralPopulation"", initialreferralrate as ""InitialReferralRate"", bookingreferralrate as ""BookingReferralRate"", shortlistcount as ""ShortlistCount"", referral_date, breast_cancer_flag, nss_flag as ""NSS_flag"", match_id as ""match_ID"", combined_treatmentfunctiondescription as ""Combined_TreatmentFunctionDescription"" from data_mart_powerbi_cancer.tbl01_2ww", null, [EnableFolding=true])
