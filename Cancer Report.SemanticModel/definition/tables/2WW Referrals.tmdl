	measure 'New FY Rate per 1000 current year' =
			
			VAR total_referrals = CALCULATE ([Number_of_referrals], 'Year Ref'[Current Year Flag]= "Current Year", ALLSELECTED('2WW Referrals'[AgeBand]),ALLSELECTED('Date Reference'[financial_year]))
			VAR pop =  CALCULATE([April_Pop], 'Year Ref'[Current Year Flag] = "Current Year")
