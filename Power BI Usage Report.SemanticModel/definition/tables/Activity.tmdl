table Activity
	lineageTag: 2c1a7b30-0000-4a00-9b00-432246588614

	measure 'Total Events' = COUNTROWS ( Activity )
		formatString: #,0
		lineageTag: 2c1a7b30-0000-4a00-9b00-979295899704

	measure 'Report Views' = CALCULATE ( COUNTROWS ( Activity ), Activity[event_category] = "View" )
		formatString: #,0
		lineageTag: 2c1a7b30-0000-4a00-9b00-601559670159

	measure 'Unique Reports Viewed' = CALCULATE ( DISTINCTCOUNT ( Activity[report_name] ), Activity[event_category] = "View" )
		formatString: #,0
		lineageTag: 2c1a7b30-0000-4a00-9b00-079309284975

	measure 'Active Users' = DISTINCTCOUNT ( Activity[user_id] )
		formatString: #,0
		lineageTag: 2c1a7b30-0000-4a00-9b00-664167110304

	measure 'Active Users (Views)' = CALCULATE ( DISTINCTCOUNT ( Activity[user_id] ), Activity[event_category] = "View" )
		formatString: #,0
		lineageTag: 2c1a7b30-0000-4a00-9b00-840614998737

	measure 'Refresh Count' = CALCULATE ( COUNTROWS ( Activity ), Activity[event_category] = "Refresh" )
		formatString: #,0
		lineageTag: 2c1a7b30-0000-4a00-9b00-904584607029

	measure 'Refresh Failures' = CALCULATE ( COUNTROWS ( Activity ), Activity[event_category] = "Refresh", Activity[is_success] = FALSE () )
		formatString: #,0
		lineageTag: 2c1a7b30-0000-4a00-9b00-463298778600

	measure 'Refresh Success Rate' = ```
			VAR _total = [Refresh Count]
			RETURN DIVIDE ( _total - [Refresh Failures], _total )
			```
		formatString: 0.0%
		lineageTag: 2c1a7b30-0000-4a00-9b00-120132278802

	measure Exports = CALCULATE ( COUNTROWS ( Activity ), Activity[event_category] = "Export" )
		formatString: #,0
		lineageTag: 2c1a7b30-0000-4a00-9b00-568953020954

	measure Shares = CALCULATE ( COUNTROWS ( Activity ), Activity[event_category] = "Share" )
		formatString: #,0
		lineageTag: 2c1a7b30-0000-4a00-9b00-212173947663

	measure 'New Reports' = CALCULATE ( COUNTROWS ( Activity ), Activity[event_category] = "Create" )
		formatString: #,0
		lineageTag: 2c1a7b30-0000-4a00-9b00-450673794244

	measure 'Report Views PM' = CALCULATE ( [Report Views], DATEADD ( 'Date'[Date], -1, MONTH ) )
		formatString: #,0
		lineageTag: 2c1a7b30-0000-4a00-9b00-298536598024

	measure 'Report Views MoM %' = ```
			VAR _pm = [Report Views PM]
			RETURN DIVIDE ( [Report Views] - _pm, _pm )
			```
		formatString: 0.0%
		lineageTag: 2c1a7b30-0000-4a00-9b00-267505781485

