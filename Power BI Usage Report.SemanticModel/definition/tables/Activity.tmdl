table Activity
	lineageTag: 2c1a7b30-0000-4a00-9b00-260567847658856

	measure 'Report Views' = CALCULATE ( COUNTROWS ( Activity ), Activity[event_category] = "View", Activity[is_internal] = FALSE () )
		formatString: #,0
		lineageTag: 2c1a7b30-0000-4a00-9b00-225263042698051

	measure 'Active Users' = CALCULATE ( DISTINCTCOUNT ( Activity[user_id] ), Activity[event_category] = "View", Activity[is_internal] = FALSE () )
		formatString: #,0
		lineageTag: 2c1a7b30-0000-4a00-9b00-258438149528585

	measure 'Unique Reports Viewed' = CALCULATE ( DISTINCTCOUNT ( Activity[report_name] ), Activity[event_category] = "View", Activity[is_internal] = FALSE () )
		formatString: #,0
		lineageTag: 2c1a7b30-0000-4a00-9b00-165858544425746

	measure 'Total Events' = COUNTROWS ( Activity )
		formatString: #,0
		lineageTag: 2c1a7b30-0000-4a00-9b00-64879754721600

	measure 'Report Views (all users)' = CALCULATE ( COUNTROWS ( Activity ), Activity[event_category] = "View" )
		formatString: #,0
		lineageTag: 2c1a7b30-0000-4a00-9b00-33362347451229

	measure 'Internal Users' = CALCULATE ( DISTINCTCOUNT ( Activity[user_id] ), Activity[is_internal] = TRUE () )
		formatString: #,0
		lineageTag: 2c1a7b30-0000-4a00-9b00-259968040642551

	measure 'Internal Report Views' = CALCULATE ( COUNTROWS ( Activity ), Activity[event_category] = "View", Activity[is_internal] = TRUE () )
		formatString: #,0
		lineageTag: 2c1a7b30-0000-4a00-9b00-273723281141856

	measure 'Internal Events' = CALCULATE ( COUNTROWS ( Activity ), Activity[is_internal] = TRUE () )
		formatString: #,0
		lineageTag: 2c1a7b30-0000-4a00-9b00-53751685533528

	measure 'Internal View Share %' = DIVIDE ( [Internal Report Views], [Report Views (all users)] )
		formatString: 0.0%
		lineageTag: 2c1a7b30-0000-4a00-9b00-263604723045564

	measure 'Report Authors' = CALCULATE ( DISTINCTCOUNT ( Activity[user_id] ), Activity[is_report_author] = TRUE () )
		formatString: #,0
		lineageTag: 2c1a7b30-0000-4a00-9b00-103771478382089

	measure 'New Reports' = CALCULATE ( COUNTROWS ( Activity ), Activity[event_category] = "Create" )
		formatString: #,0
		lineageTag: 2c1a7b30-0000-4a00-9b00-1469688540429

	measure 'Reports Edited' = CALCULATE ( COUNTROWS ( Activity ), Activity[event_category] = "Edit" )
		formatString: #,0
		lineageTag: 2c1a7b30-0000-4a00-9b00-4441565380192

	measure 'Refresh Count' = CALCULATE ( COUNTROWS ( Activity ), Activity[event_category] = "Refresh" )
		formatString: #,0
		lineageTag: 2c1a7b30-0000-4a00-9b00-241981734565584

	measure 'Refresh Failures' = CALCULATE ( COUNTROWS ( Activity ), Activity[event_category] = "Refresh", Activity[is_success] = FALSE () )
		formatString: #,0
		lineageTag: 2c1a7b30-0000-4a00-9b00-114686730268033

	measure 'Refresh Success Rate' = ```
			VAR _total = [Refresh Count]
			RETURN DIVIDE ( _total - [Refresh Failures], _total )
			```
		formatString: 0.0%
		lineageTag: 2c1a7b30-0000-4a00-9b00-8345228041027

	measure Exports = CALCULATE ( COUNTROWS ( Activity ), Activity[event_category] = "Export", Activity[is_internal] = FALSE () )
		formatString: #,0
		lineageTag: 2c1a7b30-0000-4a00-9b00-87067768938831

	measure Shares = CALCULATE ( COUNTROWS ( Activity ), Activity[event_category] = "Share" )
		formatString: #,0
		lineageTag: 2c1a7b30-0000-4a00-9b00-145130809136514

	measure 'Report Views PM' = CALCULATE ( [Report Views], DATEADD ( 'Date'[Date], -1, MONTH ) )
		formatString: #,0
		lineageTag: 2c1a7b30-0000-4a00-9b00-261978724830481

	measure 'Report Views MoM %' = ```
			VAR _pm = [Report Views PM]
			RETURN DIVIDE ( [Report Views] - _pm, _pm )
			```
		formatString: 0.0%
		lineageTag: 2c1a7b30-0000-4a00-9b00-217626336050217

