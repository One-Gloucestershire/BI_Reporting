model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Activity","Date"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProjectNote = Power BI tenant usage/adoption model

ref table Activity
ref table Date

ref cultureInfo en-GB
