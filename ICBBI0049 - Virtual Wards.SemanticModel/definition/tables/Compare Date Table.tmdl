	hierarchy 'Date Hierarchy'
		lineageTag: b91c4464-3c47-4d63-9630-44f2b4e0d99d

		level Date
			lineageTag: 19534dfa-edbd-4eef-8755-7eb0bfa56569
			column: Date

		level 'Week Ending'
			lineageTag: c4e6c961-1752-4d22-ae3f-1697937f05dc
			column: 'Week Ending'

		level Month-Year
			lineageTag: a514c7f5-16f6-43b3-b869-459b5ac39465
			column: Month-Year

	partition 'Compare Date Table' = calculated
		mode: import
		source = ```
				
				VAR BaseCalendar = 
				    ADDCOLUMNS (
				        CALENDAR (MIN('01 VW Main'[admission_dateonly]), MAX('01 VW Main'[discharge_dateonly])),
				        "Year", YEAR([Date]),
				        "Month Number", MONTH([Date]),
				        "Month Name", FORMAT([Date], "MMMM"),
				        "Month-Year", FORMAT([Date], "MMM YYYY"),
				        "Week Number", WEEKNUM([Date], 2),
				        "Week Ending", [Date] + (7 - WEEKDAY([Date], 2)),
				        "Day of Week", FORMAT([Date], "dddd"),
				        "Day", DAY([Date])
				    )
				RETURN
				    ADDCOLUMNS (
				        BaseCalendar,
				        "Financial Year", 
				            IF(MONTH([Date]) >= 4, 
				               FORMAT(YEAR([Date]), "0000") & "/" & FORMAT(YEAR([Date]) + 1, "00"), 
				               FORMAT(YEAR([Date]) - 1, "0000") & "/" & FORMAT(YEAR([Date]), "00")
				            )
				    )
				
				```

	annotation PBI_Id = 09ae1316796a4943aadb320c58133494

