	column Previous_week_discharge_flag = ```
			
			IF('Hospital @ Home'[Week_Ending_Sunday_Contact] = CALCULATE(MAX('Hospital @ Home'[Week_Ending_Sunday_Contact]), ALL('Hospital @ Home')) -7, 1,0)
			
			```
