		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "CCG_CURRENT", [Query="---NOTE - PLEASE don't query date before 01/04/2022 as  we are unable to obtain the team associated with the activity.#(lf)#(tab)--double check the figures using GHC tableau. #(lf)#(lf)#(tab)IF OBJECT_ID ('tempdb..#HAH') IS NOT NULL DROP TABLE #HAH#(lf)#(tab)SELECT #(lf)#(tab)c.UniqueServiceRequestID#(lf)#(tab),ROW_NUMBER() OVER (PARTITION BY c.UniqueServiceRequestID ORDER BY ContactDate ASC) AS Visitcount #(lf)#(tab),c.UniqueCareContactID#(lf)#(tab),c.Derived_Pseudo_NHS#(lf)#(tab),c.AgeYrContactDate#(lf)#(tab),c.OrgIDCommissioner#(lf)#(tab),c.OrgIDCommissionerDescription#(lf)#(tab),c.OrgIDProvider#(lf)#(tab),c.OrgIDProviderDescription#(lf)#(tab),VW.admitting_ward#(lf)#(tab),[VW_Admitted] = CASE WHEN VW.administrative_category_code ='01' THEN 1 ELSE 0 END #(lf)#(tab),c.ContactDate#(lf)#(tab),c.ContactTime#(lf)#(tab),c.AdminCategory#(lf)#(tab),c.AdminCategoryDescription#(lf)#(tab),c.CareContactDuration#(lf)#(tab),c.ConsultationType#(lf)#(tab),ConsultationTypeDescription#(lf)#(tab),c.CareContactSubject#(lf)#(tab),c.CareContactSubjectDescription#(lf)#(tab),c.ConsultationMediumUsed#(lf)#(tab),c.ConsultationMediumUsedDescription#(lf)#(tab),c.ActivityLocationType#(lf)#(tab),c.ActivityLocationTypeDescription#(lf)#(tab),c.TreatmentOrgSiteID#(lf)#(tab),c.TreatmentOrgSiteIDDescription#(lf)#(tab),r.ReferralCostCentre#(lf)#(tab),r.AllCostCentresOnReferral#(lf)#(tab),r.ReferralRequestReceivedDate#(lf)#(tab),c.ClinicalContactFlag#(lf)#(tab),AttendOrNot#(lf)#(tab),AttendOrNotDescription#(lf)#(tab),d.FinancialYear#(lf)#(tab),d.FinancialMonth#(lf)#(tab),d.[MonthName]#(lf)#(tab),DATEADD(DAY, 7 - DATEPART(WEEKDAY, ContactDate), CAST(ContactDate AS DATE)) AS Week_Ending_Sunday#(lf)#(tab),h.Team#(lf)#(tab),h.Service#(lf)#(tab),[Counter] = 1#(lf)#(lf)#(tab),MPI.AgeBand5yr#(lf)#(tab),MPI.Gender#(lf)#(tab),MPI.LocalityName#(lf)#(tab),MPI.EthnicOriginDescription#(lf)#(tab),MPI.RuralUrbanClass#(lf)#(tab),MPI.eFI_Catgory_derived#(lf)#(tab),MPI.IMDcountyDecile#(lf)#(tab),MPI.[LSOA Code]#(lf)#(tab)  #(lf)#(tab)  INTO #HAH#(lf)#(tab)  FROM [CCG_Current].[CSDS].[vw_302_CareContact] as c#(lf)#(lf)#(tab)  left join CCG_Reference.Reference.vw_DateLookup as d on d.Date = cast(c.ContactDate as date)#(lf)#(lf)#(tab)  LEFT join CCG_Current.CSDS.vw_301_Referral as r on c.UniqueServiceRequestID = r.UniqueServiceRequestID#(lf)#(tab)  --Due to configuration issues in systmOne GHC are unable to identify the team at contact ; as a proxy the contact uses the referral cost centre. #(lf)#(tab)  left join CCG_Reference.GHC.vw_Hierarchy as h on r.ReferralCostCentre = h.Cost_Centre -- hierarchy is a reference to GHC #(lf)#(lf)#(tab) LEFT JOIN [CCG_Current].GHFT.vw_IPVirtualWard AS VW   ON VW.nhs_number = c.Derived_Pseudo_NHS#(lf)#(lf) ----------- Joining for demographic data --------------#(lf)#(tab)LEFT JOIN [BIReports].[MPI].[MPI_current] as MPI#(lf)    ON MPI.Derived_Pseudo_NHS = C.Derived_Pseudo_NHS #(lf)#(lf)#(tab)where #(lf)#(tab)c.OrgIDProvider  like 'RTQ%' -- GHC #(lf)#(tab)and c.OrgIDCommissioner like '11M%' -- glos patients only#(lf)#(tab)and c.ContactDate>= '20220401' #(lf)#(tab)and (c.ClinicalContactFlag = 1 or c.ClinicalContactFlag is null)   -- added 20/01/2025 due to GHC logic. If the consultation mechanism is null then this is classed as an admin event i.e. not clinical . Assuming all other providers provide non clinical events only. #(lf)#(tab)  #(lf)#(tab)AND  ( r.ReferralCostCentre in ('G15503', --Rapid Response#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)'G15503a', --Rapid Response - RR - ENDNS#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)'G15503b', --Rapid Response - RR - District Nursing   #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)'G15501') -- IV Therapy ---- change teams as required #(lf)#(lf)#(tab) ---- change teams below as required , accounts for DQ issues whereby multiple teams are assigned at the point of referral and can't distinguish the first. #(lf)#(tab) OR r.AllCostCentresOnReferral like  ('%G15503%') --Rapid Response#(lf)#(tab) OR r.AllCostCentresOnReferral like  ('%G15503a%') --Rapid Response - RR - ENDNS#(lf)#(tab) OR r.AllCostCentresOnReferral like  ('%G15503b%')--Rapid Response - RR - District Nursing   #(lf)#(tab) OR r.AllCostCentresOnReferral like  ('G15501')) -- IV Therapy#(lf)#(lf)#(lf)#(tab)and (AttendOrNot in ('5','6') -- attended contacts only  -- there are known to be a number of nulls in this field but may not apply to the teams you need so please check this#(lf)#(tab)OR AttendOrNot IS NULL )#(lf)#(lf)#(tab)AND ConsultationMediumUsed = '01'#(lf)#(lf)#(tab)AND C.Derived_Pseudo_NHS IS NOT NULL#(lf)#(lf)#(tab)order by c.ContactDate asc ;#(lf)#(lf)#(lf)#(lf)-- Ensuring that only full weeks are pulled through --#(lf)#(tab)#(lf)#(tab)SELECT *,#(lf)#(tab)CASE WHEN RU.RUC11Desc LIKE '%urban%' THEN 'Urban' #(lf)#(tab)#(tab) WHEN RU.RUC11Desc LIKE '%rural%' THEN 'Rural' #(lf)#(tab)     ELSE 'Unknown' END AS 'Rural_Urban'#(lf)#(tab)#(lf)#(tab)FROM #HAH#(lf)#(lf)#(tab)INNER JOIN (#(lf)#(tab)#(tab)SELECT [Week_Ending_Sunday]#(lf)#(tab)#(tab)FROM #HAH #(lf)#(tab)#(tab)WHERE [Week_Ending_Sunday] = (SELECT MAX([Week_Ending_Sunday]) FROM #HAH) -- checking the latest week end only#(lf)#(tab)#(tab)GROUP BY [Week_Ending_Sunday]#(lf)#(tab)#(tab)HAVING COUNT(DISTINCT CAST(ContactDate AS DATE)) = 7 -- checking to see if 7 individual days have been included across to week #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)  #(tab)   #(lf)#(tab)#(tab)UNION ALL#(lf)    #(lf)#(tab)#(tab)-- Include all previous weeks (those before the latest Sunday) regardless of completeness#(lf)#(tab)#(tab)SELECT [Week_Ending_Sunday]#(lf)#(tab)#(tab)FROM #HAH#(lf)#(tab)#(tab)WHERE [Week_Ending_Sunday] < (SELECT MAX([Week_Ending_Sunday]) FROM #HAH)  -- Prior weeks#(lf)#(tab)#(tab)GROUP BY [Week_Ending_Sunday]) AS FULLWEEKS#(lf)#(tab)#(tab)ON #HAH.Week_Ending_Sunday = FULLWEEKS.Week_Ending_Sunday#(lf)#(lf)LEFT JOIN [CCG_Reference].[Reference].[vw_rural_urban] AS RU#(lf)ON RU.[LSOACode] = #HAH.[LSOA Code] #(lf)#(lf)#(tab)--WHERE ContactDate <= EOMONTH ( DATEADD ( MONTH, -1, GETDATE() ) )#(lf)#(tab)ORDER BY ContactDate DESC #(lf)#(lf)#(tab)-- WHERE Visitcount = '1'#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)------- Joined to Virtual Wards table via NHS Number and searched for contacts during the VW stay --------#(lf)#(lf)#(lf)#(lf)#(tab)#(lf)#(tab)--WHERE nhs_number IS NOT NULL #(lf)#(tab)--AND #HAH.ContactDate BETWEEN VW.admission_datetime AND VW.discharge_datetime"]),
				    #"Merged Queries" = Table.NestedJoin(Source, {"ContactDate"}, #"Discharge Date Table", {"date"}, "Discharge Date Table", JoinKind.LeftOuter),
				    #"Expanded Discharge Date Table" = Table.ExpandTableColumn(#"Merged Queries", "Discharge Date Table", {"day_month_year", "day", "weekday", "weekday_name", "month", "month_name", "year_month", "financial_year", "financial_month", "month_year"}, {"Discharge Date Table.day_month_year", "Discharge Date Table.day", "Discharge Date Table.weekday", "Discharge Date Table.weekday_name", "Discharge Date Table.month", "Discharge Date Table.month_name", "Discharge Date Table.year_month", "Discharge Date Table.financial_year", "Discharge Date Table.financial_month", "Discharge Date Table.month_year"}),
				    #"Replaced Value" = Table.ReplaceValue(#"Expanded Discharge Date Table",null,"Unknown",Replacer.ReplaceValue,{"ConsultationTypeDescription"}),
				    #"Replaced Value1" = Table.ReplaceValue(#"Replaced Value",null,"Unknown",Replacer.ReplaceValue,{"ActivityLocationTypeDescription"}),
				    #"Added Conditional Column" = Table.AddColumn(#"Replaced Value1", "SeenorNotSeen", each if [AttendOrNot] = "5" then "Seen" else if [AttendOrNot] = "6" then "Not Seen" else "Unknown"),
				    #"Replaced Value2" = Table.ReplaceValue(#"Added Conditional Column","Other locations not elsewhere classified","Unknown",Replacer.ReplaceText,{"ActivityLocationTypeDescription"})
				in
				    #"Replaced Value2"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

