table 'Hospital @ Home'
	lineageTag: 749ce3c2-c895-47d8-8a7b-01a9165c8aee

	measure H@H_LATEST_WEEK =
			
			CALCULATE(SUM('Hospital @ Home'[Counter]), 'Hospital @ Home'[Latest_week_discharge_flag] = 1)
		formatString: 0
		lineageTag: 5035af32-55c9-418b-bb23-02c6bf1600a5

	measure 'Latest Week End H@H' = ```
			
			VAR LatestWeek = CALCULATE(MAX('Hospital @ Home'[Week_Ending_Sunday_Contact]), ALL('Hospital @ Home'))
			RETURN 
			FORMAT(LatestWeek, "dd mmmm yyyy")
			
			```
		lineageTag: bc365132-d4ba-4741-ae7d-53925ec48789

	measure H@H_PREVIOUS_WEEK =
			
			CALCULATE(SUM('Hospital @ Home'[Counter]), 'Hospital @ Home'[Previous_week_discharge_flag] = 1)
		formatString: 0
		lineageTag: a500eb78-0493-4118-9d31-82d4f8dae263

	measure H@H_LATEST_4WEEK =
			
			CALCULATE(SUM('Hospital @ Home'[Counter]) /4 , 'Hospital @ Home'[Latest_discharge_4week_flag] = 1)
		formatString: 0
		lineageTag: 815179de-b21b-4629-bf92-b566db89b3b7

	measure H@H_PREVIOUS_4WEEK =
			
			CALCULATE(SUM('Hospital @ Home'[Counter])/4, 'Hospital @ Home'[Previous_discharge_4week_flag] = 1)
		formatString: 0
		lineageTag: 473e7a68-1aa7-40c4-b5f7-477afaf08a90

