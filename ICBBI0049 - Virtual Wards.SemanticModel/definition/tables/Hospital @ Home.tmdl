	column Latest_discharge_4week_flag = ```
			
			IF( 'Hospital @ Home'[Week_Ending_Sunday_Contact] = CALCULATE(MAX('Hospital @ Home'[Week_Ending_Sunday_Contact]), ALL('Hospital @ Home')) -7
			    || 'Hospital @ Home'[Week_Ending_Sunday_Contact] = CALCULATE(MAX('Hospital @ Home'[Week_Ending_Sunday_Contact] ), ALL('Hospital @ Home')) -14
			    ||'Hospital @ Home'[Week_Ending_Sunday_Contact]  = CALCULATE(MAX('Hospital @ Home'[Week_Ending_Sunday_Contact] ), ALL('Hospital @ Home')) -21
			    || 'Hospital @ Home'[Week_Ending_Sunday_Contact] = CALCULATE(MAX('Hospital @ Home'[Week_Ending_Sunday_Contact] ), ALL('Hospital @ Home')),
			    1, 0 ) 
			```
		formatString: 0
		lineageTag: eddb0d1f-bf30-46ac-a755-013638bdb0f7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Previous_discharge_4week_flag = ```
			
			IF( 'Hospital @ Home'[Week_Ending_Sunday_Contact] = CALCULATE(MAX('Hospital @ Home'[Week_Ending_Sunday_Contact]), ALL('Hospital @ Home')) -28
			    || 'Hospital @ Home'[Week_Ending_Sunday_Contact] = CALCULATE(MAX('Hospital @ Home'[Week_Ending_Sunday_Contact] ), ALL('Hospital @ Home')) -35
			    ||'Hospital @ Home'[Week_Ending_Sunday_Contact]  = CALCULATE(MAX('Hospital @ Home'[Week_Ending_Sunday_Contact] ), ALL('Hospital @ Home')) -42
			    || 'Hospital @ Home'[Week_Ending_Sunday_Contact] = CALCULATE(MAX('Hospital @ Home'[Week_Ending_Sunday_Contact] ), ALL('Hospital @ Home')) -48,
			    1, 0 ) 
			```
		formatString: 0
		lineageTag: 3044d004-4044-4932-b118-e603be9c7428
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

