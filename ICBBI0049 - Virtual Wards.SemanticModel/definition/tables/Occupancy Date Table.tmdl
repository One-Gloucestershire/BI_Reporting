	hierarchy 'Date Hierarchy'
		lineageTag: 59cd8544-29fd-4231-99dc-8cb21dbcdf6a

		level Date
			lineageTag: d5c597d5-3d12-4396-b41e-3da91a8945f6
			column: Date

		level 'Week Ending'
			lineageTag: 5170c0a1-8710-4004-a233-0f106b5b9156
			column: 'Week Ending'

		level Month-Year
			lineageTag: 4378e054-2353-4158-aea8-0d9aa580faf5
			column: Month-Year

	partition 'Occupancy Date Table' = calculated
		mode: import
		source = ```
				
				VAR BaseCalendar = 
				    ADDCOLUMNS (
				        CALENDAR (MIN('01 VW Main'[admission_dateonly]), MAX('01 VW Main'[discharge_dateonly])),
				        "Year", YEAR([Date]),
				        "Month Number", MONTH([Date]),
				        "Month Name", FORMAT([Date], "MMMM"),
				        "Month-Year", FORMAT([Date], "MMM YYYY"),
				        "Week Number", WEEKNUM([Date], 2),
				        "Week Ending", [Date] + (7 - WEEKDAY([Date], 2)),
				        "Day of Week", FORMAT([Date], "dddd"),
				        "Day", DAY([Date])
				    )
				RETURN
				    ADDCOLUMNS (
				        BaseCalendar,
				        "Financial Year", 
				            IF(MONTH([Date]) >= 4, 
				               FORMAT(YEAR([Date]), "0000") & "/" & FORMAT(YEAR([Date]) + 1, "00"), 
				               FORMAT(YEAR([Date]) - 1, "0000") & "/" & FORMAT(YEAR([Date]), "00")
				            )
				    )
				
				```

	annotation PBI_Id = cdaaa13ec9ab4730b18bb98d8d261364

