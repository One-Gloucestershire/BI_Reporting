	measure DISCH_PREVIOUS_4WEEK = ```
			
			
			VAR _LATEST = 
			    CALCULATE(
			        MAX('01 VW Main'[discharge_Week_Ending_Sunday]),
			        REMOVEFILTERS('01 VW Main') )
			
			VAR _START = 
			CALCULATE(
			    MAX('01 VW Main'[discharge_Week_Ending_Sunday]),
			    REMOVEFILTERS('01 VW Main')) - 28 
			
			VAR _4WEEKS = 
			DATESINPERIOD(
			    '01 VW Main'[discharge_Week_Ending_Sunday], 
			    _START,
			    -28, DAY ) 
			
			RETURN
			CALCULATE(
			    COUNTROWS('01 VW Main'),
			    _4WEEKS) / 4
			```
		lineageTag: fc328ffc-e74c-4ee7-9789-a33607690833

