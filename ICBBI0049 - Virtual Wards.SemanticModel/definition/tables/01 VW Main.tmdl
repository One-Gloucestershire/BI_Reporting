	measure 'KPI DisCH LatestW' = CALCULATE(SUM('01 VW Main'[discharge_counter]), '01 VW Main'[Latest_week_discharge_flag] = 1) +0
		formatString: 0
		lineageTag: 471ac71e-e771-4ce5-a494-67d35328b909

	measure DISCH_LATEST_WEEK = ```
			
			VAR LatestWeek = MAX('01 VW Main'[discharge_Week_Ending_Sunday])  -- Get the latest week
			RETURN
			CALCULATE(
			    COUNTROWS('01 VW Main'), 
			    '01 VW Main'[discharge_Week_Ending_Sunday] = LatestWeek,
			    USERELATIONSHIP('Discharge Date Table'[day_month_year], '01 VW Main'[discharge_dateonly]) 
			) + 0
			
			```
		formatString: 0
		lineageTag: 8f698097-49b9-40f1-9bb7-4abced8d9ca1

	measure DISCH_PREVIOUS_WEEK = ```
			
			VAR LatestWeek = MAX('01 VW Main'[discharge_Week_Ending_Sunday])  
			VAR PreviousWeek = 
			    CALCULATE(
			        MAX('01 VW Main'[discharge_Week_Ending_Sunday]), 
			        '01 VW Main'[discharge_Week_Ending_Sunday] < LatestWeek
			    )  -- Get the most recent week before the latest week
			RETURN
			CALCULATE(
			    SUM('01 VW Main'[discharge_counter]), 
			    '01 VW Main'[discharge_Week_Ending_Sunday] = PreviousWeek
			) + 0
			
			```
		formatString: 0
		lineageTag: a5cddd63-27fa-4ab0-b781-1f3dbbc415db

	measure 'Total Readmissions' = ```
			
			CALCULATE(
			    SUM('03 VW Readmissions'[Count]), 
			    RELATEDTABLE('03 VW Readmissions')  -- This ensures we only get the related rows from 'Query1'
			)
			
			
			```
		formatString: 0
		lineageTag: c1da4b62-1c10-4426-9bab-d9d4e128b761

	measure 'INDIV WARD OCC WEEKEND' = ```
			
			VAR Admissions = 
			    CALCULATE(
			        COUNT('01 VW Main'[admitting_counter]), 
			        FILTER(
			            ALL('01 VW Main'), 
			            '01 VW Main'[Week_End_Wednesday] <= MAX('01 VW Main'[Week_End_Wednesday]) &&
			            '01 VW Main'[Admitting_Ward] = SELECTEDVALUE('01 VW Main'[Admitting_Ward]) 
			        )
			    )
			
			VAR Discharges = 
			    CALCULATE(
			        COUNT('01 VW Main'[discharge_counter]), 
			        FILTER(
			            ALL('01 VW Main'), 
			            '01 VW Main'[WeekEnd_Discharge] <= MAX('01 VW Main'[Week_End_Wednesday]) &&
			            '01 VW Main'[Admitting_Ward] = SELECTEDVALUE('01 VW Main'[Admitting_Ward])
			        )
			    )
			
			RETURN Admissions - Discharges
			
			```
		formatString: 0
		lineageTag: 0626a24f-2f4f-4872-adc7-d15b6a8a2a59

	measure DISCH_LATEST_4WEEK = ```
			
			
			VAR _LATEST = 
			    CALCULATE(
			        MAX('01 VW Main'[discharge_Week_Ending_Sunday]),
			        REMOVEFILTERS('01 VW Main') )
			
			VAR _4WEEKS = 
			DATESINPERIOD(
			    '01 VW Main'[discharge_Week_Ending_Sunday], 
			    _LATEST,
			    -28, DAY ) 
			
			RETURN 
			CALCULATE(
			    COUNTROWS('01 VW Main'),
			    _4WEEKS) / 4 
			```
		lineageTag: 6440395e-35d3-4bb3-8331-3c76b86e8a0c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Latest Week End Discharges' = ```
			
			VAR LatestWeek = CALCULATE(MAX('01 VW Main'[discharge_Week_Ending_Sunday]), ALL('01 VW Main'))
			RETURN 
			FORMAT(LatestWeek, "dd mmmm yyyy")
			
			```
		lineageTag: 8e1420a2-8963-4527-a408-53693aee3e2d

