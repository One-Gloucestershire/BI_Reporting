	hierarchy 'discharge_dateonly Hierarchy'
		lineageTag: 6898d5fb-a83d-493a-9c82-7394439540fc

		level discharge_dateonly
			lineageTag: f7f94b3e-c2f7-459f-9c76-457c0e2b0144
			column: discharge_dateonly

		level discharge_month_year
			lineageTag: ab377408-6099-48a6-ab06-3a0b33b7f9da
			column: discharge_month_year

		level discharge_Week_Ending_Sunday
			lineageTag: dd5d8c3e-7150-4296-a1f7-e6e4c265c2a0
			column: discharge_Week_Ending_Sunday

	partition '01 VW Main' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "ccg_current", [Query="--------- Virtual Wards table ---------#(lf) IF OBJECT_ID ('tempdb..#VW') IS NOT NULL DROP TABLE #VW#(lf)#(lf)#(lf)SELECT VW.nhs_number, VW.hospital_episode_number, VW.organisation_code_of_commissioner,#(lf)#(tab)   -- admission columns --#(lf)#(tab)   VW.admission_datetime, CAST(VW.admission_datetime AS DATE) as 'admission_dateonly', #(lf)#(tab)   DATEADD(DAY, 7 - DATEPART(WEEKDAY, VW.admission_datetime), CAST(VW.admission_datetime AS DATE)) AS Admission_Week_Ending_Sunday,#(lf)#(tab)   ad.Derived_AdmissionMethodName_Short, VW.admission_method_code, VW.admission_method, VW.admission_treatment_function_code, VW.admission_treatment_function,#(lf)#(tab)   VW.admitting_ward_code, VW.admitting_ward, #(lf)#(tab)   -- discharge columns --#(lf)#(tab)   VW.discharge_datetime, CAST( VW.discharge_datetime AS DATE) as 'discharge_dateonly',  #(lf)#(tab)   VW.discharge_destination_code, VW.discharge_destination, dd.CCI_Name, VW.discharge_method, VW.discharge_method_code, HPS.discharge_pathway,#(lf)#(tab)   -- LoS and readmission --#(lf)#(tab)   CASE WHEN VW.discharge_datetime <> '' THEN DATEDIFF(DAY, VW.admission_datetime, VW.discharge_datetime) ELSE NULL END AS length_of_stay_days, #(lf)#(tab)   HPS.readmission_30_day,#(lf)#(tab)   -- HRG and primary diagnosis columns--#(lf)#(tab)   VW.SpellHRG, HRG.HRGCodeDescription, HRG.HRG_Chapter_Description, HRG.HRG_SubChapter_Description,#(lf)#(tab)   VW.spell_P_diag, ICD.ICD10Code, ICD.ICD10Description as 'Primary_diagnosis',  CASE WHEN VW.spell_P_diag <> '' THEN 1 ELSE 0 END AS 'primary_diagnosis_counter', #(lf)#(tab)   -- Demographics columns --#(lf)#(tab)   VW.frailty_proxy, VW.age_at_admission, MPI.Gender, MPI.EthnicOriginDescription, MPI.PracNameCurrent, MPI.RuralUrbanClass, MPI.NetworkName, MPI.LocalityName, MPI.IMDcountyDecile, MPI.AgeBand5yr, MPI.[LSOA Code],#(lf)#(lf)#(tab)   -- counters and flags --#(lf)#(tab)   CASE WHEN VW.discharge_datetime <> '' THEN 1 ELSE 0 END AS discharge_counter,#(lf)#(tab)   CASE WHEN VW.discharge_method_code = '4' THEN '1' ELSE '0' END AS death_flag, #(lf)#(tab)   CASE WHEN VW.discharge_method_code = '4' THEN EOL.place_of_death ELSE NULL END AS place_of_death#(lf)#(lf)#(tab)   into #VW#(lf)FROM [CCG_Current].[GHFT].[vw_IPVirtualWard] as VW#(lf)#(lf)#(lf)----------- Joining for HRG description -----------------#(lf)  LEFT JOIN [CCG_Reference].[Reference].[vw_HRG] as HRG#(lf)#(tab)ON HRG.HRGCode = VW.SpellHRG#(lf)#(lf)  #(lf)----------- Joining primary diagnosis description -----------------#(lf)  LEFT JOIN CCG_Reference.Reference.vw_ICD10 as ICD#(lf)  ON ICD.ICD10Code = VW.spell_P_diag#(lf)  #(lf)#(lf)----------- Joining for place of death -----------------#(lf) LEFT JOIN [PowerBI_Processing].[dbo].[EOL_Report_Table_v2] as EOL#(lf)#(tab)ON VW.nhs_number = EOL.pseudo_nhs_number#(lf)#(tab)#(lf)----------- Joining for readmission and discharge pathway --------------#(lf) LEFT JOIN [CCG_Current].[GHFT].[vw_HospitalProviderSpell] as HPS#(lf)#(tab)ON HPS.hospital_episode_number = VW.hospital_episode_number#(lf)#(lf)----------- Joining for demographic data --------------#(lf) LEFT JOIN [BIReports].[MPI].[MPI_current] as MPI#(lf)    ON MPI.Derived_Pseudo_NHS = VW.nhs_number#(lf)#(lf)------------ Joining for further admission method details -------#(lf)  LEFT JOIN [CCG_Reference].[Reference].[vw_AdmissionMethod] as ad#(lf)  ON VW.admission_method_code = ad.AdmissionMethodCode#(lf)#(lf)------------ Joining for discharge destination reference --------#(lf)  LEFT JOIN [CCG_Reference].[Reference].[vw_DischargeDestination] as dd#(lf)  ON dd.DischargeDestinationCode = VW.discharge_destination_code#(lf)  #(lf)#(lf)#(lf)WHERE VW.organisation_code_of_commissioner = '11M' #(lf)#(tab)AND VW.nhs_number NOT LIKE '' #(lf)#(tab)AND VW.[admitting_ward] IN ('Virtual Heart Failure Ward', 'Virtual Respiratory Ward', 'Virtual Frailty Ward', 'Virtual General Medicine Ward', 'Virtual Oncology Haematology Ward')#(lf)#(lf)#(tab)--AND VW.discharge_datetime BETWEEN '20180401 00:00:00.000' AND EOMONTH ( DATEADD ( MONTH, -1, GETDATE() ) )  --  The EOMONTH function finds the latest complete month.#(lf)    --AND VW.admission_datetime BETWEEN  '20250102 00:00:00.0000' AND GETDATE()                                                                               #(lf)#(tab)#(lf) #(lf)ORDER BY nhs_number desc#(lf)#(lf);#(lf)#(lf)--------------------------------------------------------------------------------------------------------------------------------------------------#(lf)#(lf) IF OBJECT_ID ('tempdb..#VWmain') IS NOT NULL DROP TABLE #VWmain#(lf)#(lf)#(lf)------  VW TABLE FOR ADMISSIONS WEEK END  -------#(lf)select *, #(lf)CASE WHEN RU.RUC11Desc LIKE '%urban%' THEN 'Urban' #(lf)#(tab) WHEN RU.RUC11Desc LIKE '%rural%' THEN 'Rural' #(lf)#(tab) ELSE 'Unknown' END AS 'Rural_Urban',#(lf)#(lf)CASE WHEN #VW.length_of_stay_days = 0 THEN '0 days' #(lf)#(tab) WHEN #VW.length_of_stay_days BETWEEN 1 AND 4 THEN '1-4 days'#(lf)#(tab) WHEN #VW.length_of_stay_days BETWEEN 5 AND 9 THEN '5-9 days'#(lf)#(tab) WHEN #VW.length_of_stay_days BETWEEN 10 AND 14 THEN '10-14 days'#(lf)#(tab) WHEN #VW.length_of_stay_days > 14 THEN 'Over 14 days'#(lf)#(tab) ELSE 'Unknown' END AS 'length_of_stay_groups' #(lf)#(tab) #(lf)from #VW#(lf)#(lf)INNER JOIN (#(lf)#(tab)#(tab)SELECT [Admission_Week_Ending_Sunday]#(lf)#(tab)#(tab)FROM #VW #(lf)#(tab)#(tab)WHERE [Admission_Week_Ending_Sunday] = (SELECT MAX([Admission_Week_Ending_Sunday]) FROM #VW) -- checking the latest week end only#(lf)#(tab)#(tab)GROUP BY [Admission_Week_Ending_Sunday]#(lf)#(tab)#(tab)HAVING COUNT(DISTINCT CAST(admission_dateonly AS DATE)) = 7 -- checking to see if 7 individual days have been included across to week #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)  #(tab)   #(lf)#(tab)#(tab)UNION ALL#(lf)    #(lf)#(tab)#(tab)-- Include all previous weeks (those before the latest Sunday) regardless of completeness#(lf)#(tab)#(tab)SELECT [Admission_Week_Ending_Sunday]#(lf)#(tab)#(tab)FROM #VW#(lf)#(tab)#(tab)WHERE [Admission_Week_Ending_Sunday]< (SELECT MAX([Admission_Week_Ending_Sunday]) FROM #VW)  -- Prior weeks#(lf)#(tab)#(tab)GROUP BY [Admission_Week_Ending_Sunday]) AS FULLWEEKS#(lf)#(tab)#(tab)ON #VW.[Admission_Week_Ending_Sunday] = FULLWEEKS.[Admission_Week_Ending_Sunday]#(lf)#(lf)LEFT JOIN [CCG_Reference].[Reference].[vw_rural_urban] AS RU#(lf)ON RU.[LSOACode] = #VW.[LSOA Code] #(lf)#(lf)ORDER BY #vw.[Admission_Week_Ending_Sunday] desc #(lf)#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)------- FINAL OUTPUT INCLUDING VW DISCHARGES WEEK END -----#(lf)#(lf)--SELECT #VWmain.*#(lf)--#(tab), #ref_reporting_dates_ref.Week_End AS 'WeekEnd_Discharge' #(lf)#(lf)--#(tab)FROM #VWmain#(lf)#(lf)--LEFT JOIN  #ref_reporting_dates_ref ON #ref_reporting_dates_ref.date_only = #VWmain.discharge_dateonly #(lf)----INNER JOIN (#(lf)----#(tab)#(tab)SELECT [Week_Ending_Sunday]#(lf)----#(tab)#(tab)FROM #HAH #(lf)----#(tab)#(tab)WHERE [Week_Ending_Sunday] = (SELECT MAX([Week_Ending_Sunday]) FROM #HAH) -- checking the latest week end only#(lf)----#(tab)#(tab)GROUP BY [Week_Ending_Sunday]#(lf)----#(tab)#(tab)HAVING COUNT(DISTINCT CAST(ContactDate AS DATE)) = 7 -- checking to see if 7 individual days have been included across to week #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)  #(tab)   #(lf)----#(tab)#(tab)UNION ALL#(lf)    #(lf)----#(tab)#(tab)-- Include all previous weeks (those before the latest Sunday) regardless of completeness#(lf)----#(tab)#(tab)SELECT [Week_Ending_Sunday]#(lf)----#(tab)#(tab)FROM #HAH#(lf)----#(tab)#(tab)WHERE [Week_Ending_Sunday] < (SELECT MAX([Week_Ending_Sunday]) FROM #HAH)  -- Prior weeks#(lf)----#(tab)#(tab)GROUP BY [Week_Ending_Sunday]) AS FULLWEEKS#(lf)----#(tab)#(tab)ON #HAH.Week_Ending_Sunday = FULLWEEKS.Week_Ending_Sunday#(lf)#(lf)#(lf)--WHERE #VWmain.discharge_datetime BETWEEN '20180401 00:00:00.000' AND GETDATE()#(lf)#(lf)#(lf)----EOMONTH ( DATEADD ( MONTH, -1, GETDATE() ) )  --  The EOMONTH function finds the latest complete month.#(lf)"]),
				    #"Added Custom" = Table.AddColumn(Source, "admitting_counter", each 1),
