	column Latest_week_discharge_flag = ```
			
			IF('01 VW Main'[discharge_Week_Ending_Sunday] = CALCULATE(MAX('01 VW Main'[discharge_Week_Ending_Sunday]), ALL('01 VW Main')), 1, 0) 
