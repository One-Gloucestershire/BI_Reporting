	measure 'Weekly Bed Occupancy' = ```
			
			COUNTROWS(
			    FILTER(
			        '01 VW Main', 
			        '01 VW Main'[admission_dateonly] <= '01 VW Main'[Week_End_Wednesday] &&
			        ('01 VW Main'[discharge_dateonly] > '01 VW Main'[Week_End_Wednesday] || ISBLANK('01 VW Main'[discharge_dateonly])  ) ) )
