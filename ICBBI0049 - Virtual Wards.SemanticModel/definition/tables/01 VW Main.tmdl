	measure 'WEEK Latest4 AVG Admissions' = ```
			
			VAR Latestweekend = CALCULATE(MAX('01 VW Main'[Week_End_Wednesday]), ALL('01 VW Main'))
			VAR Totalforweek = SUMMARIZE(  FILTER('01 VW Main', '01 VW Main'[Previous_admission_4week_flag] = 1), 
			                        '01 VW Main'[Week_End_Wednesday], "TotalOcc", SUM('01 VW Main'[admitting_counter])  )  
			RETURN AVERAGEX(Totalforweek, [TotalOcc])
