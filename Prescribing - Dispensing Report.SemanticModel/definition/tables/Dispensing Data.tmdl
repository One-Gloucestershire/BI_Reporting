table 'Dispensing Data'
	lineageTag: 47478345-5d79-4ae9-a8ae-e4142a0b199c

	measure 'Total Costs (£)' = SUM('Dispensing Data'[Cost])
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 13fc55b7-1dfc-4ffb-a8be-c40dc6b48bf3

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Total Items' = SUM('Dispensing Data'[Items])
		formatString: #,0
		lineageTag: e138726e-d859-4ea4-9d9c-fca2a9c5501e

	measure 'Mapping Chart Title' =
			
			
			CONCATENATE("Gloucestershire Mapping - ", [Item / Cost Title Function])
		lineageTag: fbb29004-bda4-4605-8ee8-8ebea4155b0b

	measure '% of Total Cost' =
			
			DIVIDE([Total Costs (£)], [Overall Cost])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 2470a7de-c99b-4749-96fe-286d1d9570b0

	measure 'Overall Cost' = CALCULATE(SUM('Dispensing Data'[Cost]), ALL('Dispensing Data'), 'Date Reference'[Financial Year] <> BLANK(), 'Dispensing Data'[BNFChapter] <> BLANK())
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 76e9e52e-fefa-4b19-ad95-63095f022c9a

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Average Item Cost' =
			
			
			DIVIDE([Total Costs (£)], [Total Items])
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: 2e4b4c29-c280-4afa-81bb-0b821e5a4f06

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Overall Items' = CALCULATE(SUM('Dispensing Data'[Items]), ALL('Dispensing Data'), 'Date Reference'[Financial Year] <> BLANK(), 'Dispensing Data'[BNFChapter] <> BLANK())
		formatString: 0
		lineageTag: 5003ba39-b28c-441b-a458-12233bd82adb

	measure '% of Total Items' =
			
			DIVIDE([Total Items], [Overall Items])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 322a8d0a-9c05-4a9f-92c6-f6730653741e

	measure 'Hidden Hex Code' =
			
			
			IF(ISFILTERED('Items / Costs Parameter'[Parameter]), "#00FF0000", "#00FF0000")
		lineageTag: 345386a8-79ab-47f0-ab0f-428826f21b25

	measure 'Distinct Patients' = DISTINCTCOUNT('Dispensing Data'[NHS_Number])
		formatString: #,0
		lineageTag: f3ad9ae2-4fa3-4cad-951a-1d0b52a99f92

	measure 'BNF Chart Title' =
			
			
			CONCATENATE("BNF Categories - ", [Item / Cost Title Function])
		lineageTag: a9bfd486-e8b4-48e6-ba24-314e3257ccba

	measure 'Segmentation Bar Chart Title' =
			
			
			CONCATENATE([Item / Cost Title Function], " - Segmented by - " & SELECTCOLUMNS('Legend Filter Parameter', 'Legend Filter Parameter'[Legend Filter Parameter]))
		lineageTag: fbb4da0f-f35b-4578-86aa-59ab869bde57

