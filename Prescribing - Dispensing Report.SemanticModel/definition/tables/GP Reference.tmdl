table 'GP Reference'
	lineageTag: 7e9eaaa0-60d6-4cf5-96a8-15e509a818da

	measure 'Locality Filtered Values' = ```
			
			
			VAR _FILTERED_COUNT = DISTINCTCOUNT('GP Reference'[Locality])
			VAR _MAXVALUES = 10
			
			RETURN 
			
			IF (
			    _FILTERED_COUNT > _MAXVALUES
			    && ISCROSSFILTERED( 'GP Reference'[Locality] )
			    && DISTINCTCOUNT('GP Reference'[Locality]) < CALCULATE(DISTINCTCOUNT('GP Reference'[Locality]), ALL('GP Reference')),
			        CONCATENATE(CONCATENATEX(
			        TOPN(_MAXVALUES,
			        VALUES('GP Reference'[Locality]),
			        'GP Reference'[Locality], ASC
			        ),
			        'GP Reference'[Locality],
			        ", "), ", etc"),
			IF (
			    _FILTERED_COUNT <= _MAXVALUES
			    && ISCROSSFILTERED( 'GP Reference'[Locality] )
			    && DISTINCTCOUNT('GP Reference'[Locality]) < CALCULATE(DISTINCTCOUNT('GP Reference'[Locality]), ALL('GP Reference')),
			    CONCATENATEX(
			        TOPN(_MAXVALUES,
			        VALUES('GP Reference'[Locality]),
			        'GP Reference'[Locality], ASC
			        ),
			        'GP Reference'[Locality],
			        ", "),
			"All Localities are currently selected"
			))
			
			
			```
		lineageTag: f5e519bf-d7cc-4ae4-b64b-62692ffcfc3e

