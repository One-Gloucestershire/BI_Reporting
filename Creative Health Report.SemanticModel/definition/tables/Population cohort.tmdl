table 'Population cohort'
	lineageTag: 876d0e5f-78e1-41e3-b8b0-3e9b057ec679

	measure 'Population - Age Band Measure' = ```
			
			
			VAR _Selection = MAX('Calculation Selection Parameter'[Calculation Selection])
			
			RETURN
			
			SWITCH(
			    TRUE(),
			    CONTAINSSTRINGEXACT(_Selection, "% of Total"), 
			    // Calculation of % of overall total //
			    COUNT('Population cohort'[PseudoNHSNumber])
			    /
			    CALCULATE(
			        COUNT('Population cohort'[PseudoNHSNumber]),
			        ALL('Age Reference')
			),
			    CONTAINSSTRING(_Selection, "Crude Rate Per 1,000"),                                                 
			    // Calculation of Crude Rate per 1,000 //
			    (COUNT('Population cohort'[PseudoNHSNumber])
			    /
			    CALCULATE(
			        COUNT('Population cohort'[PseudoNHSNumber]),
			        ALL('Age Reference')) * 1000
			    ),
			    // Otherwise produce a Blank value //
			    BLANK()
			)
			```
		lineageTag: 7a1b05e9-7e7c-4ff8-a276-786198023105

		formatStringDefinition = ```
				VAR _Selection = MAX('Calculation Selection Parameter'[Calculation Selection])
				
				RETURN
				
				SWITCH(
				    TRUE(),
				    CONTAINSSTRINGEXACT(_Selection, "% of Total"), 
				    "0.0%"
				    ,
				    CONTAINSSTRING(_Selection, "Crude Rate Per 1,000"),                                                 
				    "0,0.0",
				    BLANK()
				    )
				```

