		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db01_reference"), "select distinct age as ""Age"", case when ""10yr_age_band""='0-9' then '00-09' else ""10yr_age_band"" end as ""10YR_Age_Band"", case when ""5yr_age_band""='0-4' then '00-04' when ""5yr_age_band""='5-9' then '05-09' else ""5yr_age_band"" end as ""5YR_Age_Band"", case when age >= 55 then '55+' else 'Under 55' end as ""55 and Over"" from ccg_reference.vw_ageband where age between 0 and 120", null, [EnableFolding=true])
