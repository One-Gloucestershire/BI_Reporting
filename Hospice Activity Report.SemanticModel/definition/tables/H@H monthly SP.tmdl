	measure 'New Average Referrals a Day' =
			
			
			var day_count = sum('REF date_table'[Day Counter])
			var total_pcs = CALCULATE(SUM('H@H monthly SP'[Counter]))
			RETURN total_pcs / day_count
		lineageTag: b53bfdde-6bfb-432f-b8d7-a21df69ba237

