table 'H@H monthly SP'
	lineageTag: f23f5dc6-8741-4a47-8609-b79037436129

	measure Referrals_accepted =
			
			CALCULATE(
				COUNTA('H@H monthly SP'[Counter]),
				'H@H monthly SP'[Referral_Accepted] IN { "Yes" }
			)
		formatString: #,0
		lineageTag: a55284de-9a65-48f7-811c-05d5876f9479

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "FilteredMeasure"
				}

	measure Referrals = sum([Counter])
		formatString: #,0
		lineageTag: bca61a9d-72e7-4e6f-97bf-49fe0956e8ac

	measure counter_small_number_suppression = if(and(count('H@H monthly SP'[Counter])<5,count('H@H monthly SP'[Counter])>0),"<5",count('H@H monthly SP'[Counter]))
		formatString: 0
		lineageTag: 21b35212-b5c5-4bcb-903e-af6c117f8149

	measure practice_%_of_total =
			DIVIDE(
			                            CALCULATE(
			                                COUNT('H@H monthly SP'[Practice])
			                            ),
			                            CALCULATE(
			                                COUNT('H@H monthly SP'[Practice]),
			                                ALL('H@H monthly SP')
			                                )
			                            )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d52fc973-332f-49e7-bf7c-37ab3ded349f

		changedProperty = FormatString

	measure %_of_total = ```
			
			        divide(
			            sum('H@H monthly SP'[Counter]),
			                calculate(
			                    sum('H@H monthly SP'[Counter]),
			                    allselected('H@H monthly SP')
			                    ))
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 839e0d9d-34be-4f40-807f-e9d7a8de4216

		changedProperty = FormatString

	measure %_accepted =
			
			DIVIDE(
			    CALCULATE(
				COUNTA('H@H monthly SP'[Counter]),	'H@H monthly SP'[Referral_Accepted] IN { "Yes" }),
			    CALCULATE(COUNTA('H@H monthly SP'[Counter]),ALL('H@H monthly SP'[Referral_Accepted]))
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 984333ad-662e-4fdd-8c2d-f5ebf1a0779c

	measure nhs_no_completion = ```
			
			        divide(
			            sum('H@H monthly SP'[nhs_no_flag]),
			                calculate(
			                    sum('H@H monthly SP'[Counter])
			                    
			                    ))
			```
		formatString: 0%;-0%;0%
		lineageTag: 94521b07-e71d-41ae-8a96-256dfbccecd6

	measure %_cancer =
			
			DIVIDE(
			    CALCULATE(
				COUNTA('H@H monthly SP'[Counter]),	'H@H monthly SP'[Primary_Diagnosis] IN { "Cancer" }),
			    CALCULATE(COUNTA('H@H monthly SP'[Counter]),ALL('H@H monthly SP'[Primary_Diagnosis]))
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c3df058d-7a7f-4732-aa64-b1292c3469f6

	measure 'Sum of Hospice Referrals' = CALCULATE(SUM('H@H monthly SP'[Counter]))
		formatString: 0
		lineageTag: ed7613ba-b315-46e0-9e78-d954c1862108

	measure 'H@H Referrals Rate per 1000 - By Month' =
			
			
			VAR HAHREF =
			    CALCULATE (
			        SUM ( 'H@H monthly SP'[Counter] )
			    )
			
			VAR POP =
			    CALCULATE (
			        SUM ( 'REF Population'[population] )
			    )
			
			RETURN
			    DIVIDE ( HAHREF * 1000, POP, BLANK () )
		lineageTag: ca7bc70f-e442-4c6f-be1c-0715b6e91628

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'H@H Referrals - By Year' =
			
			
			VAR HAHREF =
			    CALCULATE (
			        SUM ( 'H@H monthly SP'[Counter] )
			    )
			
			VAR POP =
			    CALCULATE (
			        SUM ( 'REF Population'[population] ),
			        'REF date_table'[month_name] IN { "Apr" },
			        NOT ( ISBLANK ( 'REF Population'[population] ) )
			    )
			
			RETURN
			    DIVIDE ( HAHREF * 1000, POP, BLANK () )
		lineageTag: fa23b422-ff43-48fb-b37d-950406d53e00

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Average Acccepted H@H Referrals with Funding in Place per Day' = ```
			
			var max_date = ENDOFMONTH('H@H monthly SP'[Referral_Date])
			var min_date = STARTOFMONTH('H@H monthly SP'[Referral_Date])
			var diff = DATEDIFF(min_date, max_date, DAY)
			var total_hours = CALCULATE(sum('H@H monthly SP'[Counter]),'H@H monthly SP'[Referral_accepted_–_funding_in_place] = "Yes")
			RETURN total_hours / diff 
			```
		formatString: 0.00
		lineageTag: 929bfc7b-bcc5-4158-863a-d0a7c106d5dc

	measure 'Total Average H@H Referrals per Day' =
			
			var max_date = ENDOFMONTH('H@H monthly SP'[Referral_Date])
			var min_date = STARTOFMONTH('H@H monthly SP'[Referral_Date])
			var diff = DATEDIFF(min_date, max_date, DAY) +1
			var total_hours = sum('H@H monthly SP'[Counter])
			RETURN total_hours / diff
		lineageTag: f7ac5783-7a47-4c55-84ac-0eb4cb132af9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure eom = STARTOFMONTH('H@H monthly SP'[Referral_Date])
		formatString: General Date
		lineageTag: 7b293302-0853-4cca-b55b-6c55c43ede38

	measure 'Total Average Acccepted H@H Referrals per Day' =
			
			var max_date = ENDOFMONTH('H@H monthly SP'[Referral_Date])
			var min_date = STARTOFMONTH('H@H monthly SP'[Referral_Date])
			var diff = DATEDIFF(min_date, max_date, DAY)
			var total_hours = CALCULATE(sum('H@H monthly SP'[Counter]),'H@H monthly SP'[Referral_Accepted] = "Yes")
			RETURN total_hours / diff
		lineageTag: 5cad9e5b-e13e-4662-ac39-fe55087081c4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average H@H Refferals per Day' =
			
			CALCULATE((AVERAGEX(
				KEEPFILTERS(VALUES('REF date_table'[day_month_year])),
				CALCULATE(sum('H@H monthly SP'[Counter])) +0
			)  ))
		lineageTag: f4bf7cab-d38e-47f0-9495-83b5d9f27f9e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Accepted H@H Refferals per Day' =
			
			CALCULATE((AVERAGEX(
				KEEPFILTERS(VALUES('REF date_table'[day_month_year])),
				CALCULATE(sum('H@H monthly SP'[Counter]), 'H@H monthly SP'[Referral_Accepted] = "Yes") +0
			)  ))
		lineageTag: fea943e3-a784-4cf3-84cc-3254f0072762

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Accepted H@H Refferals with Funding in Place per Day' = ```
			
			
			
			CALCULATE((AVERAGEX(
			    KEEPFILTERS(VALUES('REF date_table'[day_month_year])),
			    CALCULATE(sum('H@H monthly SP'[Counter]), 'H@H monthly SP'[Referral_accepted_–_funding_in_place] = "Yes") +0
			)  )) 
			
			```
		lineageTag: 96449f07-e49a-4124-8fb9-f24ca6f4a0bd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Hospice at Home Referrals per Month correct' =
			
			var max_date = ENDOFMONTH('H@H monthly SP'[Referral_Date])
			var min_date = STARTOFMONTH('H@H monthly SP'[Referral_Date])
			var diff = DATEDIFF(min_date, max_date, MONTH) + 1
			var total_hours = sum('H@H monthly SP'[Counter])
			RETURN total_hours / diff
		lineageTag: 658faaec-c67a-491e-8592-c732216df779

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Number of Patients Died within 3 Days of Referral' = CALCULATE(SUM('H@H monthly SP'[Counter]),'H@H monthly SP'[Days between referral and death using Discharge date] <= 3  && 'H@H monthly SP'[Days between referral and death using Discharge date] <> BLANK())
		formatString: 0
		lineageTag: 6fed9000-0f45-4150-b4a7-030cb4189e16

	measure '% of Patients Died within 3 Days of Referral' = ```
			CALCULATE([Number of Patients Died within 3 Days of Referral] / CALCULATE(SUM('H@H monthly SP'[Counter]))) 
			```
		formatString: 0.00%;-0.00%;0.00%
