	partition 'REF GP' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db01_reference"), "select case when locality ilike 'North Cotswolds' then 'Cotswolds' when locality ilike 'South Cotswolds' then 'Cotswolds' else locality end as ""Locality"", primarycarenetwork as ""PrimaryCareNetwork"", organisationcode as ""OrganisationCode"", organisationname as ""OrganisationName"" from icb_data_reference.vw_gppractice where commissioner = '11M' and locality is not null and statusdescription = 'Active'", null, [EnableFolding=true])
