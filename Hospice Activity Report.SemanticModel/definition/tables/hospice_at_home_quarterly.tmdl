table hospice_at_home_quarterly
	lineageTag: 6acb6d85-a2bb-4952-9f75-730ab77f104b

	measure 'Total Average Hours of Care per Day' = ```
			
			var max_date = ENDOFMONTH('hospice_at_home_quarterly'[Month])
			var min_date = STARTOFMONTH('hospice_at_home_quarterly'[Month])
			var diff = DATEDIFF(min_date, max_date, DAY) + 31
			var total_hours = sum('hospice_at_home_quarterly'[total_hours_of_care]) 
			RETURN total_hours / diff
			```
		lineageTag: f354beca-5b82-4530-a52f-4a289c2e2898

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Average Hours of Care per Month correct' =
			
			var max_date = ENDOFMONTH('hospice_at_home_quarterly'[Month])
			var min_date = STARTOFMONTH('hospice_at_home_quarterly'[Month])
			var diff = DATEDIFF(min_date, max_date, MONTH) + 1
			var total_hours = sum('hospice_at_home_quarterly'[total_hours_of_care])
			RETURN total_hours / diff
		formatString: 0
		lineageTag: f4dfd474-9c57-4710-a281-088294cfa998

	measure 'Average Hours of Care per Day' =
			
			CALCULATE((AVERAGEX(
				KEEPFILTERS(VALUES('REF date_table (2)'[day_month_year])),
				CALCULATE(sum(hospice_at_home_quarterly[total_hours_of_care])) +0
			)  ))
		lineageTag: c9e0138b-890c-4b91-81ca-baa147894a3d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Date Diff Total Average Hours of Care per Month correct' =
			
			var max_date = ENDOFMONTH('hospice_at_home_quarterly'[Month])
			var min_date = STARTOFMONTH('hospice_at_home_quarterly'[Month])
			var diff = DATEDIFF(min_date, max_date, MONTH) +1
			var total_hours = sum('hospice_at_home_quarterly'[total_hours_of_care])
			RETURN diff
		formatString: 0
		lineageTag: b3bfac44-f83a-40be-af57-97162f0c0490

	measure 'Date Diff Day Average Hours of Care per Day' =
			
			var max_date = ENDOFMONTH('hospice_at_home_quarterly'[Month])
			var min_date = STARTOFMONTH('hospice_at_home_quarterly'[Month])
			var diff = DATEDIFF(min_date, max_date, DAY) + 31
			
			RETURN diff
		formatString: 0
		lineageTag: a7ab6ae9-e5e4-4802-90a1-8989d0cd3761

	measure 'Total hours monthly (per 12 months)' = CALCULATE(sum(hospice_at_home_quarterly[total_hours_of_care]) / 12)
		formatString: 0
		lineageTag: 592c3832-b36a-4d32-8fbb-994eb7049d34

