	column 'H&H Quarterly YTD' =
			
			
			VAR current_month = MONTH('hospice_at_home_quarterly'[Month])
			VAR f_current_month = SWITCH(TRUE(),
			current_month = 4, 1,
			current_month = 5, 2,
			current_month = 6, 3,
			current_month = 7, 4,
			current_month = 8, 5,
			current_month = 9, 6,
			current_month = 10, 7,
			current_month = 11, 8,
			current_month = 12, 9,
			current_month = 1, 10,
			current_month = 2, 11,
			current_month = 3, 12
			)
			
			VAR max_month = CALCULATE(MONTH(MAX('hospice_at_home_quarterly'[Month])),ALLEXCEPT('hospice_at_home_quarterly','hospice_at_home_quarterly'[Provider]))
			VAR f_max_month = SWITCH(TRUE(),
			max_month = 4, 1,
			max_month = 5, 2,
			max_month = 6, 3,
			max_month = 7, 4,
			max_month = 8, 5,
			max_month = 9, 6,
			max_month = 10, 7,
			max_month = 11, 8,
			max_month = 12, 9,
			max_month = 1, 10,
			max_month = 2, 11,
			max_month = 3, 12
			)
			
			return if(f_current_month <= f_max_month, "Year to Date", "Not Year to Date")
		lineageTag: 82926e08-87d4-4c81-ad86-c99eed951d45
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column max_month = CALCULATE(MONTH(MAX('hospice_at_home_quarterly'[Month])),ALLEXCEPT('hospice_at_home_quarterly','hospice_at_home_quarterly'[Provider]))
		formatString: 0
		lineageTag: 39c7a8f8-210f-43a3-869f-7cb6b6a6bcbe
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Current Year Flag' = ```
			
			
			VAR max_year = YEAR(MAX('hospice_at_home_quarterly'[Month]
			))
			VAR max_month = MONTH(MAX('hospice_at_home_quarterly'[Month]
			))
			VAR financial_month = SWITCH(TRUE(),
			max_month = 4, 1,
			max_month = 5, 2,
			max_month = 6, 3,
			max_month = 7, 4,
			max_month = 8, 5,
			max_month = 9, 6,
			max_month = 10, 7,
			max_month = 11, 8,
			max_month = 12, 9,
			max_month = 1, 10,
			max_month = 2, 11,
			max_month = 3, 12
			)
			VAR current_year = SWITCH(TRUE(),
			max_month = 1, max_year - 1,
			max_month = 2, max_year - 1,
			max_month = 3, max_year - 1,
			max_month = 4, max_year,
			max_month = 5, max_year,
			max_month = 6, max_year,
			max_month = 7, max_year,
			max_month = 8, max_year,
			max_month = 9, max_year,
			max_month = 10, max_year,
			max_month = 11, max_year,
			max_month = 12, max_year
			)
			
			VAR adjusted_year = if(
			    MONTH('hospice_at_home_quarterly'[Month])= 1, YEAR('hospice_at_home_quarterly'[Month]
			) -1, 
			    if(MONTH('hospice_at_home_quarterly'[Month]) = 2, YEAR('hospice_at_home_quarterly'[Month]
			) -1, 
			    if(MONTH('hospice_at_home_quarterly'[Month]) = 3, YEAR('hospice_at_home_quarterly'[Month]
			) -1, year('hospice_at_home_quarterly'[Month]
			))))
			
			var year_flag = IF(adjusted_year = current_year, "Current Year", IF(adjusted_year = current_year - 1, "Previous Year", "Other Year"))
			
			RETURN year_flag
			```
		lineageTag: 9ac6d081-54d8-4575-899f-6441ce7de7c0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

