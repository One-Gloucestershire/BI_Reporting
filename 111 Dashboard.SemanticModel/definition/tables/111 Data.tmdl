	column Derived_PPG_Final_Disposition_Group =
			
			IF (
			    '111 Data'[DispositionGroup(PPG)]= "Call Closed",
			    "Call Closed",
			    IF (
			        '111 Data'[DispositionGroup(PPG)]= "Primary Care Contact",
			        "Contact Primary Care",
			           IF (
			            '111 Data'[DispositionGroup(PPG)] = "Primary Care Speak To",
			            "Contact Primary Care",
			        IF (
			        '111 Data'[DispositionGroup(PPG)]= "Category 1/2 Ambulance",
			        "Ambulance",
			                IF (
			        '111 Data'[DispositionGroup(PPG)]= "Category 3/4 Ambulance",
			        "Ambulance",
			            "All Other dispositions"
			        )
			    )
			)))
		lineageTag: 527c9899-abc3-4e57-b9b7-2ea1247cac71
		summarizeBy: none

