	partition '111 Data-47235561-0715-4ae8-a713-589783b761c8' = m
		mode: import
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "PowerBI_Reporting", [Query="select *#(lf),[Call_Closed_Flag] = CASE WHEN [DispositionGroup(PPG)] = 'Call Closed'  then 1 else 0 end#(lf),[Category_1/2_Ambulance_Flag] = CASE WHEN [DispositionGroup(PPG)] = 'Category 1/2 Ambulance' then 1 else 0 end#(lf),[Category_3/4_Ambulance_Flag] = CASE WHEN [DispositionGroup(PPG)] = 'Category 3/4 Ambulance' then 1 else 0 end#(lf),[COVID-19_Flag] =  CASE WHEN [DispositionGroup(PPG)] = 'COVID-19' then 1 else 0 end#(lf),[Dental_Flag] = CASE WHEN [DispositionGroup(PPG)] = 'Dental' then 1 else 0 end#(lf),[ED_Flag] = CASE WHEN [DispositionGroup(PPG)] = 'ED' then 1 else 0 end#(lf),[Home_Management_Flag] = CASE WHEN [DispositionGroup(PPG)] = 'Home Management' then 1 else 0 end#(lf),[Other_Service_Referral_Flag] = CASE WHEN [DispositionGroup(PPG)] = 'Other Service Referral' then 1 else 0 end#(lf),[Pharmacy/Prescription_Flag] = CASE WHEN [DispositionGroup(PPG)] = 'Pharmacy/Prescription' then 1 else 0 end#(lf),[Primary_Care_Contact_Flag] = CASE WHEN [DispositionGroup(PPG)] = 'Primary Care Contact' then 1 else 0 end#(lf),[Primary_Care_Speak_To_Flag] = CASE WHEN [DispositionGroup(PPG)] = 'Primary Care Speak To' then 1 else 0 end#(lf),[Speak_to_CA_Flag] = CASE WHEN [DispositionGroup(PPG)] = 'Speak to CA' then 1 else 0 end#(lf),[Last_Updated] = cast(getdate() as date)#(lf)from [PowerBI_Reporting].[dbo].[111_all_calls]#(lf)#(lf)#(lf)where cast(DateOfCase as date) between '20201201' and eomonth(dateadd(month, -1, getdate()))"]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"DateOfCase", type date}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

