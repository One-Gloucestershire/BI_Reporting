	measure 'Redirect % By Final Disposition on Columns' =
			
			DIVIDE (
			sum('111 Data'[Redirect]),
			CALCULATE ( sum('111 Data'[Redirect]),ALLSELECTED('111 Data'[FinalDispositonDescription]))
			)
		formatString: 0.00%;-0.00%;0.00%
