	partition GP_Practice_Populations_over_time-3b9bd41f-4e8e-4093-bdac-9292b9e34415 = m
		mode: import
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "CCG_Reference", [Query="----------------------------------#(lf)-------- POPULATION TABLE --------#(lf)----------------------------------#(lf)#(lf)SELECT DISTINCT#(lf)--[Practice Code] = [P].[OrganisationCode],#(lf)--[Practice Name] = [P].[OrganisationName],#(lf)--[Locality] = CASE WHEN [GP].[Locality] IN ('South Cotswolds','North Cotswolds') THEN 'Cotswolds' ELSE [GP].[Locality] END ,#(lf)--[Primary Care Network] = CASE WHEN [GP].[PrimaryCareNetwork] = 'Tewkesbury, Newent and Staunton and West Cheltenham Medical' THEN 'TWNS' ELSE [GP].[PrimaryCareNetwork] END,#(lf)CensusDate,#(lf)--Age,#(lf)[CensusDate_as_date] = CAST('01-'+LEFT(CENSUSDATE,3)+'-20'+RIGHT(CENSUSDATE,2)AS DATE),#(lf)[Total 65+ Population] = SUM([Total])#(lf)#(lf)#(lf)FROM [CCG_Reference].[Reference].[vw_GPPracticePopulation] [P]#(lf)#(lf)LEFT JOIN [CCG_Reference].[Reference].[vw_GPPractice] AS [GP]#(lf)ON [P].[OrganisationCode] = [GP].[OrganisationCode]#(lf)#(lf)WHERE AgeGroupType = 'GROUP 1'#(lf)and left(Age,2) >= 65  #(lf)AND [P].[OrganisationCode] <> 'Y00054' -- excluded homeless health team#(lf)group by CensusDate#(lf)#(lf)#(lf)#(lf)order by CensusDate_as_date asc#(lf)"])
				in
				    Source

	annotation PBI_ResultType = Table

