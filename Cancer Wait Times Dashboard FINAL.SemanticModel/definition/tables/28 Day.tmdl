		lineageTag: 65dc6e21-2142-465b-b54b-e82616f7f5b1

		annotation Format = <Format Format="Percentage" Accuracy="1" />

	measure '28 Day Target %' = MIN('28 Day'[Target])
		lineageTag: 58e629fe-cb8b-4a60-8665-c442ab19c691

		annotation Format = <Format Format="General" />

	measure '28 Day Target Checker' = IF('28 Day'[28 Day Performance] >= '28 Day'[28 Day Target %], "#63BE7B","#F8696B")
		lineageTag: b00b16ca-cac3-42fe-ae5d-19c7d26224ee

		annotation Format = <Format Format="Text" />

