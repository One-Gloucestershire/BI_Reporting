table '28 Day'
	lineageTag: d7cc0c22-4fb9-493f-8503-6b34c1bf7d87

	measure '28 Day Performance' = (SUM('28 Day'[Total Patients])-SUM('28 Day'[Breaches]))/(SUM('28 Day'[Total Patients]))
