	partition '28 Day-b49290f1-728c-4371-8cac-ee248cbab78a' = m
		mode: import
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "Data_Mart_Performance", [Query="-----------------------#(lf)--- 28 DAY STANDARD ---#(lf)-----------------------#(lf)#(lf)SELECT [Type] = '28 Day'#(lf)      ,[First_Seen_Provider] [First Seen Provider Code]#(lf)#(tab)  ,CASE WHEN [First_Seen_Provider] = 'RTE' THEN 'Gloucestershire Hospitals NHS Foundation Trust'#(lf)            ELSE 'Other Provider' END AS [First Seen Provider Group]#(lf)      ,[Urgent_Suspected_Cancer_Type] [Tumour Type]#(lf)#(tab)  #(tab)  ,CASE WHEN [Urgent_Suspected_Cancer_Type] = 'acute leukaemia' THEN 'Suspected Acute Leukaemia'#(lf)#(tab)        WHEN [Urgent_Suspected_Cancer_Type] LIKE '%brain%' THEN 'Suspected Brain / Central Nervous System'#(lf)#(tab)#(tab)#(tab)WHEN [Urgent_Suspected_Cancer_Type] LIKE '%cancer not initially suspected%' THEN 'Non-Cancer Breast Symptoms'#(lf)#(tab)#(tab)    WHEN [Urgent_Suspected_Cancer_Type] LIKE '%breast%' THEN 'Suspected Breast'#(lf)#(tab)#(tab)#(tab)WHEN [Urgent_Suspected_Cancer_Type] LIKE '%children%' THEN 'Suspected Childrens Cancer'#(lf)#(tab)#(tab)#(tab)WHEN [Urgent_Suspected_Cancer_Type] LIKE '%gynaecological%' THEN 'Suspected Gynaecological'#(lf)#(tab)#(tab)#(tab)WHEN [Urgent_Suspected_Cancer_Type] LIKE '%Suspected haematological malignancies excluding acute leukaemia%' THEN 'Suspected Haematological Malignancies'#(lf)#(tab)#(tab)#(tab)WHEN [Urgent_Suspected_Cancer_Type] LIKE '%Head and Neck%' THEN 'Suspected Head and Neck'#(lf)#(tab)#(tab)#(tab)WHEN [Urgent_Suspected_Cancer_Type] LIKE '%lower gastrointestinal%' THEN 'Suspected Lower Gastrointestinal'#(lf)#(tab)#(tab)#(tab)WHEN [Urgent_Suspected_Cancer_Type] LIKE '%lung%' THEN 'Suspected Lung'#(lf)#(tab)#(tab)#(tab)WHEN [Urgent_Suspected_Cancer_Type] LIKE '%other%' THEN 'Suspected Other'#(lf)#(tab)#(tab)#(tab)WHEN [Urgent_Suspected_Cancer_Type] LIKE '%sarcoma%' THEN 'Suspected Sarcoma'#(tab)   #(lf)#(tab)#(tab)#(tab)WHEN [Urgent_Suspected_Cancer_Type] LIKE '%skin%' THEN 'Suspected Skin'#(lf)#(tab)#(tab)#(tab)WHEN [Urgent_Suspected_Cancer_Type] LIKE '%suspected testicular%' THEN 'Suspected Testicular'#(lf)#(tab)#(tab)#(tab)WHEN [Urgent_Suspected_Cancer_Type] LIKE '%upper gastrointestinal%' THEN 'Suspected Upper Gastrointestinal'#(lf)#(tab)#(tab)#(tab)WHEN [Urgent_Suspected_Cancer_Type] LIKE '%Suspected urological cancers (excluding testicular)%' THEN 'Suspected Urological'#(lf)#(tab)#(tab)#(tab)ELSE 'Unknown' END AS [Tumour Group]#(lf)#(tab)  ,[No_Of_Patients] [Total Patients]#(lf)#(tab)  ,[Breaches] = ([Days_29_To_38]+[Days_39_To_62]+[Days_63_And_More])#(lf)      ,[Report_Number] [Report Number]#(lf)     #(tab)  ,CASE WHEN [Report_Number] = '18.1' THEN '18.1 28 Day Two Week Wait'#(lf)#(tab)            WHEN [Report_Number] = '18.2' THEN '18.2 28 Day Two Week Wait Non-Cancer Breast Symptoms'#(lf)#(tab)#(tab)#(tab)    WHEN [Report_Number] = '18.3' THEN '18.3 28 Day Screening'#(lf)#(tab)#(tab)#(tab)ELSE 'ERROR' END AS [Report Name]#(lf)#(tab)  ,[B].[FinancialYear] [Financial Year]#(lf)      ,LEFT([Report_Month],3) as [Month]#(lf)#(tab)  ,[B].[FinancialMonth] [Financial Month]#(lf)#(lf)  FROM [Data_Mart_Performance].[dbo].[Cancer_28_Day_Aggregate_Data] a#(lf)  LEFT JOIN  [CCG_Reference].[Reference].[vw_DateLookup] b on a.[Report_Date] = b.[Date]#(lf)  WHERE [Report_Date] > '20190331'#(lf)  AND [Extract_Type] = 'Monthly'"]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Financial Month", Int64.Type}, {"Report Number", type number}})
				in
				    #"Changed Type"

	annotation PBI_DescriptionAtRefresh

