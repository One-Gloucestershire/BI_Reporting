table 'Two Week Wait'
	lineageTag: 47554672-258c-4206-823f-163625564fbc

	measure 'Two Week Wait Performance' = (SUM('Two Week Wait'[Total Referrals])-SUM('Two Week Wait'[Breaches]))/SUM('Two Week Wait'[Total Referrals])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 1d00ec46-5578-4af4-b1c7-fc63f0a5f7ae

		annotation Format = <Format Format="Percentage" Accuracy="1" />

	measure '2WW Target %' = MIN('Two Week Wait'[Target])
		lineageTag: 7bf585ca-600c-435c-aecf-dc5e39af869c

		annotation Format = <Format Format="General" />

	measure '2WW Target Checker' = IF('Two Week Wait'[Two Week Wait Performance] >= 'Two Week Wait'[2WW Target %], "#63BE7B","#F8696B")
		lineageTag: 56892b3b-db4d-4165-b1e6-52c99a11f7f8

		annotation Format = <Format Format="Text" />

