	partition 'Two Week Wait-7db293eb-814f-4173-88fd-8638f97498b6' = m
		mode: import
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "Data_Mart_Performance", [Query="------------------------------#(lf)--- TWO WEEK WAIT STANDARD ---#(lf)------------------------------#(lf)#(lf)SELECT [Type] = '2WW'#(lf)      ,[Provider_Code] [Provider Code]#(lf)#(tab)  ,CASE WHEN [Provider_Code] = 'RTE' THEN 'Gloucestershire Hospitals NHS Foundation Trust'#(lf)            ELSE 'Other Provider' END AS [Provider Group]#(lf)      ,[Tumour_Type] [Tumour Type]#(lf)#(tab)  ,CASE WHEN [Tumour_Type] = 'acute leukaemia' THEN 'Suspected Acute Leukaemia'#(lf)#(tab)        WHEN [Tumour_Type] LIKE '%brain%' THEN 'Suspected Brain / Central Nervous System'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%cancer not initially suspected%' THEN 'Non-Cancer Breast Symptoms'#(lf)#(tab)#(tab)    WHEN [Tumour_Type] LIKE '%breast%' THEN 'Suspected Breast'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%children%' THEN 'Suspected Childrens Cancer'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%gynaecological%' THEN 'Suspected Gynaecological'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%Suspected haematological malignancies excluding acute leukaemia%' THEN 'Suspected Haematological Malignancies'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%Head and Neck%' THEN 'Suspected Head and Neck'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%lower gastrointestinal%' THEN 'Suspected Lower Gastrointestinal'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%lung%' THEN 'Suspected Lung'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%other%' THEN 'Suspected Other'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%sarcoma%' THEN 'Suspected Sarcoma'#(tab)   #(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%skin%' THEN 'Suspected Skin'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%suspected testicular%' THEN 'Suspected Testicular'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%upper gastrointestinal%' THEN 'Suspected Upper Gastrointestinal'#(lf)#(tab)#(tab)#(tab)WHEN [Tumour_Type] LIKE '%Suspected urological cancers (excluding testicular)%' THEN 'Suspected Urological'#(lf)#(tab)#(tab)#(tab)ELSE 'ERROR' END AS [Tumour Group]#(lf)      ,[Total_Referrals_Seen_During_The_Period] [Total Referrals]#(lf)#(tab)  ,[Breaches] = ([Seen_15_To_16_Days]+[Seen_17_To_21_Days]+[Seen_22_To_28_Days]+[Seen_After_28_Days])#(lf)#(tab)  ,[Target] = '93%'#(lf)      ,[%_Meeting_Standard] [Performance]#(lf)      ,[Report_Number] [Report Number]#(lf)#(tab)  ,CASE WHEN [Report_Number] = '6.3' THEN '6.3 - Two Week Wait'#(lf)#(tab)        WHEN [Report_Number] = '6.4' THEN '6.4 - Breast Symptom Two Week Wait'#(lf)#(tab)#(tab)#(tab)ELSE 'ERROR' END AS [Report Name]#(lf)#(tab)  ,[B].[FinancialYear] [Financial Year]#(lf)      ,LEFT([Report_Month],3) as [Month]#(lf)#(tab)  ,[B].[FinancialMonth] [Financial Month]#(lf)#(lf)  FROM [Data_Mart_Performance].[dbo].[Cancer_2_Week_Aggregate_Data] [A]#(lf)  LEFT JOIN  [CCG_Reference].[Reference].[vw_DateLookup] [B] on [A].[Report_Date] = [B].[Date]#(lf)  WHERE [Report_Date] > '20190331'#(lf)  AND [Extract_Type] = 'Monthly'"]),
				    #"Changed Type1" = Table.TransformColumnTypes(Source,{{"Target", Percentage.Type}}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Changed Type1",{{"Financial Month", Int64.Type}, {"Report Number", type number}})
				in
				    #"Changed Type"

	annotation PBI_DescriptionAtRefresh

	annotation PBI_ResultType = Table

