		lineageTag: 54b94189-ccf3-43fa-bfa9-d67e8b2b11e6

		annotation Format = <Format Format="General" />

	measure '31 Day Target Checker' = IF('31 Day'[31 Day Performance] >= '31 Day'[31 Day Target %], "#63BE7B","#F8696B")
