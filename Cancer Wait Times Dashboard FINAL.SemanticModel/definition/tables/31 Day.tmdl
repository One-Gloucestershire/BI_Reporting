	partition '31 Day-7ae55095-11bb-4b7c-9f99-facf98f9280f' = m
		mode: import
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "Data_Mart_Performance", [Query="------------------------------------#(lf)--- 31 DAY TUMOUR GROUP STANDARD ---#(lf)------------------------------------#(lf)#(lf)SELECT [Standard Group] = '31 Day Tumour'#(lf)      ,[Provider_Code] [Provider Code]#(lf)#(tab)  ,CASE WHEN [Provider_Code] = 'RTE' THEN 'Gloucestershire Hospitals NHS Foundation Trust'#(lf)            ELSE 'Other Provider' END AS [Provider Group]#(lf)      ,[Tumour_Type] [Type]#(lf)#(tab)  ,[Total_Treated] [Total Treated]#(lf)#(tab)  ,[Treated_After_31_Days] [Breaches]#(lf)      ,CASE WHEN [Report_Number] = '7.4' THEN '96%'#(lf)#(tab)#(tab)#(tab)ELSE 'ERROR' END AS [Target]#(lf)      ,[%_Meeting_Standard] [Performance]#(lf)      ,[Report_Number] [Report Number]#(lf)#(tab)  ,CASE WHEN [Report_Number] = '7.4' THEN '7.4 - 31 Day First Treatment'#(lf)#(tab)#(tab)#(tab)ELSE 'ERROR' END AS [Report Name]#(lf)#(tab)  ,[B].[FinancialYear] [Financial Year]#(lf)      ,LEFT([Report_Month],3) as [Month]#(lf) #(tab)  ,[B].[FinancialMonth] [Financial Month]#(lf) #(lf)  FROM [Data_Mart_Performance].[dbo].[Cancer_31_Day_Aggregate_Data] [A]#(lf)  LEFT JOIN  [CCG_Reference].[Reference].[vw_DateLookup] [B] ON [A].[Report_Date] = [B].[Date]#(lf)  WHERE [Report_Date] > '20190331'#(lf)  AND [Extract_Type] = 'Monthly'#(lf)#(lf)  UNION ALL#(lf)#(lf)---------------------------------------#(lf)--- 31 DAY TREATMENT GROUP STANDARD ---#(lf)---------------------------------------#(lf)#(lf)  SELECT [Standard Group] = '31 Day Treatment'#(lf)      ,[Provider_Code] [Provider Code]#(lf)#(tab)  ,CASE WHEN [Provider_Code] = 'RTE' THEN 'Gloucestershire Hospitals NHS Foundation Trust'#(lf)            ELSE 'Other Provider' END AS [Provider Group]#(lf)      ,[Treatment_Group] [Type]#(lf)#(tab)  ,[Total_Treated] [Total Treated]#(lf)#(tab)  ,[Treated_After_31_Days] [Breaches]#(lf)#(tab)  ,CASE WHEN [Report_Number] = '7.11' AND [Treatment_Group] = 'Radiotherapy Treatments'THEN '94%'#(lf)#(tab)  #(tab)    WHEN [Report_Number] = '7.11' AND [Treatment_Group] = 'Surgery'THEN '94%'#(lf)#(tab)        WHEN [Report_Number] = '7.11' AND [Treatment_Group] = 'Drug Treatments'THEN '98%'#(lf)#(tab)#(tab)#(tab)ELSE 'ERROR' END AS [Target]#(lf)      ,[%_Meeting_Standard] [Performance]#(lf)      ,[Report_Number] [Report Number]#(lf)#(tab)  ,CASE WHEN [Report_Number] = '7.11' THEN '7.11 - 31 Day Subsequent Treatment'#(lf)#(tab)#(tab)#(tab)ELSE 'ERROR' END AS [Report Name]#(lf)#(tab)  ,[B].[FinancialYear] [Financial Year]#(lf)      ,LEFT([Report_Month],3) as [Month]#(lf)#(tab)  ,[B].[FinancialMonth] [Financial Month]#(lf)#(lf)  FROM [Data_Mart_Performance].[dbo].[Cancer_31_Day_Treatment_Aggregate_Data] [A]#(lf)  LEFT JOIN  [CCG_Reference].[Reference].[vw_DateLookup] [B] ON [A].[Report_Date] = [B].[Date]#(lf)  WHERE [Report_Date] > '20190331'#(lf)  AND [Extract_Type] = 'Monthly'"]),
				    #"Changed Type2" = Table.TransformColumnTypes(Source,{{"Target", Percentage.Type}}),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Changed Type2",{{"Financial Month", Int64.Type}}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Changed Type1",{{"Report Number", type number}})
				in
				    #"Changed Type"

	annotation PBI_DescriptionAtRefresh

