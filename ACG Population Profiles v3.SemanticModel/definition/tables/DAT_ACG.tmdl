	partition DAT_ACG = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Current", [Query="SELECT [PseudoNHSNumber]#(lf)      ,[Chronic_Condition_Count]#(lf)      ,[Active_Ingredient_Count]#(lf)      ,[Emergency_Admission_Risk] = [Probability_IP_Hosp]#(lf)      ,[High_User_Risk] = [Probability_Persistent_High_User]#(lf)      ,[High_Pharmacy_Risk] = [Probability_Unexpected_Pharmacy_Cost]#(lf)      ,[Long_Stay_Risk] = [Probability_Extended_Hosp]#(lf)#(lf)FROM [CCG_Current].[ACG].[vw_ACGResults]#(lf)#(lf)WHERE [IsLatest] = 1"])
				in
				    Source

	changedProperty = Name

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

