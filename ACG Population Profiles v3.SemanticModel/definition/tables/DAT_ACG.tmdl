table DAT_ACG
	lineageTag: a403c1eb-ab22-498c-b5e0-377bc455828c

	measure 'Median Chronic Condition Count' =
			
			
			MEDIAN(
			    'DAT_ACG'[Chronic_Condition_Count]
			)
		formatString: 0
		lineageTag: 8e39512a-70cf-4589-a858-c5b7b35cbfd4

	measure 'Median Prescribed Drug Count' =
			
			
			MEDIAN(
			    'DAT_ACG'[Active_Ingredient_Count]
			)
		formatString: 0
		lineageTag: e9c2f584-0278-4532-ae24-ad450f988ac4

		annotation PBI_FormatHint = {"isDecimal":true}

