				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db01_reference"), "select age as ""Age"", case when age between 0 and 17 then 'Paediatric (0-17)' when age between 18 and 64 then 'Adult (18-64)' when age >= 65 then 'Older Adult (65+)' else null end as ""Age_Grouping"" from ccg_reference.vw_ageband where age between 0 and 130", null, [EnableFolding=true])
