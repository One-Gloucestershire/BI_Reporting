table DAT_ADG
	lineageTag: 5c5df96e-2256-4704-b85f-a3cffb1084c3

	measure 'Top1 EDC' =
			
			VAR RankedTable =
			    ADDCOLUMNS(
			        VALUES(DAT_ADG[EDCDescription]),
			        "CounterValue", CALCULATE(SUM(DAT_ADG[Counter])),
			        "RankValue",
			            RANKX(
			                VALUES(DAT_ADG[EDCDescription]),
			                CALCULATE(SUM(DAT_ADG[Counter])),
			                ,
			                DESC,
			                DENSE
			            )
			    )
			
			VAR TopRow =
			    FILTER(RankedTable, [RankValue] = 1)
			
			RETURN
			IF(
			    NOT ISEMPTY(TopRow),
			    CONCATENATEX(
			        TopRow,
			        DAT_ADG[EDCDescription]
			            & " ("
			            & FORMAT([CounterValue], "#,##0")
			            & " | "
			            & FORMAT(DIVIDE([CounterValue], [Total Population]), "0%")
			            & ")"
			    )
			)
		lineageTag: ad2df54c-16e9-4753-9559-904504e0b3c0

