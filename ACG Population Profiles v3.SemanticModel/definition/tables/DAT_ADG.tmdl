	partition DAT_ADG = m
		mode: import
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "CCG_Current", [Query="#(lf)--drop table #maxmonth#(lf)select cast(max([Month]) as date)  as [MM] #(lf)into #MaxMonth#(lf)from ccg_current.acg.[vw_EDCCodes]#(lf)#(lf)--SELECT MAX([month])#(lf)--from  ccg_current.acg.vw_ACGResults#(lf)#(lf)select *#(lf)from (#(lf)    select#(lf)        sum(1) as [Counter],#(lf)        EDCDescription,#(lf)        Patient_Need_Group,#(lf)#(tab)#(tab)case #(lf)#(tab)#(tab)#(tab)when cast([sum].[DerivedAge] as int) between 0 and 17 then 'Paediatric (0-17)'#(lf)#(tab)#(tab)#(tab)when cast([sum].[DerivedAge] as int) between 18 and 64 then 'Adult (18-64)'#(lf)#(tab)#(tab)#(tab)when cast([sum].[DerivedAge] as int) >= 65 then 'Older Adult (65+)'#(lf)#(tab)#(tab)end as [Age Group],#(lf)        row_number() over (#(lf)            partition by Patient_Need_Group,#(lf)#(tab)#(tab)#(tab)case #(lf)#(tab)#(tab)#(tab)when cast([sum].[DerivedAge] as int) between 0 and 17 then 'Paediatric (0-17)'#(lf)#(tab)#(tab)#(tab)when cast([sum].[DerivedAge] as int) between 18 and 64 then 'Adult (18-64)'#(lf)#(tab)#(tab)#(tab)when cast([sum].[DerivedAge] as int) >= 65 then 'Older Adult (65+)'#(lf)#(tab)#(tab)end#(lf)            order by sum(1) desc#(lf)        ) as rn#(lf)    from ccg_current.acg.[vw_EDCCodes] [a]#(lf)    left join ccg_current.acg.vw_ACGResults [b] #(lf)        on [a].PseudoNHSNumber = [b].PseudoNHSNumber #(lf)        and cast([a].[Month] as date) = cast([b].[Month] as date)#(lf)    left join ICB_Products.Patient.vw_Summary [sum] #(lf)        on [a].PseudoNHSNumber = [sum].PseudoNHSNumber #(lf)    left join #MaxMonth [c] #(lf)        on 1 = 1#(lf)    where cast([a].[Month] as date) = [c].MM#(lf)#(tab)and #(tab)EDCDescription NOT IN ('Medical counseling/advice','Administrative concerns and non-specific laboratory abnormalities')#(lf)    group by #(lf)        EDCDescription, #(lf)        Patient_Need_Group,#(lf)#(tab)#(tab)case #(lf)#(tab)#(tab)#(tab)when cast([sum].[DerivedAge] as int) between 0 and 17 then 'Paediatric (0-17)'#(lf)#(tab)#(tab)#(tab)when cast([sum].[DerivedAge] as int) between 18 and 64 then 'Adult (18-64)'#(lf)#(tab)#(tab)#(tab)when cast([sum].[DerivedAge] as int) >= 65 then 'Older Adult (65+)'#(lf)#(tab)#(tab)end#(lf)) t#(lf)where rn <= 5#(lf)order by Patient_Need_Group, [Counter] desc;"])
				in
				    Source

