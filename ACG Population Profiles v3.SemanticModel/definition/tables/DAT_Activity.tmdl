table DAT_Activity
	lineageTag: d8b20ec9-1968-49f6-973c-2b8e1dd76c44

	measure 'Activity per Person' = (calculate(sum('DAT_Activity'[Activity]))/[Total Population])
		lineageTag: ef0edd09-2265-428e-b858-af593085eeeb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column DerivedCost
		dataType: double
		lineageTag: 1315caff-576c-4fc7-9b89-6271a8d8c978
		summarizeBy: sum
		sourceColumn: DerivedCost

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Activity
		dataType: int64
		formatString: 0
		lineageTag: 22002491-ceb3-4eee-b239-7b697a1028df
		summarizeBy: sum
		sourceColumn: Activity

		annotation SummarizationSetBy = Automatic

	column ACGPatientNeedsGroup
		dataType: string
		lineageTag: 2ba18f72-1a54-4c3d-8dbd-5dc2e34773d0
		summarizeBy: none
		sourceColumn: ACGPatientNeedsGroup

		annotation SummarizationSetBy = Automatic

	column ActivityType
		dataType: string
		lineageTag: 0c111457-dcc7-4739-afe3-8d977cedd001
		summarizeBy: none
		sourceColumn: ActivityType

		annotation SummarizationSetBy = Automatic

	partition DAT_Activity = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "select sum(a.derivedactivitycost) as ""DerivedCost"", sum(a.counter) as ""Activity"", b.patient_need_group as ""ACGPatientNeedsGroup"", a.activitytype as ""ActivityType"" from data_mart_pls.vw_activity a left join (select pseudonhsnumber, patient_need_group from data_mart_acg.vw_acgresults_full where islatest=1) b on a.pseudonhsnumber=b.pseudonhsnumber group by b.patient_need_group, a.activitytype", null, [EnableFolding=true])
				in
				    Source

	changedProperty = Name

	annotation PBI_ResultType = Table

