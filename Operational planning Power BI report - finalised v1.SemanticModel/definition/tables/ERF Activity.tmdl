	partition 'ERF Activity-e47c47cf-9100-4486-a65e-46a1d788ffa2' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "powerbi_reporting", [Query="SELECT [Metric]#(lf)      ,[Provider]#(lf)      ,[Month name]#(lf)      ,[Type]#(lf)      ,[Activity]#(lf)  FROM [PowerBI_Reporting].[dbo].[ERF activity v2]"]),
				    #"Renamed Columns" = Table.RenameColumns(Source,{{"Type", "Time frame"}})
