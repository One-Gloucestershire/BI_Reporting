table 'ERF Activity'
	lineageTag: ce76a91f-b878-4e88-8590-563f7f861eae

	measure 'Recovery 19/20' = ```
			
			
			    (CALCULATE(
				SUM('ERF Activity'[Activity]),
				'ERF Activity'[Time frame] IN { "Actual flex 2023/24"})
			    
			    /
			CALCULATE(
				SUM('ERF Activity'[Activity]),
				'ERF Activity'[Time frame] IN { "Actual 2019/20" }))
			  
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9649b744-8041-4789-8a70-b38c9d4f17c1

	measure 'ERF Activity Metric Selected' = IF ( ISFILTERED ( 'ERF Activity'[Metric]) , CONCATENATEX(ALLSELECTED('ERF Activity'[Metric]), 'ERF Activity'[Metric], ", ") , "No specific metric selected" )
		lineageTag: be6f7410-71f7-4652-9b6d-ad582960eb9c

	measure 'ERF Activity Provider Selected' = IF ( ISFILTERED ( 'ERF Activity'[Provider]) , CONCATENATEX(ALLSELECTED('ERF Activity'[Provider]), 'ERF Activity'[Provider], ", ") , "No specific provider selected" )
		lineageTag: af4b43b4-2201-46ee-8262-f9e2d7eba149

	measure 'ERF Activity Time Frame Selected' = IF ( ISFILTERED ( 'ERF Activity'[Time frame]) , CONCATENATEX(ALLSELECTED('ERF Activity'[Time frame]), 'ERF Activity'[Time frame], ", ") , "No specific time frame selected" )
		lineageTag: 5faa750a-c849-45ae-9b1a-92d6f283e97d

	measure 'ERF 1 Recovery of 19/20' = if('ERF Activity'[Recovery 19/20] <>BLANK(), 'ERF Activity'[Recovery 19/20], "")
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 1bbeafdd-cf1f-4281-859a-ed02e681f29a

	measure 'ERF Activity Variance 23/24' = ```
			IFERROR((CALCULATE(sum('ERF Activity'[Activity]), 'ERF Activity'[Time frame] IN {"Plan"})
			- 
			CALCULATE(sum('ERF Activity'[Activity]), 'ERF Activity'[Time frame] IN {"Actual flex 2023/24"}))
			/ 
			CALCULATE(sum('ERF Activity'[Activity]), 'ERF Activity'[Time frame] IN {"Plan"}),"")
			```
		lineageTag: 939afae2-4b74-4756-9718-e97658f79cc4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ERF Activity 1 Variance 23/24' = if('ERF Activity'[ERF Activity Variance 23/24]<>1.0000, 'ERF Activity'[ERF Activity Variance 23/24], "")
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: fa1feb2d-4804-4a74-812c-c0e77b473a79

	measure 'Activity for % Target' =
			
			CALCULATE(
				SUM('ERF Activity'[Activity]),
				'ERF Activity'[Time frame] IN { "% Target" }
			)
		lineageTag: fbd4cbbe-7823-4ea2-993f-c648b90393ac

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ERF Activity % for Target' = FORMAT('ERF Activity'[Activity for % Target],"Percent")
		lineageTag: 47d5f670-1c35-4c4c-adb2-c5e31e058fd3

