table Prescribing
	lineageTag: 18501bf5-7f33-4cf7-b52c-f75a9f271a11

	measure 'Prescribing Rate per 1000 Yearly' =
			
			
			VAR Activity = CALCULATE ( SUM ('Prescribing'[counter] ))
			VAR POP = CALCULATE ( [Diagnosed Dementia 65+ Population] , ALLEXCEPT ('Date Reference', 'Date Reference'[financial_year] ), 'Date Reference'[month_name] IN {"Apr"} )
			
			RETURN IFERROR(Activity/POP*1000,BLANK())
		lineageTag: 84e0e49a-1d52-4f73-89ce-8a10b503c6e2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Prescribing Rate per 1000 Monthly' = ```
			
			
			VAR Activity = CALCULATE ( SUM ('Prescribing'[counter] ))
			VAR POP =  [Diagnosed Dementia 65+ Population] 
			
			RETURN IFERROR(Activity/POP*1000,BLANK())
			```
		lineageTag: eb6cc766-7768-4150-b531-67be3213e881

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Prescribing graph parameter y-value' = ```
			
			
			VAR prescribing_value = 
			    if(SELECTEDVALUE('Prescribing Filter'[Prescribing Filter]) = "Costs of Prescriptions", "Cost",
			    IF(SELECTEDVALUE('Prescribing Filter'[Prescribing Filter]) = "Number of Prescriptions", "Number",
			    "none"))
			
			VAR Activity = IF(prescribing_value = "Number", CALCULATE ( SUM ('Prescribing'[counter] )), CALCULATE(SUM('Prescribing'[Item_cost_in_pounds])))
			VAR POP_month = [Diagnosed Dementia 65+ Population] 
			VAR POP_year = CALCULATE ([Diagnosed Dementia 65+ Population] , ALLEXCEPT ('Date Reference', 'Date Reference'[financial_year] ), 'Date Reference'[month_name] IN {"Apr"} )
			
			
			VAR Year_or_month =
			    SELECTCOLUMNS (
			        SUMMARIZE ( 'Month or Yearly Parameter', 'Month or Yearly Parameter'[Month or Yearly], 'Month or Yearly Parameter'[Month or Yearly Fields] ),
			        'Month or Yearly Parameter'[Month or Yearly])
			
			VAR rate_or_actual =
			    SELECTCOLUMNS (
			        SUMMARIZE ( 'Rate or Actual Parameter', 'Rate or Actual Parameter'[Rate or Actual], 'Rate or Actual Parameter'[Parameter Fields] ),
			        'Rate or Actual Parameter'[Rate or Actual])
			
			
			
			RETURN if(Year_or_month = "monthly"
			        && rate_or_actual = "Rate per 1000"
			        && prescribing_value = "Number"
			        ,Activity/POP_month*1000, 
			
			        if(Year_or_month = "yearly" 
			        && rate_or_actual = "Rate per 1000"
			        && prescribing_value = "Number"
			        ,Activity/POP_year*1000,
			
			        if(Year_or_month = "monthly"
			        && rate_or_actual = "Actual Activity"
			        && prescribing_value = "Number"
			        ,Activity, 
			
			        if(Year_or_month = "yearly"
			        && rate_or_actual = "Actual Activity"
			        && prescribing_value = "Number"
			        ,Activity,
			
			        if(Year_or_month = "monthly"
			        && rate_or_actual = "Rate per 1000"
			        && prescribing_value = "Cost"
			        ,Activity/POP_month*1000, 
			
			        if(Year_or_month = "yearly" 
			        && rate_or_actual = "Rate per 1000"
			        && prescribing_value = "Cost"
			        ,Activity/POP_year*1000,
			
			        if(Year_or_month = "monthly"
			        && rate_or_actual = "Actual Activity"
			        && prescribing_value = "Cost"
			        ,Activity, 
			
			        if(Year_or_month = "yearly"
			        && rate_or_actual = "Actual Activity"
			        && prescribing_value = "Cost"
			        ,Activity
			        
			        ,BLANK()))))))))
			```
		lineageTag: 58ed2efd-036d-4c4c-a7ac-58860a82a133

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Prescribing graph title' = ```
			
			
			VAR activity = SELECTCOLUMNS (
			        SUMMARIZE ( 'Rate or Actual Parameter', 'Rate or Actual Parameter'[Rate or Actual], 'Rate or Actual Parameter'[Parameter Fields] ),
			        'Rate or Actual Parameter'[Rate or Actual]
			    )
			
			VAR timeframe = SELECTCOLUMNS (
			        SUMMARIZE ( 'Month or Yearly Parameter', 'Month or Yearly Parameter'[Month or Yearly], 'Month or Yearly Parameter'[Month or Yearly Fields] ),
			        'Month or Yearly Parameter'[Month or Yearly]
			    )
			
			VAR activity_type = "Anti-Psychotic Prescribing"
			
			VAR prescribing_value = 
			    IF(SELECTEDVALUE('Prescribing Filter'[Prescribing Filter]) = "Costs of Prescriptions", "Costs of Prescriptions (£)", 
			    IF(SELECTEDVALUE('Prescribing Filter'[Prescribing Filter]) = "Number of Prescriptions", "Number of Prescriptsions", BLANK()))
			
			//IF ( COUNTROWS ( activity ) = 1, CONCATENATE(activity & " - ", reason ))
			
			RETURN 
			IF ( activity = "Actual Activity" && timeframe = "Yearly" && prescribing_value <> BLANK(), CONCATENATE(activity_type & " - " & prescribing_value & " - ", activity & " - Yearly"  ),
			IF ( activity = "Actual Activity" && timeframe = "Monthly" && prescribing_value <> BLANK() , CONCATENATE(activity_type & " - " & prescribing_value & " - ", activity & " - Monthly"  ),
			IF ( activity = "Rate per 1000" && timeframe = "Yearly" && prescribing_value <> BLANK(), CONCATENATE(activity_type & " - " & prescribing_value & " - ", activity & " - Yearly" ),
			IF ( activity = "Rate per 1000" && timeframe  = "Monthly" && prescribing_value <> BLANK(), CONCATENATE(activity_type & " - " & prescribing_value & " - ", activity & " - Monthly" ), "Please select slicers from the left to show data"))))
			
			```
		lineageTag: 91d6a041-8807-49c1-93d0-1af497ff4d3f

	measure 'Prescribing graph cost y-value' = ```
			
			
			VAR Activity = CALCULATE ( SUM ('Prescribing'[Item_cost_in_pounds] ))
			VAR POP_month = [Diagnosed Dementia 65+ Population] 
			VAR POP_year = CALCULATE ([Diagnosed Dementia 65+ Population] , ALLEXCEPT ('Date Reference', 'Date Reference'[financial_year] ), 'Date Reference'[month_name] IN {"Apr"} )
			
			
			VAR Year_or_month =
			    SELECTCOLUMNS (
			        SUMMARIZE ( 'Month or Yearly Parameter', 'Month or Yearly Parameter'[Month or Yearly], 'Month or Yearly Parameter'[Month or Yearly Fields] ),
			        'Month or Yearly Parameter'[Month or Yearly])
			
			VAR rate_or_actual =
			    SELECTCOLUMNS (
			        SUMMARIZE ( 'Rate or Actual Parameter', 'Rate or Actual Parameter'[Rate or Actual], 'Rate or Actual Parameter'[Parameter Fields] ),
			        'Rate or Actual Parameter'[Rate or Actual])
			
			
			RETURN if(Year_or_month = "monthly"
			        && rate_or_actual = "Rate per 1000"
			        ,Activity/POP_month*1000, 
			
			        if(Year_or_month = "yearly" 
			        && rate_or_actual = "Rate per 1000",
			        Activity/POP_year*1000,
			
			        if(Year_or_month = "monthly"
			        && rate_or_actual = "Actual Activity"
			        ,Activity, 
			
			        if(Year_or_month = "yearly"
			        && rate_or_actual = "Actual Activity"
			        ,Activity
			        
			        ,1000))))
			```
		lineageTag: c11ef510-daa4-4f2a-839d-3413f928c1c6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Prescribing y axis title' = ```
			
			
			VAR activity = SELECTCOLUMNS (
			        SUMMARIZE ( 'Rate or Actual Parameter', 'Rate or Actual Parameter'[Rate or Actual], 'Rate or Actual Parameter'[Parameter Fields] ),
			        'Rate or Actual Parameter'[Rate or Actual]
			    )
			
			VAR timeframe = SELECTCOLUMNS (
			        SUMMARIZE ( 'Month or Yearly Parameter', 'Month or Yearly Parameter'[Month or Yearly], 'Month or Yearly Parameter'[Month or Yearly Fields] ),
			        'Month or Yearly Parameter'[Month or Yearly]
			    )
			
			VAR activity_type = "Anti-Psychotic Prescribing"
			
			VAR prescribing_value = 
			    IF(SELECTEDVALUE('Prescribing Filter'[Prescribing Filter]) = "Costs of Prescriptions", "Cost (£)", 
			    IF(SELECTEDVALUE('Prescribing Filter'[Prescribing Filter]) = "Number of Prescriptions", "Number of Prescriptsions", BLANK()))
			
			//IF ( COUNTROWS ( activity ) = 1, CONCATENATE(activity & " - ", reason ))
			
			RETURN 
			IF ( activity = "Actual Activity" && timeframe = "Yearly" && prescribing_value <> BLANK(), "Actual " & prescribing_value,
			IF ( activity = "Actual Activity" && timeframe = "Monthly" && prescribing_value <> BLANK() , "Actual " & prescribing_value,
			IF ( activity = "Rate per 1000" && timeframe = "Yearly" && prescribing_value <> BLANK(), "Rate per 1000 " & prescribing_value,
			IF ( activity = "Rate per 1000" && timeframe  = "Monthly" && prescribing_value <> BLANK(), "Rate per 1000 " & prescribing_value, BLANK()))))
			
			```
		lineageTag: 8d6173e9-1de8-4a7e-8a45-d478926fa2c7

