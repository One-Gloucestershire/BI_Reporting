	measure 'Area Selected' = IF ( ISFILTERED ( 'List of Areas'[Amended_Name]) , CONCATENATEX(ALLSELECTED('List of Areas'[Amended_Name]), 'List of Areas'[Amended_Name], ", ") , "Whole section of area or no area selected" )
