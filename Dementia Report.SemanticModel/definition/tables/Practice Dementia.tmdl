	column prior_month = if('Practice Dementia'[practice_dementia_year_month] = max('Practice Dementia'[month_prior_YearMonth]), 1, 0)
		formatString: 0
		lineageTag: 09296c30-d214-4fe4-bba8-c2970b00057d
