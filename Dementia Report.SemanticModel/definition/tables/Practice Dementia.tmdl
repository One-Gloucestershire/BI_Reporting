	column table
		dataType: string
		lineageTag: 685e416d-96d5-4634-8ce7-7eb7581e8a1d
		summarizeBy: none
		sourceColumn: table

		annotation SummarizationSetBy = Automatic

	column 'Current month flag' = ```
			
			
			VAR Date_year_month = CONCATENATE(YEAR('Practice Dementia'[month_prior_ach_date]),MONTH('Practice Dementia'[month_prior_ach_date]))
			
			VAR current_year_month = CONCATENATE(YEAR(MAX('Practice Dementia'[month_prior_ach_date])),MONTH(MAX('Practice Dementia'[month_prior_ach_date])))
			
			VAR prior_year_month_calc = EOMONTH(max('Practice Dementia'[month_prior_ach_date]), -1)
			
			VAR prior_year_month = CONCATENATE(YEAR(prior_year_month_calc),MONTH(prior_year_month_calc))
			
			RETURN IF(Date_year_month = current_year_month, "Current Month", if(Date_year_month = prior_year_month, "Prior Month", "Other Month")) 
			```
		lineageTag: fd1ab835-710c-4b0f-9ebe-9e12af5eaf36
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Practice Dementia YTD' =
			
			VAR current_month = MONTH('Practice Dementia'[ACH_DATE])
			VAR f_current_month = SWITCH(TRUE(),
			current_month = 4, 1,
			current_month = 5, 2,
			current_month = 6, 3,
			current_month = 7, 4,
			current_month = 8, 5,
			current_month = 9, 6,
			current_month = 10, 7,
			current_month = 11, 8,
			current_month = 12, 9,
			current_month = 1, 10,
			current_month = 2, 11,
			current_month = 3, 12
			)
			VAR max_month = MONTH(MAX('Practice Dementia'[ACH_DATE]))
			VAR f_max_month = SWITCH(TRUE(),
			max_month = 4, 1,
			max_month = 5, 2,
			max_month = 6, 3,
			max_month = 7, 4,
			max_month = 8, 5,
			max_month = 9, 6,
			max_month = 10, 7,
			max_month = 11, 8,
			max_month = 12, 9,
			max_month = 1, 10,
			max_month = 2, 11,
			max_month = 3, 12
			)
			return if(f_current_month <= f_max_month, "Year to Date", "Not Year to Date")
		lineageTag: 4025e760-b7cc-4d95-988b-55a336c4ec9c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

