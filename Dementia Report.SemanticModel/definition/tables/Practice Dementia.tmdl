table 'Practice Dementia'
	lineageTag: a3958b1e-3f54-43d6-a8b6-4baa086fd2e3

	measure 'Diagnosed Dementia 65+ Population' = CALCULATE(sum('Practice Dementia'[Value]),'Practice Dementia'[Measure] = "DEMENTIA_REGISTER_65_PLUS")
		lineageTag: 83b35987-0ca2-47fb-addd-0c8fbd5039cd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'DDR %' = IFERROR('Practice Dementia'[Diagnosed Dementia 65+ Population] / CALCULATE(sum('Practice Population'[Estimated Total Dementia Population])) * 100, BLANK())
		formatString: 0.0
		lineageTag: 84458497-67ec-4b8f-bb01-5e851bf8aef4

	measure 'Measure max date' = CALCULATE(MAX('Practice Dementia'[ach_date]))
		formatString: General Date
		lineageTag: 6a2f09b2-0928-45c7-a4b8-f4250d4bda71

	measure 'Gloucestershire Local DDR' = IFERROR(CALCULATE('Practice Dementia'[Diagnosed Dementia 65+ Population], 'Practice Dementia'[ICB_ODS_CODE] = "QR1") / CALCULATE(sum('Practice Population'[Estimated Total Dementia Population])), BLANK())
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 1a5cd952-22e9-411f-a707-1e938388dfcf

	measure 'National Diagnosis needed' = CALCULATE(sum('Practice Population'[Required Number of Diagnosed Dementia Patients for DDR]) - [Gloucestershire Dementia 65+ Population] )
		formatString: 0
		lineageTag: 90b2e9f4-762a-4298-ba2a-f8a20da6e685

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Gloucestershire Dementia 65+ Population' = CALCULATE(sum('Practice Dementia'[Value]),'Practice Dementia'[Measure] = "DEMENTIA_REGISTER_65_PLUS", 'Practice Dementia'[ICB_ODS_CODE] = "QR1")
		lineageTag: ece4fe0b-956b-4102-9add-628d86270053

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Latest month local DDR' = CALCULATE('Practice Dementia'[Gloucestershire Local DDR], 'Date Reference'[Local data latest month flag] = 1)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 26045e7a-ae05-43a7-92fe-55e846306535

	measure 'Prior month local DDR' = CALCULATE('Practice Dementia'[Gloucestershire Local DDR], 'Date Reference'[Local data prior month flag] = 1)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 8288ce48-9fd4-4883-8e12-faf5ee039bd7

	measure 'DDR change from last month' = [Latest month local DDR] - [Prior month local DDR]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f338f276-45a4-408f-a525-a9e66e24968b

	measure 'Comparison arrow' = if([DDR change from last month] > 0, UNICHAR(9650), if([DDR change from last month] < 0, UNICHAR(9660)))
		lineageTag: 9722b6db-7e97-4ad8-998f-e0857dc17d06

	measure 'Area chart Y-axis start' = ```
			CALCULATE(sum('Practice Dementia'[Value])/1.5,'Practice Dementia'[Measure] = "DEMENTIA_REGISTER_65_PLUS", 'Practice Dementia'[ICB_ODS_CODE] = "QR1") 
			```
		lineageTag: 2e45f047-6172-494a-9e0a-c479926dda16

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'National Data Current Gloucestershire Dementia 65+ Population' = CALCULATE(sum('Practice Dementia'[Value]),'Practice Dementia'[Measure] = "DEMENTIA_REGISTER_65_PLUS", 'Practice Dementia'[ICB_ODS_CODE] = "QR1", 'Date Reference'[Local data latest month flag] = 1)
		lineageTag: f508156a-1f8e-4a47-8af4-e70864565c9a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'National Diagnosis needed current month' = CALCULATE([National Diagnosis needed], 'Date Reference'[Local data latest month flag] = 1)
		lineageTag: 481140c2-42ee-42da-9d1f-283abce4769c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Gloucestershire Diagnosed Population' = CALCULATE(AVERAGEX(VALUES('Date Reference'[year_month]),[Gloucestershire Dementia 65+ Population]))
		lineageTag: 56056cdc-a806-4ebe-b365-7e263b8071a8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

