		variation Variation
			isDefault
			relationship: 1e60f016-ed9f-439d-bfb4-409b97101118
			defaultHierarchy: LocalDateTable_ba592526-9aba-4d37-9229-66f30d0fa1a8.'Date Hierarchy'

