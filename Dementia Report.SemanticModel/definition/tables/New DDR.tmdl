		lineageTag: c5b8d6c1-1182-4538-9e13-388bf0e586ab
		summarizeBy: sum
		sourceColumn: Estimated Total Dementia Population

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

