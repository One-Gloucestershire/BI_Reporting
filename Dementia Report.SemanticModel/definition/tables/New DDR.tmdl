		lineageTag: e04f047b-3404-4f04-bef0-17afce2c21c3
		summarizeBy: sum
		sourceColumn: Diagnosed Dementia Population

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Name
		dataType: string
		lineageTag: 779e8bde-7084-4704-aff8-9f7dab235a18
		summarizeBy: none
		sourceColumn: Name

		annotation SummarizationSetBy = Automatic

	column ACH_DATE
		dataType: dateTime
		formatString: General Date
		lineageTag: fd59514c-8f02-4b14-bb36-9f8b80569cd5
		summarizeBy: none
		sourceColumn: ACH_DATE

		annotation SummarizationSetBy = Automatic

	column area
		dataType: string
		lineageTag: da93137d-e0fc-4b73-bb2d-f9c3a32507ca
		summarizeBy: none
		sourceColumn: area

		annotation SummarizationSetBy = Automatic

	column 'Target Dementia Population' = 'New DDR'[Estimated Total Dementia Population] * 0.667
		lineageTag: 5c5d82f7-bf73-4079-9126-fcf3ab267808
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Current month flag' =
			
			VAR year_month = CONCATENATE(YEAR(MAX('New DDR'[ACH_DATE])),MONTH(MAX('New DDR'[ACH_DATE])))
			var Date_year_month = CONCATENATE(YEAR('New DDR'[ACH_DATE]),MONTH('New DDR'[ACH_DATE]))
			var prior_month = EOMONTH(max('New DDR'[ACH_DATE]), -1)
			var date_prior_month = CONCATENATE(YEAR(prior_month),MONTH(prior_month))
			RETURN IF(year_month = Date_year_month,"Current Month",if(date_prior_month= Date_year_month, "Prior Month", "Other Month"))
		lineageTag: 3781aed1-5b6d-4dda-886a-be9c39a5c4e6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Diagnosis Required' = 'New DDR'[Target Dementia Population] - 'New DDR'[Diagnosed Dementia Population]
		formatString: 0
		lineageTag: 6ee94cba-b538-4ab5-bdcc-8f9f25b46579
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDecimal":true}

	column 'DDR Target Flag' = IF('New DDR'[ddr] >= 0.667, 1, 0)
		formatString: 0
		lineageTag: a1064942-a967-4f8c-b7b1-829595e7532e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'DDR Target Descriptor' = IF('New DDR'[ddr] >= 0.667, "Achieving Target", "Below Target")
		lineageTag: 9fe9837a-6471-44d9-a32f-6ef48f9340ed
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'DDR Current Target Descriptor' = IF('New DDR'[DDR Target Descriptor] = "Achieving Target" && 'New DDR'[Current month flag] = "Current Month", "Currently Achieving Target", "Currently Below Target")
		lineageTag: 4e3695c5-ccd1-4e00-ac6c-7bc93b317576
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Areas currently meeting DDR target' = ```
			
			VAR CurrentPCN = [Name]  -- Get the current PCN
			VAR CheckFlag = 
			    CALCULATE(
			        MAX([Month flag]),   -- Look for the maximum value of month flag (1 if present, 0 otherwise)
			        FILTER(
			            ALL('New DDR'),    -- Replace 'Table' with your actual table name
			            'New DDR'[Name] = CurrentPCN && 
			            'New DDR'[month flag] = 1 && 
			            'New DDR'[DDR Target Flag] = 1  -- Check if both flags are 1 for this PCN
			        )
			    )
			RETURN IF(CheckFlag = 1, "Achieving Target", "Below Target")  -- Return 1 if conditions are met, 0 otherwise
			```
		lineageTag: 2973b840-8d01-49d2-b946-e8754f364eed
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Month flag' = IF('New DDR'[Current month flag] = "Current Month", 1, 0)
		formatString: 0
		lineageTag: 027ffb60-032c-47c2-84fd-7c7e4e0d8a6f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

