table 'New DDR'
	lineageTag: d68381c1-4964-4d03-b40f-a6c93f7c2f0f

	measure 'Gloucestershire ICB DDR' = ```
			CALCULATE(SUM('New DDR'[ddr]),'New DDR'[Name] = "NHS GLOUCESTERSHIRE INTEGRATED CARE BOARD",REMOVEFILTERS('List of Areas'))
			
			
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: b8ed50a3-381a-41cc-8dcc-3602a21ad80b

	measure 'Dash Line' = REPT("|"&UNICHAR(10),40)
		lineageTag: ce1f70c3-c691-476e-bbf1-cb15c75407c8

	measure 'Latest month local new DDR' = CALCULATE(SUM('New DDR'[ddr]), 'New DDR'[Current month flag] = "Current Month")
		formatString: 0.00
		lineageTag: 6cb62f17-4017-4b41-abb3-be147f0d6dac

	measure 'Prior month local new DDR' = CALCULATE(SUM('New DDR'[ddr]), 'New DDR'[Current month flag] = "Prior Month")
		lineageTag: 19de0715-6bf4-4819-94bc-15947fc25059

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'New DDR change from last month' = [Latest month local new DDR] - [Prior month local new DDR]
		formatString: 0.0000
		lineageTag: df370450-fd64-43b4-96a9-2234c8d91e05

	measure 'New Comparison arrow' = if([New DDR change from last month] > 0.00000, UNICHAR(9650), if([New DDR change from last month] < 0.00000, UNICHAR(9660), UNICHAR(61)))
		lineageTag: f18c7757-3f68-4a9e-80e7-e482dbf87d7a

	measure 'Current estimated dementia patients in Gloucestershire' = CALCULATE(SUM('New DDR'[Estimated Total Dementia Population]),'New DDR'[Name] = "NHS GLOUCESTERSHIRE INTEGRATED CARE BOARD", 'New DDR'[Current month flag] = "Current Month")
		formatString: 0
		lineageTag: f9ce5484-c0a3-4dee-9c35-4c836bb132b1

		annotation PBI_FormatHint = {"isDecimal":true}

	measure '% away from DDR target' = 0.667 - [DDR current month]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8afe0310-7f34-4c45-b453-c1e35dac1432

	measure 'DDR current month' = CALCULATE([Calculated DDR], 'New DDR'[Current month flag] = "Current Month")
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ed4cb452-7442-4ba9-9951-8f02bb00fe6d

	measure 'Calculated DDR' = ```
			CALCULATE(SUM('New DDR'[Diagnosed Dementia Population]),'New DDR'[Current month flag] = "Current Month") / CALCULATE(SUM('New DDR'[Estimated Total Dementia Population]),'New DDR'[Current month flag] = "Current Month") 
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 97642b05-85aa-4a9e-8b7f-cb353bf66d2c

	measure 'Latest national Gloucestershire DDR' = ```
			CALCULATE(SUM('New DDR'[ddr]),'New DDR'[Name] = "NHS GLOUCESTERSHIRE INTEGRATED CARE BOARD",'New DDR'[Current month flag] = "Current Month",REMOVEFILTERS('List of Areas'))
			
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 97e2a6db-669b-4525-bbe7-744e0cb3a249

	column ddr
		dataType: double
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: d668b8c4-3bcc-434f-8df2-65c0f87ed1b6
		summarizeBy: sum
		sourceColumn: ddr

		annotation SummarizationSetBy = Automatic

