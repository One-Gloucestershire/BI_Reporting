table 'New Waiting List Table'
	lineageTag: 7b705096-ab33-496d-9432-e2a82c50d5c2

	measure 'MAS Waiting List Per Month' = ```
			
			 
			VAR CurrentDate = max('Date Reference'[date])
			
			
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT('New Waiting List Table'[UniqServReqID]),
			        'New Waiting List Table'[ReferralRequestReceivedDate] <= CurrentDate
			        && 
			        //'New Waiting List Table'[End Date] > CurrentDate )
			        'New Waiting List Table'[New End Date] > CurrentDate )
			    
			```
		lineageTag: edc38179-f034-4420-9f2d-3c291b4598fa

	measure 'Monthly Average Waiting Time' =
			
			VAR MaxMonthDate = MAX('Date Reference'[date])
			RETURN
			    CALCULATE(
			        AVERAGEX(
			            'New Waiting List Table',
			            DATEDIFF(
			                'New Waiting List Table'[ReferralRequestReceivedDate],
			                MaxMonthDate,
			                WEEK
			            )
			        ),
			        -- Removes all filters from the Date Reference table, allowing you to manually apply a new filter.
			        ALL('Date Reference'),
			        -- The visual's filter context is now gone. We must manually filter the waiting list table.
			        -- This correctly includes all referrals up to the snapshot date.
			        FILTER(
			            'New Waiting List Table',
			            'New Waiting List Table'[ReferralRequestReceivedDate] <= MaxMonthDate &&
			            'New Waiting List Table'[New End Date] > MaxMonthDate
			        )
			    )
		lineageTag: d50cc5ef-1f09-418a-a581-3a1a4cec00b2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Average Waiting Time' = ```
			
			
			
			VAR MaxMonthDate =
			    MAX ( 'Date Reference'[date] )
			RETURN
			CALCULATE (
			    AVERAGE ( 'New Waiting List Table'[Total Waiting Time]  ), 'New Waiting List Table'[ReferralRequestReceivedDate] <= MaxMonthDate
			        && 
			        'New Waiting List Table'[New End Date] > MaxMonthDate  ,
			    USERELATIONSHIP (
			        'New Waiting List Table'[ReferralRequestReceivedDate],
			        'Date Reference'[date]
			    ),
			    FILTER (
			        ALL ( 'Date Reference' ),
			        'Date Reference'[date] <= MaxMonthDate
			    )
			)
			```
		lineageTag: f7509010-0464-4acc-aefb-2cbe7df458d7

	measure 'Average Length of Stay' = CALCULATE(MEDIAN('New Waiting List Table'[Length of Stay (excluding current non-discharged patients)]),USERELATIONSHIP('New Waiting List Table'[Actual Discharge Date],'Date Reference'[date]))
		lineageTag: 587a2fa4-b1f1-4c9b-ba6e-90a7bad6056a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Time to First Contact' = CALCULATE(AVERAGE([Time to Care Contact]),USERELATIONSHIP('New Waiting List Table'[CareContDate],'Date Reference'[date]))
		lineageTag: 8e9c0d25-e52f-475d-83e8-323d9db91333

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Monthly Median Waiting Time' =
			
			VAR MaxMonthDate = MAX('Date Reference'[date])
			RETURN
			    CALCULATE(
			        MEDIANX(
			            'New Waiting List Table',
			            DATEDIFF(
			                'New Waiting List Table'[ReferralRequestReceivedDate],
			                MaxMonthDate,
			                WEEK
			            )
			        ),
			        -- Removes all filters from the Date Reference table, allowing you to manually apply a new filter.
			        ALL('Date Reference'),
			        -- The visual's filter context is now gone. We must manually filter the waiting list table.
			        -- This correctly includes all referrals up to the snapshot date.
			        FILTER(
			            'New Waiting List Table',
			            'New Waiting List Table'[ReferralRequestReceivedDate] <= MaxMonthDate &&
			            'New Waiting List Table'[New End Date] > MaxMonthDate
			        )
			    )
		lineageTag: b261f0f6-34c9-498b-911f-f61682b87eae

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ends Per Month' = ```
			
			 
			VAR Max_Month_Date = max('Date Reference'[date])
			VAR Min_Month_Date = min('Date Reference'[date])
			
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT('New Waiting List Table'[UniqServReqID]),
			        'New Waiting List Table'[New End Date] <= Max_Month_Date
			        && 
			        'New Waiting List Table'[New End Date] >= Min_Month_Date)
			     
			    
			```
		formatString: 0
		lineageTag: 0ea65232-4564-41da-848f-28b9fa91563e

	measure 'Time between referral and end date' = ```
			
			 
			VAR Max_Month_Date = max('Date Reference'[date])
			VAR Min_Month_Date = min('Date Reference'[date])
			
			
			RETURN
			    CALCULATE(
			                AVERAGE('New Waiting List Table'[Time to End Date]),
			        'New Waiting List Table'[New End Date] <= Max_Month_Date
			        && 
			        'New Waiting List Table'[New End Date] >= Min_Month_Date)
			     
			    
			```
		lineageTag: f7d8efe5-1c02-4f7e-aa16-a6c8492d4950

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Referrals per month' = ```
			
			 
			    CALCULATE(DISTINCTCOUNT('New Waiting List Table'[UniqServReqID]),
			    USERELATIONSHIP('New Waiting List Table'[ReferralRequestReceivedDate],'Date Reference'[date]))
			
			```
		formatString: 0
		lineageTag: 0c337aa5-ccb9-46d9-9c43-7a2584c014ad

	measure 'First Care Contacts per month' = ```
			
			 
			    CALCULATE(DISTINCTCOUNT('New Waiting List Table'[UniqServReqID]),
			    USERELATIONSHIP('New Waiting List Table'[CareContDate],'Date Reference'[date]))
			
			```
		formatString: 0
		lineageTag: 3d1c158c-ef01-4fc2-a77f-aac81bd292a6

	measure 'Service Discharges per month' = ```
			
			 
			    CALCULATE(DISTINCTCOUNT('New Waiting List Table'[UniqServReqID]),
			    USERELATIONSHIP('New Waiting List Table'[ServDischDate],'Date Reference'[date]))
			
			```
		formatString: 0
		lineageTag: a8e39b43-7bf9-41b3-99ef-7174bbd6b9ac

	measure 'Removals per month' = ```
			
			 
			    CALCULATE(DISTINCTCOUNT('New Waiting List Table'[UniqServReqID]),
			    USERELATIONSHIP('New Waiting List Table'[pds_removal_date],'Date Reference'[date]))
			
			```
		lineageTag: 4bd2f00d-d7e2-4c41-937e-3ddded0fdf1b

	measure 'Waiting List' = ```
			
			 
			VAR CurrentDate = 
			MAX('Date Reference'[date])
			
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT('New Waiting List Table'[UniqServReqID]),
			        'New Waiting List Table'[ReferralRequestReceivedDate] <= CurrentDate
			        && 
			        'New Waiting List Table'[New End Date] > CurrentDate )
			    
			```
		formatString: 0
		lineageTag: 6eca67e6-c4ec-4024-9ff3-25937a64249d

	measure 'Waiting List Proportion' = ```
			
			 
			VAR CurrentDate = 
			MAX('Date Reference'[date])
			
			VAR total_wl =     CALCULATE(
			        DISTINCTCOUNT('New Waiting List Table'[UniqServReqID]),
			        'New Waiting List Table'[ReferralRequestReceivedDate] <= CurrentDate
			        && 
			        'New Waiting List Table'[New End Date] > CurrentDate
			         ,ALL('New Waiting List Table'[Referral Date Yearmonth]))
			
			
			VAR wl_per_yearmonth =
			    CALCULATE(
			        DISTINCTCOUNT('New Waiting List Table'[UniqServReqID]),
			        'New Waiting List Table'[ReferralRequestReceivedDate] <= CurrentDate
			        && 
			        'New Waiting List Table'[New End Date] > CurrentDate )
			
			RETURN wl_per_yearmonth / total_wl
			    
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f4f1516a-5876-4ac7-a096-03cfa6ac7917

