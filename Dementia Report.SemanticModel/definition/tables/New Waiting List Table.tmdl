	column 'New End Date' = ```
			
			
			VAR end_date =  MAX('Date Reference'[date])
			
			
			
			RETURN
			SWITCH(TRUE(),
			[CareContDate] <> BLANK(), [CareContDate]
			,[ServDischDate] <> BLANK(), [ServDischDate]
			,[pds_removal_date] <> BLANK(), [pds_removal_date]
			,end_date
