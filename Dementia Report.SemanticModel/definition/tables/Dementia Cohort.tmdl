table 'Dementia Cohort'
	lineageTag: a77aa5cf-cb89-4c77-b663-9c5aaa59bc30

	measure 'All patients with recorded place of death' = ```
			CALCULATE ( COUNT ( 'Dementia Cohort'[pseudo_nhs_number] ) , 'Dementia Cohort'[preferred_place_of_death] IN { "Did not die in preferred place" , "Died in preferred place" }, USERELATIONSHIP('Dementia Cohort'[death_date],'Date Reference'[date]))
			
			```
		formatString: 0%;-0%;0%
		lineageTag: 2502177a-b9bd-4f01-90c7-b3efa8545bc8

	measure 'Patients who died in preferred place of death' = ```
			CALCULATE ( COUNT ( 'Dementia Cohort'[preferred_place_of_death] ) , 'Dementia Cohort'[preferred_place_of_death] IN { "Died in preferred place" }, USERELATIONSHIP('Dementia Cohort'[death_date],'Date Reference'[date]))
			
			```
		formatString: 0
		lineageTag: 10d34159-a110-4ee2-a031-4ad82b55aef8

	measure '% Died in preferred place' = CALCULATE([Patients who died in preferred place of death] / [All patients with recorded place of death], USERELATIONSHIP('Dementia Cohort'[death_date],'Date Reference'[date]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ea853652-bdea-4f6e-a9a4-20782110e5b7

	measure '% Did not die in preferred place' = 1 - CALCULATE([% Died in preferred place], USERELATIONSHIP('Dementia Cohort'[death_date],'Date Reference'[date]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a7481af4-fc46-4326-97e7-9311e00c4cae

	measure '% with a Respect Form' = CALCULATE(COUNT('Dementia Cohort'[pseudo_nhs_number]),'Dementia Cohort'[Has_respect_form_flag] = 1)/count('Dementia Cohort'[pseudo_nhs_number])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e2c828af-290a-43bf-a88b-7e7d6ff620ea

	measure 'Local Current Dementia Patients' = CALCULATE(COUNT('Dementia Cohort'[pseudo_nhs_number]),'Dementia Cohort'[death_flag] <> "Dead")
		formatString: #,0
		lineageTag: 91b06e82-6c86-4d18-8a06-caeb6c2d3bf1

	measure 'Local latest DDR' = ```
			
			[Local Current Dementia Patients]
			/ 
			CALCULATE(sum('Practice Population'[Estimated Total Dementia Population]),'Date Reference'[Local data latest month flag] = 1)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: bb1e29c4-cb1b-4693-bea3-dda32dba6661

	measure 'Local Diagnosis needed' = CALCULATE(sum('Practice Population'[Required Number of Diagnosed Dementia Patients for DDR]),'Date Reference'[Local data latest month flag] = 1) - [Local Current Dementia Patients]
		lineageTag: 16d0068c-7892-465d-9c1f-012d5c108f6b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Female Dementia Cohort' = ```
			
			
			VAR female = CALCULATE(COUNT('Dementia Cohort'[pseudo_nhs_number]),'Dementia Cohort'[gender] = "Female",'Dementia Cohort'[death_flag] <> "Dead") 
			Var total = CALCULATE(COUNT('Dementia Cohort'[pseudo_nhs_number]),'Dementia Cohort'[death_flag] <> "Dead")
			
			RETURN female/total
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: f61a5bf4-5d26-407f-809c-d0160b917728

	measure 'Male Dementia Cohort' =
			
			
			VAR male = CALCULATE(COUNT('Dementia Cohort'[pseudo_nhs_number]),'Dementia Cohort'[gender] = "Male",'Dementia Cohort'[death_flag] <> "Dead")
			Var total = CALCULATE(COUNT('Dementia Cohort'[pseudo_nhs_number]),'Dementia Cohort'[death_flag] <> "Dead")
			
			RETURN male/total
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 749ba6a9-72d5-47a9-9ed0-56a159913b16

	measure 'Average PC Appointments' = CALCULATE(AVERAGE('Dementia Cohort'[PrimaryCareAppointments]),'Dementia Cohort'[death_flag] <> "Dead")
		lineageTag: aa8b6e5e-8a35-4392-836c-45f8f7b1a656

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Deaths in past 12 months' = CALCULATE(COUNT('Dementia Cohort'[pseudo_nhs_number]),'Dementia Cohort'[death_date] >= 'Dementia Cohort'[12 months prior from max death date])
		formatString: 0
		lineageTag: 38c8bf34-d291-40cd-bcf1-3fe301767109

	measure 'Emergency Admission %' = CALCULATE(COUNT('Dementia Cohort'[pseudo_nhs_number]),'Dementia Cohort'[death_flag] <> "Dead", 'Dementia Cohort'[EmergencyAdmissions] > 0) / [Local Current Dementia Patients]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 772a3a1f-dfca-4118-982c-da3dfa50c403

	measure 'Care Home %' = CALCULATE(COUNT('Dementia Cohort'[pseudo_nhs_number]),'Dementia Cohort'[death_flag] <> "Dead", 'Dementia Cohort'[Care_home_flag] = 1) / [Local Current Dementia Patients]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 04f26848-f0a4-4c7d-b566-ef220f88d261

	measure 'Emergency Attendance %' = CALCULATE(COUNT('Dementia Cohort'[pseudo_nhs_number]),'Dementia Cohort'[death_flag] <> "Dead", 'Dementia Cohort'[EDAttendances] > 0) / [Local Current Dementia Patients]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0794660b-db29-4e7f-b5b6-2757f5ce518e

	measure 'FALL A&E Attendance %' = CALCULATE(sum('Dementia Cohort'[number_of_falls_last_12_months]),'Dementia Cohort'[death_flag] <> "Dead") / CALCULATE(sum('Dementia Cohort'[EDAttendances]),'Dementia Cohort'[death_flag] <> "Dead")
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 66c81d5c-7ca8-4f42-877b-6cdc631f52eb

	measure 'Patients under 65 %' = IF(CALCULATE(COUNT('Dementia Cohort'[pseudo_nhs_number]),'Dementia Cohort'[death_flag] <> "Dead", 'Dementia Cohort'[age] < 65) / [Local Current Dementia Patients] = BLANK(),0,CALCULATE(COUNT('Dementia Cohort'[pseudo_nhs_number]),'Dementia Cohort'[death_flag] <> "Dead", 'Dementia Cohort'[age] < 65) / [Local Current Dementia Patients])
		formatString: 0%;-0%;0%
		lineageTag: b1c16506-876e-406d-9f33-d5efaeb59ff1

	measure 'Patients 65 and over %' = CALCULATE(COUNT('Dementia Cohort'[pseudo_nhs_number]),'Dementia Cohort'[death_flag] <> "Dead", 'Dementia Cohort'[age] >= 65) / [Local Current Dementia Patients]
		formatString: 0%;-0%;0%
		lineageTag: 97c9589f-ef86-47d0-a7f5-c0b2af674b81

	measure 'Patient average age' = CALCULATE(AVERAGE('Dementia Cohort'[age]), 'Dementia Cohort'[death_flag] <> "Dead")
		lineageTag: e115621c-9ee7-42d9-aa37-dfc7550e2082

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'White Patient %' = CALCULATE(COUNT('Dementia Cohort'[pseudo_nhs_number]),'Dementia Cohort'[death_flag] <> "Dead", 'Dementia Cohort'[ethnicity] = "White") / [Local Current Dementia Patients]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 1500f9bf-e447-4a7f-afbd-f40938c9687a

	measure 'Black Patient %' = CALCULATE(COUNT('Dementia Cohort'[pseudo_nhs_number]),'Dementia Cohort'[death_flag] <> "Dead", 'Dementia Cohort'[ethnicity] = "Black or Black British") / [Local Current Dementia Patients]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 71cb8aec-02f6-41d6-a171-5721d9f2c50b

	measure 'Asian Patient %' = CALCULATE(COUNT('Dementia Cohort'[pseudo_nhs_number]),'Dementia Cohort'[death_flag] <> "Dead", 'Dementia Cohort'[ethnicity] = "Asian or Asian British") / [Local Current Dementia Patients]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 00a093ad-5005-46b7-91a7-27dffaefabc8

	measure 'Mixed Ethnicity Patient %' = CALCULATE(COUNT('Dementia Cohort'[pseudo_nhs_number]),'Dementia Cohort'[death_flag] <> "Dead", 'Dementia Cohort'[ethnicity] = "Mixed") / [Local Current Dementia Patients]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: d0fbeb5b-5e81-4a88-8486-ec61a0765cb5

	measure 'Unknown Ethnicity Patient %' = CALCULATE(COUNT('Dementia Cohort'[pseudo_nhs_number]),'Dementia Cohort'[death_flag] <> "Dead", 'Dementia Cohort'[ethnicity] = BLANK()) / [Local Current Dementia Patients]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 66fc2ecc-f712-409d-b7df-09848656d4fb

	measure 'Other Ethnicity Patient %' = CALCULATE(COUNT('Dementia Cohort'[pseudo_nhs_number]),'Dementia Cohort'[death_flag] <> "Dead", 'Dementia Cohort'[ethnicity] = "Other Ethnic Groups") / [Local Current Dementia Patients]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 7f6edad7-d105-4648-bf9d-b33cd8cac9a7

	measure 'Current vs prior month preferred place of death' = ```
			
			
			VAR current_month   = CALCULATE([% Died in preferred place],'Month reference'[Month flag] = "Current Month")  
			VAR prior_month     = CALCULATE([% Died in preferred place],'Month reference'[Month flag] = "Prior Month")
			
			RETURN current_month - prior_month
			```
		lineageTag: e4c84b05-733b-47d5-9dc4-6013934451b7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Preferred place of death comparison arrow' = IF([Current vs prior month preferred place of death] > 0, UNICHAR(9650), UNICHAR(9660))
		lineageTag: 6b1e2e7b-c928-4408-8c29-8e39baa19a66

	measure 'Gloucestershire ICB % Died in preferred place' = CALCULATE([Patients who died in preferred place of death] / [All patients with recorded place of death], ALL('GP Reference'))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 82f0a84f-9847-404d-9cc9-4c1ac366bbd0

	measure 'Gloucestershire ICB % with a Respect Form' = CALCULATE(CALCULATE(COUNT('Dementia Cohort'[pseudo_nhs_number]),'Dementia Cohort'[Has_respect_form_flag] = 1)/count('Dementia Cohort'[pseudo_nhs_number]),ALL(('GP Reference')))
		lineageTag: 1ffc887f-2c68-4f03-9d68-4127e3781de1

