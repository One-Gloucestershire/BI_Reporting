	column 'Preferred Place of Death Current month flag' =
			
			VAR year_month = CONCATENATE(YEAR(MAX('Dementia Cohort'[death_date])),MONTH(MAX('Dementia Cohort'[death_date])))
			var Date_year_month = CONCATENATE(YEAR('Dementia Cohort'[death_date]),MONTH('Dementia Cohort'[death_date]))
			var prior_month = EOMONTH(max('Dementia Cohort'[death_date]), -1)
			var date_prior_month = CONCATENATE(YEAR(prior_month),MONTH(prior_month))
			RETURN IF(year_month = Date_year_month,"Current Month",if(date_prior_month= Date_year_month, "Prior Month", "Other Month"))
		lineageTag: 1a01e77b-8f77-4a61-b3b4-6a272f9e7ceb
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Death Date YTD' =
			
			VAR current_month = MONTH('Dementia Cohort'[death_date])
			VAR f_current_month = SWITCH(TRUE(),
			current_month = 4, 1,
			current_month = 5, 2,
			current_month = 6, 3,
			current_month = 7, 4,
			current_month = 8, 5,
			current_month = 9, 6,
			current_month = 10, 7,
			current_month = 11, 8,
			current_month = 12, 9,
			current_month = 1, 10,
			current_month = 2, 11,
			current_month = 3, 12
			)
			VAR max_month = MONTH(MAX('Dementia Cohort'[death_date]))
			VAR f_max_month = SWITCH(TRUE(),
			max_month = 4, 1,
			max_month = 5, 2,
			max_month = 6, 3,
			max_month = 7, 4,
			max_month = 8, 5,
			max_month = 9, 6,
			max_month = 10, 7,
			max_month = 11, 8,
			max_month = 12, 9,
			max_month = 1, 10,
			max_month = 2, 11,
			max_month = 3, 12
			)
			return if(f_current_month <= f_max_month, "Year to Date", "Not Year to Date")
		lineageTag: 07a973e2-0610-4cd0-8ad2-fc72db20c496
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Dementia Diagnosis Date YTD' =
			
			VAR current_month = MONTH('Dementia Cohort'[dementia_diagnosis_date])
			VAR f_current_month = SWITCH(TRUE(),
			current_month = 4, 1,
			current_month = 5, 2,
			current_month = 6, 3,
			current_month = 7, 4,
			current_month = 8, 5,
			current_month = 9, 6,
