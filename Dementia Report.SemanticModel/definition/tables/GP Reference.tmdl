	partition 'GP Reference' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db01_reference"), "with t as (select case when a.organisationcode='Y05212' then 'Tewkesbury Newent and Staunton' else a.locality end as ""Locality"", a.primarycarenetwork as ""PrimaryCareNetwork"", a.organisationcode as ""OrganisationCode"", a.organisationname as ""OrganisationName"", a.reportingorganisationcode as ""ReportingOrganisationCode"", a.reportingorganisationname as ""ReportingOrganisationName"", b.postcode as ""Postcode"" from icb_data_reference.vw_gppractice a left join icb_data_reference.vw_gppractice b on b.organisationcode=a.organisationcode where a.locality is not null) select t.""Locality"", t.""PrimaryCareNetwork"", t.""OrganisationCode"", t.""OrganisationName"", t.""ReportingOrganisationCode"", t.""ReportingOrganisationName"", t.""Postcode"", c.gplatitude as ""GPLatitude"", c.gplongitude as ""GPLongitude"", 'Localities' as ""Hierachy_slicer_top"" from t left join (select distinct gp_practice_code, gplatitude, gplongitude from db02_nopid.data_mart_powerbi_phm.tbl02_demographicsoverview) c on c.gp_practice_code=t.""ReportingOrganisationCode"" order by t.""OrganisationName""", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table

