		summarizeBy: sum
		sourceColumn: counter

		annotation SummarizationSetBy = Automatic

	partition Whiteboard = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "PowerBI_Reporting", [Query="select distinct#(lf)pseudo_nhs_number#(lf),PCSP_Completed_Flag#(lf),ReSPECT_Completed_Flag#(lf),w.Census_Date#(lf),[counter] = 1#(lf)#(lf)from PowerBI_Reporting.dementia.tbl01_Population d#(lf)#(lf)left join [PowerBI_Reporting].[AgeingWell].[tbl02_Proactive_Whiteboard_Registered_Population_Over_Time] w on w.Derived_NHS_Number = d.pseudo_nhs_number#(lf)and Census_Date >= d.dementia_diagnosis_date"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

