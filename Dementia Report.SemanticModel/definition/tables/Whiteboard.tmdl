table Whiteboard
	lineageTag: c1d0462b-39ed-42a7-afbc-7252d10b7360

	measure 'PCSP %' = CALCULATE(SUM('Whiteboard'[PCSP_Completed_Flag])) / CALCULATE(COUNT('Whiteboard'[pseudo_nhs_number]))
		lineageTag: d4142c49-d1d6-4149-bda7-00d35e8aab44

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Respect %' = CALCULATE(SUM('Whiteboard'[ReSPECT_Completed_Flag])) / CALCULATE(COUNT('Whiteboard'[pseudo_nhs_number]))
		lineageTag: f9407865-c0aa-490c-a8e4-24046861a0aa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

