table 'Anti-Psychotic Prescribing'
	lineageTag: b0ce9e75-4177-477a-8b22-5ad5fcaa745a

	measure '% of Gloucestershire with Prescription' =
			CALCULATE(sum('Anti-Psychotic Prescribing'[Total_Antipsychotic_Prescriptions]),'Anti-Psychotic Prescribing'[Area] = "Gloucestershire")
			/
			CALCULATE(SUM('Anti-Psychotic Prescribing'[Total_Dementia_Patients]),'Anti-Psychotic Prescribing'[Area] = "Gloucestershire")
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 6dc974b1-8369-4ce1-9443-022a3e6a3092

	measure '% of England with Prescription' =
			CALCULATE(sum('Anti-Psychotic Prescribing'[Total_Antipsychotic_Prescriptions]),'Anti-Psychotic Prescribing'[Area] = "England")
			/
			CALCULATE(SUM('Anti-Psychotic Prescribing'[Total_Dementia_Patients]),'Anti-Psychotic Prescribing'[Area] = "England")
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3be2abce-fcff-4349-88e1-54831352a5be

	measure 'Average % of Gloucestershire with prescription' = CALCULATE(AVERAGE('Anti-Psychotic Prescribing'[% with prescription]),'Anti-Psychotic Prescribing'[Area] = "Gloucestershire", ALLSELECTED('Date Reference'))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 77879ab5-9500-4923-83f3-9500a7c4e180

	measure 'Anti-psychotic comparison arrow' = IF([Current vs prior month anti-psychotic] > 0, UNICHAR(9650), UNICHAR(9660))
		lineageTag: 7683fddf-cb1d-40ae-b968-dbc786877218

	measure 'Current vs prior month anti-psychotic' = ```
			
			
			VAR current_month   = CALCULATE([% of Gloucestershire with Prescription],'Month reference'[Month flag] = "Current Month")  
			VAR prior_month     = CALCULATE([% of Gloucestershire with Prescription],'Month reference'[Month flag] = "Prior Month")
			
			RETURN current_month - prior_month
			```
		lineageTag: cbe2e570-afbb-4be5-8672-a1f1646bd5a3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

