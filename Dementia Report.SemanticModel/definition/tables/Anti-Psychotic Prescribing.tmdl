	column Area
		dataType: string
		lineageTag: 243f83ed-1aaa-42d1-abc7-2322c39b3143
		summarizeBy: none
		sourceColumn: Area

		annotation SummarizationSetBy = Automatic

	column '% with prescription' = 'Anti-Psychotic Prescribing'[Total_Antipsychotic_Prescriptions] / 'Anti-Psychotic Prescribing'[Total_Dementia_Patients]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e37d4e56-0ce5-4621-91d9-d688312eea9c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Current month flag' =
			
			VAR year_month = CONCATENATE(YEAR(MAX('Anti-Psychotic Prescribing'[Date])),MONTH(MAX('Anti-Psychotic Prescribing'[Date])))
			var Date_year_month = CONCATENATE(YEAR('Anti-Psychotic Prescribing'[Date]),MONTH('Anti-Psychotic Prescribing'[Date]))
			var prior_month = EOMONTH(max('Anti-Psychotic Prescribing'[Date]), -1)
			var date_prior_month = CONCATENATE(YEAR(prior_month),MONTH(prior_month))
			RETURN IF(year_month = Date_year_month,"Current Month",if(date_prior_month= Date_year_month, "Prior Month", "Other Month"))
		lineageTag: c2949b4f-393f-4bf7-9ca7-fe54dc04daf3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Anti-Psychotic YTD' =
			
			VAR current_month = MONTH('Anti-Psychotic Prescribing'[Date])
			VAR f_current_month = SWITCH(TRUE(),
			current_month = 4, 1,
			current_month = 5, 2,
			current_month = 6, 3,
			current_month = 7, 4,
			current_month = 8, 5,
			current_month = 9, 6,
			current_month = 10, 7,
			current_month = 11, 8,
			current_month = 12, 9,
			current_month = 1, 10,
			current_month = 2, 11,
			current_month = 3, 12
			)
			VAR max_month = MONTH(MAX('Anti-Psychotic Prescribing'[Date]))
			VAR f_max_month = SWITCH(TRUE(),
			max_month = 4, 1,
			max_month = 5, 2,
			max_month = 6, 3,
			max_month = 7, 4,
			max_month = 8, 5,
			max_month = 9, 6,
			max_month = 10, 7,
			max_month = 11, 8,
			max_month = 12, 9,
			max_month = 1, 10,
			max_month = 2, 11,
			max_month = 3, 12
			)
			return if(f_current_month <= f_max_month, "Year to Date", "Not Year to Date")
		lineageTag: 91a0a9ff-ebea-4ab6-954d-8a727a59ebe7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

