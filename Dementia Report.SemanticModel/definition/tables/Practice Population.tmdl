	column 'Estimated Total Dementia Population' =
			
			SWITCH(TRUE(),
			'Practice Population'[age_band] = "65-69" && 'Practice Population'[sex] = "Male", 'Practice Population'[population] * 0.012,
			'Practice Population'[age_band] = "70-74" && 'Practice Population'[sex] = "Male", 'Practice Population'[population] * 0.03,
			'Practice Population'[age_band] = "75-79" && 'Practice Population'[sex] = "Male", 'Practice Population'[population] * 0.052,
			'Practice Population'[age_band] = "80-84" && 'Practice Population'[sex] = "Male", 'Practice Population'[population] * 0.106,
			'Practice Population'[age_band] = "85-89" && 'Practice Population'[sex] = "Male", 'Practice Population'[population] * 0.128,
			'Practice Population'[age_band] = "90-94" && 'Practice Population'[sex] = "Male", 'Practice Population'[population] * 0.171,
			'Practice Population'[age_band] = "95+" && 'Practice Population'[sex] = "Male", 'Practice Population'[population] * 0.171,
			'Practice Population'[age_band] = "65-69" && 'Practice Population'[sex] = "Female", 'Practice Population'[population] * 0.018,
			'Practice Population'[age_band] = "70-74" && 'Practice Population'[sex] = "Female", 'Practice Population'[population] * 0.025,
			'Practice Population'[age_band] = "75-79" && 'Practice Population'[sex] = "Female", 'Practice Population'[population] * 0.062,
			'Practice Population'[age_band] = "80-84" && 'Practice Population'[sex] = "Female", 'Practice Population'[population] * 0.095,
			'Practice Population'[age_band] = "85-89" && 'Practice Population'[sex] = "Female", 'Practice Population'[population] * 0.181,
			'Practice Population'[age_band] = "90-94" && 'Practice Population'[sex] = "Female", 'Practice Population'[population] * 0.35,
			'Practice Population'[age_band] = "95+" && 'Practice Population'[sex] = "Female", 'Practice Population'[population] * 0.35,
			0)
		lineageTag: d8195a7f-c4e6-47c0-92a3-84c8ed235828
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column dementia_date_one_month_prior
		dataType: dateTime
		formatString: General Date
		lineageTag: 5ebbeab6-975b-4837-8c2b-a3290d5cd49b
		summarizeBy: none
		sourceColumn: dementia_date_one_month_prior

		annotation SummarizationSetBy = Automatic

	column 'Required Number of Diagnosed Dementia Patients for DDR' = 'Practice Population'[Estimated Total Dementia Population] * 0.667
		lineageTag: 16232f38-c8a9-46ad-a352-5c20611b0fb7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Current month flag' = ```
			
			
			VAR Date_year_month = CONCATENATE(YEAR('Practice Population'[dementia_date_one_month_prior]),MONTH('Practice Population'[dementia_date_one_month_prior]))
			
			VAR current_year_month = CONCATENATE(YEAR(MAX('Practice Population'[dementia_date_one_month_prior])),MONTH(MAX('Practice Population'[dementia_date_one_month_prior])))
			
			VAR prior_year_month_calc = EOMONTH(max('Practice Population'[dementia_date_one_month_prior]), -1)
			
			VAR prior_year_month = CONCATENATE(YEAR(prior_year_month_calc),MONTH(prior_year_month_calc))
			
			RETURN IF(Date_year_month = current_year_month, "Current Month", if(Date_year_month = prior_year_month, "Prior Month", "Other Month")) 
			```
		lineageTag: d751b368-3d90-4dca-89c9-69e2bdfbbaef
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column practice_yearmonth
		dataType: string
		lineageTag: a31b5728-6c3d-412b-a03c-afe797e1f78f
		summarizeBy: none
		sourceColumn: practice_yearmonth

		annotation SummarizationSetBy = Automatic

	partition 'Practice Population' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "PowerBI_Reporting", [Query="select *#(lf),[dementia_date_one_month_prior] = EOMONTH(DATEADD(MONTH, -1, last_date_of_month))#(lf),[practice_yearmonth] = CONCAT(practice_code, '_', format(convert(date, EOMONTH(DATEADD(MONTH, -1, last_date_of_month))), 'yyyyMM'))#(lf)FROM [PowerBI_Reporting].[primarycare].[tbl01_GP_Practice_Populations]#(lf)#(lf)order by last_date_of_month desc"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

