	column 'Last 12 Months' = ```
			
			
			VAR max_month = MAX('Query1'[activity_date])
			VAR min_month = max_month - 365
			return if(Query1[activity_date] <= max_month && Query1[activity_date] >= min_month, "Last 12 Months", "Older than 1 Year")
			
			```
