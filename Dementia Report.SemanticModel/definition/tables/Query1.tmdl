table Query1
	lineageTag: f0020c98-5734-4305-907a-44e85d2bf763

	measure 'Activity Rate per 1000 Yearly' =
			
			
			VAR Activity = CALCULATE ( SUM ('Query1'[counter] ))
			VAR POP = CALCULATE ([Diagnosed Dementia 65+ Population]  , ALLEXCEPT ('Date Reference', 'Date Reference'[financial_year] ), 'Date Reference'[month_name] IN {"Apr"} )
			
			RETURN (Activity/POP*1000)
		lineageTag: 2caa31a4-8839-446b-8fd8-2c342a4902d4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Activity Rate per 1000 Monthly' = ```
			
			
			VAR Activity = CALCULATE ( SUM ('Query1'[counter] ))
			VAR POP = [Diagnosed Dementia 65+ Population] 
			
			RETURN (Activity/POP*1000)
			```
		lineageTag: 5940458e-c4c9-4370-8bb7-a629f0a19853

		annotation PBI_FormatHint = {"isGeneralNumber":true}

