	measure 'A&E attendances' = CALCULATE(SUM('Query1'[counter]), 'Query1'[activity] = "A&E Attendances")
		formatString: 0
		lineageTag: d980febf-9a5b-452d-8b45-1c571e5d9cde

	measure 'Activity graph parameter y-value' = ```
			
			
			VAR Activity = CALCULATE ( SUM ('Query1'[counter] ))
			VAR POP_month = [Gloucestershire Dementia 65+ Population]
			VAR POP_year = CALCULATE ([Gloucestershire Dementia 65+ Population], ALLEXCEPT ('Date Reference', 'Date Reference'[financial_year] ), 'Date Reference'[month_name] IN {"Apr"} )
			
			
			VAR Year_or_month =
			    SELECTCOLUMNS (
			        SUMMARIZE ( 'Month or Yearly Parameter', 'Month or Yearly Parameter'[Month or Yearly], 'Month or Yearly Parameter'[Month or Yearly Fields] ),
			        'Month or Yearly Parameter'[Month or Yearly])
			
			VAR rate_or_actual =
			    SELECTCOLUMNS (
			        SUMMARIZE ( 'Rate or Actual Parameter', 'Rate or Actual Parameter'[Rate or Actual], 'Rate or Actual Parameter'[Parameter Fields] ),
			        'Rate or Actual Parameter'[Rate or Actual])
			
			
			RETURN IFERROR(if(Year_or_month = "monthly"
			        && rate_or_actual = "Rate per 1000"
			        ,Activity/POP_month*1000, 
			
			        if(Year_or_month = "yearly" 
			        && rate_or_actual = "Rate per 1000",
			        Activity/POP_year*1000,
			
			        if(Year_or_month = "monthly"
			        && rate_or_actual = "Actual Activity"
			        ,Activity, 
			
			        if(Year_or_month = "yearly"
			        && rate_or_actual = "Actual Activity"
			        ,Activity
			        
			        ,1000)))),BLANK())
			```
		lineageTag: 159ffefa-4121-4629-aad9-247a2196c6b9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Activity reason graph title' = ```
			
			VAR reason = if(SELECTEDVALUE('Query1'[activity]) = "Emergency Hospital Admissions", "Emergency Hospital Admissions Reasons",
			if(SELECTEDVALUE('Query1'[activity]) = "A&E Attendances", "A&E Attendance Reasons",
			if(SELECTEDVALUE('Query1'[activity]) = "MIU Attendances", "MIU Attendance Reasons",
			"Admission & Attendance Reasons")))
			
			VAR rate_or_actual = SELECTCOLUMNS (
			        SUMMARIZE ( 'Rate or Actual Parameter', 'Rate or Actual Parameter'[Rate or Actual], 'Rate or Actual Parameter'[Parameter Fields] ),
			        'Rate or Actual Parameter'[Rate or Actual]
			    )
			
			VAR timeframe = SELECTCOLUMNS (
			        SUMMARIZE ( 'Month or Yearly Parameter', 'Month or Yearly Parameter'[Month or Yearly], 'Month or Yearly Parameter'[Month or Yearly Fields] ),
			        'Month or Yearly Parameter'[Month or Yearly]
			    )
			
			VAR yeartodate = IF(SELECTEDVALUE('YTD Reference'[YTD Description]) = "Year to Date", "ytd","not ytd")
			
			VAR activity_type = SELECTEDVALUE('Query1'[activity])
			
			RETURN 
			IF ( rate_or_actual = "Actual Activity" && timeframe = "Yearly" && yeartodate = "not ytd", CONCATENATE("Top 5 "& reason & " - Yearly ", rate_or_actual ),
			IF ( rate_or_actual = "Actual Activity" && timeframe = "Monthly" && yeartodate = "not ytd", CONCATENATE("Top 5 "& reason & " - Yearly ", rate_or_actual ),
			IF ( rate_or_actual = "Rate per 1000" && timeframe = "Yearly" && yeartodate = "not ytd", CONCATENATE("Top 5 "& reason & " - Yearly ", rate_or_actual ),
			IF ( rate_or_actual = "Rate per 1000" && timeframe = "Monthly" && yeartodate = "not ytd", CONCATENATE("Top 5 "& reason & " - Average Monthly ", rate_or_actual ),
			
			IF ( rate_or_actual = "Actual Activity" && timeframe = "Yearly" && yeartodate = "ytd", CONCATENATE("Top 5 "& reason & " (YTD) - Yearly ", rate_or_actual ),
			IF ( rate_or_actual = "Actual Activity" && timeframe = "Monthly" && yeartodate = "ytd", CONCATENATE("Top 5 "& reason & " (YTD) - Yearly ", rate_or_actual ),
			IF ( rate_or_actual = "Rate per 1000" && timeframe = "Yearly" && yeartodate = "ytd", CONCATENATE("Top 5 "& reason & " (YTD) - Yearly ", rate_or_actual ),
			IF ( rate_or_actual = "Rate per 1000" && timeframe = "Monthly" && yeartodate = "ytd", "This selection does not produce data" ))))))))
			
			
			
			```
		lineageTag: 45e27c81-b839-455b-9432-5c31aeb89f32

	measure 'Activity graph title' = ```
			
			
			VAR activity = SELECTCOLUMNS (
			        SUMMARIZE ( 'Rate or Actual Parameter', 'Rate or Actual Parameter'[Rate or Actual], 'Rate or Actual Parameter'[Parameter Fields] ),
			        'Rate or Actual Parameter'[Rate or Actual]
			    )
			
			VAR timeframe = SELECTCOLUMNS (
			        SUMMARIZE ( 'Month or Yearly Parameter', 'Month or Yearly Parameter'[Month or Yearly], 'Month or Yearly Parameter'[Month or Yearly Fields] ),
			        'Month or Yearly Parameter'[Month or Yearly]
			    )
			
			VAR activity_type = SELECTEDVALUE('Query1'[activity])
			
			//IF ( COUNTROWS ( activity ) = 1, CONCATENATE(activity & " - ", reason ))
			
			RETURN 
			IF ( activity = "Actual Activity" && timeframe = "Yearly", CONCATENATE(activity_type & " ", activity & " - Yearly"  ),
			IF ( activity = "Actual Activity" && timeframe = "Monthly", CONCATENATE(activity_type & " ", activity & " - Monthly"  ),
			IF ( activity = "Rate per 1000" && timeframe = "Yearly", CONCATENATE(activity_type & " ", activity & " - Yearly" ),
			IF ( activity = "Rate per 1000" && timeframe = "Monthly", CONCATENATE(activity_type & " ", activity & " - Monthly" )))))
			
			```
		lineageTag: 160bb877-2448-453f-a997-8d9af77a58b6

	measure 'Activity reason graph parameter y-value' = ```
			
			
			VAR Activity = CALCULATE ( SUM ('Query1'[counter] ))
			VAR POP_month = [Diagnosed Dementia 65+ Population] 
			VAR POP_year = CALCULATE ( [Diagnosed Dementia 65+ Population] , ALLEXCEPT ('Date Reference', 'Date Reference'[financial_year] ), 'Date Reference'[month_name] IN {"Apr"} )
			
			VAR yeartodate = IF(SELECTEDVALUE('YTD Reference'[YTD Description]) = "Year to Date", "ytd","not ytd")
			
			VAR Year_or_month =
			    SELECTCOLUMNS (
			        SUMMARIZE ( 'Month or Yearly Parameter', 'Month or Yearly Parameter'[Month or Yearly], 'Month or Yearly Parameter'[Month or Yearly Fields] ),
			        'Month or Yearly Parameter'[Month or Yearly])
			
			VAR rate_or_actual =
			    SELECTCOLUMNS (
			        SUMMARIZE ( 'Rate or Actual Parameter', 'Rate or Actual Parameter'[Rate or Actual], 'Rate or Actual Parameter'[Parameter Fields] ),
			        'Rate or Actual Parameter'[Rate or Actual])
			
			
			RETURN if(Year_or_month = "monthly"
			        && rate_or_actual = "Rate per 1000"
			        && yeartodate = "not ytd"
			        ,Activity/POP_month*1000, 
			
			        if(Year_or_month = "yearly" 
			        && rate_or_actual = "Rate per 1000"
			        && yeartodate = "not ytd",
			        Activity/POP_year*1000,
			
			        if(Year_or_month = "monthly"
			        && rate_or_actual = "Actual Activity"
			        && yeartodate = "not ytd"
			        ,Activity, 
			
			        if(Year_or_month = "yearly"
			        && rate_or_actual = "Actual Activity"
			        && yeartodate = "not ytd"
			        ,Activity,
			
			        if(Year_or_month = "monthly"
			        && rate_or_actual = "Rate per 1000"
			        && yeartodate = "ytd"
			        ,BLANK(),
			
			        if(Year_or_month = "yearly"
			        && rate_or_actual = "Rate per 1000"
			        && yeartodate = "ytd",
			        Activity/POP_year*1000,
			
			        if(Year_or_month = "monthly"
			        && rate_or_actual = "Actual Activity"
			        && yeartodate = "ytd"
			        ,Activity, 
			
			        if(Year_or_month = "yearly"
			        && rate_or_actual = "Actual Activity"
			        && yeartodate = "ytd"
			        ,Activity
			
			        
			        ,1000))))))))
			```
		lineageTag: bbcc8e06-a5e1-41bb-aaba-4c2f57d2b0d5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

