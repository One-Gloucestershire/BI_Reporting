	column 'Time to First Assessment' =
			
			
			VAR cont_date = IF('First Assessment'[CareContDate] = BLANK(), BLANK(), 'First Assessment'[CareContDate])
			
			RETURN DATEDIFF('First Assessment'[ReferralRequestReceivedDate],cont_date,WEEK)
		formatString: 0
		lineageTag: c8672c77-1000-4d68-a3b3-2f1c3ab7d0ae
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition 'First Assessment' = m
		mode: import
		source =
