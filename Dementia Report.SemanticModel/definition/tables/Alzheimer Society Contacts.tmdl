table 'Alzheimer Society Contacts'
	lineageTag: 937b369f-4d8c-41bc-9a61-4db9ae3a60c9

	measure 'Alzheimer society contacts graph parameter y-value' = ```
			
			
			VAR Activity = CALCULATE ( SUM ('Alzheimer Society Contacts'[counter] ))
			VAR POP_month = [Diagnosed Dementia 65+ Population] 
			VAR POP_year = CALCULATE ([Diagnosed Dementia 65+ Population] , ALLEXCEPT ('Date Reference', 'Date Reference'[financial_year] ), 'Date Reference'[month_name] IN {"Apr"} )
			
			
			VAR Year_or_month =
			    SELECTCOLUMNS (
			        SUMMARIZE ( 'Month or Yearly Parameter', 'Month or Yearly Parameter'[Month or Yearly], 'Month or Yearly Parameter'[Month or Yearly Fields] ),
			        'Month or Yearly Parameter'[Month or Yearly])
			
			VAR rate_or_actual =
			    SELECTCOLUMNS (
			        SUMMARIZE ( 'Rate or Actual Parameter', 'Rate or Actual Parameter'[Rate or Actual], 'Rate or Actual Parameter'[Parameter Fields] ),
			        'Rate or Actual Parameter'[Rate or Actual])
			
			
			RETURN IFERROR(if(Year_or_month = "monthly"
			        && rate_or_actual = "Rate per 1000"
			        ,Activity/POP_month*1000, 
			
			        if(Year_or_month = "yearly" 
			        && rate_or_actual = "Rate per 1000",
			        Activity/POP_year*1000,
			
			        if(Year_or_month = "monthly"
			        && rate_or_actual = "Actual Activity"
			        ,Activity, 
			
			        if(Year_or_month = "yearly"
			        && rate_or_actual = "Actual Activity"
			        ,Activity
			        
			        ,1000)))),BLANK())
			```
		lineageTag: 2eec5cd6-58f1-4472-a10a-3ef8284588ae

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Alzheimer society contacts graph title' = ```
			
			
			VAR activity = SELECTCOLUMNS (
			        SUMMARIZE ( 'Rate or Actual Parameter', 'Rate or Actual Parameter'[Rate or Actual], 'Rate or Actual Parameter'[Parameter Fields] ),
			        'Rate or Actual Parameter'[Rate or Actual]
			    )
			
			
			VAR activity_type = "Alzheimer Society - Dementia Advisor Contacts"
			
			//IF ( COUNTROWS ( activity ) = 1, CONCATENATE(activity & " - ", reason ))
			
			VAR final = 
			IF ( activity = "Actual Activity", CONCATENATE(activity_type & " ", activity),
			IF ( activity = "Rate per 1000", CONCATENATE(activity_type & " ", activity)))
			
			RETURN final
			```
		lineageTag: 107b0558-bf78-4966-a47f-897a4cc5e16e

	measure 'Gloucestershire ICB AS Contacts' = CALCULATE([Alzheimer society contacts graph parameter y-value], ALL('GP Reference'))
		lineageTag: 7be3c9f0-89e2-4f47-afad-ce6b9a052aa2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Contacts rate per 1000 and actual activity' = ```
			
			
			VAR Activity = CALCULATE ( SUM ('Alzheimer Society Contacts'[counter] ))
			VAR POP_month = [Average Gloucestershire Diagnosed Population]
			
			VAR rate_or_actual =
			    SELECTCOLUMNS (
			        SUMMARIZE ( 'Rate or Actual Parameter', 'Rate or Actual Parameter'[Rate or Actual], 'Rate or Actual Parameter'[Parameter Fields] ),
			        'Rate or Actual Parameter'[Rate or Actual])
			
			RETURN IFERROR(if(rate_or_actual = "Rate per 1000"
			        ,Activity/POP_month*1000, 
			
			        if(rate_or_actual = "Actual Activity"
			        ,Activity,
			         0
			
			        )),BLANK())
			```
		lineageTag: ec93f419-3fd2-41e9-a085-a6421399802f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

