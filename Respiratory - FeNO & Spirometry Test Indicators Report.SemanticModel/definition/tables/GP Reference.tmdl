table 'GP Reference'
	lineageTag: 452ab777-7585-412d-a067-a71dea78be4b

	measure Matrix_Primary_Care_Network_Header = ```
			
			
			VAR OrgCode = SELECTEDVALUE('GP Reference'[OrganisationCode])
			RETURN
			IF(
			    ISBLANK(OrgCode),
			    "Residing in county but registered out of county at the time of test",
			    OrgCode
			)
			
			
