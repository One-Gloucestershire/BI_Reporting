	partition 'GP Reference' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Reference", [Query="--first obtain practices and their location coordinates#(lf)#(lf)#(lf)IF OBJECT_ID ('tempdb..#gp_practice_coordinates') IS NOT NULL DROP TABLE #gp_practice_coordinates#(lf);#(lf)#(tab)#(tab)   SELECT DISTINCT [GP_Practice_Code]#(lf)#(tab)#(tab)   ,  [GPLongitude] #(lf)#(tab)#(tab)   ,[GPLatitude] #(lf)#(tab)#(tab)   #(lf)#(tab)#(tab)   into #gp_practice_coordinates#(lf)#(lf)           FROM [PowerBI_Reporting].[PHM].[tbl02_DemographicsOverview]#(lf)#(lf)#(tab)#(tab) WHERE GPLongitude is not null #(lf)#(lf)#(lf)-- Create a GP location temp table with adjusted coordinates#(lf)#(lf)IF OBJECT_ID('tempdb..#gp_practice_map') IS NOT NULL #(lf)    DROP TABLE #gp_practice_map;#(lf)#(lf)SELECT #(lf)    gp.GP_Practice_Code,  -- Select all original columns#(lf)#(tab)#(lf)    -- Add a tiny random offset (less than 1 metre) to avoid overlapping points in Power BI#(lf)    [GPLongitude] = [GPLongitude] + ((RAND(CHECKSUM(NEWID())) - 0.5) * 0.000018),#(lf)    [GPLatitude]  = [GPLatitude]  + ((RAND(CHECKSUM(NEWID())) - 0.5) * 0.000009)#(lf)INTO #gp_practice_map#(lf)FROM #gp_practice_coordinates AS gp;#(lf)#(lf);#(lf)#(lf)#(lf)-- Create base gp reference temp table #(lf)  IF OBJECT_ID ('tempdb..#TEMP') IS NOT NULL DROP TABLE #TEMP#(lf)#(lf)SELECT [Locality] =[Locality]#(lf)      ,[PrimaryCareNetwork] = [PrimaryCareNetwork]#(lf)#(tab)  ,[OrganisationCode]#(lf)#(tab)  ,[ReportingOrganisationCode] =  [ReportingOrganisationCode] #(lf)#(tab)  ,[ReportingOrganisationName] =  [ReportingOrganisationName] #(lf)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab),[ReportingOrganisation_codeanddescription] = cast(NULL as varchar(max)) -- UPDATE AFTER #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)  #(lf)INTO #TEMP#(lf)FROM [CCG_Reference].[Reference].[vw_GPPractice]#(lf)#(lf)WHERE [Commissioner] = '11M'#(lf)AND [Locality] IS NOT NULL#(lf);#(lf)#(lf)#(lf)---update [ReportingOrganisation_codeanddescription]#(lf)#(lf)UPDATE #TEMP#(lf)SET [ReportingOrganisation_codeanddescription] = t.ReportingOrganisationCode + ' - ' + t.ReportingOrganisationName#(lf)#(lf)from #TEMP as t#(lf)#(lf)#(lf)---FINAL ouput #(lf)SELECT [GP].*#(lf)#(tab)  ,[COORD].[GPLatitude]#(lf)#(tab)  ,[COORD].[GPLongitude]#(lf)#(lf)FROM #TEMP AS [GP]#(lf)#(lf)LEFT JOIN #gp_practice_map [COORD] ON [COORD].[GP_Practice_Code] = [GP].[ReportingOrganisationCode]#(lf)#(lf)#(tab)#(tab)   where GP.OrganisationCode <> 'L84609' -- remove St Luke's Medical Centre#(lf)#(lf)"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

