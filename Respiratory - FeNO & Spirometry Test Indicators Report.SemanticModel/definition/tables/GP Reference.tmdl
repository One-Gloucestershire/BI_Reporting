	partition 'GP Reference' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db01_reference"), "with t as (select locality as ""Locality"", primarycarenetwork as ""PrimaryCareNetwork"", organisationcode as ""OrganisationCode"", reportingorganisationcode as ""ReportingOrganisationCode"", reportingorganisationname as ""ReportingOrganisationName"", reportingorganisationcode || ' - ' || reportingorganisationname as ""ReportingOrganisation_codeanddescription"" from icb_data_reference.vw_gppractice where commissioner ilike '11m%' and locality is not null) select t.*, c.gplatitude as ""GPLatitude"", c.gplongitude as ""GPLongitude"" from t left join (select distinct practice_code as gp_practice_code, gp_longitude as gplatitude, gp_latitude as gplongitude from db02_nopid.data_mart_primarycare.tbl01_gp_practice_populations where gp_latitude is not null) c on c.gp_practice_code=t.""ReportingOrganisationCode"" where t.""OrganisationCode"" <> 'L84609'", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

