table 'Metric Index'
	excludeFromModelRefresh
	lineageTag: b8bcc393-1be7-4049-85dd-8fbcb503b5e0

	measure 'Metric Description - Outputted Text' = ```
			
			
			
			
			IF (
			    ISFILTERED('Metric Index'[Metric ID]) 
			        || ISFILTERED('Metric Index'[Payable_activity_group]) 
			        || ISFILTERED('Metric Index'[Payable_activity_subgroup]),
			    IF (
			        DISTINCTCOUNT('Metric Index'[Metric Description]) = 1,
			        MAX('Metric Index'[Metric Description]), // One metric is selected
			        "Multiple metrics are selected, please refer to the slicer" // More than one metric is selected
			    ),
			    "Multiple metrics are selected, please refer to the slicer" // Nothing is selected
			)
			
			
			
			```
		lineageTag: 8047d652-dce2-45fe-808e-c44128791f62

	measure 'Metrics - Switch Values in view' = ```
			
			VAR SelectedMetric = SELECTEDVALUE('Metric Index'[Metric ID])
			VAR MetricsInScope = VALUES('Metric Index'[Metric ID])
			RETURN
			
			IF(
			    ISINSCOPE('Metric Index'[Metric ID]),
			    // Row level, do your SWITCH logic as usual
			    SWITCH(
			        SelectedMetric,
			        "1a", COALESCE([Metrics - Matrix Table Total Counts],0),
			        "2a", COALESCE([Metrics - Matrix Table Total Counts],0),
			        "2b", COALESCE([Metrics - Matrix Table Total Counts],0),
			        "1b", COALESCE([Metrics - Matrix Table Total Counts],0),
			        "2c", COALESCE([Metrics - Matrix Table Total Counts],0),
			        --"706", [Metrics - Matrix Table Total Counts],
			        --"707", [Metrics - Matrix Table Total Counts],
			        "5a", COALESCE([Metrics - Matrix Table Total Counts],0),
			        "5c", COALESCE([Metrics - Matrix Table Total Counts],0),
			        "5d", COALESCE([Metrics - Matrix Table Total Counts],0),
			        "5f", COALESCE([Metrics - Matrix Table Total Counts],0),
			        "5e", COALESCE([Metrics - Matrix Table Total Counts],0),
			        "5b", COALESCE([Metrics - Matrix Table Total Counts],0),
			        "3a", COALESCE([Metrics - Matrix Table Total Counts],0),
			        --"706ab", [Metrics - Matrix Table Total Counts],
			        "3b", COALESCE([Metrics - Matrix Table Total Counts],0),
			        "4a", COALESCE(CALCULATE(SUM('Metric Data Table'[UniqueTestValueID]), 'Metric Data Table'[Metric_ID] = "4a"),0),
			        "4b", COALESCE(CALCULATE(SUM('Metric Data Table'[UniqueTestValueID]), 'Metric Data Table'[Metric_ID] = "4b"),0),
			        BLANK()
			    ),
			    // Total/subtotal level, sum across all visible metric IDs in this context
			    SUMX(
			        MetricsInScope,
			        SWITCH(
			            [Metric ID],
			        "1a", COALESCE([Metrics - Matrix Table Total Counts],0),
			        "2a", COALESCE([Metrics - Matrix Table Total Counts],0),
			        "2b", COALESCE([Metrics - Matrix Table Total Counts],0),
			        "1b", COALESCE([Metrics - Matrix Table Total Counts],0),
			        "2c", COALESCE([Metrics - Matrix Table Total Counts],0),
			        --"706", [Metrics - Matrix Table Total Counts],
			        --"707", [Metrics - Matrix Table Total Counts],
			        "5a", COALESCE([Metrics - Matrix Table Total Counts],0),
			        "5c", COALESCE([Metrics - Matrix Table Total Counts],0),
			        "5d", COALESCE([Metrics - Matrix Table Total Counts],0),
			        "5f", COALESCE([Metrics - Matrix Table Total Counts],0),
			        "5e", COALESCE([Metrics - Matrix Table Total Counts],0),
			        "5b", COALESCE([Metrics - Matrix Table Total Counts],0),
			        "3a", COALESCE([Metrics - Matrix Table Total Counts],0),
			        --"706ab", [Metrics - Matrix Table Total Counts],
			        "3b", COALESCE([Metrics - Matrix Table Total Counts],0),
			        "4a", COALESCE(CALCULATE(SUM('Metric Data Table'[UniqueTestValueID]), 'Metric Data Table'[Metric_ID] = "4a"),0),
			        "4b", COALESCE(CALCULATE(SUM('Metric Data Table'[UniqueTestValueID]), 'Metric Data Table'[Metric_ID] = "4b"),0),
			        BLANK()
			        )
			    )
			)
			
			```
		formatString: 0
		lineageTag: 11a1756b-da75-4f75-ac46-08ccc3d87e1b

	measure ShowActivityGroup = ```
			
			
			CALCULATE(
			    COUNTROWS('Metric Data Table'),
			    REMOVEFILTERS('GP Reference'),
			    REMOVEFILTERS('Metric Index'[Metric_ID_and_Description]
			) 
			)
			```
		formatString: 0
		lineageTag: 69573283-f36c-40e2-a790-63960e46b73b

