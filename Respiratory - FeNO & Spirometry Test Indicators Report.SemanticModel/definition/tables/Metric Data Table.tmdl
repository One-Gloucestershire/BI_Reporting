	measure 'Metrics - Trendline Count' = ```
			
			
			VAR MonthlyMetricTable =
			    SUMMARIZE(
			        'Metric Data Table',
			        'Date Reference'[year_month],
			        'Metric Data Table'[Metric_ID],
			        "MonthlyCount", calculate(DISTINCTCOUNT('Metric Data Table'[Pseudo_NHS_Number])
			    )
			
			
			
			VAR Temp_Table = 
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED( 'Date Reference'[financial_year], 'Date Reference'[financial_month],
			                         'Date Reference'[month_name], 'Date Reference'[Month_Number] ),
			            "Value_x", 'Date Reference'[Month_Number],
			            "Value_y", 'Metric Data Table'[Metrics - Matrix Table Total Counts]
			        ),
			        AND (
			            NOT ( ISBLANK ( "Value_x" ) ),
			            NOT ( ISBLANK ( "Value_y" ) )
			        )
			    )
			
			VAR LINESTX_Table = 
			    LINESTX(Temp_Table, [Value_y], [Value_x], TRUE)
			VAR Slope = 
			    MAXX ( LINESTX_Table, [Slope1] )
			VAR Intercept = 
			    MAXX ( LINESTX_Table, [Intercept] )
			
			RETURN
			    IF(
			        SUMX (
			        DISTINCT ( 'Date Reference'[Month_Number] ),
			        Intercept + Slope * 'Date Reference'[Month_Number]
			    ) < 0,
			    0,
			        SUMX (
			        DISTINCT ( 'Date Reference'[Month_Number] ),
			        Intercept + Slope * 'Date Reference'[Month_Number]
			                )
			    )
			```
		lineageTag: 4c853370-fc7f-43fd-b69a-eba189029e06

