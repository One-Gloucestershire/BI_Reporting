	measure 'Metrics - Trendline Total Tests (712&713)' = ```
			
			
			VAR MonthsTable =
			    ADDCOLUMNS(
			        FILTER(
			            ALLSELECTED('Date Reference'),
			            NOT(ISBLANK('Metric Data Table'[Metrics - Total Unique Patient Tests]))
			        ),
			        "Value_y", 'Metric Data Table'[Metrics - Total Unique Patient Tests]
			    )
			
			VAR RankedMonths =
			    ADDCOLUMNS(
			        MonthsTable,
			        "Value_x",
			        RANKX(
			            MonthsTable,
			            [year_month], , ASC, DENSE
			        )
			    )
			
			VAR Temp_Table =
			    SELECTCOLUMNS(
			        RankedMonths,
			        "Value_x", [Value_x],
			        "Value_y", [Value_y]
			    )
			
			VAR LINESTX_Table =
			    LINESTX(Temp_Table, [Value_y], [Value_x], TRUE)
			VAR Slope =
			    MAXX(LINESTX_Table, [Slope1])
			VAR Intercept =
			    MAXX(LINESTX_Table, [Intercept])
			
			VAR CurrentYearMonth = SELECTEDVALUE('Date Reference'[year_month])
			
			VAR CurrentValueX =
			    MAXX(
			        FILTER(RankedMonths, [year_month] = CurrentYearMonth),
			        [Value_x]
			    )
			
			VAR TrendlineValue = Intercept + Slope * CurrentValueX
			
			RETURN IF(TrendlineValue < 0, 0, TrendlineValue)
			
			```
		lineageTag: ee20e3bd-bdae-483f-8efd-8ae67d21048d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

