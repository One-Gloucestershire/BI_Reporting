	measure 'Metrics - Latest Month Total in Care Home' =
			
			
			VAR LatestDate = MAX('Date Reference'[date])
			VAR StartOfLatestMonth = CALCULATE(STARTOFMONTH('Date Reference'[date]), 'Date Reference'[date] = LatestDate)
			VAR EndOfLatestMonth = CALCULATE(ENDOFMONTH('Date Reference'[date]), 'Date Reference'[date] = LatestDate)
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT('Metric Data Table'[Pseudo_NHS_Number])
			    ,'Metric Data Table'[Derived_IsLivingInCareHome] = 1
			)
		formatString: #,0
		lineageTag: b2e9c867-f0de-4b30-85e3-d22f366f930e

