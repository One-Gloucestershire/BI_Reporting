table Date
	lineageTag: d342dd2e-b0bb-4f6f-a38e-a4dcc3f5dd70

	measure 'Latest Month' = ```
			
			
			Var LatestMonth = MAX ('Date'[month_year_name])
			
			
			Return 
			
			CALCULATETABLE({LatestMonth},'Date'[date] = max('Date'[date]))
			```
		lineageTag: b779c048-e275-43be-87b5-54076a04c629

	measure 'Latest Month for Card' =
			
			
			MAX ( 'Date'[month_year_name] )
		lineageTag: d607b802-b6cc-4c1b-904e-9f6024ec57f5

	measure 'Latest Month-Year for Card' =
			
			
			CALCULATETABLE(
			    {'Date'[Latest Month for Card] } ,
			    'Date'[date] = MAX ( 'Date'[date] ))
		formatString: General Date
		lineageTag: e3358698-0e7b-469f-b41b-f616fbcd43b6

	measure 'Last Updated' = ```
			
			
			 
			
			TODAY()
			```
		formatString: mmmm yyyy
		lineageTag: ba5f0478-276e-4551-bada-244aa142608f

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

