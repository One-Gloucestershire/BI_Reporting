table '1. Ambulance. SWASFT - Activity'
	lineageTag: 287f8d5d-c6bf-4e34-bdd1-86cacdd35cd6

	measure SeeConveyPercentage = ```
			
			VAR SeeConveyTotal = 
			CALCULATE(SUM('1. Ambulance. SWASFT - Activity'[Counter]),
			'1. Ambulance. SWASFT - Activity'[Outcome] in {"See & Convey"})
			VAR SWASFTTotal = 
			CALCULATE(SUM('1. Ambulance. SWASFT - Activity'[Counter]))
			RETURN
			SeeConveyTotal/SWASFTTotal
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Measures
		lineageTag: aa8eb78f-b027-4fbf-bee2-8f4bbe8fe603

	measure RatePer1000MAP =
			
			
			VAR NoCalls = CALCULATE(sum('1. Ambulance. SWASFT - Activity'[Counter]))
			
			VAR Pop = CALCULATE(SUM('Current Populations'[Counter]))
			
			RETURN IFERROR((NoCalls/Pop)*1000,BLANK())
		displayFolder: Measures
		lineageTag: 2cb88f6c-9087-420e-af56-a1b0f9ffeef6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Conveyance Linear Regression' = ```
			
			 
			VAR Temp_Table =
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED( 'Date Table'[FinancialYear], 'Date Table'[FinancialMonth],
			                         'Date Table'[monthname], 'Date Table'[month_number] ),
			            "Value_x", 'Date Table'[month_number],
			            "Value_y", 'SWASFT - Activity'[SeeConveyPercentage]
			        ),
			        AND (
			            NOT ( ISBLANK ( "Value_x" ) ),
			            NOT ( ISBLANK ( "Value_y" ) )
			        )
			    )
			 
			VAR LINESTX_Table =
			    LINESTX(Temp_Table, [Value_y], [Value_x], TRUE)
			VAR Slope =
			    MAXX ( LINESTX_Table, [Slope1] )
			VAR Intercept =
			    MAXX ( LINESTX_Table, [Intercept] )
			 
			RETURN
			    SUMX (
			        DISTINCT ( 'Date Table'[month_number] ),
			        Intercept + Slope * 'Date Table'[month_number]
			    )
			```
		displayFolder: Measures
		lineageTag: 4a7b1884-e270-4c55-883e-523d795808e7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure TotalPerMonth_AmbAct =
			
			calculate(SUM('1. Ambulance. SWASFT - Activity'[Counter]),ALLSELECTED('1. Ambulance. SWASFT - Activity'),'1. Ambulance. SWASFT - Activity'[SPC Flag]=1)
		displayFolder: SPC
		lineageTag: 59b34266-2b22-4df2-9c2d-a1fb3917f966

	measure NumberOfMonths_AmbAct = CALCULATE(DISTINCTCOUNT('1. Ambulance. SWASFT - Activity'[year_month]),ALLSELECTED('1. Ambulance. SWASFT - Activity'),'1. Ambulance. SWASFT - Activity'[SPC Flag]=1)
		displayFolder: SPC
		lineageTag: d83515e5-d843-4e6f-bfd2-e516d498b28a

	measure Mean_AmbAct =
			
			[TotalPerMonth_AmbAct]/[NumberOfMonths_AmbAct]
		displayFolder: SPC
		lineageTag: 90fbf8cf-b8a8-4045-9c18-bcebf8cee298

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure MonthlyTotal_AmbAct =
			SUMX (
			    VALUES ( '1. Ambulance. SWASFT - Activity'[year_month] ),
			    CALCULATE ( SUM ( '1. Ambulance. SWASFT - Activity'[CounteR] ),
			    '1. Ambulance. SWASFT - Activity'[SPC Flag] = 1 )
			)
		formatString: 0
		displayFolder: SPC
		lineageTag: b708fbbd-df7e-430d-8811-36a831a1f0b0

	measure StdDev_AmbAct = ```
			
			VAR STD_DEV = CALCULATE(STDEVX.P ( VALUES ( '1. Ambulance. SWASFT - Activity'[year_month]), [MonthlyTotal_AmbAct]), ALLEXCEPT('Date Table', 'Date Table'[year_month]))
			 
			RETURN IFERROR(STD_DEV, 0)
			```
		displayFolder: SPC
		lineageTag: 2977569a-12e0-4f80-82c8-2684f83eb3bf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure LCL_AmbAct = [Mean_AmbAct]-(3*[StdDev_AmbAct])
		displayFolder: SPC
		lineageTag: 9c59b4f2-0310-4ed3-8431-511715972172

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure UCL_AmbAct = [Mean_AmbAct]+(3*[StdDev_AmbAct])
		displayFolder: SPC
		lineageTag: 924f6e0b-7068-455d-84cd-e328a889ae58

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure SWASFT_CounterSupressed =
			IF(
			    ISBLANK(SUM('1. Ambulance. SWASFT - Activity'[Counter])),"",
			    IF(
			        SUM('1. Ambulance. SWASFT - Activity'[Counter])<5,0,sum('1. Ambulance. SWASFT - Activity'[Counter])))
		formatString: 0.00
		displayFolder: Data Values
		lineageTag: dd80743e-13a7-41ac-be00-7556a4b78b36

