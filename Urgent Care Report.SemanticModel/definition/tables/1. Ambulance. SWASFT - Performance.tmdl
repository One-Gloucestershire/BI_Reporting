table '1. Ambulance. SWASFT - Performance'
	lineageTag: d68ce1ed-f9b4-4215-a17a-e1cd4fb11cac

	measure StdDev2 = CALCULATE(STDEVX.P('1. Ambulance. SWASFT - Performance',[ResponseTime]),ALLSELECTED('Date Table'), '1. Ambulance. SWASFT - Performance'[SPC Flag] = 1)
		lineageTag: cbe375d7-189f-494c-93a7-a246bc533f8b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure UCL2 = [Mean2]+(3*[StdDev2])
		lineageTag: 2289fd90-237c-4e92-b5d9-96fd90d59dfb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure LCL2 = [Mean2]-(3*[StdDev2])
		lineageTag: 10bb346d-371c-45a4-bfe4-2093e74387b9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Mean_Amb = ```
			
			VAR Response_month = 
			    CALCULATE ( SUM ( '1. Ambulance. SWASFT - Performance'[ResponseTime] ),ALLSELECTED('1. Ambulance. SWASFT - Performance'),
			    '1. Ambulance. SWASFT - Performance'[SPC Flag] = 1 )
			
			VAR Patients = CALCULATE(sum('1. Ambulance. SWASFT - Performance'[Counter]),ALLSELECTED('1. Ambulance. SWASFT - Performance'), '1. Ambulance. SWASFT - Performance'[DataType] = "Grouped Performance",'1. Ambulance. SWASFT - Performance'[SPC Flag]=1)
			
			RETURN Response_month/Patients
			```
		formatString: 0.0
		lineageTag: 4aae2a99-39ec-4acb-9a75-0cde61e21b35

