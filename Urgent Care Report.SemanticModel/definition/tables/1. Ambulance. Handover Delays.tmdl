table '1. Ambulance. Handover Delays'
	lineageTag: e95f0793-f343-4c86-a8e0-99f524b2895d

	measure TotalMinutes = sum('1. Ambulance. Handover Delays'[Handover delays - minutes])
		lineageTag: 815d42a8-5263-438a-9062-705c78b7913d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Handover Linear Regression' = ```
			
			 
			VAR Temp_Table =
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED( 'Date Table'[FinancialYear], 'Date Table'[FinancialMonth],
			                         'Date Table'[monthname], 'Date Table'[month_number] ),
			            "Value_x", 'Date Table'[month_number],
			            "Value_y", 'Handover Delays'[TotalMinutes]
			        ),
			        AND (
			            NOT ( ISBLANK ( "Value_x" ) ),
			            NOT ( ISBLANK ( "Value_y" ) )
			        )
			    )
			 
			VAR LINESTX_Table =
			    LINESTX(Temp_Table, [Value_y], [Value_x], TRUE)
			VAR Slope =
			    MAXX ( LINESTX_Table, [Slope1] )
			VAR Intercept =
			    MAXX ( LINESTX_Table, [Intercept] )
			 
			RETURN
			    SUMX (
			        DISTINCT ( 'Date Table'[month_number] ),
			        Intercept + Slope * 'Date Table'[month_number]
			    )
			```
		lineageTag: 6da51e33-c4cd-4900-9526-60a148b3b0d2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

