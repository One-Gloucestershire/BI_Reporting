table '2. A&E. Patient level data'
	lineageTag: c1c4d096-a025-46cc-9083-7a910bc260e8

	measure Arrival_Hour_% =
			
			VAR _TOTAL = SUM ( '2. A&E. Patient level data'[Counter] )
			VAR _STATIC = CALCULATE ( SUM ( '2. A&E. Patient level data'[Counter]  ), REMOVEFILTERS( '2. A&E. Patient level data'[arrival_hour] ))
			
			RETURN
			_TOTAL/_STATIC
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Measures
		lineageTag: a8068f5f-7105-41df-84e4-056386772c90

	measure Arrival_Day_% =
			
			VAR _TOTAL = SUM ( '2. A&E. Patient level data'[Counter] )
			VAR _STATIC = CALCULATE ( SUM ( '2. A&E. Patient level data'[Counter]  ), REMOVEFILTERS( '2. A&E. Patient level data'[weekday_name] ,'2. A&E. Patient level data'[Weekday Sorter]))
			
			RETURN
			_TOTAL/_STATIC
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Measures
		lineageTag: af4b599a-137d-4b08-8115-15a5448563d4

	measure RatePer1000LSOA =
			
			
			VAR ED = CALCULATE ( SUM ('2. A&E. Patient level data'[Counter]))
			VAR POP = CALCULATE ( SUM ( 'LSOA Populations Through Time'[Population]) , ALLEXCEPT ('date table', 'Date Table'[Financial Year] ), 'date table'[month_name] IN {"Apr"} )
			RETURN (ED/POP*1000)
		displayFolder: Measures
		lineageTag: fbb4bccb-771f-4e12-812c-0c0cdfbec8a7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Admitted_% =
			
			VAR _TOTAL = SUM ( '2. A&E. Patient level data'[Counter] )
			VAR _STATIC = CALCULATE ( SUM ( '2. A&E. Patient level data'[Counter]  ), REMOVEFILTERS( '2. A&E. Patient level data'[admitted_flag] ))
			
			RETURN
			_TOTAL/_STATIC
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Measures
		lineageTag: 426c4b66-58e8-4701-92d5-01e92fcc7ed3

	measure Mean_ED =
			
			[TotalPerMonth_ED]/[NumberOfMonths_ED]
		formatString: #,0.00
		displayFolder: SPC
		lineageTag: 16f2067e-a30f-4b64-8339-1e2403184465

	measure TotalPerMonth_ED =
			
			calculate(SUM('2. A&E. Patient level data'[Counter]),ALLSELECTED('2. A&E. Patient level data'),'2. A&E. Patient level data'[SPC Flag]=1)
		formatString: 0
		displayFolder: SPC
		lineageTag: ccef0b8c-162c-488e-b1d2-58e731cc6fc1

	measure NumberOfMonths_ED = CALCULATE(DISTINCTCOUNT('2. A&E. Patient level data'[year_month]),ALLSELECTED('2. A&E. Patient level data'),'2. A&E. Patient level data'[SPC Flag]=1)
		formatString: 0
		displayFolder: SPC
		lineageTag: 9062e76e-db01-448a-b5ee-db39f68af138

	measure StdDev_ED = ```
			
			VAR STD_DEV = CALCULATE(STDEVX.P ( VALUES ( '2. A&E. Patient level data'[year_month]), [MonthlyTotal_ED]), ALLEXCEPT('Date Table', 'Date Table'[year_month]))
			 
			RETURN IFERROR(STD_DEV, 0)
			```
		displayFolder: SPC
		lineageTag: 9a422793-86ef-4be6-956a-68a6e59e9e96

	measure MonthlyTotal_ED =
			SUMX (
			    VALUES ( '2. A&E. Patient level data'[year_month] ),
			    CALCULATE ( SUM ( '2. A&E. Patient level data'[Counter] ),
			    '2. A&E. Patient level data'[SPC Flag] = 1 )
			)
		formatString: 0
		displayFolder: SPC
		lineageTag: 9dd9f312-b250-49d3-989d-436a135a1418

	measure UCL_ED = [Mean_ED]+(3*[StdDev_ED])
		formatString: #,0.00
		displayFolder: SPC
		lineageTag: 181b099c-7dcf-48ef-8cd0-0e5e4b42f7a7

	measure LCL_ED = [Mean_ED]-(3*[StdDev_ED])
		formatString: #,0.00
		displayFolder: SPC
		lineageTag: bf784552-6c89-4da0-b5b9-68612b2ccfd5

	measure AE_CounterSupressed =
			IF(
			    ISBLANK(SUM('2. A&E. Patient level data'[Counter])),"",
			    IF(
			        SUM('2. A&E. Patient level data'[Counter])<5,0,sum('2. A&E. Patient level data'[Counter])))
		formatString: #,0
		lineageTag: 739441d6-6f94-48c1-b33f-90ba447bd07b

		annotation PBI_FormatHint = {"isDecimal":true}

