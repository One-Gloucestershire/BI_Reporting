table '3. Admissions'
	lineageTag: ee584f6b-fe9a-44a9-8e0e-1d2da5e366ba

	measure NumberOfMonths_Adm = CALCULATE(DISTINCTCOUNT('3. Admissions'[year_month]),ALLSELECTED('3. Admissions'),'3. Admissions'[SPC Flag]=1)
		displayFolder: SPC
		lineageTag: 99656aca-0d8b-45c2-a9df-9a480a29713f

	measure MonthlyTotal_Adm =
			SUMX (
			    VALUES ( '3. Admissions'[year_month] ),
			    CALCULATE ( SUM ( '3. Admissions'[Counter] ),
			    '3. Admissions'[SPC Flag] = 1 )
			)
		displayFolder: SPC
		lineageTag: 4da4d0c5-ccf1-4c54-8779-ffcedd0bef24

	measure TotalPerMonth_Adm =
			
			calculate(SUM('3. Admissions'[Counter]),ALLSELECTED('3. Admissions'),'3. Admissions'[SPC Flag]=1)
		displayFolder: SPC
		lineageTag: f8d4ad75-2958-4bf2-a9fb-d956719982c9

	measure Mean_Adm =
			
			[TotalPerMonth_Adm]/[NumberOfMonths_Adm]
		formatString: #,0
		displayFolder: SPC
		lineageTag: a5de5c67-5d73-4aeb-abc2-4e20fd511e76

		annotation PBI_FormatHint = {"isDecimal":true}

	measure StdDev_Adm = ```
			
			VAR STD_DEV = CALCULATE(STDEVX.P ( VALUES ( '3. Admissions'[year_month]), [MonthlyTotal_Adm]), ALLEXCEPT('Date Table', 'Date Table'[year_month]))
			 
			RETURN IFERROR(STD_DEV, 0)
			```
		displayFolder: SPC
		lineageTag: 18bf9ff4-5f97-4231-b67a-cb8688d41fe4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure UCL_Adm = [Mean_Adm]+(3*[StdDev_Adm])
		formatString: #,0
		displayFolder: SPC
		lineageTag: ca6704b4-eb24-4b35-aaa6-4c9b77ff5a52

		annotation PBI_FormatHint = {"isDecimal":true}

	measure LCL_Adm = [Mean_Adm]-(3*[StdDev_Adm])
		formatString: #,0
		displayFolder: SPC
		lineageTag: 8a097fe3-5001-488c-a584-973c77df8990

		annotation PBI_FormatHint = {"isDecimal":true}

	measure Admissions_CounterSupressed =
			IF(
			    ISBLANK(SUM('3. Admissions'[Counter])),"",
			    IF(
			        SUM('3. Admissions'[Counter])<5,0,sum('3. Admissions'[Counter])))
		formatString: #,0
		lineageTag: b19fb3ec-0823-4055-971b-68d7f6a8b32c

		annotation PBI_FormatHint = {"isDecimal":true}

	measure RatePer1000LSOA_Admission =
			
			
			VAR Adm = CALCULATE ( SUM ('3. Admissions'[Counter]))
			VAR POP = CALCULATE ( SUM ( 'LSOA Populations Through Time'[Population]) , ALLEXCEPT ('date table', 'Date Table'[Financial Year] ), 'date table'[month_name] IN {"Apr"} )
			RETURN (Adm/POP*1000)
		lineageTag: bd20db92-0b1a-4f0d-976f-bd71bb15479d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

