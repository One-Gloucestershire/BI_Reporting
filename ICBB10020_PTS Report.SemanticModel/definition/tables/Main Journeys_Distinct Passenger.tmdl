	partition 'Main Journeys_Distinct Passenger' = m
		mode: directQuery
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "PowerBI_Reporting", [Query="#(lf)select distinct [passengerID] as [Distinct Patient]#(lf),[Pseudo_NHS_Number] #(lf),[Counter] = 1#(lf),[Patient_Practice_Description]#(lf), [NetworkName] #(lf),[localityname]#(lf),[district]#(lf),[Ethnic Origin Grouped] = case when [Ethnic Origin Grouped] IS NULL then 'Unknown' else [Ethnic Origin Grouped] end#(lf),[Gender] = case when [Gender] IS NULL then'Unknown'#(lf)when [Gender] = 'F' then 'Female'#(lf)when [Gender] = 'M' then 'Male' #(lf)else [Gender] end#(lf),[core20flag]#(lf),[ageband_5yr_ordered]#(lf),[ruralurbanclass]#(lf),[segmenthealthleeds]#(lf),[Living_in_Care_Home]#(lf),IMDcountyDecile#(lf),[IMD 1 Income]#(lf),[IMD 2 Employment]#(lf),[IMD 3 Education]#(lf),[IMD 4 Health]#(lf),[IMD 5 Crime]#(lf),[IMD 6 Barriers to Housing and Services]#(lf),[IMD 7 Living Environment]#(lf)#(lf)from [PowerBI_Reporting].[dbo].[PTS_Main]#(lf)where [Activity_Month] in (#(lf)select distinct top 12 [Activity_Month] from [PowerBI_Reporting].[dbo].[PTS_Main] order by [Activity_Month] desc)"])
				in
				    Source

	changedProperty = Name

	annotation PBI_ResultType = Table

