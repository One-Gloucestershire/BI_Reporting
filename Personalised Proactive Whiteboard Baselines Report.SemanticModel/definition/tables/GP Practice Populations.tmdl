	partition 'GP Practice Populations' = m
		mode: import
		queryGroup: 'Reference Tables'
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "CCG_Reference", [Query="#(lf)#(lf)SELECT *#(lf),[Census_Date] = CAST('01-'+LEFT(CENSUSDATE,3)+'-20'+RIGHT(CENSUSDATE,2)AS DATE)#(lf)FROM CCG_Reference.Reference.vw_GPPracticePopulation#(lf)where left(age,2) >60#(lf)and AgeGroupType = 'Group 1'#(lf)and CAST('01-'+LEFT(CENSUSDATE,3)+'-20'+RIGHT(CENSUSDATE,2)AS DATE) between '20210701' and '20230801'#(lf)order by left(age,2) #(lf)"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

