			        MONTH
			    )
			VAR DistinctMonths =
			    COUNTROWS(
			        DISTINCT(
			            SELECTCOLUMNS(
			                RollingPeriod,
			                "YearMonth", FORMAT([Date], "YYYY-MM")
			            )
			        )
			    )
			VAR TableWithAggregates =
			    ADDCOLUMNS(
			        RollingPeriod,
			        "Total of ppw patients that died in their preferred place of death", CALCULATE([Total PPW patients that died in their preferred place of death]),
			        "Total of ppw patients that had a preferred place of death recorded", CALCULATE([Number of PPW deaths in cohort with a preferred place of death recorded])
			    )
			VAR TotalSum_PPW_deaths_that_died_in_their_preferred_place_of_death = 
			    SUMX(TableWithAggregates, [Total of ppw patients that died in their preferred place of death])
			
			VAR TotalSum_PPW_deaths_that_had_a_preferred_place_of_death_recorded = 
			    SUMX(TableWithAggregates, [Total of ppw patients that had a preferred place of death recorded])
			
			
			RETURN
			IF(
			   ISBLANK(MAX(REF_Date_Ref[Date])) || DistinctMonths < 3 || TotalSum_PPW_deaths_that_died_in_their_preferred_place_of_death < 6,
			   BLANK(),
			   DIVIDE(TotalSum_PPW_deaths_that_died_in_their_preferred_place_of_death,TotalSum_PPW_deaths_that_had_a_preferred_place_of_death_recorded,0)
			)
			
			```
		formatString: 0.000%;-0.000%;0.000%
		displayFolder: .15Patients died in their preferred place of death
		lineageTag: 83687e19-2f09-4e93-a2bf-526d79a14069

	measure 'percentage change PPW  died in preferred place of death in 6 months' = ```
			
			/* Amended 14_02_25 to get the average over the previous 6 months */
			
			VAR CM = calculate([PPW proption that died in their preferred place of death],'REF_Date_Ref'[Latest_Month_Flag] = 1)
			VAR num_of_ppw_that_died_in_their_preferred_place_of_death = CALCULATE(
			    [Total PPW patients that died in their preferred place of death],
			    DATESBETWEEN(
			        'REF_Date_Ref'[date],
			        EDATE(max('1.Baselines'[Census_Date]),-6),
			        EOMONTH(max('1.Baselines'[Census_Date]),-1)
			    )
			 
			
			)
			
			VAR num_of_ppw_deaths_with_a_preferred_place_of_death_recorded = CALCULATE(
			    [Number of PPW deaths in cohort with a preferred place of death recorded],
			    DATESBETWEEN(
			        'REF_Date_Ref'[date],
			        EDATE(max('1.Baselines'[Census_Date]),-6),
			        EOMONTH(max('1.Baselines'[Census_Date]),-1)
			    )
			
			
			)
			
			VAR LM = DIVIDE(num_of_ppw_that_died_in_their_preferred_place_of_death,num_of_ppw_deaths_with_a_preferred_place_of_death_recorded,0)
			
			Return
			
			if(num_of_ppw_that_died_in_their_preferred_place_of_death<6,0, --suppressed
			
			(CM-LM)/LM 
			
			
			)
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: .15Patients died in their preferred place of death
		lineageTag: c64f3e78-0899-4254-9b91-6104463c171b

	measure proportion_of_ppw_died_in_preferred_place_of_death_percentage_change_Arrow = ```
			
			    IF([percentage change PPW  died in preferred place of death in 6 months] > 0, UNICHAR(9650),
			        IF([percentage change PPW  died in preferred place of death in 6 months]< 0, UNICHAR(9660), "")
			    )
			```
		displayFolder: .15Patients died in their preferred place of death
		lineageTag: b6babf25-2196-42a6-ad32-79257e61460d

	measure 'Suppressed_Total PPW patients that died in their preferred place of death' = ```
			
			
			Var Number_died_in_preferred_place =  
			calculate(DISTINCTCOUNT('1.Baselines'[nhs_number])
			,'1.Baselines'[Patient_latest_snapshot_flag] = 1 //only include the last snapshot the patient was in 
			,'1.Baselines'[deceased_flag] = 1 //only include deceased patients 
			,'1.Baselines'[In_Cohort_Flag] = 1
			,'1.Baselines'[died_in_preferred_place_of_death_flag] = 1
			,'1.Baselines'[Appeared_on_PPW_3_consecutive_months_prior_to_death_flag] = 1 
			,DATEDIFF('1.Baselines'[Census_Date], '1.Baselines'[Date_of_Death], MONTH) >= 0 &&
			DATEDIFF('1.Baselines'[Census_Date], '1.Baselines'[Date_of_Death], MONTH) <= 1
			,USERELATIONSHIP('1.Baselines'[Date_of_Death],REF_Date_Ref[Date]) // use the inactive relationship to join on date of death
			)
			
			
			
			RETURN 
			if(Number_died_in_preferred_place<6,0,
			Number_died_in_preferred_place
			)
			```
		formatString: 0
		displayFolder: .15Patients died in their preferred place of death
		lineageTag: 27ba858f-5018-40b8-bac1-3c6c2c7f1776

	measure 'suppressed_PPW proption that died in their preferred place of death' =
			
			if([Total PPW patients that died in their preferred place of death]<6,0,
			divide([Total PPW patients that died in their preferred place of death],[Number of PPW deaths in cohort with a preferred place of death recorded],0)
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: .15Patients died in their preferred place of death
		lineageTag: 6e42dc26-2ea4-4d70-ac89-6fb7db44bbec

	measure Percentage_variance_ppw_deaths_died_in_preferred_place_of_death_variance_Arrow_Colour = ```
			
			    IF([percentage change PPW  died in preferred place of death in 6 months] > 0, "Green",
			        IF([percentage change PPW  died in preferred place of death in 6 months] < 0, "Red", BLANK())
			    )
			```
		displayFolder: .15Patients died in their preferred place of death
		lineageTag: a8403851-7e96-4e10-9593-db1e565efeba

