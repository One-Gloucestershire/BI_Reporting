	measure Growth_In_Total_Whiteboard_6_months =
			
			VAR CM = calculate(SUM('1.Baselines'[counter]),'REF_Date_Ref'[Latest_Month_Flag] = 1)
			VAR LM = CALCULATE(
			    sum('1.Baselines'[counter]),
			    DATESBETWEEN(
			        'REF_Date_Ref'[date],
			        EDATE(max('1.Baselines'[Census_Date]),-6),
			        EOMONTH(max('1.Baselines'[Census_Date]),-6)
			    )
			
			)
			
			Return
			((CM-LM)/LM)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: .01.Total on whiteboard Metric
		lineageTag: 13ad145c-1bdf-44e1-9c66-16cfa5abcb1a

	measure 'Palliative Care Proportion Change in the last 6 months' =
			
			VAR CM = calculate([% of Total on the whiteboard(01) that are on the pallative care register],'REF_Date_Ref'[Latest_Month_Flag] = 1)
			VAR LM = CALCULATE(
			    [% of Total on the whiteboard(01) that are on the pallative care register],
			    DATESBETWEEN(
			        'REF_Date_Ref'[date],
			        EDATE(max('1.Baselines'[Census_Date]),-6),
			        EOMONTH(max('1.Baselines'[Census_Date]),-6)
			    )
			
			)
			
			Return
			(CM-LM)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: .02.Palliative Care Metric
		lineageTag: 253ae3d6-311c-462e-85d2-4cdc84be5c23

	measure Total_Whiteboard_Arrow = ```
			
			    IF([Growth_In_Total_Whiteboard_6_months] > 0, UNICHAR(9650),
			        IF([Growth_In_Total_Whiteboard_6_months] < 0, UNICHAR(9660), "")
			    )
			```
		displayFolder: .01.Total on whiteboard Metric
		lineageTag: 01b51c55-13ac-426c-a196-f5ba959f67da

	measure Total_Whiteboard_Change_Arrow_Colour = ```
			
			    IF([Growth_In_Total_Whiteboard_6_months] > 0, "Green",
			        IF([Growth_In_Total_Whiteboard_6_months] < 0, "Red", BLANK())
			    )
			```
		displayFolder: .01.Total on whiteboard Metric
		lineageTag: 942f0949-1dd5-4928-9a39-fabc979c9010

