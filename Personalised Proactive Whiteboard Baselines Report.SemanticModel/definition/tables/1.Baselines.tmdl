	measure 'Total on whitebaord - Rolling 3-Month Average' = ```
			
			VAR RollingPeriod =
			    DATESINPERIOD(
			        REF_Date_Ref[Date],
			        MAX(REF_Date_Ref[Date]),
			        -3,
			        MONTH
			    )
			
			VAR DistinctMonths =
			    COUNTROWS(
			        DISTINCT(
			            SELECTCOLUMNS(
			                RollingPeriod,
			                "YearMonth", FORMAT([Date], "YYYY-MM")
			            )
			        )
			    )
			
			VAR TableWithAggregates =
			    ADDCOLUMNS(
			        RollingPeriod,
			        "Total Aggregate", 
			        CALCULATE(SUM('1.Baselines'[In_Cohort_Flag]))
			    )
			
			VAR TotalSum = 
			    SUMX(TableWithAggregates, [Total Aggregate])
			
			RETURN
			
			IF(IF(
			    ISBLANK(MAX(REF_Date_Ref[Date])) || DistinctMonths < 3 || TotalSum < 6,
			    BLANK(),
			    AVERAGEX(TableWithAggregates, [Total Aggregate])
			) <6,BLANK(), --SUPPRESSED
			
			
			IF(
			    ISBLANK(MAX(REF_Date_Ref[Date])) || DistinctMonths < 3 || TotalSum < 6,
			    BLANK(),
			    AVERAGEX(TableWithAggregates, [Total Aggregate])
			)
			)
			```
		displayFolder: .01.Total on whiteboard Metric
		lineageTag: c709157f-4ea0-4356-86b9-6bfbd4c3356e

