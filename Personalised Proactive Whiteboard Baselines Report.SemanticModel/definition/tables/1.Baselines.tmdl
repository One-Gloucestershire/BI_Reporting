	measure Countywide_Wilson_ReSPECT_Confidence_Interval_Lower_Bound = ```
			
			
			VAR Number_of_ReSPECT_Completed = CALCULATE(
			    DISTINCTCOUNT('1.Baselines'[nhs_number])
			, ALL('1.Baselines'[In_Cohort_Flag])
			,all('REF_GP Practice Reference Table')
			,'1.Baselines'[respect_form_flag] = 1)
			
			
			 VAR Total_Population = Calculate(
			    DISTINCTCOUNT('1.Baselines'[nhs_number])
			    ,all('1.Baselines'[In_Cohort_Flag])
			,all('REF_GP Practice Reference Table')
			)
			 
			
			
			 VAR Proportion = DIVIDE(Number_of_ReSPECT_Completed, Total_Population) // Calculating the proportion
			 
			VAR Z_Value = 1.9599639845400500000 // Z-score for 95% confidence level 
			VAR Wilson_Factor = DIVIDE(Z_Value^2, 2 * Total_Population) // Wilson factor for interval adjustment
			 
			VAR Variance_of_Proportion = Proportion * (1 - Proportion) // Variance for the proportion calculation
			 VAR Adjusted_Standard_Error = DIVIDE(Z_Value^2, 4 * Total_Population^2) // Adjustment for small sample sizes
			 VAR Standard_Error = Z_Value * SQRT(DIVIDE(Variance_of_Proportion, Total_Population) + Adjusted_Standard_Error) // Standard error term
			 
			VAR Adjustment_Factor = 1 + DIVIDE(Z_Value^2, Total_Population) // Adjustment factor for Wilson score
			 
			RETURN  
			
			IF(Number_of_ReSPECT_Completed <6,0, --SUPPRESSED
			DIVIDE(Proportion + Wilson_Factor - Standard_Error, Adjustment_Factor)
			)
			
			
			
			```
