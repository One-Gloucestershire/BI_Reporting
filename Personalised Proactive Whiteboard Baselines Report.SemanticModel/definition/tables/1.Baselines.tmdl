	measure 'Confidence Interval Emergency admissions within 90 days in cohort lower bounds' = ```
			
			
			
			VAR CountVariable = [PPW Emergency Admissions within 90 days of death number]
			VAR DenominatorVariable = [Number of PPW deaths in cohort]
			VAR ConfidenceLevel = 95
			VAR ScalingFactor = 1000
			// Approximate the Inverse of the Standard Normal Distribution
			VAR ApproxNORM_INV = 
			IF(
			 ConfidenceLevel = 95, 
			1.9599639845400500, // 95% confidence level
			 IF(
			 ConfidenceLevel = 90, 
			1.645, // 90% confidence level
			 1.28 // 80% confidence level as an example
			 )
			 )
			// Byars Calculation
			RETURN
			IF(CountVariable<6,0,
			
			 IF(
			 CountVariable < 10, 
			IFERROR( (CHISQ.INV(1 - (0.5 + ConfidenceLevel / 200), 2 * CountVariable) / 2),
			 BLANK())
			 
			, CountVariable * (1 - 1 / (9 * CountVariable) - (ApproxNORM_INV / (3 * SQRT(CountVariable))))^3
			 )
			 / DenominatorVariable * ScalingFactor
			
			)
			```
		displayFolder: .14.Emergency admissions within 90 days of death
		lineageTag: 4617dda9-10ed-47a0-8b83-1a1e57b27765

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Confidence interval Emergency admissions within 90 days in cohort upper bound' = ```
			
			
			VAR CountVariable = [PPW Emergency Admissions within 90 days of death number]
			VAR DenominatorVariable = [Number of PPW deaths in cohort]
			VAR ConfidenceLevel = 95
			VAR ScalingFactor = 1000
			// Approximate the Inverse of the Standard Normal Distribution
			VAR ApproxNORM_INV = 
			IF(
			 ConfidenceLevel = 95, 
			1.9599639845400500, // 95% confidence level
			 IF(
			 ConfidenceLevel = 90, 
			1.645, // 90% confidence level
			 1.28 // 80% confidence level as an example
			 )
			 )
			// Byars Calculation for Upper Bound
			RETURN
			IF(CountVariable<6,0,
			IF(
			 CountVariable < 10, 
			iferror( (CHISQ.INV(1 - (0.5 - ConfidenceLevel / 200), 2*CountVariable+2) / 2),
			 BLANK()), 
			(CountVariable + 1) * (1 - 1 / (9 * (CountVariable + 1)) + (ApproxNORM_INV / (3 * SQRT(CountVariable + 1))))^3
			) / DenominatorVariable * ScalingFactor
			)
			```
		displayFolder: .14.Emergency admissions within 90 days of death
		lineageTag: 67fa1d0a-9c4c-4ec2-b4f2-011caa8b4682

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Confidence Intervals Countywide Emergency Admissions within 90 days of death rate per 1000 deaths Upper bounds' = ```
			VAR CountVariable = [Countywide Emergency Admissions within 90 days of death (NUMBER)]
			
			VAR DenominatorVariable = [Countywide Number of deaths in period]
			VAR ConfidenceLevel = 95
			VAR ScalingFactor = 1000
			// Approximate the Inverse of the Standard Normal Distribution
			VAR ApproxNORM_INV = 
			IF(
			 ConfidenceLevel = 95, 
			1.9599639845400500, // 95% confidence level
			 IF(
			 ConfidenceLevel = 90, 
			1.645, // 90% confidence level
			 1.28 // 80% confidence level as an example
			 )
			 )
			// Byars Calculation for Upper Bound
			RETURN
			IF(CountVariable<6,0,
			
			IF(
			 CountVariable < 10, 
			iferror( (CHISQ.INV(1 - (0.5 - ConfidenceLevel / 200), 2*CountVariable+2) / 2),
			 BLANK()), 
			(CountVariable + 1) * (1 - 1 / (9 * (CountVariable + 1)) + (ApproxNORM_INV / (3 * SQRT(CountVariable + 1))))^3
			) / DenominatorVariable * ScalingFactor
			)
			```
		displayFolder: .14.Emergency admissions within 90 days of death
		lineageTag: b805c75d-0b78-4838-865b-83d8f29aa4a8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Confidence Intervals Countywide Emergency Admissions within 90 days of death rate per 1000 deaths lower bounds' = ```
			
			
			VAR CountVariable = [Countywide Emergency Admissions within 90 days of death (NUMBER)]
			VAR DenominatorVariable = [Countywide Number of deaths in period]
			VAR ConfidenceLevel = 95
			VAR ScalingFactor = 1000
			// Approximate the Inverse of the Standard Normal Distribution
			VAR ApproxNORM_INV = 
			IF(
			 ConfidenceLevel = 95, 
			1.9599639845400500, // 95% confidence level
			 IF(
			 ConfidenceLevel = 90, 
			1.645, // 90% confidence level
			 1.28 // 80% confidence level as an example
			 )
			 )
			// Byars Calculation
			RETURN
			IF(CountVariable<6,0,
			
			 IF(
			 CountVariable < 10, 
			IFERROR( (CHISQ.INV(1 - (0.5 + ConfidenceLevel / 200), 2 * CountVariable) / 2),
			 BLANK())
			 
			, CountVariable * (1 - 1 / (9 * CountVariable) - (ApproxNORM_INV / (3 * SQRT(CountVariable))))^3
			 )
			 / DenominatorVariable * ScalingFactor
			
			)
			```
		displayFolder: .14.Emergency admissions within 90 days of death
		lineageTag: cfdf7515-8af4-418b-821e-618ced369b05

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'percentage change Emergency Admissions in cohort in 6 months' = ```
			
			/* Amended 14_02_25 to get the average over the previous 6 months */
			
			VAR CM = calculate([PPW Emergency Admissions within 90 days of death rate per 1000 deaths],'REF_Date_Ref'[Latest_Month_Flag] = 1)
			VAR num_of_deaths = CALCULATE(
			    [Number of PPW deaths in cohort],
			    DATESBETWEEN(
			        'REF_Date_Ref'[date],
			        EDATE(max('1.Baselines'[Census_Date]),-6),
			        EOMONTH(max('1.Baselines'[Census_Date]),-1)
			    )
			 
			
			)
			
			VAR num_of_emg_admissions_90_days_prior_to_death = CALCULATE(
			    [PPW Emergency Admissions within 90 days of death number],
			    DATESBETWEEN(
			        'REF_Date_Ref'[date],
			        EDATE(max('1.Baselines'[Census_Date]),-6),
			        EOMONTH(max('1.Baselines'[Census_Date]),-1)
			    )
			
			
			)
			
			VAR LM = DIVIDE(num_of_emg_admissions_90_days_prior_to_death,num_of_deaths,0)*1000
			
			Return
			
			if([PPW Emergency Admissions within 90 days of death number]<6,0, --suppressed
			
			(CM-LM)/LM 
			
			
			)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: .14.Emergency admissions within 90 days of death
		lineageTag: 3b7af445-b698-449b-84ad-dc44f3280e71

