table '1.Baselines'
	lineageTag: 479de03a-3b56-42da-bd23-b959033d6651

	measure '% of Total on the whiteboard(01) that are on the pallative care register' =
			
			
			if(SUM('1.Baselines'[Palliative_Care_Flag])<6,0,
			
			
			IF(
			    ISBLANK(SUM('1.Baselines'[Palliative_Care_Flag]) / SUM('1.Baselines'[In_Cohort_Flag])),
			    0,
			    SUM('1.Baselines'[Palliative_Care_Flag]) / SUM('1.Baselines'[In_Cohort_Flag])
			)
			
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: .01.Total on whiteboard Metric
		lineageTag: 3ab9bed4-a004-4533-b32b-d2bc17152df5

	measure '% on whiteboard (01) that have a respect plan' =
			
			if(sum('1.Baselines'[respect_form_flag])<6,0,
			
			sum('1.Baselines'[respect_form_flag])/sum([In_Cohort_Flag])
			
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: .03.ResPECT completed metric
		lineageTag: 173cac04-1f5a-4aa6-ad82-c0f9f28781f8

	measure '% with a personalised care plan completed' = ```
			
			
			IF(sum('1.Baselines'[completed_a_personalised_care_and_support_plan_flag])<6,0, --suppressed
			
			sum('1.Baselines'[completed_a_personalised_care_and_support_plan_flag])/sum([In_Cohort_Flag])
			
			) 
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: .08.Completed a PCSP Metric
		lineageTag: 8d8e4ec0-da10-47fa-b9c2-614b864e5560

	measure '% of people with a preferred place of death recorded' =
			
			
			IF(sum('1.Baselines'[Preferred_place_of_death_recorded_flag])<6,0, --SUPPRESED
			sum('1.Baselines'[Preferred_place_of_death_recorded_flag])/SUM('1.Baselines'[In_Cohort_Flag])
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: .11.Preferred Place of Death Recorded Metric
		lineageTag: 8e55af4b-ebe9-4f4d-b07c-f021b37079c1

	measure '% with dementia recorded' =
			if(SUM('1.Baselines'[dementia_flag])<6,0,
			
			IF(ISBLANK(SUM('1.Baselines'[dementia_flag])/SUM([In_Cohort_Flag])),0,SUM('1.Baselines'[dementia_flag])/SUM([In_Cohort_Flag]))
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: .04.Dementia Metric
		lineageTag: 15e83db5-33e6-43bc-b585-791d5c0505c9

	measure '% declined a PCSP' = ```
			
			
			if(sum('1.Baselines'[declined_a_personalised_care_and_support_plan_flag]) <6,0, -- supressed
			if(isblank(sum('1.Baselines'[declined_a_personalised_care_and_support_plan_flag])/sum([In_Cohort_Flag])),0,sum('1.Baselines'[declined_a_personalised_care_and_support_plan_flag])/sum([In_Cohort_Flag])) 
			)
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: .09.Declined a PCSP Metric
		lineageTag: 798a926e-b503-456c-b10b-1c8c7102be72

	measure '% offerred a PCSP' =
			
			
			if(SUM([offered_a_personalised_care_and_support_plan_flag])<6,0, --suppressed
			
			IF(ISBLANK(SUM([offered_a_personalised_care_and_support_plan_flag])/sum([In_Cohort_Flag])),0,SUM([offered_a_personalised_care_and_support_plan_flag])/sum([In_Cohort_Flag]))
			
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: .07.Offered a PCSP Metrics
		lineageTag: 4268f850-b578-4993-aa28-b1db4d1f72fa

	measure '% with cancer (QOF + GSF)' =
			
			
			if(SUM('1.Baselines'[QOF_Cancer_and_GSF_Flag])<6,0, --- suppressed
			
			IF(ISBLANK(SUM('1.Baselines'[QOF_Cancer_and_GSF_Flag])/SUM([In_Cohort_Flag])),0,SUM('1.Baselines'[QOF_Cancer_and_GSF_Flag])/SUM([In_Cohort_Flag]))
			
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: .05.Cancer & QOF Metric
		lineageTag: c3a14241-f3e5-4ba0-9fa2-1bc6bef2a26b

	measure '% with a non-cancer diagnosis (GSF patients)' =
			
			
			
			if(SUM([non_cancer_diagnosis_Flag])<6,0,
			
			IF(ISBLANK(SUM([non_cancer_diagnosis_Flag])/SUM([In_Cohort_Flag])),0,SUM([non_cancer_diagnosis_Flag])/SUM([In_Cohort_Flag]))
			
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: .06.Non Cancer Diagnosis Metric
		lineageTag: 6c610aec-11cd-4928-8dd4-f107f4b79ca6

	measure 'MDT meetings per 1000 whiteboard population' =
			
			
			IF(sum('1.Baselines'[Number_of_MDT_Meetings])<6,0, --suppressed
			
