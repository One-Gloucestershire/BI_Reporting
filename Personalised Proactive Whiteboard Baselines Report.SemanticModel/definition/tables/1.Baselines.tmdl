	measure 'PPW Emergency Admissions within 90 days of death rate per 1000 deaths' = ```
			
			
			
			VAR number_of_emergency_admissions = 
			calculate(sum('1.Baselines'[Number_of_emergency_admissions_within_90_days_of_death])
			,'1.Baselines'[Patient_latest_snapshot_flag] = 1 //only include the last snapshot the patient was in 
			,'1.Baselines'[deceased_flag] = 1
			,'1.Baselines'[In_Cohort_Flag] = 1
			,'1.Baselines'[Appeared_on_PPW_3_consecutive_months_prior_to_death_flag] =1 
			,DATEDIFF('1.Baselines'[Census_Date], '1.Baselines'[Date_of_Death], MONTH) >= 0 &&
			DATEDIFF('1.Baselines'[Census_Date], '1.Baselines'[Date_of_Death], MONTH) <= 1
			,USERELATIONSHIP('1.Baselines'[Date_of_Death],REF_Date_Ref[Date]) // use the inactive relationship to join on date of death
			)
			
			VAR number_of_deaths_in_period =
			calculate(DISTINCTCOUNT('1.Baselines'[nhs_number])
			,'1.Baselines'[Patient_latest_snapshot_flag] = 1 //only include the last snapshot the patient was in 
			,'1.Baselines'[deceased_flag] = 1 //only include deceased patients 
			,'1.Baselines'[In_Cohort_Flag] = 1
			,'1.Baselines'[Appeared_on_PPW_3_consecutive_months_prior_to_death_flag] =1 
			,DATEDIFF('1.Baselines'[Census_Date], '1.Baselines'[Date_of_Death], MONTH) >= 0 &&
			DATEDIFF('1.Baselines'[Census_Date], '1.Baselines'[Date_of_Death], MONTH) <= 1
			,USERELATIONSHIP('1.Baselines'[Date_of_Death],REF_Date_Ref[Date]) // use the inactive relationship to join on date of death
			)
			
			
			RETURN
			if(number_of_emergency_admissions<6,0, -- suppressed
			(number_of_emergency_admissions/number_of_deaths_in_period)*1000
			)
			
			```
		formatString: 0.0
		displayFolder: .14.Emergency admissions within 90 days of death
		lineageTag: cf0d28cd-4dc0-42a9-ac6c-572f0bc10314

	measure 'Countywide Emergency Admissions within 90 days of death rate per 1000 deaths' = ```
			
			
			
			VAR number_of_emergency_admissions = 
			CALCULATE(
			    SUM('1.Baselines'[Number_of_emergency_admissions_within_90_days_of_death]),
			    '1.Baselines'[Patient_latest_snapshot_flag] = 1, // Only include the last snapshot the patient was in
			    '1.Baselines'[deceased_flag] = 1, // Include only deceased patients
			    ALL('1.Baselines'[In_Cohort_Flag]), // Ignore all filters on In_Cohort_Flag
			    ALL('REF_GP Practice Reference Table'), // Ignore all practices 
			    USERELATIONSHIP('1.Baselines'[Date_of_Death], REF_Date_Ref[Date]), // Use the inactive relationship to join on date of death
			    DATEDIFF('1.Baselines'[Census_Date], '1.Baselines'[Date_of_Death], MONTH) >= 0 &&
			    DATEDIFF('1.Baselines'[Census_Date], '1.Baselines'[Date_of_Death], MONTH) <= 1
			)
			
			
			
			VAR number_of_deaths_in_period =
			CALCULATE(
			    DISTINCTCOUNT('1.Baselines'[nhs_number]),
			    '1.Baselines'[Patient_latest_snapshot_flag] = 1, // Only include the last snapshot the patient was in
			    '1.Baselines'[deceased_flag] = 1, // Only include deceased patients
			    ALL('1.Baselines'[In_Cohort_Flag]), // Ignore all filters on In_Cohort_Flag
			    ALL('REF_GP Practice Reference Table'), // Ignore all practices 
			    USERELATIONSHIP('1.Baselines'[Date_of_Death], REF_Date_Ref[Date]), // Use inactive relationship to join on Date of Death
			   DATEDIFF('1.Baselines'[Census_Date], '1.Baselines'[Date_of_Death], MONTH) >= 0 &&
			    DATEDIFF('1.Baselines'[Census_Date], '1.Baselines'[Date_of_Death], MONTH) <= 1
			)
			
			    
			
			
			RETURN
			IF(number_of_emergency_admissions<6,0, -- SUPPRESSED
			(number_of_emergency_admissions/number_of_deaths_in_period)*1000
			)
			```
