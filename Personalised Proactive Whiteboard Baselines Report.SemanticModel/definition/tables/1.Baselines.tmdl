	measure DynamicMetricForSelectedPractice1 = ```
			
			VAR SelectedPractice = VALUES(REF_GP_Practice_1_Comparison[practice_name])
			VAR SelectedMetricDescription = SELECTEDVALUE(Dynamic_Measures_Parameters[Metric Fields])  -- Get the description
			
			RETURN
			    SWITCH(
			        TRUE(),
			        -- Case 1: If the description matches "Total on Whiteboard"
			        SelectedMetricDescription = "'Baselines'[Total on Whiteboard]", 
			        CALCULATE([Total on Whiteboard], 'REF_GP Practice Reference Table'[practice_name] in SelectedPractice),
			
			        -- Case 2: If the description matches "Total identified on Palliative Care"
			        SelectedMetricDescription = "'Baselines'[Total identified on Palliative Care]", 
			        CALCULATE([Total PPW identified on Palliative Care], 'REF_GP Practice Reference Table'[practice_name] IN SelectedPractice),
			        
			        BLANK()  -- Default case if no valid description is selected
			    )
			```
		formatString: 0
		displayFolder: Comparison_graph_measures
		lineageTag: 0bfe98e2-72ae-4b7e-8204-57abeb010337

