	partition REF_LSOA = m
		mode: import
		queryGroup: 'Reference Tables'
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db01_reference"), "select distinct p.lsoacode as ""LSOACode"", p.derived_imdgloucestershiredecile as ""IMDCountyDecile"", case when m.isgloucestershire='Y' then 1 else 0 end as ""LSOA_in_Gloucestershire"" from ccg_reference.vw_lsoa_imd p left join ccg_reference.vw_geographymapping m on m.lsoacode=p.lsoacode where p.lsoacode is not null", null, [EnableFolding=true])
				in
				    Source

