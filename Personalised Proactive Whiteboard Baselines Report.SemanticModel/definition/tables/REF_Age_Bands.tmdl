	partition REF_Age_Bands = m
		mode: import
		queryGroup: 'Reference Tables'
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "CCG_Reference", [Query="#(tab)select *#(lf)#(tab),[5YR_Age_Band_Revised] = case when [5YR_Age_Band] = '5-9' THEN '05-9' ELSE [5YR_Age_Band] end #(lf)#(tab),[Age_group_for_Average_LOS] = case when Age between 0 and 17 then '0-17' #(lf)#(tab)when age between 18 AND 64 then '18-64'#(lf)#(tab)when age >=65 then '65+' end #(lf)#(lf)#(tab),[Age_Group_CAMHS_Adults] = case when Age between 0 and 17 then 'CAMHS(0-17)'  #(lf)#(tab)WHEN Age BETWEEN 18 and 200 then 'Adults(18+)' end#(lf)#(lf)#(lf)#(tab)from CCG_Reference.Reference.vw_AgeBand#(lf)#(lf)#(tab)where Age <= 200#(lf)#(tab)AND Age <> -1#(lf)#(lf)#(tab)ORDER BY Age"])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

