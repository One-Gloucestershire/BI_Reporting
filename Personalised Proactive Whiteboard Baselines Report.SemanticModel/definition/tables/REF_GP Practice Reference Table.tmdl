	partition 'REF_GP Practice Reference Table' = m
		mode: import
		queryGroup: 'Reference Tables'
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "select distinct gp.organisationcode as practice_code, gp.reportingorganisationname as practice_name, gp.reporting_primarycarenetwork as primary_care_network, gp.reporting_locality as ""Locality"", case when gp.organisationcode in (select distinct practice_code from data_mart_powerbi_ageingwell.tbl04_ref_ppw_practice_list) then 'Yes' else 'No' end as ""Using_Whiteboard_Flag"", pl.practice_evaluation_status as ""Practice_Evaluation_Status"" from data_mart_powerbi_dbo.gp_practice_ref as gp left join data_mart_powerbi_ageingwell.tbl04_ref_ppw_practice_list as pl on gp.organisationcode = pl.practice_code where gp.organisationcode in (select distinct practice_code from data_mart_powerbi_ageingwell.tbl01_proactive_whiteboard_cohort)", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

