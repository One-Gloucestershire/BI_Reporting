	column 'Completed days' =
			
			DATEDIFF (
			    '28days_Referrals'[checklist],
			    '28days_Referrals'[decision],
			    DAY
			)
		formatString: 0
		displayFolder: _DAX_Columns
		lineageTag: 98c3bab5-495c-4f71-ba08-f24ea4ffffba
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_ChangedProperties = ["IsHidden"]

	column 'current Outstanding over 12w' =
			
			IF (
			    DATEDIFF (
			        '28days_Referrals'[checklist],
			        TODAY (),
			        DAY
			    ) > ( 12 * 7 )
			        && ISBLANK ( '28days_Referrals'[decision] ),
			    1,
			    0
			)
		formatString: 0
		displayFolder: _DAX_Columns
		lineageTag: 3c89f26c-0c42-4820-8a5a-87e7f9a8be96
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_ChangedProperties = ["IsHidden"]

	column 'MDT assessment Days' =
			
			DATEDIFF (
			    '28days_Referrals'[checklist],
			    '28days_Referrals'[mdtrecommendation],
