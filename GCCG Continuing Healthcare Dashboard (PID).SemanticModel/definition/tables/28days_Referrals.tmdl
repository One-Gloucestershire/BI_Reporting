			)
		formatString: 0
		displayFolder: _DAX_Columns
		lineageTag: 4a61c0bb-9d21-49ae-b2de-2bce9447fadb
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_ChangedProperties = ["IsHidden"]

	column 'Verification Days' =
			
			DATEDIFF (
			    '28days_Referrals'[checklist],
			    '28days_Referrals'[decision],
			    DAY
			)
		formatString: 0
		displayFolder: _DAX_Columns
		lineageTag: ff28e45c-b7ae-47e7-81bf-2f292e726d39
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_ChangedProperties = ["IsHidden"]

	column 'Open Cases exceeding 28days breakdown' =
			
			VAR daysdiff =
			    DATEDIFF (
			        '28days_Referrals'[checklist],
			        TODAY (),
			        DAY
			    ) - 28
			RETURN
			    SWITCH (
			        TRUE,
			        NOT (
			            ISBLANK ( '28days_Referrals'[decision] )
			        ), BLANK (),
			        daysdiff <= 0, BLANK (),
			        daysdiff <= 14, "0-2 weeks (1-14 Days)",
			        daysdiff <= 28, "2-4 weeks (15-28 Days)",
			        daysdiff <= 84, "4-12 weeks (29-84 Days)",
			        daysdiff <= 182, "12-26 weeks (85-182 Days)",
			        "26+ weeks (183+ Days)"
			    )
		displayFolder: _DAX_Columns
		lineageTag: 0457b461-342c-4eff-907d-9fe07168421b
		summarizeBy: none
		sortByColumn: 'Open Cases exceeding 28days Sort'

		annotation SummarizationSetBy = Automatic

		annotation PBI_ChangedProperties = ["SortByColumn"]

	column 'Open Cases exceeding 28days Sort' =
			
			VAR daysdiff =
			    DATEDIFF (
			        '28days_Referrals'[checklist],
			        TODAY (),
			        DAY
			    ) - 28
			RETURN
			    SWITCH (
			        TRUE,
			        NOT (
			            ISBLANK ( '28days_Referrals'[decision] )
			        ), BLANK (),
			        daysdiff <= 0, BLANK (),
			        daysdiff <= 14, 1,
			        daysdiff <= 28, 2,
			        daysdiff <= 84, 3,
			        daysdiff <= 182, 4,
			        5
			    )
		formatString: 0
		displayFolder: _DAX_Columns
		lineageTag: 87ac4c0d-e029-4253-9ab6-ca0ac7a95809
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

