	partition 'Practice Population' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "select practice_code, practice_name, primary_care_network, place, locality, age_band, ""3_year_age_band"", sex, gp_longitude, gp_latitude, population, census_date, year_month, first_date_of_month, last_date_of_month, financial_year, updated_date from data_mart_primarycare.tbl01_gp_practice_populations where age_band in ('65-69','70-74','75-79','80-84','85-89','90-94','95+') order by last_date_of_month desc", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

