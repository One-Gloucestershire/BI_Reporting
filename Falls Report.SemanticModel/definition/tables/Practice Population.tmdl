table 'Practice Population'
	lineageTag: ad8dead0-78f0-4737-aac5-9bea4ca0df60

	measure POP = CALCULATE ( sum('Practice Population'[population]) )
		lineageTag: a05f83da-69ef-4cc9-b1c2-02f665ea1177

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'April Population for Yearly Rate' = CALCULATE ( sum('Practice Population'[population]) , 'Date Table'[Month Name] = "Apr")
		lineageTag: 18536e57-4b5f-4848-bae3-f18bd15f25a0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Current Population' =
			
			
			var max_month = MAX('Practice Population'[last_date_of_month])
			
			RETURN  CALCULATE ( sum('Practice Population'[population]) , 'Practice Population'[last_date_of_month] = max_month)
		lineageTag: 903426a5-8f7d-48a5-8d8c-b0e0e7453499

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Stroud Population' = CALCULATE([Current Population],'GP Reference'[Locality] = "Stroud and Berkeley Vale", REMOVEFILTERS('GP Reference'[ReportingOrganisationName]))
		lineageTag: dd0298f1-5d34-49af-8334-b560d44cc3ed

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Proportion of population within Stroud Locality' = ```
			
			
			
			
			     'Practice Population'[Current Population] / 
			    CALCULATE ( [Current Population], ALL ( 'GP Reference'[ReportingOrganisationName]))
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 42cf8b19-6625-4cb5-83ba-a02f7b598fbc

