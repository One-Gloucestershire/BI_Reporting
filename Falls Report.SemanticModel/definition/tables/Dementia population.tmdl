table 'Dementia population'
	lineageTag: e86a3d24-3a1d-46ba-ae8f-54b3b00ccdd7

	measure 'Dementia Population Summed' = CALCULATE(sum('Dementia population'[COUNTER]),'Dementia population'[Dementia Status]="Dementia")
		formatString: 0
		lineageTag: 2ac36e29-5b82-454c-806c-fae4b7a7a204

	column 'Dementia Status'
		dataType: string
		lineageTag: f02bc1b0-aec0-404f-93d7-ad61564950e4
		summarizeBy: none
		sourceColumn: Dementia Status

		annotation SummarizationSetBy = Automatic

	column COUNTER
		dataType: int64
		formatString: 0
		lineageTag: bbc3f24a-a37b-4d8f-a20d-1233d996b25c
		summarizeBy: sum
		sourceColumn: COUNTER

		annotation SummarizationSetBy = Automatic

	partition 'Dementia population-b9d8bcd3-2eed-4cbb-a321-67071d80bdbb' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "select distinct case when mpi.dementia = 1 then 'Dementia' else 'No dementia' end as ""Dementia Status"", count(mpi.pseudonhsnumber) as ""COUNTER"" from data_mart_pls.vw_summary mpi where mpi.derivedage >= 65 group by 1", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

