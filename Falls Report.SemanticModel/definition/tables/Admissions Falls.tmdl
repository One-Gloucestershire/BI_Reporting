	column 'Admissions YTD' = if('Admissions Falls'[Admissions financial month] <= 'Admissions Falls'[Admissions max financial month], "Year to Date", "Not Year to Date")
		lineageTag: d527e127-53d2-468e-922d-0b8177538f89
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Admissions current year' = ```
			
			VAR max_year = YEAR(MAX('Admissions Falls'[discharge_date]))
			VAR max_month = MONTH(MAX('Admissions Falls'[discharge_date]))
			VAR financial_month = SWITCH(TRUE(),
			max_month = 4, 1,
			max_month = 5, 2,
			max_month = 6, 3,
			max_month = 7, 4,
			max_month = 8, 5,
			max_month = 9, 6,
			max_month = 10, 7,
			max_month = 11, 8,
			max_month = 12, 9,
			max_month = 1, 10,
			max_month = 2, 11,
			max_month = 3, 12
			)
			VAR adjust_year = SWITCH(TRUE(),
			max_month = 1, max_year - 1,
			max_month = 2, max_year - 1,
			max_month = 3, max_year - 1,
			max_month = 4, max_year,
			max_month = 5, max_year,
			max_month = 6, max_year,
			max_month = 7, max_year,
			max_month = 8, max_year,
			max_month = 9, max_year,
			max_month = 10, max_year,
			max_month = 11, max_year,
			max_month = 12, max_year
			)
			return adjust_year
			
			```
		formatString: 0
		lineageTag: ecd2f81f-bc88-4e55-82db-8da4d9721f04
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Admission year adjusted' = ```
			if(
			    [Admissions financial month] = 10, YEAR('Admissions Falls'[discharge_date]) -1, 
			    if([Admissions financial month] = 11, YEAR('Admissions Falls'[discharge_date]) -1, 
			    if([Admissions financial month] = 12, YEAR('Admissions Falls'[discharge_date]) -1, year('Admissions Falls'[discharge_date]))))
			```
		formatString: 0
		lineageTag: b4bafa28-6c13-490f-b407-1862c4dd5347
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

