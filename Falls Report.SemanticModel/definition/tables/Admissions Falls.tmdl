table 'Admissions Falls'
	lineageTag: acb7f50a-86d6-447e-9a94-67d48d4aea43

	measure '% Admitted' =
			CALCULATE(SUM('ED Falls (GHFT Only)'[admitted_flag])
			/
			SUM('ED Falls (GHFT Only)'[counter_ED_falls]))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 89489461-fb58-4a5b-bfd1-5735591de09a

	measure 'Locality Rate Per 1000 Falls Admissions' =
			
			
			VAR ACTIVITY = CALCULATE ( sum('Admissions Falls'[Number of Admissions]))
			VAR POP = CALCULATE ( 'Practice Population'[April Population for Yearly Rate], ALLEXCEPT ('Date Table', 'Date Table'[Financial Year] ) )
			
			RETURN (ACTIVITY/POP*1000)
		lineageTag: de939e67-7438-4036-b01b-b68110a8babb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure count_of_pop_PCN = count('Place Population'[Primary Care Network])
		formatString: 0
		lineageTag: 950fa3db-f9da-412b-9fd2-416af17be761

	measure count_of_ED_PCN = count('ED Falls (GHFT Only)'[primary_care_network])
		formatString: 0
		lineageTag: a2da525d-e1ca-4211-9afd-ee8642c629aa

	measure ed_PCN_rate_per_1000 = ('Admissions Falls'[count_of_ED_PCN]/'Admissions Falls'[count_of_pop_PCN]) * 1000
		lineageTag: 7314adef-40cf-4471-8899-373c2c60617f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Previous Year ED Admissions' = CALCULATE(sum('Admissions Falls'[Number of Admissions]), 'Admissions Falls'[Admission year adjusted] = 'Admissions Falls'[Admissions previous year])
		formatString: 0
		lineageTag: 36c76f91-593d-43d1-bed6-02e475cd6cc6

	measure 'Comparison Previous YTD ED Admissions' = CALCULATE(sum('Admissions Falls'[Number of Admissions]), 'Admissions Falls'[Admission year adjusted] = 'Admissions Falls'[Admissions previous year] && 'Admissions Falls'[Admissions YTD] = "Year to Date")
		formatString: 0
		lineageTag: b4e18ade-075a-4535-a705-8233205255c1

	measure 'Current Year ED Admissions' = CALCULATE(sum('Admissions Falls'[Number of Admissions]), 'Admissions Falls'[Admission year adjusted] = 'Admissions Falls'[Admissions current year])
		formatString: 0
		lineageTag: 5ea82a9e-648d-4e25-854b-95cb91b5ec02

	measure 'Dementia rate per 1000' = sum('Admissions Falls'[Number of Admissions])/sum('Dementia population'[COUNTER])*1000
		lineageTag: 9562dba0-9f62-41b5-b079-72e83a98fa9d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Frailty rate per 1000' = sum('Admissions Falls'[Number of Admissions])/sum('Frail population'[COUNTER])*1000
		lineageTag: 47d3649f-edc6-4ceb-9ac9-452a942e23b7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Care home rate per 1000' = sum('Admissions Falls'[Number of Admissions])/sum('Care home population'[COUNTER])*1000
		lineageTag: 2432e685-b1ce-49a5-be4b-35c6fbb80979

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Died in hospital %' = sum('Admissions Falls'[Died in hospital flag])/sum('Admissions Falls'[Number of Admissions])*100
		lineageTag: 0729ef87-4412-4db3-b1c9-def79c5bf4b3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cheltenham Rate Per 1000' =
			(calculate(sum('Admissions Falls'[Number of Admissions]),'Admissions Falls'[locality]="Cheltenham")
			/CALCULATE(sum('Place Population'[Population]),'Place Population'[Locality]="Cheltenham"))*1000
		lineageTag: d68a795a-aa69-406e-a8c4-308732e9ce8f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

