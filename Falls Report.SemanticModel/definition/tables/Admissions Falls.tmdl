	measure 'Deaths 30 Days After Admission' = calculate(count('Admissions Falls'[Number of Admissions]),FILTER('Admissions Falls',[death_in_days_from_admission]<31&&'Admissions Falls'[mortality_flag]="Deceased"))
		formatString: 0
		lineageTag: 92e7e68a-8561-4cd7-91d1-4231c767ac99

	measure 'Deaths 90 Days After Admission' = countrows(FILTER('Admissions Falls',[death_in_days_from_admission]<91&&'Admissions Falls'[mortality_flag]="Deceased"))
		formatString: 0
		lineageTag: 50a756d3-37c4-472a-8cd0-8c008bced26e

	measure 'Admissions with death after 90 Days After Discharge or No Death' = countrows(FILTER('Admissions Falls',[death_in_days_from_discharge]>90||'Admissions Falls'[mortality_flag]="Alive"))
		formatString: 0
		lineageTag: b87e87a8-5c1b-497e-b679-0383a22e81bb

	measure '% #FNOF' = ```
			
			divide(
			    CALCULATE(
				SUM('Admissions Falls'[Number of Admissions]),
				'Admissions Falls'[icd_10_description] IN { "S720 Fracture of Neck of Femur"  })
			    ,sum('Admissions Falls'[Number of Admissions]))
			
			
			
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 002c2e33-9931-4fe0-b197-3b9de930bbc1

	measure Max_Admissions_Date = ```
			CALCULATE(MAX('Date Table'[Date]),FILTER('Admissions Falls',[discharge_date]))
			
			 
			```
		formatString: General Date
		lineageTag: f805e40b-b810-4cbb-9b84-44c046135fbb

	measure Min_Admissions_Date = ```
			CALCULATE(MIN('Date Table'[Date]),FILTER('Admissions Falls',[discharge_date]))
			
			```
		formatString: General Date
		lineageTag: 4a3600c6-e0f1-44cc-8a39-cad808a1886f

	measure Number_of_days_admissions = DATEDIFF('Admissions Falls'[Min_Admissions_Date],'Admissions Falls'[Max_Admissions_Date],DAY)
		formatString: 0
		lineageTag: b7d6127d-f499-48a3-a3d4-9b96b7aa42ac

	measure Average_admission_falls_per_day =
			
			AVERAGEX(
				KEEPFILTERS(VALUES('Date Table'[DayMonthYear])),
				CALCULATE(SUM('Admissions Falls'[Number of Admissions]))
			)
		lineageTag: 0ff496c8-54a0-4904-9b94-d8c8650ac4e3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'MH Home Rate Per 1000' =
			(calculate(sum('Admissions Falls'[Number of Admissions]),'Admissions Falls'[Care_home_status]="Mental Health")
			/CALCULATE(sum('Care home population'[COUNTER]),'Care home population'[Care_home_status]="Mental Health"))*1000
		lineageTag: 12bbbedf-6734-4b9c-8247-b7c3bd2568dc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Median LOS' = MEDIAN('Admissions Falls'[length_of_stay])
		lineageTag: 39963f9e-6925-4a61-94df-a5710c6e4a29

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Over/Under YTD Comparison Admissions' = ('Admissions Falls'[Current Year ED Admissions] - 'Admissions Falls'[Comparison Previous YTD ED Admissions]) / 'Admissions Falls'[Comparison Previous YTD ED Admissions]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: f977b5a1-381b-4a20-84fe-fcbf8b10ebed

	measure 'New rate per 1000 monthly' =
			
			
			VAR activity = CALCULATE(SUM('Admissions Falls'[Number of Admissions]))
			
			VAR POP = CALCULATE ( sum('Practice Population'[population]) )
			
			RETURN activity/pop*1000
		lineageTag: c13e0878-3094-450a-8c6a-cd3ccb2f3b00

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'New rate per 1000 yearly' =
			
			
			VAR activity = CALCULATE(SUM('Admissions Falls'[Number of Admissions]))
			
			VAR POP = CALCULATE ( sum('Practice Population'[population]),'Date Table'[Month Name] IN {"Apr"}  ,ALLEXCEPT('Date Table','Date Table'[Financial Year]))
			
			RETURN IFERROR(activity/pop*1000, BLANK())
		formatString: 0
		lineageTag: 7932de80-c26b-4a7a-b5f4-f26945c27cfd

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Care Home Admissions' = CALCULATE(SUM('Admissions Falls'[Number of Admissions]), 'Admissions Falls'[Care_home_status] <> "Not Living in a Care Home")
		formatString: 0
		lineageTag: 235dd8cf-9513-41aa-ba8b-c5b28304bff2

	measure 'Non-Care Home Admissions' = CALCULATE(SUM('Admissions Falls'[Number of Admissions]), 'Admissions Falls'[Care_home_status] = "Not Living in a Care Home")
		formatString: 0
		lineageTag: 048eb739-e405-414e-a7e2-ed5b90bf64bf

	measure '% Care Home Admissions' = [Care Home Admissions] / SUM('Admissions Falls'[Number of Admissions])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f28039a9-5751-4773-b968-e36f28e21d4b

	measure 'Gloucestershire Rate Per 1000 Falls Admissions' =
			
			
			VAR ACTIVITY = CALCULATE ( sum('Admissions Falls'[Number of Admissions]),ALL('GP Reference'))
			VAR POP = CALCULATE ( 'Practice Population'[April Population for Yearly Rate], ALLEXCEPT ('Date Table', 'Date Table'[Financial Year] ) ,ALL('GP Reference'))
			
			RETURN ACTIVITY/POP*1000
		lineageTag: f67f6f66-31b6-4309-a7b2-67d52813a073

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gloucestershire Falls Admissions' =
			
			
			VAR ACTIVITY = CALCULATE ( sum('Admissions Falls'[Number of Admissions]),ALL('GP Reference'))
			
			RETURN ACTIVITY
		formatString: 0
		lineageTag: 9cc070b2-9b8a-4694-b0fa-d91bdfcd9dfa

	measure '% #FNOF Glocuestershire' = ```
			
			divide(
			    CALCULATE(
				SUM('Admissions Falls'[Number of Admissions]),
				'Admissions Falls'[icd_10_description] IN { "S720 Fracture of Neck of Femur"  },all('GP Reference'))
			    ,CALCULATE(sum('Admissions Falls'[Number of Admissions]),ALL('GP Reference')))
			
			
			
			```
		lineageTag: b748ae4f-978a-4e46-b3ff-304d7d7834e2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

