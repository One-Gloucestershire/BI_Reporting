	column 'Admissions max financial month' = ```
			
			VAR currmonth = MONTH(MAX('Admissions Falls'[discharge_date]))
			VAR cal = SWITCH(TRUE(),
			currmonth = 4, 1,
			currmonth = 5, 2,
			currmonth = 6, 3,
			currmonth = 7, 4,
			currmonth = 8, 5,
			currmonth = 9, 6,
			currmonth = 10, 7,
			currmonth = 11, 8,
			currmonth = 12, 9,
			currmonth = 1, 10,
			currmonth = 2, 11,
			currmonth = 3, 12
			)
			return cal
			
			```
		formatString: 0
		lineageTag: 1f15623e-d77f-4dc0-a8b7-e4b42e4fe63d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Admissions financial month' = ```
			
			VAR currmonth = MONTH('Admissions Falls'[discharge_date])
			VAR cal = SWITCH(TRUE(),
			currmonth = 4, 1,
			currmonth = 5, 2,
			currmonth = 6, 3,
			currmonth = 7, 4,
			currmonth = 8, 5,
			currmonth = 9, 6,
