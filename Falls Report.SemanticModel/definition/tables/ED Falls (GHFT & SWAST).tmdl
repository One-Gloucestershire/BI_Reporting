	column 'ED GHFT & SWAST YTD' = ```
			if('ED Falls (GHFT & SWAST)'[ED & SWAST financial month] <= 'ED Falls (GHFT & SWAST)'[ED & SWAST max financial month], "Year to Date", "Not Year to Date")
			
			```
		lineageTag: 36d9f666-0f5d-482e-9b45-ca99de47ac23
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'ED GHFT & SWAST current year' = ```
			
			VAR max_year = YEAR(MAX('ED Falls (GHFT & SWAST)'[arrival_date]))
			VAR max_month = MONTH(MAX('ED Falls (GHFT & SWAST)'[arrival_date]))
			VAR financial_month = SWITCH(TRUE(),
			max_month = 4, 1,
			max_month = 5, 2,
			max_month = 6, 3,
			max_month = 7, 4,
			max_month = 8, 5,
			max_month = 9, 6,
			max_month = 10, 7,
			max_month = 11, 8,
			max_month = 12, 9,
			max_month = 1, 10,
			max_month = 2, 11,
			max_month = 3, 12
			)
			VAR adjust_year = SWITCH(TRUE(),
			max_month = 1, max_year - 1,
			max_month = 2, max_year - 1,
			max_month = 3, max_year - 1,
			max_month = 4, max_year,
			max_month = 5, max_year,
			max_month = 6, max_year,
			max_month = 7, max_year,
			max_month = 8, max_year,
			max_month = 9, max_year,
			max_month = 10, max_year,
			max_month = 11, max_year,
			max_month = 12, max_year
			)
			return adjust_year
			
			```
		formatString: 0
		lineageTag: 0253030e-1307-45fc-ae5d-7ab62a3102c0
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'ED GHFT & SWAST year adjusted' = ```
			if(
			    'ED Falls (GHFT & SWAST)'[ED & SWAST financial month] = 10, YEAR('ED Falls (GHFT & SWAST)'[arrival_date]) -1, 
			    if('ED Falls (GHFT & SWAST)'[ED & SWAST financial month] = 11, YEAR('ED Falls (GHFT & SWAST)'[arrival_date]) -1, 
			    if('ED Falls (GHFT & SWAST)'[ED & SWAST financial month]= 12, YEAR('ED Falls (GHFT & SWAST)'[arrival_date]) -1, year('ED Falls (GHFT & SWAST)'[arrival_date]))))
			
			
			
			```
		formatString: 0
		lineageTag: bf7c7e0d-454e-4578-b4d2-9bc854651dd5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'ED GHFT & SWAST previous year' = ```
