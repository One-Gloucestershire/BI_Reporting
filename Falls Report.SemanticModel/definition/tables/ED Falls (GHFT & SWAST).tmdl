	measure 'NULL Diagnosis Attendances (GHFT & SWAST)' = ```
			
			CALCULATE(
				SUM('ED Falls (GHFT & SWAST)'[counter]),
				ISBLANK('ED Falls (GHFT & SWAST)'[Diagnosis_1]) 
			)
			```
		formatString: 0
		lineageTag: 1f1fd5a2-8d71-4653-87cf-52988c88d410

	measure 'Non-NULL Diagnosis Attendances (GHFT & SWAST)' =
			
			SUM('ED Falls (GHFT & SWAST)'[counter]) - [NULL Diagnosis Attendances (GHFT & SWAST)]
		formatString: 0
		lineageTag: ef45c817-51a6-48b0-a01a-26b81340a264

	measure 'Non-Injury Attendances (GHFT & SWAST)' =
			
			CALCULATE(
				SUM('ED Falls (GHFT & SWAST)'[counter]),
				'ED Falls (GHFT & SWAST)'[Injury Flag] = "No")
		formatString: 0
		lineageTag: a047c23e-4c98-4fd7-8e1c-eb811db57338

	measure '% Non-Injury Attendances (GHFT & SWAST)' =
			
			calculate('ED Falls (GHFT & SWAST)'[Non-Injury Attendances (GHFT & SWAST)]
			/
			'ED Falls (GHFT & SWAST)'[Non-NULL Diagnosis Attendances (GHFT & SWAST)])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 25899529-efa7-4b6f-a925-a432066380f7

	measure 'Average_attendance_falls_per_day (GHFT & SWAST)' =
			
			AVERAGEX(
				KEEPFILTERS(VALUES('Date Table'[DayMonthYear])),
				CALCULATE(SUM('ED Falls (GHFT & SWAST)'[counter]))
			)
		formatString: 0.0
		lineageTag: c5392dfa-8dee-45d0-b99f-135d5512af2d

	measure 'Previous Year ED Falls (GHFT & SWAST)' = CALCULATE(sum('ED Falls (GHFT & SWAST)'[counter]),'ED Falls (GHFT & SWAST)'[ED GHFT & SWAST year adjusted] = 'ED Falls (GHFT & SWAST)'[ED GHFT & SWAST previous year])
		formatString: 0
		lineageTag: 7fe84757-da89-4e91-ac01-0d52b33f72e3

	measure 'Current Year ED Falls (GHFT & SWAST)' = CALCULATE(sum('ED Falls (GHFT & SWAST)'[counter]), 'ED Falls (GHFT & SWAST)'[ED GHFT & SWAST year adjusted] = 'ED Falls (GHFT & SWAST)'[ED GHFT & SWAST current year])
		formatString: 0
		lineageTag: 5b296af2-9565-4237-b72a-e5d547b57a94

	measure 'Comparison previous YTD ED Falls (GHFT & SWAST)' = CALCULATE(sum('ED Falls (GHFT & SWAST)'[counter]),'ED Falls (GHFT & SWAST)'[ED GHFT & SWAST year adjusted] = 'ED Falls (GHFT & SWAST)'[ED GHFT & SWAST previous year] && 'ED Falls (GHFT & SWAST)'[ED GHFT & SWAST YTD] = "Year to Date")
		formatString: 0
		lineageTag: 817b9752-244e-4918-b5d7-5523f9544242

	measure 'Average_attendance_non-admitted_falls_per_day (GHFT & SWAST)' =
			
			AVERAGEX(
				KEEPFILTERS(VALUES('Date Table'[DayMonthYear])),
				CALCULATE(SUM('ED Falls (GHFT & SWAST)'[admitted_flag]))
			)
		lineageTag: a0238700-956b-4bb2-8688-15eb343e810b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average_non-injurious_falls_per_day (GHFT & SWAST)' = ```
			
			AVERAGEX(
				KEEPFILTERS(VALUES('Date Table'[DayMonthYear])),
				'ED Falls (GHFT & SWAST)'[Non-Injury Attendances (GHFT & SWAST)])
			
			```
		lineageTag: 73ed579a-af4e-4925-8611-823c55c8714b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Over/Under YTD Comparison ED GHFT & SWAST' = ```
			('ED Falls (GHFT & SWAST)'[Current Year ED Falls (GHFT & SWAST)] - 'ED Falls (GHFT & SWAST)'[Comparison previous YTD ED Falls (GHFT & SWAST)]) / 'ED Falls (GHFT & SWAST)'[Comparison previous YTD ED Falls (GHFT & SWAST)] 
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 34de9708-bfa1-4cb4-b665-92c8fa1547e9

	measure '% of Chief Complaints' = ```
			SUM('ED Falls (GHFT & SWAST)'[counter]) / CALCULATE(SUM('ED Falls (GHFT & SWAST)'[counter]) , ALLSELECTED('ED Falls (GHFT & SWAST)'[Chief_Complaint_translated])) 
			
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8c34f14d-b04e-41b4-ba7a-0565e2dcca36

	measure 'Gloucestershire Rate Per 1000 Falls Attendances' =
			
			
			VAR ACTIVITY = CALCULATE ( sum('ED Falls (GHFT & SWAST)'[counter]),ALL('GP Reference'))
			VAR POP = CALCULATE ( 'Practice Population'[April Population for Yearly Rate], ALLEXCEPT ('Date Table', 'Date Table'[Financial Year] ) ,ALL('GP Reference'))
			
			RETURN ACTIVITY/POP*1000
		lineageTag: c9ca9f50-5a29-43f2-8973-b8c7856666ab

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gloucestershire Falls Attendances' =
			
			
			VAR ACTIVITY = CALCULATE ( sum('ED Falls (GHFT & SWAST)'[counter]),ALL('GP Reference'))
			
			RETURN ACTIVITY
		formatString: 0
		lineageTag: f56e6c32-4659-4d49-b734-324d3402948b

