table 'SWAST All Years Falls'
	lineageTag: 66be301b-33be-49d5-85b7-c422b43d4ea0

	measure 'Number of Injury Falls (All Years)' = ```
			
			CALCULATE(
				SUM('SWAST All Years Falls'[counter_column]),
				'SWAST All Years Falls'[Incident_Colour] IN { "Category 1", "Category 2" } 
			)
			```
		formatString: 0
		lineageTag: 1f37b24f-1f3f-4676-b554-d6e55698482e

	measure '% Non-Injury Calls (All Years)' =
			
			CALCULATE('SWAST All Years Falls'[Number of Injury Falls (All Years)])
			/
			SUM('SWAST All Years Falls'[counter_column])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 4df431ea-7ea6-478b-879a-7036d6f79f89

	measure 'Average SWAST Calls per Day (All Years)' =
			
			AVERAGEX(
				KEEPFILTERS(VALUES('Date Table'[DayMonthYear])),
				CALCULATE(SUM('SWAST All Years Falls'[counter_column]))
			)
		formatString: 0.0
		lineageTag: 1d8f5575-3bc8-4953-8298-ebcf9c778cd4

	measure 'Non-injurious SWAST Calls' =
			
			CALCULATE(
				SUM('SWAST All Years Falls'[counter_column]),
				'SWAST All Years Falls'[Incident_Colour] IN {
					"Category 4",
					"Category 4 999",
					"Category 3",
					"Category 4 HCP 120",
					"Category 5",
					"HCP Level 3",
					"HCP Level 4",
					"IFT Level 3"
				}
			)
		formatString: 0
		lineageTag: 47b09694-e4e4-407e-97be-5f710a414638

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "FilteredMeasure"
				}

		changedProperty = FormatString

	measure 'Average Non-Injurious SWAST Calls per Day (All Years)' =
			
			AVERAGEX(
				KEEPFILTERS(VALUES('Date Table'[DayMonthYear])),
				CALCULATE(
				SUM('SWAST All Years Falls'[counter_column]),
				'SWAST All Years Falls'[Incident_Colour] IN {
					"Category 4",
					"Category 4 999",
					"Category 3",
					"Category 4 HCP 120",
					"Category 5",
					"HCP Level 3",
					"HCP Level 4",
					"IFT Level 3"
				}
			)
			)
		lineageTag: 33a5b90a-3cf8-4a41-9d40-ffd356c20f3a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Previous year SWAT calls' = CALCULATE(sum('SWAST All Years Falls'[counter_column]),'SWAST All Years Falls'[SWAST year adjusted] = 'SWAST All Years Falls'[SWAST previous year])
		formatString: 0
		lineageTag: 4a140a84-4654-49d8-b64f-6f777976435f

	measure 'Comparison Previous YTD all calls comparison' = CALCULATE(sum('SWAST All Years Falls'[counter_column]),'SWAST All Years Falls'[SWAST year adjusted] = 'SWAST All Years Falls'[SWAST previous year] && 'SWAST All Years Falls'[SWAST YTD] = "Year to Date")
		formatString: 0
		lineageTag: fd3c5f16-5bcd-4e6e-9d26-4621d51934fd

	measure 'Current Year SWAST calls' = ```
			CALCULATE(sum('SWAST All Years Falls'[counter_column]),'SWAST All Years Falls'[SWAST year adjusted] = 'SWAST All Years Falls'[SWAST current year])
			
			```
		formatString: 0
		lineageTag: 5aac9d9e-a4c9-412e-8fc4-077e5e46ba3d

	measure '% Over/Under YTD Comparison SWAST Calls' = ('SWAST All Years Falls'[Current Year SWAST calls] - 'SWAST All Years Falls'[Comparison Previous YTD all calls comparison]) / 'SWAST All Years Falls'[Comparison Previous YTD all calls comparison]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 057d63d8-0a73-47b1-a8a4-8f889b24de6b

	measure 'SWAST Calls Rate per 1000 Yearly' =
			
			VAR Activity = CALCULATE ( SUM ('SWAST All Years Falls'[counter_column]))
			VAR POP = CALCULATE ('Practice Population'[April Population for Yearly Rate])
			RETURN (Activity/POP*1000)
		lineageTag: 2f9d268b-0e55-464d-8205-b7530e54adb9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SWAST Calls Rate per 1000 Monthly' =
			
			VAR Activity = CALCULATE ( SUM ('SWAST All Years Falls'[counter_column] ))
			VAR POP = CALCULATE(SUM('Practice Population'[population]))
			RETURN (Activity/POP*1000)
		lineageTag: 54dac64f-af18-46df-b080-cfef8a41faaf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

