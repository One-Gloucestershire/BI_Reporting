	column 'SWAST max financial month' =
			
			VAR currmonth = MONTH(MAX('SWAST All Years Falls'[dateofincident]))
			VAR cal = SWITCH(TRUE(),
			currmonth = 4, 1,
			currmonth = 5, 2,
			currmonth = 6, 3,
			currmonth = 7, 4,
			currmonth = 8, 5,
			currmonth = 9, 6,
			currmonth = 10, 7,
			currmonth = 11, 8,
			currmonth = 12, 9,
			currmonth = 1, 10,
			currmonth = 2, 11,
			currmonth = 3, 12
			)
			return cal
		formatString: 0
		lineageTag: e42dda29-482b-4d88-8a70-c12a478b316f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'SWAST financial month' =
			
			VAR currmonth = MONTH('SWAST All Years Falls'[dateofincident])
			VAR cal = SWITCH(TRUE(),
			currmonth = 4, 1,
			currmonth = 5, 2,
			currmonth = 6, 3,
			currmonth = 7, 4,
			currmonth = 8, 5,
			currmonth = 9, 6,
			currmonth = 10, 7,
			currmonth = 11, 8,
			currmonth = 12, 9,
			currmonth = 1, 10,
			currmonth = 2, 11,
			currmonth = 3, 12
			)
			return cal
		formatString: 0
		lineageTag: 85a8f9fe-5304-4223-aeae-b9589c5e6e57
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'SWAST YTD' = IF('SWAST All Years Falls'[SWAST financial month] <= 'SWAST All Years Falls'[SWAST max financial month], "Year to Date", "Not Year to Date")
		lineageTag: 86a8cc6f-81d4-4634-b0f5-a969fbc42525
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'SWAST current year' = ```
			
			VAR max_year = YEAR(MAX('SWAST All Years Falls'[dateofincident]))
			VAR max_month = MONTH(MAX('SWAST All Years Falls'[dateofincident]))
			VAR financial_month = SWITCH(TRUE(),
			max_month = 4, 1,
			max_month = 5, 2,
			max_month = 6, 3,
			max_month = 7, 4,
			max_month = 8, 5,
			max_month = 9, 6,
			max_month = 10, 7,
			max_month = 11, 8,
			max_month = 12, 9,
			max_month = 1, 10,
			max_month = 2, 11,
			max_month = 3, 12
			)
			VAR adjust_year = SWITCH(TRUE(),
			max_month = 1, max_year - 1,
			max_month = 2, max_year - 1,
			max_month = 3, max_year - 1,
			max_month = 4, max_year,
			max_month = 5, max_year,
			max_month = 6, max_year,
			max_month = 7, max_year,
			max_month = 8, max_year,
			max_month = 9, max_year,
			max_month = 10, max_year,
			max_month = 11, max_year,
			max_month = 12, max_year
			)
			return adjust_year
			
			```
		formatString: 0
		lineageTag: b88397ba-5456-44b7-a46a-65346719ea6c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'SWAST year adjusted' = ```
			if(
			    'SWAST All Years Falls'[SWAST financial month] = 10, YEAR('SWAST All Years Falls'[dateofincident]) -1, 
			    if('SWAST All Years Falls'[SWAST financial month]  = 11, YEAR('SWAST All Years Falls'[dateofincident]) -1, 
			    if('SWAST All Years Falls'[SWAST financial month] = 12, YEAR('SWAST All Years Falls'[dateofincident]) -1, year('SWAST All Years Falls'[dateofincident]))))
			
			```
		formatString: 0
		lineageTag: db399eee-cc5c-4121-b356-de3985e020bb
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'SWAST previous year' = ```
			'SWAST All Years Falls'[SWAST current year]- 1
			
			```
		formatString: 0
		lineageTag: bf8c474e-8984-4dbb-adc5-d4f669f48641
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

