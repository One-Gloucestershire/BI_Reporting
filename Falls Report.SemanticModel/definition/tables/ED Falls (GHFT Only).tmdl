	measure 'Attendance Rate per 1000' =
			
			
			VAR ACTIVITY = CALCULATE ( sum('ED Falls (GHFT Only)'[counter_ED_falls]))
			VAR POP = CALCULATE ( 'Practice Population'[April Population for Yearly Rate], ALLEXCEPT ('Date Table', 'Date Table'[Financial Year] ) )
			
			RETURN (ACTIVITY/POP*1000)
		lineageTag: 7639067e-cdda-4d70-a1bf-33fdaf3244f8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

