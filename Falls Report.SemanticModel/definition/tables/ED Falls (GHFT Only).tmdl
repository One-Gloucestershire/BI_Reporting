	measure 'Non-Injury Attendances' =
			
			CALCULATE(
				SUM('ED Falls (GHFT Only)'[counter_ED_falls]),
				'ED Falls (GHFT Only)'[Treatment_all] IN { "Patient given written advice", "Review of medication", "Cardiac monitor surveillance", "Treatment not indicated"  }
			)
		lineageTag: 8cddc119-c487-4c1d-a9ac-c433d7ac1ace

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "FilteredMeasure"
				}

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Min_Attendance_Date = CALCULATE(MIN('Date Table'[Date]),FILTER('ED Falls (GHFT Only)',[arrival_date]))
		formatString: General Date
		lineageTag: 6c2ec041-2aab-4846-ad06-e1c5d8e4b24c

	measure Max_Attendance_Date = CALCULATE(MAX('Date Table'[Date]),FILTER('ED Falls (GHFT Only)',[arrival_date]))
		formatString: General Date
		lineageTag: e158bd6b-773f-4f98-a94b-cd57ebc4ff9f

	measure Number_of_days_attendance = DATEDIFF('ED Falls (GHFT Only)'[Min_Attendance_Date],'ED Falls (GHFT Only)'[Max_Attendance_Date],DAY)
		formatString: 0
		lineageTag: 9ca08798-1e0c-48d6-9deb-8c3ca9853acc

	measure Average_attendance_falls_per_day =
			
			AVERAGEX(
				KEEPFILTERS(VALUES('Date Table'[DayMonthYear])),
				CALCULATE(SUM('ED Falls (GHFT Only)'[counter_ED_falls]))
			)
		formatString: 0.0
		lineageTag: 83427db9-478c-4bd7-8437-a013e9931103

		extendedProperty MeasureTemplate =
				{
