	measure 'Previous Year ED Falls' = CALCULATE(sum('ED Falls (GHFT Only)'[counter_ED_falls]),'ED Falls (GHFT Only)'[ED GHFT year adjusted] = 'ED Falls (GHFT Only)'[ED GHFT previous year])
