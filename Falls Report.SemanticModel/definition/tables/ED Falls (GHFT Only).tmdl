	measure '% Over/Under YTD Comparison' = ```
			('ED Falls (GHFT Only)'[Current Year ED Falls] - 'ED Falls (GHFT Only)'[Comparison to previous YTD ED Falls]) / 'ED Falls (GHFT Only)'[Comparison to previous YTD ED Falls] 
