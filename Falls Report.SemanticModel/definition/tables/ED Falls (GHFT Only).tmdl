	column 'ED GHFT YTD' = ```
			if('ED Falls (GHFT Only)'[ED financial month] <= 'ED Falls (GHFT Only)'[ED GHFT max financial month], "Year to Date", "Not Year to Date")
			
			```
		lineageTag: b879308b-9d9c-4aa4-a9a7-7e4b486cc48a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'ED GHFT current year' = ```
			
			VAR max_year = YEAR(MAX('ED Falls (GHFT Only)'[arrival_date]))
			VAR max_month = MONTH(MAX('ED Falls (GHFT Only)'[arrival_date]))
			VAR financial_month = SWITCH(TRUE(),
			max_month = 4, 1,
			max_month = 5, 2,
			max_month = 6, 3,
			max_month = 7, 4,
			max_month = 8, 5,
			max_month = 9, 6,
			max_month = 10, 7,
			max_month = 11, 8,
			max_month = 12, 9,
			max_month = 1, 10,
			max_month = 2, 11,
			max_month = 3, 12
			)
			VAR adjust_year = SWITCH(TRUE(),
			max_month = 1, max_year - 1,
			max_month = 2, max_year - 1,
			max_month = 3, max_year - 1,
			max_month = 4, max_year,
			max_month = 5, max_year,
			max_month = 6, max_year,
			max_month = 7, max_year,
			max_month = 8, max_year,
			max_month = 9, max_year,
			max_month = 10, max_year,
			max_month = 11, max_year,
			max_month = 12, max_year
			)
			return adjust_year
			
			```
		formatString: 0
		lineageTag: 6f38b479-6549-41b5-8018-28cc82f6d22c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'ED GHFT year adjusted' = ```
			if(
			    'ED Falls (GHFT Only)'[ED financial month] = 10, YEAR('ED Falls (GHFT Only)'[arrival_date]) -1, 
			    if('ED Falls (GHFT Only)'[ED financial month] = 11, YEAR('ED Falls (GHFT Only)'[arrival_date]) -1, 
			    if('ED Falls (GHFT Only)'[ED financial month] = 12, YEAR('ED Falls (GHFT Only)'[arrival_date]) -1, year('ED Falls (GHFT Only)'[arrival_date]))))
			
			```
		formatString: 0
		lineageTag: 3d701930-9272-4420-a5d7-e793301d9365
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'ED GHFT previous year' = ```
