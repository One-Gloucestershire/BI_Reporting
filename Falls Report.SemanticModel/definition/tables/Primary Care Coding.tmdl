	partition 'Primary Care Coding' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "select pseudonhsnumber as ""PseudoNHSNumber"", reportingorganisationname as ""ReportingOrganisationName"", primarycarenetwork as ""PrimaryCareNetwork"", locality as ""Locality"", organisationcode as ""OrganisationCode"", eventdate as ""EventDate"", eventcode as ""EventCode"", snomedcode as ""SnomedCode"", snomedcodedescription as ""SnomedCodeDescription"", value1 as ""Value1"" from data_mart_powerbi_falls.tbl11_primarycarecoding", null, [EnableFolding=true]),
				    #"Added Conditional Column" = Table.AddColumn(Source, "Falls Assessment Template Related Code", each if [SnomedCodeDescription] = "Falls risk assessment complete" then "Falls Assessment Template Code" else if [SnomedCodeDescription] = "Falls risk assessment refused" then "Falls Assessment Template Code" else if [SnomedCodeDescription] = "Does not fall" then "Falls Assessment Template Code" else if [SnomedCodeDescription] = "Falls infrequently" then "Falls Assessment Template Code" else if [SnomedCodeDescription] = "Recurrent falls" then "Falls Assessment Template Code" else if [SnomedCodeDescription] = "Low risk of falls" then "Falls Assessment Template Code" else if [SnomedCodeDescription] = "At high risk of falls" then "Falls Assessment Template Code" else if [SnomedCodeDescription] = "Multidisciplinary team falls assessment" then "Falls Assessment Template Code" else if [SnomedCodeDescription] = "Multidisciplinary team falls assessment declined" then "Falls Assessment Template Code" else if [SnomedCodeDescription] = "Multidisciplinary team falls assessment defaulted" then "Falls Assessment Template Code" else if [SnomedCodeDescription] = "Multidisciplinary team falls assessment done" then "Falls Assessment Template Code" else if [SnomedCodeDescription] = "Number of falls in last year" then "Falls Assessment Template Code" else "Non-Falls Assessment Template Code")
				in
				    #"Added Conditional Column"

	annotation PBI_ResultType = Table

