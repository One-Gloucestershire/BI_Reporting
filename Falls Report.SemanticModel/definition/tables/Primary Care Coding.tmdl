	column 'Other Template Related Code' =
			IF('Primary Care Coding'[SnomedCodeDescription] IN{
			"Fall in home"
			,"Fall  - Help summoned"
			,"Fall -[X]Unspecif fall occurrnce school oth instit/pub admin area"
			,"Fall [X]Unspecified fall, occurrence at other specified place"
			,"Finding related to falls"
			,"Referral to falls service declined"
			,"Morse Falls Risk Assessment score"
			,"Discussion about falls"
			,"Discussion about falls declined"
			,"Discussion about falls not appropriate"
			,"Refer for falls assessment"
