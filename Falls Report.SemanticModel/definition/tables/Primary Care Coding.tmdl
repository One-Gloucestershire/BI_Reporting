			,"Referral to falls service"
			,"At low risk for fall"
			,"No fear of falls"
			,"Falls risk assessment tool"}
			, "Other Template Code", "Non-Template Code")
		lineageTag: 6cd37a38-e670-4caf-86e2-c14403cc3a84
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

