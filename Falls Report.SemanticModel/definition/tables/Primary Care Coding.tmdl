	column 'Frailty Template Related Code' =
			SWITCH(TRUE(),
			[SnomedCodeDescription] = "Low risk of falls", "Frailty Template Code",
			[SnomedCodeDescription] = "At risk of falls", "Frailty Template Code",
			[SnomedCodeDescription] = "At high risk of falls", "Frailty Template Code",
			[SnomedCodeDescription] = "Does not fall", "Frailty Template Code",
			[SnomedCodeDescription] = "Falls", "Frailty Template Code",
			[SnomedCodeDescription] = "Falls infrequently", "Frailty Template Code",
			[SnomedCodeDescription] = "Recurrent falls", "Frailty Template Code",
			[SnomedCodeDescription] = "Falls risk assessment complete", "Frailty Template Code",
			[SnomedCodeDescription] = "Falls risk assessment referral", "Frailty Template Code",
			[SnomedCodeDescription] = "Falls risk assessment refused", "Frailty Template Code",
			"Non-Frailty Template Code")
		lineageTag: c3820bb7-fbce-4163-87ff-e43c09f7a02e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Care Home Template Related Code' =
			SWITCH(TRUE(),
			[SnomedCodeDescription] = "Assessment using home falls and accidents screening tool", "Care Home Template Code",
			[SnomedCodeDescription] = "Falls assessment", "Care Home Template Code",
			[SnomedCodeDescription] = "Falls risk assessment complete", "Care Home Template Code",
			[SnomedCodeDescription] = "Morse Fall Scale", "Care Home Template Code",
			[SnomedCodeDescription] = "Multidisciplinary team falls assessment", "Care Home Template Code",
			[SnomedCodeDescription] = "Multidisciplinary team falls assessment declined", "Care Home Template Code",
			[SnomedCodeDescription] = "Primary health care team falls assessment", "Care Home Template Code",
			[SnomedCodeDescription] = "Primary health care team falls assessment declined", "Care Home Template Code",
			"Non-Frailty Template Code")
		lineageTag: ee423607-7c40-49c5-bad2-2f81076e5e59
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Template Related Code' = ```
			IF(
			    [Frailty Template Related Code] = "Frailty Template Code" || 
			    [Falls Assessment Template Related Code] = "Falls Assessment Template Code" || 
			    [Care Home Template Related Code] = "Care Home Template Code" || 
			    [Other Template Related Code] = "Other Template Code"
			    , "Template Code", "Non-Template Code")
			```
		lineageTag: 5ccd137b-42a3-45e7-8496-f18664ec84ba
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Falls Assessment Template Related Code'
		dataType: string
