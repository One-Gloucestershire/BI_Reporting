table 'Primary Care Coding'
	lineageTag: 76831260-6301-41ca-b4b0-9bb3e76c1da8

	measure 'Coding Rate per 1000 Monthly' =
			
			VAR Activity = CALCULATE ( COUNT('Primary Care Coding'[PseudoNHSNumber]))
			VAR POP = [Current Population]
			RETURN (Activity/POP*1000)
		lineageTag: e7b97dd9-b2b8-4a9a-961e-663f23dc4631

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Proportion of code used by Locality' =
			
			
			VAR numerator = CALCULATE(COUNT('Primary Care Coding'[PseudoNHSNumber]))
			
			VAR denominator = CALCULATE(COUNT('Primary Care Coding'[PseudoNHSNumber]),ALL('GP Reference'[Locality]))
			
			RETURN IF(numerator/denominator = BLANK(), 0, numerator/denominator)
		formatString: 0%;-0%;0%
		lineageTag: e12e43d0-3ba4-480f-9cd9-630f8c92c5d6

	measure 'Times Code Used' = IF(CALCULATE(COUNT('Primary Care Coding'[PseudoNHSNumber])) = BLANK(), 0, CALCULATE(COUNT('Primary Care Coding'[PseudoNHSNumber])))
		formatString: 0
		lineageTag: 6cc3001c-2b65-4250-a796-57d03c748d39

	measure 'SWAST activity by Locality' =
			
			
			VAR numerator = CALCULATE(COUNT('SWAST All Years Falls'[counter_column]))
			
			VAR denominator = CALCULATE(COUNT('SWAST All Years Falls'[counter_column]),ALL('GP Reference'[Locality]))
			
			RETURN numerator/denominator
		formatString: 0%;-0%;0%
		lineageTag: a8cf5d4f-d61b-4256-8a79-13145f48db63

	measure 'Admissions activity by Locality' =
			
			
			VAR numerator = CALCULATE(COUNT('Admissions Falls'[Number of Admissions]))
			
			VAR denominator = CALCULATE(COUNT('Admissions Falls'[Number of Admissions]),ALL('GP Reference'[Locality]))
			
			RETURN numerator/denominator
		formatString: 0%;-0%;0%
		lineageTag: d82c2bb1-ce9f-4376-a8ba-065081eacf00

	measure 'ED activity by Locality' =
			
			
			VAR numerator = CALCULATE(COUNT('ED Falls (GHFT & SWAST)'[counter]))
			
			VAR denominator = CALCULATE(COUNT('ED Falls (GHFT & SWAST)'[counter]),ALL('GP Reference'[Locality]))
			
			RETURN numerator/denominator
		formatString: 0%;-0%;0%
		lineageTag: b220aaea-b0c1-4318-8d85-7cc7512ee770

	measure 'Proportion of template code used by Locality' =
			
			
			VAR numerator = CALCULATE(COUNT('Primary Care Coding'[PseudoNHSNumber]), 'Primary Care Coding'[Template Related Code] = "Template Code")
			
			VAR denominator = CALCULATE(COUNT('Primary Care Coding'[PseudoNHSNumber]), 'Primary Care Coding'[Template Related Code] = "Template Code",ALL('GP Reference'[Locality]))
			
			RETURN IF(numerator/denominator = BLANK(), 0, numerator/denominator)
		lineageTag: cb4039e0-74b9-403d-82ce-0a714cb8f3ca

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Proportion of non-template code used by Locality' =
			
			
			VAR numerator = CALCULATE(COUNT('Primary Care Coding'[PseudoNHSNumber]), 'Primary Care Coding'[Template Related Code] = "Non-Template Code")
			
			VAR denominator = CALCULATE(COUNT('Primary Care Coding'[PseudoNHSNumber]), 'Primary Care Coding'[Template Related Code] = "Non-Template Code",ALL('GP Reference'[Locality]))
			
			RETURN IF(numerator/denominator = BLANK(), 0, numerator/denominator)
		lineageTag: 78feb0cb-530c-4978-b0ae-6a91b1299328

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Proportion of code used with Stroud Locality' = ```
			
			
			CALCULATE(COUNT('Primary Care Coding'[PseudoNHSNumber])) / [Stroud codes]
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a1fbfa70-55fc-4f39-b310-a7ff09e94a28

	measure 'Stroud codes' = CALCULATE(COUNT('Primary Care Coding'[PseudoNHSNumber]),'GP Reference'[Locality] = "Stroud and Berkeley Vale", REMOVEFILTERS('GP Reference'[ReportingOrganisationName]))
		formatString: 0
		lineageTag: c75baf26-3869-47d6-96e9-b66bca17c142

	measure 'Codes recorded' = CALCULATE(COUNT('Primary Care Coding'[PseudoNHSNumber]))
		formatString: 0
		lineageTag: 669b478f-8a6a-4137-988f-19fbf60c1421

