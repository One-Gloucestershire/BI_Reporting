	partition Date-2890826c-90f7-46ab-9fe6-2d654f34cea2 = m
		mode: import
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "CCG_Reference", [Query="SELECT [Date] [date]#(lf)#(lf)      ,[DayMonthYear] [day_month_year]#(lf)#(lf)      ,[Day] [day]#(lf)#(lf)      ,[Weekday] [weekday]#(lf)#(lf)      ,[WeekDayName] [weekday_name]#(lf)#(lf)      ,[Month] [month]#(lf)#(lf)      ,left([MonthName],3) [month_name]#(lf)#(lf)      ,[Quarter] [quarter]#(lf)#(lf)      ,[YearMonth] [year_month]#(lf)#(lf)      ,[IsWeekend] [is_weekend]#(lf)#(lf)      ,[IsHoliday] [is_holiday]#(lf)#(lf)      ,[FinancialWeekofYear] [financial_week_of_year]#(lf)#(lf)      ,[FinancialYear] [financial_year]#(lf)#(lf)      ,[FinancialQuarter] [financial_quarter]#(lf)#(lf)      ,[FinancialMonth] [financial_month]#(lf)#(lf)      ,[MonthYearName] [month_year_name]#(lf)#(lf)      ,[ytd_flag] = CASE WHEN [FinancialMonth] <= (#(lf)#(lf)                                           SELECT#(lf)#(lf)                                           CAST([FinancialMonth] AS INT)#(lf)#(lf)                                           FROM [CCG_Reference].[Reference].[vw_DateLookup]#(lf)#(lf)                                           WHERE [Date] = EOMONTH(DATEADD(MONTH, -1, GETDATE()))#(lf)#(lf)                                           )#(lf)#(lf)                                           THEN 1 ELSE 0 END#(lf)#(lf) #(lf)#(lf)from [CCG_Reference].[Reference].[vw_DateLookup]#(lf)#(lf)where [Date] BETWEEN '20160401' AND EOMONTH(DATEADD(MONTH, -2, GETDATE()))"])
				in
				    Source

	annotation PBI_ResultType = Table

