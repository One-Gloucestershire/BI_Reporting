table 'Rockwood Frailty over Time'
	lineageTag: 08df0869-2125-4585-92c6-cb1f9eb155d6

	measure 'Frailty Population over Time' =
			
			
			VAR _CURRENTDATE = MAX('Date Reference'[date])
			
			RETURN
			    CALCULATE(
			        COUNT('Rockwood Frailty over Time'[PseudoNHSNumber]),
			        'Rockwood Frailty over Time'[Start_Date] <= _CURRENTDATE,
			        OR ( ISBLANK('Rockwood Frailty over Time'[End_Date]), 'Rockwood Frailty over Time'[End_Date] >= _CURRENTDATE)
			    )
		formatString: #,0
		lineageTag: 7402812e-e178-41ef-8aff-6a78be7ffc0d

	measure '% Frail' =
			
			
			'Rockwood Frailty over Time'[Frailty Population over Time]/'GP Population - All Years'[65+ Population - All Years]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: fc3a7fd2-84cb-484b-ace0-db34c28fbe97

	measure 'Frailty Population over Time - ICB' =
			
			
			VAR _CURRENTDATE = MAX('Date Reference'[date])
			
			RETURN
			    CALCULATE(
			        COUNT('Rockwood Frailty over Time'[PseudoNHSNumber]),
			        'Rockwood Frailty over Time'[Start_Date] <= _CURRENTDATE,
			        OR ( ISBLANK('Rockwood Frailty over Time'[End_Date]), 'Rockwood Frailty over Time'[End_Date] >= _CURRENTDATE), ALL('GP Reference'), 'GP Reference'[PrimaryCareNetwork] <> BLANK()
			    )
		formatString: #,0
		lineageTag: f301a349-b8b6-4025-ab37-1c386aa3c59f

	measure '% Frail ICB' =
			
			
			'Rockwood Frailty over Time'[Frailty Population over Time - ICB]/'GP Population - All Years'[65+ Population - All Years - ICB]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 0fd40143-187d-45d6-a369-1c7caa31dc68

	measure '% Frail Trendline' = ```
			
			
			VAR Temp_Table = 
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED( 'Date Reference'[financial_year], 'Date Reference'[financial_month],
			                         'Date Reference'[month_name], 'Date Reference'[month_number] ),
			            "Value_x", 'Date Reference'[month_number],
			            "Value_y", 'Rockwood Frailty over Time'[% Frail]
			        ),
			        AND (
			            NOT ( ISBLANK ( "Value_x" ) ),
			            NOT ( ISBLANK ( "Value_y" ) )
			        )
			    )
			
			VAR LINESTX_Table = 
			    LINESTX(Temp_Table, [Value_y], [Value_x], TRUE)
			VAR Slope = 
			    MAXX ( LINESTX_Table, [Slope1] )
			VAR Intercept = 
			    MAXX ( LINESTX_Table, [Intercept] )
			
			RETURN
			    SUMX (
			        DISTINCT ( 'Date Reference'[month_number] ),
			        Intercept + Slope * 'Date Reference'[month_number]
			    )
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: b4d53dd2-04b5-4726-a2ff-096bbb469e06

	measure '% Frail Trendline - ICB' = ```
			
			
			VAR Temp_Table = 
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED( 'Date Reference'[financial_year], 'Date Reference'[financial_month],
			                         'Date Reference'[month_name], 'Date Reference'[month_number] ),
			            "Value_x", 'Date Reference'[month_number],
			            "Value_y", 'Rockwood Frailty over Time'[% Frail ICB]
			        ),
			        AND (
			            NOT ( ISBLANK ( "Value_x" ) ),
			            NOT ( ISBLANK ( "Value_y" ) )
			        )
			    )
			
			VAR LINESTX_Table = 
