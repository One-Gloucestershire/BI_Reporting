			RETURN
			    SUMX (
			        DISTINCT ( 'Date Reference'[month_number] ),
			        Intercept + Slope * 'Date Reference'[month_number]
			    )
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: cc30063c-d954-4f80-8c6e-23a5ab7b2ed7

	measure '% Frail - Variance from ICB' =
			
			
			[% Frail] - [% Frail ICB]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: fed254a1-7790-4559-a994-017f62fd8e5b

	measure '% Frail Variance from ICB Trendline' = ```
			
			
			VAR Temp_Table = 
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED( 'Date Reference'[financial_year], 'Date Reference'[financial_month],
			                         'Date Reference'[month_name], 'Date Reference'[month_number] ),
			            "Value_x", 'Date Reference'[month_number],
			            "Value_y", 'Rockwood Frailty over Time'[% Frail - Variance from ICB]
			        ),
			        AND (
