			VAR Intercept = 
			    MAXX ( LINESTX_Table, [Intercept] )
			
			RETURN
			    SUMX (
			        DISTINCT ( 'Date Reference'[month_number] ),
			        Intercept + Slope * 'Date Reference'[month_number]
			    )
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ede97bd3-09f6-4237-8359-c177fae7935f

	measure '% Frail 2021/22' =
			
			
			CALCULATE([% Frail], 'Date Reference'[financial_year] = "2021/22", 'Date Reference'[Latest_Month_Name] = 1)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: cdec8cdf-2389-4362-8e21-edf177717f71

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "AveragePerCategory"
				}

		changedProperty = FormatString

	measure '% Frail Latest Year' =
			
			
			CALCULATE([% Frail], 'Date Reference'[financial_year] = MAX('Date Reference'[financial_year]), 'Date Reference'[Latest_Month_Name] = 1)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 654001c4-418e-47b7-b026-5be3f5cb8964

	measure 'Frail Card Variance' =
			
			
			VAR _CALC = [% Frail Latest Year] - [% Frail 2021/22]
			
			RETURN
			
			FORMAT(_CALC, "+0.0%;-0.0%;0.0%")
		lineageTag: 565face1-54f8-4468-a87f-1b0c49a8fe89

	measure 'Frail Card Variance Colours' =
			
			
			IF(([% Frail Latest Year] - [% Frail 2021/22]) > 0, "#8cb369", "#EF5B5B")
		lineageTag: f91a1ece-58fb-4bf8-9833-7f3088792f19

	measure 'Failty Over Time Trendline' = ```
			
			
			VAR Temp_Table = 
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED( 'Date Reference'[financial_year], 'Date Reference'[financial_month],
			                         'Date Reference'[month_name], 'Date Reference'[month_number] ),
			            "Value_x", 'Date Reference'[month_number],
			            "Value_y", 'Rockwood Frailty over Time'[Frailty Population over Time]
			        ),
			        AND (
			            NOT ( ISBLANK ( "Value_x" ) ),
			            NOT ( ISBLANK ( "Value_y" ) )
			        )
			    )
			
			VAR LINESTX_Table = 
			    LINESTX(Temp_Table, [Value_y], [Value_x], TRUE)
			VAR Slope = 
			    MAXX ( LINESTX_Table, [Slope1] )
