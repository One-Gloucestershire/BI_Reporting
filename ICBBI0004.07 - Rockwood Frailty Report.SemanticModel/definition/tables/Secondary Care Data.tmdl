table 'Secondary Care Data'
	lineageTag: 5c8323ea-ee4b-41e5-80d1-c5923c22279e

	measure 'ED & MIIU Trendline' = ```
			
			
			VAR Temp_Table = 
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED( 'Date Reference'[financial_year], 'Date Reference'[financial_month],
			                         'Date Reference'[month_name], 'Date Reference'[month_number] ),
			            "Value_x", 'Date Reference'[month_number],
			            "Value_y", 'Secondary Care Data'[Secondary Care Total Activity]
			        ),
			        AND (
			            NOT ( ISBLANK ( "Value_x" ) ),
			            NOT ( ISBLANK ( "Value_y" ) )
			        )
			    )
			
			VAR LINESTX_Table = 
			    LINESTX(Temp_Table, [Value_y], [Value_x], TRUE)
			VAR Slope = 
			    MAXX ( LINESTX_Table, [Slope1] )
			VAR Intercept = 
			    MAXX ( LINESTX_Table, [Intercept] )
			
			RETURN
			    SUMX (
			        DISTINCT ( 'Date Reference'[month_number] ),
			        Intercept + Slope * 'Date Reference'[month_number]
			    )
			```
		formatString: #,0
		lineageTag: 26c5afb4-e3ab-4349-bf7b-c22457f38ad7

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Secondary Care Total Activity' =
			
			
			IF(SUM('Secondary Care Data'[Activity_Counter]) < 6, BLANK(), SUM('Secondary Care Data'[Activity_Counter]))
		formatString: #,0
		lineageTag: 2e94de40-6b12-4eaf-af06-c8d53032825f

	measure 'Secondary Care Activity - Rate per 1,000' =
			
			
			VAR _SECONDARYACT = CALCULATE(SUM('Secondary Care Data'[Activity_Counter]))
			VAR _POP = CALCULATE(COUNT('Rockwood Frailty over Time'[PseudoNHSNumber]))
			
			RETURN
			
			(_SECONDARYACT/_POP)*1000
		lineageTag: e87a8009-2076-4a1a-9e3a-39e294c7453e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Secondary Care Activity - Rate per 1,000 - ICB' =
			
			
			VAR _SECONDARYACT = CALCULATE(SUM('Secondary Care Data'[Activity_Counter]), ALL('Frailty Reference'), ALL('Age Band Reference'), ALL('GP Reference'), ALL('Gender Reference'), ALL('Deprivation Level'), ALL('Ethnicity Reference'), 'GP Reference'[PrimaryCareNetwork] <> BLANK(), 'Frailty Reference'[Frailty Type] <> BLANK())
			VAR _POP = CALCULATE(COUNT('Rockwood Frailty over Time'[PseudoNHSNumber]), ALL('Frailty Reference'), ALL('Age Band Reference'), ALL('GP Reference'), ALL('Gender Reference'), ALL('Deprivation Level'), ALL('Ethnicity Reference'), 'GP Reference'[PrimaryCareNetwork] <> BLANK(), 'Frailty Reference'[Frailty Type] <> BLANK())
			
			RETURN
			
			(_SECONDARYACT/_POP)*1000
		lineageTag: 3c1e4845-7c6b-45f7-9bf2-d66e70deb33f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Secondary Care Activity - Variance from ICB' =
			
			
			[Secondary Care Activity - Rate per 1,000] - [Secondary Care Activity - Rate per 1,000 - ICB]
		lineageTag: c1690e30-21ac-4925-bc30-4c82166a956c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Secondary Care Activity - Rate per 1,000 Trendline' = ```
			
			
			VAR Temp_Table = 
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED( 'Date Reference'[financial_year], 'Date Reference'[financial_month],
			                         'Date Reference'[month_name], 'Date Reference'[month_number] ),
			            "Value_x", 'Date Reference'[month_number],
			            "Value_y", 'Secondary Care Data'[Secondary Care Activity - Variance from ICB]
			        ),
			        AND (
			            NOT ( ISBLANK ( "Value_x" ) ),
			            NOT ( ISBLANK ( "Value_y" ) )
			        )
			    )
			
			VAR LINESTX_Table = 
			    LINESTX(Temp_Table, [Value_y], [Value_x], TRUE)
			VAR Slope = 
			    MAXX ( LINESTX_Table, [Slope1] )
			VAR Intercept = 
			    MAXX ( LINESTX_Table, [Intercept] )
			
			RETURN
			    SUMX (
			        DISTINCT ( 'Date Reference'[month_number] ),
			        Intercept + Slope * 'Date Reference'[month_number]
			    )
			```
		lineageTag: 06cdaf23-548b-4578-a6a8-7eb9d4dce046

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Secondary Care Activity - Rate per 1,000 - Mean' = ```
			
			
			VAR _SUMMARYTABLE = 
			
			SUMMARIZE(
			    ALLSELECTED('Date Reference'),
			    'Date Reference'[financial_year],
			    'Date Reference'[month_name],
			    "Rate per 1,000", 'Secondary Care Data'[Secondary Care Activity - Rate per 1,000]
			)
			
			VAR _AVG = 
			
			AVERAGEX(_SUMMARYTABLE, [Rate per 1,000])
			
			RETURN
			
			_AVG
			```
		lineageTag: 5226d4b1-b1cb-47ff-908f-96361479fcbc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Secondary Care Activity - Rate per 1,000 - ICB - Mean' = ```
			
			
			VAR _SUMMARYTABLE = 
			
			SUMMARIZE(
			    ALLSELECTED('Date Reference'),
			    'Date Reference'[financial_year],
			    'Date Reference'[month_name],
			    "Rate per 1,000", 'Secondary Care Data'[Secondary Care Activity - Rate per 1,000 - ICB]
			)
			
			VAR _AVG = 
			
			AVERAGEX(_SUMMARYTABLE, [Rate per 1,000])
			
			RETURN
			
			_AVG
			```
		lineageTag: 5b0411f5-473c-437c-9f87-f5b4086c19b4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Secondary Care Total Activity - Aggregated & Rate' =
			
			
			VAR _SELECTION = MAX('Calculation Selection'[Selection Column - Calculation])
			VAR _TOTALMONTHS = CALCULATE(DISTINCTCOUNT('Date Reference'[month_name]), 'Date Reference'[ytd_flag] = 1)
			
			RETURN
			
			IF(CONTAINSSTRING(_SELECTION, "Total Figure"), [Secondary Care Total Activity], ([Secondary Care Activity - Rate per 1,000]/_TOTALMONTHS))
		lineageTag: d83545bb-ac42-4dab-abaf-0257f32551f1

		formatStringDefinition =
				VAR _SELECTION = MAX('Calculation Selection'[Selection Column - Calculation])
				
				RETURN
				
				IF(CONTAINSSTRING(_SELECTION, "Total Figure"), ",0", "0.0")

	measure 'No Split' = BLANK()
		formatString: 0
		lineageTag: 3c9ed53e-874a-4cd9-b04d-59b64d91c0e2

	measure '% ED' =
			
			
			CALCULATE(SUM('Secondary Care Data'[Activity_Counter]), 'Secondary Care Data'[Service_Type] = "Emergency Department")/SUM('Secondary Care Data'[Activity_Counter])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e3e72bd0-5044-4c90-b8a9-47c9b1bc5e42

	measure '% Major Injury' =
			
			
			CALCULATE(SUM('Secondary Care Data'[Activity_Counter]), 'Secondary Care Data'[Injury_Type] = "Major")/SUM('Secondary Care Data'[Activity_Counter])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e9dc49c7-a7c4-4745-a354-94bd605ffa9f

	measure '% Admissions' =
			
			
			CALCULATE(SUM('Secondary Care Data'[Activity_Counter]), 'Secondary Care Data'[Admission_Flag] = "Admitted")/SUM('Secondary Care Data'[Activity_Counter])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 299b1b4e-362e-4f40-a729-c231e456023f

