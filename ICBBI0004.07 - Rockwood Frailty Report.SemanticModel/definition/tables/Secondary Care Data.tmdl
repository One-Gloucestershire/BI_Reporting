	partition 'Secondary Care Data' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Current", [Query="#(lf)IF OBJECT_ID('TEMPDB..#TEMP_RWFRAILTY') IS NOT NULL DROP TABLE #TEMP_RWFRAILTY#(lf);#(lf)#(lf)SELECT DISTINCT [PseudoNHSNumber]#(lf)               ,[Start_Date]#(lf)#(tab)#(tab)#(tab)   ,[End_Date]#(lf)#(tab)#(tab)#(tab)   ,[Frailty_Type]#(lf)#(lf)INTO #TEMP_RWFRAILTY#(lf)FROM [PowerBI_Reporting].[dbo].[tbl_rockwood_frailty_over_time]#(lf);#(lf)#(lf)SELECT DISTINCT [ED].[CDS_Unique_Identifier]#(lf)               ,[ED].[NHS_Number]#(lf)#(tab)#(tab)#(tab)   ,[ED].[Organisation_Code_Provider]#(lf)#(tab)#(tab)#(tab)   ,[Service_Type] = CASE WHEN [Department_Type] IN (1, 2) THEN 'Emergency Department'#(lf)#(tab)#(tab)#(tab)                          WHEN [Department_Type] = 3 THEN 'Minor Injury Unit'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)  WHEN [Department_Type] = 4 THEN 'NHS Walk In Centre'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)  ELSE 'Unrecorded' END#(lf)#(tab)#(tab)#(tab)   ,[Injury_Type] = CASE WHEN [Acuity] IN ('1064891000000107', '1064911000000105', '1064901000000108') THEN 'Major'#(lf)#(tab)#(tab)#(tab)                         WHEN [Acuity] IN ('1077241000000103', '1077251000000100') THEN 'Minor'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) ELSE 'Unrecorded' END#(lf)#(tab)#(tab)#(tab)   ,[Admission_Flag] = CASE WHEN [GHFTED].[Discharge_destination_code] = '01' THEN 'Admitted'#(lf)#(tab)#(tab)#(tab)                            WHEN [GHFTED].[discharge_destination_code] IN ('02', '03', '04', '05', '06', '07', '11', '12', '13', '14') THEN 'Discharged'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [ED].[Destination] IN ('1066331000000109', '1066361000000104', '1066371000000106', '1066381000000108',#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   '1066391000000105', '1066401000000108') THEN 'Admitted'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [GHFTED].[disposal_method_grouped] = 'Admitted' THEN 'Admitted'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [GHFTED].[disposal_method_grouped] IN ('Discharged', 'Left before treatment', 'Streamed to primary care service / GP',#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)                                            'Transferred to other Healthcare Provider', 'Did Not Wait') THEN 'Discharged'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [ED].[Destination] IN ('1066351000000102', '183919006', '19712007', '306689006', '306691003',#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)                                               '306694006', '306705005', '50861005', '1066341000000100', '306706006') THEN 'Discharged'#(lf)#(tab)#(tab)#(tab)                            ELSE 'Unrecorded' END#(lf)#(tab)#(tab)#(tab)   ,[ED].[Arrival_Date]#(lf)#(tab)#(tab)#(tab)   ,[RW].[Frailty_Type]#(lf)#(tab)#(tab)#(tab)   ,[ED].[General_Practice]#(lf)#(tab)#(tab)#(tab)   ,[GHFTED].[discharge_destination_code]#(lf)#(tab)#(tab)#(tab)   ,[ED].[Destination]#(lf)#(tab)#(tab)#(tab)   ,[GHFTED].[disposal_method_grouped]#(lf)#(tab)#(tab)#(tab)   ,[Activity_Counter] = 1#(lf)#(lf)FROM [CCG_Current].[SEM].[vw_ECDS] AS [ED]#(lf)#(lf)LEFT JOIN (#(lf)          SELECT [PseudoNHSNumber]#(lf)                ,[Start_Date]#(lf)#(tab)#(tab)#(tab)#(tab),[End_Date]#(lf)#(tab)#(tab)#(tab)#(tab),[Frailty_Type]#(lf)#(tab)#(tab)#(tab)#(tab),[RW_Flag] = 1#(lf)#(tab)#(tab)   FROM #TEMP_RWFRAILTY#(lf)#(tab)#(tab)   ) AS [RW] ON [RW].[PseudoNHSNumber] = [ED].[NHS_Number]#(lf)#(lf)LEFT JOIN (#(lf)          SELECT DISTINCT [cds_unique_identifier]#(lf)#(tab)#(tab)                 ,[Discharge_destination_code]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) ,[disposal_method_grouped]#(lf)#(tab)#(tab)  FROM [CCG_Current].[GHFT].[vw_EDAttendance]#(lf)#(tab)#(tab)  ) AS [GHFTED] ON [GHFTED].[cds_unique_identifier] = [ED].[CDS_Unique_Identifier]#(lf)#(lf)WHERE CAST([ED].[Arrival_Date] AS DATE) >= '20210401'#(lf)AND [ED].[Organisation_Code_Commissioner] = '11M'#(lf)AND [RW].[RW_Flag] = 1#(lf)AND [ED].[Arrival_Date] BETWEEN [RW].[Start_Date] AND ISNULL([RW].[End_Date], GETDATE())"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

