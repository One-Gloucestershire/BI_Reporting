	partition 'Rockwood Frailty Scores' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Current", [Query="/*===============================================================================================================#(lf)Section One - Picking out Rockwood cohort#(lf)===============================================================================================================*/#(lf)#(lf)SET NOCOUNT ON#(lf)SET ANSI_WARNINGS OFF#(lf)#(lf)IF OBJECT_ID('TEMPDB..#TEMP_ROCKWOOD') IS NOT NULL DROP TABLE #TEMP_ROCKWOOD#(lf)IF OBJECT_ID('TEMPDB..#TEMP_ROCKWOOD_VALUE_FIXED') IS NOT NULL DROP TABLE #TEMP_ROCKWOOD_VALUE_FIXED#(lf);#(lf)#(lf)SELECT DISTINCT [PseudoNHSNumber]#(lf)               ,[GP].[PrimaryCareNetwork]#(lf)#(tab)#(tab)#(tab)   ,[PC].[PracticeCode]#(lf)#(tab)#(tab)#(tab)   ,[PC].[PracticeDescription]#(lf)#(tab)#(tab)#(tab)   ,[Last_12_Months_Flag] = CASE WHEN [EventDate] BETWEEN DATEADD(MONTH, -12, (SELECT MAX([EventDate]) FROM [CCG_Current].[PrimaryCare].[vw_Events]))#(lf)#(tab)#(tab)#(tab)                                 AND (SELECT MAX([EventDate]) FROM [CCG_Current].[PrimaryCare].[vw_Events]) THEN 1 ELSE 0 END                                 #(lf)#(tab)#(tab)#(tab)   ,[EventDate]#(lf)#(tab)#(tab)#(tab)   ,[Event_Order] = ROW_NUMBER() OVER (PARTITION BY [PseudoNHSNumber] ORDER BY [EventDate] DESC)#(lf)#(tab)#(tab)#(tab)   ,[Value1]#(lf)#(tab)#(tab)#(tab)   ,[Value_Fix] = ISNUMERIC([Value1])#(lf)#(lf)INTO #TEMP_ROCKWOOD#(lf)FROM [CCG_Current].[PrimaryCare].[vw_Events] AS [PC]#(lf)#(lf)LEFT JOIN (#(lf)           SELECT DISTINCT [OrganisationCode]#(lf)#(tab)#(tab)                  ,[PrimaryCareNetwork]#(lf)#(tab)#(tab)   FROM [CCG_Reference].[Reference].[vw_GPPractice]#(lf)#(tab)#(tab)   WHERE [PrimaryCareNetwork] IS NOT NULL#(lf)#(tab)#(tab)   ) AS [GP]#(lf)ON [GP].[OrganisationCode] = [PC].[PracticeCode]#(lf)#(lf)WHERE ([EventCode] COLLATE SQL_Latin1_General_CP1_CS_AS IN ('XaQik')#(lf)OR [SnomedCode] = '763264000')#(lf)AND [PseudoNHSNumber] IS NOT NULL#(lf);#(lf)#(lf)SELECT DISTINCT [PseudoNHSNumber]#(lf)               ,[PrimaryCareNetwork]#(lf)#(tab)#(tab)#(tab)   ,[PracticeDescription]#(lf)#(tab)#(tab)#(tab)   ,[PracticeCode]#(lf)#(tab)#(tab)#(tab)   ,[Last_12_Months_Flag]#(lf)#(tab)#(tab)#(tab)   ,[EventDate]#(lf)#(tab)#(tab)#(tab)   ,[Event_Order]#(lf)#(tab)#(tab)#(tab)   ,[Value_1] = CAST([Value1] AS FLOAT)#(lf)#(lf)INTO #TEMP_ROCKWOOD_VALUE_FIXED#(lf)FROM #TEMP_ROCKWOOD#(lf)#(lf)WHERE [Value_Fix] = 1#(lf)AND [Event_Order] = 1#(lf);#(lf)#(lf)ALTER TABLE #TEMP_ROCKWOOD_VALUE_FIXED#(lf)ADD [Month_Date] VARCHAR (30)#(lf);#(lf)#(lf)UPDATE #TEMP_ROCKWOOD_VALUE_FIXED#(lf)SET [Month_Date] = (SELECT DISTINCT [Date].[MonthYearName] FROM #TEMP_ROCKWOOD_VALUE_FIXED AS [RW]#(lf)                    LEFT JOIN (SELECT DISTINCT [Date], [MonthYearName] FROM [CCG_Reference].[Reference].[vw_DateLookup]) AS DATE#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)ON [DATE].[Date] = (SELECT CAST(MAX([EventDate]) AS DATE) FROM #TEMP_ROCKWOOD_VALUE_FIXED))#(lf);#(lf)   /*===============================================================================================================#(lf)Section Two - Pulling final table#(lf)===============================================================================================================*/#(lf)#(lf)SELECT DISTINCT [Table] = 'Frailty'#(lf)               ,[PseudoNHSNumber]#(lf)               ,[PrimaryCareNetwork]#(lf)#(tab)#(tab)#(tab)   ,[PracticeDescription]#(lf)#(tab)#(tab)#(tab)   ,[PracticeCode]#(lf)#(tab)#(tab)#(tab)   ,[Last_12_Months_Flag]#(lf)#(tab)#(tab)#(tab)   ,[Month_Date]#(lf)#(tab)#(tab)#(tab)   ,[Frailty_Type] =  CASE WHEN [Value_1] BETWEEN 1 AND 4 THEN 'Non-Frail'#(lf)#(tab)#(tab)#(tab)                           WHEN [Value_1] = 5 THEN 'Mild'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN [Value_1] = 6 THEN 'Moderate'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN [Value_1] BETWEEN 7 AND 9 THEN 'Severe'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   ELSE 'Unknown' END#(lf)#(tab)#(tab)#(tab)   ,[Age_Band] = CASE WHEN [AGE].[5YR_Age_Band] LIKE '0-4' THEN '00-04'#(lf)#(tab)#(tab)#(tab)                      WHEN [AGE].[5YR_Age_Band] LIKE '5-9' THEN '05-09'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)  ELSE [AGE].[5YR_Age_Band] END#(lf)#(tab)#(tab)#(tab)   ,[Gender] = [PDS].[Gender_Desc]#(lf)#(tab)#(tab)#(tab)   ,[Population] = 1#(lf)#(lf)FROM #TEMP_ROCKWOOD_VALUE_FIXED AS [RW]#(lf)#(lf)LEFT JOIN (SELECT DISTINCT [Derived_NHS_Number]#(lf)                          ,[PDS_Flag] = 1 #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)  ,[Derived_Age]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)  ,[Gender_Desc]#(lf)#(lf)#(tab)#(tab)   FROM [CCG_Reference].[Population].[vw_PDS_Current]) AS [PDS]#(lf)ON [PDS].[Derived_NHS_Number] = [RW].[PseudoNHSNumber]#(lf)#(lf)LEFT JOIN (SELECT DISTINCT [Age], [5YR_Age_Band] FROM [CCG_Reference].[Reference].[vw_AgeBand]) AS [AGE]#(lf)ON [AGE].[Age] = [PDS].[Derived_Age]#(lf)#(lf)WHERE [PDS_Flag] = 1"])
				in
				    Source

	annotation PBI_ResultType = Table

