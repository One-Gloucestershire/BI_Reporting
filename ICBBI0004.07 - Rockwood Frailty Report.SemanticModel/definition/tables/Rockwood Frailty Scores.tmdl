table 'Rockwood Frailty Scores'
	lineageTag: b6f57b6a-2cd3-456d-8fb4-5bc3275800ca

	measure 'Observed Rockwood Population' = SUM('Rockwood Frailty Scores'[Population])
		formatString: 0
		lineageTag: d880af9a-66c9-40bc-9b24-35d1dc817a93

		annotation PBI_FormatHint = {"isDecimal":true}

	measure '% Mild Frailty' =
			
			
			VAR FRAIL_POP = CALCULATE(SUM('Rockwood Frailty Scores'[Population]), 'Rockwood Frailty Scores'[Frailty_Type] IN {"Mild"}, 'Age Band Reference'[age_banding] IN {"65-69", "70-74", "75-79", "80-84", "85+"})
			
			RETURN FRAIL_POP / [65 + Population]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: d210c07d-5d5e-472f-a53d-666bf4d9abb2

	measure '% Mild Frailty - ICB' =
			
			
			VAR FRAIL_POP = CALCULATE(SUM('Rockwood Frailty Scores'[Population]), 'Rockwood Frailty Scores'[Frailty_Type] IN {"Mild"}, 'Age Band Reference'[age_banding] IN {"65-69", "70-74", "75-79", "80-84", "85+"}, ALL('GP Reference'), 'GP Reference'[PrimaryCareNetwork] <> BLANK())
			
			RETURN FRAIL_POP / [65 + Population - ICB]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 713f4d1a-7e10-4d3a-80ba-345f1b6fe733

	measure '% Moderate Frailty' =
			
			
