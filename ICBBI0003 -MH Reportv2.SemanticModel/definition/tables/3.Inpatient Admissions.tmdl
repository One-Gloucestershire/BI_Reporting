table '3.Inpatient Admissions'
	lineageTag: 68a1be3f-2608-4b4c-a134-0cf78537d150

	measure 'Number of admissions' = DISTINCTCOUNT('3.Inpatient Admissions'[Unique_Hospital_Provider_SpellID])
		formatString: #,0
		lineageTag: 122b32b8-2df1-4380-b5ee-cd0918f35e3e

	measure Admissions_Growth = ```
			
			VAR CY = [Number of admissions]
			VAR LY = CALCULATE(
			    distinctcount('3.Inpatient Admissions'[Unique_Hospital_Provider_SpellID]),
			    DATESBETWEEN(
			        REF_Date_Ref[date],
			        EDATE(MIN('REF_Date_Ref'[date]),-12),
			        EOMONTH(max(REF_Date_Ref[date]),-12)
			    )
			
			)
			VAR Check = CY  &&  LY && HASONEVALUE('REF_Date_Ref'[financial_year])
			Return 
			
			IF(Check,divide(CY,LY) -1)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: d3231ef3-1aec-4fc7-8bd2-8eacec64061f

	measure Discharge_Growth = ```
			
			VAR CY = [Number of IP discharges]
			VAR LY = CALCULATE(
			    distinctcount('4.Inpatient Discharges'[Unique_Hospital_Provider_SpellID]),
			    DATESBETWEEN(
			        REF_Date_Ref[date],
			        EDATE(MIN('REF_Date_Ref'[date]),-12),
			        EOMONTH(max(REF_Date_Ref[date]),-12)
			    )
			
			)
			VAR Check = CY  &&  LY && HASONEVALUE('REF_Date_Ref'[financial_year])
			Return 
			
			IF(Check,divide(CY,LY) -1)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 6316041c-a601-4511-a69a-6d219bc22db1

	measure Number_of_inpatient_admissions_current_FY_in_reporting =
			
			
			var latest_reporting_month = calculate(max(REF_Date_Ref[financial_month]),REF_Date_Ref[Reporting_Month_Flag] = 1,all(REF_Date_Ref))
			var latest_financial_year_order_in_range = calculate(max(REF_Date_Ref[Date_Order_Financial_Year]),all(REF_Date_Ref))
			Var final_calc = calculate([Number of admissions],REF_Date_Ref[financial_month] <= latest_reporting_month,REF_Date_Ref[Date_Order_Financial_Year] = latest_financial_year_order_in_range,all(REF_Date_Ref)
			)
			
			return
			
			if(isblank(final_calc),0,final_calc)
		lineageTag: 0814a286-2696-4ca1-9b3d-35759e39ad14

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Number_of_inpatient_admissions_previous_FY_in_reporting =
			
			
			var latest_reporting_month = calculate(max(REF_Date_Ref[financial_month]),REF_Date_Ref[Reporting_Month_Flag] = 1,all(REF_Date_Ref))
			var latest_financial_year_order_in_range = calculate(max(REF_Date_Ref[Date_Order_Financial_Year]),all(REF_Date_Ref))
			
			return
			
			calculate([Number of admissions],REF_Date_Ref[financial_month] <= latest_reporting_month,REF_Date_Ref[Date_Order_Financial_Year] = latest_financial_year_order_in_range -1,all(REF_Date_Ref)
			)
		formatString: 0
		lineageTag: e63cfd86-d315-4f45-8cc6-0a86107bfe68

	measure Number_of_admissions_%_variance_current_reporting_period_current_FY_Vs_Previous = ([Number_of_inpatient_admissions_current_FY_in_reporting] - [Number_of_inpatient_admissions_previous_FY_in_reporting])/[Number_of_inpatient_admissions_previous_FY_in_reporting]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c92d6293-656b-4094-a3dc-7fa4c245c9e5

	measure Number_of_admissions_%_variance_current_reporting_period_current_FY_Vs_Previous_Arrow = ```
			
			  VAR ADMISSIONS_ARROW =   IF(
			        [Number_of_admissions_%_variance_current_reporting_period_current_FY_Vs_Previous] > 0, UNICHAR(9650),
			        IF(
			            [Number_of_admissions_%_variance_current_reporting_period_current_FY_Vs_Previous] < 0, UNICHAR(9660), 
			            BLANK()
			        )
			    )
			
			    RETURN
			
			    IF(ISBLANK(ADMISSIONS_ARROW),"",ADMISSIONS_ARROW)
			```
		lineageTag: 65c585ff-877c-40de-96f3-588a8060e32d

	measure Number_of_IP_admissions_per_1000_crude_rate = ```
			
			VAR latest_date = MAX(REF_Date_Ref[date])
			VAR start_of_latest_month = DATE(YEAR(latest_date), MONTH(latest_date), 1)
			RETURN
			calculate(([Number of admissions]/sum('REF_GP Practice Populations'[Total Population]))*1000,'REF_GP Practice Populations'[CensusDate_as_date] = start_of_latest_month)
			 
			
			```
		lineageTag: 25a5ae9e-35c7-4007-88f3-1709b7ca02df

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Total_GP_Practice_Population_Latest_Reporting_Month_in_Range = ```
			
			VAR latest_date = MAX(REF_Date_Ref[date])
			VAR start_of_latest_month = DATE(YEAR(latest_date), MONTH(latest_date), 1)
			RETURN
			calculate(sum('REF_GP Practice Populations'[Total Population]),'REF_GP Practice Populations'[CensusDate_as_date] = start_of_latest_month)
			 
			```
		formatString: #,0
		lineageTag: 9797b0c0-5d0e-4fa8-aaac-3e3b2d5f1c95

	measure Number_of_countywide_IP_admissions_per_1000_crude_rate = ```
			
			VAR latest_date = MAX(REF_Date_Ref[date])
			VAR start_of_latest_month = DATE(YEAR(latest_date), MONTH(latest_date), 1)
			RETURN
			CALCULATE(
			    ([Number of admissions] / SUM('REF_GP Practice Populations'[Total Population])) * 1000,
			    'REF_GP Practice Populations'[CensusDate_as_date] = start_of_latest_month,
			    ALL(REF_GP_Reference_Table),
			    REF_GP_Reference_Table[OrganisationCode] <> "Y00054",
			    NOT ISBLANK(REF_GP_Reference_Table[Locality]) 
			)
			```
		lineageTag: ae060e82-6058-459f-84bb-c46eb902b7b8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Total_Countywide_GP_Practice_Population_Latest_Reporting_Month_in_Range = ```
			
			VAR latest_date = MAX(REF_Date_Ref[date])
			VAR start_of_latest_month = DATE(YEAR(latest_date), MONTH(latest_date), 1)
			RETURN
			calculate(sum('REF_GP Practice Populations'[Total Population]),'REF_GP Practice Populations'[CensusDate_as_date] = start_of_latest_month, ALL(REF_GP_Reference_Table),
			    REF_GP_Reference_Table[OrganisationCode] <> "Y00054",
			    NOT ISBLANK(REF_GP_Reference_Table[Locality]))
			 
			```
		formatString: #,0
		lineageTag: 1243e635-4571-43d0-a46d-2a1752430c8b

	measure Locality_Bars_Conditional_Formatting_compared_to_countywide_rate =
			
			SWITCH(
			    True(),
			    [Number_of_IP_admissions_per_1000_crude_rate] > [Number_of_countywide_IP_admissions_per_1000_crude_rate],"#FE7A36"
			    ,"#3652AD"
			)
		lineageTag: a5be1acc-141f-4a79-8afa-1bd32b82b172

	measure Only_Relevant_Admissions_in_filter =
			
			
			var admission_row_count = countrows('3.Inpatient Admissions')
			var IP_discharges_row_count = countrows('4.Inpatient Discharges')
			
			RETURN
			
			admission_row_count + IP_discharges_row_count
		formatString: 0
		lineageTag: 130c5996-4f56-4470-94fc-6d0ffc6a0ed4

