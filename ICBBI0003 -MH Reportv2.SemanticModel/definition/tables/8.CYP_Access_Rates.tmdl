	partition '8.CYP_Access_Rates' = m
		mode: import
		queryGroup: MH_KPIs
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Reference", [Query="set nocount on #(lf)#(lf)/*------------------------------------------------------------#(lf)Delete Temp Tables if exists#(lf)/-------------------------------------------------------------*/#(lf)IF OBJECT_ID('tempdb..#Contacts') is not null#(lf)drop table #Contacts#(lf)#(lf)IF OBJECT_ID('tempdb..#CYP_Contacts') is not null#(lf)drop table #CYP_Contacts#(lf)#(lf)#(lf)IF OBJECT_ID('tempdb..#Contacts_loop_temp') is not null#(lf)drop table #Contacts_loop_temp#(lf)#(lf)#(lf)IF OBJECT_ID('tempdb..#MH_Referrals') is not null#(lf)drop table #MH_Referrals#(lf)#(lf)/*------------------------------------------------------------#(lf)Start TEMP tables#(lf)#(lf)#(lf)/-------------------------------------------------------------*/#(lf)#(lf)#(lf)---Referrals Temp Table#(lf)#(lf)select  distinct r.*#(lf),[GHC_Cost_Centre_on_referral] = g.Cost_Centre#(lf),[Postcode_on_referral] = r.DerivedPostcode#(lf),[LSOA_on_referral] = p.LSOACode#(lf)#(lf)into #MH_Referrals#(lf)from CCG_Current.MHSDS.vw_101_Referral as r #(lf)left join CCG_Reference.GHC.vw_Hierarchy as g on  case when r.CareProfTeamLocalId  NOT IN (select distinct Cost_Centre from CCG_Reference.GHC.vw_Hierarchy) then g.Ward_Team_Code else g.Cost_Centre end = r.CareProfTeamLocalId#(lf)and r.OrgIDProv like 'RTQ%' -- GHC ONLY#(lf)left join ccg_reference.reference.vw_postcode_lookup as p on  r.DerivedPostcode  = p.derived_Postcode_Key#(lf)#(lf)where AgeServReferRecDate between 0 and 17 #(lf)and OrgIDComm like '11M%'#(lf)and OrgIDProv in ('RTQ','8JF65','8JG08','8F440','8K685')  ---only providers that are under the SW as reported by NHSE #(lf)--and cast(ReferralRequestReceivedDate as date) >= '20220401'#(lf)order by ReferralRequestReceivedDate asc #(lf)#(lf)#(lf)---Contacts Temp Table (Joining Direct and Indirect Activity as per NHS guidance)#(lf)#(lf)SELECT distinct  #(lf)[Activity_Type] = 'Direct Contact' #(lf),c.UniqServReqID#(lf),C.UniqCareContID#(lf),C.OrgIDComm#(lf),C.OrgIDCommDescription#(lf),C.OrgIDProv#(lf),C.OrgIDProvDescription#(lf),C.NHSNumber#(lf),C.Person_ID#(lf),CareContDate#(lf),CareContTime#(lf),ConsMechanismMH#(lf),ConsMechanismMHDescription#(lf),c.AttendOrDNACodeDescription#(lf),c.AttendOrDNACode#(lf),[GP_on_referral_code] = gp_at_referral.GMPCodeReg #(lf),c.CareProfTeamLocalId#(lf)#(lf)#(lf)into #Contacts #(lf)  FROM [CCG_Current].[MHSDS].[vw_301_Contact] as  c#(lf)#(lf)  left join #(lf)#(lf)  (select distinct UniqServReqID,GMPCodeReg#(lf)  from #MH_Referrals) as gp_at_referral on gp_at_referral.UniqServReqID = c.UniqServReqID#(lf)#(lf)#(lf)  where #(lf)#(lf)  c.OrgIDComm LIKE '11M%' --11M#(lf) and #(lf)  c.AttendOrDNACode in ('5','6') -- attended #(lf)  and c.ConsMechanismMH in ('01','02','04','11') --- NHSE Guidance#(lf)#(lf)#(lf)  UNION ALL #(lf) #(lf)  select  [Activity_Type] = 'Indirect Contact' #(lf)  ,[UniqServReqID] = I.UniqServReqID#(lf),[UniqCareContID] = NULL#(lf),[OrgIDComm] = i.OrgIDComm#(lf),[OrgIDCommDescription] = NULL#(lf),[OrgIDProv] = i.OrgIDProv#(lf),[OrgIDProvDescription] = NULL #(lf),[NHSNumber] = p.NHSNumber#(lf),[Person_ID] = i.Person_ID#(lf),[CareContDate] = IndirectActDate#(lf),[CareContTime] = IndirectActTime#(lf),[ConsMechanismMH] = NULL#(lf),[ConsMechanismMHDescription]  = NULL#(lf),[AttendOrDNACodeDescription] = NULL#(lf),[AttendOrDNACode]  = NULL#(lf),[GP_on_referral_code] = gp_at_referral.GMPCodeReg#(lf),[CareProfTeamLocalId] = I.CareProfTeamLocalId#(lf)#(lf)#(lf)#(lf)#(lf)  from Data_Mart_MHSDS.dbo.MHS204IndirectActivity AS I#(lf)#(lf)  left join  (select DISTINCT Person_ID,NHSNumber#(lf) from CCG_Current.MHSDS.vw_001_MPI#(lf) where NHSNumber is not null ) as p on p.Person_ID = i.Person_ID#(lf)#(lf)   left join #(lf)#(lf)  (select distinct UniqServReqID,GMPCodeReg#(lf)  from #MH_Referrals) as gp_at_referral on gp_at_referral.UniqServReqID = i.UniqServReqID#(lf)#(lf)#(lf)  AND i.OrgIDComm LIKE '11M%'#(lf)#(lf)#(lf) ---Brings referrals and contacts together and only finds CYP referral contacts #(lf)#(lf)select distinct  c.*#(lf),[Start_Date_Range] = cast('' as date)#(lf),[End_Date_Range] = cast('' as date)#(lf),r.ReferralRequestReceivedDate#(lf),r.ServTeamTypeRefToMH#(lf),r.ServTeamTypeRefToMHDescription#(lf),r.AgeServReferRecDate#(lf),[Gender_Code] = r.Gender#(lf),[Postcode_on_referral] = r.DerivedPostcode#(lf),[LSOA_on_referral] = r.LSOA_on_referral#(lf),[Ethnic_Origin_Code] = e.[Ethnic Origin]#(lf),[Ethnic_Origin_Description] = e.EthnicOriginDescription#(lf),[GHC_Cost_Centre_on_referral] = r.GHC_Cost_Centre_on_referral#(lf)#(lf)into #CYP_Contacts #(lf)#(lf)from #Contacts as c#(lf)left join #MH_Referrals  as r on c.UniqServReqID = r.UniqServReqID and c.Person_ID = r.Person_ID#(lf)left join CCG_Reference.Reference.vw_DateLookup as d on d.Date = c.CareContDate#(lf)left join BIReports.MPI.Ethnicity_Table as e on e.PseudoNHSNo = c.NHSNumber#(lf)#(lf)#(lf)#(lf)where r.UniqServReqID is not null  --only find those that meet the criteria.#(lf)#(lf)#(lf)/*------------------------------------------------------------#(lf)LOOP TO find all contacts in rolling date ranges #(lf)/-------------------------------------------------------------*/#(lf)#(lf)#(lf)select NHSNumber#(lf),UniqCareContID#(lf),UniqServReqID#(lf),Activity_Type#(lf),OrgIDComm#(lf),OrgIDCommDescription#(lf),OrgIDProv#(lf),OrgIDProvDescription#(lf),Person_ID#(lf),ConsMechanismMHDescription#(lf),AttendOrDNACode#(lf),AttendOrDNACodeDescription#(lf),CareContDate#(lf),CareContTime#(lf),ReferralRequestReceivedDate#(lf),ServTeamTypeRefToMH#(lf),ServTeamTypeRefToMHDescription#(lf),AgeServReferRecDate#(lf),Start_Date_Range#(lf),End_Date_Range#(lf),[GP_on_referral_code]#(lf),[Ethnic_Origin_Code]#(lf),[Ethnic_Origin_Description] #(lf),[Gender_Code]#(lf),[Postcode_on_referral]#(lf),[LSOA_on_referral]#(lf),[GHC_Cost_Centre_on_referral]#(lf)INTO #Contacts_loop_temp#(lf)from #CYP_Contacts#(lf)#(lf)#(lf)--now the temp table is setup remove all data but keep the structure#(lf)delete  from #Contacts_loop_temp#(lf)#(lf)#(lf)--Start loop#(lf)declare @start_date date#(lf)declare @end_date date #(lf)set @start_date  = '20220501'#(lf)set @end_date = eomonth('20230401')#(lf) #(lf)while ( @end_date <= '20240229')#(lf)#(lf)begin #(lf)#(lf)insert into #Contacts_loop_temp#(lf)#(lf)select distinct NHSNumber#(lf),UniqCareContID#(lf),UniqServReqID#(lf),Activity_Type#(lf),OrgIDComm#(lf),OrgIDCommDescription#(lf),OrgIDProv#(lf),OrgIDProvDescription#(lf),Person_ID#(lf),ConsMechanismMHDescription#(lf),AttendOrDNACode#(lf),AttendOrDNACodeDescription#(lf),CareContDate#(lf),CareContTime#(lf),ReferralRequestReceivedDate#(lf),ServTeamTypeRefToMH#(lf),ServTeamTypeRefToMHDescription#(lf),AgeServReferRecDate#(lf),[Start_Date_Range] = @start_date#(lf),End_Date_Range = @end_date#(lf),[GP_on_referral_code]#(lf),[Ethnic_Origin_Code]#(lf),[Ethnic_Origin_Description] #(lf),[Gender_Code]#(lf),[Postcode_on_referral]#(lf),[LSOA_on_referral]#(lf),[GHC_Cost_Centre_on_referral]#(lf)from #CYP_Contacts as c #(lf)where c.CareContDate between @start_date and @end_date#(lf)#(lf)print 'The month start value is  ' + convert(varchar,@start_date)#(lf)print 'The month end value is  ' + convert(varchar,@end_date)#(lf)#(lf)set @start_date = dateadd(month,1,@start_date)#(lf)set @end_date = eomonth(dateadd(month,1,@end_date))#(lf)#(lf)end #(lf)#(lf)#(lf)/*------------------------------------------------------------#(lf)End of TEMP TABLES#(lf)/-------------------------------------------------------------*/#(lf)#(lf)/*------------------------------------------------------------#(lf)Final Ouput #(lf)/-------------------------------------------------------------*/#(lf)SELECT c.*#(lf),d.MonthName#(lf),d.FinancialYear#(lf),d.FinancialMonth#(lf)#(lf)FROM #Contacts_loop_temp as c#(lf)left join CCG_Reference.Reference.vw_DateLookup as d on d.Date = c.End_Date_Range#(lf)#(lf)#(lf)/*------------------------------------------------------------#(lf)Testing#(lf)/-------------------------------------------------------------*/#(lf)--select *#(lf)--from #Contacts_loop_temp#(lf)--WHERE End_Date_Range = '20240131'#(lf)--order by End_Date_Range#(lf)#(lf)#(lf)--select *#(lf)--from #CYP_Contacts as c#(lf)--where c.CareContDate between '20230201' and '20240131'#(lf)#(lf)#(lf)--SELECT DISTINCT concat(End_Date_Range,UniqCareContID)#(lf)--FROM #Contacts_loop_temp#(lf)#(lf)#(lf)--select  UniqServReqID,count(*)#(lf)--from #MH_Referrals#(lf)--GROUP BY UniqServReqID#(lf)--having count(*) >1#(lf)#(lf)--select  UniqCareContID#(lf)--from #Contacts#(lf)--where Activity_Type LIKE 'Direct%'#(lf)--where UniqServReqID = 'RTQcr531029' #(lf)#(lf)--'RTQcr488816'#(lf)#(lf)--select *#(lf)--from #Contacts#(lf)--where UniqServReqID = '8JF65AS1383_1'#(lf)"])
				in
				    Source

	annotation PBI_ResultType = Table

