table '2.Community_Discharges'
	lineageTag: fff58e8c-e592-4786-ab51-d11759161219

	measure Referral_to_discharge_rate = [number_of_community_discharges]/[Number of referrals]
		formatString: 0.00
		lineageTag: 006b5ca2-190b-464c-896b-fc0171fbc068

	measure Discharges_Growth = ```
			
			VAR CY = [number_of_community_discharges]
			VAR LY = CALCULATE(
			    [number_of_community_discharges],
			    DATESBETWEEN(
			        REF_Date_Ref[date],
			        EDATE(MIN('REF_Date_Ref'[date]),-12),
			        EOMONTH(max(REF_Date_Ref[date]),-12)
			    )
			
			)
			VAR Check = CY  &&  LY && HASONEVALUE('REF_Date_Ref'[financial_year])
			Return 
			
			IF(Check,divide(CY,LY) -1)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: dbefe712-4488-42c4-9861-85a3cdda02ca

	measure number_of_community_discharges = ```
			distinctcount('2.Community_Discharges'[UniqServReqID]) 
			```
		formatString: #,0
		lineageTag: c50ddc20-18dc-4518-b3a4-f0fcfa47e0a9

	measure Contacts_per_referral =
			
			
			VAR Attended_Contacts_Per_Unique_Ref = SUMMARIZE(
			    '2.Community_Discharges',
			    '2.Community_Discharges'[UniqServReqID],
			    "Contacts_Per_Referral", MAX('2.Community_Discharges'[Attended_Contacts_in_Referral])
			)
			
			return
			averagex(
			Attended_Contacts_Per_Unique_Ref
			,[Contacts_Per_Referral])
		lineageTag: 51a75f0a-c9d2-470f-b548-033fd14474e5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

