	partition '2.Community_Discharges' = m
		mode: import
		source =
				let
				    Source = #"1.Community_Referrals",
				    #"Only Discharged Referrals" = Table.SelectRows(Source, each ([Service_Discharge_Date] <> null))
				in
				    #"Only Discharged Referrals"

	annotation PBI_ResultType = Table

