	partition REF_GHC_Team_Hierarchy = m
		mode: import
		queryGroup: 'Reference Tables'
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Reference", [Query=" ---GHC Heirarchy Reference Script--#(lf)#(lf)#(lf) #(lf)select *#(lf)#(lf)from CCG_Reference.GHC.vw_Hierarchy as h#(lf)#(lf) #(lf) #(lf)-- ---First Identify all MH cost centres found in MHSDS currently. #(lf)-- if object_id ('tempdb..#Distinct_Cost_Centres_GHC_in_MHSDS') is not null drop table #Distinct_Cost_Centres_GHC_in_MHSDS#(lf)#(lf)#(lf)--select DISTINCT [GHC_MH_Cost_Centre] =  h.GHC_Admission_Ward_Cost_Centre#(lf)#(lf)--into #Distinct_Cost_Centres_GHC_in_MHSDS#(lf)#(lf)--from #(lf)#(lf)--(select distinct  GHC_Admission_Ward_Cost_Centre#(lf)--from PowerBI_processing.dbo.MHSDS_MH_Inpatients#(lf)#(lf)--WHERE  Provider_Code like 'RTQ%'#(lf)--AND  GHC_Admission_Ward_Cost_Centre is not null #(lf)#(lf)--union#(lf)#(lf)--select distinct  GHC_Cost_Centre#(lf)--from PowerBI_processing.dbo.MHSDS_MH_Contacts#(lf)#(lf)--WHERE  Provider_Code like 'RTQ%'#(lf)--AND  GHC_Cost_Centre is not null #(lf)#(lf)--union#(lf)#(lf)--select distinct  GHC_Cost_Centre#(lf)--from PowerBI_processing.dbo.MHSDS_MH_Referrals#(lf)#(lf)--WHERE  Provider_Code like 'RTQ%'#(lf)--AND  GHC_Cost_Centre is not null ) as h#(lf)#(lf)#(lf)-- ---Identify all MH IP cost centres found in MHSDS currently. #(lf)#(lf)--  if object_id ('tempdb..#GHC_MH_IP_Cost_Centres') is not null drop table #GHC_MH_IP_Cost_Centres#(lf)#(lf)#(lf)-- select distinct  [GHC_MH_IP_Cost_Centre] = GHC_Admission_Ward_Cost_Centre#(lf)#(lf)-- into #GHC_MH_IP_Cost_Centres#(lf)#(lf)--from PowerBI_processing.dbo.MHSDS_MH_Inpatients#(lf)#(lf)--WHERE  Provider_Code like 'RTQ%'#(lf)--AND  GHC_Admission_Ward_Cost_Centre is not null #(lf)#(lf)#(lf)-- ---Identify all MH Community cost centres found in MHSDS currently. #(lf)#(lf)-- if object_id ('tempdb..#GHC_MH_Comm_Cost_Centres') is not null drop table #GHC_MH_Comm_Cost_Centres#(lf)#(lf)#(lf)-- select distinct [GHC_MH_Comm_Cost_Centre] = C.GHC_Cost_Centre#(lf)#(lf)-- into #GHC_MH_Comm_Cost_Centres#(lf)#(lf)-- from #(lf)#(lf)-- (select distinct  GHC_Cost_Centre#(lf)--from PowerBI_processing.dbo.MHSDS_MH_Contacts#(lf)#(lf)--WHERE  Provider_Code like 'RTQ%'#(lf)--AND  GHC_Cost_Centre is not null #(lf)#(lf)--union#(lf)#(lf)--select distinct  GHC_Cost_Centre#(lf)--from PowerBI_processing.dbo.MHSDS_MH_Referrals#(lf)#(lf)--WHERE  Provider_Code like 'RTQ%'#(lf)--AND  GHC_Cost_Centre is not null ) as c#(lf)#(lf)#(lf)------Final Output#(lf)#(lf)--select *#(lf)--,[MH_IP_Only] = case when h.Cost_Centre in (Select distinct i.GHC_MH_IP_Cost_Centre  from #GHC_MH_IP_Cost_Centres as i) then 1 else 0 end #(lf)--,[MH_Comm_Only] = case when h.Cost_Centre in (Select distinct c.GHC_MH_Comm_Cost_Centre  from #GHC_MH_Comm_Cost_Centres as c) then 1 else 0 end #(lf)#(lf)--from CCG_Reference.GHC.vw_Hierarchy as h#(lf)#(lf)--where h.Cost_Centre in (select distinct C.GHC_MH_Cost_Centre from #Distinct_Cost_Centres_GHC_in_MHSDS as c) #(lf)#(lf)#(lf)#(lf)#(lf)"])
				in
				    Source

	annotation PBI_ResultType = Table

