	partition '5.Wait Times - Referral to first Contact' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Reference", [Query="#(tab)set nocount on #(lf)#(tab)---First obtain all referrals #(lf)#(lf)#(tab)IF OBJECT_ID('tempdb..#MH_Referrals') is not null#(lf)#(tab)drop table #MH_Referrals#(lf)#(lf)#(lf)#(lf)#(lf)#(tab)select distinct *#(lf)#(lf)#(tab)into #MH_Referrals#(lf)#(tab)from PowerBI_Processing.dbo.MHSDS_MH_Referrals#(lf)#(tab)where Referral_Rejection_Date is null #(lf)#(tab)and cast(Referral_Recieved_Date as date) >='20220401'#(lf)#(lf)#(lf)#(tab)---second obtain all first contacts for referrals#(lf)#(lf)#(tab)IF OBJECT_ID('tempdb..#MH_Attended_Contacts') is not null#(lf)#(tab)drop table #MH_Attended_Contacts#(lf)#(lf)#(lf)#(tab)select distinct c.*#(lf)#(tab),[Contact_Order] = row_number() over (partition by c.UniqServReqID order by contact_date , contact_time asc )#(lf)#(lf)#(lf)#(tab)into #MH_Attended_Contacts #(lf)#(tab)from PowerBI_Processing.dbo.MHSDS_MH_Contacts as c#(lf)#(tab)where  Consultation_Mechanism_Type_Code in ('01','02','11','03') -- f2f,telephone or video (telemedicine)#(lf)#(tab)and Attended_or_DNA_Code in ('5','6')#(lf)#(tab)and cast(Contact_Date as date) >= '20220401'#(lf)#(lf)#(tab)--Only keep the first contact in each referral , remove the rest #(lf)#(tab)delete from #MH_Attended_Contacts#(lf)#(tab)where Contact_Order <> 1;#(lf)#(lf)#(lf)#(lf)#(tab)--Final Ouput #(lf)#(lf)#(tab)select r.*#(lf)#(tab),c.UniqCareContID#(lf)#(tab),c.Contact_Date#(lf)#(tab),c.Contact_Time#(lf)#(tab),c.Contact_Order#(lf)#(tab),c.GHC_Cost_Centre#(lf)#(tab),c.GHC_Service_Description#(lf)#(tab),c.GHC_Team_Description#(lf)#(tab),[Time_Between_Referral_and_first_contact_days] = DATEDIFF(dd,r.Referral_Recieved_Date,c.Contact_Date)#(lf)#(tab),[Weeks_to_first_contact_banding] =#(lf)#(tab)case when DATEDIFF(dd,r.Referral_Recieved_Date,c.Contact_Date) < 0  then 'Data Quality - contact before referral start'#(lf)#(tab)when DATEDIFF(dd,r.Referral_Recieved_Date,c.Contact_Date) between 0 and 6 then 'less than one week'#(lf)#(tab)when DATEDIFF(dd,r.Referral_Recieved_Date,c.Contact_Date) between 7and 13 then 'one to two weeks'#(lf)#(tab)when  DATEDIFF(dd,r.Referral_Recieved_Date,c.Contact_Date) between 14 and 27 then 'two to four weeks'#(lf)#(tab)when  DATEDIFF(dd,r.Referral_Recieved_Date,c.Contact_Date) between 28 and 83 then 'four to twelve weeks'#(lf)#(tab)when  DATEDIFF(dd,r.Referral_Recieved_Date,c.Contact_Date) >=84 then '12 weeks and over' End#(lf)#(lf)#(tab),[Weeks_to_first_contact_banding_order] =#(lf)#(tab)case when DATEDIFF(dd,r.Referral_Recieved_Date,c.Contact_Date) < 0  then 0#(lf)#(tab)when DATEDIFF(dd,r.Referral_Recieved_Date,c.Contact_Date) between 0 and 6 then 1#(lf)#(tab)when DATEDIFF(dd,r.Referral_Recieved_Date,c.Contact_Date) between 7and 13 then 2#(lf)#(tab)when  DATEDIFF(dd,r.Referral_Recieved_Date,c.Contact_Date) between 14 and 27 then 3#(lf)#(tab)when  DATEDIFF(dd,r.Referral_Recieved_Date,c.Contact_Date) between 28 and 83 then 4#(lf)#(tab)when  DATEDIFF(dd,r.Referral_Recieved_Date,c.Contact_Date) >=84 then 5 End#(lf)#(lf)#(lf)#(lf)#(tab)from #MH_Referrals as r #(lf)#(tab)left join #MH_Attended_Contacts as c on r.UniqServReqID = c.UniqServReqID#(lf)#(tab)and r.Person_ID = c.Person_ID#(lf)#(lf)#(tab)where c.Contact_Date is not null #(lf)#(tab)#(lf)#(tab)order by Contact_Date#(lf)#(lf)"])
				in
				    Source

	annotation PBI_ResultType = Table

