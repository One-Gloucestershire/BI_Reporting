table electives
	lineageTag: 236f311d-33b6-4e54-aece-4a78e55bcb24

	measure 'Average Length of Stay' = ```
			SUM('electives'[TotalBedDays])/CALCULATE(SUM('electives'[counter]),'electives'[PatientClassification] = "Inpatient Admission") 
			```
		lineageTag: 302068f9-cca2-4803-827d-240ac28f7b7d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Elective_Activity =
			
			CALCULATE(
			    SUM(electives[counter]),
			    AND(OR(CONTAINSSTRING(electives[patient_classification], "Day Case Admission"),CONTAINSSTRING(electives[patient_classification], "Inpatient Admission")),electives[elective_flag] = 1)
			)
		formatString: 0
		lineageTag: 08170199-4bcf-4b26-a485-a547698eaa3a

