		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "select nhs_number as ""NHS_Number"", age as ""Age"", ""5yr_age_band"" as ""5yr_Age_Band"", ""10yr_age_band"", appointmentdate as ""AppointmentDate"", practice_code as ""Practice_Code"", practice_name as ""Practice_Name"", primarycarenetwork as ""PrimaryCareNetwork"", locality as ""Locality"", provider_code as ""Provider_Code"", site_code as ""Site_Code"", site_name as ""Site_Name"", treatment_function_code as ""Treatment_Function_Code"", treatment_function_description as ""Treatment_Function_Description"", attended_code as ""Attended_Code"", source_of_referral_code as ""Source_Of_Referral_Code"", priority_code as ""Priority_Code"", priority as ""Priority"", core_hrg as ""Core_HRG"", core_hrg_description as ""Core_HRG_Description"", counter as ""Counter"", financial_year as ""Financial_Year"", month_name as ""Month_Name"", financial_month as ""Financial_Month"", yearmonth as ""YearMonth"", postcode as ""Postcode"", lsoa as ""LSOA"", nationaldeprivation as ""NationalDeprivation"", countydeprivation as ""CountyDeprivation"", ethnicorigindescription as ""EthnicOriginDescription"", derivedethnicitygroup as ""DerivedEthnicityGroup"", carehomeflag as ""CareHomeFlag"", livingaloneflag as ""LivingAloneFlag"", efi_category as ""EFI_Category"", provider_name as ""Provider_Name"", provider_group as ""Provider_Group"", attended_flag as ""Attended_Flag"", appointmentmode as ""AppointmentMode"", first_or_follow_up as ""First_or_Follow_up"", appointmenttype as ""AppointmentType"", referralsource as ""ReferralSource"", attendance_or_procedure as ""Attendance_Or_Procedure"", reportingmonth as ""ReportingMonth"", population as ""Population"", rate as ""Rate"" from data_mart_powerbi_plannedcare.tbl02_outpatients", null, [EnableFolding=true])
