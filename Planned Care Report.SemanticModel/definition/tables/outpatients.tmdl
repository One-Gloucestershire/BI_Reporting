table outpatients
	lineageTag: d4d7e24c-29c8-41e5-a11b-aee5bed0cdc4

	measure follow_up_attendances = CALCULATE(COUNT('outpatients'[counter]),FILTER('outpatients','outpatients'[First_or_Follow_up]="Follow-up"),FILTER('outpatients','outpatients'[Attended_Flag]="Attended"))
		formatString: 0
		lineageTag: a508961f-f46e-4c92-8dd6-0c1e19252049

	measure first_attendances = CALCULATE(COUNT('outpatients'[counter]),FILTER('outpatients','outpatients'[first_or_follow_up]="First"),FILTER('outpatients','outpatients'[attended_flag]="Attended"))
		formatString: 0
		lineageTag: bd515102-adf6-4a50-b071-78d3c6ce5e73

	measure first_to_follow_up_ratio = [follow_up_attendances]/[first_attendances]
		lineageTag: 43d77e53-72ab-4ed7-8a10-7b00bab4ceb4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure non_f2f_target = 0.25
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 86d7d7ba-afc8-40ab-9865-655bb1059906

	measure total_attendances = CALCULATE(SUM('outpatients'[counter]),FILTER('outpatients','outpatients'[attended_flag]="Attended"))
		formatString: 0
		lineageTag: dd332ef9-cdfb-4953-a341-69abb7043c92

	measure non_f2f_attendances = CALCULATE(COUNT('outpatients'[counter]),FILTER('outpatients','outpatients'[AppointmentMode]="Non Face-to-Face"),FILTER('outpatients','outpatients'[Attended_Flag]="Attended"))
		formatString: 0
		lineageTag: e95b3bce-6e58-4afa-a592-f70d92b98064

	measure non_f2f_attendances_% = IFERROR(DIVIDE([non_f2f_attendances],[total_attendances]),0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 6fce8aae-7433-4806-b66a-654036ffa53d

	measure did_not_attend = CALCULATE(SUM('outpatients'[counter]),FILTER('outpatients','outpatients'[Attended_Flag]="Did Not Attend"))
		formatString: 0
		lineageTag: 6df75685-9502-4135-a11f-242325ee985c

	measure dna_rate_% = [did_not_attend]/([total_attendances]+[did_not_attend])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c5bfd063-9e80-46f3-bb36-ccc54c435df5

	measure 'average outpatient' =
			AVERAGEX(KEEPFILTERS(VALUES('date'[year_month])),
				CALCULATE(SUM('outpatients'[counter])
			))
		lineageTag: 911decc6-d1c2-4c08-8ee8-7c8de0108208

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Mean2 = CALCULATE(AVERAGEX('outpatients',[counter]), ALLSELECTED('outpatients'))
		lineageTag: 0494bfb1-428b-4b50-a755-386959f60a1f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Outpatient_Parameter = "Total Outpatient Attendances"
		lineageTag: af20f9af-b27a-4f3a-90ce-f3bcee4a8689

	measure First_Attended_Appointments =
			
			CALCULATE(
			    SUM(outpatients[counter]),
			    CONTAINSSTRING(outpatients[First_or_Follow_up], "First"),
			    outpatients[Attended_Flag] = "Attended"
			)
		formatString: 0
		lineageTag: bffd15b3-5e61-4607-b523-61809b682e91

	measure Conversion = electives[Elective_Activity]/outpatients[First_Attended_Appointments]
		lineageTag: b34c325b-462c-4593-bdf8-a9e428993ef5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

