table E-Referrals
	lineageTag: f6693a4c-f369-4d19-980d-21fc6df64f3c

	measure 'Rejection %' = calculate(divide(sum('E-Referrals'[Rejection]),sum('E-Referrals'[DirectlyBookable])))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3cd3db26-0555-47f7-ad29-b80deedc130a

	measure GHFTCountOnly = ```
			CALCULATE( 
			    SUM('E-Referrals'[Counter]),
			    'E-Referrals'[Provider_Code] = "RTE", 
			    REMOVEFILTERS('E-Referrals'[Provider_Name], 'E-Referrals'[Provider_Group] ) ) +0
			```
		formatString: 0
		lineageTag: f7c7d40c-676a-4fcf-ad56-3cc26f8c8d94

	measure OtherCountOnly = CALCULATE( SUM('E-Referrals'[Counter]), 'E-Referrals'[Provider_Code] <> "RTE" ) +0
		formatString: 0
		lineageTag: fa55242e-5e9a-4dce-8681-af6f705543d2

	measure TotalCount = ```
			CALCULATE( 
			    SUM('E-Referrals'[Counter]),
			        REMOVEFILTERS('E-Referrals'[Provider_Name], 'E-Referrals'[Provider_Group] ) ) +0
			```
		formatString: 0
		lineageTag: 70d41d42-d3b4-4380-9b97-dffd76ec1fad

	measure OtherPercentage = ```
			
			DIVIDE(
			    CALCULATE(SUM('E-Referrals'[Counter]), 'E-Referrals'[GHFT or Other] = "Other"), 
			    CALCULATE(SUM('E-Referrals'[Counter]), 
			    REMOVEFILTERS('E-Referrals'[Provider_Name], 'E-Referrals'[Provider_Group] )), 
			    0 ) +0
			```
		lineageTag: 3fed3ade-2383-4a2f-ab89-848777b733fe

		annotation PBI_FormatHint = {"isGeneralNumber":true}

