		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Deaths Raw Local Rate per 1000' = [Deaths Local events]/[Deaths Local population]*1000
		lineageTag: 951a0c6e-40dc-4b24-95d8-1be09fbe3c74

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Deaths Difference in events' = [deaths Correct local expected events]-[deaths Local events]
