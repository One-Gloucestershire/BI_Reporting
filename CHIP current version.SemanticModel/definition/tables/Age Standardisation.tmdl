		formatString: 0
		lineageTag: c7abcec8-9577-46b1-b88c-46d9877988bb

	measure 'Deaths Reference events' =
			
			CALCULATE(sum('Cancer data'[Counter]),ALL('Core 20 ref'[Core20Flag]),ALL('LD ref'[LD_flag]),all('Locality ref'[Locality]), all('MH ref'[MH_flag]), all('Table'[Ethnicity]), 'Cancer data'[Death_from_treatment_within_one_year] = 1)
		formatString: 0
		lineageTag: 0f7d76f9-64a6-43fb-b68a-0fd2df780c66

	measure 'Deaths Reference population' =
			
			CALCULATE(SUM('Cancer data'[Counter]), ALL('Core 20 ref'[Core20Flag]), all('LD ref'[LD_flag]),all('Locality ref'[Locality]), all('MH ref'[MH_flag]), all('Table'[Ethnicity]))
		formatString: 0
		lineageTag: 98a488bc-d2c4-431f-b14e-cbe2aa1473c6

	measure 'Deaths Reference rate' = ([Deaths Reference events]/[Deaths Reference population])
