		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Deaths Correct local expected events' = sumx(VALUES('Age ref'[AgeBand5yr]),[Deaths Incorrect Local expected events])
		formatString: #,0.0
		lineageTag: 422de20d-3ac4-4adc-97d1-b7e47693aaba

	measure 'Deaths Local rate per 1000 AS' = [Deaths Local events]/[Deaths Correct local expected events]*[Deaths Reference rate per 1000]
