	partition MPI = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "bireports", [Query="#(lf)#(tab)  SELECT#(lf)#(tab)  locality = case when m.LocalityName like '%cotswold%' then 'Cotswolds' else LocalityName end#(lf)#(tab)  ,MH_flag = m.MentalIllnessDerived#(lf)#(tab)  ,LD_flag = m.LearningDisabilityDerived#(lf)#(tab)  ,Core20Flag#(lf)#(tab)  ,[Ethnic Origin Grouped] = EthnicOriginDescription#(lf)#(tab)  ,[5YR_Age_Band] = m.AgeBand5yr#(lf)#(tab)  ,Derived_Pseudo_NHS#(lf)#(tab)  ,counter = 1#(lf)#(lf)#(tab)  from BIReports.MPI.MPI_current m"])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

