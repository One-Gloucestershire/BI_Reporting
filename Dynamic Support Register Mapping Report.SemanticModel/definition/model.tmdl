model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Sheet1","Query1"]

annotation __PBI_TimeIntelligenceEnabled = 1

ref table Sheet1
ref table Query1

ref cultureInfo en-GB

