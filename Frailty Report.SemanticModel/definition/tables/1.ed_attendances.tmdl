	measure 'ED attendances per 1000 frail population trend line' = ```
			
			 
			VAR Temp_Table =
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED( 'REF_Date'[financial_year], 'REF_Date'[financial_month],
			                         'REF_Date'[month_name], 'REF_Date'[month_number] ),
			            "Value_x", 'REF_Date'[month_number],
			            "Value_y", [total_frail_ed_att_per_1000]
			        ),
			        AND (
			            NOT ( ISBLANK ( "Value_x" ) ),
			            NOT ( ISBLANK ( "Value_y" ) )
			        )
			    )
			 
			VAR LINESTX_Table =
			    LINESTX(Temp_Table, [Value_y], [Value_x], TRUE)
			VAR Slope =
			    MAXX ( LINESTX_Table, [Slope1] )
			VAR Intercept =
			    MAXX ( LINESTX_Table, [Intercept] )
			 
			RETURN
			    SUMX (
			        DISTINCT ( 'REF_Date'[month_number] ),
			        Intercept + Slope * 'REF_Date'[month_number]
			    )
			```
		lineageTag: 65b944fd-9f2c-4713-93d5-1a74c725ae36

		annotation PBI_FormatHint = {"isGeneralNumber":true}

