		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ED_att_moving_range = ```
			
			VAR FilteredTable_ =
			    FILTER(
			        ALL(REF_Date),
			        REF_Date[YearMonthIndex] >= 1 && REF_Date[SPC_Flag] = 1
			    )
			
			VAR SummaryTable =
			    SUMMARIZE(
			        FilteredTable_,
			        REF_Date[financial_year],
			        REF_Date[month_name],
			        REF_Date[YearMonthIndex],
			        REF_Date[SPC_Flag],
			        "total_frail_ed_att_per_1000", [total_frail_ed_att_per_1000]
			    )
			
			VAR SummaryTableWithDifference =
			    ADDCOLUMNS(
			        SummaryTable,
			        "Difference",
			        VAR CurrentYearMonthIndex = [YearMonthIndex]
			        VAR NextValue =
			            CALCULATE(
			                MINX(
			                    FILTER(
			                        SummaryTable,
			                        [YearMonthIndex] = CurrentYearMonthIndex + 1
			                    ),
			                   [total_frail_ed_att_per_1000]
			                )
			            )
			        RETURN IF(ISBLANK(NextValue), BLANK(),  abs([total_frail_ed_att_per_1000] - NextValue))
			    )
			
			VAR Differences =
			    SELECTCOLUMNS(SummaryTableWithDifference, "Diff", [Difference])
			
			    VAR Cumulative_moving_range = (AVERAGEX(Differences, [Diff])) 
			
			RETURN Cumulative_moving_range *2.66
			```
		displayFolder: SPC Chart - ED Attendances
		lineageTag: cd643b89-f222-4ee1-b56d-4dafce931d67

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Confidence_Limits_Upper_ED_Mild_Frailty_Rate_per_1000 = ```
			VAR CountVariable = [mildly_frail_ed_att]
			VAR DenominatorVariable = [Mild_frailty_population_end_of_each_fy]
			VAR ConfidenceLevel = 95
			VAR ScalingFactor = 1000
			// Approximate the Inverse of the Standard Normal Distribution
			VAR ApproxNORM_INV = 
			IF(
			 ConfidenceLevel = 95, 
			1.9599639845400500, // 95% confidence level
			 IF(
			 ConfidenceLevel = 90, 
			1.645, // 90% confidence level
			 1.28 // 80% confidence level as an example
			 )
			 )
			// Byars Calculation for Upper Bound
			RETURN
			IFERROR(
			IF(
			 CountVariable < 10, 
			iferror( (CHISQ.INV(1 - (0.5 - ConfidenceLevel / 200), 2*CountVariable+2) / 2),
			 BLANK()), 
			(CountVariable + 1) * (1 - 1 / (9 * (CountVariable + 1)) + (ApproxNORM_INV / (3 * SQRT(CountVariable + 1))))^3
			) / DenominatorVariable * ScalingFactor 
			,BLANK())
			    
			```
		displayFolder: Frail_ED_att_Rate_Per_1000_Confidence_Limits
		lineageTag: c3b4fd93-55b5-4ce2-8ff1-efe8c19ef001

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Confidence_Limits_Lower_ED_Mild_Frailty_Rate_per_1000 = ```
			VAR CountVariable = [Mildly_frail_ed_att]
			
			
			// =========================================================================
			// Stage 1: Create your base table to house your virtual pivot table 
			// =========================================================================   
			
			VAR SummaryTable =
			    SUMMARIZE(
			        REF_Age_Bands,
			        REF_Age_Bands[5YR_Age_Band],
			        "Total_Local_Observed_Events", '1.ed_attendances'[mildly_frail_ed_att],
			        "Total_Local_Population",
			            VAR latest_month_in_range = STARTOFMONTH(LASTDATE(REF_Date[date]))
			            VAR mildly_fail_populations_at_year_end =
			                CALCULATE(
			                    SUM(REF_GP_Practice_Populations_over_time[mild_frailty]),
			                    REF_Date[date] = latest_month_in_range
			                )
			            RETURN
			                mildly_fail_populations_at_year_end,
			        "Reference_Events",
			            CALCULATE(
			                '1.ed_attendances'[mildly_frail_ed_att],
			                REMOVEFILTERS(REF_GP_Practice),
			                REMOVEFILTERS(REF_LSOA),
			                REMOVEFILTERS(REF_Ethnicity),
			                REMOVEFILTERS(REF_EFI_Category),
			                REMOVEFILTERS(REF_Gender),
			                REMOVEFILTERS(REF_admission_method),
			                -- REMOVEFILTERS(REF_Age_Bands),
			                REMOVEFILTERS(REF_Cinapsis_Pathways),
			                REMOVEFILTERS(REF_Cinapsis_Specialist_Outcome),
			                REMOVEFILTERS(REF_ED_Department_Type),
			                REMOVEFILTERS(REF_Site),
			                REMOVEFILTERS(REF_Providers)
			            ),
			        "Reference_Population",
			            CALCULATE(
			                VAR latest_month_in_range = STARTOFMONTH(LASTDATE(REF_Date[date]))
			                VAR Gloucestershire_mildly_fail_populations_at_year_end =
			                    CALCULATE(
			                        SUM(REF_GP_Practice_Populations_over_time[mild_frailty]),
			                        REF_Date[date] = latest_month_in_range,
			                        REMOVEFILTERS(REF_GP_Practice),
			                        REMOVEFILTERS(REF_LSOA),
			                        REMOVEFILTERS(REF_Ethnicity),
			                        REMOVEFILTERS(REF_EFI_Category),
			                        REMOVEFILTERS(REF_Gender),
			                        REMOVEFILTERS(REF_admission_method),
			                        -- REMOVEFILTERS(REF_Age_Bands),
			                        REMOVEFILTERS(REF_Cinapsis_Pathways),
			                        REMOVEFILTERS(REF_Cinapsis_Specialist_Outcome),
			                        REMOVEFILTERS(REF_ED_Department_Type),
			                        REMOVEFILTERS(REF_Site),
			                        REMOVEFILTERS(REF_Providers)
			                    )
			                RETURN
			                    CALCULATE(
			                        Gloucestershire_mildly_fail_populations_at_year_end,
			                        REMOVEFILTERS(REF_GP_Practice),
			                        REMOVEFILTERS(REF_LSOA),
			                        REMOVEFILTERS(REF_Ethnicity),
			                        REMOVEFILTERS(REF_EFI_Category),
			                        REMOVEFILTERS(REF_Gender),
			                        REMOVEFILTERS(REF_admission_method),
			                        -- REMOVEFILTERS(REF_Age_Bands),
			                        REMOVEFILTERS(REF_Cinapsis_Pathways),
			                        REMOVEFILTERS(REF_Cinapsis_Specialist_Outcome),
			                        REMOVEFILTERS(REF_ED_Department_Type),
			                        REMOVEFILTERS(REF_Site),
			                        REMOVEFILTERS(REF_Providers)
			                    )
			            )
			    )
			
			// =========================================================================
			// Stage 2: Add in fields for reference rates
			// =========================================================================   
			
			VAR SummaryTable_with_reference_rates =
			    ADDCOLUMNS(
			        SummaryTable,
			        "Reference_Rates", DIVIDE([Reference_Events], [Reference_Population], 0)
			    )
			
			// =========================================================================
			// Stage 3: Add in field for local expected events per age group
			// =========================================================================   
			
			VAR SummaryTable_with_reference_rates_and_local_expected_events =
			    ADDCOLUMNS(
			        SummaryTable_with_reference_rates,
			        "Local_Expected_Events", [Reference_Rates] * [Total_Local_Population]
			    )
			
			// =========================================================================
			// Stage 4: Obtain totals
			// =========================================================================
			
			VAR total_observed =
			    SUMX(SummaryTable_with_reference_rates_and_local_expected_events, [Total_Local_Observed_Events])
			
			VAR total_expected =
			    SUMX(SummaryTable_with_reference_rates_and_local_expected_events, [Local_Expected_Events])
			
			VAR total_reference_events =
			    SUMX(SummaryTable_with_reference_rates_and_local_expected_events, [Reference_Events])
			
			VAR total_reference_population =
			    SUMX(SummaryTable_with_reference_rates_and_local_expected_events, [Reference_Population])
			
			// =========================================================================
			// Stage 5: Calculate the reference crude rate
			// =========================================================================
			   
			VAR reference_crude_rate =
			    DIVIDE(total_reference_events, total_reference_population, 0) * 1000
			
			// =========================================================================
			// Stage 6: Calculate the age standardised rate
			// =========================================================================
			
			VAR age_standardised_rate =
			    DIVIDE(total_observed, total_expected, 0) * reference_crude_rate
			
			// =========================================================================
			// Stage 7: Calculate lower confidence limit
			// =========================================================================
			
			VAR ConfidencePct = 0.95
			VAR Alpha = 1 - ConfidencePct
			VAR ZValue = 1.95996398454005
			
			VAR ObservedLower =
			    IF(
			        total_observed = 0,
			        0,
			        IF(
			            total_observed < 10,
			            CHISQ.INV(Alpha / 2, 2 * total_observed) / 2,
			            total_observed
			                * (1 - 1 / (9 * total_observed) - ZValue / (3 * SQRT(total_observed))) ^ 3
			        )
			    )
			
			RETURN
			    DIVIDE(ObservedLower, total_expected, BLANK()) * reference_crude_rate
