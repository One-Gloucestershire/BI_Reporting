	measure SCV_ed_att_per_1000_decreasing_trend = ```
			
			VAR FilteredTable_ =
			    filter(ALLSELECTED(REF_Date),REF_Date[YearMonthIndex] >= 1)
			
			VAR SummaryTable =
			    SUMMARIZE(
			        FilteredTable_,
			        REF_Date[financial_year],
			        REF_Date[month_name],
			        REF_Date[YearMonthIndex],
			        REF_Date[SPC_Flag],
			        "total_frail_ed_att_per_1000", [total_frail_ed_att_per_1000]
			    )
			
			
			VAR SummaryTableWithDifference =
			    ADDCOLUMNS(
			        SummaryTable,
			        "Difference",
			        VAR CurrentYearMonthIndex = REF_Date[YearMonthIndex]
			        VAR PreviousValue =
			            CALCULATE(
			                MAXX(
			                    FILTER(
			                        SummaryTable,
			                        REF_Date[YearMonthIndex] = CurrentYearMonthIndex - 1
			                    ),
			                    [total_frail_ed_att_per_1000]
			                )
			            )
			        RETURN [total_frail_ed_att_per_1000] - PreviousValue
			    )
			
			VAR SummaryTableWithDecreasingFlag =
			    ADDCOLUMNS(
			        SummaryTableWithDifference,
			        "DecreasingFlag",
			        IF([Difference] < 0, 1, 0)
			    )
			
			VAR DecreasingSequence =
			    FILTER(
			        ADDCOLUMNS(
			            SummaryTableWithDecreasingFlag,
			            "DecreasingSequence",
			            VAR CurrentYearMonthIndex = REF_Date[YearMonthIndex]
			            VAR DecreasingCount =
			                COUNTROWS(
			                    FILTER(
			                        SummaryTableWithDecreasingFlag,
			                        REF_Date[YearMonthIndex] >= CurrentYearMonthIndex - 4 &&
			                        REF_Date[YearMonthIndex] <= CurrentYearMonthIndex &&
			                        [DecreasingFlag] = 1
			                    )
			                )
			            RETURN IF(DecreasingCount =5 , 1, 0) -- Adjust the number of periods for your trend
			        ),
			        [DecreasingSequence] = 1
			    )
			
			VAR AdditionalFlags =
			    UNION(
			   
			   SELECTCOLUMNS(
			           ADDCOLUMNS(DecreasingSequence, "OffsetIndex", [YearMonthIndex] - 5),
			           "YearMonthIndex", [OffsetIndex]
			       ),
			       SELECTCOLUMNS(
			            ADDCOLUMNS(DecreasingSequence, "OffsetIndex", [YearMonthIndex] - 4),
			           "YearMonthIndex", [OffsetIndex]
			       ),
			       SELECTCOLUMNS(
			           ADDCOLUMNS(DecreasingSequence, "OffsetIndex", [YearMonthIndex] - 3),
			           "YearMonthIndex", [OffsetIndex]
			       ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(DecreasingSequence, "OffsetIndex", [YearMonthIndex] - 2),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(DecreasingSequence, "OffsetIndex", [YearMonthIndex] - 1),
			            "YearMonthIndex", [OffsetIndex]
			        ),
			        SELECTCOLUMNS(
			            ADDCOLUMNS(DecreasingSequence, "OffsetIndex", [YearMonthIndex]),
			            "YearMonthIndex", [OffsetIndex]
			        )
			    )
			
			
			RETURN
			IF(
			    MIN(REF_Date[YearMonthIndex]) IN AdditionalFlags,
			    [total_frail_ed_att_per_1000],
			    BLANK()
			)
			```
