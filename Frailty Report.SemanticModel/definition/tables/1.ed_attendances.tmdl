			// =========================================================================
			   
			VAR reference_crude_rate =
			    DIVIDE(total_reference_events, total_reference_population, 0) * 1000
			
			// =========================================================================
			// Stage 6: Calculate the age standardised rate
			// =========================================================================
			
			VAR age_standardised_rate =
			    DIVIDE(total_observed, total_expected, 0) * reference_crude_rate
			
			// =========================================================================
			// Stage 7: Calculate upper confidence limit
			// =========================================================================
			
			VAR ConfidencePct = 0.95
			VAR Alpha = 1 - ConfidencePct
			VAR ZValue = 1.95996398454005
			
			VAR ObservedUpper =
			    IF(
			        total_observed < 10,
			        CHISQ.INV(1 - Alpha / 2, 2 * (total_observed + 1)) / 2,
			        (total_observed + 1)
			            * (1 - 1 / (9 * (total_observed + 1)) + ZValue / (3 * SQRT(total_observed + 1))) ^ 3
			    )
			
			RETURN
			    DIVIDE(ObservedUpper, total_expected, BLANK()) * reference_crude_rate
			```
		displayFolder: Frail_ED_att_Rate_Per_1000_Confidence_Limits
		lineageTag: 99800cd1-8451-4996-a752-cc90609b11da

