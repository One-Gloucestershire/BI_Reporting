	measure total_frail_ed_att_2025/26 = CALCULATE(DISTINCTCOUNT('1.ed_attendances'[nhs_number]),FILTER('1.ed_attendances','1.ed_attendances'[efi_category] IN {"Mild Frailty","Moderate Frailty","Severe Frailty"}), FILTER(REF_Date,'REF_Date'[financial_year] = "2025/26"))
