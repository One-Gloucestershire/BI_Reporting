	measure average_total_frail_ed_att_per_1000 = ```
			
			VAR  FilteredTable = 
			    CALCULATETABLE(
			        REF_Date,
			        ALL(REF_Date),
			        REF_Date[SPC_Flag] = 1
			    )
			
			VAR SummaryTable = 
			    SUMMARIZE(
			       FilteredTable,
			        REF_Date[financial_year],
			        REF_Date[month_name],
			        "Total_Frail_ed_att_per_1000", [total_frail_ed_att_per_1000]
			    )
			
			VAR AverageRate =
			    AVERAGEX(
			        SummaryTable,
			        [total_frail_ed_att_per_1000]
			    )
			RETURN
			    AverageRate
			```
		formatString: 0.00
		displayFolder: SPC Chart - ED Attendances
		lineageTag: 46a4e361-e859-4c2d-8dc8-70151b0eaafd

