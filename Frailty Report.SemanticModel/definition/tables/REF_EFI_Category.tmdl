				    Source = Sql.Database("grh-ccg-sql", "PowerBI_Reporting", [Query="SELECT distinct [efi_category] =  efi_category_current#(lf)#(lf)FROM#(lf)PowerBI_Reporting.Frailty.tbl01_Frail_Patient_Deficits#(lf)where efi_category_current is not null #(lf)#(lf)union #(lf)#(lf)select distinct efi_category#(lf)from PowerBI_Reporting.SecondaryCare.tbl07_Inpatients#(lf)where efi_category is not null #(lf)#(lf)union #(lf)#(lf)select distinct efi_category#(lf)from PowerBI_Reporting.UrgentCare.tbl01_ECDS#(lf)where efi_category is not null #(lf)#(lf)#(lf)"])
