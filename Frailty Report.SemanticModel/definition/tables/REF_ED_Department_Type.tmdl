	partition REF_ED_Department_Type = m
		mode: import
		queryGroup: 'Reference Tables'
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "DSCRO_NATIONAL_LOOKUPS", [Query="SELECT [Department_type_code] = RIGHT(Main_Code_Text,1) #(lf)#(lf),[Department_type_description] = Main_Description#(lf),[Department_type_group] = #(lf)case when Main_Code_Text in ('01','02') then 'A&E Department'#(lf)when Main_Code_Text in ('03') then 'Minor Injury Unit'#(lf)when Main_Code_Text in ('04') then 'NHS Walk In Centre'#(lf)when Main_Code_Text in ('05') then Main_Description END #(lf)  FROM [DSCRO_NATIONAL_LOOKUPS].[Data_Dictionary].[Emergency_Care_Department_Type_SCD]#(lf)  where Is_Latest = 1#(lf)#(lf)  order by RIGHT(Main_Code_Text,1)  asc"])
				in
				    Source

