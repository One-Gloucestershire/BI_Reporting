	partition REF_ED_Department_Type = m
		mode: import
		queryGroup: 'Reference Tables'
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db01_reference"), "select dt.code as ""Department_type_code"", dt.descr as ""Department_type_description"", case when dt.mct in ('01','02') then 'A&E Department' when dt.mct='03' then 'Minor Injury Unit' when dt.mct='04' then 'NHS Walk In Centre' when dt.mct='05' then dt.descr end as ""Department_type_group"" from (select '01' mct,'1' code,'Emergency Care Attendance at an Emergency Care Department Type ''Major Emergency Care Department''' descr union all select '02','2','Emergency Care Attendance at an Emergency Care Department Type ''Mono-specialty Emergency Care Department''' union all select '03','3','Emergency Care Attendance at an Emergency Care Department Type ''Urgent Treatment Centre''' union all select '04','4','NHS walk in centres' union all select '05','5','Same Day Emergency Care.') dt order by dt.code asc", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

