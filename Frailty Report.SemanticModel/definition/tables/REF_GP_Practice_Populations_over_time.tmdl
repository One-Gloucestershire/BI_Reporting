	measure locality_mildly_frail_per_1000 =
			
			--var mildly_frail_population_current = [Total_Mildly_Frail_Population_Current]
			--var locality_populations_65_plus = sum(REF_GP_Practice_Populations_over_time[Total 65+ Population]
			IF(REF_GP_Practice_Populations_over_time[Mildly_frail_population_current]<6,0, -- SUPPRESSED
			iferror((REF_GP_Practice_Populations_over_time[Mildly_frail_population_current]/REF_GP_Practice_Populations_over_time[Total_65+_Population_Current]*1000),0)
			)
		formatString: 0.00
