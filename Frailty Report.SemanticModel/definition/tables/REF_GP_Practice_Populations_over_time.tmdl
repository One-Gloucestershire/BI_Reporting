	measure 'Confidence_Limits_Upper_Frail_population_age_standaradisation_severe frailty rate per 1000 population' =
			
			
			// =========================================================================
			// Stage 1: Create base table by age band
			// =========================================================================
			
			VAR SummaryTable =
			    SUMMARIZE(
			        REF_Age_Bands,
			        REF_Age_Bands[5YR_Age_Band],
			
			        "Total_Local_Observed_Events",
			            VAR latest_month_in_range =
			                MAXX( STARTOFMONTH( LASTDATE( REF_Date[date] ) ), REF_Date[date] )
			            VAR severely_frail_local_populations_at_yearmonth_end =
