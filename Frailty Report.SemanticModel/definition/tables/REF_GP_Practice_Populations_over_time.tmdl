	measure countywide_mildly_frail_population = ```
			
			
			VAR latest_month_in_range = STARTOFMONTH(LASTDATE(REF_Date[date]))
			
			
			Var Total_Countywide_Mild_Frail_Population = CALCULATE(
			        SUM(REF_GP_Practice_Populations_over_time[mild_frailty]),
			        FILTER(
			            REF_EFI_Category,REF_EFI_Category[efi_category] = "Mild Frailty" 
			        )
			        ,all(REF_GP_Practice)
					 ,REF_GP_Practice_Populations_over_time[Census_Date] = latest_month_in_range
			    )
				
				
				Var  Total_65plus_Countywide_current_population   = 
				 CALCULATE(DISTINCTCOUNT(REF_GP_Practice_Populations_over_time[Derived_NHS_Number])
			 ,REF_GP_Practice_Populations_over_time[Census_Date] = latest_month_in_range
			 ,all(REF_EFI_Category)
			 ,all(ref_date)
			 )
			 
			return 
			 
			 Total_65plus_Countywide_current_population
			```
		formatString: 0
		lineageTag: 8563ecd2-4928-42a9-9101-9b8d37cfc0c0

	measure countywide_mildly_frail_rate_per_1000_65plus_population = ```
			
			
			    VAR LatestMonthStart =
			        DATE (
			            YEAR ( MAX ( REF_Date[date] ) ),
			            MONTH ( MAX ( REF_Date[date] ) ),
			            1
			        )
			
			    VAR Total_Countywide_Mild_Frail_Population =
			        CALCULATE (
			            SUM ( REF_GP_Practice_Populations_over_time[mild_frailty] ),
			            REF_EFI_Category[efi_category] = "Mild Frailty",
			            ALL ( REF_GP_Practice ),
			            REF_GP_Practice_Populations_over_time[Census_Date] = LatestMonthStart
			        )
			
			    VAR Total_65plus_Countywide_Current_Population =
			        CALCULATE (
			            DISTINCTCOUNT ( REF_GP_Practice_Populations_over_time[Derived_NHS_Number] ),
			            REF_GP_Practice_Populations_over_time[Census_Date] = LatestMonthStart,
			            ALL(REF_EFI_Category),
			            ALL ( REF_Date ),
			            ALL ( REF_GP_Practice )
			        )
			
			    RETURN
			        DIVIDE (
			            Total_Countywide_Mild_Frail_Population,
			            Total_65plus_Countywide_Current_Population,
			            0
			        ) * 1000
			```
