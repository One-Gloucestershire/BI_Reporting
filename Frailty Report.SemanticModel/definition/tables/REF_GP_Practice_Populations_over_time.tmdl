	measure Confidence_Limits_Upper_Mild_Frailty_Rate_per_1000 = ```
			VAR CountVariable = [Mildly_frail_population_current]
			VAR DenominatorVariable = [Total_65+_Population_Current]
			VAR ConfidenceLevel = 95
			VAR ScalingFactor = 1000
			// Approximate the Inverse of the Standard Normal Distribution
			VAR ApproxNORM_INV = 
			IF(
			 ConfidenceLevel = 95, 
			1.9599639845400500, // 95% confidence level
			 IF(
			 ConfidenceLevel = 90, 
			1.645, // 90% confidence level
			 1.28 // 80% confidence level as an example
			 )
			 )
			// Byars Calculation for Upper Bound
			RETURN
			
			if(CountVariable<6,0, -- SUPPRESSED
			
			IFERROR(
			IF(
			 CountVariable < 10, 
			iferror( (CHISQ.INV(1 - (0.5 - ConfidenceLevel / 200), 2*CountVariable+2) / 2),
			 BLANK()), 
			(CountVariable + 1) * (1 - 1 / (9 * (CountVariable + 1)) + (ApproxNORM_INV / (3 * SQRT(CountVariable + 1))))^3
			) / DenominatorVariable * ScalingFactor 
			,BLANK())
			)
			    
			```
		displayFolder: Confidence_Intervals_Frail_Population_Sheet
		lineageTag: 9d1cd7d2-3dc4-49c7-9ef8-ead7a69c9cd0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

