				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "select census_date as ""Census_Date"", derived_nhs_number as ""Derived_NHS_Number"", primarycareprovider as ""Practice_Code"", age_at_census as ""Age_at_census"", lsoa as ""LSOA"", ethnicity_code as ""Ethnicity_code"", gender as ""Gender"", efi_category as ""efi_category"", qof_dementia_flag as ""QOF_Dementia_Flag"", living_in_a_care_home as ""living_in_a_care_home"", core20flag as ""Core20Flag"", smoking_flag as ""Smoking_Flag"", case when efi_category = 'Mild Frailty' then 1 end as ""mild_frailty"", case when efi_category = 'Moderate Frailty' then 1 end as ""moderate_frailty"", case when efi_category = 'Severe Frailty' then 1 end as ""severe_frailty"" from data_mart_powerbi_ageingwell.tbl02_proactive_whiteboard_registered_population_over_time where cast(age_at_census as int) >= 65 and census_date <= (date_trunc('month', current_date) - interval '2 months')::date and derived_registered_ccg like '11M%' order by census_date, age_at_census", null, [EnableFolding=true])
