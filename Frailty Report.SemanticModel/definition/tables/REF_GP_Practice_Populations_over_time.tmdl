			                    - 1 / (9 * (O_grouped + 1))
			                    + Z / (3 * SQRT(O_grouped + 1)),
			                3
			            )
			    )
			
			/* =========================================================================
			   APHO Formula 9b – ISRupper × reference crude rate
			   ========================================================================= */
			VAR UpperCI_grouped =
			    DIVIDE(Oupper_grouped, E_grouped, 0) * RefRate_grouped
			
			/* =========================================================================
			   STEP 3A: WIDER GROUPS (same logic, different ethnicity column)
			   ========================================================================= */
			VAR SummaryTable_Wider =
			    ADDCOLUMNS(
			        SUMMARIZECOLUMNS(
			            REF_Age_Bands[5YR_Age_Band],
			            REF_Ethnicity[Ethnic Origin Wider Groups]
			        ),
			
			        "O",
			            CALCULATE(
			                SUM(REF_GP_Practice_Populations_over_time[moderate_frailty]),
			                REF_Date[date] = latest_month_in_range,
			                KEEPFILTERS(REF_Ethnicity[Ethnic Origin Wider Groups] <> BLANK())
			            ),
			
			        "N_local",
			            CALCULATE(
			                [Total_65+_Population_ot],
			                REF_Date[date] = latest_month_in_range,
			                KEEPFILTERS(REF_Ethnicity[Ethnic Origin Wider Groups] <> BLANK())
			            ),
			
			        "Ref_O",
			            CALCULATE(
			                SUM(REF_GP_Practice_Populations_over_time[moderate_frailty]),
			                REF_Date[date] = latest_month_in_range,
			                REMOVEFILTERS(REF_GP_Practice),
			                REMOVEFILTERS(REF_LSOA),
			                REMOVEFILTERS(REF_EFI_Category),
			                REMOVEFILTERS(REF_Gender),
			                REMOVEFILTERS(REF_admission_method),
			                REMOVEFILTERS(REF_Cinapsis_Pathways),
			                REMOVEFILTERS(REF_Cinapsis_Specialist_Outcome),
			                REMOVEFILTERS(REF_ED_Department_Type),
			                REMOVEFILTERS(REF_Site),
			                REMOVEFILTERS(REF_Providers),
			                KEEPFILTERS(REF_Ethnicity[Ethnic Origin Wider Groups] <> BLANK())
			            ),
			
			        "Ref_N",
			            CALCULATE(
			                [Total_65+_Population_ot],
			                REF_Date[date] = latest_month_in_range,
			                REMOVEFILTERS(REF_GP_Practice),
			                REMOVEFILTERS(REF_LSOA),
			                REMOVEFILTERS(REF_EFI_Category),
			                REMOVEFILTERS(REF_Gender),
			                REMOVEFILTERS(REF_admission_method),
			                REMOVEFILTERS(REF_Cinapsis_Pathways),
			                REMOVEFILTERS(REF_Cinapsis_Specialist_Outcome),
			                REMOVEFILTERS(REF_ED_Department_Type),
			                REMOVEFILTERS(REF_Site),
			                REMOVEFILTERS(REF_Providers),
			                KEEPFILTERS(REF_Ethnicity[Ethnic Origin Wider Groups] <> BLANK())
			            )
			    )
			
			VAR Wider_WithExpected =
			    ADDCOLUMNS(
			        SummaryTable_Wider,
			        "Expected",
			            DIVIDE([Ref_O], [Ref_N], 0) * [N_local]
			    )
			
			VAR O_wider =
			    SUMX(Wider_WithExpected, [O])
			
			VAR E_wider =
			    SUMX(Wider_WithExpected, [Expected])
			
			VAR RefRate_wider =
			    DIVIDE(
			        SUMX(Wider_WithExpected, [Ref_O]),
			        SUMX(Wider_WithExpected, [Ref_N]),
			        0
			    ) * 1000
			
			VAR Oupper_wider =
			    IF(
			        O_wider < 10,
			        0.5 * CHISQ.INV(1 - Alpha / 2, 2 * (O_wider + 1)),
			        (O_wider + 1) *
			            POWER(
			                1
			                    - 1 / (9 * (O_wider + 1))
			                    + Z / (3 * SQRT(O_wider + 1)),
			                3
			            )
			    )
			
			VAR UpperCI_wider =
			    DIVIDE(Oupper_wider, E_wider, 0) * RefRate_wider
			
			/* =========================================================================
			   STEP 4: Return hierarchy‑appropriate upper CI
			   ========================================================================= */
			RETURN
			    SWITCH(
			        TRUE(),
			        IsWiderLevel, UpperCI_wider,
			        IsGroupedLevel, UpperCI_grouped,
			        UpperCI_grouped
			    )
