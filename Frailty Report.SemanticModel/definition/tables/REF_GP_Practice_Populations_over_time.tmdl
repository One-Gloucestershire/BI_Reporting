		formatString: 0%;-0%;0%
		lineageTag: 539bd345-f031-4fbf-a5db-dc6c82bb5846

	measure total_frail_population_current =
			
			VAR Total_frail_population = (REF_GP_Practice_Populations_over_time[Mildly_frail_population_current] + REF_GP_Practice_Populations_over_time[Moderately_frail_population_current] + REF_GP_Practice_Populations_over_time[severely_frail_population_current])
			
			RETURN
			IF(Total_frail_population<6,0, -- suppressed
			IF(ISBLANK(Total_frail_population),0,Total_frail_population)
			
			)
		formatString: #,0
		lineageTag: 53d6cd35-8917-4f49-9e7d-c57cbd6ec330

	measure total_fraility_prevalence_current =
			
			
