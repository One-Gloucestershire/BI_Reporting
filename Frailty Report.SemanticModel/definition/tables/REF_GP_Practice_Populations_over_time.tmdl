table REF_GP_Practice_Populations_over_time
	lineageTag: 06fe48b5-e759-4587-86bb-9859b0c35532

	measure Latest_census_in_population_over_time_dataset = ```
			
			 calculate(MAX(REF_GP_Practice_Populations_over_time[Census_Date])
			 ,all(REF_Date))
			```
		formatString: Mmmm yyyy
		lineageTag: 7220594c-52a7-4ecc-a4ad-f2b6de95e3aa

		annotation PBI_FormatHint = {"isCustom":true}

	measure Total_moderately_frail_population_current = ```
			
			VAR Latest_available_census = [Latest_census_in_population_over_time_dataset]
			return 
			
			calculate(DISTINCTCOUNT(REF_GP_Practice_Populations_over_time[Derived_NHS_Number])
			,REF_GP_Practice_Populations_over_time[moderate_frailty] = 1
			,REF_GP_Practice_Populations_over_time[Census_Date] = Latest_available_census)
			```
		formatString: 0
		lineageTag: bc917d2e-5788-460b-904c-b5ff52da5047

	measure Total_65+_Population_Current =
			
			
			var latest_census_date = [Latest_census_in_population_over_time_dataset]
			RETURN
			
			IF( CALCULATE(DISTINCTCOUNT(REF_GP_Practice_Populations_over_time[Derived_NHS_Number])
			 ,REF_GP_Practice_Populations_over_time[Census_Date] = latest_census_date
			 ,all(REF_EFI_Category)
			 ,all(ref_date)
			 ) <6,0, -- SUPRESSED
			
			 CALCULATE(DISTINCTCOUNT(REF_GP_Practice_Populations_over_time[Derived_NHS_Number])
			 ,REF_GP_Practice_Populations_over_time[Census_Date] = latest_census_date
			 ,all(REF_EFI_Category)
			 ,all(ref_date)
			 )
			)
		formatString: 0
		lineageTag: f83c7afa-6ae3-4c31-aac9-afdd09451fd3

	measure mild_frailty_%_growth = DIVIDE(SUM(REF_GP_Practice_Populations_over_time[mild_frailty]) - [mild_frailty_py], [mild_frailty_py])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 9de1b8c4-e4e8-44b7-a32b-32e5308a9cba

	measure moderate_frailty_%_growth = DIVIDE(SUM('REF_GP_Practice_Populations_over_time'[moderate_frailty]) - [moderate_frailty_py], [moderate_frailty_py])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: b0c82307-1886-40a3-933a-c03e074a45a7

	measure severe_frailty_%_growth = DIVIDE(SUM(REF_GP_Practice_Populations_over_time[severe_frailty]) - [severe_frailty_py], [severe_frailty_py])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 11fb1ffb-36a5-444a-8d2f-efe67515b6d8

	measure Total_65+_Population_ot =
			
			DISTINCTCOUNT(REF_GP_Practice_Populations_over_time[Derived_NHS_Number])
		formatString: 0
		lineageTag: 0e57311f-7e92-4532-8b05-b81eca391d93

	measure mild_frailty_pm = SUM(REF_GP_Practice_Populations_over_time[mild_frailty])-CALCULATE(SUM(REF_GP_Practice_Populations_over_time[mild_frailty]),PREVIOUSMONTH(REF_Date[date]))
		formatString: 0
		lineageTag: ecd63c47-5f8c-4d51-9c70-89fd75be8bf5

	measure moderate_frailty_pm = SUM(REF_GP_Practice_Populations_over_time[moderate_frailty])-CALCULATE(SUM(REF_GP_Practice_Populations_over_time[moderate_frailty]),PREVIOUSMONTH(REF_Date[date]))
		formatString: 0
		lineageTag: 4b8af8db-50b0-41d9-9795-afc38195e92a

	measure severe_frailty_pm = SUM(REF_GP_Practice_Populations_over_time[severe_frailty])-CALCULATE(SUM(REF_GP_Practice_Populations_over_time[severe_frailty]),PREVIOUSMONTH(REF_Date[date]))
		formatString: 0
		lineageTag: b6a7c713-fc2a-4c7e-89ac-138840c45ec9

	measure Mildly_frail_population_current = ```
			
			var Latest_census_in_population_over_time_dataset = [Latest_census_in_population_over_time_dataset]
			var mildly_fail_population_current = 
			calculate(sum(REF_GP_Practice_Populations_over_time[mild_frailty])
			,all(REF_Date)
			,REF_GP_Practice_Populations_over_time[Census_Date] = Latest_census_in_population_over_time_dataset)
			
			RETURN
			mildly_fail_population_current
			
			--IF(mildly_fail_population_current<6,0, -- supressed
			
			--if(isblank(mildly_fail_population_current),0,mildly_fail_population_current)
			--)
			```
		formatString: #,0
		lineageTag: ea9b6870-447c-4faa-a3dc-4a12c8e05efd

	measure Moderately_frail_population_current = ```
			
			var Latest_census_in_population_over_time_dataset = [Latest_census_in_population_over_time_dataset]
			var moderately_fail_population_current = 
			calculate(sum(REF_GP_Practice_Populations_over_time[moderate_frailty])
			,all(REF_Date)
			,REF_GP_Practice_Populations_over_time[Census_Date] = Latest_census_in_population_over_time_dataset)
			
			RETURN
			moderately_fail_population_current 
			--if(moderately_fail_population_current<6,0, -- supressed
			--if(isblank(moderately_fail_population_current),0,moderately_fail_population_current)
			--)
			```
		formatString: #,0
		lineageTag: 6c70a793-ef65-4ac3-83be-727a4f30b14a

	measure severely_frail_population_current = ```
			
			var Latest_census_in_population_over_time_dataset = [Latest_census_in_population_over_time_dataset]
			var severe_fail_population_current = 
			calculate(sum(REF_GP_Practice_Populations_over_time[severe_frailty])
			,all(REF_Date)
			,REF_GP_Practice_Populations_over_time[Census_Date] = Latest_census_in_population_over_time_dataset)
			
			RETURN
			severe_fail_population_current
			
			--IF(severe_fail_population_current<6,0, --SUPPRESSED
			--if(isblank(severe_fail_population_current),0,severe_fail_population_current)
			--)
			```
		formatString: #,0
		lineageTag: cd4cd320-660a-4254-9b7b-99707616f9d3

	measure GP_population_65+_current = ```
			
			Var latest_census_date_in_population = [Latest_census_in_population_over_time_dataset]
			var GP_population = 
			calculate(DISTINCTCOUNT(REF_GP_Practice_Populations_over_time[Derived_NHS_Number])
			,all(REF_Date)
			,REF_GP_Practice_Populations_over_time[Census_Date] = latest_census_date_in_population)
			
			RETURN
			if(GP_population<6,0,
			
			if(isblank(GP_population),0,GP_population)
			
			)
			```
		formatString: #,0
		lineageTag: ee7832cd-6b07-43e0-8f02-61b425523f1f

	measure Midly_frail_per_1000_per_FY = (REF_GP_Practice_Populations_over_time[Mild_frailty_population_end_of_each_fy]/REF_GP_Practice_Populations_over_time[Total_65+_Population_at_the_end_of_each_fy])*1000
