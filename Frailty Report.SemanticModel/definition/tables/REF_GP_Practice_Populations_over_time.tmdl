			    )
			
			/* =========================================================================
			   STEP 1: Detect which ethnicity hierarchy level is currently active
			   ========================================================================= */
			VAR IsWiderLevel =
			    ISINSCOPE(REF_Ethnicity[Ethnic Origin Wider Groups])
			
			VAR IsGroupedLevel =
			    ISINSCOPE(REF_Ethnicity[Ethnic Origin Grouped])
			
			/* =========================================================================
			   STEP 2A: Build the AGE × ETHNICITY (Grouped) cell table
			   ========================================================================= */
			VAR SummaryTable_Grouped =
			    ADDCOLUMNS(
			        SUMMARIZECOLUMNS(
			            REF_Age_Bands[5YR_Age_Band],
			            REF_Ethnicity[Ethnic Origin Grouped]
			        ),
			
			        "Total_Local_Observed_Events",
			            CALCULATE(
			                SUM(REF_GP_Practice_Populations_over_time[moderate_frailty]),
			                REF_Date[date] = latest_month_in_range,
			                KEEPFILTERS(REF_Ethnicity[Ethnic Origin Grouped] <> BLANK())
			            ),
			
			        "Total_Local_Population",
			            CALCULATE(
			                [Total_65+_Population_ot],
			                REF_Date[date] = latest_month_in_range,
			                KEEPFILTERS(REF_Ethnicity[Ethnic Origin Grouped] <> BLANK())
			            ),
			
			        "Reference_Events",
			            CALCULATE(
			                SUM(REF_GP_Practice_Populations_over_time[moderate_frailty]),
			                REF_Date[date] = latest_month_in_range,
			                REMOVEFILTERS(REF_GP_Practice),
			                REMOVEFILTERS(REF_LSOA),
			                REMOVEFILTERS(REF_EFI_Category),
			                REMOVEFILTERS(REF_Gender),
			                REMOVEFILTERS(REF_admission_method),
			                REMOVEFILTERS(REF_Cinapsis_Pathways),
			                REMOVEFILTERS(REF_Cinapsis_Specialist_Outcome),
			                REMOVEFILTERS(REF_ED_Department_Type),
			                REMOVEFILTERS(REF_Site),
			                REMOVEFILTERS(REF_Providers),
			                KEEPFILTERS(REF_Ethnicity[Ethnic Origin Grouped] <> BLANK())
			            ),
			
			        "Reference_Population",
			            CALCULATE(
			                [Total_65+_Population_ot],
			                REF_Date[date] = latest_month_in_range,
			                REMOVEFILTERS(REF_GP_Practice),
			                REMOVEFILTERS(REF_LSOA),
			                REMOVEFILTERS(REF_EFI_Category),
			                REMOVEFILTERS(REF_Gender),
			                REMOVEFILTERS(REF_admission_method),
			                REMOVEFILTERS(REF_Cinapsis_Pathways),
			                REMOVEFILTERS(REF_Cinapsis_Specialist_Outcome),
			                REMOVEFILTERS(REF_ED_Department_Type),
			                REMOVEFILTERS(REF_Site),
			                REMOVEFILTERS(REF_Providers),
			                KEEPFILTERS(REF_Ethnicity[Ethnic Origin Grouped] <> BLANK())
			            )
			    )
			
			/* =========================================================================
			   STEP 2B: Add reference rate and expected local events
			   ========================================================================= */
			VAR Grouped_WithRates =
			    ADDCOLUMNS(
			        SummaryTable_Grouped,
			        "Reference_Rate", DIVIDE([Reference_Events], [Reference_Population], 0),
			        "Local_Expected_Events", DIVIDE([Reference_Events], [Reference_Population], 0) * [Total_Local_Population]
			    )
			
			/* =========================================================================
			   STEP 2C: Aggregate totals for the GROUPED version
			   ========================================================================= */
			VAR Grouped_TotalObserved =
			    SUMX(Grouped_WithRates, [Total_Local_Observed_Events])
			
			VAR Grouped_TotalExpected =
			    SUMX(Grouped_WithRates, [Local_Expected_Events])
			
			VAR Grouped_TotalReferenceEvents =
			    SUMX(Grouped_WithRates, [Reference_Events])
			
			VAR Grouped_TotalReferencePopulation =
			    SUMX(Grouped_WithRates, [Reference_Population])
			
			/* =========================================================================
			   STEP 2D: Reference crude rate
			   ========================================================================= */
			VAR Grouped_ReferenceCrudeRate =
			    DIVIDE(Grouped_TotalReferenceEvents, Grouped_TotalReferencePopulation, 0) * 1000
			
			/* =========================================================================
			   STEP 2E: LOWER confidence limit for observed count O
			   -------------------------------------------------------------------------
			   APHO / PHE method:
			   - Exact Poisson/chi-square lower limit when O < 10
			   - Byar's lower approximation when O >= 10
			   ========================================================================= */
			VAR Grouped_O_Lower =
			    IF(
			        Grouped_TotalObserved < 10,
			        IF(
			            Grouped_TotalObserved = 0,
			            0,
			            0.5 * CHISQ.INV(Alpha / 2, 2 * Grouped_TotalObserved)
			        ),
			        Grouped_TotalObserved *
			            POWER(
			                1
			                    - 1 / (9 * Grouped_TotalObserved)
			                    - Z / (3 * SQRT(Grouped_TotalObserved)),
			                3
			            )
			    )
			
			/* =========================================================================
			   STEP 2F: Convert lower observed limit to lower ISR and then lower rate
			   -------------------------------------------------------------------------
			   ISRlower = Olower / E
			   Lower CI rate = ISRlower × reference crude rate
			   ========================================================================= */
			VAR Grouped_ISR_Lower =
			    DIVIDE(Grouped_O_Lower, Grouped_TotalExpected, 0)
			
			VAR Grouped_Lower_CI_Rate =
			    Grouped_ISR_Lower * Grouped_ReferenceCrudeRate
			
			
			/* =========================================================================
			   STEP 3A: Build the AGE × ETHNICITY (Wider Groups) cell table
			   ========================================================================= */
			VAR SummaryTable_Wider =
			    ADDCOLUMNS(
			        SUMMARIZECOLUMNS(
			            REF_Age_Bands[5YR_Age_Band],
			            REF_Ethnicity[Ethnic Origin Wider Groups]
			        ),
			
			        "Total_Local_Observed_Events",
			            CALCULATE(
			                SUM(REF_GP_Practice_Populations_over_time[moderate_frailty]),
			                REF_Date[date] = latest_month_in_range,
			                KEEPFILTERS(REF_Ethnicity[Ethnic Origin Wider Groups] <> BLANK())
			            ),
			
			        "Total_Local_Population",
			            CALCULATE(
			                [Total_65+_Population_ot],
			                REF_Date[date] = latest_month_in_range,
			                KEEPFILTERS(REF_Ethnicity[Ethnic Origin Wider Groups] <> BLANK())
			            ),
			
			        "Reference_Events",
			            CALCULATE(
			                SUM(REF_GP_Practice_Populations_over_time[moderate_frailty]),
			                REF_Date[date] = latest_month_in_range,
			                REMOVEFILTERS(REF_GP_Practice),
			                REMOVEFILTERS(REF_LSOA),
			                REMOVEFILTERS(REF_EFI_Category),
			                REMOVEFILTERS(REF_Gender),
			                REMOVEFILTERS(REF_admission_method),
			                REMOVEFILTERS(REF_Cinapsis_Pathways),
			                REMOVEFILTERS(REF_Cinapsis_Specialist_Outcome),
			                REMOVEFILTERS(REF_ED_Department_Type),
			                REMOVEFILTERS(REF_Site),
			                REMOVEFILTERS(REF_Providers),
			                KEEPFILTERS(REF_Ethnicity[Ethnic Origin Wider Groups] <> BLANK())
			            ),
			
			        "Reference_Population",
			            CALCULATE(
			                [Total_65+_Population_ot],
			                REF_Date[date] = latest_month_in_range,
			                REMOVEFILTERS(REF_GP_Practice),
			                REMOVEFILTERS(REF_LSOA),
			                REMOVEFILTERS(REF_EFI_Category),
			                REMOVEFILTERS(REF_Gender),
			                REMOVEFILTERS(REF_admission_method),
			                REMOVEFILTERS(REF_Cinapsis_Pathways),
			                REMOVEFILTERS(REF_Cinapsis_Specialist_Outcome),
			                REMOVEFILTERS(REF_ED_Department_Type),
			                REMOVEFILTERS(REF_Site),
			                REMOVEFILTERS(REF_Providers),
			                KEEPFILTERS(REF_Ethnicity[Ethnic Origin Wider Groups] <> BLANK())
			            )
			    )
			
			/* =========================================================================
			   STEP 3B: Add reference rate and expected events for WIDER version
			   ========================================================================= */
			VAR Wider_WithRates =
			    ADDCOLUMNS(
			        SummaryTable_Wider,
			        "Reference_Rate", DIVIDE([Reference_Events], [Reference_Population], 0),
			        "Local_Expected_Events", DIVIDE([Reference_Events], [Reference_Population], 0) * [Total_Local_Population]
			    )
			
			/* =========================================================================
			   STEP 3C: Aggregate totals for the WIDER version
			   ========================================================================= */
			VAR Wider_TotalObserved =
			    SUMX(Wider_WithRates, [Total_Local_Observed_Events])
			
			VAR Wider_TotalExpected =
			    SUMX(Wider_WithRates, [Local_Expected_Events])
			
			VAR Wider_TotalReferenceEvents =
			    SUMX(Wider_WithRates, [Reference_Events])
			
			VAR Wider_TotalReferencePopulation =
			    SUMX(Wider_WithRates, [Reference_Population])
			
			/* =========================================================================
			   STEP 3D: Reference crude rate for WIDER version
			   ========================================================================= */
			VAR Wider_ReferenceCrudeRate =
			    DIVIDE(Wider_TotalReferenceEvents, Wider_TotalReferencePopulation, 0) * 1000
			
			/* =========================================================================
			   STEP 3E: LOWER confidence limit for observed count O (WIDER)
			   ========================================================================= */
			VAR Wider_O_Lower =
			    IF(
			        Wider_TotalObserved < 10,
			        IF(
			            Wider_TotalObserved = 0,
			            0,
			            0.5 * CHISQ.INV(Alpha / 2, 2 * Wider_TotalObserved)
			        ),
			        Wider_TotalObserved *
			            POWER(
			                1
			                    - 1 / (9 * Wider_TotalObserved)
			                    - Z / (3 * SQRT(Wider_TotalObserved)),
			                3
			            )
			    )
			
			VAR Wider_ISR_Lower =
			    DIVIDE(Wider_O_Lower, Wider_TotalExpected, 0)
			
			VAR Wider_Lower_CI_Rate =
			    Wider_ISR_Lower * Wider_ReferenceCrudeRate
			
			/* =========================================================================
			   STEP 4: Return the correct LOWER 95% CI based on hierarchy level
			   ========================================================================= */
			RETURN
			    SWITCH(
			        TRUE(),
			        IsWiderLevel, Wider_Lower_CI_Rate,
			        IsGroupedLevel, Grouped_Lower_CI_Rate,
			        Grouped_Lower_CI_Rate
			    )
		displayFolder: Frail_population_Ethnicity_age_standaradisation rate per 1000 population
		lineageTag: 1618de43-49ce-4d64-a892-e9f5f712e121

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Confidence_Limits_Upper_Frail_population_age_standaradisation_mild frailty rate per 1000 population' =
			
			
			// =========================================================================
			// Stage 1: Create base table by age band
			// =========================================================================
			
			VAR SummaryTable =
			    SUMMARIZE(
			        REF_Age_Bands,
			        REF_Age_Bands[5YR_Age_Band],
			
			        "Total_Local_Observed_Events",
			            VAR latest_month_in_range =
			                MAXX( STARTOFMONTH( LASTDATE( REF_Date[date] ) ), REF_Date[date] )
			            VAR mildly_frail_local_populations_at_yearmonth_end =
			                CALCULATE(
			                    SUM( REF_GP_Practice_Populations_over_time[mild_frailty] ),
			                    REF_Date[date] = latest_month_in_range
			                )
			            RETURN
			                mildly_frail_local_populations_at_yearmonth_end,
			
			        "Total_Local_Population",
			            VAR latest_month_in_range =
			                MAXX( STARTOFMONTH( LASTDATE( REF_Date[date] ) ), REF_Date[date] )
			            VAR total_local_65plus =
			                CALCULATE(
			                    [Total_65+_Population_ot],
			                    REMOVEFILTERS( REF_EFI_Category ),
			                    REF_Date[date] = latest_month_in_range
			                )
			            RETURN
			                total_local_65plus,
			
			        "Reference_Events",
			            VAR latest_month_in_range =
			                MAXX( STARTOFMONTH( LASTDATE( REF_Date[date] ) ), REF_Date[date] )
			            VAR mildly_frail_glos_populations_at_yearmonth_end =
			                CALCULATE(
			                    SUM( REF_GP_Practice_Populations_over_time[mild_frailty] ),
			                    REF_Date[date] = latest_month_in_range,
			                    REMOVEFILTERS( REF_GP_Practice ),
			                    REMOVEFILTERS( REF_LSOA ),
			                    REMOVEFILTERS( REF_Ethnicity ),
			                    REMOVEFILTERS( REF_EFI_Category ),
			                    REMOVEFILTERS( REF_Gender ),
			                    REMOVEFILTERS( REF_admission_method ),
			                    // keep REF_Age_Bands filter for age standardisation
			                    REMOVEFILTERS( REF_Cinapsis_Pathways ),
			                    REMOVEFILTERS( REF_Cinapsis_Specialist_Outcome ),
			                    REMOVEFILTERS( REF_ED_Department_Type ),
			                    REMOVEFILTERS( REF_Site ),
			                    REMOVEFILTERS( REF_Providers )
			                )
			            RETURN
			                mildly_frail_glos_populations_at_yearmonth_end,
			
			        "Reference_Population",
			            VAR latest_month_in_range =
			                MAXX( STARTOFMONTH( LASTDATE( REF_Date[date] ) ), REF_Date[date] )
			            VAR gloucestershire_mildly_frail_population_at_year_end =
			                CALCULATE(
			                    [Total_65+_Population_ot],
			                    REF_Date[date] = latest_month_in_range,
			                    REMOVEFILTERS( REF_GP_Practice ),
			                    REMOVEFILTERS( REF_LSOA ),
			                    REMOVEFILTERS( REF_Ethnicity ),
			                    REMOVEFILTERS( REF_EFI_Category ),
			                    REMOVEFILTERS( REF_Gender ),
			                    REMOVEFILTERS( REF_admission_method ),
			                    // keep REF_Age_Bands filter for age standardisation
			                    REMOVEFILTERS( REF_Cinapsis_Pathways ),
			                    REMOVEFILTERS( REF_Cinapsis_Specialist_Outcome ),
			                    REMOVEFILTERS( REF_ED_Department_Type ),
			                    REMOVEFILTERS( REF_Site ),
			                    REMOVEFILTERS( REF_Providers )
			                )
			            RETURN
			                gloucestershire_mildly_frail_population_at_year_end
			    )
			
			// =========================================================================
			// Stage 2: Add reference age-specific rates
			// =========================================================================
			
			VAR SummaryTable_with_reference_rates =
			    ADDCOLUMNS(
			        SummaryTable,
			        "Reference_Rates",
			            DIVIDE( [Reference_Events], [Reference_Population], 0 )
			    )
			
			// =========================================================================
			// Stage 3: Add expected local events by age band
			// =========================================================================
			
			VAR SummaryTable_with_expected =
			    ADDCOLUMNS(
			        SummaryTable_with_reference_rates,
			        "Local_Expected_Events",
			            [Reference_Rates] * [Total_Local_Population]
			    )
			
			// =========================================================================
			// Stage 4: Total observed, expected, and reference values
			// =========================================================================
			
			VAR total_observed =
			    SUMX( SummaryTable_with_expected, [Total_Local_Observed_Events] )
			
			VAR total_expected =
			    SUMX( SummaryTable_with_expected, [Local_Expected_Events] )
			
			VAR total_reference_events =
			    SUMX( SummaryTable_with_expected, [Reference_Events] )
			
			VAR total_reference_population =
			    SUMX( SummaryTable_with_expected, [Reference_Population] )
			
			// =========================================================================
			// Stage 5: Reference crude rate per 1,000
			// =========================================================================
			
			VAR reference_crude_rate =
			    DIVIDE( total_reference_events, total_reference_population, 0 ) * 1000
			
			// =========================================================================
			// Stage 6: Upper confidence limit for observed count O
			// Method:
			// - exact Poisson if O < 10
			// - Byar's approximation if O >= 10
			// =========================================================================
			
			VAR alpha = 0.05
			VAR z = 1.95996398454005
			
			VAR observed_upper_limit =
			    IF(
			        total_observed < 10,
			        0.5 * CHISQ.INV( 1 - alpha / 2, ( 2 * total_observed ) + 2 ),
			        ( total_observed + 1 ) *
			            POWER(
			                1
			                    - DIVIDE( 1, 9 * ( total_observed + 1 ), 0 )
			                    + DIVIDE( z, 3 * SQRT( total_observed + 1 ), 0 ),
			                3
			            )
			    )
			
			// =========================================================================
			// Stage 7: ISR upper = O upper / E
			// =========================================================================
			
			VAR isr_upper =
			    DIVIDE( observed_upper_limit, total_expected, 0 )
			
			// =========================================================================
			// Stage 8: Convert ISR upper to indirectly age-standardised rate upper CL
			// =========================================================================
			
			VAR indirect_age_standardised_rate_upper =
			    isr_upper * reference_crude_rate
			
			RETURN
			    indirect_age_standardised_rate_upper
		lineageTag: 21a66f0b-299a-4000-ba21-ffdac424ebd7

