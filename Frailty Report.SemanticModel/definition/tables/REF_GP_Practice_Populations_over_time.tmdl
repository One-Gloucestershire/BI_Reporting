	measure 'Frail_population_Ethnicity_age_standaradisation_mild frailty rate per 1000 population' = ```
			
			
			/* =========================================================================
			   STEP 0: Identify the latest month snapshot date
			   -------------------------------------------------------------------------
			   This measure uses a snapshot population, so we pin all local/reference
			   numerator and denominator calculations to the latest month in context.
			   ========================================================================= */
			VAR latest_month_in_range =
			    DATE(
			        YEAR(MAX(REF_Date[date])),
			        MONTH(MAX(REF_Date[date])),
			        1
			    )
			
			/* =========================================================================
			   STEP 1: Detect which ethnicity hierarchy level is currently active
			   -------------------------------------------------------------------------
			   We check the lower drill level first. This is important when using a
			   hierarchy, because the deeper level should win if the visual is drilled.
			   - Wider Groups level
			   - Grouped level
			   ========================================================================= */
			VAR IsWiderLevel =
			    ISINSCOPE(REF_Ethnicity[Ethnic Origin Wider Groups])
			
			VAR IsGroupedLevel =
			    ISINSCOPE(REF_Ethnicity[Ethnic Origin Grouped])
			
			/* =========================================================================
			   STEP 2A: Build the AGE × ETHNICITY (Grouped) cell table
			   -------------------------------------------------------------------------
			   This is the version used when the visual is sitting on
			   REF_Ethnicity[Ethnic Origin Grouped].
			
			   Each row in this virtual table is one:
			   - 5 year age band
			   - ethnic origin grouped category
			
			   For each cell we calculate:
			   - Local observed mild frailty count
			   - Local population
			   - Gloucestershire reference events
			   - Gloucestershire reference population
			   ========================================================================= */
			VAR SummaryTable_Grouped =
			    ADDCOLUMNS(
			        SUMMARIZECOLUMNS(
			            REF_Age_Bands[5YR_Age_Band],
			            REF_Ethnicity[Ethnic Origin Grouped]
			        ),
			
			        /* -------------------------------------------------------------
			           Local observed:
			           Mild frailty count in the current local filter context
			           (for example locality / PCN / practice if selected),
			           for the current age band × grouped ethnicity cell.
			           Blank ethnicity rows are excluded, but the current
			           ethnicity row is preserved using KEEPFILTERS.
			           ------------------------------------------------------------- */
			        "Total_Local_Observed_Events",
			            CALCULATE(
			                SUM(REF_GP_Practice_Populations_over_time[mild_frailty]),
			                REF_Date[date] = latest_month_in_range,
			                KEEPFILTERS(REF_Ethnicity[Ethnic Origin Grouped] <> BLANK())
			            ),
			
			        /* -------------------------------------------------------------
			           Local population:
			           Total 65+ population in the current local filter context,
			           for the current age band × grouped ethnicity cell.
			           Again, blanks are excluded without overwriting the row.
			           ------------------------------------------------------------- */
			        "Total_Local_Population",
			            CALCULATE(
			                [Total_65+_Population_ot],
			                REF_Date[date] = latest_month_in_range,
			                KEEPFILTERS(REF_Ethnicity[Ethnic Origin Grouped] <> BLANK())
			            ),
			
			        /* -------------------------------------------------------------
			           Reference events:
			           Gloucestershire mild frailty count for the same
			           age band × grouped ethnicity cell.
			
			           Geography filters are removed so the reference stays county-wide,
			           but ethnicity and age band are left in place via the row context.
			           ------------------------------------------------------------- */
			        "Reference_Events",
			            CALCULATE(
			                SUM(REF_GP_Practice_Populations_over_time[mild_frailty]),
			                REF_Date[date] = latest_month_in_range,
			                REMOVEFILTERS(REF_GP_Practice),
			                REMOVEFILTERS(REF_LSOA),
			                REMOVEFILTERS(REF_EFI_Category),
			                REMOVEFILTERS(REF_Gender),
			                REMOVEFILTERS(REF_admission_method),
			                REMOVEFILTERS(REF_Cinapsis_Pathways),
			                REMOVEFILTERS(REF_Cinapsis_Specialist_Outcome),
			                REMOVEFILTERS(REF_ED_Department_Type),
			                REMOVEFILTERS(REF_Site),
			                REMOVEFILTERS(REF_Providers),
			                KEEPFILTERS(REF_Ethnicity[Ethnic Origin Grouped] <> BLANK())
			            ),
			
			        /* -------------------------------------------------------------
			           Reference population:
			           Gloucestershire total 65+ population for the same
			           age band × grouped ethnicity cell.
			           Geography removed, ethnicity retained.
			           ------------------------------------------------------------- */
			        "Reference_Population",
			            CALCULATE(
			                [Total_65+_Population_ot],
			                REF_Date[date] = latest_month_in_range,
			                REMOVEFILTERS(REF_GP_Practice),
			                REMOVEFILTERS(REF_LSOA),
			                REMOVEFILTERS(REF_EFI_Category),
			                REMOVEFILTERS(REF_Gender),
			                REMOVEFILTERS(REF_admission_method),
			                REMOVEFILTERS(REF_Cinapsis_Pathways),
			                REMOVEFILTERS(REF_Cinapsis_Specialist_Outcome),
			                REMOVEFILTERS(REF_ED_Department_Type),
			                REMOVEFILTERS(REF_Site),
			                REMOVEFILTERS(REF_Providers),
			                KEEPFILTERS(REF_Ethnicity[Ethnic Origin Grouped] <> BLANK())
			            )
			    )
			
			/* =========================================================================
			   STEP 2B: Add reference rate and expected local events
			   -------------------------------------------------------------------------
			   For each age × grouped ethnicity cell:
			   - Reference_Rate = Gloucestershire reference events / population
			   - Local_Expected_Events = reference rate × local population
			   ========================================================================= */
			VAR Grouped_WithRates =
			    ADDCOLUMNS(
			        SummaryTable_Grouped,
			        "Reference_Rate", DIVIDE([Reference_Events], [Reference_Population], 0),
			        "Local_Expected_Events", DIVIDE([Reference_Events], [Reference_Population], 0) * [Total_Local_Population]
			    )
			
			/* =========================================================================
			   STEP 2C: Aggregate totals for the GROUPED version
			   ========================================================================= */
			VAR Grouped_TotalObserved =
			    SUMX(Grouped_WithRates, [Total_Local_Observed_Events])
			
			VAR Grouped_TotalExpected =
			    SUMX(Grouped_WithRates, [Local_Expected_Events])
			
			VAR Grouped_TotalReferenceEvents =
			    SUMX(Grouped_WithRates, [Reference_Events])
			
			VAR Grouped_TotalReferencePopulation =
			    SUMX(Grouped_WithRates, [Reference_Population])
			
			/* =========================================================================
			   STEP 2D: Final grouped-level indirectly standardised rate
			   -------------------------------------------------------------------------
			   Indirectly standardised rate =
			       (Observed / Expected) × Reference crude rate
			   ========================================================================= */
			VAR Grouped_ReferenceCrudeRate =
			    DIVIDE(Grouped_TotalReferenceEvents, Grouped_TotalReferencePopulation, 0) * 1000
			
			VAR Grouped_Result =
			    DIVIDE(Grouped_TotalObserved, Grouped_TotalExpected, 0) * Grouped_ReferenceCrudeRate
			
			
			/* =========================================================================
			   STEP 3A: Build the AGE × ETHNICITY (Wider Groups) cell table
			   -------------------------------------------------------------------------
			   This is the version used when the visual is drilled to
			   REF_Ethnicity[Ethnic Origin Wider Groups].
			
			   The logic is the same as above, but using the Wider Groups column.
			   ========================================================================= */
			VAR SummaryTable_Wider =
			    ADDCOLUMNS(
			        SUMMARIZECOLUMNS(
			            REF_Age_Bands[5YR_Age_Band],
			            REF_Ethnicity[Ethnic Origin Wider Groups]
			        ),
			
			        "Total_Local_Observed_Events",
			            CALCULATE(
			                SUM(REF_GP_Practice_Populations_over_time[mild_frailty]),
			                REF_Date[date] = latest_month_in_range,
			                KEEPFILTERS(REF_Ethnicity[Ethnic Origin Wider Groups] <> BLANK())
			            ),
			
			        "Total_Local_Population",
			            CALCULATE(
			                [Total_65+_Population_ot],
			                REF_Date[date] = latest_month_in_range,
			                KEEPFILTERS(REF_Ethnicity[Ethnic Origin Wider Groups] <> BLANK())
			            ),
			
			        "Reference_Events",
			            CALCULATE(
			                SUM(REF_GP_Practice_Populations_over_time[mild_frailty]),
			                REF_Date[date] = latest_month_in_range,
			                REMOVEFILTERS(REF_GP_Practice),
			                REMOVEFILTERS(REF_LSOA),
			                REMOVEFILTERS(REF_EFI_Category),
			                REMOVEFILTERS(REF_Gender),
			                REMOVEFILTERS(REF_admission_method),
			                REMOVEFILTERS(REF_Cinapsis_Pathways),
			                REMOVEFILTERS(REF_Cinapsis_Specialist_Outcome),
			                REMOVEFILTERS(REF_ED_Department_Type),
			                REMOVEFILTERS(REF_Site),
			                REMOVEFILTERS(REF_Providers),
			                KEEPFILTERS(REF_Ethnicity[Ethnic Origin Wider Groups] <> BLANK())
			            ),
			
			        "Reference_Population",
			            CALCULATE(
			                [Total_65+_Population_ot],
			                REF_Date[date] = latest_month_in_range,
			                REMOVEFILTERS(REF_GP_Practice),
			                REMOVEFILTERS(REF_LSOA),
			                REMOVEFILTERS(REF_EFI_Category),
			                REMOVEFILTERS(REF_Gender),
			                REMOVEFILTERS(REF_admission_method),
			                REMOVEFILTERS(REF_Cinapsis_Pathways),
			                REMOVEFILTERS(REF_Cinapsis_Specialist_Outcome),
			                REMOVEFILTERS(REF_ED_Department_Type),
			                REMOVEFILTERS(REF_Site),
			                REMOVEFILTERS(REF_Providers),
			                KEEPFILTERS(REF_Ethnicity[Ethnic Origin Wider Groups] <> BLANK())
			            )
			    )
			
			/* =========================================================================
			   STEP 3B: Add reference rate and expected events for WIDER version
			   ========================================================================= */
			VAR Wider_WithRates =
			    ADDCOLUMNS(
			        SummaryTable_Wider,
			        "Reference_Rate", DIVIDE([Reference_Events], [Reference_Population], 0),
			        "Local_Expected_Events", DIVIDE([Reference_Events], [Reference_Population], 0) * [Total_Local_Population]
			    )
			
			/* =========================================================================
			   STEP 3C: Aggregate totals for the WIDER version
			   ========================================================================= */
			VAR Wider_TotalObserved =
			    SUMX(Wider_WithRates, [Total_Local_Observed_Events])
			
			VAR Wider_TotalExpected =
			    SUMX(Wider_WithRates, [Local_Expected_Events])
			
			VAR Wider_TotalReferenceEvents =
			    SUMX(Wider_WithRates, [Reference_Events])
			
			VAR Wider_TotalReferencePopulation =
			    SUMX(Wider_WithRates, [Reference_Population])
			
			/* =========================================================================
			   STEP 3D: Final wider-level indirectly standardised rate
			   ========================================================================= */
			VAR Wider_ReferenceCrudeRate =
			    DIVIDE(Wider_TotalReferenceEvents, Wider_TotalReferencePopulation, 0) * 1000
			
			VAR Wider_Result =
			    DIVIDE(Wider_TotalObserved, Wider_TotalExpected, 0) * Wider_ReferenceCrudeRate
			
			
			/* =========================================================================
			   STEP 4: Return the correct scalar result based on the current hierarchy level
			   -------------------------------------------------------------------------
			   This is the key fix for the error you hit earlier.
			
			   We do NOT try to choose between table variables.
			   We choose between:
			   - Wider_Result   (scalar)
			   - Grouped_Result (scalar)
			
			   That keeps the measure valid and hierarchy-aware.
			   ========================================================================= */
			RETURN
			    SWITCH(
			        TRUE(),
			
			        /* If drilled to Wider Groups, use the Wider result */
			        IsWiderLevel, Wider_Result,
			
			        /* Otherwise if at Grouped level, use the Grouped result */
			        IsGroupedLevel, Grouped_Result,
			
			        /* Fallback if the visual is not on either level */
			        Grouped_Result
			    )
			
