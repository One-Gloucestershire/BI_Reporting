	partition 'Metrics Table' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "select metriccategory as ""MetricCategory"", metricname as ""MetricName"", value as ""Value"", age as ""Age"", gender as ""Gender"", cypflag as ""CYPFlag"", ldflag as ""LDFlag"", deprivation as ""Deprivation"", ethnicity as ""Ethnicity"", practicecode as ""PracticeCode"", activityyearmonth as ""ActivityYearMonth"" from data_mart_powerbi_phm.tbl05_healthinequalitiesmetrics WHERE activityyearmonth BETWEEN '201904' AND '202103' OR activityyearmonth >= '202304'", null, [EnableFolding=true])
				in
				    Source

