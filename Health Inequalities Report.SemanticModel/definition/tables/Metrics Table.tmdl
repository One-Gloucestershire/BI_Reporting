table 'Metrics Table'
	lineageTag: 9e19ec13-1638-4f24-83dc-28d557ec84f0

	measure 'Metric - Total Value' =
			
			
			SUM('Metrics Table'[Value])
		formatString: #,0
		lineageTag: 81c08242-fda4-4b17-a509-52458e8e8fce

	measure 'Metric - Total Value Crude Rate per 1,000' =
			
			
			SUM('Metrics Table'[Value])
			/
			SUM('Census Population - Gloucestershire'[Value]) * 1000
		formatString: #,0.0
		lineageTag: 7d5dc52e-255c-49a8-99d5-40fc13d6fd39

	measure 'Metric - CI Lower Bound - CRP 1,000' = ```
			
			
			VAR _STANDARD_ERROR = 
			    SQRT(
			        ([Metric - Total Value Crude Rate per 1,000] / 1000) * (1 - ([Metric - Total Value Crude Rate per 1,000] / 1000))
			        /
			        SUM('Census Population - Gloucestershire'[Value])
			    ) * 1000
			
			RETURN
			
			IF(
			    [Metric - Total Value Crude Rate per 1,000] - (1.96 * _STANDARD_ERROR) < 0,
			    0,
			    [Metric - Total Value Crude Rate per 1,000] - (1.96 * _STANDARD_ERROR)
			)
			```
		lineageTag: 6eb35f55-d767-4fb2-8707-10c14f9253a5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Metric - CI Upper Bound - CRP 1,000' = ```
			
			
			VAR _STANDARD_ERROR = 
			    SQRT(
			        ([Metric - Total Value Crude Rate per 1,000] / 1000) * (1 - ([Metric - Total Value Crude Rate per 1,000] / 1000))
			        /
			        SUM('Census Population - Gloucestershire'[Value])
			    ) * 1000
			
			RETURN
			
			[Metric - Total Value Crude Rate per 1,000] + (1.96 * _STANDARD_ERROR)
			```
		lineageTag: 6084c248-fade-4bc3-8f14-0bae3410bc4e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Metric - Total Value Crude Rate per 100,000' =
			
			
			SUM('Metrics Table'[Value])
			/
			SUM('Census Population - Gloucestershire'[Value]) * 100000
		lineageTag: 9f1e928f-642e-41f3-bddf-3b7785e72610

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Metric - Direct Age Standardisation' = ```
			
			
			VAR _SUMMARYTABLE =
			    SUMMARIZE(
			        'Age Band Reference',
			        'Age Band Reference'[5YR_Age_Band], // Age Bands //
			        "Observed Events", SUM('Metrics Table'[Value]), // Observed Events from Metrics Table //
			        "Local Population", SUM('Census Population - Gloucestershire'[Value]), // Local Population //
			        "Reference Population", SUM('European Reference Population'[population]) // Reference Population //
			    )
			    
			VAR _EXPECTED_EVENTS = 
			    ADDCOLUMNS(
			        _SUMMARYTABLE,
			        "Expected Events", [Reference Population]/[Local Population]*[Observed Events]
			    )
			
			RETURN
			
			SUMX(_EXPECTED_EVENTS, [Expected Events])
			/
			SUMX(_EXPECTED_EVENTS, [Reference Population])
			*
			1000 // Directly Standardised Rate per 1,000 //
			```
		lineageTag: 16b4cb14-f8c0-415b-b030-f2e7868a7b35

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Metric - CI Lower Bound - DSR' = ```
			
			
			VAR _STANDARD_ERROR = 
			    SQRT(
			        ([Metric - Direct Age Standardisation] / 1000) * (1 - ([Metric - Direct Age Standardisation] / 1000))
			        /
			        SUM('Census Population - Gloucestershire'[Value])
			    ) * 1000
			
			RETURN
			IFERROR(
			IF(
			    [Metric - Direct Age Standardisation] - (1.96 * _STANDARD_ERROR) < 0,
			    0,
			    [Metric - Direct Age Standardisation] - (1.96 * _STANDARD_ERROR)
			), 0)
			```
		lineageTag: a31ae363-89aa-4865-99f6-2e61b6472dc9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Metric - CI Upper Bound - CRP 100,000' = ```
			
			
			VAR _STANDARD_ERROR = 
			    SQRT(
			        ([Metric - Total Value Crude Rate per 100,000] / 100000) * (1 - ([Metric - Total Value Crude Rate per 100,000] / 100000))
