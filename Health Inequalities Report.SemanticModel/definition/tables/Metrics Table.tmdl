	measure 'Metric Selection' =
			
			
			IF(
			   ISFILTERED('Metrics Table'[MetricName])
			   && DISTINCTCOUNT('Metrics Table'[MetricName]) = 1
			  ,MAX('Metrics Table'[MetricName])
			  ,"Please Select One Metric"
			  )
		lineageTag: 9d99bbc0-75e2-4c06-9ef1-a72841cf142e

