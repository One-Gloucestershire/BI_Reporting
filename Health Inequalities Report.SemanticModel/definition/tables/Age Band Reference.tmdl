	partition 'Age Band Reference' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db01_reference"), "select distinct ""5yr_age_band"" as ""5YR_Age_Band_for_Modeling"", case when ""5yr_age_band""='0-4' then '00-04' when ""5yr_age_band""='5-9' then '05-09' else ""5yr_age_band"" end as ""5YR_Age_Band"", case when ""10yr_age_band""='0-9' then '00-09' else ""10yr_age_band"" end as ""10YR_Age_Band"" from ccg_reference.vw_ageband where age between 0 and 120", null, [EnableFolding=true])
