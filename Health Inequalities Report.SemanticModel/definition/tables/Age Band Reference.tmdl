	partition 'Age Band Reference' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Reference", [Query="SELECT DISTINCT [5YR_Age_Band_for_Modeling] = [5YR_Age_Band]#(lf)#(tab)     ,[5YR_Age_Band] = CASE WHEN [5YR_Age_Band] = '0-4' THEN '00-04'#(lf)                                      WHEN [5YR_Age_Band] = '5-9' THEN '05-09'#(lf)#(tab)                            ELSE [5YR_Age_Band] END#(lf)#(tab)     ,[10YR_Age_Band] = CASE WHEN [10YR_Age_Band] = '0-9' THEN '00-09'#(lf)#(tab)                             ELSE [10YR_Age_Band] END#(lf)#(lf)FROM [CCG_Reference].[Reference].[vw_AgeBand]#(lf) #(lf)WHERE [Age] BETWEEN 0 AND 120"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

