table 'GP Population - All Years'
	lineageTag: 683532a3-477d-492e-af54-d3048cb6b9c9

	measure '65+ Population - All Years' =
			
			
			CALCULATE(SUM('GP Population - All Years'[population]), 'Age Band Reference'[age_banding] IN {"65-69", "70-74", "75-79", "80-84", "85+"})
		lineageTag: ec46104f-17cc-408f-a343-0cab9b11b66b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '65+ Population - All Years - ICB' =
			
			
			CALCULATE(SUM('GP Population - All Years'[population]), 'Age Band Reference'[age_banding] IN {"65-69", "70-74", "75-79", "80-84", "85+"}, ALL('GP Reference'), 'GP Reference'[PrimaryCareNetwork] <> BLANK())
		lineageTag: ee999af7-0bf8-4fbe-8d26-b66142ab9df0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

