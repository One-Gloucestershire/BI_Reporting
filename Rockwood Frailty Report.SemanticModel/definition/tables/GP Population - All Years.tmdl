	partition 'GP Population - All Years' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "PowerBI_Reporting", [Query="SELECT DISTINCT [locality]#(lf)               ,[primary_care_network]#(lf)               ,[practice_name]#(lf)#(tab)#(tab)#(tab)   ,[practice_code]#(lf)               ,[age_band] = CASE WHEN [age_band] IN ('85-89', '90-94', '95+') THEN '85+' ELSE [age_band] END#(lf)#(tab)#(tab)#(tab)   ,[sex]#(lf)               ,[financial_year]#(lf)#(tab)#(tab)#(tab)   ,[population]#(lf)               ,[gp_longitude]#(lf)               ,[gp_latitude]#(lf)#(tab)#(tab)#(tab)   ,[first_date_of_month]#(lf)               ,[census_date]#(lf)#(lf)  FROM [PowerBI_Reporting].[primarycare].[tbl01_GP_Practice_Populations] AS [GPP]#(lf)#(lf)  LEFT JOIN (SELECT DISTINCT [MonthYearName], [YearMonth], [Date_Flag] = 1 FROM [CCG_Reference].[Reference].[vw_DateLookup]) AS [DATE]#(lf)  ON [DATE].[MonthYearName] = [GPP].[census_date]"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

