	measure 'RW Population' =
			
			
			CALCULATE(SUM('Rockwood Frailty Scores'[Population]), 'Age Band Reference'[age_banding] IN {"65-69", "70-74", "75-79", "80-84", "85+"})
		formatString: #,0
		lineageTag: 33350e9b-631a-457d-b909-61a1a45108e3

	measure '% Mild Frailty Difference' =
			
			
			VAR _CALC = [% Mild Frailty] - [% Mild Frailty - ICB]
			
			RETURN
			
			FORMAT(_CALC, "+0.0%;-0.0%;0.0%")
		lineageTag: 0c841b4c-f0bf-4ab4-a6b5-0d907e9095bf

	measure '% Moderate Frailty - ICB' =
			
			
			VAR FRAIL_POP = CALCULATE(SUM('Rockwood Frailty Scores'[Population]), 'Rockwood Frailty Scores'[Frailty_Type] IN {"Moderate"}, 'Age Band Reference'[age_banding] IN {"65-69", "70-74", "75-79", "80-84", "85+"}, ALL('Age Band Reference'), ALL('GP Reference'), 'GP Reference'[PrimaryCareNetwork] <> BLANK())
			
			RETURN FRAIL_POP / [65 + Population - ICB]
