	partition cinapsis_frailty_assessment-92b8fe2d-8f0d-4dd7-8ae4-e0a601972358 = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "ccg_current", [Query="select *, #(lf)  [frailty_specialist_outcome_group] = case when [specialist_outcome] like '%primary care%' then 'Manage in Primary care'#(lf)#(tab)                                     when [specialist_outcome] like '%call failed%' then 'Call Failed'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)         when [specialist_outcome] like '%Admitted%' then 'Admitted to Acute Hospital'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)     when [specialist_outcome] like '%frailty unit%' then 'To be seen in Frailty Unit'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)     when [specialist_outcome] like '%transfer to ED%' then 'Transfer to ED'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)     when [specialist_outcome] like '%community services%' then 'Refer to Community Services'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) #(tab)#(tab)#(tab)     else 'Other' end#(lf)  from [PowerBI_Reporting].[dbo].[Cinapsis]#(lf)  where [service] = 'Frailty Assessment Service'"])
				in
				    Source

	annotation PBI_ResultType = Table

