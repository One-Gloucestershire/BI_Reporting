table emergency_admissions
	lineageTag: d5cc1935-e3fa-4e48-aa2b-b95ba8bd627f

	measure mildly_frail_emg_adm = CALCULATE(COUNT('emergency_admissions'[counter]),FILTER('emergency_admissions','emergency_admissions'[efi_category] IN {"Mild Frailty"}))
		formatString: 0
		lineageTag: 5444fe3c-5879-471f-b362-8c5509299581

	measure mildly_frail_emg_adm_per_1000_current = ([mildly_frail_emg_adm]/[mildly_frail_population_current])*1000
