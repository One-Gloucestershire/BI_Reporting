	partition emergency_admissions-af9c3281-ad8b-4616-9238-da40314d1c75 = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "PowerBI_Reporting", [Query="select * from [PowerBI_Reporting].[dbo].[Inpatients]#(lf)where [age] >= '65'#(lf)and [efi_category] in ('Mild Frailty','Moderate Frailty','Severe Frailty')#(lf)"])
				in
				    Source

