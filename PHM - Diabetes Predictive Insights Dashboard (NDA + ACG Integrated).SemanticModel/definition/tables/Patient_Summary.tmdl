	partition Patient_Summary = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "ICB_Products", [Query="SELECT#(lf)    [PseudoNHSNumber],#(lf)    PracticeCode AS PLS_PracticeCode,#(lf)    PracticeName AS PLS_PracticeName,#(lf)    PrimaryCareNetwork,#(lf)    Locality,#(lf)    ICBofRegistration,#(lf)    IMDNationalDecile,#(lf)    IMDCountyDecile,#(lf)    eFICategoryDerived,#(lf)    ACGPatientNeedsGroup,#(lf)    BMI AS PLS_BMI,#(lf)    BMIGroup,#(lf)    Smoker AS PLS_Smoker,#(lf)    LTCCountDerived,#(lf)#(lf)    -- LTC condition flags#(lf)    Asthma,#(lf)    COPD,#(lf)    Dementia,#(lf)    Depression,#(lf)    Diabetes,#(lf)    PalliativeCare,#(lf)    ChronicKidneyDisease,#(lf)    Epilepsy,#(lf)    HeartFailure,#(lf)    Stroke,#(lf)    AtrialFibrillation,#(lf)    Cancer,#(lf)    CoronaryHeartDisease,#(lf)    Hypertension,#(lf)    LearningDisability,#(lf)    Obesity,#(lf)    MentalIllness#(lf)FROM [ICB_Products].[Patient].[vw_Summary];#(lf)"])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

