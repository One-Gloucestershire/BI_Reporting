	column Smoking_Label = ```
			
			VAR s = TRIM( UPPER( FORMAT('TrajectoryAnalysis'[Latest_Smoking_Value], "") ) )
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(s), "Unknown",
			    s IN { "CURRENT SMOKER", "SMOKER", "CURRENT" }, "Current Smoker",
			    s IN { "EX-SMOKER", "EX SMOKER", "PREVIOUS" }, "Ex-Smoker",
			    s IN { "NEVER", "NEVER SMOKER" }, "Never Smoked",
			    "Unknown"
			)
			
			```
		lineageTag: 51355693-140d-4e39-a701-60d4d3818303
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column HbA1c_Category = ```
			
			VAR val = VALUE('TrajectoryAnalysis'[Follow_HbA1c])
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(val), "Unknown",
			    val < 48, "<48 (Normal)",
			    val <= 58, "48–58 (Good Control)",
			    val <= 74, "59–74 (Sub-optimal)",
			    val >= 75, "≥75 (Poor Control)",
			    "Unknown"
			)
			
			```
