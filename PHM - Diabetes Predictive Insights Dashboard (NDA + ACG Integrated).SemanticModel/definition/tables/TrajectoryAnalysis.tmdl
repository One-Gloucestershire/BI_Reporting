	column Action_Act_Now = ```
			
			VAR traj = 'TrajectoryAnalysis'[Trajectory_Label]
			VAR frb  = 'TrajectoryAnalysis'[Final_Risk_Band]
			VAR prb  = 'TrajectoryAnalysis'[Predicted_Risk_Band]
			RETURN IF( (traj="Deteriorating" && frb="High Risk") || prb="Very High Risk" || prb="High Risk", 1, 0 )
			
			```
		formatString: 0
		lineageTag: 32e134b6-fdb4-46f0-b0cb-71fc09bf20d1
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Action_Review_Soon = ```
			
			IF( 'TrajectoryAnalysis'[Trajectory_Label]="Deteriorating"
			    && 'TrajectoryAnalysis'[Final_Risk_Band]="Moderate Risk", 1, 0 )
			
			```
		formatString: 0
		lineageTag: 5ce1c898-56bf-4943-8d5e-c2cea2d99806
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Action_Rapid_Improvement = ```
			
			IF( 'TrajectoryAnalysis'[Trajectory_Label]="Improved"
			    && 'TrajectoryAnalysis'[Final_Risk_Band]="Rapid Improvement", 1, 0 )
			
			
			
			
			
			
			```
		formatString: 0
		lineageTag: 9e5115c6-b980-428a-91a7-e5a3327530c9
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Action_Rising_Risk = ```
			
			VAR p = 'TrajectoryAnalysis'[Predicted_High_Risk_Probability]
			RETURN IF( p > 0.40 && p <= 0.70, 1, 0 )
			
			```
		formatString: 0
		lineageTag: ec41d5c1-5fc8-4c86-afe6-16ea5998f150
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Final_Risk_Sort = ```
			
			SWITCH(
			    'TrajectoryAnalysis'[Final_Risk_Band],
			    "High Risk", 1, "Moderate Risk", 2, "Low Risk", 3, "No Risk", 4,
			    "Rapid Improvement", 5, "Moderate Improvement", 6, "Gradual Improvement", 7,
			    "No Change", 8, "Stable", 9, "Single Reading Only", 10, 99
			)
			
			```
		formatString: 0
		lineageTag: 13acde25-e332-418c-9ff6-95145cb85207
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Predicted_Risk_Sort = ```
			
			SWITCH(
			    'TrajectoryAnalysis'[Predicted_Risk_Band],
			    "Very High Risk", 1, "High Risk", 2, "Moderate Risk", 3, "Low Risk", 4, "Below Threshold", 5, 99
			)
			
			```
		formatString: 0
		lineageTag: 6d8a60ce-32f0-451a-96ab-cc715ec209bc
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Gestational = ```
			
			VAR ageNum =
			    IFERROR( VALUE( 'TrajectoryAnalysis'[Age] ), BLANK() )
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(ageNum), BLANK(),
			    ageNum < 18, "<18",
			    ageNum <= 24, "18–24",
			    ageNum <= 29, "25–29",
			    ageNum <= 34, "30–34",
			    ageNum <= 39, "35–39",
			    ageNum <= 44, "40–44",
			    ageNum <= 49, "45–49",
			    "50+"
			)
			
			
			
			
			
			```
		lineageTag: e8362936-435a-4055-b135-5a103c1ce7a2
