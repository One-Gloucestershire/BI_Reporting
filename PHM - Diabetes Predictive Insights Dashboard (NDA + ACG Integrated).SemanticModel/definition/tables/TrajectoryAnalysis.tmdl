table TrajectoryAnalysis
	lineageTag: a3eb2ef2-d60f-4556-baf3-8f5af31ea8c6

	measure HighRiskPatientsOver70 = ```
			
			DIVIDE(
			    COUNTROWS(
			        FILTER(TrajectoryAnalysis, [Predicted_High_Risk_Probability] > 0.7)
			    ),
			    COUNTROWS(TrajectoryAnalysis)
			)
			
			```
		formatString: 0
		lineageTag: 01681518-9726-4e02-ad4d-2848cb09545f

	measure AvgHighRiskProbability = AVERAGE(TrajectoryAnalysis[Predicted_High_Risk_Probability])
		lineageTag: 982ef2a3-fe6e-4c90-94cf-dd9039049f7c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure AvgHighRiskProbability_ByPractice = ```
			
			AVERAGEX(
			    VALUES(TrajectoryAnalysis[Practice]),
			    CALCULATE(AVERAGE(TrajectoryAnalysis[Predicted_High_Risk_Probability]))
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 88a79467-9dd7-4f28-a73b-9f8a6b0368ae

	measure TopPracticeName = ```
			
			VAR TopPractice = 
			    TOPN(1, 
			        SUMMARIZE(
			            TrajectoryAnalysis, 
			            TrajectoryAnalysis[Practice], 
			            "AvgRisk", AVERAGE(TrajectoryAnalysis[Predicted_High_Risk_Probability])
			        ), 
			        [AvgRisk], 
			        DESC
			    )
			RETURN
			    MAXX(TopPractice, TrajectoryAnalysis[Practice])
			
			```
		lineageTag: 4f5b06b2-e744-45a5-b025-990472b2c7d7

	measure SingleReadingPct =
			
			DIVIDE(
			    COUNTROWS(
			        FILTER(TrajectoryAnalysis, TrajectoryAnalysis[Trajectory_Label] = "Single Reading Only")
			    ),
			    COUNTROWS(TrajectoryAnalysis)
			)
		lineageTag: 89c45404-0b4b-4aa5-9b29-3785e447bccd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Single_Reading_Due = ```
			
			VAR rowDate = SELECTEDVALUE('TrajectoryAnalysis'[Follow_HbA1c_Date])
			VAR isSingle = SELECTEDVALUE('TrajectoryAnalysis'[Trajectory_Label]) = "Single Reading Only"
			RETURN IF( isSingle && NOT ISBLANK(rowDate) && DATEDIFF(rowDate, TODAY(), DAY) >= 270, 1, 0 )
			
			```
		formatString: 0
		lineageTag: 35675214-a550-4609-a790-ed1611e04655

	measure AllPatients_Count = ```
			
			DISTINCTCOUNT('TrajectoryAnalysis'[Derived_Pseudo_NHS_Number])
			
			```
		formatString: 0
		lineageTag: 00b08061-5205-41ca-b416-a2ab8c8789ce

	measure HighRisk_Count = ```
			
			CALCULATE(
			    DISTINCTCOUNT('TrajectoryAnalysis'[Derived_Pseudo_NHS_Number]),
			    'TrajectoryAnalysis'[Final_Risk_Band] = "High Risk"
			)
			
			
			```
		formatString: 0
		lineageTag: 7687f2fe-a141-443c-9832-36a2504472f1

	measure HighRisk_per_1k =
			
			1000 * DIVIDE([HighRisk_Count], [AllPatients_Count])
		lineageTag: 802bdf3b-06cc-4f5e-b086-2f9a9f9dc56f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Patient_Count = ```
			
			COUNTROWS('TrajectoryAnalysis')
			
			```
		formatString: #,0
		lineageTag: f5379690-9e2b-4702-93b8-df73689f45e1

	measure Measure = ```
			
			COUNTROWS (
			    FILTER (
			        'TrajectoryAnalysis',
			        'TrajectoryAnalysis'[Trajectory_Label] = "Deteriorating"
			            && 'TrajectoryAnalysis'[Final_Risk_Band] = "Moderate Risk"
			    )
			)
			
			```
		formatString: 0
		lineageTag: 66936029-7e03-4ec5-a3fd-84fe98ac316f

	measure LTC_Patients_NDA = ```
			
			VAR NDA_Patients =
			    VALUES ( TrajectoryAnalysis[Derived_Pseudo_NHS_Number] )
			
			VAR Cond =
			    SELECTEDVALUE ( LTC_Conditions[LTCName] )
			
			RETURN
			SWITCH (
			    TRUE (),
			
			    Cond = "Hypertension",
			        CALCULATE (
			            DISTINCTCOUNT ( Patient_Summary[PseudoNHSNumber] ),
			            Patient_Summary[Hypertension] = 1,
			            TREATAS ( NDA_Patients, Patient_Summary[PseudoNHSNumber] )
			        ),
			
			    Cond = "Depression",
			        CALCULATE (
			            DISTINCTCOUNT ( Patient_Summary[PseudoNHSNumber] ),
			            Patient_Summary[Depression] = 1,
			            TREATAS ( NDA_Patients, Patient_Summary[PseudoNHSNumber] )
			        ),
			
			    Cond = "Diabetes",
			        CALCULATE (
			            DISTINCTCOUNT ( Patient_Summary[PseudoNHSNumber] ),
			            Patient_Summary[Diabetes] = 1,
			            TREATAS ( NDA_Patients, Patient_Summary[PseudoNHSNumber] )
			        ),
			
			    Cond = "Asthma",
			        CALCULATE (
			            DISTINCTCOUNT ( Patient_Summary[PseudoNHSNumber] ),
			            Patient_Summary[Asthma] = 1,
			            TREATAS ( NDA_Patients, Patient_Summary[PseudoNHSNumber] )
			        ),
			
			    Cond = "Chronic Kidney Disease",
			        CALCULATE (
			            DISTINCTCOUNT ( Patient_Summary[PseudoNHSNumber] ),
			            Patient_Summary[ChronicKidneyDisease] = 1,
			            TREATAS ( NDA_Patients, Patient_Summary[PseudoNHSNumber] )
			        ),
			
			    Cond = "Cancer",
			        CALCULATE (
			            DISTINCTCOUNT ( Patient_Summary[PseudoNHSNumber] ),
			            Patient_Summary[Cancer] = 1,
			            TREATAS ( NDA_Patients, Patient_Summary[PseudoNHSNumber] )
			        ),
			
			    Cond = "Coronary Heart Disease",
			        CALCULATE (
			            DISTINCTCOUNT ( Patient_Summary[PseudoNHSNumber] ),
			            Patient_Summary[CoronaryHeartDisease] = 1,
			            TREATAS ( NDA_Patients, Patient_Summary[PseudoNHSNumber] )
			        ),
			
			    Cond = "Atrial Fibrillation",
			        CALCULATE (
			            DISTINCTCOUNT ( Patient_Summary[PseudoNHSNumber] ),
			            Patient_Summary[AtrialFibrillation] = 1,
			            TREATAS ( NDA_Patients, Patient_Summary[PseudoNHSNumber] )
			        ),
			
			    Cond = "Stroke",
			        CALCULATE (
			            DISTINCTCOUNT ( Patient_Summary[PseudoNHSNumber] ),
			            Patient_Summary[Stroke] = 1,
			            TREATAS ( NDA_Patients, Patient_Summary[PseudoNHSNumber] )
			        ),
			
			    Cond = "COPD",
			        CALCULATE (
			            DISTINCTCOUNT ( Patient_Summary[PseudoNHSNumber] ),
			            Patient_Summary[COPD] = 1,
			            TREATAS ( NDA_Patients, Patient_Summary[PseudoNHSNumber] )
			        ),
			
			    Cond = "Heart Failure",
			        CALCULATE (
			            DISTINCTCOUNT ( Patient_Summary[PseudoNHSNumber] ),
			            Patient_Summary[HeartFailure] = 1,
			            TREATAS ( NDA_Patients, Patient_Summary[PseudoNHSNumber] )
			        ),
			
			    Cond = "Dementia",
			        CALCULATE (
			            DISTINCTCOUNT ( Patient_Summary[PseudoNHSNumber] ),
			            Patient_Summary[Dementia] = 1,
			            TREATAS ( NDA_Patients, Patient_Summary[PseudoNHSNumber] )
			        ),
			
			    Cond = "Mental Illness",
			        CALCULATE (
			            DISTINCTCOUNT ( Patient_Summary[PseudoNHSNumber] ),
			            Patient_Summary[MentalIllness] = 1,
			            TREATAS ( NDA_Patients, Patient_Summary[PseudoNHSNumber] )
			        ),
			
			    Cond = "Learning Disability",
			        CALCULATE (
			            DISTINCTCOUNT ( Patient_Summary[PseudoNHSNumber] ),
			            Patient_Summary[LearningDisability] = 1,
			            TREATAS ( NDA_Patients, Patient_Summary[PseudoNHSNumber] )
			        ),
			
			    Cond = "Palliative Care",
			        CALCULATE (
			            DISTINCTCOUNT ( Patient_Summary[PseudoNHSNumber] ),
			            Patient_Summary[PalliativeCare] = 1,
			            TREATAS ( NDA_Patients, Patient_Summary[PseudoNHSNumber] )
			        ),
			
			    Cond = "Epilepsy",
			        CALCULATE (
			            DISTINCTCOUNT ( Patient_Summary[PseudoNHSNumber] ),
			            Patient_Summary[Epilepsy] = 1,
			            TREATAS ( NDA_Patients, Patient_Summary[PseudoNHSNumber] )
			        ),
			
			    BLANK ()
			)
			
			```
		formatString: 0
		lineageTag: a3cf869d-a4b7-4279-8666-0a3139ab7fd1

	measure CM_TP =
			
			CALCULATE (
			    COUNTROWS ( 'TrajectoryAnalysis' ),
			    'TrajectoryAnalysis'[Predicted_High_Risk_Flag] = 1,
			    'TrajectoryAnalysis'[Observed_High_Risk_Flag] = 1
			)
		formatString: 0
		lineageTag: 1f136a92-f760-48c9-a3ea-e95599eb2337

	measure CM_FP =
			
			CALCULATE (
			    COUNTROWS ( 'TrajectoryAnalysis' ),
			    'TrajectoryAnalysis'[Predicted_High_Risk_Flag] = 1,
			    'TrajectoryAnalysis'[Observed_High_Risk_Flag] = 0
			)
		formatString: 0
		lineageTag: 268a8980-34b2-4560-aa53-27f637d722f4

	measure CM_FN =
			
			CALCULATE (
			    COUNTROWS ( 'TrajectoryAnalysis' ),
			    'TrajectoryAnalysis'[Predicted_High_Risk_Flag] = 0,
			    'TrajectoryAnalysis'[Observed_High_Risk_Flag] = 1
			)
		formatString: 0
		lineageTag: 282f58ca-84f8-4c3e-9b78-5e5daabbdc2f

	measure CM_TN =
			
			CALCULATE (
			    COUNTROWS ( 'TrajectoryAnalysis' ),
			    'TrajectoryAnalysis'[Predicted_High_Risk_Flag] = 0,
			    'TrajectoryAnalysis'[Observed_High_Risk_Flag] = 0
			)
		formatString: 0
		lineageTag: 02d2612e-5311-4ba1-841b-cdb071fc4845

	measure CM_Precision =
			
			DIVIDE ( [CM_TP], [CM_TP] + [CM_FP] )
		lineageTag: c3afa4a5-df3c-4261-aa5e-9bb7fe858d5b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure CM_Recall =
			
			DIVIDE ( [CM_TP], [CM_TP] + [CM_FN] )
		lineageTag: 98322bc6-f889-46f2-a67a-22fe01737235

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure CM_Accuracy =
			
			DIVIDE (
			    [CM_TP] + [CM_TN],
			    [CM_TP] + [CM_FP] + [CM_FN] + [CM_TN]
			)
		lineageTag: 7b4977ef-3cc2-49b6-91fe-066f28492709

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Model_Validation_Summary = ```
			
			VAR Prec = [CM_Precision]
			VAR Rec  = [CM_Recall]
			VAR Acc  = [CM_Accuracy]
			RETURN
			"Within the selected cohort, the model correctly classifies "
			& FORMAT ( Acc, "0.0%" ) & " of patients overall, identifies "
			& FORMAT ( Rec, "0.0%" ) & " of patients currently in the High Risk band, "
			& "and when it flags a patient as high risk it is correct "
			& FORMAT ( Prec, "0.0%" ) & " of the time."
			
			```
		lineageTag: 9665c691-fec6-4bda-8e94-7fa5035ec980

