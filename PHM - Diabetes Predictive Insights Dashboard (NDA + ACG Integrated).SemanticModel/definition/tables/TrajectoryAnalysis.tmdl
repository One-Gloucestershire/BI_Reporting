	partition TrajectoryAnalysis = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "Data_Mart_National_Diabetes_Audit", [Query="/* ========= 1) Core pairing & counts ========= */#(lf)WITH RankedHbA1c AS (#(lf)    SELECT#(lf)        Derived_Pseudo_NHS_Number,#(lf)        HbA1c_mmol_Value,#(lf)        HBA1C_Date,#(lf)        Diabetes_Duration,#(lf)        PCN_Code,#(lf)        -- removed Age here to avoid duplication/drift#(lf)        Clean_Sex,#(lf)        Derived_Clean_Birth_Year,#(lf)        Clean_Ethnicity,#(lf)        CURRENT_GP,#(lf)        ROW_NUMBER() OVER (PARTITION BY Derived_Pseudo_NHS_Number ORDER BY HBA1C_Date ASC)  AS RN_Start,#(lf)        ROW_NUMBER() OVER (PARTITION BY Derived_Pseudo_NHS_Number ORDER BY HBA1C_Date DESC) AS RN_End#(lf)    FROM [Data_Mart_National_Diabetes_Audit].[NDA].[core_NDA]#(lf)    WHERE HbA1c_mmol_Value IS NOT NULL#(lf)      AND Clean_Diabetes_Type NOT IN ('1', '01')#(lf)),#(lf)ReadingCounts AS (#(lf)    SELECT#(lf)        Derived_Pseudo_NHS_Number,#(lf)        COUNT(*) AS HbA1c_Readings_Count#(lf)    FROM [Data_Mart_National_Diabetes_Audit].[NDA].[core_NDA]#(lf)    WHERE HbA1c_mmol_Value IS NOT NULL#(lf)      AND Clean_Diabetes_Type NOT IN ('1', '01')#(lf)    GROUP BY Derived_Pseudo_NHS_Number#(lf)),#(lf)Base AS (#(lf)    SELECT * FROM RankedHbA1c WHERE RN_Start = 1#(lf)),#(lf)FollowUp AS (#(lf)    SELECT * FROM RankedHbA1c WHERE RN_End   = 1#(lf))#(lf)#(lf)/* ========= 2) Latest value CTEs ========= */#(lf), LatestSmoking AS (#(lf)    SELECT Derived_Pseudo_NHS_Number,#(lf)           Clean_Smoking_Value AS Latest_Smoking_Value,#(lf)           Clean_Smoking_Date  AS Latest_Smoking_Date#(lf)    FROM (#(lf)        SELECT c.Derived_Pseudo_NHS_Number,#(lf)               c.Clean_Smoking_Value,#(lf)               c.Clean_Smoking_Date,#(lf)               ROW_NUMBER() OVER (#(lf)                   PARTITION BY c.Derived_Pseudo_NHS_Number#(lf)                   ORDER BY c.Clean_Smoking_Date DESC, c.HBA1C_Date DESC#(lf)               ) AS rn#(lf)        FROM [Data_Mart_National_Diabetes_Audit].[NDA].[core_NDA] c#(lf)        WHERE c.Clean_Smoking_Value IS NOT NULL#(lf)           OR c.Clean_Smoking_Date  IS NOT NULL#(lf)    ) x#(lf)    WHERE rn = 1#(lf)),#(lf)LatestBMI AS (#(lf)    SELECT Derived_Pseudo_NHS_Number,#(lf)           BMI              AS Latest_BMI,#(lf)           BMI_Date         AS Latest_BMI_Date#(lf)    FROM (#(lf)        SELECT c.Derived_Pseudo_NHS_Number,#(lf)               c.BMI,#(lf)               c.BMI_Date,#(lf)               ROW_NUMBER() OVER (#(lf)                   PARTITION BY c.Derived_Pseudo_NHS_Number#(lf)                   ORDER BY c.BMI_Date DESC#(lf)               ) AS rn#(lf)        FROM [Data_Mart_National_Diabetes_Audit].[NDA].[core_NDA] c#(lf)        WHERE c.BMI IS NOT NULL#(lf)           OR c.BMI_Date IS NOT NULL#(lf)    ) x#(lf)    WHERE rn = 1#(lf)),#(lf)LatestBP AS (#(lf)    SELECT Derived_Pseudo_NHS_Number,#(lf)           Systolic_Value          AS Latest_Systolic_Value,#(lf)           Diastolic_Value         AS Latest_Diastolic_Value,#(lf)           BP_Date                 AS Latest_BP_Date,#(lf)           [BP<=140/80_TT]         AS Latest_BP_Target_Achieved#(lf)    FROM (#(lf)        SELECT c.Derived_Pseudo_NHS_Number,#(lf)               c.Systolic_Value,#(lf)               c.Diastolic_Value,#(lf)               c.BP_Date,#(lf)               c.[BP<=140/80_TT],#(lf)               ROW_NUMBER() OVER (#(lf)                   PARTITION BY c.Derived_Pseudo_NHS_Number#(lf)                   ORDER BY c.BP_Date DESC#(lf)               ) AS rn#(lf)        FROM [Data_Mart_National_Diabetes_Audit].[NDA].[core_NDA] c#(lf)        WHERE c.BP_Date IS NOT NULL#(lf)    ) x#(lf)    WHERE rn = 1#(lf)),#(lf)LatestChol AS (#(lf)    SELECT Derived_Pseudo_NHS_Number,#(lf)           Cholesterol_Value_Total AS Latest_Cholesterol_Total,#(lf)           Cholesterol_Date_Total  AS Latest_Cholesterol_Date,#(lf)           [CHOL_TOTAL_<5]         AS Latest_CHOL_TOTAL_lt5,#(lf)           [CHOL_TOTAL_<4]         AS Latest_CHOL_TOTAL_lt4#(lf)    FROM (#(lf)        SELECT c.Derived_Pseudo_NHS_Number,#(lf)               c.Cholesterol_Value_Total,#(lf)               c.Cholesterol_Date_Total,#(lf)               c.[CHOL_TOTAL_<5],#(lf)               c.[CHOL_TOTAL_<4],#(lf)               ROW_NUMBER() OVER (#(lf)                   PARTITION BY c.Derived_Pseudo_NHS_Number#(lf)                   ORDER BY c.Cholesterol_Date_Total DESC#(lf)               ) AS rn#(lf)        FROM [Data_Mart_National_Diabetes_Audit].[NDA].[core_NDA] c#(lf)        WHERE c.Cholesterol_Date_Total IS NOT NULL#(lf)    ) x#(lf)    WHERE rn = 1#(lf)),#(lf)LatestIMD AS (#(lf)    SELECT Derived_Pseudo_NHS_Number,#(lf)           IMD_Quintile#(lf)    FROM (#(lf)        SELECT c.Derived_Pseudo_NHS_Number,#(lf)               c.IMD_Quintile,#(lf)               ROW_NUMBER() OVER (#(lf)                   PARTITION BY c.Derived_Pseudo_NHS_Number#(lf)                   ORDER BY c.HBA1C_Date DESC#(lf)               ) AS rn#(lf)        FROM [Data_Mart_National_Diabetes_Audit].[NDA].[core_NDA] c#(lf)        WHERE c.IMD_Quintile IS NOT NULL#(lf)    ) x#(lf)    WHERE rn = 1#(lf)),#(lf)LatestFrailty AS (#(lf)    SELECT Derived_Pseudo_NHS_Number,#(lf)           Frailty,#(lf)           Frailty_Date#(lf)    FROM (#(lf)        SELECT c.Derived_Pseudo_NHS_Number,#(lf)               c.Frailty,#(lf)               c.Frailty_Date,#(lf)               ROW_NUMBER() OVER (#(lf)                   PARTITION BY c.Derived_Pseudo_NHS_Number#(lf)                   ORDER BY COALESCE(c.Frailty_Date, c.HBA1C_Date) DESC#(lf)               ) AS rn#(lf)        FROM [Data_Mart_National_Diabetes_Audit].[NDA].[core_NDA] c#(lf)        WHERE c.Frailty IS NOT NULL#(lf)           OR c.Frailty_Date IS NOT NULL#(lf)    ) x#(lf)    WHERE rn = 1#(lf)),#(lf)LatestStatin AS (#(lf)    SELECT Derived_Pseudo_NHS_Number,#(lf)           Statin_Flag#(lf)    FROM (#(lf)        SELECT c.Derived_Pseudo_NHS_Number,#(lf)               c.Statin_Flag,#(lf)               ROW_NUMBER() OVER (#(lf)                   PARTITION BY c.Derived_Pseudo_NHS_Number#(lf)                   ORDER BY COALESCE(c.Cholesterol_Date_Total, c.HBA1C_Date) DESC#(lf)               ) AS rn#(lf)        FROM [Data_Mart_National_Diabetes_Audit].[NDA].[core_NDA] c#(lf)        WHERE c.Statin_Flag IS NOT NULL#(lf)    ) x#(lf)    WHERE rn = 1#(lf)),#(lf)LatestIHD AS (#(lf)    SELECT Derived_Pseudo_NHS_Number,#(lf)           Clean_IHD_Value#(lf)    FROM (#(lf)        SELECT c.Derived_Pseudo_NHS_Number,#(lf)               c.Clean_IHD_Value,#(lf)               ROW_NUMBER() OVER (#(lf)                   PARTITION BY c.Derived_Pseudo_NHS_Number#(lf)                   ORDER BY COALESCE(c.Creatinine_Date, c.HBA1C_Date) DESC#(lf)               ) AS rn#(lf)        FROM [Data_Mart_National_Diabetes_Audit].[NDA].[core_NDA] c#(lf)        WHERE c.Clean_IHD_Value IS NOT NULL#(lf)    ) x#(lf)    WHERE rn = 1#(lf)),#(lf)LatestCVD AS (#(lf)    SELECT Derived_Pseudo_NHS_Number,#(lf)           CVD_Admission#(lf)    FROM (#(lf)        SELECT c.Derived_Pseudo_NHS_Number,#(lf)               c.CVD_Admission,#(lf)               ROW_NUMBER() OVER (#(lf)                   PARTITION BY c.Derived_Pseudo_NHS_Number#(lf)                   ORDER BY COALESCE(c.HBA1C_Date, c.BP_Date, c.Cholesterol_Date_Total) DESC#(lf)               ) AS rn#(lf)        FROM [Data_Mart_National_Diabetes_Audit].[NDA].[core_NDA] c#(lf)        WHERE c.CVD_Admission IS NOT NULL#(lf)    ) x#(lf)    WHERE rn = 1#(lf)),#(lf)LatestCare AS (#(lf)    SELECT Derived_Pseudo_NHS_Number,#(lf)           All_8_Care_Processes,#(lf)           All_9_Care_Processes#(lf)    FROM (#(lf)        SELECT c.Derived_Pseudo_NHS_Number,#(lf)               c.All_8_Care_Processes,#(lf)               c.All_9_Care_Processes,#(lf)               ROW_NUMBER() OVER (#(lf)                   PARTITION BY c.Derived_Pseudo_NHS_Number#(lf)                   ORDER BY COALESCE(c.HBA1C_Date, c.BP_Date, c.Cholesterol_Date_Total) DESC#(lf)               ) AS rn#(lf)        FROM [Data_Mart_National_Diabetes_Audit].[NDA].[core_NDA] c#(lf)        WHERE c.All_8_Care_Processes IS NOT NULL#(lf)           OR c.All_9_Care_Processes IS NOT NULL#(lf)    ) x#(lf)    WHERE rn = 1#(lf)),#(lf)LatestRemission AS (#(lf)    SELECT Derived_Pseudo_NHS_Number,#(lf)           Remission,#(lf)           Remission_Date#(lf)    FROM (#(lf)        SELECT c.Derived_Pseudo_NHS_Number,#(lf)               c.Remission,#(lf)               c.Remission_Date,#(lf)               ROW_NUMBER() OVER (#(lf)                   PARTITION BY c.Derived_Pseudo_NHS_Number#(lf)                   ORDER BY c.Remission_Date DESC#(lf)               ) AS rn#(lf)        FROM [Data_Mart_National_Diabetes_Audit].[NDA].[core_NDA] c#(lf)        WHERE c.Remission IS NOT NULL#(lf)           OR c.Remission_Date IS NOT NULL#(lf)    ) x#(lf)    WHERE rn = 1#(lf))#(lf)#(lf)/* ========= 3) Score & assemble ========= */#(lf), Scored AS (#(lf)    SELECT#(lf)        b.Derived_Pseudo_NHS_Number,#(lf)        b.CURRENT_GP,#(lf)        b.PCN_Code,#(lf)#(lf)        /* Age anchored to the follow-up (or base) date for accuracy */#(lf)        DATEDIFF(YEAR, DATEFROMPARTS(b.Derived_Clean_Birth_Year, 7, 1), COALESCE(f.HBA1C_Date, b.HBA1C_Date))#(lf)          - CASE WHEN DATEFROMPARTS(b.Derived_Clean_Birth_Year, 7, 1) > COALESCE(f.HBA1C_Date, b.HBA1C_Date)#(lf)                 THEN 1 ELSE 0 END AS Age,#(lf)#(lf)        b.Clean_Sex,#(lf)        b.Derived_Clean_Birth_Year,#(lf)        b.Clean_Ethnicity,#(lf)#(lf)        b.HbA1c_mmol_Value AS Base_HbA1c,#(lf)        b.HBA1C_Date       AS Base_HbA1c_Date,#(lf)        f.HbA1c_mmol_Value AS Follow_HbA1c,#(lf)        f.HBA1C_Date       AS Follow_HbA1c_Date,#(lf)        rc.HbA1c_Readings_Count,#(lf)#(lf)        DATEDIFF(DAY, b.HBA1C_Date, f.HBA1C_Date) AS Days_Between_Readings,#(lf)#(lf)        (f.HbA1c_mmol_Value - b.HbA1c_mmol_Value) AS HbA1c_Change,#(lf)#(lf)        /* Display % change to 1 d.p.; T-SQL ROUND uses “half away from zero” */#(lf)        CASE#(lf)            WHEN b.HbA1c_mmol_Value IS NOT NULL AND b.HbA1c_mmol_Value <> 0#(lf)            THEN ROUND(((f.HbA1c_mmol_Value - b.HbA1c_mmol_Value) * 100.0) / b.HbA1c_mmol_Value, 1)#(lf)            ELSE NULL#(lf)        END AS HbA1c_Percent_Change_Display,#(lf)#(lf)        CASE#(lf)            WHEN rc.HbA1c_Readings_Count = 1 OR f.HbA1c_mmol_Value IS NULL THEN 'Single Reading Only'#(lf)            WHEN (f.HbA1c_mmol_Value - b.HbA1c_mmol_Value) > 0 THEN 'Deteriorating'#(lf)            WHEN (f.HbA1c_mmol_Value - b.HbA1c_mmol_Value) < 0 THEN 'Improved'#(lf)            ELSE 'Stable'#(lf)        END AS Trajectory_Label,#(lf)#(lf)        (#(lf)            FLOOR(ABS((f.HbA1c_mmol_Value - b.HbA1c_mmol_Value) * 100.0 / NULLIF(b.HbA1c_mmol_Value,0)) / 5)#(lf)            + CASE WHEN DATEDIFF(DAY, b.HBA1C_Date, f.HBA1C_Date) <= 180 THEN 5 ELSE 0 END#(lf)        ) AS HbA1c_Score,#(lf)#(lf)        ls.Latest_Smoking_Value,#(lf)        lbmi.Latest_BMI,#(lf)        lbp.Latest_Systolic_Value,#(lf)        lchol.Latest_Cholesterol_Total,#(lf)        limd.IMD_Quintile,#(lf)        lfrail.Frailty,#(lf)        lstatin.Statin_Flag,#(lf)        lihd.Clean_IHD_Value,#(lf)        lcvd.CVD_Admission,#(lf)        lcare.All_8_Care_Processes,#(lf)        lcare.All_9_Care_Processes,#(lf)        lrem.Remission#(lf)#(lf)    FROM Base b#(lf)    LEFT JOIN FollowUp f#(lf)      ON b.Derived_Pseudo_NHS_Number = f.Derived_Pseudo_NHS_Number#(lf)    LEFT JOIN ReadingCounts rc#(lf)      ON b.Derived_Pseudo_NHS_Number = rc.Derived_Pseudo_NHS_Number#(lf)    LEFT JOIN LatestSmoking   ls      ON b.Derived_Pseudo_NHS_Number = ls.Derived_Pseudo_NHS_Number#(lf)    LEFT JOIN LatestBMI       lbmi    ON b.Derived_Pseudo_NHS_Number = lbmi.Derived_Pseudo_NHS_Number#(lf)    LEFT JOIN LatestBP        lbp     ON b.Derived_Pseudo_NHS_Number = lbp.Derived_Pseudo_NHS_Number#(lf)    LEFT JOIN LatestChol      lchol   ON b.Derived_Pseudo_NHS_Number = lchol.Derived_Pseudo_NHS_Number#(lf)    LEFT JOIN LatestIMD       limd    ON b.Derived_Pseudo_NHS_Number = limd.Derived_Pseudo_NHS_Number#(lf)    LEFT JOIN LatestFrailty   lfrail  ON b.Derived_Pseudo_NHS_Number = lfrail.Derived_Pseudo_NHS_Number#(lf)    LEFT JOIN LatestStatin    lstatin ON b.Derived_Pseudo_NHS_Number = lstatin.Derived_Pseudo_NHS_Number#(lf)    LEFT JOIN LatestIHD       lihd    ON b.Derived_Pseudo_NHS_Number = lihd.Derived_Pseudo_NHS_Number#(lf)    LEFT JOIN LatestCVD       lcvd    ON b.Derived_Pseudo_NHS_Number = lcvd.Derived_Pseudo_NHS_Number#(lf)    LEFT JOIN LatestCare      lcare   ON b.Derived_Pseudo_NHS_Number = lcare.Derived_Pseudo_NHS_Number#(lf)    LEFT JOIN LatestRemission lrem    ON b.Derived_Pseudo_NHS_Number = lrem.Derived_Pseudo_NHS_Number#(lf))#(lf)#(lf)/* ========= 4) Final output ========= */#(lf)SELECT *,#(lf)    CASE#(lf)        WHEN HbA1c_Readings_Count = 1 THEN 'Single Reading Only'#(lf)        WHEN HbA1c_Change = 0 THEN 'Stable'#(lf)        WHEN Trajectory_Label = 'Deteriorating' THEN#(lf)            CASE#(lf)                WHEN HbA1c_Score >= 10 THEN 'High Risk'#(lf)                WHEN HbA1c_Score BETWEEN 5 AND 9 THEN 'Moderate Risk'#(lf)                WHEN HbA1c_Score BETWEEN 1 AND 4 THEN 'Low Risk'#(lf)                ELSE 'Stable' -- defensive, should be unreachable if change > 0#(lf)            END#(lf)        WHEN Trajectory_Label = 'Improved' THEN#(lf)            CASE#(lf)                WHEN HbA1c_Score >= 10 THEN 'Rapid Improvement'#(lf)                WHEN HbA1c_Score BETWEEN 5 AND 9 THEN 'Moderate Improvement'#(lf)                WHEN HbA1c_Score BETWEEN 1 AND 4 THEN 'Gradual Improvement'#(lf)                ELSE 'Stable' -- defensive, should be unreachable if change < 0#(lf)            END#(lf)        ELSE 'Stable'#(lf)    END AS Final_Risk_Band#(lf)FROM Scored#(lf)ORDER BY HbA1c_Change DESC;#(lf)"]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Follow_HbA1c", Int64.Type}, {"HbA1c_Change", Int64.Type}}),
				    #"Merged Queries" = Table.NestedJoin(#"Changed Type", {"CURRENT_GP"}, #"GP Practice Reference", {"OrganisationCode"}, "GP Practice Reference", JoinKind.LeftOuter),
				    #"Expanded GP Practice Reference" = Table.ExpandTableColumn(#"Merged Queries", "GP Practice Reference", {"ReportingOrganisationName"}, {"GP Practice Reference.ReportingOrganisationName"}),
				    #"Renamed Columns" = Table.RenameColumns(#"Expanded GP Practice Reference",{{"GP Practice Reference.ReportingOrganisationName", "Practice"}}),
				    #"Run Python script" = Python.Execute("import pandas as pd#(lf)import numpy as np#(lf)#(lf)from sklearn.ensemble import RandomForestClassifier#(lf)from sklearn.compose import ColumnTransformer#(lf)from sklearn.impute import SimpleImputer#(lf)from sklearn.preprocessing import OneHotEncoder#(lf)from sklearn.pipeline import Pipeline#(lf)from sklearn.model_selection import train_test_split#(lf)from sklearn.metrics import roc_auc_score, confusion_matrix#(lf)#(lf)# =========================================#(lf)# CONFIG: fast, explainable, Power BI safe#(lf)# =========================================#(lf)RANDOM_STATE        = 42#(lf)FAST_MAX_TRAIN_ROWS = 20000     # cap training rows; set None to use all#(lf)FAST_TEST_SIZE      = 0.20#(lf)FAST_N_ESTIMATORS   = 150#(lf)FAST_MAX_DEPTH      = 6#(lf)FAST_MIN_LEAF       = 50#(lf)FAST_CLASS_WEIGHT   = ""balanced_subsample""#(lf)#(lf)# Risk band thresholds on P(High Risk)#(lf)TH_VERY_HIGH = 0.85#(lf)TH_HIGH      = 0.70#(lf)TH_MODERATE  = 0.50#(lf)TH_LOW       = 0.30#(lf)#(lf)# Optional ""borderline"" rising-risk window (between Moderate & High cutoffs)#(lf)RISING_LOW, RISING_HIGH = 0.50, 0.70#(lf)#(lf)# =========================================#(lf)# 1) Defensive setup (Power BI supplies `dataset`)#(lf)# =========================================#(lf)# Assumes `dataset` is your final SQL output:#(lf)#   - Includes: Age, HbA1c_Percent_Change_Display, Days_Between_Readings,#(lf)#     Latest_BMI, IMD_Quintile, Clean_Ethnicity, Clean_Sex,#(lf)#     Latest_Smoking_Value, Trajectory_Label, Final_Risk_Band, etc.#(lf)#(lf)dataset = dataset.copy()#(lf)#(lf)required_cols = [#(lf)    ""Age"",#(lf)    ""HbA1c_Percent_Change_Display"",#(lf)    ""Days_Between_Readings"",#(lf)    ""Latest_BMI"",#(lf)    ""IMD_Quintile"",#(lf)    ""Clean_Ethnicity"",#(lf)    ""Clean_Sex"",#(lf)    ""Latest_Smoking_Value"",#(lf)    ""Trajectory_Label"",#(lf)    ""Final_Risk_Band""#(lf)]#(lf)#(lf)for col in required_cols:#(lf)    if col not in dataset.columns:#(lf)        dataset[col] = pd.NA#(lf)#(lf)# =========================================#(lf)# 2) Feature engineering (aligned to NDA fields)#(lf)# =========================================#(lf)#(lf)def sex_to_male(s):#(lf)    if pd.isna(s):#(lf)        return np.nan#(lf)    s = str(s).strip().upper()#(lf)    if s in (""M"", ""MALE""):#(lf)        return 1#(lf)    if s in (""F"", ""FEMALE""):#(lf)        return 0#(lf)    return np.nan#(lf)#(lf)def map_ethnicity(e):#(lf)    if pd.isna(e):#(lf)        return ""Unknown / Not stated""#(lf)    e = str(e).strip().lower()#(lf)    if ""white"" in e:#(lf)        return ""White""#(lf)    if ""asian"" in e:#(lf)        return ""Asian / Asian British""#(lf)    if ""black"" in e:#(lf)        return ""Black / Black British""#(lf)    if ""mixed"" in e or ""other"" in e:#(lf)        return ""Mixed / Other""#(lf)    return ""Unknown / Not stated""#(lf)#(lf)def map_smoking(v):#(lf)    if pd.isna(v):#(lf)        return ""Unknown""#(lf)    v = str(v).strip().lower()#(lf)    if ""current"" in v or v == ""smoker"":#(lf)        return ""Current""#(lf)    if ""ex"" in v:#(lf)        return ""Ex-smoker""#(lf)    if ""never"" in v:#(lf)        return ""Never""#(lf)    return ""Unknown""#(lf)#(lf)# Derived features#(lf)dataset[""Sex_Male""]        = dataset[""Clean_Sex""].apply(sex_to_male)#(lf)dataset[""Ethnicity_Group""] = dataset[""Clean_Ethnicity""].apply(map_ethnicity)#(lf)dataset[""Smoking_Group""]   = dataset[""Latest_Smoking_Value""].apply(map_smoking)#(lf)#(lf)# Coerce numerics (robust against stray strings)#(lf)numeric_features = [#(lf)    ""Age"",#(lf)    ""HbA1c_Percent_Change_Display"",#(lf)    ""Days_Between_Readings"",#(lf)    ""Latest_BMI"",#(lf)    ""IMD_Quintile"",#(lf)    ""Sex_Male""#(lf)]#(lf)#(lf)for c in numeric_features:#(lf)    dataset[c] = pd.to_numeric(dataset[c], errors=""coerce"")#(lf)#(lf)categorical_features = [""Ethnicity_Group"", ""Smoking_Group""]#(lf)#(lf)# =========================================#(lf)# 3) Build training set (exclude Single Reading Only)#(lf)# =========================================#(lf)#(lf)# Use only patients with trajectories for training#(lf)dataset_model = dataset[dataset[""Trajectory_Label""] != ""Single Reading Only""].copy()#(lf)#(lf)# Binary target: observed High Risk from rule-based Final_Risk_Band#(lf)y_full = (dataset_model[""Final_Risk_Band""] == ""High Risk"").astype(int)#(lf)#(lf)X_full = dataset_model[numeric_features + categorical_features].copy()#(lf)#(lf)# Optional: cap rows for speed (stratified on outcome, if possible)#(lf)if FAST_MAX_TRAIN_ROWS is not None and len(dataset_model) > FAST_MAX_TRAIN_ROWS:#(lf)    pos = dataset_model[y_full == 1]#(lf)    neg = dataset_model[y_full == 0]#(lf)#(lf)    frac = FAST_MAX_TRAIN_ROWS / len(dataset_model)#(lf)#(lf)    pos_keep = max(1, int(len(pos) * frac))#(lf)    neg_keep = max(1, FAST_MAX_TRAIN_ROWS - pos_keep)#(lf)#(lf)    pos_sample = pos.sample(#(lf)        n=min(pos_keep, len(pos)), random_state=RANDOM_STATE#(lf)    )#(lf)    neg_sample = neg.sample(#(lf)        n=min(neg_keep, len(neg)), random_state=RANDOM_STATE#(lf)    )#(lf)#(lf)    dataset_model = (#(lf)        pd.concat([pos_sample, neg_sample], axis=0)#(lf)        .sample(frac=1.0, random_state=RANDOM_STATE)#(lf)    )#(lf)#(lf)    y_full = (dataset_model[""Final_Risk_Band""] == ""High Risk"").astype(int)#(lf)    X_full = dataset_model[numeric_features + categorical_features].copy()#(lf)#(lf)# =========================================#(lf)# 4) Preprocessing + model#(lf)# =========================================#(lf)#(lf)num_pipe = Pipeline(steps=[#(lf)    (""imputer"", SimpleImputer(strategy=""median"")),#(lf)])#(lf)#(lf)cat_pipe = Pipeline(steps=[#(lf)    (""imputer"", SimpleImputer(strategy=""most_frequent"")),#(lf)    (""onehot"", OneHotEncoder(handle_unknown=""ignore""))#(lf)])#(lf)#(lf)preprocess = ColumnTransformer(#(lf)    transformers=[#(lf)        (""num"", num_pipe, numeric_features),#(lf)        (""cat"", cat_pipe, categorical_features),#(lf)    ],#(lf)    remainder=""drop""#(lf))#(lf)#(lf)rf = RandomForestClassifier(#(lf)    n_estimators=FAST_N_ESTIMATORS,#(lf)    max_depth=FAST_MAX_DEPTH,#(lf)    min_samples_leaf=FAST_MIN_LEAF,#(lf)    class_weight=FAST_CLASS_WEIGHT,#(lf)    random_state=RANDOM_STATE,#(lf)    n_jobs=-1,#(lf))#(lf)#(lf)clf = Pipeline(steps=[#(lf)    (""preprocess"", preprocess),#(lf)    (""rf"", rf),#(lf)])#(lf)#(lf)# =========================================#(lf)# 5) Fit + evaluation#(lf)# =========================================#(lf)#(lf)# Default: no decile thresholds until we compute them#(lf)decile_thresholds = None#(lf)#(lf)if X_full.shape[0] >= 10 and y_full.sum() > 0 and y_full.sum() < len(y_full):#(lf)    X_train, X_test, y_train, y_test = train_test_split(#(lf)        X_full,#(lf)        y_full,#(lf)        test_size=FAST_TEST_SIZE,#(lf)        stratify=y_full,#(lf)        random_state=RANDOM_STATE#(lf)    )#(lf)else:#(lf)    # If too small / single-class, fit on all and skip proper evaluation#(lf)    X_train, y_train = X_full, y_full#(lf)    X_test,  y_test  = X_full, y_full#(lf)#(lf)clf.fit(X_train, y_train)#(lf)#(lf)# Evaluation only if we have a meaningful test set#(lf)if X_test.shape[0] > 0 and y_test.nunique() == 2:#(lf)    y_proba_test = clf.predict_proba(X_test)[:, 1]#(lf)#(lf)    # 1) ROC AUC#(lf)    auc = roc_auc_score(y_test, y_proba_test)#(lf)    print(""Test ROC AUC:"", round(auc, 3))#(lf)#(lf)    # 2) Confusion matrix at operational threshold TH_HIGH#(lf)    y_pred_test = (y_proba_test >= TH_HIGH).astype(int)#(lf)    tn, fp, fn, tp = confusion_matrix(y_test, y_pred_test).ravel()#(lf)    print(f""Confusion matrix @ threshold {TH_HIGH}:"")#(lf)    print(f""TP: {tp}, FP: {fp}, FN: {fn}, TN: {tn}"")#(lf)#(lf)    # 3) Decile thresholds (for calibration / lift plots)#(lf)    eval_df = pd.DataFrame({#(lf)        ""y_true"": y_test.values,#(lf)        ""y_proba"": y_proba_test#(lf)    })#(lf)#(lf)    # Rank-based deciles (1 = lowest, 10 = highest)#(lf)    eval_df[""Decile""] = (#(lf)        eval_df[""y_proba""]#(lf)        .rank(method=""first"", pct=True)#(lf)        .apply(lambda x: min(10, int(np.ceil(x * 10))))#(lf)    )#(lf)#(lf)    # For assigning deciles to all patients, use max prob per decile as boundary#(lf)    decile_thresholds = (#(lf)        eval_df#(lf)        .groupby(""Decile"")[""y_proba""]#(lf)        .max()#(lf)        .reset_index()#(lf)        .sort_values(""Decile"")#(lf)        .values.tolist()#(lf)    )#(lf)else:#(lf)    print(""Model evaluation skipped: insufficient rows or class variation."")#(lf)#(lf)# =========================================#(lf)# 6) Score ALL patients (including Single Reading Only)#(lf)# =========================================#(lf)#(lf)X_all = dataset[numeric_features + categorical_features].copy()#(lf)pred_proba_all = clf.predict_proba(X_all)[:, 1]#(lf)pred_class_all = (pred_proba_all >= TH_HIGH).astype(int)#(lf)#(lf)dataset[""Predicted_High_Risk_Probability""] = pred_proba_all#(lf)#(lf)dataset[""Predicted_Class""] = np.where(#(lf)    pred_class_all == 1,#(lf)    ""High Risk"",#(lf)    ""Not High Risk""#(lf))#(lf)#(lf)# Probability-based risk bands (model overlay)#(lf)def classify_predicted_risk(p):#(lf)    if pd.isna(p):#(lf)        return ""Below Threshold""#(lf)    if p > TH_VERY_HIGH:#(lf)        return ""Very High Risk""#(lf)    elif p > TH_HIGH:#(lf)        return ""High Risk""#(lf)    elif p > TH_MODERATE:#(lf)        return ""Moderate Risk""#(lf)    elif p > TH_LOW:#(lf)        return ""Low Risk""#(lf)    else:#(lf)        return ""Below Threshold""#(lf)#(lf)dataset[""Predicted_Risk_Band""] = dataset[#(lf)    ""Predicted_High_Risk_Probability""#(lf)].apply(classify_predicted_risk)#(lf)#(lf)# Rising risk: highlight borderline probabilities#(lf)def rising_flag(p):#(lf)    if pd.isna(p):#(lf)        return ""—""#(lf)    return ""Rising Risk"" if (p >= RISING_LOW and p < RISING_HIGH) else ""—""#(lf)#(lf)dataset[""Rising_Risk_Flag""] = dataset[#(lf)    ""Predicted_High_Risk_Probability""#(lf)].apply(rising_flag)#(lf)#(lf)# Trajectory flag for visuals#(lf)dataset[""Single_Reading_Flag""] = dataset[""Trajectory_Label""].apply(#(lf)    lambda x: ""Single Reading Only"" if x == ""Single Reading Only"" else ""Has Trajectory""#(lf))#(lf)#(lf)# =========================================#(lf)# 7) Assign risk deciles (for calibration visuals in Power BI)#(lf)# =========================================#(lf)#(lf)def assign_decile_from_thresholds(p, thresholds):#(lf)    if pd.isna(p):#(lf)        return np.nan#(lf)    # thresholds is list like [[1, max_p_dec1], [2, max_p_dec2], ...]#(lf)    for decile, t in thresholds:#(lf)        if p <= t:#(lf)            return int(decile)#(lf)    return 10#(lf)#(lf)if decile_thresholds is not None and len(decile_thresholds) >= 2:#(lf)    # Use test-set-based thresholds if available#(lf)    dataset[""Predicted_Risk_Decile""] = dataset[#(lf)        ""Predicted_High_Risk_Probability""#(lf)    ].apply(lambda p: assign_decile_from_thresholds(p, decile_thresholds))#(lf)else:#(lf)    # Fallback: derive deciles directly from all predictions#(lf)    try:#(lf)        # qcut may fail if not enough unique values; handle gracefully#(lf)        valid = dataset[""Predicted_High_Risk_Probability""].dropna()#(lf)        if valid.nunique() > 1:#(lf)            dataset.loc[valid.index, ""Predicted_Risk_Decile""] = pd.qcut(#(lf)                valid,#(lf)                q=10,#(lf)                labels=False,#(lf)                duplicates=""drop""#(lf)            ) + 1#(lf)        else:#(lf)            dataset[""Predicted_Risk_Decile""] = np.nan#(lf)    except Exception:#(lf)        dataset[""Predicted_Risk_Decile""] = np.nan#(lf)#(lf)# =========================================#(lf)# 8) Return to Power BI#(lf)# =========================================#(lf)output = dataset#(lf)",[dataset=#"Renamed Columns"]),
				    dataset = #"Run Python script"{[Name="dataset"]}[Value],
				    #"Changed Type1" = Table.TransformColumnTypes(dataset,{{"Latest_BMI", type number}, {"Latest_Smoking_Value", Int64.Type}}),
				    #"Rounded Off" = Table.TransformColumns(#"Changed Type1",{{"Latest_BMI", each Number.Round(_, 1), type number}}),
				    #"Changed Type2" = Table.TransformColumnTypes(#"Rounded Off",{{"Latest_Systolic_Value", Int64.Type}, {"Latest_Cholesterol_Total", type number}}),
				    #"Rounded Off1" = Table.TransformColumns(#"Changed Type2",{{"Latest_Cholesterol_Total", each Number.Round(_, 1), type number}}),
				    #"Changed Type3" = Table.TransformColumnTypes(#"Rounded Off1",{{"IMD_Quintile", Int64.Type}, {"Frailty", Int64.Type}, {"Statin_Flag", Int64.Type}, {"Predicted_High_Risk_Probability", type number}}),
				    #"Rounded Off2" = Table.TransformColumns(#"Changed Type3",{{"Predicted_High_Risk_Probability", each Number.Round(_, 2), type number}}),
				    #"Changed Type4" = Table.TransformColumnTypes(#"Rounded Off2",{{"Base_HbA1c", Int64.Type}}),
				    #"Replaced Value" = Table.ReplaceValue(#"Changed Type4",null,0,Replacer.ReplaceValue,{"Frailty", "Statin_Flag"}),
				    #"Changed Type5" = Table.TransformColumnTypes(#"Replaced Value",{{"Frailty", Int64.Type}, {"Statin_Flag", Int64.Type}})
				in
				    #"Changed Type5"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

