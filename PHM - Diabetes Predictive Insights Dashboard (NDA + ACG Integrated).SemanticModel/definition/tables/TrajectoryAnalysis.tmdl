	column LTC_List = ```
			
			VAR LTCs =
			    UNION (
			        ROW ( "Name", "Asthma",                 "Has", RELATED ( Patient_Summary[Asthma] ) ),
			        ROW ( "Name", "COPD",                   "Has", RELATED ( Patient_Summary[COPD] ) ),
			        ROW ( "Name", "Dementia",               "Has", RELATED ( Patient_Summary[Dementia] ) ),
			        ROW ( "Name", "Depression",             "Has", RELATED ( Patient_Summary[Depression] ) ),
			        ROW ( "Name", "Diabetes",               "Has", RELATED ( Patient_Summary[Diabetes] ) ),
			        ROW ( "Name", "Palliative Care",        "Has", RELATED ( Patient_Summary[PalliativeCare] ) ),
			        ROW ( "Name", "Chronic Kidney Disease", "Has", RELATED ( Patient_Summary[ChronicKidneyDisease] ) ),
			        ROW ( "Name", "Epilepsy",               "Has", RELATED ( Patient_Summary[Epilepsy] ) ),
			        ROW ( "Name", "Heart Failure",          "Has", RELATED ( Patient_Summary[HeartFailure] ) ),
			        ROW ( "Name", "Stroke",                 "Has", RELATED ( Patient_Summary[Stroke] ) ),
			        ROW ( "Name", "Atrial Fibrillation",    "Has", RELATED ( Patient_Summary[AtrialFibrillation] ) ),
			        ROW ( "Name", "Cancer",                 "Has", RELATED ( Patient_Summary[Cancer] ) ),
			        ROW ( "Name", "Coronary Heart Disease", "Has", RELATED ( Patient_Summary[CoronaryHeartDisease] ) ),
			        ROW ( "Name", "Hypertension",           "Has", RELATED ( Patient_Summary[Hypertension] ) ),
			        ROW ( "Name", "Learning Disability",    "Has", RELATED ( Patient_Summary[LearningDisability] ) ),
			         ROW ( "Name", "Obesity",               "Has", RELATED ( Patient_Summary[Obesity] ) ),
			        ROW ( "Name", "Mental Illness",         "Has", RELATED ( Patient_Summary[MentalIllness] ) )
			    )
			
			VAR LTCsWithFlag =
			    ADDCOLUMNS (
			        LTCs,
			        "HasNumeric",
			            IF (
			                NOT ISBLANK ( [Has] ) &&
			                [Has] <> 0,
			                1,
			                0
			            )
			    )
			
			VAR HasLTCs =
			    FILTER ( LTCsWithFlag, [HasNumeric] = 1 )
			
			RETURN
			IF (
			    COUNTROWS ( HasLTCs ) = 0,
			    BLANK(),
			    CONCATENATEX ( HasLTCs, [Name], ", " )
			)
			
			```
		lineageTag: 306b58a1-e324-421b-95f2-12237987e43f
		summarizeBy: none

