		annotation SummarizationSetBy = Automatic

	column Clean_Sex_Label = ```
			
			SWITCH(
			    TRUE(),
			    VALUE('TrajectoryAnalysis'[Clean_Sex]) = 1, "Male",
			    VALUE('TrajectoryAnalysis'[Clean_Sex]) = 2, "Female",
			    BLANK()
			)
			
			
