	partition 'FoD Cohorts' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "BIReports", [Query="SELECT DISTINCT [PseudoNHSNo]#(lf)           --      ,[Rockwood_Frailty] = CASE WHEN [Value1] IN ('0','1') THEN 'Very Fit'#(lf)#(tab)#(tab)#(tab)#(tab)       --                     WHEN [Value1] IN ('2') THEN 'Well'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)--WHEN [Value1] IN ('3') THEN 'Managing Well'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)--WHEN [Value1] IN ('4') THEN 'Vulnerable'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)--WHEN [Value1] IN ('5') THEN 'Mildly Frail'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)--WHEN [Value1] IN ('6') THEN 'Moderately Frail'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)--WHEN [Value1] IN ('7') THEN 'Severely Frail'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)--WHEN [Value1] IN ('8') THEN 'Very Severely Frail'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)--WHEN [Value1] IN ('9') THEN 'Terminally Ill' ELSE 'Not Recorded' END#(lf)  INTO #TEMP#(lf)  FROM [CCG_Current].[PrimaryCare].[vw_Events] WHERE ([EventCode] COLLATE SQL_Latin1_General_CP1_CS_AS IN ('XaQik')#(lf)                                               OR [SnomedCode] = '763264000')#(lf)  ;#(lf)#(lf)  SELECT DISTINCT [Derived_Pseudo_NHS]#(lf)                 ,[LSOA code]#(lf)                 ,[Current District Ward name 2021]#(lf)#(tab)#(tab)#(tab)#(tab) ,[District]#(lf)#(tab)#(tab)#(tab)#(tab) ,[DementiaDerived] = CASE WHEN [DementiaDerived] IS NULL THEN 'Not Diagnosed'#(lf)#(tab)#(tab)#(tab)#(tab)                           WHEN [DementiaDerived] = 0 THEN 'Not Diagnosed'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN [DementiaDerived] = 1 THEN 'Dementia Diagnosed' END#(lf)#(tab)#(tab)#(tab)#(tab) ,[eFI_Catgory_derived]#(lf)#(tab)#(tab)#(tab)#(tab) ,[65+_Flag] = CASE WHEN [Derived_Age] >= 65 THEN '65+' ELSE '>65' END#(lf)#(tab)#(tab)#(tab)#(tab) --,[Rockwood_Frailty] = CASE WHEN [B].[Rockwood_Frailty] IS NULL THEN 'Not Recorded'#(lf)#(tab)#(tab)#(tab)#(tab) --                           ELSE [B].[Rockwood_Frailty] END#(lf)#(lf)  FROM [BIReports].[MPI].[MPI_current] [A]#(lf)#(lf)  LEFT JOIN #TEMP [B] ON [B].[PseudoNHSNo] = [A].[Derived_Pseudo_NHS]#(lf)#(lf)  WHERE [LSOA code] IS NOT NULL#(lf)  AND [CCG_Of_Registration] = '11M'#(lf)  AND [District] IS NOT NULL"])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

