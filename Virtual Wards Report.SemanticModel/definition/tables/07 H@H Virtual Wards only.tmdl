table '07 H@H Virtual Wards only'
	lineageTag: 742d9ce4-eab6-43d9-9f00-6c90f8a5df31

	measure 'VW H@H LATEST WEEK' = CALCULATE(SUM('07 H@H Virtual Wards only'[Counter]), '07 H@H Virtual Wards only'[Latest_Full_Week_flag] = 1, '07 H@H Virtual Wards only'[Contact_during_stay_flag] = 1) +0
		formatString: 0
		lineageTag: 6ab54478-a1bc-40a8-a0fa-9a650ec09deb

	measure 'VW H@H LATEST 4WEEK' = (CALCULATE(SUM('07 H@H Virtual Wards only'[Counter]), '07 H@H Virtual Wards only'[Latest_4Full_Week_flag] = 1, '07 H@H Virtual Wards only'[Contact_during_stay_flag] = 1) /4) +0
		lineageTag: 3a01e43c-7a1a-4556-a401-d819bb646cd8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'VW H@H PREVIOUS 4WEEK' = (CALCULATE(SUM('07 H@H Virtual Wards only'[Counter]), '07 H@H Virtual Wards only'[Previous_4Full_Week_flag] = 1, '07 H@H Virtual Wards only'[Contact_during_stay_flag] = 1) /4) +0
		lineageTag: 34f431dc-b131-4624-8961-3f046c93bd1e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure H@H_Contacts_for_VW_Patients_Time_Series_Title = ```
			
			VAR _TypeHasOne     = HASONEVALUE ( '07 H@H Virtual Wards only'[Virtual_Ward_Type])
			VAR _TypeIsFiltered = ISFILTERED ( '07 H@H Virtual Wards only'[Virtual_Ward_Type] )
			VAR _WardHasOne     = HASONEVALUE ( '07 H@H Virtual Wards only'[admitting_ward] )
			VAR _WardIsFiltered = ISFILTERED ( '07 H@H Virtual Wards only'[admitting_ward] )
			
			VAR _TypeName = SELECTEDVALUE ( '07 H@H Virtual Wards only'[Virtual_Ward_Type], "Unknown" )
			VAR _WardName = SELECTEDVALUE ( '07 H@H Virtual Wards only'[admitting_ward], "Unknown" )
			
			RETURN
			SWITCH (
			    TRUE(),
			
			    // 1) If a single ward is selected (regardless of type selection), show the ward name
			    _WardHasOne,
			        "Trend of Hospital @ Home Contacts for " & _WardName & "patients only" ,
			
			    // 2) A single type selected and wards NOT filtered: show that type )
			    _TypeHasOne && NOT _WardIsFiltered,
			        "Trend of Hospital @ Home Contacts for " & _TypeName & " patients only" ,
			
			    // 3) A single type selected AND wards filtered (multiple): selected wards within that type
			    _TypeHasOne && _WardIsFiltered && NOT _WardHasOne,
			        "Trend of Hospital @ Home Contacts for " & _TypeName & "patients only",
			
			    // 4) Multiple types selected (any ward state): generic selected
			    _TypeIsFiltered && NOT _TypeHasOne,
			        "Trend of Hospital @ Home Contacts for selected Virtual Ward patients only",
			
			    // 5) Wards filtered (multiple) but type not filtered: generic selected
			    _WardIsFiltered && NOT _WardHasOne,
			        "Trend of Hospital @ Home Contacts for selected Virtual Ward patients only",
			
			    // 6) No filters at all
			    "Trend of Hospital @ Home Contacts for all Virtual Ward patients only"
			)
			
			
			```
		lineageTag: 93429bfc-9bbc-480d-8897-a1a2051bb0c1

