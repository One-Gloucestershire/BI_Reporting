	column Is_Complete_Latest_Week_Flag =
			
			VAR MaxWeek =
			    CALCULATE(
			        MAX('07 H@H Virtual Wards only'[Week_Ending_Sunday]),
			        ALL('07 H@H Virtual Wards only')
			    )
			VAR NumDaysInMaxWeek =
			    CALCULATE(
			        DISTINCTCOUNT('07 H@H Virtual Wards only'[ContactDate]),
			        FILTER(
			            ALL('07 H@H Virtual Wards only'),
			            '07 H@H Virtual Wards only'[Week_Ending_Sunday] = MaxWeek
			        )
			    )
			RETURN
			    IF (
			        '07 H@H Virtual Wards only'[Week_Ending_Sunday] = MaxWeek && NumDaysInMaxWeek < 7,
			        0,
			        1
			    )
		formatString: 0
		lineageTag: 4af209d5-7e0d-49d0-ba93-fdded951aedf
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Latest_Full_Week_flag = ```
			
			VAR MaxFullWeek = 
			    CALCULATE(
			        MAX('07 H@H Virtual Wards only'[Week_Ending_Sunday]),
			        FILTER(
			            '07 H@H Virtual Wards only',
			            '07 H@H Virtual Wards only'[Is_Complete_Latest_Week_Flag] = 1
			        )
			    )
			
			RETURN 
			IF('07 H@H Virtual Wards only'[Week_Ending_Sunday] = MaxFullWeek, 1, 0)
			
			
			```
		formatString: 0
		lineageTag: 4c41a85a-42d9-4953-8aee-d28decbf67dd
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Previous_Full_Week_Flag =
			
			VAR LatestFullWeek =
			    CALCULATE(
			        MAX('07 H@H Virtual Wards only'[Week_Ending_Sunday]),
			        FILTER(
			            '07 H@H Virtual Wards only',
			            '07 H@H Virtual Wards only'[Is_Complete_Latest_Week_Flag] = 1
			        )
			    )
			VAR PreviousWeek = LatestFullWeek - 7
			RETURN
			IF('07 H@H Virtual Wards only'[Week_Ending_Sunday] = PreviousWeek, 1, 0)
		formatString: 0
		lineageTag: 150cd5d4-07b6-4050-9565-65f2a6510147
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'VW H@H PREVIOUS WEEK' = CALCULATE(SUM('07 H@H Virtual Wards only'[Counter]), '07 H@H Virtual Wards only'[Previous_Full_Week_Flag] = 1, '07 H@H Virtual Wards only'[Contact_during_stay_flag] = 1) +0
		formatString: 0
		lineageTag: a1913999-19bc-4118-86f0-9673d587fa5c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Latest_4Full_Week_flag = ```
			
			VAR LatestWeek = 
			    CALCULATE(
			        MAX('07 H@H Virtual Wards only'[Week_Ending_Sunday]),
			        '07 H@H Virtual Wards only'[Is_Complete_Latest_Week_Flag] = 1,
			        ALL('07 H@H Virtual Wards only') 
			    )
			VAR PreviousWeek = LatestWeek - 7
			VAR TwoWeeksAgo = LatestWeek - 14
			VAR ThreeWeeksAgo = LatestWeek - 21
			RETURN
			    IF (
			        '07 H@H Virtual Wards only'[Week_Ending_Sunday] IN {LatestWeek, PreviousWeek, TwoWeeksAgo, ThreeWeeksAgo},
			        1,
			        0
			    )
			```
		formatString: 0
		lineageTag: da7bf50d-09ef-4ad6-9b8a-eeb183c8c594
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Previous_4Full_Week_flag = ```
			
			VAR LatestWeek = 
			    CALCULATE(
			        MAX('07 H@H Virtual Wards only'[Week_Ending_Sunday]),
			        '07 H@H Virtual Wards only'[Is_Complete_Latest_Week_Flag] = 1,
			        ALL('07 H@H Virtual Wards only') 
			    )
			VAR Fourweeksago = LatestWeek - 28
			VAR FiveWeeksAgo = LatestWeek - 35
			VAR SixWeeksAgo = LatestWeek - 42
			VAR SevenWeeksAgo = LatestWeek - 49
			RETURN
			    IF (
			        '07 H@H Virtual Wards only'[Week_Ending_Sunday] IN {Fourweeksago, FiveWeeksAgo, SixWeeksAgo, SevenWeeksAgo},
			        1,
			        0
			    )
			```
		formatString: 0
		lineageTag: 45801899-88e0-4c08-a877-249e6916c793
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

