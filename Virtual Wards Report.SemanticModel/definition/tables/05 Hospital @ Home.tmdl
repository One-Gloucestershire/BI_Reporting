	column Previous_Full_Week_Flag = ```
			
			VAR LatestFullWeek =
			    CALCULATE(
			        MAX('05 Hospital @ Home'[Week_Ending_Sunday]),
			        FILTER(
			            '05 Hospital @ Home',
			            '05 Hospital @ Home'[Is_Complete_Latest_Week_Flag] = 1
			        )
			    )
			VAR PreviousWeek = LatestFullWeek - 7
			RETURN
			IF('05 Hospital @ Home'[Week_Ending_Sunday] = PreviousWeek, 1, 0)
			
			```
		formatString: 0
		lineageTag: cbda7aeb-77a0-4744-9892-dc90c247d1a8
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Latest_4Full_Week_flag = ```
			
			VAR LatestWeek = 
			    CALCULATE(
			        MAX('05 Hospital @ Home'[Week_Ending_Sunday]),
			        '05 Hospital @ Home'[Is_Complete_Latest_Week_Flag] = 1,
			        ALL('05 Hospital @ Home') 
			    )
			VAR PreviousWeek = LatestWeek - 7
			VAR TwoWeeksAgo = LatestWeek - 14
			VAR ThreeWeeksAgo = LatestWeek - 21
			RETURN
			    IF (
			        '05 Hospital @ Home'[Week_Ending_Sunday] IN {LatestWeek, PreviousWeek, TwoWeeksAgo, ThreeWeeksAgo},
			        1,
			        0
			    )
			
			```
		formatString: 0
		lineageTag: eddb0d1f-bf30-46ac-a755-013638bdb0f7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

