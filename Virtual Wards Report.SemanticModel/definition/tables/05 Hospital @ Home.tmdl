	column 'LSOA Code'
		dataType: string
		lineageTag: 41b8da97-7f39-42ab-b2df-b8637ba841eb
		summarizeBy: none
		sourceColumn: LSOA Code

		annotation SummarizationSetBy = Automatic

	column Is_Complete_Latest_Week_Flag =
			
			VAR MaxWeek =
			    CALCULATE(
			        MAX('05 Hospital @ Home'[Week_Ending_Sunday]),
			        ALL('05 Hospital @ Home')
			    )
			VAR NumDaysInMaxWeek =
			    CALCULATE(
			        DISTINCTCOUNT('05 Hospital @ Home'[ContactDate]),
			        FILTER(
			            ALL('05 Hospital @ Home'),
			            '05 Hospital @ Home'[Week_Ending_Sunday] = MaxWeek
			        )
			    )
			RETURN
			    IF (
			        '05 Hospital @ Home'[Week_Ending_Sunday] = MaxWeek && NumDaysInMaxWeek < 7,
			        0,
			        1
			    )
		formatString: 0
		lineageTag: 90d1cbdc-9cd5-435b-adc9-9693d5aac35f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Previous_4Full_Week_flag = ```
			
			VAR LatestWeek = 
			    CALCULATE(
			        MAX('05 Hospital @ Home'[Week_Ending_Sunday]),
			        '05 Hospital @ Home'[Is_Complete_Latest_Week_Flag] = 1,
			        ALL('05 Hospital @ Home') 
			    )
			VAR Fourweeksago = LatestWeek - 28
			VAR FiveWeeksAgo = LatestWeek - 35
			VAR SixWeeksAgo = LatestWeek - 42
			VAR SevenWeeksAgo = LatestWeek - 49
			RETURN
			    IF (
			        '05 Hospital @ Home'[Week_Ending_Sunday] IN {Fourweeksago, FiveWeeksAgo, SixWeeksAgo, SevenWeeksAgo},
			        1,
			        0
			    )
			
			```
		formatString: 0
		lineageTag: 89516220-7810-4b35-9aa4-6058126ea6ad
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

