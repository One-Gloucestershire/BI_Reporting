table '05 Hospital @ Home'
	lineageTag: 749ce3c2-c895-47d8-8a7b-01a9165c8aee

	measure 'Full Week Flag' = ```
			
			VAR ThisWeek = SELECTEDVALUE('05 Hospital @ Home'[Week_Ending_Sunday])
			VAR NumDays = 
			    CALCULATE(
			        DISTINCTCOUNT('05 Hospital @ Home'[ContactDate]),  -- or AdmissionDate if that’s more accurate
			        '05 Hospital @ Home'[Week_Ending_Sunday]= ThisWeek
			    )
			RETURN IF(NumDays = 7, 1, 0)
			```
		formatString: 0
		lineageTag: 58512fa1-fbcb-4c22-b212-47255d9b196e

	measure 'H@H LATEST WEEK' = CALCULATE(SUM('05 Hospital @ Home'[Counter]), '05 Hospital @ Home'[Latest_Full_Week_flag] = 1) +0
		formatString: 0
		lineageTag: 441fb2aa-1c7f-4f11-bc12-a9a8ace07803

	measure 'H@H PREVIOUS WEEK' = CALCULATE(SUM('05 Hospital @ Home'[Counter]), '05 Hospital @ Home'[Previous_Full_Week_Flag] = 1) +0
		formatString: 0
		lineageTag: 6e1727da-2974-4758-aaaf-528adbb8154a

	measure 'H@H LATEST 4WEEK' = (CALCULATE(SUM('05 Hospital @ Home'[Counter]), '05 Hospital @ Home'[Latest_4Full_Week_flag] = 1) /4) +0
		formatString: 0
		lineageTag: 3e85607e-ea8b-4627-8a96-9d386abddeb2

	measure 'H@H PREVIOUS 4WEEK' = (CALCULATE(SUM('05 Hospital @ Home'[Counter]), '05 Hospital @ Home'[Previous_4Full_Week_flag] = 1) /4)+0
		formatString: 0
		lineageTag: 654c7dbf-ef28-4dbf-919c-292f5c24e12a

	measure Latest_Full_Week_Date_hah = ```
			
			VAR _week = CALCULATE(MAX('05 Hospital @ Home'[Week_Ending_Sunday]), 
			FILTER('05 Hospital @ Home', '05 Hospital @ Home'[Is_Complete_Latest_Week_Flag] = 1) ) 
			
			RETURN 
			FORMAT(_week, "dd mmmm yyyy")
			```
		lineageTag: a6e80fd2-b4b3-47a9-abd7-35c82e942362

