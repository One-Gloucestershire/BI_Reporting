table '03 Discharge'
	lineageTag: 087f43a3-9771-4a92-ad3c-c75b655ed5dd

	measure LOS_AVERAGE = AVERAGE('03 Discharge'[length_of_stay_days])
		lineageTag: c9a547a0-90c6-4e86-9cf3-2ffa794990b9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure DISCH_LOS_LATEST_WEEK = CALCULATE([LOS_AVERAGE],  '03 Discharge'[FLAG_latest_weekend_dis] = 1) +0
		lineageTag: 9f9ea752-aa60-42e1-9d7b-9655a4316f4a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure DISCH_LOS_PREVIOUS_WEEK =
			CALCULATE(AVERAGE('03 Discharge'[length_of_stay_days]),
			 '03 Discharge'[FLAG_previous_weekend_dis] = 1 ) +0
		lineageTag: 066ed8b3-a48d-4127-98ab-5083efe5d3f2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure DISCH__USUAL%_LATEST_WEEK = CALCULATE(DIVIDE(CALCULATE(SUM('03 Discharge'[discharge_counter]), '03 Discharge'[discharge_destination_code] = "19"), SUM('03 Discharge'[discharge_counter])), '03 Discharge'[FLAG_latest_weekend_dis] = 1) +0
		formatString: 0
		lineageTag: 34a9128a-664c-4f5f-8646-1fcd3cc2e472

	measure DISCH__USUAL%_PREVIOUS_WEEK = CALCULATE(DIVIDE(CALCULATE(SUM('03 Discharge'[discharge_counter]), '03 Discharge'[discharge_destination_code] = "19"), SUM('03 Discharge'[discharge_counter])), '03 Discharge'[FLAG_previous_weekend_dis] = 1) +0
		lineageTag: 8fd60260-2e64-43c5-acb0-31cafa0616d5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure DISCH_LATEST_WEEK = ```
			
