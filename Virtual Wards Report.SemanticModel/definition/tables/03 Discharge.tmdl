	column FLAG_latest_weekend_dis =
			
			IF('03 Discharge'[Discharge_Week_Ending_Sunday] = MAX('03 Discharge'[Discharge_Week_Ending_Sunday]), 1, 0)
		formatString: 0
		lineageTag: 2bda729c-0c94-451c-a26f-96f353862186
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column FLAG_previous_weekend_dis =
			
			IF('03 Discharge'[Discharge_Week_Ending_Sunday] = MAX('03 Discharge'[Discharge_Week_Ending_Sunday]) -7, 1, 0)
		formatString: 0
		lineageTag: a6206caa-488b-48fe-ab3a-8b77432153d6
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column FLAG_latest_4week_dis =
			
			VAR LatestWeek = MAX('03 Discharge'[Discharge_Week_Ending_Sunday])
			VAR PreviousWeek = LatestWeek - 7
			VAR TwoWeeksAgo = LatestWeek - 14
			VAR ThreeWeeksAgo = LatestWeek - 21
			RETURN
			    IF (
			        '03 Discharge'[Discharge_Week_Ending_Sunday] IN {LatestWeek, PreviousWeek, TwoWeeksAgo, ThreeWeeksAgo},
			        1,
			        0
			    )
		formatString: 0
		lineageTag: 85695c73-887e-4feb-98d5-42f7c0b8781f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

