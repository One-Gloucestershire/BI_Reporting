	column FLAG_previous_4week_dis =
			
			VAR LatestWeek = MAX('03 Discharge'[Discharge_Week_Ending_Sunday])
			VAR FourWeekAgo = LatestWeek - 28
			VAR FiveWeekAgo = LatestWeek - 35
			VAR SixWeeksAgo = LatestWeek - 42
			VAR SevenWeeksAgo = LatestWeek - 48
			RETURN
			    IF (
			        '03 Discharge'[Discharge_Week_Ending_Sunday] IN {FourWeekAgo, FiveWeekAgo, SixWeeksAgo, SevenWeeksAgo},
			        1,
			        0
			    )
		formatString: 0
		lineageTag: b119ab45-4551-4ae6-aef4-96f9ea64bc1d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

