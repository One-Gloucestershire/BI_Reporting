	measure VW_Discharge_Time_Series_Title = ```
			
			VAR _TypeHasOne     = HASONEVALUE ( '03 Discharge'[Virtual_Ward_Type])
			VAR _TypeIsFiltered = ISFILTERED ( '03 Discharge'[Virtual_Ward_Type] )
			VAR _WardHasOne     = HASONEVALUE ( '03 Discharge'[admitting_ward] )
			VAR _WardIsFiltered = ISFILTERED ( '03 Discharge'[admitting_ward] )
			
			VAR _TypeName = SELECTEDVALUE ( '03 Discharge'[Virtual_Ward_Type], "Unknown" )
			VAR _WardName = SELECTEDVALUE ( '03 Discharge'[admitting_ward], "Unknown" )
			
			RETURN
			SWITCH (
			    TRUE(),
			
			    // 1) If a single ward is selected (regardless of type selection), show the ward name
			    _WardHasOne,
			        "Trend of discharges from " & _WardName ,
			
			    // 2) A single type selected and wards NOT filtered: show that type )
			    _TypeHasOne && NOT _WardIsFiltered,
			        "Trend of discharges from " & _TypeName,
			
			    // 3) A single type selected AND wards filtered (multiple): selected wards within that type
			    _TypeHasOne && _WardIsFiltered && NOT _WardHasOne,
			        "Trend of discharges from selected " & _TypeName,
			
			    // 4) Multiple types selected (any ward state): generic selected
			    _TypeIsFiltered && NOT _TypeHasOne,
			        "Trend of discharges from selected Virtual Wards",
			
			    // 5) Wards filtered (multiple) but type not filtered: generic selected
			    _WardIsFiltered && NOT _WardHasOne,
			        "Trend of discharges from selected Virtual Wards",
			
			    // 6) No filters at all
			    "Trend of discharges from all Virtual Wards"
			)
			
			
			```
		lineageTag: 65132d2d-ce7c-4c14-8d17-26e4e864bcbd

	measure VW_Discharge_Destination_Title = ```
			
			VAR _TypeHasOne     = HASONEVALUE ( '03 Discharge'[Virtual_Ward_Type])
			VAR _TypeIsFiltered = ISFILTERED ( '03 Discharge'[Virtual_Ward_Type] )
			VAR _WardHasOne     = HASONEVALUE ( '03 Discharge'[admitting_ward] )
			VAR _WardIsFiltered = ISFILTERED ( '03 Discharge'[admitting_ward] )
			
			VAR _TypeName = SELECTEDVALUE ( '03 Discharge'[Virtual_Ward_Type], "Unknown" )
			VAR _WardName = SELECTEDVALUE ( '03 Discharge'[admitting_ward], "Unknown" )
			
			RETURN
			SWITCH (
			    TRUE(),
			
			    // 1) If a single ward is selected (regardless of type selection), show the ward name
			    _WardHasOne,
			        "Destination on discharge from " & _WardName ,
			
			    // 2) A single type selected and wards NOT filtered: show that type )
			    _TypeHasOne && NOT _WardIsFiltered,
			        "Destination on discharge from " & _TypeName,
			
			    // 3) A single type selected AND wards filtered (multiple): selected wards within that type
			    _TypeHasOne && _WardIsFiltered && NOT _WardHasOne,
			        "Destination on discharge from selected " & _TypeName,
			
			    // 4) Multiple types selected (any ward state): generic selected
			    _TypeIsFiltered && NOT _TypeHasOne,
			        "Destination on discharge from selected Virtual Wards",
			
			    // 5) Wards filtered (multiple) but type not filtered: generic selected
			    _WardIsFiltered && NOT _WardHasOne,
			        "Destination on discharge from selected Virtual Wards",
			
			    // 6) No filters at all
			    "Destination on discharge from all Virtual Wards"
			)
			
			
			```
		lineageTag: f3d88d1c-c355-48b0-baaf-17834a99d4f3

	measure VW_Discharge_Average_LOS_Series_Title = ```
			
			VAR _TypeHasOne     = HASONEVALUE ( '03 Discharge'[Virtual_Ward_Type])
			VAR _TypeIsFiltered = ISFILTERED ( '03 Discharge'[Virtual_Ward_Type] )
			VAR _WardHasOne     = HASONEVALUE ( '03 Discharge'[admitting_ward] )
			VAR _WardIsFiltered = ISFILTERED ( '03 Discharge'[admitting_ward] )
			
			VAR _TypeName = SELECTEDVALUE ( '03 Discharge'[Virtual_Ward_Type], "Unknown" )
			VAR _WardName = SELECTEDVALUE ( '03 Discharge'[admitting_ward], "Unknown" )
			
			RETURN
			SWITCH (
			    TRUE(),
			
			    // 1) If a single ward is selected (regardless of type selection), show the ward name
			    _WardHasOne,
			        "Average Length of Stay on " & _WardName ,
			
			    // 2) A single type selected and wards NOT filtered: show that type )
			    _TypeHasOne && NOT _WardIsFiltered,
			        "Average Length of Stay on " & _TypeName,
			
			    // 3) A single type selected AND wards filtered (multiple): selected wards within that type
			    _TypeHasOne && _WardIsFiltered && NOT _WardHasOne,
			        "Average Length of Stay on selected " & _TypeName,
			
			    // 4) Multiple types selected (any ward state): generic selected
			    _TypeIsFiltered && NOT _TypeHasOne,
			        "Average Length of Stay on selected Virtual Wards",
			
			    // 5) Wards filtered (multiple) but type not filtered: generic selected
			    _WardIsFiltered && NOT _WardHasOne,
			        "Average Length of Stay on selected Virtual Wards",
			
			    // 6) No filters at all
			    "Average Length of Stay on all Virtual Wards"
			)
			
			
			```
		lineageTag: 0b1a5cf3-3e33-4940-9d94-92ffed376565

