	column Discharge_Week_Ending_Sunday = ```
			
			VAR _CURRENT = '06 H@H Date Table'[date]
			RETURN 
			    _CURRENT + (7 - weekday(_CURRENT, 2) ) 
			```
		formatString: dd mmmm yyyy
		lineageTag: 4ad21699-cd1a-4bb8-bb98-c4a135bbcc8b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	column Week_Ending_Sunday_Disch = ```
			
			VAR _CURRENT = '06 H@H Date Table'[date]
			RETURN 
			    _CURRENT + (7 - weekday(_CURRENT, 2) ) 
			```
		formatString: Long Date
		lineageTag: ae84b699-5c12-43c9-ba8a-faa261023d39
		summarizeBy: none

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Latest_week_discharge_flag = ```
			
			IF('06 H@H Date Table'[Week_Ending_Sunday_Disch] = CALCULATE(MAX('06 H@H Date Table'[Week_Ending_Sunday_Disch]), ALL('06 H@H Date Table')), 1,0)
			
			```
		formatString: 0
		lineageTag: 5092188d-d079-4660-80dc-5c7c70ffd3d3
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

