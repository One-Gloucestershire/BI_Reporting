	partition '06 H@H Date Table' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db01_reference"), "SELECT DISTINCT cast(d.full_date as date) as ""date"" ,to_char(d.full_date,'DD/MM/YYYY') as ""day_month_year"" ,d.day_of_fin_year as ""day"" ,d.weekday_no as ""weekday"" ,d.weekday_name as ""weekday_name"" ,d.month_no as ""month"" ,d.month_short_name as ""month_name"" ,d.cal_quarter_no as ""quarter"" ,d.year_month as ""year_month"" ,case when d.weekday_no in (6,7) then 1 else 0 end as ""is_weekend"" ,case when d.bank_holiday_desc is not null then 1 else 0 end as ""is_holiday"" ,d.bank_holiday_desc as ""holiday_description"" ,d.working_day_calc as ""is_working_day"" ,d.fin_week_no as ""financial_week_of_year"" ,replace(d.fin_year_yyyy_dash_yy,' - ','/') as ""financial_year"" ,d.fin_quarter_no as ""financial_quarter"" ,d.day_of_quarter as ""day_of_quarter"" ,cast(d.quarter_start as date) as ""quarter_start_date"" ,cast(d.quarter_start as date) as ""quarter_end_date"" ,d.month_day_no as ""month_day_no"" ,d.fin_month_no as ""financial_month"" ,concat(concat(d.month_short_name,'-'),left(d.date_112,4)) as ""month_year_name"" ,d.monthyear_mmmm_yyyyy as ""month_year"" ,case when d.fin_month_no <= (select cast(fin_month_no as int) from dscro_national_lookups.ref_dates where full_date = last_day(add_months(current_date,-1))) then 1 else 0 end as ""ytd_flag"" ,case when d.year_month in (select max(year_month) from dscro_national_lookups.ref_dates where full_date between '2019-04-01' and last_day(add_months(current_date,-1))) then 1 else 0 end as ""latest_month_flag"" ,case when d.year_month in (select max(year_month) from dscro_national_lookups.ref_dates where full_date between '2019-04-01' and last_day(add_months(current_date,-2))) then 1 else 0 end as ""previous_month_flag"" ,case when d.year_month in (select year_month from dscro_national_lookups.ref_dates where full_date between last_day(add_months(current_date,-12)) and last_day(add_months(current_date,-1))) then 1 else 0 end as ""latest_12_months_flag"" ,case when d.year_month in (select year_month from dscro_national_lookups.ref_dates where full_date between last_day(add_months(current_date,-24)) and last_day(add_months(current_date,-13))) then 1 else 0 end as ""previous_12_months_flag"" ,case when d.year_month in (select max(year_month) from dscro_national_lookups.ref_dates where full_date between '2019-04-01' and last_day(add_months(current_date,-13))) then 1 else 0 end as ""same_month_last_year_flag"" ,last_day(add_months(current_date,-2)) as ""Data_Up_To"" ,getdate() as ""Last_Updated"" FROM dscro_national_lookups.ref_dates d WHERE cast(d.full_date as date) between '2023-04-01' and last_day(add_months(current_date,-2))", null, [EnableFolding=true]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"day_month_year", type date}, {"month_year", type date}})
				in
				    #"Changed Type"

	annotation PBI_NavigationStepName = Navigation

