		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "PowerBI_Reporting", [Query="#(lf)SELECT [Readmission_date_only] = ''#(lf)#(lf)#(lf)#(lf)--SET DATEFORMAT ymd;#(lf)#(lf)---------- CREATE VIRTUAL WARDS TABLE FOR UNION ------------#(lf)#(lf)--IF OBJECT_ID ('tempdb..#VW') IS NOT NULL DROP TABLE #VW#(lf)#(lf)--SELECT [nhs_number]#(lf)--#(tab)  ,[admission_datetime]      #(lf)--      ,[admission_method]#(lf)--#(tab)  ,[admission_method_code]#(lf)--      ,[admission_treatment_function_code]#(lf)--      ,[admission_treatment_function]#(lf)--      ,[admitting_ward_code]#(lf)--      ,[admitting_ward]#(lf)--      ,[discharge_datetime] #(lf)--#(tab)  ,[hospital_episode_number]#(lf)--#(tab)  ,[SpellHRG]#(lf)--      ,[spell_P_diag]#(lf)--#(tab)  ,[Data_source] = 'Virtual Wards'#(lf)#(lf)--INTO #VW #(lf)--FROM CCG_Current.GHFT.vw_IPVirtualWard#(lf)--WHERE [admitting_ward] IN ('Virtual Frailty Ward', 'Virtual Respiratory Ward', 'Virtual Heart Failure Ward', 'Virtual Oncology Haematology Ward', 'Virtual General Medicine Ward')#(lf)#(lf)----SELECT *#(lf)----FROM #VW#(lf)#(lf)#(lf)---------- CREATE GHFT INPATIENTS TABLE FOR UNION ------------#(lf)#(lf)--IF OBJECT_ID ('tempdb..#GHFT') IS NOT NULL DROP TABLE #GHFT#(lf)#(lf)--SELECT [nhs_number]#(lf)--#(tab)  ,[admission_datetime] = CONVERT(VARCHAR(19), [admission_datetime], 120)  --= CAST([admission_datetime] AS VARCHAR)#(lf)--      ,[admission_method]#(lf)--#(tab)  ,[admission_method_code]#(lf)--      ,[local_admission_treatment_function_code]#(lf)--      ,[local_admission_treatment_function]#(lf)--      ,[admitting_ward_code]#(lf)--      ,[admitting_ward]#(lf)--      ,[discharge_datetime] = CONVERT(VARCHAR(19), [DISCHARGE_datetime], 120)#(lf)--#(tab)  ,[hospital_episode_number]#(lf)--#(tab)  ,[SpellHRG]#(lf)--      ,[spell_P_diag]#(lf)--#(tab)  ,[Data_source] = 'GHFT'#(lf)#(lf)--INTO #GHFT#(lf)--FROM [CCG_Current].[GHFT].[vw_HospitalProviderSpell]#(lf)#(lf)----SELECT *#(lf)----FROM #GHFT#(lf)#(lf)#(lf)---------- CREATE SUS TABLE FOR UNION ------------#(lf)#(lf)--IF OBJECT_ID ('tempdb..#SUS') IS NOT NULL DROP TABLE #SUS#(lf)#(lf)--SELECT [spell_patient_identity_nhs_number_value]#(lf)--#(tab)  ,[spell_admission_datetime] = CAST(#(lf)--    CAST([spell_admission_date] AS VARCHAR(10)) + ' ' +#(lf)--    CAST(ISNULL([spell_admission_time], '00:00:00') AS VARCHAR(8))#(lf)--    AS DATETIME#(lf)--)#(lf)--#(tab)  ,AM.[AdmissionMethodName]#(lf)--      ,[spell_admission_method]   #(lf)--      ,[care_professional_treatment_function]#(lf)--      ,[treatment_function_description]#(lf)--      ,[spell_commissioning_service_agreement_provider_derived]#(lf)--      ,[derived_provider_name] --COLLATE SQL_Latin1_General_CP1_CS_AS AS [Derived_Provider_Name] #(lf)--#(tab)  ,[spell_discharge_datetime] = CAST(#(lf)--    CAST([spell_discharge_date] AS VARCHAR(10)) + ' ' +#(lf)--    CAST(ISNULL([spell_discharge_time], '00:00:00') AS VARCHAR(8))#(lf)--    AS DATETIME#(lf)--)#(lf)--      ,[spell_hospital_provider_spell_number]#(lf)--      ,[spell_commissioning_grouping_core_hrg]#(lf)--      ,[spell_clinical_coding_grouper_derived_primary_diagnosis]#(lf)--#(tab)  ,[Data_source] = 'SUS'#(lf)#(lf)--INTO #SUS #(lf)--FROM CCG_Current.[UnifiedSUS].[vw_HospitalProviderSpell]#(lf)#(lf)--LEFT JOIN CCG_Reference.Reference.vw_AdmissionMethod AS AM #(lf)--ON AM.[AdmissionMethodCode] = [spell_admission_method]#(lf)#(lf)#(lf)#(lf)----------- UNION VW AND GHFT INPATIENTS TABLES -----------#(lf)#(lf)--IF OBJECT_ID ('tempdb..#ALL') IS NOT NULL DROP TABLE #ALL#(lf)#(lf)--SELECT DISTINCT * #(lf)--,[Admission_Order] = NULL#(lf)--INTO #ALL#(lf)--FROM #GHFT#(lf)#(lf)--UNION#(lf)#(lf)--SELECT DISTINCT * #(lf)--,[Admission_Order] = NULL#(lf)--FROM #VW#(lf)#(lf)--UNION#(lf)#(lf)----SELECT DISTINCT * #(lf)----,[Admission_Order] = NULL#(lf)----FROM #SUS#(lf)#(lf)--SELECT [spell_patient_identity_nhs_number_value]#(lf)--      ,[spell_admission_datetime]#(lf)--#(tab)  ,[AdmissionMethodName]#(lf)--      ,[spell_admission_method]   #(lf)--      ,[care_professional_treatment_function]#(lf)--      ,[treatment_function_description]#(lf)--      ,[spell_commissioning_service_agreement_provider_derived]#(lf)--      ,[derived_provider_name] COLLATE SQL_Latin1_General_CP1_CS_AS AS [Derived_Provider_Name] #(lf)--#(tab)  ,[spell_discharge_datetime]#(lf)--      ,[spell_hospital_provider_spell_number]#(lf)--      ,[spell_commissioning_grouping_core_hrg]#(lf)--      ,[spell_clinical_coding_grouper_derived_primary_diagnosis]#(lf)--#(tab)  ,[Data_source] #(lf)--#(tab)  ,[Admission_Order] = NULL#(lf)--FROM #SUS #(lf)#(lf)------------------------- TAKEN FROM ASH'S SCRIPT --------------------------#(lf)-----Admission order to place a sequence against each admission by admission date#(lf)#(lf)--UPDATE #ALL#(lf)#(lf)--SET [Admission_Order] = ORD.[Order]#(lf)#(lf)--FROM #ALL#(lf)#(lf)--LEFT JOIN  (SELECT *#(lf)--#(tab)#(tab)#(tab)#(tab)  ,[Order] =  ROW_NUMBER() OVER(PARTITION BY ORD.[nhs_number] ORDER BY ORD.[admission_datetime]  ASC#(lf)--#(tab)#(tab)#(tab)#(tab)  )  FROM #ALL AS ORD#(lf)--) AS ORD#(lf)--ON ORD.[hospital_episode_number] = #ALL.[hospital_episode_number]#(lf)#(lf)--WHERE #All.[nhs_number] IS NOT NULL  -- Only update records with known nhs number #(lf)#(lf)#(lf)----SELECT *#(lf)----FROM #ALL#(lf)----WHERE nhs_number = '2AA58BF95DE3363DEDEB'#(lf)----ORDER BY [Admission_Order]#(lf)#(lf)#(lf)#(lf)#(lf)---------------------------- START OF READMISSION QUERY ---------------------------#(lf)--------- #ALL AS AD1 FOR FIRST ADMISSIONS | #ALL AS AD2 FOR READMISSIONS ----------#(lf)#(lf)--IF OBJECT_ID ('tempdb..#READMISSIONS') IS NOT NULL DROP TABLE #READMISSIONS#(lf)#(lf)--SELECT AD1.[nhs_number]#(lf)--#(tab)  ,[VW_Hospital_Ep_Number] = AD1.hospital_episode_number#(lf)--#(tab)  ,[RE_Hospital_Ep_Number] = AD2.hospital_episode_number#(lf)--#(tab)  ,[VW_Admission] = AD1.[admission_datetime]    #(lf)--#(tab)  ,[VW_Discharge] =  AD1.[discharge_datetime]   #(lf)--#(tab)  ,[RE_Admission] = AD2.[admission_datetime]        #(lf)--#(tab)  ,[RE_Discharge] = AD2.[discharge_datetime]   #(lf)--#(tab)  ,[Days_Between_Stays] = CAST(DATEDIFF(DAY,#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)TRY_CONVERT(DATETIME, AD1.[discharge_datetime], 120),#(lf)--#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)TRY_CONVERT(DATETIME, AD2.[admission_datetime], 120) ) AS INT)#(lf)#(lf)--#(tab)  ,[VW_Ward] = AD1.[admitting_ward]#(lf)--#(tab)  ,[VW_Admission_Order] = AD1.Admission_Order#(lf)--#(tab)  ,[RE_Ward] = AD2.[admitting_ward]#(lf)--#(tab)  ,[RE_Admission_Order] = AD2.Admission_Order#(lf)--#(tab)  ,[VW_Admission_Method] = AD1.admission_method#(lf)--#(tab)  ,[VW_Admission_Method_Code] = AD1.admission_method_code#(lf)--#(tab)  ,[VW_HRG] = AD1.SpellHRG#(lf)--#(tab)  ,[VW_HRG_Description] = HRG2.HRGCodeDescription#(lf)--#(tab)  ,[VW_Primary_Diag] = AD1.spell_P_diag#(lf)--#(tab)  ,[VW_Primary_Diag_Description] = ICD2.ICD10Description#(lf)--#(tab)  ,[VW_TFC] = AD1.local_admission_treatment_function_code#(lf)--#(tab)  ,[VW_TF] = AD1.local_admission_treatment_function#(lf)#(lf)--#(tab)  ,[RE_TF] = AD2.local_admission_treatment_function#(lf)--#(tab)  ,[RE_TFC] = AD2.local_admission_treatment_function_code#(lf)--#(tab)  ,[RE_Admission_Method] = AD2.admission_method#(lf)--#(tab)  ,[RE_Admission_Method_Code] = AD2.admission_method_code#(lf)--#(tab)  ,CASE WHEN AD2.admission_method_code like '1%' then cast('Elective' as varchar)#(lf)--#(tab)#(tab)#(tab)WHEN AD2.admission_method_code like '2%' then cast('Non-Elective' as varchar)#(lf)--#(tab)#(tab)#(tab)WHEN AD2.admission_method_code like '3%' then cast('Non-Elective' as varchar)#(lf)--#(tab)#(tab)#(tab)WHEN AD2.admission_method_code like '8%' then cast('Non-Elective' as varchar)  ELSE 'Other' #(lf)--#(tab)#(tab)END AS [RE_Elective_or_Non] #(lf)--#(tab)  ,[RE_HRG] = AD2.SpellHRG#(lf)--#(tab)  ,[RE_HRG_Description] = HRG.HRGCodeDescription#(lf)--#(tab)  ,[RE_Primary_Diag] = AD2.spell_P_diag#(lf)--#(tab)  ,[RE_Primary_Diag_Description] = ICD.ICD10Description#(lf)--#(tab) -- ,[Readmission_order] = ROW_NUMBER() OVER (PARTITION BY [nhs_number] ORDER BY #VW.[discharge_datetime]   #(lf)#(lf)--INTO #READMISSIONS#(lf)--FROM #ALL AS [AD1] #(lf)#(lf)---------- JOIN TO #ALL AS AD2 TABLE FOR READMISSIONS (TAKEN FROM RACHAEL'S AND ASH'S SCRIPT) -----------#(lf)--LEFT JOIN #ALL AS [AD2] ON#(lf)--#(tab)   TRY_CAST(AD2.[admission_datetime] AS DATETIME) IS NOT NULL#(lf)--   AND TRY_CAST(AD1.[discharge_datetime] AS DATETIME) IS NOT NULL#(lf)--   AND DATEDIFF(#(lf)--         MINUTE,#(lf)--         TRY_CAST(AD1.[discharge_datetime] AS DATETIME),#(lf)--         TRY_CAST(AD2.[admission_datetime] AS DATETIME)#(lf)--       ) BETWEEN 1440 AND 43200#(lf)#(lf)--AND AD1.[nhs_number] = AD2.[nhs_number] #(lf)--AND AD2.Admission_Order = AD1.Admission_Order+1#(lf)#(lf)--AND AD1.[hospital_episode_number] != AD2.[hospital_episode_number] #(lf)#(lf)#(lf)------------ JOIN TO ICD10 FOR READMISSION PRIMARY DIAGNOSIS -----------#(lf)--LEFT JOIN [CCG_Reference].[Reference].vw_ICD10 AS ICD#(lf)--ON ICD.ICD10Code = AD2.spell_P_diag #(lf)#(lf)------------ JOIN TO ICD10 FOR VIRTUAL WARDS PRIMARY DIAGNOSIS -----------#(lf)--LEFT JOIN [CCG_Reference].[Reference].vw_ICD10 AS ICD2#(lf)--ON ICD2.ICD10Code = AD1.spell_P_diag #(lf)#(lf)#(lf)------------ JOIN TO ICD10 FOR READMISSION HRG -----------#(lf)--LEFT JOIN [CCG_Reference].[Reference].vw_HRG AS HRG#(lf)--ON HRG.HRGCode = AD2.SpellHRG#(lf)#(lf)------------ JOIN TO ICD10 FOR VIRTUAL WARDS HRG -----------#(lf)--LEFT JOIN [CCG_Reference].[Reference].vw_HRG AS HRG2#(lf)--ON HRG2.HRGCode = AD1.SpellHRG#(lf)#(lf)--ORDER BY RE_Admission DESC#(lf)#(lf)#(lf)#(lf)---------- FILTERING FINAL READMISSIONS TABLE ----------#(lf)#(lf)--SELECT *#(lf)--#(tab)#(tab),[Readmission_date_only] = CAST([RE_Admission] AS DATE) #(lf)--#(tab)#(tab),[Readmission_to_VW_flag] = CASE WHEN VW_Ward = RE_Ward THEN 1 ELSE 0 END #(lf)--,[Counter] = 1#(lf)#(lf)--FROM #READMISSIONS #(lf)--WHERE RE_Elective_or_Non = 'Non-Elective'  #(lf)--AND VW_TFC = RE_TFC #(lf)--AND [VW_Ward] IN ('Virtual Frailty Ward', 'Virtual Respiratory Ward', 'Virtual Heart Failure Ward', 'Virtual Oncology Haematology Ward', 'Virtual General Medicine Ward') ----- FIRST ADMISSIONS ARE VIRTUAL WARDS ONLY #(lf)#(lf)#(lf)----AND NHS_NUMBER = 'A815D2EFAA0F9E187630' #(lf)----AND NHS_NUMBER = '69125B85D660B01D7640'#(lf)"]),
