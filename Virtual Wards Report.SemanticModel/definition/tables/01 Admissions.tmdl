table '01 Admissions'
	lineageTag: c2a935b6-0518-41d8-85de-90220658f33c

	measure ADMISSION_TOTAL =
			CALCULATE(
			    COUNTROWS('01 Admissions'))
		formatString: 0
		lineageTag: 5ca020cd-7a8b-4403-9fbb-ddea5d18a2e3

	measure ADM_LATEST_WEEK = ```
			
			    CALCULATE(COUNTROWS('01 Admissions'), 
			    '01 Admissions'[FLAG_latest_weekend_adm] = 1) +0
			```
		formatString: 0
		lineageTag: 3e6cc030-45e0-4dfe-b584-77d3d91b4b71

	measure ADM_PREVIOUS_WEEK = ```
			
			    CALCULATE(COUNTROWS('01 Admissions'), 
			    '01 Admissions'[FLAG_previous_weekend_adm] = 1) +0
			```
		formatString: 0
		lineageTag: 8bf2cb6a-e319-4a59-88d6-8c7229b830d6

	measure ADM_PREVIOUS_4WEEK = ```
			
			   ( CALCULATE(COUNTROWS('01 Admissions'), 
			    '01 Admissions'[FLAG_previous_4week_adm] = 1) / 4 ) +0
			```
		formatString: 0
		lineageTag: ce31d2bb-24b0-4bda-b734-6451e9487e0b

	measure ADM_LATEST_4WEEK = ```
			
			   ( CALCULATE(COUNTROWS('01 Admissions'), 
			    '01 Admissions'[FLAG_latest_4week_adm] = 1) / 4 ) +0
			```
		formatString: 0
		lineageTag: d6bb35cb-f996-477d-959c-506cde8dbbd7

	measure ADM_DIAGNOSIS% = ```
			(SUM('01 Admissions'[primary_diagnosis_counter]) / SUM('01 Admissions'[Counter]) ) 
			```
		lineageTag: 2eec76ed-5e3f-43c9-adcd-1febcd1208c2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure LATEST_WEEK_END = FORMAT(MAX('01 Admissions'[Admission_Week_Ending_Sunday]), "DD/MM/YYYY")
		lineageTag: 02fbb8ba-e667-4b7a-ba5e-83b8dd870735

	measure ADM_TFC% = ```
			(SUM('01 Admissions'[primary_diagnosis_counter]) / SUM('01 Admissions'[Counter]) ) 
			```
		lineageTag: deadefc8-59e1-4c9b-a818-abc555166cc9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure admission_TFC_% = ```
			(SUM('01 Admissions'[admission_tfc_count]) / SUM('01 Admissions'[Counter]) ) 
			```
		lineageTag: d8a91d3e-0cf6-489d-b7f3-fe47d5b5a7d2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure HRG_% = ```
			(SUM('01 Admissions'[HRG_Counter]) / SUM('01 Admissions'[Counter]) ) 
			```
		lineageTag: d5e1baad-691a-4b9f-bf9a-97661b0b77f2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Current_Month_Year = FORMAT(TODAY(), "MMMM YYYY")
		lineageTag: 2ae04af2-30b9-46e3-a04a-c1e58bdee74c

	measure VW_Admission_Time_Series_Title = ```
			
			VAR _TypeHasOne     = HASONEVALUE ( '01 Admissions'[Virtual_Ward_Type] )
			VAR _TypeIsFiltered = ISFILTERED ( '01 Admissions'[Virtual_Ward_Type] )
			VAR _WardHasOne     = HASONEVALUE ( '01 Admissions'[admitting_ward] )
			VAR _WardIsFiltered = ISFILTERED ( '01 Admissions'[admitting_ward] )
			
			VAR _TypeName = SELECTEDVALUE ( '01 Admissions'[Virtual_Ward_Type], "Unknown" )
			VAR _WardName = SELECTEDVALUE ( '01 Admissions'[admitting_ward], "Unknown" )
			
			RETURN
			SWITCH (
			    TRUE(),
			
			    // 1) If a single ward is selected (regardless of type selection), show the ward name
			    _WardHasOne,
			        "Trend of admissions to " & _WardName ,
			
			    // 2) A single type selected and wards NOT filtered: show that type )
			    _TypeHasOne && NOT _WardIsFiltered,
			        "Trend of admissions to " & _TypeName,
			
			    // 3) A single type selected AND wards filtered (multiple): selected wards within that type
			    _TypeHasOne && _WardIsFiltered && NOT _WardHasOne,
			        "Trend of admissions to selected " & _TypeName,
			
			    // 4) Multiple types selected (any ward state): generic selected
			    _TypeIsFiltered && NOT _TypeHasOne,
			        "Trend of admissions to selected Virtual Wards",
			
			    // 5) Wards filtered (multiple) but type not filtered: generic selected
			    _WardIsFiltered && NOT _WardHasOne,
			        "Trend of admissions to selected Virtual Wards",
			
			    // 6) No filters at all
			    "Trend of admissions to all Virtual Wards"
			)
			
			
			```
		lineageTag: efb0ca68-1758-44fa-bd6e-0df35aed9e37

	measure VW_Admission_Admission_Method_Title = ```
			
			VAR _TypeHasOne     = HASONEVALUE ( '01 Admissions'[Virtual_Ward_Type] )
			VAR _TypeIsFiltered = ISFILTERED ( '01 Admissions'[Virtual_Ward_Type] )
			VAR _WardHasOne     = HASONEVALUE ( '01 Admissions'[admitting_ward] )
			VAR _WardIsFiltered = ISFILTERED ( '01 Admissions'[admitting_ward] )
			
			VAR _TypeName = SELECTEDVALUE ( '01 Admissions'[Virtual_Ward_Type], "Unknown" )
			VAR _WardName = SELECTEDVALUE ( '01 Admissions'[admitting_ward], "Unknown" )
			
			RETURN
			SWITCH (
			    TRUE(),
			
			    // 1) If a single ward is selected (regardless of type selection), show the ward name
			    _WardHasOne,
			        "Admission method to " & _WardName ,
			
			    // 2) A single type selected and wards NOT filtered: show that type )
			    _TypeHasOne && NOT _WardIsFiltered,
			        "Admission method to " & _TypeName,
			
			    // 3) A single type selected AND wards filtered (multiple): selected wards within that type
			    _TypeHasOne && _WardIsFiltered && NOT _WardHasOne,
			        "Admission method to " & _TypeName,
			
			    // 4) Multiple types selected (any ward state): generic selected
			    _TypeIsFiltered && NOT _TypeHasOne,
			        "Admission method for selected Virtual Wards",
			
			    // 5) Wards filtered (multiple) but type not filtered: generic selected
			    _WardIsFiltered && NOT _WardHasOne,
			        "Admission method to selected Virtual Wards",
			
			    // 6) No filters at all
			    "Admission method to all Virtual Wards"
			)
			
			
			```
		lineageTag: 816c1628-ddab-411d-be6a-233b9c0610f8

