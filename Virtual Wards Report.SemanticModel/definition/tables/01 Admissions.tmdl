	column FLAG_latest_weekend_adm =
			
			IF('01 Admissions'[Admission_Week_Ending_Sunday] = MAX('01 Admissions'[Admission_Week_Ending_Sunday]), 1, 0 )
		formatString: 0
		lineageTag: cca87221-99a7-456a-9f6c-2a14504e55a1
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column FLAG_latest_4week_adm =
			
			VAR LatestWeek = MAX('01 Admissions'[Admission_Week_Ending_Sunday])
			VAR PreviousWeek = LatestWeek - 7
			VAR TwoWeeksAgo = LatestWeek - 14
			VAR ThreeWeeksAgo = LatestWeek - 21
			RETURN
			    IF (
			        '01 Admissions'[Admission_Week_Ending_Sunday] IN {LatestWeek, PreviousWeek, TwoWeeksAgo, ThreeWeeksAgo},
			        1,
			        0
			    )
		formatString: 0
		lineageTag: 2a5fa5a0-ae89-466f-b05e-46a0feef49e8
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column FLAG_previous_4week_adm =
			
			VAR LatestWeek = MAX('01 Admissions'[Admission_Week_Ending_Sunday])
			VAR FourWeekAgo = LatestWeek - 28
			VAR FiveWeekAgo = LatestWeek - 35
			VAR SixWeeksAgo = LatestWeek - 42
			VAR SevenWeeksAgo = LatestWeek - 48
			RETURN
			    IF (
			        '01 Admissions'[Admission_Week_Ending_Sunday] IN {FourWeekAgo, FiveWeekAgo, SixWeeksAgo, SevenWeeksAgo},
			        1,
			        0
			    )
		formatString: 0
		lineageTag: 6b432e5c-5523-4b5f-8add-f022892f846c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

