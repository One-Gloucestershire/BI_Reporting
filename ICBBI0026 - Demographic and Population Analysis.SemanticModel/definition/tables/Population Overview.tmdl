	measure 'Care Home' = Sum('Population Overview'[Care_Home])/Sum('Population Overview'[Population_Counter])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d30be8c7-7b2c-4184-b961-3e1b5db2195b

	measure Percentage = SUM('Population Overview'[Population_Counter])/CALCULATE(SUM('Population Overview'[Population_Counter]), ALLEXCEPT('Population Overview','Population Overview'[LSOA_Code],'Population Overview'[District_Name],'Population Overview'[Ward_Name],'Population Overview'[GP_Practice_Name],'Population Overview'[PrimaryCareNetwork]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 12c9864a-d391-4ae9-a950-1592ceac2120

	measure PercentageMap = SUM('Population Overview'[Population_Counter])/CALCULATE(SUM('Population Overview'[Population_Counter]), ALLEXCEPT('Population Overview','Population Overview'[LSOA_Code],'Population Overview'[District_Name],'Population Overview'[Ward_Name]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 05705ae4-9645-4d5f-ab73-f7c6d9f738db

	measure QOF_Asthma% = IF(SELECTEDVALUE('Health Overview'[Attribute]) = "QOF_Asthma",0, (SUM('Population Overview'[QOF_Asthma])/CALCULATE(SUM('Population Overview'[Population_Counter]))))
