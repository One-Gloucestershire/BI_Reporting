	partition 'Population Overview' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "ccg_reference", [Query="#(lf)SELECT#(lf)[Derived_NHS_Number],#(lf)[Population_Counter] = 1,#(lf)[Age] = CASE WHEN [AB].[Age_Band_5_YRS] = '0-4' THEN '00-04'#(lf)#(tab)#(tab)#(tab) WHEN [AB].[Age_Band_5_YRS] = '5-9' THEN '05-09'#(lf)#(tab)#(tab)#(tab) WHEN [PDS].[Derived_Age] >= 85 THEN '85+' ELSE [AB].[Age_Band_5_YRS] END,#(lf)[Age_Rank] = DENSE_RANK() OVER(ORDER BY CASE WHEN [AB].[Age_Band_5_YRS] = '0-4' THEN '00-04'#(lf)#(tab)#(tab)#(tab) WHEN [AB].[Age_Band_5_YRS] = '5-9' THEN '05-09'#(lf)#(tab)#(tab)#(tab) WHEN [PDS].[Derived_Age] >= 85 THEN '85+' ELSE [AB].[Age_Band_5_YRS] END),#(lf)[Ageband] = CASE WHEN [PDS].[Derived_Age] < 18 THEN 'Under 18' #(lf)#(tab)#(tab)#(tab)#(tab) WHEN [PDS].[Derived_Age] >= 65 THEN '65 and Over' ELSE 'Working Age' END,#(lf)[Under_18] = CASE WHEN [PDS].[Derived_Age] < 18 THEN 1 ELSE 0 END,#(lf)[65_and_Over] = CASE WHEN [PDS].[Derived_Age] >= 65 THEN 1 ELSE 0 END,#(lf)[Gender] = CASE WHEN [PDS].[Gender_Desc] LIKE '%SPINE%9' OR [PDS].[Gender_Desc] IS NULL THEN 'Not Known' ELSE [PDS].[Gender_Desc] END,#(lf)[Care_Home] = [PDS].[Derived_IsLivingInCareHome],#(lf)[Ethnicity] = CASE WHEN [ETH].[Ethnic Origin Grouped] = 'Not Stated' OR [Ethnic Origin Grouped] IS NULL THEN 'Not Known' ELSE [ETH].[Ethnic Origin Grouped] END,#(lf)[EthnicMinority] = CASE WHEN [ETH].[Ethnic Origin Grouped] = 'Not Stated' OR [Ethnic Origin Grouped] IS NULL THEN 0 #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [ETH].[Ethnic Origin Grouped] = 'White' THEN 0 ELSE 1 END,#(lf)[IMD_Decile_England] = [IndexOfMultipleDeprivation_EnglandDecile],#(lf)[IMD_Decile_Gloucester] = [Derived_IMDGloucestershireDecile],#(lf)[Core20] = CASE WHEN [IndexOfMultipleDeprivation_EnglandDecile] IN (1,2) THEN 1 ELSE 0 END,#(lf)[GP_Practice_Code] = [GP].[ReportingOrganisationCode],#(lf)[GP_Practice_Name] = CASE WHEN [GP].[PrimaryCareNetwork] IS NULL THEN 'Out of County' ELSE [GP].[ReportingOrganisationName] END,#(lf)[PrimaryCareNetwork] = COALESCE([GP].[PrimaryCareNetwork],'Out of County'),#(lf)[Registered] = CASE WHEN [PDS].[Derived_Registered_CCG] <> '11M' THEN 0 ELSE 1 END, #(lf)[Resident] =  CASE WHEN [PDS].[Derived_Residential_CCG] <> '11M' THEN 0 #(lf)#(tab)#(tab)#(tab)#(tab)   WHEN  [GEO].[DistrictName] NOT IN ('Cheltenham','Gloucester','Stroud','Forest of Dean','Tewkesbury','Cotswold') THEN 0 ELSE 1 END,#(lf)[Registered_Text] = CASE WHEN [PDS].[Derived_Registered_CCG] <> '11M' THEN 'Registered out of county' ELSE 'Registered in Gloucestershire' END, #(lf)[Resident_Text] = CASE WHEN [PDS].[Derived_Residential_CCG] <> '11M' THEN 'Resident out of county' #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN  [GEO].[DistrictName] NOT IN ('Cheltenham','Gloucester','Stroud','Forest of Dean','Tewkesbury','Cotswold') THEN 'Resident out of county' ELSE 'Resident in Gloucestershire' END,#(lf)[Derived_Postcode_Key],#(lf)[LSOA_Code] = [POS].[LSOACode],#(lf)[LSOA_Name] = [LSOA].[LSOA_Name],#(lf)[Ward_Code] = [GEO].[WardCode21],#(lf)[Ward_Name] = [GEO].[WardName21],#(lf)[District_Code] = [GEO].[DistrictCode],#(lf)[District_Name] = CASE WHEN [GEO].[DistrictName] NOT IN ('Cheltenham','Gloucester','Stroud','Forest of Dean','Tewkesbury','Cotswold') THEN 'Out of County' #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN [GEO].[DistrictName] IS NULL THEN 'Unknown' ELSE [GEO].[DistrictName] END,#(lf)[QOF_Hypertension] = COALESCE([QOF_Hypertension],0),#(lf)[QOF_Depression] = COALESCE([QOF_Depression],0),#(lf)[QOF_Asthma] = COALESCE([QOF_Asthma],0),#(lf)[QOF_Diabetes] = COALESCE([QOF_Diabetes],0),#(lf)[QOF_CoronaryHeartDisease] = COALESCE([QOF_CoronaryHeartDisease],0),#(lf)[QOF_Cancer] = COALESCE([QOF_Cancer],0),#(lf)[QOF_AtrialFibrilation] = COALESCE([QOF_AtrialFibrilation],0),#(lf)[QOF_Osteoporosis] = COALESCE([QOF_Osteoporosis],0),#(lf)[QOF_COPD] = COALESCE([QOF_COPD],0),#(lf)[QOF_Stroke] = COALESCE([QOF_Stroke],0),#(lf)[QOF_TIA] = COALESCE([QOF_TIA],0),#(lf)[QOF_HeartFailure] = COALESCE([QOF_HeartFailure],0),#(lf)[QOF_ChronicKidneyDisease] = COALESCE([QOF_ChronicKidneyDisease],0),#(lf)[QOF_PeripheralArterialDisease] = COALESCE([QOF_PeripheralArterialDisease],0),#(lf)[QOF_SMI] = COALESCE([QOF_SMI],0),#(lf)[QOF_Dementia] = COALESCE([QOF_Dementia],0),#(lf)[QOF_Epilepsy] = COALESCE([QOF_Epilepsy],0),#(lf)[QOF_RheumatoidArthritis] = COALESCE([QOF_RheumatoidArthritis],0),#(lf)[QOF_LearningDisability] = COALESCE([QOF_LearningDisability],0)#(lf)FROM [CCG_Reference].[Population].[vw_PDS_Current] [PDS]#(lf)#(lf)#(tab)LEFT JOIN [CCG_Reference].[Reference].[vw_Postcode_Lookup] [POS]#(lf)#(tab)ON [POS].[Derived_Postcode_Key] = [PDS].[Derived_Postcode]#(lf)#(lf)#(tab)#(tab)LEFT JOIN [DSCRO_NATIONAL_LOOKUPS].[ODS].[LSOAs_England_And_Wales_SCD] [LSOA]#(lf)#(tab)#(tab)ON [LSOA].[LSOA_Code] COLLATE SQL_Latin1_General_CP1_CS_AS = [POS].[LSOACode]#(lf)#(lf)#(tab)#(tab)#(tab)LEFT JOIN [CCG_Reference].[Reference].[vw_GeographyMapping] [GEO]#(lf)#(tab)#(tab)#(tab)ON [GEO].[LSOACode] = [POS].[LSOACode]#(lf)#(lf)#(tab)#(tab)#(tab)#(tab)LEFT JOIN [BIReports].[MPI].[Ethnicity_Table] [ETH]#(lf)#(tab)#(tab)#(tab)#(tab)ON [ETH].[PseudoNHSNo] = [PDS].[Derived_NHS_Number]#(lf)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)LEFT JOIN [CCG_Reference].[Reference].[vw_GPPractice] [GP]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)ON [GP].[OrganisationCode] = [PDS].[PrimaryCareProvider]#(lf)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)LEFT JOIN [DSCRO_NATIONAL_LOOKUPS].[dbo].[ref_Age] [AB]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ON [AB].[pk_Age] = [PDS].[Derived_Age]#(lf)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)LEFT JOIN (SELECT DISTINCT [LTC].[Pseudo_NHS_Number],#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)[QOF_Hypertension] = MAX(CASE WHEN [LTC_CODE] IN ('QOF48_HYP_COD') THEN 1 ELSE 0 END),#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)[QOF_Depression] = MAX(CASE WHEN [LTC_CODE] IN ('QOF48_DEPR_COD') THEN 1 ELSE 0 END),#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)[QOF_Asthma] = MAX(CASE WHEN [LTC_CODE] IN ('QOF48_AST_COD') THEN 1 ELSE 0 END),#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)[QOF_Diabetes] = MAX(CASE WHEN [LTC_CODE] IN ('QOF48_DM_COD') THEN 1 ELSE 0 END),#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)[QOF_CoronaryHeartDisease] = MAX(CASE WHEN [LTC_CODE] IN ('QOF48_CHD_COD') THEN 1 ELSE 0 END),#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)[QOF_Cancer] = MAX(CASE WHEN [LTC_CODE] IN ('QOF48_CAN_COD') THEN 1 ELSE 0 END),#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)[QOF_AtrialFibrilation] = MAX(CASE WHEN [LTC_CODE] IN ('QOF48_AFIB_COD') THEN 1 ELSE 0 END),#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)[QOF_Osteoporosis] = MAX(CASE WHEN [LTC_CODE] IN ('QOF48_OSTEO_COD') THEN 1 ELSE 0 END),#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)[QOF_COPD] = MAX(CASE WHEN [LTC_CODE] IN ('QOF48_COPD_COD') THEN 1 ELSE 0 END),#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)[QOF_Stroke] = MAX(CASE WHEN [LTC_CODE] IN ('QOF48_STRK_COD') THEN 1 ELSE 0 END),#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)[QOF_TIA] = MAX(CASE WHEN [LTC_CODE] IN ('QOF48_TIA_COD') THEN 1 ELSE 0 END),#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)[QOF_HeartFailure] = MAX(CASE WHEN [LTC_CODE] IN ('QOF48_HF_COD') THEN 1 ELSE 0 END),#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)[QOF_ChronicKidneyDisease] = MAX(CASE WHEN [LTC_CODE] IN ('QOF48_CKD_COD','QOF48_CKD1AND2_COD') THEN 1 ELSE 0 END),#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)[QOF_PeripheralArterialDisease] = MAX(CASE WHEN [LTC_CODE] IN ('QOF48_PAD_COD') THEN 1 ELSE 0 END),#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)[QOF_SMI] =  MAX(CASE WHEN [LTC_CODE] IN ('QOF48_MH_COD') THEN 1 ELSE 0 END), #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)[QOF_Dementia] = MAX(CASE WHEN [LTC_CODE] IN ('QOF48_DEM_COD') T