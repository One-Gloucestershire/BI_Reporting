table 'Population Overview'
	lineageTag: 79ff387f-1547-4a91-b64c-d910e31bae71

	measure 'Under 18''s' = Sum('Population Overview'[Under_18])/Sum('Population Overview'[Population_Counter])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 5670edaa-00ae-4974-86e1-5ad03695e15f

	measure '65 and Over' = Sum('Population Overview'[65_and_Over])/Sum('Population Overview'[Population_Counter])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3a880e1c-fa84-4fe4-84c6-ab2b351b0c66

	measure 'Ethnic Minorities' = Sum('Population Overview'[EthnicMinority])/Sum('Population Overview'[Population_Counter])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 851eefe3-8d13-4453-a6de-0531963aacaf

	measure 'Core 20' = Sum('Population Overview'[Core20])/Sum('Population Overview'[Population_Counter])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a33400d6-b7cc-4959-886b-c5a19b6bd3f0

	measure 'Care Home' = Sum('Population Overview'[Care_Home])/Sum('Population Overview'[Population_Counter])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d30be8c7-7b2c-4184-b961-3e1b5db2195b

	measure PercentageMap = SUM('Population Overview'[Population_Counter])/CALCULATE(SUM('Population Overview'[Population_Counter]), ALLEXCEPT('Population Overview','Population Overview'[LSOA_Code],'Population Overview'[District_Name],'Population Overview'[Ward_Name]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 05705ae4-9645-4d5f-ab73-f7c6d9f738db

	measure 'LTC POPULATION MEASURE' = CALCULATE(SUM('Population Overview'[Population_Counter]), ALL('Health Overview'[Attribute]))
		formatString: 0
		lineageTag: 2648b71a-d346-4af9-9b3d-c37507aa6ab6

	measure FilterVisualAttribute = ISFILTERED('Health Overview'[Attribute])
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 1c68bc32-fe64-4b6e-bbe0-d8f594a3de8a

	measure HideVisualAttribute = if([FilterVisualAttribute],1,0)
		formatString: 0
		lineageTag: 7e4dc80d-36af-48f4-a93c-2972e4dd8783

	measure Denominator = CALCULATE(SUM('Population Overview'[Population_Counter]), ALLEXCEPT('Population Overview','Population Overview'[LSOA_Code],'Population Overview'[District_Name],'Population Overview'[Ward_Name],'Population Overview'[GP_Practice_Name],'Population Overview'[PrimaryCareNetwork],'Population Overview'[Locality],'Population Overview'[Age],'Population Overview'[Care_Home],'Population Overview'[Ethnicity]))
		formatString: 0
		lineageTag: 5a2bffd9-e7d5-41df-9eba-07ad10f104f5

	measure PyramidAge = sum('Population Overview'[Population_Counter])/CALCULATE(SUM('Population Overview'[Population_Counter]), ALLEXCEPT('Population Overview','Population Overview'[LSOA_Code],'Population Overview'[District_Name],'Population Overview'[Ward_Name],'Population Overview'[GP_Practice_Name],'Population Overview'[PrimaryCareNetwork],'Population Overview'[Locality],'Population Overview'[Care_Home],'Population Overview'[Ethnicity],'Population Overview'[IMD_Decile_England],'Population Overview'[IMD_Decile_Gloucester]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0894b826-eaf7-47df-9092-a6ac606c9846

	measure PyramidEthnicity = sum('Population Overview'[Population_Counter])/CALCULATE(SUM('Population Overview'[Population_Counter]), ALLEXCEPT('Population Overview','Population Overview'[LSOA_Code],'Population Overview'[District_Name],'Population Overview'[Ward_Name],'Population Overview'[GP_Practice_Name],'Population Overview'[PrimaryCareNetwork],'Population Overview'[Locality],'Population Overview'[Care_Home],'Population Overview'[Age],'Population Overview'[IMD_Decile_England],'Population Overview'[IMD_Decile_Gloucester]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4f9bd5c3-c238-4c12-b4de-9c4cdb1eb0db

	measure PyramidIMD = sum('Population Overview'[Population_Counter])/CALCULATE(SUM('Population Overview'[Population_Counter]), ALLEXCEPT('Population Overview','Population Overview'[LSOA_Code],'Population Overview'[District_Name],'Population Overview'[Ward_Name],'Population Overview'[GP_Practice_Name],'Population Overview'[PrimaryCareNetwork],'Population Overview'[Locality],'Population Overview'[Care_Home],'Population Overview'[Age],'Population Overview'[IMD_Decile_England],'Population Overview'[Ethnicity]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c67abadd-1644-4d56-b604-b438ec61c436

	measure PercentageBubbleMap = [SelectedGroup]/sum('Population'[Population])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3a9f4008-49d0-4e1a-9dd1-f0f86a357afb

	measure SelectedGroup = CALCULATE(SUM('Population Overview'[Population_Counter]))
		formatString: 0
		lineageTag: 36d75980-8e9d-4e33-aade-12033dd10ecf

	measure WholePopulation = CALCULATE(SUM('Population Overview'[Population_Counter]), ALLEXCEPT('Population Overview','Population Overview'[GPLatitude],'Population Overview'[GPLongitude]))
		formatString: 0
		lineageTag: 08c54f7a-035c-4d2a-b51f-68ab555605c3

	measure 'Proportion - National Deprivation' = SUM('Population Overview'[Population_Counter])/CALCULATE(SUM('Population Overview'[Population_Counter]), ALLEXCEPT('Population Overview','Population Overview'[LSOA_Code],'Population Overview'[District_Name],'Population Overview'[Ward_Name],'Population Overview'[GP_Practice_Name],'Population Overview'[PrimaryCareNetwork],'Population Overview'[Locality],'Population Overview'[Care_Home],'Population Overview'[Ethnicity],'Population Overview'[EFi_Category]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d7256879-3a5f-4cb9-96ae-d85637f2dc58

	measure 'Proportion - Ethnicity' = SUM('Population Overview'[Population_Counter])/CALCULATE(SUM('Population Overview'[Population_Counter]), ALLEXCEPT('Population Overview','Population Overview'[LSOA_Code],'Population Overview'[District_Name],'Population Overview'[Ward_Name],'Population Overview'[GP_Practice_Name],'Population Overview'[PrimaryCareNetwork],'Population Overview'[Locality],'Population Overview'[Care_Home],'Population Overview'[IMD_Decile_England],'Population Overview'[IMD_Decile_Gloucester],'Population Overview'[EFi_Category]))
		formatString: 0%;-0%;0%
		lineageTag: afaa9933-eef4-47ef-abe6-58f00fbb88a1

	measure 'Proportion - eFI' = SUM('Population Overview'[Population_Counter])/CALCULATE(SUM('Population Overview'[Population_Counter]), ALLEXCEPT('Population Overview','Population Overview'[LSOA_Code],'Population Overview'[District_Name],'Population Overview'[Ward_Name],'Population Overview'[GP_Practice_Name],'Population Overview'[PrimaryCareNetwork],'Population Overview'[Locality],'Population Overview'[Care_Home],'Population Overview'[IMD_Decile_England],'Population Overview'[IMD_Decile_Gloucester],'Population Overview'[Ethnicity]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: fe521b5b-d2b1-4e66-bba8-3c17a14844b0

