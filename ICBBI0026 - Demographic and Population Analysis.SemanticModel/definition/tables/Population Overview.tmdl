table 'Population Overview'
	lineageTag: 79ff387f-1547-4a91-b64c-d910e31bae71

	measure 'Under 18''s' = Sum('Population Overview'[Under_18])/Sum('Population Overview'[Population_Counter])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 5670edaa-00ae-4974-86e1-5ad03695e15f

	measure '65 and Over' = Sum('Population Overview'[65_and_Over])/Sum('Population Overview'[Population_Counter])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3a880e1c-fa84-4fe4-84c6-ab2b351b0c66

	measure 'Ethnic Minorities' = Sum('Population Overview'[EthnicMinority])/Sum('Population Overview'[Population_Counter])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 851eefe3-8d13-4453-a6de-0531963aacaf

	measure 'Core 20' = Sum('Population Overview'[Core20])/Sum('Population Overview'[Population_Counter])
		formatString: 0.00%;-0.00%;0.00%
