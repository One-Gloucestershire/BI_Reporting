	partition Population = m
		mode: import
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "POWERBI_Reporting", [Query="SELECT #(lf)[GP_Practice_Code],#(lf)[GP_Practice_Name],#(lf)[GPLatitude],#(lf)[GPLongitude],#(lf)[Population] = SUM([Population]) #(lf)FROM (#(lf)#(tab)SELECT DISTINCT  #(lf)#(tab)[DPO].[GP_Practice_Code],#(lf)#(tab)[GP_Practice_Name] = CASE WHEN [DPO].[GP_Practice_Code] = 'L84080' THEN 'The Willow Tree Practice' ELSE [DPO].[GP_Practice_Name] END,#(lf)#(tab)[DPO].[GPLatitude],#(lf)#(tab)[DPO].[GPLongitude],#(lf)#(tab)[Population] = COUNT(*) #(lf)#(tab)FROM [PowerBI_Reporting].[dbo].[tbl_Demographics_Population_Overview] [DPO]#(lf)#(tab)WHERE [DPO].[GPLatitude] IS NOT NULL #(lf)#(tab)GROUP BY [DPO].[GP_Practice_Code],#(lf)#(tab)[DPO].[GP_Practice_Name],#(lf)#(tab)[DPO].[GPLatitude],#(lf)#(tab)[DPO].[GPLongitude]) AS SUB#(lf)GROUP BY [GP_Practice_Code],#(lf)[GP_Practice_Name],#(lf)[GPLatitude],#(lf)[GPLongitude]"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

