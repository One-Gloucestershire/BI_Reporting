	partition ED_Attendances = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Current", [Query="SELECT DISTINCT #(lf)[OrganisationCode],#(lf)[OrganisationName] = [GP].[ReportingOrganisationName],#(lf)[Network] = [GP].[PrimaryCareNetwork],#(lf)[Locality],#(lf)[MonthName] = LEFT([D].[MonthName],3),#(lf)[D].[FinancialYear],#(lf)[D].[YearMonth],#(lf)[Attendances]#(lf)FROM [CCG_Reference].[Reference].[vw_GPPractice] [GP]#(lf)#(lf)LEFT JOIN (SELECT #(lf)[Arrival_Date] = CAST([ArrivalDate] AS DATE),#(lf)[GPpractice_Derived],#(lf)[Attendances] = COUNT(AEattendanceNumber)#(lf)FROM [CCG_Current].[SEM].vw_EDAttendance#(lf)#(lf)WHERE CAST([ArrivalDate] AS DATE) >= '01-APR-2019'#(lf)GROUP BY #(lf)CAST([ArrivalDate] AS DATE),#(lf)[GPpractice_Derived]) AS [ED]#(lf)ON [ED].[GPpractice_Derived] = [GP].[OrganisationCode]#(lf)#(lf)LEFT JOIN [CCG_Reference].[Reference].[vw_DateLookup] AS [D]#(lf)ON [D].[Date] = [ED].[Arrival_Date]#(lf)#(lf)WHERE [PrimaryCareNetwork] IS NOT NULL"])
				in
				    Source

	annotation PBI_ResultType = Table

