table ED_Attendances
	lineageTag: 003765b0-f5b3-48bd-b0e9-abb58c63b976

	measure 'ED Attendances - Rate per 1000' = ```
			
			
			VAR EDATT = CALCULATE ( SUM ( ED_Attendances[Attendances] ) , ALLEXCEPT( Date_Table, Date_Table[financial_year] ) , Date_Table[ytd_flag] = 1) 
			VAR POP = CALCULATE ( SUM ( Populations[population] ) , ALLEXCEPT (Date_Table, Date_Table[financial_year] ) )
			
			RETURN ((EDATT/POP)*1000)
			```
		lineageTag: 1e9247bf-739c-40d1-83fc-517e495971b5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

