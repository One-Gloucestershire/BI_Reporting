table 'PDS Movement'
	lineageTag: be657d2e-fddf-4b6e-86cb-f0d591eeed29

	measure 'PDS Movement - Population' =
			
			
			SUM('PDS Movement'[Counter])
		formatString: #,0
		lineageTag: fe8b7a82-8f97-4508-a9db-3e1017456d2b

	measure 'PDS Movement - Net Movement' =
			
			
			CALCULATE(
			    SUM('PDS Movement'[Counter]),
			    'PDS Movement'[Movement_Type] = "Joiner"
			)
			
			-
			
			CALCULATE(
			    SUM('PDS Movement'[Counter]),
			    'PDS Movement'[Movement_Type] = "Leaver"
			)
		formatString: #,0
		lineageTag: abf8a69f-81b2-4469-b59b-a722e200e3fd

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'PDS Movement - Net Movement - Cards' = [PDS Movement - Net Movement]
		lineageTag: 2b9e5c76-67cc-41e9-b55d-8e4ee691ba49

		formatStringDefinition = "+,0;-,0"

	measure 'PDS Movement Leavers' =
			
			
			0
			
			-
			
			CALCULATE(
			    SUM('PDS Movement'[Counter]),
			    'PDS Movement'[Movement_Type] = "Leaver"
			)
		formatString: 0
		lineageTag: a84a9ec6-5ba3-4b7e-a104-1649fc4f1517

	measure 'PDS Movement - Joiners' =
			
			
			CALCULATE(
			    SUM('PDS Movement'[Counter]),
			    'PDS Movement'[Movement_Type] = "Joiner"
			)
		formatString: 0
		lineageTag: 3b5ce698-b86b-433f-9848-753334f7fdf9

	measure 'Base 0' =
			
			
			0
		formatString: 0
		lineageTag: 56db1c99-17e5-45f2-9749-f3deb039e8f6

	measure 'PDS Movement - Male Population' =
			
			
			CALCULATE(
			    SUM('PDS Movement'[Counter]),
			    'PDS Movement'[Gender] = "Male"
			)
		formatString: #,0
		lineageTag: d710eef3-8af8-4b37-aaad-bf1214a688c3

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'PDS Movement - Female Population' =
			
			
			CALCULATE(
			    SUM('PDS Movement'[Counter]),
			    'PDS Movement'[Gender] = "Female"
			)
		formatString: #,0
		lineageTag: d486a3c1-837d-457e-a343-927d13388ed8

	measure 'PDS Movement - Male Population Gloucestershire' =
			
			
			CALCULATE(
			    SUM('PDS Movement'[Counter]),
			    ALLSELECTED('PDS Movement'[10YR_Age_Band]),
			    'PDS Movement'[Gender] = "Male"
			)
		formatString: 0
		lineageTag: adb2186b-b86d-4e78-ba06-98fdc6ee4a8b

	measure 'PDS Movement - % Male Population' =
			
			
			[PDS Movement - Male Population] / [PDS Movement - Male Population Gloucestershire]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: cfaab70d-3247-4d59-b846-a1557e34106d

	measure 'PDS Movement - Female Population Gloucestershire' =
			
			
			CALCULATE(
			    SUM('PDS Movement'[Counter]),
			    ALLSELECTED('PDS Movement'[10YR_Age_Band]),
			    'PDS Movement'[Gender] = "Female"
			)
		formatString: 0
		lineageTag: 6cd37858-6ae0-4543-8e28-f05b83fdec74

	measure 'PDS Movement - % Female Population' =
			
			
			[PDS Movement - Female Population] / [PDS Movement - Female Population Gloucestershire]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 3d093d3a-4c43-4c81-8c38-5118139e675f

	measure 'PDS Movement - % Female Population Gloucestershire' = ```
			
			
			CALCULATE(
			    [PDS Movement - Female Population],
			    ALL('PDS Movement'[Core20Flag])
			)
			
			/
			
			CALCULATE(
			    [PDS Movement - Female Population Gloucestershire],
			    ALL('PDS Movement'[Core20Flag])
			)
			
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e88a68a6-11b4-428f-bd64-6ae7e29a341a

