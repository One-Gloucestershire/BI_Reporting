	measure 'Latest Month of Selection' =
			
			
			VAR _LATEST = MAX('Date Reference'[year_month])
			
			RETURN
			
			CALCULATE(MAX('Date Reference'[month_year]), 'Date Reference'[year_month] = _LATEST)
