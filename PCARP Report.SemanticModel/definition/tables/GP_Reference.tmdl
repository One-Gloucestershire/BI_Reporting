	partition GP_Reference = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Reference", [Query="SELECT DISTINCT [Practice_Code] = [OrganisationCode]#(lf)               ,[Practice_Name] = [ReportingOrganisationName]#(lf)#(tab)     ,[PCN] = [PrimaryCareNetwork]#(lf)#(tab)     ,[Locality]#(lf)#(lf)FROM [CCG_Reference].[Reference].[vw_GPPractice]#(lf)#(lf)WHERE [Locality] IS NOT NULL"])
				in
				    Source

