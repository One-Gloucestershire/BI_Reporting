		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "CCG_reference", [Query="#(tab)#(lf)#(tab)#(tab)set nocount on #(lf)#(lf)#(lf)--get list of required TFC's and their associated Descs#(lf)#(lf)select ISP.OrganisationCode#(lf),isp.OrganisationName#(lf)from CCG_Reference.Reference.vw_IndependentProvider as isp#(lf)where OrganisationCode in (#(lf)#(lf)'NVC', -- Ramsay Healthcare#(lf)'NT2', -- Nuffield Health#(lf)'AAH', -- Tetbury#(lf)'NXP', -- Independent Health Group #(lf) 'NTP') -- Practice Plus Group#(lf)#(lf) union all#(lf)#(lf)#(lf) select OrganisationCode#(lf) ,Name#(lf)#(lf) from  CCG_Reference.Reference.vw_OrganisationTrust AS NHSO#(lf)#(lf) where OrganisationCode = 'RTE' -- GHFT#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)"])
				in
