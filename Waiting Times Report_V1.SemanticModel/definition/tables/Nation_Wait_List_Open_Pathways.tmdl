	partition Nation_Wait_List_Open_Pathways-4198ea21-7170-47c1-8522-d039fbd858b8 = m
		mode: import
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "CCG_Current", [Query="#(tab)set nocount on #(lf)#(lf)#(tab)/*------------------------------------------------------------#(lf)#(tab)Delete Temp Tables if exists#(lf)#(tab)/-------------------------------------------------------------*/#(lf)#(lf)#(lf)#(tab)IF OBJECT_ID('tempdb..#latest_WL_Date_temp') is not null#(lf)#(tab)drop table #latest_WL_Date_temp #(lf)#(lf)#(tab)IF OBJECT_ID('tempdb..#latest_WL_Date') is not null#(lf)#(tab)drop table #latest_WL_Date#(lf)#(lf)#(tab)IF OBJECT_ID('tempdb..#Waiting_List_Type') is not null#(lf)#(tab)drop table #Waiting_List_Type#(lf)#(lf)#(tab)IF OBJECT_ID('tempdb..#Current_11M_Wait_List') is not null#(lf)#(tab)drop table #Current_11M_Wait_List#(lf)#(lf)#(tab)IF OBJECT_ID('tempdb..#Current_11M_Waiting_for_first_attendance') is not null#(lf)#(tab)drop table #Current_11M_Waiting_for_first_attendance#(lf)#(lf)#(tab)IF OBJECT_ID('tempdb..#Current_11M_Waiting_for_treatment') is not null#(lf)#(tab)drop table #Current_11M_Waiting_for_treatment#(lf)#(lf)#(tab)#(tab)IF OBJECT_ID('tempdb..#TFC') is not null#(lf)#(tab)drop table #TFC#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)#(tab)/*------------------------------------------------------------#(lf)#(tab)Declare Variables#(lf)#(tab)/-------------------------------------------------------------*/#(lf)#(lf)#(lf)#(tab)--Variable to get the latest WL snapshot with the most records (there are dq records with a snapshot date in the future)#(lf)#(tab)select wl.Week_Ending_Date#(lf)#(tab),total#(lf)#(tab),[Row_Order] = ROW_NUMBER()OVER( Order By week_ending_date DESC)#(lf)#(lf)#(tab)into #latest_WL_Date_temp #(lf)#(lf)#(tab)from #(lf)#(lf)#(tab)#(tab)(select Week_Ending_Date,COUNT(*) as total#(lf)#(tab)#(tab)from [Data_Mart_COVID19].[dbo].[National_Wait_List_Open_Pathways] WL#(lf)#(tab)#(tab)group by Week_Ending_Date ) as wl#(lf)#(lf)#(tab)#(tab)where total >1000#(lf)#(tab)#(tab)and Week_Ending_Date is not null#(lf)#(tab)#(tab)and Week_Ending_Date <= cast(getdate() as date)#(lf)#(tab)#(tab)order by ROW_NUMBER()OVER( Order By week_ending_date DESC)#(lf)#(lf)#(lf)#(tab)select distinct Week_Ending_Date#(lf)#(tab)into #latest_WL_Date#(lf)#(tab)from #latest_WL_Date_temp as l#(lf)#(tab)WHERE Row_Order = 1#(lf)#(lf)#(lf)#(tab)--variable to get required W/L type #(lf)#(tab)-- CHECK what is INON and ONON? do we need these?#(lf)#(lf)#(tab)select distinct Waiting_List_Type#(lf)#(lf)#(tab)into #Waiting_List_Type#(lf)#(lf)#(tab)from [Data_Mart_COVID19].[dbo].[National_Wait_List_Open_Pathways]#(lf)#(tab)WHERE Organisation_Identifier_Code_Of_Commissioner = '11M'#(lf)#(tab)AND Waiting_List_Type IN ('IRTT','ORTT')#(lf)#(lf)#(lf)#(tab)#(tab)--variable to get required TFC's#(lf)#(lf)#(tab)#(tab)CREATE TABLE #TFC (TFC INT);#(lf)#(lf)INSERT INTO #TFC (TFC)#(lf)VALUES #(lf)#(tab)(101),#(lf)#(tab)(103),#(lf)#(tab)(104),#(lf)#(tab)(106),#(lf)#(tab)(107),#(lf)#(tab)(108),#(lf)#(tab)(110),#(lf)#(tab)(120),#(lf)#(tab)(130),#(lf)#(tab)(191),#(lf)#(tab)(301),#(lf)#(tab)(302),#(lf)#(tab)(303),#(lf)#(tab)(306),#(lf)#(tab)(307),#(lf)#(tab)(320),#(lf)#(tab)(330),#(lf)#(tab)(340),#(lf)#(tab)(410),#(lf)#(tab)(420),#(lf)#(tab)(502) ; #(lf)#(lf)#(lf)#(lf)#(lf)#(tab)/*------------------------------------------------------------#(lf)#(tab)Start TEMP tables#(lf)#(tab)/-------------------------------------------------------------*/#(lf)#(lf)#(tab)/*------------------------------------------------------------#(lf)#(tab)National open pathways data tables start #(lf)#(tab)/-------------------------------------------------------------*/#(lf)#(lf)#(tab)--Gets most recent national open pathways data#(lf)#(lf)#(tab)select #(lf)#(tab)[Data_Source] = 'National_Wait_List_Open_Pathways'#(lf)#(tab),WL.*#(lf)#(tab),[Provider_Name] = isnull(o.name,i.OrganisationName)#(lf)#(tab),[Provider_Group] = CASE WHEN wl.Organisation_Identifier_Code_Of_Provider like 'RTE%' then 'GHFT (11M)' else 'Other Providers (11M)' END#(lf)#(tab),[Activity_Treatment_Function_Description] = tfc_ref.TreatmentFunctionDescription#(lf)#(tab),[Waiting_List_Type_Group] = case when WL.Waiting_List_Type = 'IRTT' then 'Admitted PTL'#(lf)#(tab)when  WL.Waiting_List_Type = 'ORTT' then 'Non-Admitted PTL'#(lf)#(tab)else 'Other' End#(lf)#(lf)#(tab)into #Current_11M_Wait_List#(lf)#(lf)#(tab)from [Data_Mart_COVID19].[dbo].[National_Wait_List_Open_Pathways] as WL#(lf)#(lf)#(tab)left join #Waiting_List_Type as WL_Type on wl.Waiting_List_Type = WL_Type.Waiting_List_Type#(lf)#(tab)left join CCG_Reference.Reference.vw_OrganisationTrust as o on o.OrganisationCode = wl.Organisation_Identifier_Code_Of_Provider#(lf)#(tab)left join CCG_Reference.Reference.vw_IndependentProvider as i on i.OrganisationCode = wl.Organisation_Identifier_Code_Of_Provider#(lf)#(tab)left join #TFC as TFC on tfc.TFC = wl.Activity_Treatment_Function_Code#(lf)#(lf)#(tab) left join CCG_Reference.Reference.vw_TreatmentFunction as tfc_ref on WL.Activity_Treatment_Function_Code = tfc_ref.TreatmentFunctionCode#(lf)#(lf)#(tab)where wl.Waiting_List_Type in (select * from #Waiting_List_Type) -- gets waiting list types#(lf)#(tab)and wl.Week_Ending_Date in (select * from #latest_WL_Date) -- gets current WL snapshot date#(lf)#(tab)and Organisation_Identifier_Code_Of_Commissioner = '11M' --- 11M registered patients only#(lf)#(tab)and tfc.TFC is not null --- only includes specified TFC's#(lf)#(tab)and Pseudo_NHS_Number is not null --  has an nhs ID#(lf)#(lf)#(lf)#(lf)#(tab)--All patients waiting for first attendance#(lf)#(lf)#(lf)#(tab)select #(lf)#(tab)[Metric] = 'Current_11M_Waiting_for_first_attendance'#(lf)#(tab),wl.*#(lf)#(tab),[Current_Wait_days] = cast(datediff(dd, isnull (wl.[Referral_To_Treatment_Period_Start_Date], wl.[Current_Pathway_Period_Start_Date]), wl.[Week_Ending_Date])   as float)#(lf)#(tab),[Current_Wait_weeks] =  cast(datediff(dd, isnull (wl.[Referral_To_Treatment_Period_Start_Date], wl.[current_pathway_period_start_date]), wl.[Week_Ending_Date]) / 7.0 as float)#(lf)#(lf)#(tab)into #Current_11M_Waiting_for_first_attendance#(lf)#(lf)#(tab)from #Current_11M_Wait_List as wl#(lf)#(lf)#(tab)where Date_Last_Attended is null -- no first attendance#(lf)#(tab)and Referral_To_Treatment_Period_End_Date is null -- RTT hasn't been completed #(lf)#(lf)#(lf)#(tab)--All patients waiting for treatment #(lf)#(lf)#(tab)select #(lf)#(tab)[Metric] = 'Current_11M_Waiting_for_treatment'#(lf)#(tab),wl.*#(lf)#(tab),[Current_Wait_days] = cast(datediff(dd, isnull (wl.[Referral_To_Treatment_Period_Start_Date], wl.[Current_Pathway_Period_Start_Date]), wl.[Week_Ending_Date])   as float)#(lf)#(tab),[Current_Wait_weeks] =  cast(datediff(dd, isnull (wl.[Referral_To_Treatment_Period_Start_Date], wl.[current_pathway_period_start_date]), wl.[Week_Ending_Date]) / 7.0 as float)#(lf)#(lf)#(tab)into #Current_11M_Waiting_for_treatment#(lf)#(lf)#(tab)from #Current_11M_Wait_List as wl#(lf)#(lf)#(tab)where wl.Referral_To_Treatment_Period_End_Date is null -- hasn't started treatment#(lf)#(lf)#(lf)#(tab)/*------------------------------------------------------------#(lf)#(tab)National open pathways data tables end #(lf)#(tab)/-------------------------------------------------------------*/#(lf)#(lf)#(tab)/*------------------------------------------------------------#(lf)#(tab)End of TEMP TABLES#(lf)#(tab)/-------------------------------------------------------------*/#(lf)#(lf)#(lf)#(tab)/*------------------------------------------------------------#(lf)#(tab)COMBINE ALL TEMP TABLES#(lf)#(tab)/-------------------------------------------------------------*/#(lf)#(lf)#(tab)/*------------------------------------------------------------#(lf)#(tab)FINAL OUTPUT as per Christian/Anneka specification 09/02/23#(lf)#(tab)/-------------------------------------------------------------*/#(lf)#(lf)#(tab)select *#(lf)#(tab),[NWT_Paeds_Flag] = case when Activity_Treatment_Function_code = '420' then 1 --paediatric service#(lf)#(tab)when CAST(NECS_Derived_Age_At_Referral as int) < 18 then 1 else 0 end #(lf)#(tab),[Provider_Code_Edit] = left(Organisation_Identifier_Code_Of_Provider,3)#(lf)#(lf)#(tab)FROM #(lf)#(tab)(SELECT * #(lf)#(tab)from #Current_11M_Waiting_for_first_attendance#(lf)#(lf)#(tab)union all #(lf)#(lf)#(tab)select * #(lf)#(tab)from #Current_11M_Waiting_for_treatment) as wt#(lf)#(lf)#(tab)Where#(lf)#(lf)#(lf)#(tab) (wt.Organisation_Identifier_Code_Of_Provider like '%RTE%' --GHFT#(lf)#(tab)or wt.Organisation_Identifier_Code_Of_Provider like '%NVC%' -- Ramsay Healthcare#(lf)#(tab)or wt.Organisation_Identifier_Code_Of_Provider like '%NT2%' -- Nuffield Health#(lf)#(tab)or wt.Organisation_Identifier_Code_Of_Provider like '%AAH%' -- Tetbury#(lf)#(tab)or wt.Organisation_Identifier_Code_Of_Provider like '%NXP%' -- Independent Health Group #(lf)#(tab)or wt.Organisation_Identifier_Code_Of_Provider like '%NTP%') -- Practice Plus Group#(lf)#(lf)#(lf)#(lf)#(lf)#(tab)--and Metric = 'Total_Waiting_for_treatment'#(lf)#(tab)--AND Activity_Treatment_Function_Code = '120'#(lf)#(tab)--and Age_Group = '18+'#(lf)#(tab)----and Waiting_List_Type = 'ORTT'#(lf)#(tab)/*------------------------------------------------------------#(lf)#(tab)Testing#(lf)#(tab)/-------------------------------------------------------------*/#(lf)#(lf)#(tab)--check if IWT data matches Joe's IWT report#(lf)#(lf)#(tab)#(tab)--select avg(cast(IndicativeWaitTime as float))#(lf)#(tab)#(tab)--from #iwt_data#(lf)#(tab)#(tab)--where Derived_ReferralYearMonth = '202211'#(lf)#(tab)#(tab)--AND Derived_ProviderOrganisationCode like 'RTE%'#(lf)#(lf)#(tab)#(tab)--select distinct  Organisation_Identifier_Code_Of_Provider#(lf)#(tab)#(tab)--from #Current_11M_Wait_List#(lf)#(lf)#(tab)#(tab)--order by Organisation_Identifier_Code_Of_Provider#(lf)#(lf)#(tab)#(tab)--select * #(lf)#(tab)#(tab)--from  #Current_11M_Wait_List#(lf)"])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

