	partition Admissions = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "PowerBI_Reporting", [Query="SELECT DISTINCT [INP].[nhs_number]#(lf)               ,[INP].[hospital_provider_spell_number]#(lf)               ,[INP].[practice_code]#(lf)#(tab)#(tab)#(tab)   ,[INP].[discharge_date]#(lf)#(tab)#(tab)#(tab)   ,[INP].[Emergency_Admission_flag]#(lf)#(tab)#(tab)#(tab)   ,[Length_of_Stay] = [INP].[total_bed_days]#(lf)#(lf)FROM [PowerBI_Reporting].[SecondaryCare].[tbl07_Inpatients] AS [INP]#(lf)#(lf)INNER JOIN (SELECT DISTINCT [PseudoNHSNumber]#(lf)            FROM [PowerBI_Reporting].[PrimaryCare].[tbl02_INT_Metrics_Table]) AS [INT]#(lf)ON [INT].[PseudoNHSNumber] = [INP].[nhs_number]#(lf)#(lf)WHERE [INP].[discharge_date] >= '20230701'"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

