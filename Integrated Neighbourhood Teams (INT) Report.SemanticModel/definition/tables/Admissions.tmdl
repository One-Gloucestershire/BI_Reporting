	partition Admissions = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "select distinct inp.nhs_number as nhs_number, inp.hospital_provider_spell_number as hospital_provider_spell_number, inp.practice_code as practice_code, inp.discharge_date as discharge_date, inp.emergency_admission_flag as ""Emergency_Admission_flag"", inp.total_bed_days as ""Length_of_Stay"" from data_mart_powerbi_secondarycare.tbl07_inpatients as inp inner join (select distinct pseudonhsnumber from data_mart_powerbi_primarycare.tbl02_int_metrics_table) as i on i.pseudonhsnumber = inp.nhs_number where inp.discharge_date >= '2023-07-01'", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table

