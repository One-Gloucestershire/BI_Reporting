	measure 'Metric - Total LOS' = ```
			
			
			VAR _TOTALPATIENTS = 
			    CALCULATE(
			        DISTINCTCOUNT('Admissions'[hospital_provider_spell_number]),
			        'INT Metric Population'[65+_Flag] = 1,
			        'INT Metric Population'[Frailty_Category] IN {"Moderate", "Severe"})
			
			VAR _TOTALLOS = 
			      CALCULATE(
			        SUM('Admissions'[Length_of_Stay]),
			        'INT Metric Population'[65+_Flag] = 1,
			        'INT Metric Population'[Frailty_Category] IN {"Moderate", "Severe"})
			
			RETURN
			
			_TOTALLOS / _TOTALPATIENTS
			```
		formatString: 0.0
		lineageTag: 68da7808-70c8-4116-9d25-718fa81683f0

	measure 'Metric - Emergency Admissions per Person' = ```
			
			
			VAR _ADMISSIONS = 
			
			    CALCULATE(
			        COUNT('Admissions'[nhs_number]),
			        'Admissions'[Emergency_Admission_flag] = 1,
			        'INT Metric Population'[65+_Flag] = 1,
			        'INT Metric Population'[Frailty_Category] IN {"Moderate", "Severe"}
			    )
			
			VAR _POP = 
			
			    CALCULATE(
			        [Metric - Rockwood Population],
			        'INT Metric Population'[Frailty_Category] IN {"Moderate", "Severe"},
			        'INT Metric Population'[65+_Flag] = 1
			    )
			
			RETURN (_ADMISSIONS / _POP) * 1000
			
			```
		formatString: 0.0
		lineageTag: e58331af-29cb-4f60-a5e4-185018cf7ae3

	measure 'Metric - Rockwood Population - PQ' =
			
			
			VAR _MAXDATE = MAX('Date Reference'[Date_3_Months_Back])
			
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT('INT Metric Population'[PseudoNHSNumber]),
			        'INT Metric Population'[Rockwood_Event_Date] <= _MAXDATE,
			        OR (ISBLANK('INT Metric Population'[Removal_Date]), 'INT Metric Population'[Removal_Date] >= _MAXDATE)
			    )
		formatString: #,0
		lineageTag: f3649256-3477-4530-af1b-efff1d671f5c

	measure 'Variance - Rockwood Population' =
			
			
