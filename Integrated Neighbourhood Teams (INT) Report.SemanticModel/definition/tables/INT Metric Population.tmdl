table 'INT Metric Population'
	lineageTag: 13840f1a-087d-4027-8945-3c9a1c7a7101

	measure 'Metric - Rockwood Population' =
			
			
			VAR _MAXDATE = MAX('Date Reference'[date])
			
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT('INT Metric Population'[PseudoNHSNumber]),
			        'INT Metric Population'[Rockwood_Event_Date] <= _MAXDATE,
			        OR (ISBLANK('INT Metric Population'[Removal_Date]), 'INT Metric Population'[Removal_Date] >= _MAXDATE)
			    )
		formatString: #,0
		lineageTag: 30f82c38-96bd-458d-920a-b031c7651acc

	measure 'Metric - % 65+ With Rockwood Coding' =
			
			
			CALCULATE([Metric - Rockwood Population], 'INT Metric Population'[65+_Flag] = 1)
			
			/
			
			[65+ GP Population]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 98e6d509-8687-4ccf-8002-9047b338d36a

	measure 'Metric - Total PC&SP Completed' =
			
			
			SUM('PC&SP Events'[Counter])
		formatString: #,0
		lineageTag: 30156cb7-3162-41d8-8253-2b54955e11e6

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Metric - % Rockwood with PC&SP Completed' = ```
			
			
			VAR _MAXDATE = MAX('Date Reference'[date])
			
			VAR _RWPCSP = 
			    CALCULATE(
			        [Metric - Rockwood Population],
			        'INT Metric Population'[Frailty_Category] IN {"Moderate", "Severe"},
			        'INT Metric Population'[PCSP_Date] <= _MAXDATE,
			        'INT Metric Population'[PCSP_Flag] = 1,
			        'INT Metric Population'[65+_Flag] = 1
			    )
			
			VAR _RWPOP = 
			    CALCULATE(
			        [Metric - Rockwood Population],
			        'INT Metric Population'[Frailty_Category] IN {"Moderate", "Severe"},
			        'INT Metric Population'[65+_Flag] = 1
			    )
			
			RETURN
			
			_RWPCSP / _RWPOP
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: b0d46c03-f30d-4eb2-a7d8-252252952abe

	measure 'Metric - Total ReSPECT Completed' =
			
			
			SUM('ReSPECT Events'[Counter])
		formatString: #,0
		lineageTag: 7387190b-1d71-49dc-9a72-de1298343f76

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Metric - % Rockwood with ReSPECT Completed' = ```
			
			
			VAR _MAXDATE = MAX('Date Reference'[date])
			
			VAR _RWReSPECT = 
			    CALCULATE(
			        [Metric - Rockwood Population],
			        'INT Metric Population'[Frailty_Category] IN {"Moderate", "Severe"},
			        'INT Metric Population'[ReSPECT_Flag] = 1,
			        'INT Metric Population'[ReSPECT_Date] <= _MAXDATE,
			        'INT Metric Population'[65+_Flag] = 1
			    )
			
			VAR _RWPOP = 
			    CALCULATE(
			        [Metric - Rockwood Population],
			        'INT Metric Population'[Frailty_Category] IN {"Moderate", "Severe"},
			        'INT Metric Population'[65+_Flag] = 1
			    )
			
			RETURN
			
			_RWReSPECT / _RWPOP
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: f374fae5-8259-4208-b86a-ef9ba54ae611

	measure 'Total Rockwood Events' = ```
			
			
			    CALCULATE(
			        SUM('INT Metric Population'[Counter]), 
			        USERELATIONSHIP('Date Reference'[date], 'INT Metric Population'[Rockwood_Event_Date]),
			        'INT Metric Population'[65+_Flag] = 1)
			```
		formatString: 0
		lineageTag: 1f1c49c4-699a-4ec1-998a-6fb70c428363

	measure 'RockWood Pop - 65+ / Moderate / Severe' = ```
			
			
