	partition 'Selection Parameter' = calculated
		mode: import
		source =
				{
				    ("Rockwood Population", NAMEOF('INT Metric Population'[Variance - Rockwood Population]), 0),
				    ("% 65+ With Rockwood Coding", NAMEOF('INT Metric Population'[Variance - % 65+ With Rockwood Coding]), 1),
				    ("Total PC&SP Completed", NAMEOF('INT Metric Population'[Variance - Total PC&SP Completed]), 2),
				    ("% Rockwood with PC&SP Completed", NAMEOF('INT Metric Population'[Variance - % Rockwood with PC&SP Completed]), 3),
				    ("Total ReSPECT Completed", NAMEOF('INT Metric Population'[Variance - Total ReSPECT Completed]), 4),
				    ("% Rockwood with ReSPECT Completed", NAMEOF('INT Metric Population'[Variance - % Rockwood with ReSPECT Completed]), 5),
				    ("Total Length of Stay", NAMEOF('INT Metric Population'[Variance - Total LOS]), 6),
				    ("Emergency Admissions per Person", NAMEOF('INT Metric Population'[Variance - Emergency Admissions per Person]), 7)
				}

	annotation PBI_Id = 29635c0e9f4a47e6af373945dd456df1

