table 'Selection Parameter'
	lineageTag: b44c6446-b3d8-4c42-82b3-a9ee32915cf2

	measure 'Selected Parameter Option' =
			
			
			MAX('Selection Parameter'[Parameter])
		lineageTag: 86d7da8e-7fff-496e-9727-ff0cab89003d

	measure 'Variation Title' =
			
			
			CONCATENATE("Quarterly Variation - ", [Selected Parameter Option])
		lineageTag: 96cea769-7356-44d1-9340-9c3217038744

	measure 'Parameter - PCN Split Output' =
			
			
			IF(
			    CONTAINSSTRINGEXACT([Selected Parameter Option], "Rockwood Population"), [Metric - Rockwood Population],
			    IF(CONTAINSSTRINGEXACT([Selected Parameter Option], "% 65+ With Rockwood Coding"), [Metric - % 65+ With Rockwood Coding],
			        IF(CONTAINSSTRINGEXACT([Selected Parameter Option], "Total PC&SP Completed"), [Metric - Total PC&SP Completed],
			            IF(CONTAINSSTRINGEXACT([Selected Parameter Option], "% Rockwood with PC&SP Completed"), [Metric - % Rockwood with PC&SP Completed],
			                IF(CONTAINSSTRINGEXACT([Selected Parameter Option], "Total ReSPECT Completed"), [Metric - Total ReSPECT Completed],
			                    IF(CONTAINSSTRINGEXACT([Selected Parameter Option], "% Rockwood with ReSPECT Completed"), [Metric - % Rockwood with ReSPECT Completed],
			                        IF(CONTAINSSTRINGEXACT([Selected Parameter Option], "Total Length of Stay"), [Metric - Total LOS],
			                            IF(CONTAINSSTRINGEXACT([Selected Parameter Option], "Emergency Admissions per Person"), [Metric - Emergency Admissions per Person],
			                                BLANK()
			                            ))))))))
		lineageTag: 7120ca69-4979-4eb0-910f-960fbc4a21af

		formatStringDefinition =
				IF(
				    CONTAINSSTRINGEXACT([Selected Parameter Option], "Rockwood Population"), "0",
				    IF(CONTAINSSTRINGEXACT([Selected Parameter Option], "% 65+ With Rockwood Coding"), "0.0%",
				        IF(CONTAINSSTRINGEXACT([Selected Parameter Option], "Total PC&SP Completed"), "0",
				            IF(CONTAINSSTRINGEXACT([Selected Parameter Option], "% Rockwood with PC&SP Completed"), "0.0%",
				                IF(CONTAINSSTRINGEXACT([Selected Parameter Option], "Total ReSPECT Completed"), "0",
				                    IF(CONTAINSSTRINGEXACT([Selected Parameter Option], "% Rockwood with ReSPECT Completed"), "0.0%",
				                        IF(CONTAINSSTRINGEXACT([Selected Parameter Option], "Total Length of Stay"), "0.0",
				                            IF(CONTAINSSTRINGEXACT([Selected Parameter Option], "Emergency Admissions per Person"), "0.0",
				                                BLANK()
				                            ))))))))

	measure 'Parameter - Colours' =
			
			
			IF(
			    CONTAINSSTRINGEXACT([Selected Parameter Option], "Rockwood Population"), "#05668d",
			    IF(CONTAINSSTRINGEXACT([Selected Parameter Option], "% 65+ With Rockwood Coding"), "#05668d",
			        IF(CONTAINSSTRINGEXACT([Selected Parameter Option], "Total PC&SP Completed"), "#028090",
			            IF(CONTAINSSTRINGEXACT([Selected Parameter Option], "% Rockwood with PC&SP Completed"), "#028090",
			                IF(CONTAINSSTRINGEXACT([Selected Parameter Option], "Total ReSPECT Completed"), "#00A896",
			                    IF(CONTAINSSTRINGEXACT([Selected Parameter Option], "% Rockwood with ReSPECT Completed"), "#00A896",
			                        IF(CONTAINSSTRINGEXACT([Selected Parameter Option], "Total Length of Stay"), "#02C39A",
			                            IF(CONTAINSSTRINGEXACT([Selected Parameter Option], "Emergency Admissions per Person"), "#02C39A",
			                                BLANK()
			                            ))))))))
		lineageTag: 9df08b9b-4716-4c8e-aa52-cf32ae030e3b

	measure 'Colours - Rockwood Population' =
			
			
			IF(
			    [Variance - Rockwood Population] < 0, "#EF5B5B", "#8CB369"
			)
		lineageTag: 711738cf-982b-4afe-87c6-1d6c49c95870

	measure 'Colours - % 65+ With Rockwood Coding' =
			
			
			IF(
			    [Variance - % 65+ With Rockwood Coding] < 0, "#EF5B5B", "#8CB369"
			)
		lineageTag: c3e2bc79-d386-4fa7-a215-39c1b54a406b

	measure 'Colours - Total PC&SP Coded' =
			
			
			IF(
			    [Variance - Total PC&SP Completed] < 0, "#EF5B5B", "#8CB369"
			)
		lineageTag: 4b9170b7-2818-4094-ad5d-7cea5c35cea2

	measure 'Colours - % Rockwood with PC&SP Completed' =
			
			
			IF(
			    [Variance - % Rockwood with PC&SP Completed] < 0, "#EF5B5B", "#8CB369"
			)
		lineageTag: 5a6ed2eb-eb8f-4cbe-9ab3-ef5f1d4b698a

	measure 'Colours - Total ReSPECT Coded' =
			
			
			IF(
			    [Variance - Total ReSPECT Completed] < 0, "#EF5B5B", "#8CB369"
			)
		lineageTag: e4c6c7c3-c45f-4050-b2bd-7445c63496f7

	measure 'Colours - % Rockwood with ReSPECT Completed' =
			
			
			IF(
			    [Variance - % Rockwood with ReSPECT Completed] < 0, "#EF5B5B", "#8CB369"
			)
		lineageTag: 9acb5e08-b602-4e6e-9912-70ce08036f7a

	measure 'Colours - Total LOS' =
			
			
			IF(
			    [Variance - Total LOS] > 0, "#EF5B5B", "#8CB369"
			)
		lineageTag: bbf5879f-6992-4eea-9e39-67c222c6d1ef

	measure 'Colours - Emergency Admissions per Person' =
			
			
			IF(
			    [Variance - Emergency Admissions per Person] > 0, "#EF5B5B", "#8CB369"
			)
		lineageTag: a11b0335-f5a3-4a82-b3b9-284fe282f594

	measure 'Narrative - % 65+ With Rockwood Coding' =
			
			
			[Variance - % 65+ With Rockwood Coding]
		lineageTag: 0fc965ce-f276-4e62-b1d5-e97aa1ed6f65

		formatStringDefinition = IF([Variance - % 65+ With Rockwood Coding] >= 0, "+0.0%", "0.0%")

	measure 'Narrative - Rockwood Population' =
			
			
			[Variance - Rockwood Population]
		lineageTag: a2034b50-8040-4c3b-99c8-e3f760269063

		formatStringDefinition = IF([Variance - Rockwood Population] >= 0, "+0", "0")

	measure 'Narrative - Total PC&SP Completed' =
			
			
			[Variance - Total PC&SP Completed]
		lineageTag: 27dfbce3-4b35-4187-b335-fc50ddd11a00

		formatStringDefinition = IF([Variance - Total PC&SP Completed] >= 0, "+0", "0")

	measure 'Narrative - % Rockwood with PC&SP Completed' =
			
			
			[Variance - % Rockwood with PC&SP Completed]
		lineageTag: 7232d5b0-e599-4362-8ef2-f2b95656aeff

		formatStringDefinition =
				
				IF([Variance - % Rockwood with PC&SP Completed] >= 0, "+0.0%", "-0.0%")

	measure 'Narrative - Total ReSPECT Coded' =
			
			
			[Variance - Total ReSPECT Completed]
		lineageTag: 16fff9ca-171b-4d69-a91a-7c2d16343504

		formatStringDefinition =
				
				IF([Variance - Total ReSPECT Completed] >= 0, "+0,0", "0,0")

	measure 'Narrative - % Rockwood with ReSPECT Completed' =
			
			
			[Variance - % Rockwood with ReSPECT Completed]
		lineageTag: 542c01c1-7df3-471b-9828-977b6b2cc5ef

		formatStringDefinition =
				
				IF([Variance - % Rockwood with ReSPECT Completed] >= 0, "+0.0%", "0.0%")

	measure 'Narrative - Total LOS' =
			
			
			[Variance - Total LOS]
		lineageTag: 9b71b896-399e-4ad9-9ffd-72f70777bd87

		formatStringDefinition =
				
				IF([Variance - Total LOS] >= 0, "+0.0", "0.0")

	measure 'Narrative - Emergency Admissions per Person' =
			
			
			[Variance - Emergency Admissions per Person]
		lineageTag: 2fa194bc-f855-48bb-b426-bb29b0248ff1

		formatStringDefinition = IF([Variance - Emergency Admissions per Person] >= 0, "+0.0", "0.0")

	column Parameter
		lineageTag: 5df06df6-1d26-4574-bd55-4c97ed3b4fa1
