	partition Ref_Organisations-593dae51-bb80-4e7b-b516-cd54ef8974b9 = m
		mode: import
		queryGroup: 'Reference Tables'
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "CCG_reference", [Query="#(tab)#(lf)#(tab)#(tab)set nocount on #(lf)#(lf)#(lf)IF OBJECT_ID('tempdb..#temp', 'U') IS NOT NULL DROP TABLE #temp; #(lf)#(lf)#(lf)--get list of required TFC's and their associated Descs#(lf)#(lf)select ISP.OrganisationCode#(lf),isp.OrganisationName#(lf)into #temp#(lf)from CCG_Reference.Reference.vw_IndependentProvider as isp#(lf)where OrganisationCode in (#(lf)#(lf)'NVC', -- Ramsay Healthcare#(lf)'NT2', -- Nuffield Health#(lf)'AAH', -- Tetbury#(lf)'NXP', -- Independent Health Group #(lf) 'NTP',-- Practice Plus Group#(lf) 'ACG', -- Newmedica#(lf)'NPG', -- Spamedica#(lf)'NWV') -- GP Care UK#(lf)#(lf) union all#(lf)#(lf)#(lf) select OrganisationCode#(lf) ,Name#(lf)#(lf) from  CCG_Reference.Reference.vw_OrganisationTrust AS NHSO#(lf)#(lf) where OrganisationCode = 'RTE' -- GHFT#(lf)#(lf)#(lf)#(lf)#(lf) --- Main Query#(lf)#(lf) #(lf) select * #(lf)#(lf) from #(lf) #(lf) #temp #(lf)#(lf)cross apply #(lf) #(lf) (SELECT STUFF((SELECT ',' + OrganisationName#(lf)              FROM #temp#(lf)#(tab)#(tab)#(tab)  order by OrganisationName#(lf)              FOR XML PATH(''), TYPE)#(lf)             .value('.', 'nvarchar(max)'), 1, 1, ''#(lf)#(tab)#(tab)#(tab)) AS all_providers) AS C #(lf)#(lf)#(lf)#(lf)#(lf)#(lf)"])
				in
				    Source

