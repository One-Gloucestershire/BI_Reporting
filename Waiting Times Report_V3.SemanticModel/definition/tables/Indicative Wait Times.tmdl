				    Source = Sql.Database("GRH-CCG-SQL", "CCG_Current", [Query="set nocount on #(lf)#(lf)/*------------------------------------------------------------#(lf)Delete Temp Tables if exists#(lf)/-------------------------------------------------------------*/#(lf)#(lf)#(tab)IF OBJECT_ID('tempdb..#latest_Reporting_Month') is not null#(lf)#(tab)drop table #latest_Reporting_Month#(lf)#(lf)#(tab)IF OBJECT_ID('tempdb..#TFC') is not null#(lf)#(tab)drop table #TFC#(lf)#(lf)#(tab)#(tab)IF OBJECT_ID('tempdb..#ServiceID_Exclusions') is not null#(lf)#(tab)drop table #ServiceID_Exclusions#(lf)#(lf)/*------------------------------------------------------------#(lf)Create Temp Tables#(lf)/-------------------------------------------------------------*/#(lf)#(lf)--Identifies the latest Reporting Month#(lf)#(lf)select L.*#(lf),D.MonthYearName as 'Latest_Month_Name'#(lf)#(lf)into #latest_Reporting_Month#(lf)#(lf)from #(lf)#(lf)(SELECT  max(e.Derived_ReferralYearMonth) as 'Latest_Month'#(lf)from [CCG_Current].[EReferrals].[vw_Events] as e#(lf)inner join#(lf)(select  YearMonth#(lf)from CCG_Reference.Reference.vw_DateLookup#(lf)where date = cast(getdate() as date)) as d on e.Derived_ReferralYearMonth < D.YearMonth) as l#(lf)#(lf)left join #(lf)#(lf)(select distinct YearMonth,MonthYearName#(lf)from CCG_Reference.Reference.vw_DateLookup as d) as d on d.YearMonth = l.Latest_Month#(lf)#(lf)#(lf)#(lf)#(lf)--Specified Treatment Function codes from Anneka Taylor#(lf)#(lf)#(tab)#(tab)CREATE TABLE #TFC (TFC INT);#(lf)#(lf)INSERT INTO #TFC (TFC)#(lf)VALUES #(lf)    (100),#(lf)#(tab)(101),#(lf)#(tab)(103),#(lf)#(tab)(104),#(lf)#(tab)(106),#(lf)#(tab)(107),#(lf)#(tab)(108),#(lf)#(tab)(110),#(lf)#(tab)(120),#(lf)#(tab)(130),#(lf)#(tab)(191),#(lf)#(tab)(301),#(lf)#(tab)(302),#(lf)#(tab)(303),#(lf)#(tab)(306),#(lf)#(tab)(307),#(lf)#(tab)(320),#(lf)#(tab)(330),#(lf)#(tab)(340),#(lf)#(tab)(410),#(lf)#(tab)(420),#(lf)#(tab)(502) ; #(lf)#(lf)#(tab)--Specified service exclusions from Aneeka Taylor#(lf)#(lf)#