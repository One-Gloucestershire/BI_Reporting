lf)'5076081',#(lf)'7917761',#(lf)'7919623',#(lf)'7945805',#(lf)'7975220',#(lf)'7976779')#(lf)#(lf)#(lf)#(lf)#(lf)/*------------------------------------------------------------#(lf)Main Output#(lf)/-------------------------------------------------------------*/#(lf)#(lf)--Create IWT data#(lf)#(lf)SELECT #(lf)[Metric] = 'Indicative_wait_times'#(lf),[Data_Source] = 'IWT_Data_EReferrals'#(lf),[Provider_Code_Edit] = left(iwt.Derived_ProviderOrganisationCode,3)#(lf),[Provider_Group] = CASE WHEN iwt.Derived_ProviderOrganisationCode like 'RTE%' then 'GHFT (11M)' else 'Other Providers (11M)' END#(lf)--,[Referral_in_the_last_3_months_flag] =  case when  cast([EReferralPathwayStartDate] as date) >= DATEADD(MM,-4,DATEADD(mm,DATEDIFF(MONTH,0,GETDATE()),0)) then 1 else 0 end#(lf),[Latest_Reporting_Month] = case when lrm.Latest_Month is not null then 1 else 0 end --flag to identify the latest reporting month#(lf),[Latest_Reporting_Month_Name] = lrm.Latest_Month_Name#(lf),[Month_Year_Name_of_Referral] = d.MonthYearName#(lf),[Indicative_wait_time_weeks] = cast(IndicativeWaitTime as float)/7 #(lf),[Last_Updated] = cast(getdate() as date)#(lf),[IWT_Paeds_Flag] = CASE WHEN [ServiceName] LIKE '%paediatric%' THEN '1'#(lf)#(tab)        WHEN [ServiceName] LIKE '%paeds%' THEN '1'#(lf)#(tab)        WHEN [ServiceName] LIKE '%children%' THEN '1'#(lf)#(tab)#(tab)    WHEN [ServiceName] LIKE '%adolescent%' THEN '1'#(lf)#(tab)#(tab)    WHEN [ServiceName] LIKE '%under 5s%' THEN '1'#(lf)#(tab)#(tab)#(tab)WHEN cast([PatientAge] as int) < 18 then '1' else 0     END#(lf),iwt.*#(lf)#(lf)#(lf)#(lf)  FROM [CCG_Current].[EReferrals].[vw_Events] as IWT#(lf)left join #latest_Reporting_Month as lrm on lrm.Latest_Month = iwt.Derived_ReferralYearMonth#(lf)left join CCG_Reference.Reference.vw_DateLookup as d on d.Date = IWT.EReferralPathwayStartDate#(lf)left join #ServiceID_Exclusions as serv_excl on serv_excl.ServiceID = iwt.ServiceID#(lf)#(lf)#(lf)#(lf)#(lf)  where Derived_ActionYearMonth > '201904'#(lf)#(lf)  and Derived_ReferringOrganisationParentCode = '11M'#(lf)  --and Derived_ProviderOrganisationCode = 'RTE'#(lf)  AND cast([EReferralPathwayStartDate] as date) >= DATEADD(MM,-13,DATEADD(mm,DATEDIFF(MONTH,0,GETDATE()),0)) -- last 12 months #(lf)AND [Derived_ActionDescription] IN ('Book Appointment','Rebook Appointment')#(lf)and IndicativeWaitTime is not null#(lf)and Derived_PriorityDescription <> '2 Week Wait'#(lf)and (iwt.Derived_ProviderOrganisationCode like '%NVC%' -- Ramsay Healthcare#(lf)or iwt.Derived_ProviderOrganisationCode like '%NT2%' -- Nuffield Health#(lf)or iwt.Derived_ProviderOrganisationCode like '%AAH%' -- Tetbury#(lf)or iwt.Derived_ProviderOrganisationCode like '%NXP%' -- Independent Health Group #(lf)or iwt.Derived_ProviderOrganisationCode like '%NTP%' -- Practice Plus Group#(lf)or iwt.Derived_ProviderOrganisationCode like '%RTE%' -- GHFT#(lf)or iwt.Derived_ProviderOrganisationCode like '%ACG%' -- Newmedica#(lf)or iwt.Derived_ProviderOrganisationCode like '%NPG%' -- Spamedica#(lf)or iwt.Derived_ProviderOrganisationCode like '%NWV%')  --GP Care UK#(lf)#(lf)#(lf)and Derived_TreatmentFunctionCode in (select * from #TFC) -- only selected TFCs#(lf)and serv_excl.ServiceID is null --excludes specific service ID's#(lf)#(lf)/*------------------------------------------------------------#(lf)TEST#(lf)/-------------------------------------------------------------*/#(lf)#(lf)#(lf)#(lf)--SELECT IWT.*#(lf)#(lf)--  FROM [CCG_Current].[EReferrals].[vw_Events] as IWT#(lf)#(lf)#(lf)--  where Derived_ActionYearMonth > '201904'#(lf)#(lf)--  and Derived_ReferringOrganisationParentCode = '11M'#(lf)--  --and Derived_ProviderOrganisationCode = 'RTE'#(lf)--  AND cast([EReferralPathwayStartDate] as date) >= DATEADD(MM,-13,DATEADD(mm,DATEDIFF(MONTH,0,GETDATE()),0)) -- last 12 months #(lf)--AND [Derived_ActionDescription] IN ('Book Appointment','Rebook Appointment')#(lf)--and IndicativeWaitTime is not null#(lf)--and Derived_PriorityDescription <> '2 Week Wait'#(lf)#(lf)#(lf)#(lf)"])
