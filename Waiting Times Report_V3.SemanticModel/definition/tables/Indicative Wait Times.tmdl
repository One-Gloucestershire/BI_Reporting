table 'Indicative Wait Times'
	lineageTag: a93b632d-c75d-4611-96a0-43e9852459fe

	measure Measure = ```
			if 
			```
		lineageTag: 4417ec6e-2395-4856-8366-9dcd8a635f9f

	measure Average_of_Indicative_Wait_Time_Weeks = IF(ISBLANK(AVERAGE('Indicative Wait Times'[Indicative_wait_time_weeks])), "", AVERAGE('Indicative Wait Times'[Indicative_wait_time_weeks]))
		formatString: 0.0
		lineageTag: 4016f13a-7ca0-48c1-b70c-ffa28802ad2d

		annotation PBI_ChangedProperties = ["FormatString"]

	measure Latest_Reporting_Month_Edit = IF(COUNTROWS('Indicative Wait Times') = 0, "N/A", min('Indicative Wait Times'[Latest_Reporting_Month_Name]))
		lineageTag: 54929e25-045f-4ed8-9655-8ed4a6b96abe

