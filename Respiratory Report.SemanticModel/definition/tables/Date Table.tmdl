	partition 'Date Table-a58e324f-da8c-4d0f-b34a-98d82b6852df' = m
		mode: import
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "CCG_Reference", [Query="declare @reporting_month as int#(lf)set @reporting_month = #(lf)#(lf)(select  FinancialMonth as 'latest_date'#(lf)  from #(lf)  [CCG_Reference].[Reference].[vw_DateLookup]#(lf)  where date = EOMONTH(DATEADD(MONTH, -1, GETDATE())))#(lf)#(lf)#(lf)#(lf)  ---Final output#(lf)#(lf)select [Date] [date]#(lf)      ,[DayMonthYear] [day_month_year]#(lf)      ,[Day] [day]#(lf)      ,[Weekday] [weekday]#(lf)      ,[WeekDayName] [weekday_name]#(lf)      ,[Month] [month]#(lf)      ,left([MonthName],3) [month_name]#(lf)      ,[Quarter] [quarter]#(lf)      ,[YearMonth] [year_month]#(lf)      ,[IsWeekend] [is_weekend]#(lf)      ,[IsHoliday] [is_holiday]#(lf)      ,[FinancialWeekofYear] [financial_week_of_year]#(lf)      ,[FinancialYear] [financial_year]#(lf)      ,[FinancialQuarter] [financial_quarter]#(lf)      ,[FirstDateofMonth]#(lf)      ,[FinancialMonth] [financial_month]#(lf)      ,[MonthYearName] [month_year_name]#(lf)         ,[Reporting_Month_Flag] = case when FinancialMonth <= @reporting_month then 1 #(lf)         when FinancialMonth> @reporting_month then 0 end#(lf)#(lf)from [CCG_Reference].[Reference].[vw_DateLookup]#(lf)--where [Date] >= '20190401'#(lf)where [Date] BETWEEN '20180401' AND EOMONTH(DATEADD(MONTH, -1, GETDATE()))#(lf)"])
				in
				    Source

