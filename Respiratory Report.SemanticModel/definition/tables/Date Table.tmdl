	partition 'Date Table-a58e324f-da8c-4d0f-b34a-98d82b6852df' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db01_reference"), "select date as ""date"", daymonthyear as ""day_month_year"", day as ""day"", weekday as ""weekday"", weekdayname as ""weekday_name"", month as ""month"", left(monthname,3) as ""month_name"", quarter as ""quarter"", yearmonth as ""year_month"", isweekend as ""is_weekend"", isholiday as ""is_holiday"", financialweekofyear as ""financial_week_of_year"", financialyear as ""financial_year"", financialquarter as ""financial_quarter"", financialmonth as ""financial_month"", monthyearname as ""month_year_name"", firstdateofmonth as ""FirstDateofMonth"", case when cast(financialmonth as int) <= (select cast(financialmonth as int) from ccg_reference.vw_datelookup where date = last_day(dateadd(month,-1,current_date))) then 1 when cast(financialmonth as int) > (select cast(financialmonth as int) from ccg_reference.vw_datelookup where date = last_day(dateadd(month,-1,current_date))) then 0 end as ""Reporting_Month_Flag"" from ccg_reference.vw_datelookup where date between '20180401' and last_day(dateadd(month,-1,current_date))", null, [EnableFolding=true])
				in
				    Source

