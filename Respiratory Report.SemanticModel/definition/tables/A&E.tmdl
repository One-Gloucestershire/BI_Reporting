table A&E
	lineageTag: 7b8712c4-7696-449b-8dda-f625f478e697

	measure admitted_from_AE = CALCULATE(COUNT('A&E'[Counter]),FILTER('A&E','A&E'[Destination] in {"Discharge to ward","Emergency department discharge to high dependency unit","Emergency department discharge to intensive care unit","Emergency department discharge to neonatal intensive care unit","Emergency department discharge to special care baby unit","Emergency department discharge to coronary care unit","Emergency department discharge to emergency department short stay ward","Emergency department discharge to ambulatory emergency care service"}))
		formatString: 0
		lineageTag: 499dfbd3-5dd2-4fb9-93ab-65426d0def12

	measure 'Rate per 1000 Population AE' = ```
			
			VAR Latest_GP_Population_date = MAX(GP_Practice_Population[first_date_of_month])
			 
			--Below calculates the rate per 1000 with the filter on the latest GP population date 
			RETURN
			IFERROR(Calculate((sum('A&E'[Counter])/sum(GP_Practice_Population[Total_Population]))*1000,GP_Practice_Population[first_date_of_month] = Latest_GP_Population_date),BLANK())
			```
		lineageTag: a7448a68-c051-45a9-8803-8b182d4dd7ce

		annotation PBI_FormatHint = {"isGeneralNumber":true}

