	partition 'GP Table-51634b96-b9cf-40d6-a9b8-f10c60c2656d' = m
		mode: import
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "CCG_Reference", [Query=" select #(lf) Locality as [locality],#(lf) PrimaryCareNetwork as [primary care network],#(lf) OrganisationCode as [practice code],#(lf) OrganisationName as [organisation name]#(lf)#(lf)#(lf) FROM CCG_Reference.Reference.vw_GPPractice#(lf)--Ash advised that I do not need to have the below - it did make the blanks go dow from over 3000 to 600 in the admissions#(lf) --where StatusCode = 'A' and Commissioner = '11M' #(lf) --and Locality in ('Cheltenham', 'Gloucester City', 'North Cotswolds', 'South Cotswolds', 'Stroud and Berkeley Vale', 'Tewkesbury Newent and Staunton', 'The Forest of Dean')#(lf)"])
				in
