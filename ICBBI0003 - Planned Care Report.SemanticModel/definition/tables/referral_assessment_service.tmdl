table referral_assessment_service
	lineageTag: 01c4209f-4c22-4042-b8c6-efa4e394b009

	measure triage_requests = CALCULATE(SUM('referral_assessment_service'[counter]))
		formatString: 0
		lineageTag: 965d5547-516a-49d1-a9b2-df35233e1d33

		annotation Format = <Format Format="NumberWhole" Accuracy="0" />

	measure returned_to_referrer = CALCULATE(COUNT('referral_assessment_service'[UBRN]),FILTER('referral_assessment_service','referral_assessment_service'[Triage_Outcome]="Return To Referrer With Advice"))
		formatString: 0
		lineageTag: f0514f3b-ac0e-4472-b101-9c1e46e9ce97

		annotation Format = <Format Format="NumberWhole" Accuracy="0" />

	measure returned_to_referrer_% = DIVIDE('referral_assessment_service'[returned_to_referrer],[triage_requests])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8f8351b4-e0f0-4336-a5c6-47fde21b7639

		annotation Format = <Format Format="Percentage" Accuracy="2" />

	measure outcome_% = SUM('referral_assessment_service'[counter])/[triage_requests]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a32f73f4-46a9-4f38-b633-51d36412869b

		annotation Format = <Format Format="Percentage" Accuracy="2" />

	measure 'RAS Activity' = (SUM('referral_assessment_service'[counter]))
		formatString: 0
		lineageTag: ebebf8f7-da77-4dd2-bcb8-0ab3e8933a11

		annotation Format = <Format Format="NumberWhole" Accuracy="0" />

	measure 'RAS Activity PM' = CALCULATE([RAS Activity],DATEADD('date_table'[Date],-1,MONTH))
		formatString: 0
		lineageTag: d35b7f28-4e48-45a3-b7a5-42ad73ae9f1d

		annotation Format = <Format Format="NumberWhole" Accuracy="0" />

	measure 'RAS Variance %' = DIVIDE([RAS Activity],[RAS Activity PM],BLANK()) - 1
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e696771d-d9ea-4580-b3a4-d53abda63457

		annotation Format = <Format Format="Percentage" Accuracy="2" />

	measure 'RAS Activity YTD' = CALCULATE([RAS Activity],SAMEPERIODLASTYEAR('date_table'[Date]))
		formatString: 0
		lineageTag: 83383d31-e259-4654-8bf8-bfbc82255e17

		annotation Format = <Format Format="NumberWhole" Accuracy="0" />

	measure 'RAS YTD Variance %' = DIVIDE([RAS Activity],[RAS Activity YTD],BLANK()) - 1
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f8d0e433-7b84-4eef-85eb-2a6c7ecb538a

		annotation Format = <Format Format="Percentage" Accuracy="2" />

	measure 2021_22_total_onward_referrals = CALCULATE(COUNT('referral_assessment_service'[ubrn]),'referral_assessment_service','referral_assessment_service'[triage_outcome] in {"Accept and Refer/Book Later","Refer/Book Now"},referral_assessment_service,referral_assessment_service[booked_service_group] <> BLANK(),'date','date'[financial_year] in {"2021/22"})
		formatString: 0
		lineageTag: 785155a5-150f-43a7-91e6-0e0554969c5d

		annotation Format = <Format Format="NumberWhole" Accuracy="0" />

	measure 2022_23_total_onward_referrals = CALCULATE(COUNT('referral_assessment_service'[ubrn]),'referral_assessment_service','referral_assessment_service'[triage_outcome] in {"Accept and Refer/Book Later","Refer/Book Now"},referral_assessment_service,referral_assessment_service[booked_service_group] <> BLANK(),'date','date'[financial_year] in {"2022/23"})
		formatString: 0
		lineageTag: 93eed453-edc9-40fc-b760-83500df482b3

		annotation Format = <Format Format="NumberWhole" Accuracy="0" />

	measure 2019_20_total_onward_referrals = CALCULATE(COUNT('referral_assessment_service'[ubrn]),'referral_assessment_service','referral_assessment_service'[triage_outcome] in {"Accept and Refer/Book Later","Refer/Book Now"},referral_assessment_service,referral_assessment_service[booked_service_group] <> BLANK(),'date','date'[financial_year] in {"2019/20"})
		formatString: 0
		lineageTag: 17b8f6ac-6568-460a-9a05-6bdf91facf11

		annotation Format = <Format Format="NumberWhole" Accuracy="0" />

	measure 2020_21_total_onward_referrals = CALCULATE(COUNT('referral_assessment_service'[ubrn]),'referral_assessment_service','referral_assessment_service'[triage_outcome] in {"Accept and Refer/Book Later","Refer/Book Now"},referral_assessment_service,referral_assessment_service[booked_service_group] <> BLANK(),'date','date'[financial_year] in {"2020/21"})
		formatString: 0
		lineageTag: 563c5d08-9352-417f-b40d-ae46c13c6d12

		annotation Format = <Format Format="NumberWhole" Accuracy="0" />

	measure 'Count of ubrn total for booked_service_group' =
			
			CALCULATE(
				COUNTA('referral_assessment_service'[ubrn]),
				ALLSELECTED('referral_assessment_service'[booked_service_group])
			)
		formatString: 0
		lineageTag: 096b1ad1-c5a8-4b90-8032-ab9ec2b852dd

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "TotalForSelectedCategory"
				}

		annotation Format = <Format Format="NumberWhole" Accuracy="0" />

