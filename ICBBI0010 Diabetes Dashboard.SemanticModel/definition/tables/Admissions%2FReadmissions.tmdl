	partition Admissions/Readmissions = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Current", [Query="/*========================================================================================#(lf)Temp Table#(lf)========================================================================================*/#(lf)SET ANSI_NULLS ON#(lf)SET QUOTED_IDENTIFIER ON#(lf)set nocount on#(lf)set ansi_warnings off#(lf)#(lf)IF OBJECT_ID('tempdb..#TEMP_R', 'U') IS NOT NULL DROP TABLE #TEMP_R;#(lf)#(lf)Select #(lf)[Provider] = CASE WHEN a.[OrganisationCode_CodeOfProvider] like 'rte%' THEN 'GHT' ELSE 'OOC' END,#(lf)a.[OrganisationName_NameOfProvider] as [Provider Name],#(lf)case when a.[AdmissionMethod_HospitalProviderSpell] like '1%' then 'Elective'  when a.[AdmissionMethod_HospitalProviderSpell] like '2%' then 'Emergency' else 'Other Non - Elective'#(lf)end AS [Adm method], #(lf)case when a.[PatientClassification] ='2' then 'Daycase' else 'Inpatient' end as [Inpatient or Daycase],#(lf)a.[HospitalProviderSpellNumber] as [Hospital Provider Spell Number],#(lf)a.[Derived_Pseudo_NHS] as [NHS Number], --CHANGED FIELD NAME#(lf)a.[TreatmentFunction_Description] as [Treatment Function],#(lf)a.[StartDate_HospitalProviderSpell] as [Admission Date],#(lf)a.[DischargeDate_FromHospitalProviderSpell] as [Discharge Date],#(lf)c.[MonthYearName] as [Month Year],#(lf)c.[YearMonth] as [Month Date],#(lf)c.[FinancialYear] as [Year],#(lf)datediff(day,a.[StartDate_HospitalProviderSpell],a.[DischargeDate_FromHospitalProviderSpell]) as [Spell LOS Days],#(lf)datediff(hour,a.[StartDate_HospitalProviderSpell],a.[DischargeDate_FromHospitalProviderSpell]) as [Spell LOS Hours],#(lf)a.[AgeatCDSActivityDate] as [Age],#(lf)case when a.[AgeatCDSActivityDate] < 18 THEN '0-17' ELSE '18+' END AS [Adult/Child],#(lf)a.Derived_Current_TotalPlusMFF as [Total Income MFF], --CHANGED FIELD NAME#(lf)case when a.DiagnosisPrimary_ICD between 'E10' and 'E14' then 'Diabetes in primary diag' else 'Diabetes related condition' end as [Diagnosis Position],#(lf)case when a.DiagnosisPrimary_ICD like '%E10%' or a.Diagnosis1stSecondary_ICD like '%E10%' then 'Type 1 Diabetes'#(lf)     when a.DiagnosisPrimary_ICD between 'E11' and 'E14'or a.Diagnosis1stSecondary_ICD between 'E11' and 'E14' then 'Type 2 Diabetes'#(lf)     else 'Other' end as [Diabetes Type],#(lf)a.DiagnosisPrimary_ICD as [Primary Diagnosis],#(lf)a.Diagnosis1stSecondary_ICD as [Secondary Diagnosis],#(lf)b.DiagnosisPrimary_ICD,#(lf)b.Diagnosis1stSecondary_ICD,#(lf)b.Diagnosis2ndSecondary_ICD,#(lf)b.Diagnosis3rdSecondary_ICD,#(lf)b.Diagnosis4thSecondary_ICD,#(lf)b.Diagnosis5thSecondary_ICD,#(lf)b.Diagnosis6thSecondary_ICD,#(lf)b.Diagnosis7thSecondary_ICD,#(lf)b.Diagnosis8thSecondary_ICD,#(lf)b.Diagnosis9thSecondary_ICD,#(lf)b.Diagnosis10thSecondary_ICD,#(lf)b.Diagnosis11thSecondary_ICD,#(lf)case when d.[Locality] is NULL then 'Unregistered' else d.[Locality] end as [Locality],#(lf)case when d.[Network] is NULL then 'Unregistered' else d.[Network] end as [Cluster],#(lf)case when d.[OrganisationCode] is NULL then 'Unregistered' else d.[OrganisationCode] end as [Practice Code],#(lf)case when d.[OrganisationName] is NULL then 'Unregistered' else d.[OrganisationName] end as [Practice Name],#(lf)e.[ICD10Description] as [ICD10Code_4Desc],#(lf)1 as [Counter]#(lf)INTO #TEMP_R#(lf)#(lf)#(lf)From [CCG_Current].[SEM].[vw_HospitalProviderSpell] as a#(lf)inner join [CCG_Current].[SEM].[vw_FinishedConsultantEpisode] as b on a.[HospitalProviderSpellNumber] = b.[HospitalProviderSpellNumber] and b.episodenumber in ('1', '01')#(lf)left join [CCG_Reference].[Reference].[vw_DateLookup] as c on c.[Date] = cast(a.DischargeDate_FromHospitalProviderSpell as date)#(lf)left join CCG_Reference.Reference.vw_GPPractice as d ON a.[GPPractice_Derived] = d.[OrganisationCode]#(lf)left join [CCG_Reference].[Reference].[vw_ICD10] as e on LEFT(a.DiagnosisPrimary_ICD,4) = e.[ICD10Code]#(lf)#(lf)#(lf)Where b.[EpisodeNumber] IN ('1', '01')#(lf)and cast(a.[DischargeDate_FromHospitalProviderSpell] as date) >='20180401'#(lf)and a.[Derived_Pseudo_NHS] != '41CE1CCBA451E73DACE6' --CHANGED FIELD NAME#(lf)and a.[OrganisationCode_CodeOfCommissioner] like '%11M%'#(lf)--and a.[OrganisationCode_CodeOfProvider] not like '%RTE%'#(lf)and#(lf) ((a.DiagnosisPrimary_ICD between 'E10' and 'E14')#(lf)--or#(lf)--(b.diagnosis_02 between 'E10' and 'E14') ----- should we count just primary b.diagnosis of diabetes, or secondary also on its own? Over counting if including secondary#(lf)or#(lf)#(lf)((concat(b.DiagnosisPrimary_ICD, b.Diagnosis1stSecondary_ICD, b.Diagnosis2ndSecondary_ICD, b.Diagnosis3rdSecondary_ICD,b.Diagnosis4thSecondary_ICD, b.Diagnosis5thSecondary_ICD, b.Diagnosis6thSecondary_ICD, #(lf)                                         b.Diagnosis7thSecondary_ICD, b.Diagnosis8thSecondary_ICD, b.Diagnosis9thSecondary_ICD, b.Diagnosis10thSecondary_ICD, b.Diagnosis11thSecondary_ICD) like '%E1[0-4]%')#(lf) and#(lf)(a.DiagnosisPrimary_ICD like '%E16[012]%' or a.Diagnosis1stSecondary_ICD like '%E16[012]%' --- Hypoglycaemia#(lf)or a.DiagnosisPrimary_ICD like '%I702%' or a.Diagnosis1stSecondary_ICD like '%I702%' --- Athersclerosis of arteries of extremities#(lf)or a.DiagnosisPrimary_ICD like '%I739%' or a.Diagnosis1stSecondary_ICD like '%I739%' --- Peripheral vascular diseases#(lf)or a.DiagnosisPrimary_ICD like '%I743%' or a.Diagnosis1stSecondary_ICD like '%I743%' --- Embolism and thrombosis of arteries of lower extremities#(lf)or a.DiagnosisPrimary_ICD like '%I77[19]%' or a.Diagnosis1stSecondary_ICD like '%I77[19]%' --- Disorders of arteries and arterioles#(lf)or a.DiagnosisPrimary_ICD like '%I792%' or a.Diagnosis1stSecondary_ICD like '%I792%' --- Peripheral angiopathy#(lf)or a.DiagnosisPrimary_ICD like '%I80[023]%' or a.Diagnosis1stSecondary_ICD like '%I80[023]%' --- Phlebitis and thrombophlebitis of lower extremities#(lf)or a.DiagnosisPrimary_ICD like '%I83[02]%' or a.Diagnosis1stSecondary_ICD like '%I83[02]%' --- Varicose veins of lower extremities#(lf)or a.DiagnosisPrimary_ICD like '%L024%' or a.Diagnosis1stSecondary_ICD like '%L024%' --- Cutaneous abscess, furuncle and carbuncle of limb#(lf)or a.DiagnosisPrimary_ICD like '%L031%' or a.Diagnosis1stSecondary_ICD like '%L031%' --- Cellulitis of other parts of limb#(lf)or a.DiagnosisPrimary_ICD like '%L089%' or a.Diagnosis1stSecondary_ICD like '%L089%' --- Local infection of skin and subcutaneous tissue#(lf)or a.DiagnosisPrimary_ICD like '%L97%' or a.Diagnosis1stSecondary_ICD like '%L97%' --- Ulcer of lower limb#(lf)or a.DiagnosisPrimary_ICD like '%M869%' or a.Diagnosis1stSecondary_ICD like '%M869%' --- Osteomyelitis (infection of bone)#(lf)or a.DiagnosisPrimary_ICD like '%N083%' or a.Diagnosis1stSecondary_ICD like '%N083%' --- Glomerular disorders in diabetes mellitus#(lf)or a.DiagnosisPrimary_ICD like '%R02%' or a.Diagnosis1stSecondary_ICD like '%R02%' --- Gangrene#(lf)or a.DiagnosisPrimary_ICD like '%R739%' or a.Diagnosis1stSecondary_ICD like '%R739%'  --- Hyperglycaemia, unspecified#(lf)or a.DiagnosisPrimary_ICD like '%S81%' or a.Diagnosis1stSecondary_ICD like '%S81%'  --- Open wound of leg#(lf)or a.DiagnosisPrimary_ICD like '%S91[0-7]%' or a.Diagnosis1stSecondary_ICD like '%S91[0-7]%'  --- Open wound of foot/ ankle/ toe#(lf)or a.DiagnosisPrimary_ICD like '%T013%' or a.Diagnosis1stSecondary_ICD like '%T013%'  --- Open wounds involving multiple regions of lower limbs#(lf)or a.DiagnosisPrimary_ICD like '%T87[456]%' or a.Diagnosis1stSecondary_ICD like '%T87[456]%'  --- Infection/Necrosis/Complication of amputation stump#(lf)or a.DiagnosisPrimary_ICD like '%Y835%' or a.Diagnosis1stSecondary_ICD like '%Y835%'  --- Amputation of limb(s)#(lf)or a.DiagnosisPrimary_ICD like '%Z911%' or a.Diagnosis1stSecondary_ICD like '%Z911%'  --- Personal history of noncompliance with medical treatment and regimen#(lf)))#(lf)#(lf)or #(lf)#(lf)((concat(b.DiagnosisPrimary_ICD, b.Diagnosis1stSecondary_ICD, b.Diagnosis2ndSecondary_ICD, b.Diagnosis3rdSecondary_ICD,b.Diagnosis4thSecondary_ICD, b.Diagnosis5thSecondary_ICD, b.Diagnosis6thS