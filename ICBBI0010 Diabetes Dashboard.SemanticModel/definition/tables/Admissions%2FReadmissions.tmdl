table Admissions/Readmissions
	lineageTag: dbd6f946-4a7d-4ac7-a405-fd5128b5e06f

	measure 'Spell LOS Days rolling average' =
			
			IF(
				ISFILTERED('Date Reference'[Date]),
				ERROR("Time intelligence quick measures can only be grouped or filtered by the Power BI-provided date hierarchy or primary date column."),
				VAR __LAST_DATE = ENDOFMONTH('Date Reference'[Date].[Date])
				VAR __DATE_PERIOD =
					DATESBETWEEN(
						'Date Reference'[Date].[Date],
						STARTOFMONTH(DATEADD(__LAST_DATE, -1, MONTH)),
						ENDOFMONTH(DATEADD(__LAST_DATE, 1, MONTH))
					)
				RETURN
					AVERAGEX(
						CALCULATETABLE(
							SUMMARIZE(
								VALUES('Date Reference'),
								'Date Reference'[Date].[Year],
								'Date Reference'[Date].[QuarterNo],
								'Date Reference'[Date].[Quarter],
								'Date Reference'[Date].[MonthNo],
								'Date Reference'[Date].[Month]
							),
							__DATE_PERIOD
						),
						CALCULATE(
							SUM('Admissions/Readmissions'[Spell LOS Days]),
							ALL('Date Reference'[Date].[Day])
						)
					)
			)
		formatString: 0
		lineageTag: a897c693-436f-4ef9-a929-306cb8a10d6d

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "RollingAverage"
				}

		changedProperty = FormatString

