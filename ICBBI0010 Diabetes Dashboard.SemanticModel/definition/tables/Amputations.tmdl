	partition Amputations = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Current", [Query="set nocount on#(lf)set ansi_warnings off#(lf)#(lf)IF OBJECT_ID('tempdb..#temp1') is not null#(lf)BEGIN#(lf)#(tab)drop table #temp1#(lf)END#(lf)#(lf)select#(tab)#(tab)cast(a.[Derived_Pseudo_NHS] as varchar(max)) as NHS_NUMBER#(lf)#(tab)#(tab)#(tab),a.AgeasonAdmission#(lf)            ,a.HospitalProviderSpellNumber#(lf)#(tab)#(tab)#(tab),a.[LocalPatientIdentifier] as [MRN]#(lf)#(tab)#(tab)#(tab),a.[PrimaryProcedure_OPCS]#(lf)#(tab)#(tab)#(tab),a.[Derived_SEM_SpellPDiag]#(lf)#(tab)#(tab)#(tab), a.Diagnosis1stSecondary_ICD#(lf)#(tab)#(tab)#(tab), a.Diagnosis2ndSecondary_ICD#(lf)#(tab)#(tab)#(tab), a.Diagnosis3rdSecondary_ICD#(lf)#(tab)#(tab)#(tab), a.Diagnosis4thSecondary_ICD#(lf)#(tab)#(tab)#(tab), d.EpisodeNumber#(lf)#(tab)#(tab)#(tab), b.[FinancialYear] as [Year_Financial]#(lf)#(tab)#(tab)#(tab), b.[YearMonth] as [Year_Month]#(lf)---------------------- VENOUS ULCER FLAG ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------#(lf)#(tab)#(tab)#(tab), case when concat(a.[Derived_SEM_SpellPDiag], a.Diagnosis2ndSecondary_ICD, a.Diagnosis3rdSecondary_ICD, a.Diagnosis4thSecondary_ICD, a.Diagnosis1stSecondary_ICD, a.Diagnosis6thSecondary_ICD, a.Diagnosis7thSecondary_ICD, a.Diagnosis8thSecondary_ICD) like '%L97%' then 'With Ulcer' else 'Without Ulcer' end as ulcer_flag#(lf)#(tab)#(tab)#(tab), case when concat(a.[Derived_SEM_SpellPDiag], a.Diagnosis2ndSecondary_ICD, a.Diagnosis3rdSecondary_ICD, a.Diagnosis4thSecondary_ICD, a.Diagnosis1stSecondary_ICD, a.Diagnosis6thSecondary_ICD, a.Diagnosis7thSecondary_ICD, a.Diagnosis8thSecondary_ICD) like '%R02%' then 'With Gangrenous Ulcer' else 'Without Gangrenous Ulcer' end gangrenous_ulcer_flag#(lf)#(tab)#(tab)#(tab), case when concat(a.[Derived_SEM_SpellPDiag], a.Diagnosis2ndSecondary_ICD, a.Diagnosis3rdSecondary_ICD, a.Diagnosis4thSecondary_ICD, a.Diagnosis1stSecondary_ICD, a.Diagnosis6thSecondary_ICD, a.Diagnosis7thSecondary_ICD, a.Diagnosis8thSecondary_ICD) like '%I792%' then 'With Peripheral Angiopathy' else 'Without Peripheral Angiopathy' end as peripheral_angiopathy_flag#(lf)#(tab)#(tab)#(tab), case when concat(a.[Derived_SEM_SpellPDiag], a.Diagnosis2ndSecondary_ICD, a.Diagnosis3rdSecondary_ICD, a.Diagnosis4thSecondary_ICD, a.Diagnosis1stSecondary_ICD, a.Diagnosis6thSecondary_ICD, a.Diagnosis7thSecondary_ICD, a.Diagnosis8thSecondary_ICD) like '%I83%' then 'With Venous Ulcer' else 'Without Venous Ulcer' end as venour_ulcer_flag#(lf)--------------------- AMPUTATION FLAG -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------#(lf)#(tab)#(tab)#(tab), case when concat(a.PrimaryProcedure_OPCS, a.Procedure2nd_OPCS, a.Procedure3rd_OPCS, a.Procedure4th_OPCS, a.Procedure5th_OPCS, a.Procedure6th_OPCS, a.Procedure7th_OPCS, a.Procedure8th_OPCS) like '%X09[1234589]%' then 'Amputation of leg'#(lf)#(tab)#(tab)#(tab)#(tab)   when concat(a.PrimaryProcedure_OPCS, a.Procedure2nd_OPCS, a.Procedure3rd_OPCS, a.Procedure4th_OPCS, a.Procedure5th_OPCS, a.Procedure6th_OPCS, a.Procedure7th_OPCS, a.Procedure8th_OPCS) like '%X10[123489]%' then 'Amputation of foot'#(lf)#(tab)#(tab)#(tab)#(tab)   when concat(a.PrimaryProcedure_OPCS, a.Procedure2nd_OPCS, a.Procedure3rd_OPCS, a.Procedure4th_OPCS, a.Procedure5th_OPCS, a.Procedure6th_OPCS, a.Procedure7th_OPCS, a.Procedure8th_OPCS) like '%X11[1289]%' then 'Amputation of toe'#(lf)#(tab)#(tab)#(tab)#(tab)   when concat(a.PrimaryProcedure_OPCS, a.Procedure2nd_OPCS, a.Procedure3rd_OPCS, a.Procedure4th_OPCS, a.Procedure5th_OPCS, a.Procedure6th_OPCS, a.Procedure7th_OPCS, a.Procedure8th_OPCS) like '%X12[1234589]%' or concat(a.PrimaryProcedure_OPCS, a.Procedure2nd_OPCS, a.Procedure3rd_OPCS, a.Procedure4th_OPCS, a.Procedure5th_OPCS, a.Procedure6th_OPCS, a.Procedure7th_OPCS, a.Procedure8th_OPCS) like '%X13[34]%' then 'Operations on amputation stump'#(lf)#(tab)#(tab)#(tab)#(tab)   when concat(a.PrimaryProcedure_OPCS, a.Procedure2nd_OPCS, a.Procedure3rd_OPCS, a.Procedure4th_OPCS, a.Procedure5th_OPCS, a.Procedure6th_OPCS, a.Procedure7th_OPCS, a.Procedure8th_OPCS) like '%S571%' and concat(a.PrimaryProcedure_OPCS, a.Procedure2nd_OPCS, a.Procedure3rd_OPCS, a.Procedure4th_OPCS, a.Procedure5th_OPCS, a.Procedure6th_OPCS, a.Procedure7th_OPCS, a.Procedure8th_OPCS) like '%Z50[4567]%' then 'Debridement of skin'#(lf)#(tab)#(tab)#(tab)#(tab)   when concat(a.PrimaryProcedure_OPCS, a.Procedure2nd_OPCS, a.Procedure3rd_OPCS, a.Procedure4th_OPCS, a.Procedure5th_OPCS, a.Procedure6th_OPCS, a.Procedure7th_OPCS, a.Procedure8th_OPCS) like '%S572%' then 'Removal of slough from skin'#(lf)#(tab)#(tab)#(tab)#(tab)   when concat(a.PrimaryProcedure_OPCS, a.Procedure2nd_OPCS, a.Procedure3rd_OPCS, a.Procedure4th_OPCS, a.Procedure5th_OPCS, a.Procedure6th_OPCS, a.Procedure7th_OPCS, a.Procedure8th_OPCS) like '%W336%' then 'Debridement of bone'#(lf)#(tab)#(tab)#(tab)#(tab)   when concat(a.PrimaryProcedure_OPCS, a.Procedure2nd_OPCS, a.Procedure3rd_OPCS, a.Procedure4th_OPCS, a.Procedure5th_OPCS, a.Procedure6th_OPCS, a.Procedure7th_OPCS, a.Procedure8th_OPCS) like '%Z89[4-7]%' then 'History of Amputation'#(lf)#(tab)#(tab)#(tab)#(tab)   else ' '#(lf)#(tab)#(tab)#(tab)end as amputation_flag#(lf)----------------------- OLD ACTIVE FOOT DISEASE FLAG -----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------#(lf)#(tab)#(tab)#(tab),case when a.[AgeatStartofEpisode] >='18' and a.PatientClassification in ('1','2','5') and (concat(a.[Derived_SEM_SpellPDiag], d.Diagnosis2ndSecondary_ICD, d.Diagnosis3rdSecondary_ICD, d.Diagnosis4thSecondary_ICD, d.Diagnosis1stSecondary_ICD, d.Diagnosis6thSecondary_ICD, d.Diagnosis7thSecondary_ICD, d.Diagnosis8thSecondary_ICD) like '%L97%' --- Ulcer of lower limb#(lf)#(tab)#(tab)#(tab)or concat(a.[Derived_SEM_SpellPDiag], d.Diagnosis2ndSecondary_ICD, d.Diagnosis3rdSecondary_ICD, d.Diagnosis4thSecondary_ICD, d.Diagnosis1stSecondary_ICD, d.Diagnosis6thSecondary_ICD, d.Diagnosis7thSecondary_ICD, d.Diagnosis8thSecondary_ICD) like '%L89%' --- Decubitus ulcer#(lf)#(tab)#(tab)#(tab)or concat(a.[Derived_SEM_SpellPDiag], d.Diagnosis2ndSecondary_ICD, d.Diagnosis3rdSecondary_ICD, d.Diagnosis4thSecondary_ICD, d.Diagnosis1stSecondary_ICD, d.Diagnosis6thSecondary_ICD, d.Diagnosis7thSecondary_ICD, d.Diagnosis8thSecondary_ICD) like '%L03[01]%' --- Cellulitis#(lf)#(tab)#(tab)#(tab)or (concat(a.[Derived_SEM_SpellPDiag], d.Diagnosis2ndSecondary_ICD, d.Diagnosis3rdSecondary_ICD, d.Diagnosis4thSecondary_ICD, d.Diagnosis1stSecondary_ICD, d.Diagnosis6thSecondary_ICD, d.Diagnosis7thSecondary_ICD, d.Diagnosis8thSecondary_ICD) like '%M86%' and  --- Osteomyelitis with other classification#(lf)#(tab)#(tab)#(tab)(concat(a.[Derived_SEM_SpellPDiag], d.Diagnosis2ndSecondary_ICD, d.Diagnosis3rdSecondary_ICD, d.Diagnosis4thSecondary_ICD, d.Diagnosis1stSecondary_ICD, d.Diagnosis6thSecondary_ICD, d.Diagnosis7thSecondary_ICD, d.Diagnosis8thSecondary_ICD) like '%L97%' or#(lf)#(tab)#(tab)#(tab)concat(a.[Derived_SEM_SpellPDiag], d.Diagnosis2ndSecondary_ICD, d.Diagnosis3rdSecondary_ICD, d.Diagnosis4thSecondary_ICD, d.Diagnosis1stSecondary_ICD, d.Diagnosis6thSecondary_ICD, d.Diagnosis7thSecondary_ICD, d.Diagnosis8thSecondary_ICD) like '%L89%' or#(lf)#(tab)#(tab)#(