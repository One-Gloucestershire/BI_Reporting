	column 'Sort Financial Year' = ```
			
			 var _month = month('Date Reference'[Date])
			 var _result = IF(_month > 3, _month-3, _month+9)
			 return
			 _result
			```
		formatString: 0
		lineageTag: 18fd75d6-2c28-43a9-8471-2608fbcd280c
		summarizeBy: sum

