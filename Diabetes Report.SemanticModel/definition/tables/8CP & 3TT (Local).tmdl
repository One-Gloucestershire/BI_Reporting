	partition '8CP & 3TT (Local)' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "PowerBI_Reporting", [Query="select *,#(lf)case#(lf)when #(lf)[HbA1c_NDA] = 1 and #(lf)[Blood Pressure_NDA] = 1 and #(lf)[BMI_NDA] = 1 and #(lf)[Cholesterol_NDA] = 1 and #(lf)[Creatinine_NDA] = 1 and #(lf)[UrineAlb_NDA] = 1 and #(lf)[Foot Examination_NDA] = 1 and #(lf)[Smoking_NDA] = 1 then 1 else 0 end as [8CP_NDA],#(lf)case#(lf)when #(lf)[HbA1c_Rolling] = 1 and #(lf)[Blood Pressure_Rolling] = 1 and #(lf)[BMI_Rolling] = 1 and #(lf)[Cholesterol_Rolling] = 1 and #(lf)[Creatinine_Rolling] = 1 and #(lf)[UrineAlb_Rolling] = 1 and #(lf)[Foot Examination_Rolling] = 1 and #(lf)[Smoking_Rolling] = 1 then 1 else 0 end as [8CP_Rolling],#(lf)1 as [Counter of Patients]#(lf)from [PowerBI_Reporting].[Diabetes].[tbl02_NDA_Local_Data]"])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

