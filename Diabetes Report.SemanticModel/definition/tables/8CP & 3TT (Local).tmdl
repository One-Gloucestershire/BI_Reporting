	measure Arrows_NDA_BMI =
			
			VAR Latest_Value = CALCULATE([NDA_%_BMI],'8CP & 3TT (Local)'[Latest Date] = 1)
			VAR Previous_Value = CALCULATE([NDA_%_BMI],'8CP & 3TT (Local)'[Latest Month Prev Year] = 1)
			
			RETURN
			
			IF(Latest_Value>Previous_Value,UNICHAR(UNICODE("↑")),
			IF(Latest_Value<Previous_Value,UNICHAR(UNICODE("↓")),""))
		lineageTag: 5fbb0efa-5389-4bc3-aefc-902eb3ac51bb

