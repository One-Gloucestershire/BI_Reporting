	partition Population-b5c5c83e-0f3d-44b2-92d8-4774c148a6fb = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Current", [Query="/****** Script for SelectTopNRows command from SSMS  ******/#(lf)#(lf)/*=================================================#(lf)Date Ref#(lf)=================================================*/#(lf)#(lf)IF OBJECT_ID('tempdb..#DateRef1', 'U') IS NOT NULL DROP TABLE #DateRef1;#(lf)#(lf)SELECT [DateKey]#(lf)      ,[Date]#(lf)      ,[DayMonthYear]#(lf)      ,[Day]#(lf)      ,[DaySuffix]#(lf)      ,[Weekday]#(lf)      ,[WeekDayName]#(lf)      ,[DayofWeekInMonth]#(lf)      ,[DayOfYear]#(lf)      ,[WeekOfMonth]#(lf)      ,[WeekOfYear]#(lf)      ,[Month]#(lf)      ,[MonthName]#(lf)      ,[Quarter]#(lf)      ,[QuarterName]#(lf)      ,[Year]#(lf)      ,[MonthYear]#(lf)      ,[MonthYearName]#(lf)      ,[YearMonth]#(lf)      ,[IsWeekend]#(lf)      ,[IsHoliday]#(lf)      ,[FinancialWeekofYear]#(lf)      ,[HolidayName]#(lf)      ,[SpecialDays]#(lf)      ,[FinancialYear]#(lf)      ,[FinancialQuarter]#(lf)      ,[FinancialMonth]#(lf)      ,[FirstDateofYear]#(lf)      ,[LastDateofYear]#(lf)      ,[FirstDateofQuater]#(lf)      ,[LastDateofQuater]#(lf)      ,[FirstDateofMonth]#(lf)      ,[LastDateofMonth]#(lf)      ,[FirstDateofWeek]#(lf)      ,[LastDateofWeek]#(lf)      ,[WeekBand]#(lf)      ,[CurrentYear]#(lf)      ,[CurrentQuater]#(lf)      ,[CurrentMonth]#(lf)      ,[CurrentWeek]#(lf)      ,[CurrentDay]#(lf)#(tab)  ,[ShortMonth] = LEFT([MonthName],3)#(lf)#(tab)  ,[ShortYear] = RIGHT([Year], 2)#(lf)#(tab)  ,[YearMonthName] = CONCAT(LEFT([MonthName],3),RIGHT([Year],2))#(lf)#(tab)  ,[Year-MonthName] = CONCAT(LEFT([MonthName],3),'-',RIGHT([Year],2))#(lf)#(lf)#(tab)  INTO #DateRef1#(lf)#(lf)  FROM [CCG_Reference].[Reference].[vw_DateLookup]#(lf)#(lf)  WHERE [Year] >= '2019'#(lf)#(lf)#(lf)/*=================================================#(lf)Population (max census date)#(lf)=================================================*/#(lf)#(lf)SELECT distinct [OrganisationCode]#(lf)      ,[OrganisationName]#(lf)      ,[PrimaryCareNetwork]#(lf)      ,[Place]#(lf)      ,[Locality]#(lf)      ,[CensusDate]#(lf)      ,[AgeGroupType]#(lf)      ,[Total] = sum([Total])#(lf)#(tab)  ,[YearMonth]#(lf)#(tab)  ,[Year-MonthName]#(lf)#(lf)  FROM [CCG_Reference].[Reference].[vw_GPPracticePopulation][Ref]#(lf)#(lf)  LEFT JOIN [#DateRef1]#(lf)  ON [#DateRef1].[Date] = CAST('01-'+LEFT(CENSUSDATE,3)+'-20'+RIGHT(CENSUSDATE,2)AS DATE)#(lf)#(lf)  WHERE [AgeGroupType] = 'All'#(lf)  AND CAST('01-'+LEFT(CENSUSDATE,3)+'-20'+RIGHT(CENSUSDATE,2)AS DATE) =  (select distinct MAX(CAST('01-'+LEFT(CENSUSDATE,3)+'-20'+RIGHT(CENSUSDATE,2)AS DATE)) FROM CCG_Reference.Reference.vw_GPPracticePopulation)#(lf)#(lf)  GROUP BY   [OrganisationCode]#(lf)      ,[OrganisationName]#(lf)      ,[PrimaryCareNetwork]#(lf)      ,[Place]#(lf)      ,[Locality]#(lf)      ,[CensusDate]#(lf)      ,[AgeGroupType]#(lf)#(tab)  ,[YearMonth]#(lf)#(tab)  ,[Year-MonthName]"])
				in
				    Source

	annotation PBI_ResultType = Table

