	partition General-dd1cae89-87b5-4dfa-8312-c2598fb3bee3 = m
		mode: import
		source =
				let
				    Source = Sql.Database("GRH-CCG-SQL", "BIREPORTS", [Query="SELECT #(lf)[GP].[OrganisationCode],#(lf)[GP].[ReportingOrganisationName],#(lf)[GP].[PrimaryCareNetwork],#(lf)[Practice Website],#(lf)[Total Red Flags],#(lf)[Total Amber Flags ],#(lf)[CQC Overall rating],#(lf)[CQC No. of Requires improvement],#(lf)[CQC Is the overall CQC rating displayed on the practice website?],#(lf)[EDEC 2021  (Published March 2022)],#(lf)[EDEC question 4S],#(lf)[EDEC question 5A],#(lf)[EDEC question 5G],#(lf)[EDEC question 5Z],#(lf)[EDEC question 8Q],#(lf)[2021/22 Data Security and Protection Toolkit Completed (DSPT) ],#(lf)[QOF \n(2021-22 CCG average of 600.54/635 points)],#(lf)[Friends & Family Submissions - Restarted July 2022],#(lf)[2022/23 Number of CES signed up for, not inc Surgery specific or Vasectomy (max 13 (excluded Inter-Practice Minor Surgery)],#(lf)[ES not signed up ],#(lf)[Inter-Practice Minor Surgery sign up],#(lf)[2022/23 DES Signed up for Learning Disability Annual Health Checks & Weight Management],#(lf)[2022/23 DES Signed up for Minor Surgery],#(lf)[% of LD patients with an Annual Health Check between 01/04/21 - 31/03/22 (All ages)],#(lf)[% of SMI patients with an Annual Health Check between 01/04/21 - 31/03/22 (All ages)],#(lf)[Local  soft intelligence (inc high sickness & pat)],#(lf)[Reporting_Period] = CAST(GETDATE()AS date),#(lf)--Flags#(lf)#(lf)[Flag_CQCRating] = CASE WHEN [CQC Overall rating] NOT IN ('OUTSTANDING','GOOD') THEN 1 ELSE 0 END,#(lf)[Flag_CQCDisplay] = CASE WHEN [CQC Is the overall CQC rating displayed on the practice website?] NOT IN ('YES') THEN 1 ELSE 0 END,#(lf)[Flag_EDEC2021] = CASE WHEN [EDEC 2021  (Published March 2022)] NOT IN ('YES') THEN 1 ELSE 0 END,#(lf)[Flag_EDEC4S] = CASE WHEN [EDEC question 4S] NOT IN ('YES') THEN 1 ELSE 0 END,#(lf)[Flag_EDEC5A] = CASE WHEN [EDEC question 5A] NOT IN ('YES') THEN 1 ELSE 0 END,#(lf)[Flag_EDEC5G] = CASE WHEN [EDEC question 5G] NOT IN ('YES') THEN 1 ELSE 0 END,#(lf)[Flag_EDEC5Z] = CASE WHEN [EDEC question 5Z] NOT IN ('YES') THEN 1 ELSE 0 END,#(lf)[Flag_EDEC8Q] = CASE WHEN [EDEC question 8Q] NOT IN ('YES') THEN 1 ELSE 0 END,#(lf)[Flag_DataSec] = CASE WHEN [2021/22 Data Security and Protection Toolkit Completed (DSPT) ] NOT IN ('YES') THEN 1 ELSE 0 END,#(lf)[Flag_QOF] = CASE WHEN [QOF \n(2021-22 CCG average of 600.54/635 points)] < 600.54 THEN 1 ELSE 0 END,#(lf)[Flag_CES] = CASE WHEN [2022/23 Number of CES signed up for, not inc Surgery specific or Vasectomy (max 13 (excluded Inter-Practice Minor Surgery)] < 10 THEN 1 ELSE 0 END,#(lf)[Flag_LDDES] = CASE WHEN [2022/23 DES Signed up for Learning Disability Annual Health Checks & Weight Management] NOT IN ('YES') THEN 1 ELSE 0 END,#(lf)[Flag_MinSurgDES] = CASE WHEN [2022/23 DES Signed up for Minor Surgery] NOT IN ('YES') THEN 1 ELSE 0 END,#(lf)[Flag_LD] = CASE WHEN [% of LD patients with an Annual Health Check between 01/04/21 - 31/03/22 (All ages)] < 0.5 THEN 1 ELSE 0 END,#(lf)[Flag_SMI] = CASE WHEN [% of SMI patients with an Annual Health Check between 01/04/21 - 31/03/22 (All ages)] < 0.5 THEN 1 ELSE 0 END#(lf)FROM [BIReports].[dbo].[GP_Quality_General] [Q]#(lf)#(lf)LEFT JOIN [CCG_Reference].[Reference].[vw_GPPractice] [GP]#(lf)ON [GP].[OrganisationCode] = [Q].[ODS code]"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

