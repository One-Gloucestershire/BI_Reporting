table PracticeLevel
	lineageTag: a4f628ae-9e7a-487a-977b-2e84a6aac241

	measure 'Cost Per Item' = (sum(PracticeLevel[YearlyCost])/sum(PracticeLevel[YearlyItems]))
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: 881632a6-8224-4480-af9d-59df09cc41ad

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Population Adjusted opportunities' = ```
			
			VAR Q3Q4 = SUM(PracticeLevel[Q4Q3Difference])/1000
			VAR ADJUSTED = SUM(Quartiles[Quartile3])
			RETURN 
			Q3Q4*ADJUSTED
			```
		lineageTag: 7b5e4dcc-a16f-4df8-8465-a5ce3a77a024

		annotation PBI_FormatHint = {"isGeneralNumber":true}

