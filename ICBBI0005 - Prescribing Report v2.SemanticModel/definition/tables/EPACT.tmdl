table EPACT
	lineageTag: 6964ae8d-e97c-4626-944d-3f025923e71b

	measure 'Hide Visual' = IF([Check Filtered],1,0)
		lineageTag: 3badea0c-42b2-4d95-8f36-1328f8175fa5

	measure 'Check Filtered' = ISFILTERED(EPACT[BNFChemicalSubstance]) -- Returns True when Any selection is made on the Category slicer
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: b7c15f45-e4b4-4392-94af-67b37e87fb95

	measure 'Min Cost Practice' =
			
			MINX (
			    ADDCOLUMNS (
			        SUMMARIZE (
			            FILTER ( 'EPACT', 'EPACT'[YearMonth] IN VALUES ( 'EPACT'[YearMonth] ) ),
			            'EPACT'[HSPractice]
			        ),
			        "Total Per practice", CALCULATE ( SUM ( 'EPACT'[ActualCost] ) )
			    ),
			    [Total Per practice]
			)
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: 7bc0e624-a980-4ae7-8e2f-b2cc9184cada

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Max Cost Practice' =
			
			MAXX (
			    ADDCOLUMNS (
			        SUMMARIZE (
			            FILTER ( 'EPACT', 'EPACT'[YearMonth] IN VALUES ( 'EPACT'[YearMonth] ) ),
			            'EPACT'[HSPractice]
			        ),
			        "Total Per practice", CALCULATE ( SUM ( 'EPACT'[ActualCost] ) )
			    ),
			    [Total Per practice]
			)
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: e3c67e33-58bf-45f9-91b7-77cfc349abbc

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure CostPerItem = sum(Epact[ActualCost])/sum(Epact[Items])
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: 28be563d-77f6-4d8d-b44a-d524543555c0

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Growth (%)' =
			
			VAR CurrentFYCost = CALCULATE(SUM(EPACT[ActualCost]), FILTER(ALL('EPACT'), AVERAGE('DateReference'[Financial Year]) = MAX('DateReference'[Financial Year])))
			VAR PreviousFYCost = CALCULATE(SUM(EPACT[ActualCost]), FILTER(ALL('EPACT'), AVERAGE('DateReference'[Financial Year]) = MAX('DateReference'[Financial Year]) - 1))
			RETURN
			DIVIDE(CurrentFYCost - PreviousFYCost, PreviousFYCost) * 100
		formatString: 0
		lineageTag: 1f85f594-90e9-4f8c-bb3f-a4562d5911b7

	measure 'Previous Year Cost (Month)' =
			CALCULATE(
			    SUM(EPACT[ActualCost]),
			    FILTER(
			        ALL(EPACT),
			        EPACT[Date] = max(EPACT[PreviousYear]) && EPACT[BNFChapter] in values(EPACT[BNFChapter]) ))
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: fafbb63d-4ef9-47f1-ac4b-660aa365f635

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Previous Year % Change(Month)' = IF(ISBLANK(DIVIDE(SUM(EPACT[ActualCost]), EPACT[Previous Year Cost (Month)], 0)) = TRUE(), BLANK(),  DIVIDE(SUM(EPACT[ActualCost]),  EPACT[Previous Year Cost (Month)], 0) - 1)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8812e577-6d6a-4e7e-9654-e1a31aa237a7

	measure 'Previous Year Cost (Year)' =
			CALCULATE(
			    SUM(EPACT[ActualCost]),
			    FILTER(
			        ALL(EPACT),
			        EPACT[FY] = max(EPACT[FY-1]) && EPACT[BNFChapter] in values(EPACT[BNFChapter]) && EPACT[BNFSection] in values(EPACT[BNFSection]) ))
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: b794c735-975f-4b6f-bde0-c960a6d8c715

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Previous Year % Change(Year)' = IF(ISBLANK(DIVIDE(SUM(EPACT[ActualCost]), EPACT[Previous Year Cost (Year)], 0)) = TRUE(), BLANK(),  DIVIDE(SUM(EPACT[ActualCost]),  EPACT[Previous Year Cost (Year)], 0) - 1)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8b68991e-9968-4b95-a50a-d5fe08f62578

	measure 'Previous Year Variation' = ```
			Sum(EPACT[ActualCost]) - [Previous Year Cost (Year)] 
			```
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: 3cdc588a-1166-4528-b4c1-f059481d38c7

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure PreviousYearRolling = CALCULATE(Sum([ActualCost]),SAMEPERIODLASTYEAR(DateReference[Date]))
		lineageTag: c3a76c71-e3b6-431e-bdf2-da0d5ad9beb2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Previous Year Rolling % Change' = IF(ISBLANK(DIVIDE(SUM(EPACT[ActualCost]), EPACT[PreviousYearRolling], 0)) = TRUE(), BLANK(),  DIVIDE(SUM(EPACT[ActualCost]),  EPACT[PreviousYearRolling], 0) - 1)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4fe25340-721e-45dc-a5e7-71f8f199f49c

	measure 'Last 12 Months V1' = ```
			
			CALCULATE ( 
			      [Previous Year Rolling % Change],
			      DATESINPERIOD ( 'DateReference'[Date],          -- returns period from date column
			                      MAX ( 'DateReference'[Date] ),  -- starting from MAX date
			                      -12,                   -- shifting it back 12 intervals
			                      MONTH                  -- each interval being a month
			      )
			)
			```
		lineageTag: 47cd8375-4f65-4bb4-aba5-a8b18e96fc4f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Previous Year Items (Year)' =
			CALCULATE(
			    SUM(EPACT[Items]),
			    FILTER(
			        ALL(EPACT),
			        EPACT[FY] = max(EPACT[FY-1]) && EPACT[BNFChapter] in values(EPACT[BNFChapter]) && EPACT[BNFSection] in values(EPACT[BNFSection]) ))
		formatString: #,0
		lineageTag: f99d8163-99c5-4bf0-88d5-a8a7e8ebdc2e

	measure 'Previous Year Variation Items' = ```
			Sum(EPACT[Items]) - [Previous Year Items (Year)] 
			```
		formatString: 0
		lineageTag: bfd2cd5d-19a8-41bf-8310-159f5db08d9d

	measure 'Previous Year % Change Items(Year)' = IF(ISBLANK(DIVIDE(SUM(EPACT[Items]), EPACT[Previous Year Items (Year)], 0)) = TRUE(), BLANK(),  DIVIDE(SUM(EPACT[Items]),  EPACT[Previous Year Items (Year)], 0) - 1)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c829819b-746b-4dbe-981a-b7f164b2b1a0

	measure 'Cost Mean' = ```
			
			
			VAR _SUMMARYTABLE = 
			
			SUMMARIZE(
			    ALLSELECTED('DateReference'),
			    'DateReference'[Financial Year],
			    'DateReference'[MonthNameShort],
			    "Mean", SUM('EPACT'[ActualCost])
			)
			
			VAR _AVG =
			
			AVERAGEX(_SUMMARYTABLE, [Mean])
			
			RETURN _AVG
			```
		formatString: "£"#,0.0;-"£"#,0.0;"£"#,0.0
		lineageTag: 37129b7a-2554-40d2-9bb3-a228236bdb85

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Cost Trendline' = ```
			
			
			VAR Temp_Table = 
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED( 'DateReference'[Financial Year], 'DateReference'[Month_Number], 'DateReference'[MonthNameShort], 'DateReference'[FinancialMonth] ),
			            "Value_x", 'DateReference'[Month_Number],
			            "Value_y", 'EPACT'[Cost Total]
			        ),
			        AND (
			            NOT ( ISBLANK ( "Value_x" ) ),
			            NOT ( ISBLANK ( "Value_y" ) )
			        )
			    )
			
			VAR LINESTX_Table = 
			    LINESTX(Temp_Table, [Value_y], [Value_x], TRUE)
			VAR Slope = 
			    MAXX ( LINESTX_Table, [Slope1] )
			VAR Intercept = 
			    MAXX ( LINESTX_Table, [Intercept] )
			
			RETURN
			    IF(SUMX (
			        DISTINCT ( 'DateReference'[Month_Number] ),
			        Intercept + Slope * 'DateReference'[Month_Number]
			    ) < 0, BLANK(), 
			    SUMX (
			        DISTINCT ( 'DateReference'[Month_Number] ),
			        Intercept + Slope * 'DateReference'[Month_Number]
			    )
			    )
			```
		lineageTag: b76fd6fe-b795-4735-a5dc-d7963c201484

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cost Total' = SUM('EPACT'[ActualCost])
		lineageTag: 7a4988ca-df16-48d2-9232-8143881b1e70

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Item Total' = SUM('EPACT'[Items])
		formatString: 0
		lineageTag: 4bd8c612-350e-479d-8e19-d4c3d88a7224

	measure 'Item Mean' = ```
			
			
			VAR _SUMMARYTABLE = 
			
			SUMMARIZE(
			    ALLSELECTED('DateReference'),
			    'DateReference'[Financial Year],
			    'DateReference'[MonthNameShort],
			    "Mean", SUM('EPACT'[Items])
			)
			
			VAR _AVG =
			
			AVERAGEX(_SUMMARYTABLE, [Mean])
			
			RETURN _AVG
			```
		lineageTag: 35a63a0f-77ab-401e-8dc7-470c03c79cf5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Items Trendline' = ```
			
			
			VAR Temp_Table = 
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED( 'DateReference'[Financial Year], 'DateReference'[Month_Number], 'DateReference'[MonthNameShort], 'DateReference'[FinancialMonth] ),
			            "Value_x", 'DateReference'[Month_Number],
			            "Value_y", 'EPACT'[Item Total]
			        ),
			        AND (
			            NOT ( ISBLANK ( "Value_x" ) ),
			            NOT ( ISBLANK ( "Value_y" ) )
			        )
			    )
			
			VAR LINESTX_Table = 
			    LINESTX(Temp_Table, [Value_y], [Value_x], TRUE)
			VAR Slope = 
			    MAXX ( LINESTX_Table, [Slope1] )
			VAR Intercept = 
			    MAXX ( LINESTX_Table, [Intercept] )
			
			RETURN
			    IF(SUMX (
			        DISTINCT ( 'DateReference'[Month_Number] ),
			        Intercept + Slope * 'DateReference'[Month_Number]
			    ) < 0, BLANK(), 
			    SUMX (
			        DISTINCT ( 'DateReference'[Month_Number] ),
			        Intercept + Slope * 'DateReference'[Month_Number]
			    )
			    )
			```
		lineageTag: 86c4b384-92c4-4b41-97f6-636febd7bcfa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Quantity =
			
			
			SUM('EPACT'[QuantityXItems])/SUM('EPACT'[Items])
		lineageTag: 6985ff3b-30fa-43b7-8ba0-78d36c9c5dff

		annotation PBI_FormatHint = {"isGeneralNumber":true}

