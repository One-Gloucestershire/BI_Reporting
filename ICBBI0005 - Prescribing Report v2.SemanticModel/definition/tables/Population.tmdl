onName] LIKE 'Acorn Practice' THEN 'May Lane Surgery' #(lf)#(tab)                             WHEN [OrganisationName] LIKE 'Regent Street Surgery' THEN 'The Willow Tree Practice'#(lf)#(tab)#(tab)#(tab)#(tab)                 WHEN [OrganisationName] LIKE 'Coleford Family Doctors' THEN 'Coleford Medical Practice'#(lf) #(tab)                             ELSE [OrganisationName] END#(lf)      ,[PrimaryCareNetwork]#(lf)      ,[Place]#(lf)      ,[Locality] = CASE WHEN [Locality] LIKE 'North Cotswolds' THEN 'Cotswolds'#(lf)#(tab)                     WHEN [Locality] LIKE 'South Cotswolds' THEN 'Cotswolds'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) ELSE [Locality] END#(lf)      ,[CensusDate]#(lf)      ,[AgeGroupType]#(lf)      ,[Total] = sum([Total])#(lf)#(tab)  ,[YearMonth]#(lf)#(tab)  ,[Year-MonthName]#(lf)#(lf)  FROM [CCG_Reference].[Reference].[vw_GPPracticePopulation][Ref]#(lf)#(lf)  LEFT JOIN [#DateRef1]#(lf)  ON [#DateRef1].[Date] = CAST('01-'+LEFT(CENSUSDATE,3)+'-20'+RIGHT(CENSUSDATE,2)AS DATE)#(lf)#(lf)  WHERE [AgeGroupType] = 'All'#(lf)  AND CAST('01-'+LEFT(CENSUSDATE,3)+'-20'+RIGHT(CENSUSDATE,2)AS DATE) =  (select distinct MAX(CAST('01-'+LEFT(CENSUSDATE,3)+'-20'+RIGHT(CENSUSDATE,2)AS DATE)) FROM CCG_Reference.Reference.vw_GPPracticePopulation)#(lf)#(lf)  GROUP BY   [OrganisationCode]#(lf)      ,[OrganisationName]#(lf)      ,[PrimaryCareNetwork]#(lf)      ,[Place]#(lf)      ,[Locality]#(lf)      ,[CensusDate]#(lf)      ,[AgeGroupType]#(lf)#(tab)  ,[YearMonth]#(lf)#(tab)  ,[Year-MonthName]"]),
