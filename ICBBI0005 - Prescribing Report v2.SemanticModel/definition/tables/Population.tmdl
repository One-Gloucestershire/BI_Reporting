	measure 'Rate per 1,000 Costs' =
			
			(DIVIDE(SUM('EPACT'[ActualCost]), SUM('Population'[Total])))*1000
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: 2aa6bf24-db1c-4807-acbc-a461d25eb029

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'YTD Costs Growth' =
			
			
			VAR _LATESTDATE = CALCULATE(
			    STARTOFMONTH('DateReference'[Date]),
			    FILTER(
			        ALL('DateReference'),
			        'DateReference'[Date] = MAX('DateReference'[Date])
			    )
			)
			
			VAR _PREVIOUSDATE = EDATE(
			    CALCULATE(
			    STARTOFMONTH('DateReference'[Date]),
			    FILTER(
			        ALL('DateReference'),
			        'DateReference'[Date] = MAX('DateReference'[Date])
			    )
			)
			,-12)
			
			RETURN
			
			(CALCULATE(SUM('EPACT'[ActualCost]), 'DateReference'[Date] = _LATESTDATE) - CALCULATE(SUM('EPACT'[ActualCost]), 'DateReference'[Date] = _PREVIOUSDATE))/CALCULATE(SUM('EPACT'[ActualCost]), 'DateReference'[Date] = _PREVIOUSDATE)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ca7ac6c1-4e1e-4cda-9e2f-bbb4d1e6af7a

	measure 'Latest Date' =
			
			
			MAX('DateReference'[Date])
		formatString: General Date
		lineageTag: d0bb0b92-fe14-43b7-9730-a5d8fb119792

	measure 'Latest Date (Last Year)' =
			
			
			EDATE(
			    CALCULATE(MAX('DateReference'[Date])),
			    -12
			)
		formatString: General Date
		lineageTag: b1e10d44-ebf8-466d-989e-4103be8538cf

	measure 'YTD Items Growth' =
			
			
			VAR _LATESTDATE = CALCULATE(
			    STARTOFMONTH('DateReference'[Date]),
			    FILTER(
			        ALL('DateReference'),
			        'DateReference'[Date] = MAX('DateReference'[Date])
			    )
			)
			
			VAR _PREVIOUSDATE = EDATE(
			    CALCULATE(
			    STARTOFMONTH('DateReference'[Date]),
			    FILTER(
			        ALL('DateReference'),
			        'DateReference'[Date] = MAX('DateReference'[Date])
			    )
			)
			,-12)
			
			RETURN
			
			(CALCULATE(SUM('EPACT'[Items]), 'DateReference'[Date] = _LATESTDATE) - CALCULATE(SUM('EPACT'[Items]), 'DateReference'[Date] = _PREVIOUSDATE))/CALCULATE(SUM('EPACT'[Items]), 'DateReference'[Date] = _PREVIOUSDATE)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 1fb92146-73a8-4e29-b218-26de276fecda

	measure '% Apixaban Growth' =
			
			
			VAR _BASELINE = (CALCULATE(SUM('EPACT'[Items]), 'EPACT'[BNFChemicalSubstance] = "Apixaban", 'DateReference'[YearMonth] IN {"202401", "202402", "202403"}, ALL('DateReference'))/3)
			
			VAR _LATESTDATE = CALCULATE(
			    STARTOFMONTH('DateReference'[Date]),
			    FILTER(
			        ALL('DateReference'),
			        'DateReference'[Date] = MAX('DateReference'[Date])
			    )
			)
			
			RETURN
			IF(MAX('DateReference'[YearMonth]) >= "202404",
			(
			    (CALCULATE(SUM('EPACT'[Items]), 'EPACT'[BNFChemicalSubstance] = "Apixaban", 'DateReference'[Date] = _LATESTDATE) - _BASELINE)/_BASELINE), BLANK()
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 1941c5a0-5e40-4edd-9f81-d6f947fc9a1b

	measure '% Sitagliptin Growth' =
			
			
			VAR _BASELINE = (CALCULATE(SUM('EPACT'[Items]), 'EPACT'[BNFChemicalSubstance] = "Sitagliptin", 'DateReference'[YearMonth] IN {"202401", "202402", "202403"}, ALL('DateReference'))/3)
			
			VAR _LATESTDATE = CALCULATE(
			    STARTOFMONTH('DateReference'[Date]),
			    FILTER(
			        ALL('DateReference'),
			        'DateReference'[Date] = MAX('DateReference'[Date])
			    )
			)
			
			RETURN
			IF(MAX('DateReference'[YearMonth]) >= "202404",
			(
			    (CALCULATE(SUM('EPACT'[Items]), 'EPACT'[BNFChemicalSubstance] = "Sitagliptin", 'DateReference'[Date] = _LATESTDATE) - _BASELINE)/_BASELINE), BLANK()
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 5a5c2979-4fd8-4582-b47b-70bb6f6ec4b6

	measure '% Melatonin Ceyesto Liquid' =
			
			
			VAR _MELA = CALCULATE(SUM('EPACT'[Items]), 'EPACT'[BNFChemicalSubstance] = "Melatonin", 'EPACT'[PackSizeUnit] = "ml")
			VAR _CEYE = CALCULATE(SUM('EPACT'[Items]), 'EPACT'[BNFProduct] = "Ceyesto", 'EPACT'[PackSizeUnit] = "ml")
			
			RETURN
			
			_CEYE/_MELA
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 72a1f059-a976-4f20-82d5-b402106d5cd2

	measure '% Colecalciferol Valupak Brand' =
			
			
			VAR _COLA = CALCULATE(SUM('EPACT'[Items]), 'EPACT'[BNFChemicalSubstance] = "Colecalciferol")
			VAR _VALU = CALCULATE(SUM('EPACT'[Items]), 'EPACT'[BNFProduct] IN {"Valupak Vit D3", "Valupak Vitamin D3"})
			
			RETURN
			
			_VALU/_COLA
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 13e5534c-4be0-4795-ab2d-ceb9b7d1f84c

	measure 'Rate per 1,000 Costs - Mean' = ```
			
			
			VAR _SUMMARYTABLE = 
			
			SUMMARIZE(
			    ALLSELECTED('DateReference'),
			    'DateReference'[MonthNameShort],
			    'DateReference'[Financial Year],
			    "Mean", CALCULATE([Rate per 1,000 Costs], 'DateReference'[SPC_Period] = 1)
			)
			
			VAR _AVG = 
			
			AVERAGEX(_SUMMARYTABLE, [Mean])
			
			RETURN
			
			_AVG
			```
		lineageTag: 3de99035-8e4f-4ba9-bb8e-e94025338e06

