	measure 'Fostair MDI to Fobumix' =
			
			
			VAR _BASELINE_FOST = (CALCULATE(SUM('EPACT'[Items]), 'EPACT'[BNFProduct] = "Fostair", 'DateReference'[YearMonth] IN {"202401", "202402", "202403"}, ALL('DateReference'))/3)
			
			VAR _BASELINETARGET_FOST = _BASELINE_FOST * 0.25 -- Defining a 25% reduction baseline from Q4 2023/24
			
			VAR _BASELINE_FOB = (CALCULATE(SUM('EPACT'[Items]), 'EPACT'[BNFProduct] = "Fobumix", 'DateReference'[YearMonth] IN {"202401", "202402", "202403"}, ALL('DateReference'))/3)
			
			VAR _LATESTFOB = CALCULATE(SUM('EPACT'[Items]), 'EPACT'[BNFProduct] = "Fobumix")
			
			VAR _LATESTDATE = CALCULATE(
			    STARTOFMONTH('DateReference'[Date]),
			    FILTER(
			        ALL('DateReference'),
			        'DateReference'[Date] = MAX('DateReference'[Date])
			    )
			)
			
			RETURN
			IF(MAX('DateReference'[YearMonth]) >= "202404",
			(_LATESTFOB - _BASELINE_FOB)/_BASELINETARGET_FOST
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: cb3263c6-6079-4d59-9e78-d621e8cac604

	measure '% Amoxicillin 15 Capsules' =
			
			
			VAR _CAP15 = CALCULATE(SUM('EPACT'[Items]), 'EPACT'[BNFProduct] = "Amoxicillin", 'EPACT'[PayPackSizeUnit] = "capsule", 'EPACT'[PackSize] = 15)
			VAR _CAPALL = CALCULATE(SUM('EPACT'[Items]), 'EPACT'[BNFProduct] = "Amoxicillin", 'EPACT'[PayPackSizeUnit] = "capsule")
			
			RETURN
			
			_CAP15/_CAPALL
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ac5bbe89-3228-42ac-8294-9e361aacb434

