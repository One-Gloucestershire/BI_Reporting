	measure 'Metrics Parameter Outlier' = ```
			
			
			VAR _SELECTION = 
			
			MAX('Metrics Parameter'[Metrics Parameter])
			
			VAR _IF = 
			
			IF(CONTAINSSTRING(_SELECTION, "Rate per 1,000 Costs"), [Rate per 1,000 Costs],
			IF(CONTAINSSTRING(_SELECTION, "YTD Costs Growth"), [YTD Costs Growth],
			IF(CONTAINSSTRING(_SELECTION, "YTD Items Growth"), [YTD Items Growth],
			IF(CONTAINSSTRING(_SELECTION, "% Apixaban Growth"), [% Apixaban Growth],
			IF(CONTAINSSTRING(_SELECTION, "% Sitagliptin Growth"), BLANK(),
			IF(CONTAINSSTRING(_SELECTION, "% Colecalciferol Valupak Brand"), [% Colecalciferol Valupak Brand],
			IF(CONTAINSSTRING(_SELECTION, "% Melatonin Ceyesto Liquid"), BLANK(),
			IF(CONTAINSSTRING(_SELECTION, "% Switched to Fobumix"), BLANK(),
			IF(CONTAINSSTRING(_SELECTION, "% Amoxicillin 15 Capsules"), [% Amoxicillin 15 Capsules],
			BLANK()
			)))))))))
			
			RETURN
			
			IF(OR(_IF > [Metrics Parameter UCL], _IF < [Metrics Parameter LCL]), _IF, BLANK())
			```
