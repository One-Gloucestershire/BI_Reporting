		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "ccg_current", [Query="set nocount on set ansi_nulls on #(lf)set dateformat dmy#(lf)#(lf)DECLARE @report_month DATE, @referral_end DATE, @referral_start DATE#(lf)SET @referral_end = dateadd(month,-7,getdate()) -- report_month minus 6 months#(lf)SET @referral_start = '20210401'#(lf)#(lf)-------------------#(lf)---ED Admission---#(lf)-------------------#(lf)SELECT #(lf)#(tab) [Activity_Type] = 'ED Admission' #(lf)#(tab),[Count] = 1#(lf)#(tab),[Month] = datediff(MONTH,[H].[Referral_Date],[arrival_date]) #(lf)#(tab),[E].[NHS_Number]#(lf)#(tab),[H].[Provider]#(lf)#(lf)FROM [CCG_Current].[GHFT].[vw_EDAttendance] [a]#(lf)#(lf)#(tab)LEFT JOIN [PowerBI_Reporting].[dbo].[ECDS_ED_Attendances] [E] ON [E].[CDS_Unique_Identifier] = [a].[cds_unique_identifier]#(lf)#(lf)#(tab)INNER JOIN [CCG_Current].[Hospices].[vw_HospiceAtHome_Monthly] [H]#(lf)#(tab)ON [E].[NHS_Number] = [H].[NHS_Number]#(lf)#(lf)#(tab)LEFT JOIN [CCG_Reference].[Population].[vw_PDS_Deaths][M]#(lf)#(tab)ON [H].[NHS_Number] = [M].[Derived_NHS_Number]#(lf)#(lf)WHERE #(lf)#(lf)#(tab)[E].[admitted_flag] like 'Admitted'  #(lf)#(tab)AND datediff(MONTH,[H].[Referral_Date],[arrival_date]) between -12 and 12#(lf)#(tab)AND [H].[Referral_Date] between @referral_start and @referral_end#(lf)#(tab)AND ([M].[DateOfDeath] is null or [M].[DateOfDeath] > DATEADD(MONTH,6,[H].[Referral_Date]))#(lf)#(tab)AND ([H].[NHS_Number] is not null and [H].[NHS_Number] <> ' ')#(lf)#(lf)GROUP BY #(lf)#(tab) [E].[NHS_Number] #(lf)#(tab),datediff(MONTH,[H].[Referral_Date],[arrival_date])#(lf)#(tab),[H].[Provider]#(lf)#(lf)UNION ALL#(lf)-------------------#(lf)---ED Attendance---#(lf)-------------------#(lf)SELECT #(lf)#(tab) [Activity_Type] = 'ED Attendance'           #(lf)#(tab),[Count] = 1#(lf)#(tab),[Month] = datediff(MONTH,[H].[Referral_Date],[arrival_date]) #(lf)#(tab),[E].[NHS_Number]#(lf)#(tab),[H].[Provider]#(lf)#(lf)FROM [CCG_Current].[GHFT].[vw_EDAttendance] [a]#(lf)#(lf)#(tab)LEFT JOIN [PowerBI_Reporting].[dbo].[ECDS_ED_Attendances] [E] ON [E].[CDS_Unique_Identifier] = [a].[cds_unique_identifier]#(lf)#(lf)#(tab)INNER JOIN [CCG_Current].[Hospices].[vw_HospiceAtHome_Monthly] [H]#(lf)#(tab)ON [E].[NHS_Number] = [H].[NHS_Number]#(lf)#(lf)#(tab)LEFT JOIN [CCG_Reference].[Population].[vw_PDS_Deaths][M]#(lf)#(tab)ON [H].[NHS_Number] = [M].[Derived_NHS_Number]#(lf)#(lf)WHERE #(lf)#(tab)[E].[admitted_flag] like 'Dischaged (not admitted)'#(lf)#(tab)and datediff(MONTH,[H].[Referral_Date],[arrival_date]) between -12 and 12#(lf)#(tab)AND [H].[Referral_Date] between @referral_start and @referral_end#(lf)#(tab)AND ([M].[DateOfDeath] is null or [M].[DateOfDeath] > DATEADD(MONTH,6,[H].[Referral_Date]))#(lf)#(tab)AND ([H].[NHS_Number] is not null and [H].[NHS_Number] <> ' ')#(lf)#(lf)GROUP BY #(lf)#(tab) [E].[nhs_number]#(lf)#(tab),datediff(MONTH,[H].[Referral_Date],[arrival_date])#(lf)#(tab),[H].[Provider]#(lf)#(lf)UNION ALL#(lf)-------------------#(lf)---GP Contact---#(lf)-------------------#(lf)SELECT #(lf)#(tab) [Activity_Type] = 'GP Contact'          #(lf)#(tab),[Count] = 1#(lf)#(tab),[Month] = datediff(MONTH,[H].[Referral_Date],[AppointmentDate]) #(lf)#(tab),[PseudoNHSNo]#(lf)#(tab),[H].[Provider]#(lf)#(lf)FROM [CCG_Current].[PrimaryCare].[vw_Appointments] [A]#(lf)#(lf)#(tab)INNER JOIN [CCG_Current].[Hospices].[vw_HospiceAtHome_Monthly] [H]#(lf)#(tab)ON [a].[PseudoNHSNo] = [H].[NHS_Number]#(lf)#(lf)#(tab)LEFT JOIN [CCG_Reference].[Population].[vw_PDS_Deaths][M]#(lf)#(tab)ON [H].[NHS_Number] = [M].[Derived_NHS_Number]#(lf)#(lf)WHERE#(lf)#(tab)[AppointmentStatus] in ('Left','Telephone - Complete','Visited')#(lf)#(tab)and datediff(MONTH,[H].[Referral_Date],AppointmentDate) between -12 and 12#(lf)#(tab)AND [H].[Referral_Date] between @referral_start and @referral_end#(lf)#(tab)AND ([M].[DateOfDeath] is null or [M].[DateOfDeath] > DATEADD(MONTH,6,[H].[Referral_Date]))#(lf)#(tab)AND ([NHS_Number] is not null and [NHS_Number] <> ' ')#(lf)#(lf)GROUP BY #(lf)#(tab) [PseudoNHSNo]#(lf)#(tab),datediff(MONTH,[H].[Referral_Date],[AppointmentDate])#(lf)#(tab),[H].[Provider]#(lf)#(lf)UNION ALL#(lf)#(lf)---------------------#(lf)-----MIU---#(lf)---------------------#(lf)#(lf)SELECT #(lf)#(tab) [Activity_Type] = 'MIIU'        #(lf)#(tab),[Count] = 1#(lf)#(tab),[Month] = datediff(MONTH,[H].[Referral_Date],[arrival_date]) #(lf)#(tab),[E].[nhs_number]#(lf)#(tab),[H].[Provider]#(lf)#(lf)FROM [PowerBI_Reporting].[dbo].[ECDS_ED_Attendances] [E]#(lf)#(lf)#(tab)INNER JOIN [CCG_Current].[Hospices].[vw_HospiceAtHome_Monthly] [H]#(lf)#(tab)ON [E].[NHS_Number] = [H].[NHS_Number]#(lf)#(lf)#(tab)LEFT JOIN [CCG_Reference].[Population].[vw_PDS_Deaths][M]#(lf)#(tab)ON [H].[NHS_Number] = [M].[Derived_NHS_Number]#(lf)#(lf)WHERE #(lf)#(tab)datediff(MONTH,[H].[Referral_Date] ,[arrival_date]) between -12 and 12#(lf)#(tab)AND [E].[department_type] like 'Minor Injury Unit'#(lf)#(tab)AND [H].[Referral_Date] between @referral_start and @referral_end#(lf)#(tab)AND ([M].[DateOfDeath] is null or [M].[DateOfDeath] > DATEADD(MONTH,6,[H].[Referral_Date]))#(lf)#(tab)AND ([H].[NHS_Number] is not null and [H].[NHS_Number] <> ' ')#(lf)#(lf)GROUP BY #(lf)#(tab) [E].[NHS_Number]#(lf)#(tab),datediff(MONTH,[H].[Referral_Date],[arrival_date])#(lf)#(tab),[H].[Provider]#(lf)#(lf)UNION ALL#(lf)#(lf)-------------------#(lf)---Rapid Response---#(lf)-------------------#(lf)SELECT #(lf) #(tab) [Activity_Type] = 'Rapid Response'     #(lf)#(tab),[Count] = 1 #(lf)#(tab),[Month] = datediff(MONTH,[H].[Referral_Date],[Eventdate]) #(lf)#(tab),[A].[NHSNumber]#(lf)#(tab),[H].[Provider]#(lf)#(lf)FROM [CCG_Current].[GCS].[vw_All_EventData] [A]#(lf)#(lf)#(tab)INNER JOIN [CCG_Current].[Hospices].[vw_HospiceAtHome_Monthly] [H]#(lf)#(tab)ON [a].[NHSNumber] = [H].[NHS_Number]#(lf)#(lf)#(tab)LEFT JOIN [CCG_Reference].[Population].[vw_PDS_Deaths][M]#(lf)#(tab)ON [H].[NHS_Number] = [M].[Derived_NHS_Number]#(lf)#(lf)WHERE #(lf)#(tab)datediff(MONTH,[H].[Referral_Date],[EventDate]) between -12 and 12#(lf)#(tab)and [ServiceCode] = 'RPDR'#(lf)#(tab)and [ServiceOffered] not like '%ncov%'#(lf)#(tab)AND [H].[Referral_Date] between @referral_start and @referral_end#(lf)#(tab)AND ([M].[DateOfDeath] is null or [M].[DateOfDeath] > DATEADD(MONTH,6,[H].[Referral_Date]))#(lf)#(tab)AND ([NHS_Number] is not null and [NHS_Number] <> ' ')#(lf)#(lf)GROUP BY #(lf)#(tab) [A].[NHSNumber]#(lf)#(tab),datediff(MONTH,[H].[Referral_Date],[EventDate])#(lf)#(tab),[H].[Provider]#(lf)#(lf)#(tab)UNION ALL#(lf)#(lf)-------------------#(lf)---Emergency Admission---#(lf)-------------------#(lf)SELECT #(lf)#(tab) [Activity_Type] = 'Emergency Admission' #(lf)#(tab),[Count] = 1#(lf)#(tab),[Month] = datediff(MONTH,[H].[Referral_Date],[StartDate_HospitalProviderSpell]) #(lf)#(tab),[Derived_Pseudo_NHS]#(lf)#(tab),[H].[Provider]#(lf)#(lf)FROM [CCG_Current].[SEM].[vw_HOSPITALPROVIDERSPELL] [a]#(lf)#(lf)#(tab)INNER JOIN [CCG_Current].[Hospices].[vw_HospiceAtHome_Monthly] [H]#(lf)#(tab)ON [a].[Derived_Pseudo_NHS] = [H].[NHS_Number]#(lf)#(lf)#(tab)LEFT JOIN [CCG_Reference].[Population].[vw_PDS_Deaths][M]#(lf)#(tab)ON [H].[NHS_Number] = [M].[Derived_NHS_Number]#(lf)#(lf)WHERE #(lf)#(tab)[AdmissionMethod_HospitalProviderSpell] like '2%'#(lf)#(tab)AND datediff(MONTH,[H].[Referral_Date],[StartDate_HospitalProviderSpell]) between -12 and 12#(lf)#(tab)AND [H].[Referral_Date] between @referral_start and @referral_end#(lf)#(tab)AND ([M].[DateOfDeath] is null or [M].[DateOfDeath] > DATEADD(MONTH,6,[H].[Referral_Date]))#(lf)#(tab)AND OrganisationCode_Codeofcommissioner like '11m%'#(lf)#(tab)AND StartDate_HospitalProviderSpell is not null#(lf)#(tab)AND ([NHS_Number] is not null and [NHS_Number] <> ' ')#(lf)#(lf)GROUP BY #(lf)#(tab) [Derived_Pseudo_NHS] #(lf)#(tab),datediff(MONTH,[H].[Referral_Date],[StartDate_HospitalProviderSpell])#(lf)#(tab),[H].[Provider]"])
				in
