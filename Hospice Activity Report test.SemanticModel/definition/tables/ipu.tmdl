	partition ipu-92c9a409-2716-492c-bd8b-99a3f2cdaf86 = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "ccg_current", [Query="/****** Script for SelectTopNRows command from SSMS  ******/#(lf)SELECT [Provider]#(lf)      ,[Local_Patient_Identifier]#(lf)      ,[NHS_Number]#(lf)      ,[Referral_Date] = CAST([Referral_Date] AS date)#(lf)#(tab)  ,[Referral_Date_YearMonth] = [D].[YearMonth]#(lf)#(tab)  ,[Referral_Date_FinancialYear] = [D].[FinancialYear]#(lf)      ,[Admission_Date] = CASE WHEN [Admission_Date] < '2019-01-01' THEN NULL ELSE CAST([Admission_Date] AS date) END#(lf)#(tab)  ,[Admission_Flag] = CASE WHEN [Admission_Date] < '2019-01-01' THEN NULL ELSE 1 END#(lf)      ,[Discharge_Date] = CASE WHEN [Discharge_Date] < '2019-01-01' THEN NULL ELSE CAST([Discharge_Date] AS date) END#(lf)      ,[Source_of_Referral] = CASE WHEN [Source_of_Referral] = 'General Medical Practitioner' THEN 'GP'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [Source_of_Referral] = 'General Medical Practicioner' THEN 'GP'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ELSE [Source_of_Referral] END#(lf)      ,[Referral_Accepted]#(lf)      ,[Reason_for_not_accepting]#(lf)      ,[GP_Practice]#(lf)#(tab)  ,[practice] = case when [GP_Practice] <> ' ' then LEFT([GP_Practice],CHARINDEX('-',[GP_Practice])-1) else null end#(lf)#(tab)  ,[practice_code] = case when [GP_Practice] <> ' ' then RIGHT([GP_Practice],CHARINDEX('-',(REVERSE([GP_Practice])))-2) else null end#(lf)      ,[Age_at_referral]#(lf)#(tab)  ,[Age band] = CASE WHEN CAST([Age_at_referral] AS int) between '1' and '39' THEN '<40'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN CAST([Age_at_referral] AS int) between '40' and '49' THEN '40-49'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN CAST([Age_at_referral] AS int) between '50' and '59' THEN '50-59'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN CAST([Age_at_referral] AS int) between '60' and '69' THEN '60-69'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN CAST([Age_at_referral] AS int) between '70' and '79' THEN '70-79'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN CAST([Age_at_referral] AS int) between '80' and '89' THEN '80-89'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN CAST([Age_at_referral] AS int) between '90' and '99' THEN '90-99'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN CAST([Age_at_referral] AS int) between '100' and '150' THEN '100+' #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) ELSE 'Unknown' END#(lf)      ,[Ethnicity]#(lf)      ,[Gender]#(lf)      ,[Religious/personal_belief]#(lf)      ,[Primary_diagnosis]#(lf)      ,[Died_in_hospice?]#(lf)      ,[Death_in_preferred_place_of_care?]#(lf)      ,[Discharge_location]#(lf)#(tab)  ,[M].[DateOfDeath]#(lf)#(tab)  ,[date_of_death_flag] = case when [M].[DateOfDeath] is not null then 1 else null end#(lf)#(tab)  --,[M].[DerivedPlaceOfDeathDesc]#(lf)#(tab)  ,[LOS] = CASE WHEN [Admission_Date] is not null and [Discharge_Date] is not null and [Discharge_Date] > [Admission_Date] THEN DATEDIFF(day,[Admission_Date],[Discharge_Date])#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [Admission_Date] is not null and [Discharge_Date] is null and [DateOfDeath] > [Admission_Date] THEN DATEDIFF(day,[Admission_Date],[DateOfDeath])#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [Admission_Date] is not null and [Discharge_Date] is null and [DateOfDeath] is null THEN null#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)ELSE null END#(lf)#(tab)  ,[Episode_Complete] = CASE WHEN [Discharge_Date] is not null THEN 1#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [DateOfDeath] is not null THEN 1#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)ELSE 0 END#(lf)#(lf)  FROM [CCG_Current].[Hospices].[vw_InPatientUnit_Monthly] [H]#(lf)#(lf)    LEFT JOIN [CCG_Reference].[Reference].[vw_DateLookup][D]#(lf)  ON [H].[Referral_Date] = [D].[Date]#(lf)#(lf)  LEFT JOIN [CCG_Reference].[Population].[vw_PDS_Deaths][M]#(lf)#(tab)ON [H].[NHS_Number] = [M].[Derived_NHS_Number]#(lf)#(lf)#(tab)--WHERE [Referral_Date] between '2021-04-01' and '2022-05-31'#(lf)#(tab)--and ([DateOfDeath] is null or [DateOfDeath] < DATEADD(Month,6,[H].[Referral_Date]))"])
				in
				    Source

	annotation PBI_ResultType = Table

