	partition pat_care_services-1c01d9af-bb96-4f0b-997d-d033748de572 = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "ccg_current", [Query="SELECT DISTINCT#(lf)#(tab)   [provider]#(lf)      ,[local_patient_identifier]#(lf)      ,[nhs_number]#(lf)      ,[referral_date] = CAST([Referral_Date] AS date)#(lf)#(tab)  ,[referral_date_yearmonth] = [D].[YearMonth]#(lf)#(tab)  ,[referral_date_financialyear] = [D].[FinancialYear]#(lf)      ,[registration_date] = CASE WHEN [Registration_Date] < '2019-01-01' THEN NULL ELSE CAST([Registration_Date] AS date) END#(lf)      ,[discharge_date] = CASE WHEN [Discharge_Date] < '2019-01-01' THEN NULL ELSE CAST([Discharge_Date] AS date) END#(lf)      ,[source_of_referral] = CASE WHEN [Source_of_Referral] = 'General Medical Practitioner' THEN 'GP'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [Source_of_Referral] = 'General Medical Practicioner' THEN 'GP'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ELSE [Source_of_Referral] END#(lf)      ,[referral_accepted]#(lf)      ,[reason_for_not_accepting] = CASE WHEN [Reason_for_not_accepting] = ' ' THEN NULL#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN [Reason_for_not_accepting] = 'N/A' THEN NULL#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) ELSE [Reason_for_not_accepting] END#(lf)      ,[gp_practice]#(lf),[practice] = case when ([GP_Practice] <> ' ' and [GP_Practice] <> '0') then LEFT([GP_Practice],CHARINDEX('-',[GP_Practice])-1) else null end#(lf)#(tab)  ,[practice_code] = case when ([GP_Practice] <> ' ' and [GP_Practice] <> '0') then RIGHT([GP_Practice],CHARINDEX('-',(REVERSE([GP_Practice])))-2) else null end#(lf)      ,[age_at_referral]#(lf)#(tab)  ,[age_band] = CASE WHEN [Age_at_referral] between '0' and '39' THEN '<40'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN [Age_at_referral] between '40' and '49' THEN '40-49'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN [Age_at_referral] between '50' and '59' THEN '50-59'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN [Age_at_referral] between '60' and '69' THEN '60-69'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN [Age_at_referral] between '70' and '79' THEN '70-79'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN [Age_at_referral] between '80' and '89' THEN '80-89'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN [Age_at_referral] between '90' and '99' THEN '90-99'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN [Age_at_referral] >= '100' THEN '100+' #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) ELSE 'Unknown' END#(lf)      ,[ethnicity]#(lf)      ,[gender] = case when [gender] = ' ' then 'Unknown' else [gender] end#(lf)      ,[religious/personal_belief]#(lf)      ,[support_provided_to] = case when [support_provided_to] = 'Relative' then 'Family/Relative' else [support_provided_to] end#(lf)      ,[type_of_support_provided] = case when [Type_of_support_provided] in ('Complementary therapy','Family & Carers Support','Therapy (including physiotherapy and occupational therapy)',#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) 'Spiritual and psychological support','Exercise (to support breathlessness, fatigue and falls prevention)',#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) 'Social support','Bereavement support','Wellbeing','Clinical Support','Triage/Assessment','Other') then [Type_of_support_provided]#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) else 'Other' end#(lf)#(lf)      ,[location_of_course]#(lf)      ,[total_booked_appointments]#(lf)      ,[total_attended_appointments]#(lf)      ,[total_dna_appointments]#(lf)      ,[filename]#(lf)      ,[processeddate]#(lf)  FROM [CCG_Current].[Hospices].[vw_PatCareServices_Monthly] [H]#(lf)#(lf)#(tab)#(tab)LEFT JOIN [CCG_Reference].[Reference].[vw_DateLookup][D]#(lf)#(tab)#(tab)ON [H].[Referral_Date] = [D].[Date]#(lf)#(lf)WHERE [Referral_Date] != '2109-09-03'#(lf)AND [Referral_Date] != '2012-09-10'#(lf)"]),
				    #"Added patient_id column" = Table.AddColumn(Source, "patient_id", each if [nhs_number] = "" then [local_patient_identifier] else [nhs_number]),
				    #"Added age_band_order Column" = Table.AddColumn(#"Added patient_id column", "age_band_order", each if [age_band] = "<40" then 1 else if [age_band] = "40-49" then 2 else if [age_band] = "50-59" then 3 else if [age_band] = "60-69" then 4 else if [age_band] = "70-79" then 5 else if [age_band] = "80-89" then 6 else if [age_band] = "90-99" then 7 else if [age_band] = "100+" then 8 else null),
				    #"Capitalized Each Word (source of referral)" = Table.TransformColumns(#"Added age_band_order Column",{{"source_of_referral", Text.Proper, type text}}),
				    #"Added counter column" = Table.AddColumn(#"Capitalized Each Word (source of referral)", "counter", each 1),
				    #"Replaced blank suppport_provided_to" = Table.ReplaceValue(#"Added counter column"," ","Unknown",Replacer.ReplaceText,{"support_provided_to"})
				in
				    #"Replaced blank suppport_provided_to"

	annotation PBI_ResultType = Table

