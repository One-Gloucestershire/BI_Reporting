table pat_care_services
	lineageTag: f15a2827-3ff5-4aed-b1bc-e8a3d3fa79b8

	measure counter_small_number_suppression_pcs = if(DISTINCTCOUNT(pat_care_services[patient_id])<5,"<5",DISTINCTCOUNT(pat_care_services[patient_id]))
		formatString: 0
		lineageTag: 4c5051f3-1c7e-49db-9f35-0c4d0fd96557

		annotation PBI_FormatHint = {"isDecimal":true}

	measure distinct_patients = DISTINCTCOUNT(pat_care_services[patient_id])
		formatString: 0
		lineageTag: c368a9f3-093f-4db9-b99f-9bc81e35f8c5

	measure practice_%_of_total_pcs =
			DIVIDE(
			                            CALCULATE(
			                                COUNT(pat_care_services[Practice])
			                            ),
			                            CALCULATE(
			                                COUNT(pat_care_services[Practice]),
			                                ALL(pat_care_services)
			                                )
			                            )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f7c35591-5281-4483-a707-ae7b98ffa4b2

	measure %_of_total_pcs = ```
			
			        divide(
			            distinctcount(pat_care_services[patient_id]),
			                calculate(
			                    distinctcount(pat_care_services[patient_id]),
			                    allselected(pat_care_services)
			                    ))
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: bb9d03c6-8769-4c84-b697-ac02a70e7468

	measure Average_PCS_activity =
			
			AVERAGEX(
				KEEPFILTERS(VALUES('date_table'[day_month_year])),
				'pat_care_services'[distinct_patients] + 0
			)
		lineageTag: 3371c4b9-de92-4032-b9e7-85dc5248265c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'PCS Patients Rate per 1000 - By Month' =
			
			
			VAR PCS = CALCULATE ( 'pat_care_services'[distinct_patients] )
			VAR POP = CALCULATE ( SUM ( 'Population'[population] ) )
			
			RETURN (PCS/POP*1000)
		lineageTag: 2a999c80-bd30-4e20-b0a2-8aee90a17129

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'PCS Patients - By Year' =
			
			
			VAR PCS = CALCULATE ( 'pat_care_services'[distinct_patients] , ALLEXCEPT( 'date_table', 'date_table'[financial_year] )  )
			VAR POP = CALCULATE ( SUM ( Population[population] ) , ALLEXCEPT ('date_table', 'date_table'[financial_year] ), 'date_table'[month_name] IN {"Apr"} )
			
			RETURN (PCS/POP*1000)
		lineageTag: 65ef0250-534e-4b66-b119-f9f9cf19609f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

