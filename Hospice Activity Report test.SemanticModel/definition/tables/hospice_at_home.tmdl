table hospice_at_home
	lineageTag: f23f5dc6-8741-4a47-8609-b79037436129

	measure Referrals_accepted =
			
			CALCULATE(
				COUNTA('hospice_at_home'[Counter]),
				'hospice_at_home'[Referral_Accepted] IN { "Yes" }
			)
		formatString: #,0
		lineageTag: a55284de-9a65-48f7-811c-05d5876f9479

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "FilteredMeasure"
				}

	measure Referrals = sum([Counter])
		formatString: #,0
		lineageTag: bca61a9d-72e7-4e6f-97bf-49fe0956e8ac

	measure counter_small_number_suppression = if(and(count(hospice_at_home[Counter])<5,count(hospice_at_home[Counter])>0),"<5",count(hospice_at_home[Counter]))
		formatString: 0
		lineageTag: 21b35212-b5c5-4bcb-903e-af6c117f8149

	measure practice_%_of_total =
			DIVIDE(
			                            CALCULATE(
			                                COUNT(hospice_at_home[Practice])
			                            ),
			                            CALCULATE(
			                                COUNT(hospice_at_home[Practice]),
			                                ALL(hospice_at_home)
			                                )
			                            )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d52fc973-332f-49e7-bf7c-37ab3ded349f

		changedProperty = FormatString

	measure %_of_total = ```
			
			        divide(
			            sum(hospice_at_home[Counter]),
			                calculate(
			                    sum(hospice_at_home[Counter]),
			                    allselected(hospice_at_home)
			                    ))
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 839e0d9d-34be-4f40-807f-e9d7a8de4216

		changedProperty = FormatString

	measure %_accepted =
			
			DIVIDE(
			    CALCULATE(
				COUNTA('hospice_at_home'[Counter]),	'hospice_at_home'[Referral_Accepted] IN { "Yes" }),
			    CALCULATE(COUNTA('hospice_at_home'[Counter]),ALL('hospice_at_home'[Referral_Accepted]))
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 984333ad-662e-4fdd-8c2d-f5ebf1a0779c

	measure nhs_no_completion = ```
			
			        divide(
			            sum(hospice_at_home[nhs_no_flag]),
			                calculate(
			                    sum(hospice_at_home[Counter]),
			                    allselected(hospice_at_home)
			                    ))
			```
		formatString: 0%;-0%;0%
		lineageTag: 94521b07-e71d-41ae-8a96-256dfbccecd6

	measure %_cancer =
			
			DIVIDE(
			    CALCULATE(
				COUNTA('hospice_at_home'[Counter]),	'hospice_at_home'[Primary_Diagnosis] IN { "Cancer" }),
			    CALCULATE(COUNTA('hospice_at_home'[Counter]),ALL('hospice_at_home'[Primary_Diagnosis]))
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c3df058d-7a7f-4732-aa64-b1292c3469f6

	measure 'Average H@H Ref 2' =
			
			CALCULATE((AVERAGEX(
				KEEPFILTERS(VALUES('date_table'[day_month_year])),
				CALCULATE(sum(hospice_at_home[Counter])) +0
			)  ))
		lineageTag: 835b44a2-78dd-4efc-a451-73be0c30ed78

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Measure = CALCULATE(SUM('hospice_at_home'[Counter]))
		formatString: 0
		lineageTag: ed7613ba-b315-46e0-9e78-d954c1862108

	measure 'H@H Referrals Rate per 1000 - By Month' =
			
			
			VAR HAHRef = CALCULATE ( SUM ('hospice_at_home'[Counter]) )
			VAR POP = CALCULATE ( SUM ( 'Population'[population] ) )
			
			RETURN (HAHREF/POP*1000)
		lineageTag: ca7bc70f-e442-4c6f-be1c-0715b6e91628

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'H@H Referrals - By Year' =
			
			
			VAR HAHREF = CALCULATE ( SUM ('hospice_at_home'[Counter] ) , ALLEXCEPT( 'date_table', 'date_table'[financial_year] )  )
			VAR POP = CALCULATE ( SUM ( Population[population] ) , ALLEXCEPT ('date_table', 'date_table'[financial_year] ), 'date_table'[month_name] IN {"Apr"} )
			
			RETURN (HAHREF/POP*1000)
		lineageTag: fa23b422-ff43-48fb-b37d-950406d53e00

		annotation PBI_FormatHint = {"isGeneralNumber":true}

