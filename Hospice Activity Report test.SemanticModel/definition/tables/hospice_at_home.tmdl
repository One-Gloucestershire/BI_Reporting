	partition hospice_at_home-e187f935-e874-4ade-bbe4-ec8c324ac58f = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "ccg_current", [Query="/****** Script for SelectTopNRows command from SSMS  ******/#(lf)#(lf)SET NOCOUNT ON#(lf)IF OBJECT_ID ('TEMPDB..#max_date') IS NOT NULL DROP TABLE #max_date#(lf)#(lf)#(lf)select #(lf)#(lf)[max_date] = max(referral_date)#(lf),[data_up_to] = EOMONTH(DATEADD(MONTH, -1, GETDATE()))#(lf)into #max_date#(lf)#(lf)from [CCG_Current].[Hospices].[vw_HospiceAtHome_Monthly]#(lf)#(lf)SET NOCOUNT ON#(lf)IF OBJECT_ID ('TEMPDB..#table_1') IS NOT NULL DROP TABLE #table_1#(lf)#(lf)#(lf)#(lf)SELECT DISTINCT [Provider]#(lf)      ,[Local_Patient_Identifier]#(lf)      ,[NHS_Number]#(lf)      ,[Referral_Date] = CAST([Referral_Date] AS date)#(lf)#(tab)  ,[Referral_Date_YearMonth] = [D].[YearMonth]#(lf)#(tab)  ,[Referral_Date_FinancialYear] = [D].[FinancialYear]#(lf)      ,[Registration_Date] = CASE WHEN [Registration_Date] < '2019-01-01' THEN NULL ELSE CAST([Registration_Date] AS date) END#(lf)      ,[Discharge_Date] = CASE WHEN [Discharge_Date] < '2019-01-01' THEN NULL ELSE CAST([Discharge_Date] AS date) END#(lf)#(tab)  ,[PDS].[DateOfDeath]#(lf)#(tab)  ,[days_of_care] = case when ([Referral_Accepted] = 'yes' and [Referral_Date] is not null and [Discharge_Date] is not null and [Discharge_Date]>=[Referral_Date]) then DATEDIFF(dd,[Referral_date],[discharge_date])#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) when ([Referral_Accepted] = 'yes' and [Referral_Date] is not null and [Discharge_Date] < '2018-01-01' and [DateOfDeath] is not null and [DateOfDeath]>=[Referral_Date]) then DATEDIFF(dd,[Referral_date],[DateOfDeath])#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) else null end#(lf)      ,[Source_of_Referral] = CASE WHEN [Source_of_Referral] = 'General Medical Practitioner' THEN 'GP'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [Source_of_Referral] = 'General Medical Practicioner' THEN 'GP'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ELSE [Source_of_Referral] END#(lf)      ,[Referral_Accepted]#(lf)      ,[Reason_for_not_accepting] = CASE WHEN [Reason_for_not_accepting] = ' ' THEN NULL#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)     WHEN [Reason_for_not_accepting] = 'N/A' THEN NULL#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) ELSE [Reason_for_not_accepting] END#(lf)      ,[Referral_accepted_–_funding_in_place]#(lf)      ,[Responded_to_referral_within_4_hours]#(lf)      ,[GP_Practice]#(lf)#(tab)  --,[Practice] = SUBSTRING([GP_Practice],0,charindex('-',[GP_Practice],0))#(lf)#(tab)  ,[Practice] = LEFT([GP_Practice],CHARINDEX('-',[GP_Practice])-1)#(lf)#(tab)  ,[Practice Code] = RIGHT([GP_Practice],CHARINDEX('-',(REVERSE([GP_Practice])))-2)#(lf)      ,[Age_at_referral]#(lf)#(tab)  ,[Age band] = CASE WHEN CAST([Age_at_referral] AS int) between '1' and '39' THEN '<40'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN CAST([Age_at_referral] AS int) between '40' and '49' THEN '40-49'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN CAST([Age_at_referral] AS int) between '50' and '59' THEN '50-59'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN CAST([Age_at_referral] AS int) between '60' and '69' THEN '60-69'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN CAST([Age_at_referral] AS int) between '70' and '79' THEN '70-79'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN CAST([Age_at_referral] AS int) between '80' and '89' THEN '80-89'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN CAST([Age_at_referral] AS int) between '90' and '99' THEN '90-99'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) WHEN CAST([Age_at_referral] AS int) between '100' and '150' THEN '100+' #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) ELSE 'Unknown' END#(lf)      ,[Ethnicity]#(lf)#(tab)  ,[Ethnicity Indicator] = CASE WHEN [Ethnicity] = 'Unknown' THEN 0 ELSE 1 END#(lf)      ,[H].[Gender]#(lf)      ,[Religious/personal_belief]#(lf)      ,[Primary_Diagnosis]#(lf)      ,[Patient_died]#(lf)      ,[Death_in_preferred_place_of_care]#(lf)      ,[Location_of_discharge]#(lf)      ,[FileName]#(lf)      ,[ProcessedDate]#(lf)#(tab)  ,[M].[LTCCountDerived]#(lf)#(tab)  ,[ObesityDerived]#(lf)      ,[SmokerDerived]#(lf)      ,[AsthmaDerived]#(lf)      ,[COPDDerived]#(lf)      ,[DementiaDerived]#(lf)      ,[DepressionDerived]#(lf)      ,[DiabetesDerived]#(lf)      ,[PalliativeCareDerived]#(lf)      ,[ChronicKidneyDiseaseDerived]#(lf)      ,[EpilepsyDerived]#(lf)      ,[HeartFailureDerived]#(lf)      ,[StrokeDerived]#(lf)      ,[AtrialFibrillationDerived]#(lf)      ,[CancerDerived]#(lf)      ,[CoronaryHeartDiseaseDerived]#(lf)      ,[HypertensionDerived]#(lf)      ,[HypothyroidismDerived]#(lf)      ,[LearningDisabilityDerived]#(lf)      ,[MentalIllnessDerived]#(lf)#(tab)  ,[eFI_Catgory_derived]#(lf)#(tab)  ,[data_up_to] = EOMONTH(DATEADD(quarter, -1, getdate()))#(lf)#(tab)  ,[date_refreshed] = getdate()#(lf)#(lf)#(lf)#(tab)  ,[up_to_financial_quarter] = case when datepart(month,max_date) like 1 then EOMONTH(DATEADD(month, -1, [max].max_date))#(lf)#(tab)#(tab)#(tab)when datepart(month,max_date) like 2 then EOMONTH(DATEADD(month, -2, [max].max_date))#(lf)#(tab)#(tab)#(tab)when datepart(month,max_date) like 3 then EOMONTH(DATEADD(month, -0, [max].max_date))#(lf)#(tab)#(tab)#(tab)when datepart(month,max_date) like 4 then EOMONTH(DATEADD(month, -1, [max].max_date))#(lf)#(tab)#(tab)#(tab)when datepart(month,max_date) like 5 then EOMONTH(DATEADD(month, -2, [max].max_date))#(lf)#(tab)#(tab)#(tab)when datepart(month,max_date) like 6 then EOMONTH(DATEADD(month, -0, [max].max_date))#(lf)#(tab)#(tab)#(tab)when datepart(month,max_date) like 7 then EOMONTH(DATEADD(month, -1, [max].max_date))#(lf)#(tab)#(tab)#(tab)when datepart(month,max_date) like 8 then EOMONTH(DATEADD(month, -2, [max].max_date))#(lf)#(tab)#(tab)#(tab)when datepart(month,max_date) like 9 then EOMONTH(DATEADD(month, -0, [max].max_date))#(lf)#(tab)#(tab)#(tab)when datepart(month,max_date) like 10 then EOMONTH(DATEADD(month, -1, [max].max_date))#(lf)#(tab)#(tab)#(tab)when datepart(month,max_date) like 11 then EOMONTH(DATEADD(month, -2, [max].max_date))#(lf)#(tab)#(tab)#(tab)when datepart(month,max_date) like 12 then EOMONTH(DATEADD(month, -0, [max].max_date))#(lf)#(tab)#(tab)#(tab)END #(lf)#(tab)  #(lf)#(tab)INTO #table_1#(lf)#(lf)  FROM [CCG_Current].[Hospices].[vw_HospiceAtHome_Monthly][H]#(lf)#(lf)  LEFT JOIN [CCG_Reference].[Reference].[vw_DateLookup][D]#(lf)  ON [H].[Referral_Date] = [D].[Date]#(lf)  #(lf)  left join [BIReports].[MPI].[MPI_current][M]#(lf)  on [H].[NHS_Number] = [M].[Derived_Pseudo_NHS]#(lf)#(lf)  left join [CCG_Reference].[Population].[vw_PDS_Deaths][PDS]#(lf)  on [H].[NHS_Number] = [PDS].[Derived_NHS_Number]#(lf)#(lf)  LEFT JOIN #max_date [max] on [max].[data_up_to] = EOMONTH(DATEADD(MONTH, -1, GETDATE()))#(lf)#(lf)  where [Referral_Date] >= '2021-04-01'#(lf)and [Referral_Date] <= EOMONTH(DATEADD(MONTH, -1, GETDATE()))#(lf)#(lf)order by Referral_Date desc#(lf)#(lf)#(lf)#(lf)SELECT *#(lf),[Financial_quarter_flag] = case when Referral_Date > up_to_financial_quarter then '0' else '1' END#(lf)#(lf)FROM #table_1#(lf)#(lf)order by Referral_Date desc#(lf)"]),
				    #"Added Counter column" = Table.AddColumn(Source, "Counter", each 1),
				    #"Added age_band_order column" = Table.AddColumn(#"Added Counter column", "age_band_order", each if [Age band] = "<40" then 1 else if [Age band] = "40-49" then 2 else if [Age band] = "50-59" then 3 else if [Age band] = "60-69" then 4 else if [Age band] = "70-79" then 5 else if [Age band] = "80-89" then 6 else if [Age band] = "90-99" then 7 else if [Age band] = "100+" then 8 else null),
				    #"Added patient_id column" = Table.AddColumn(#"Added age_band_order column", "patient_id", each if [NHS_Number] = "" then [Local_Patient_Identifier] else [NHS_Number]),
				    #"Added nhs_no_flag" = Table.AddColumn(#"Added patient_id column", "nhs_no_flag", each if [NHS_Number] <> "" then 1 else 0),
