	partition gp_postcode_ref-b6f44564-a62f-45de-99f6-d28ec5dc1145 = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "ccg_reference", [Query="/****** Script for SelectTopNRows command from SSMS  ******/#(lf)SELECT TOP (1000) [Locality]#(lf)      ,[Network]#(lf)      ,[Place]#(lf)      ,[PrimaryCareNetwork]#(lf)      ,[OrganisationCode]#(lf)      ,[OrganisationName]#(lf)      ,[ReportingOrganisationName]#(lf)      ,[ITSystem]#(lf)      ,[NumberOfLocations]#(lf)      ,[NumberOfEnhancedServices]#(lf)      ,[DispensingPractice]#(lf)      ,[DispensingPracticeDescription]#(lf)      ,[ContractType]#(lf)      ,[CoCommissioningModel]#(lf)      ,[OnlineAppointmentsEnabled]#(lf)      ,[OnlineAppointmentsEnabledDescription]#(lf)      ,[OnlinePrescriptionsEnabled]#(lf)      ,[OnlinePrescriptionsEnabledDescription]#(lf)      ,[NationalGrouping]#(lf)      ,[HighLevelHealthGeography]#(lf)      ,[AddressLine1]#(lf)      ,[AddressLine2]#(lf)      ,[AddressLine3]#(lf)      ,[AddressLine4]#(lf)      ,[AddressLine5]#(lf)      ,[Postcode]#(lf)      ,[OpenDate]#(lf)      ,[CloseDate]#(lf)      ,[StatusCode]#(lf)      ,[StatusDescription]#(lf)      ,[OrganisationSubTypeCode]#(lf)      ,[OrganisationSubTypeDescription]#(lf)      ,[Commissioner]#(lf)      ,[JoinProviderPurchaserDate]#(lf)      ,[LeftProviderPurchaserDate]#(lf)      ,[ContactTelephoneNumber]#(lf)      ,[AmendedRecordIndicator]#(lf)      ,[ProviderPurchaser]#(lf)      ,[PrescribingSetting]#(lf)      ,[PrescribingSettingDescription]#(lf)      ,[UpdateDate]#(lf)  FROM [CCG_Reference].[Reference].[vw_GPPractice]#(lf)#(lf)  WHERE [Commissioner] = '11M'"])
				in
				    Source

	annotation PBI_ResultType = Table

