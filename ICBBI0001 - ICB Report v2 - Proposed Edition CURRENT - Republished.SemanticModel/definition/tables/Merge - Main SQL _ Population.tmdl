	measure 'Rank Select' = ```
			
			
			IF(AVERAGE('Merge - Main SQL _ Population'[Quartile Switch])=1, CALCULATE([Rank (Val High)], 'Merge - Main SQL _ Population'[ORG CODE] = "QR1" || 'Merge - Main SQL _ Population'[ORG CODE] = "RTE" || 'Merge - Main SQL _ Population'[ORG CODE] = "11M"), 
			    IF(AVERAGE('Merge - Main SQL _ Population'[Quartile Switch])=2, CALCULATE([Rank (Val Low)], 'Merge - Main SQL _ Population'[ORG CODE] = "QR1" || 'Merge - Main SQL _ Population'[ORG CODE] = "RTE" || 'Merge - Main SQL _ Population'[ORG CODE] = "11M"),
			        IF(AVERAGE('Merge - Main SQL _ Population'[Quartile Switch])=3, CALCULATE([Rank (Rate High)], 'Merge - Main SQL _ Population'[ORG CODE] = "QR1" || 'Merge - Main SQL _ Population'[ORG CODE] = "RTE" || 'Merge - Main SQL _ Population'[ORG CODE] = "11M"),
			            IF(AVERAGE('Merge - Main SQL _ Population'[Quartile Switch])=4, CALCULATE([Rank (Rate Low)], 'Merge - Main SQL _ Population'[ORG CODE] = "QR1" || 'Merge - Main SQL _ Population'[ORG CODE] = "RTE" || 'Merge - Main SQL _ Population'[ORG CODE] = "11M"),
			    0
			    )
			)))
			```
		formatString: 0
		lineageTag: 3f992734-ed3a-4b54-a92d-b74655aecb93

	measure 'Rank Select Max' = ```
			
			
			IF(AVERAGE('Merge - Main SQL _ Population'[Quartile Switch])=1, [Rank (Val High) Max], 
			    IF(AVERAGE('Merge - Main SQL _ Population'[Quartile Switch])=2, [Rank (Val Low) Max],
			        IF(AVERAGE('Merge - Main SQL _ Population'[Quartile Switch])=3, [Rank (Rate High) Max],
			            IF(AVERAGE('Merge - Main SQL _ Population'[Quartile Switch])=4, [Rank (Rate Low) Max],
			    0
