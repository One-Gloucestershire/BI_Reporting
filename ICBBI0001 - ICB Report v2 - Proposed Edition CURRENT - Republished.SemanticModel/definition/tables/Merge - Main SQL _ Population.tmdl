	measure 'QUARTILES by Provider' = ```
			
			VAR Vals =
			    IF(HASONEFILTER('Merge - Main SQL _ Population'[ORG CODE]),AVERAGE('Merge - Main SQL _ Population'[Value]),SUMX(ALL('Merge - Main SQL _ Population'[ORG CODE]),AVERAGE('Merge - Main SQL _ Population'[Value])))
			VAR Vals_Glo =
			    CALCULATE(AVERAGE('Merge - Main SQL _ Population'[Value]), 'Merge - Main SQL _ Population'[ORG CODE] = "QR1" || 'Merge - Main SQL _ Population'[ORG CODE] = "RTE" || 'Merge - Main SQL _ Population'[ORG CODE] = "11M") 
			VAR Indicator =
			    GROUPBY( 
			        ALL ( 'Merge - Main SQL _ Population' ),
			        'Merge - Main SQL _ Population'[Indicator],
			        "Vals", SUMX ( CURRENTGROUP (), [Value] )
			    )
			    
			VAR Percentile50 =
			    MEDIAN ( 'Merge - Main SQL _ Population'[Value] )
			VAR Percentile75 =
			    PERCENTILEX.INC('Merge - Main SQL _ Population', 'Merge - Main SQL _ Population'[Value], 0.75)
			VAR Percentile25 =
			    PERCENTILEX.INC('Merge - Main SQL _ Population', 'Merge - Main SQL _ Population'[Value], 0.25)
			RETURN
			    IF (
			        Vals >= Percentile75,
			        "Q1",
			        IF ( Vals >= Percentile50, "Q2", IF ( Vals >= Percentile25, "Q3", "Q4" ) )
			    )
			```
		lineageTag: dd16af40-197c-4896-bd70-770f1213bbab

