table 'Merge - Main SQL _ Population'
	lineageTag: 4e89b8b8-793e-457a-958c-3ddecac19e71

	measure 'Compared to SW ICS (rate per 100k)' =
			
			IF(
			    SUM('Merge - Main SQL _ Population'[Gloucester ICS - Adjusted for provider]) >
			  CALCULATE (
			    AVERAGE ( 'Merge - Main SQL _ Population'[All ICS] ),
			    CALCULATETABLE (
			        VALUES ( 'Merge - Main SQL _ Population'[All ICS]), 'Merge - Main SQL _ Population'[Other South West ICS Flag]=1
			        )
			    )
			    ,"Better Than"
			    ,"Worse Than"
			)
		lineageTag: c73ea186-0431-444e-a3fb-e2c02531537c

	measure 'Compared to ALL ICS (rate per 100k)' =
			
			IF(
			    CALCULATE(AVERAGE('Merge - Main SQL _ Population'[All ICS]), 'Merge - Main SQL _ Population'[ORG CODE] = "QR1" || 'Merge - Main SQL _ Population'[ORG CODE] = "RTE" || 'Merge - Main SQL _ Population'[ORG CODE] = "11M") >
			  CALCULATE (
			    AVERAGE ( 'Merge - Main SQL _ Population'[All ICS] )
			    )
			    ,"Better Than"
			    ,"Worse Than"
			)
		lineageTag: 83224ed9-5ef6-49a4-8922-621e47f2f0e4

	measure 'Compared to ALL ICS (value)' =
			
