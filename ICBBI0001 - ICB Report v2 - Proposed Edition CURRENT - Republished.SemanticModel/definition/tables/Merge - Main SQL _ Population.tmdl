	measure 'QUARTILE (Val low-good)' = ```
			
			VAR Vals =
			    CALCULATE(SUM ( 'Merge - Main SQL _ Population'[Value] ))
			VAR Vals_Glo =
			    CALCULATE(AVERAGE('Merge - Main SQL _ Population'[Value]), 'Merge - Main SQL _ Population'[ORG CODE] = "QR1" || 'Merge - Main SQL _ Population'[ORG CODE] = "RTE" || 'Merge - Main SQL _ Population'[ORG CODE] = "11M") 
			VAR Indicator =
			    GROUPBY( 
			        ALL ( 'Merge - Main SQL _ Population' ),
			        'Merge - Main SQL _ Population'[Indicator],
			        "Val", SUMX ( CURRENTGROUP (), [Value] )
			    )
			    
			VAR Percentile50 =
			    MEDIAN ( 'Merge - Main SQL _ Population'[Value] )
			VAR Percentile75 =
			    PERCENTILEX.INC('Merge - Main SQL _ Population', 'Merge - Main SQL _ Population'[Value], 0.75)
			VAR Percentile25 =
			    PERCENTILEX.INC('Merge - Main SQL _ Population', 'Merge - Main SQL _ Population'[Value], 0.25)
			RETURN
			    IF (
			        Vals_Glo <= Percentile25,
			        "Q4",
			        IF ( Vals_Glo <= Percentile50, "Q3", IF ( Vals_Glo <= Percentile75, "Q2", "Q1" ) )
			    )
			```
		lineageTag: b1290a15-a2b9-4116-9552-55ab817ae749

	measure 'Z-Score measure' =
			
			var mean = AVERAGE('Merge - Main SQL _ Population'[Value])
			var StandardDeviation = STDEV.S('Merge - Main SQL _ Population'[Value])
			return (StandardDeviation)
		formatString: 0
