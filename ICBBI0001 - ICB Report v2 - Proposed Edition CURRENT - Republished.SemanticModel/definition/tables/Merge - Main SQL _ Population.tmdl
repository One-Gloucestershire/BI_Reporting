	measure 'QUARTILE (Rate per 100k)' = ```
			
			VAR Vals =
			    CALCULATE(SUM ( 'Merge - Main SQL _ Population'[All ICS] ))
			VAR Vals_Glo =
			    CALCULATE(AVERAGE('Merge - Main SQL _ Population'[All ICS]), 'Merge - Main SQL _ Population'[ORG CODE] = "QR1" || 'Merge - Main SQL _ Population'[ORG CODE] = "RTE" || 'Merge - Main SQL _ Population'[ORG CODE] = "11M") 
			VAR Indicator =
			    GROUPBY (
			        ALL ( 'Merge - Main SQL _ Population' ),
			        'Merge - Main SQL _ Population'[Indicator],
			        "Val", SUMX ( CURRENTGROUP (), [All ICS] )
			    )
			VAR Percentile50 =
			    MEDIAN ( 'Merge - Main SQL _ Population'[All ICS] )
			VAR Percentile75 =
			    PERCENTILEX.INC('Merge - Main SQL _ Population', 'Merge - Main SQL _ Population'[All ICS], 0.75)
			VAR Percentile25 =
			    PERCENTILEX.INC('Merge - Main SQL _ Population', 'Merge - Main SQL _ Population'[All ICS], 0.25)
			RETURN
			    IF (
			        Vals_Glo >= Percentile75,
			        "Q1",
			        IF ( Vals_Glo >= Percentile50, "Q2", IF ( Vals_Glo >= Percentile25, "Q3", "Q4" ) )
			    )
			```
		lineageTag: 7a99d936-e268-4c52-80c3-9c6f569f3f11

	measure 25 = ```
			
