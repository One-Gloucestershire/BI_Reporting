			    SelectedAttribute & " - Ageband"
			)
			```
		lineageTag: ad15e0b1-c446-476b-aa71-621c4975f1a2

	measure 'Healthy Well ICB' =
			CALCULATE(
			    SUM('Health Overview'[Value]),
			    ALLEXCEPT('Health Overview','Health Overview'[Attribute]))/CALCULATE(SUM('Population Overview'[Population_Counter]), ALL('Population Overview'),ALL('Health Overview'))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0b9afcb4-1583-4997-b9d1-7443330f1bca

	measure 'With LTC ICB' = 1-'Health Overview'[Healthy Well ICB]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: fd60ffcf-672d-4da3-baee-5f8bac2e035c

	measure 'Dynamic Title Ethnicity' = ```
			
