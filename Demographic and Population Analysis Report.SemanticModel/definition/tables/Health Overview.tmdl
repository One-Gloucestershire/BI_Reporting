			RETURN 
			IF (
			    [HideVisualAttribute] = 0,
			    "Ethnicity",
			    SelectedAttribute & " - Ethnicity"
			)
			```
		lineageTag: 56f7c59b-4bed-40c7-a0d8-94f318cab9df

	measure 'ISR - Expected' = [ISR - Local Expected Events]
		lineageTag: b7e71cc9-2ab2-478d-a385-ceef501b6ab7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ISR - Reference Crude Rate' = [ISR - Reference Events]/[ISR - Reference Population]*1000
		lineageTag: 46f39d2e-d5b9-4cc1-ade2-72818de1e0a8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ISR - Local Expected Events 1' = ```
			sumx(VALUES('Population Overview'[Age]),[ISR - Local Expected Events]) 
			```
		lineageTag: ede6aebc-d2e7-4dc1-9344-c9a7cd4de3d1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'LTC NO FILTER %' = CALCULATE(SUM('Health Overview'[Value]),ALL('Population Overview'))/CALCULATE(SUM('Population Overview'[Population_Counter]), ALL('Population Overview'),ALL('Health Overview'))
		formatString: 0.00%;-0.00%;0.00%
