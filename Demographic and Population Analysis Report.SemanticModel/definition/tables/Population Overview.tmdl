		lineageTag: 1c68bc32-fe64-4b6e-bbe0-d8f594a3de8a

	measure HideVisualAttribute = if([FilterVisualAttribute],1,0)
		formatString: 0
		lineageTag: 7e4dc80d-36af-48f4-a93c-2972e4dd8783

	measure Denominator = CALCULATE(SUM('Population Overview'[Population_Counter]), ALLEXCEPT('Population Overview','Population Overview'[LSOA_Code],'Population Overview'[District_Name],'Population Overview'[Ward_Name],'Population Overview'[GP_Practice_Name],'Population Overview'[PrimaryCareNetwork],'Population Overview'[Locality],'Population Overview'[Age],'Population Overview'[Care_Home],'Population Overview'[Ethnicity]))
		formatString: 0
		lineageTag: 5a2bffd9-e7d5-41df-9eba-07ad10f104f5

	measure PyramidAge = DIVIDE( SUM('Population Overview'[Population_Counter]), CALCULATE( SUM('Population Overview'[Population_Counter]), ALLSELECTED('Population Overview'[Age],'Population Overview'[Age_Rank])))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0894b826-eaf7-47df-9092-a6ac606c9846

	measure PyramidEthnicity = sum('Population Overview'[Population_Counter])/CALCULATE(SUM('Population Overview'[Population_Counter]), ALLEXCEPT('Population Overview','Population Overview'[LSOA_Code],'Population Overview'[District_Name],'Population Overview'[Ward_Name],'Population Overview'[GP_Practice_Name],'Population Overview'[PrimaryCareNetwork],'Population Overview'[Locality],'Population Overview'[Care_Home],'Population Overview'[Age],'Population Overview'[IMD_Decile_England],'Population Overview'[IMD_Decile_Gloucester]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4f9bd5c3-c238-4c12-b4de-9c4cdb1eb0db

	measure PyramidIMD = sum('Population Overview'[Population_Counter])/CALCULATE(SUM('Population Overview'[Population_Counter]), ALLEXCEPT('Population Overview','Population Overview'[LSOA_Code],'Population Overview'[District_Name],'Population Overview'[Ward_Name],'Population Overview'[GP_Practice_Name],'Population Overview'[PrimaryCareNetwork],'Population Overview'[Locality],'Population Overview'[Care_Home],'Population Overview'[Age],'Population Overview'[IMD_Decile_England],'Population Overview'[Ethnicity]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c67abadd-1644-4d56-b604-b438ec61c436

	measure SelectedGroup =
