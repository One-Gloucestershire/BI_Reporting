	measure 'Working Age' = 1-[Under 18's]-[65 and Over]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3ddcaa21-668c-4ee5-9ffe-3aeb0c70e44c

	measure UrbanCount =
			
			SUMX(
			    'Population Overview',
			    IF('Population Overview'[RuralUrbanClass] = "Urban", 1, 0))
		formatString: 0
		lineageTag: bcc2b857-2f00-441b-9c26-91e7faae4ce2

	measure RuralCount =
			
			SUMX(
			    'Population Overview',
			    IF(
			        CONTAINSSTRING('Population Overview'[RuralUrbanClass], "Rural"),
			        1,
			        0
			    )
			)
		formatString: 0
		lineageTag: 2ebf63b8-08a1-4f80-af94-4ce6dabe8d52

	measure Rural% = [RuralCount]/Sum('Population Overview'[Population_Counter])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 752951ba-3e0e-4126-a07e-18c52be14b14

	measure Urban% = [UrbanCount]/Sum('Population Overview'[Population_Counter])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3a329d9a-39b7-4614-a37f-91b6798c11a6

	measure ICBCareHome = CALCULATE(SUM('Population Overview'[Care_Home]),ALLEXCEPT('Population Overview','Population Overview'[Care_Home]))/CALCULATE(SUM('Population Overview'[Population_Counter]),ALL('Population Overview'))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a0379c6e-27db-4d11-9142-b822df3a6832

	measure ComparisonCareHome = IF([Care Home]>[ICBCareHome], "↑",IF([Care Home]=[ICBCareHome],"","↓"))
		lineageTag: edf7309c-29ec-4a29-a2d8-8434384debf0

	measure ICBRural =
			CALCULATE(SUMX(
			    'Population Overview',
			    IF(
			        CONTAINSSTRING('Population Overview'[RuralUrbanClass], "Rural hamlets and isolated dwellings") ||
			        CONTAINSSTRING('Population Overview'[RuralUrbanClass], "Rural town and fringe") ||
			        CONTAINSSTRING('Population Overview'[RuralUrbanClass], "Rural village"),
			        1,
			        0
			    )
			),ALLEXCEPT('Population Overview','Population Overview'[Care_Home]))/CALCULATE(SUM('Population Overview'[Population_Counter]),ALL('Population Overview'))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4794a00b-2082-4476-8acf-194a97a13416

	measure ComparisonRural = IF([Rural%]>[ICBRural], "↑",IF([Rural%]=[ICBRural],"", "↓"))
		lineageTag: fbe93f82-bd0d-4f05-957f-ac2736af9360

	measure ICBUrban =
			CALCULATE(SUMX(
			    'Population Overview',
			    IF('Population Overview'[RuralUrbanClass] = "Urban city and town", 1, 0)),ALLEXCEPT('Population Overview','Population Overview'[Care_Home]))/CALCULATE(SUM('Population Overview'[Population_Counter]),ALL('Population Overview'))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 41e5beee-44d7-4892-afa8-ec500bb6cdd4

	measure ComparisonUrban = IF([Urban%]>[ICBUrban], "↑",IF([Urban%]=[ICBUrban],"", "↓"))
		lineageTag: 2d5e739a-3481-4f19-b254-3bb32c46d81a

	measure ICBCOver65 = CALCULATE(SUM('Population Overview'[65_and_Over]),ALLEXCEPT('Population Overview','Population Overview'[65_and_Over]))/CALCULATE(SUM('Population Overview'[Population_Counter]),ALL('Population Overview'))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 11c23602-883c-437b-a8ba-1f7b1aff9dda

	measure ComparisonOver65 = IF([65 and Over]>[ICBCOver65], "↑",iF([65 and Over]=[ICBCOver65],"", "↓"))
		lineageTag: 565cf994-6900-4629-98a0-a3b0ca27f721

	measure ICBCUnder18 = CALCULATE(SUM('Population Overview'[Under_18]),ALLEXCEPT('Population Overview','Population Overview'[Under_18]))/CALCULATE(SUM('Population Overview'[Population_Counter]),ALL('Population Overview'))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 72a3ac62-6f6e-40ab-beee-9fac3f0640ba

	measure ComparisonUnder18 = IF([Under 18's]>[ICBCUnder18], "↑",IF([Under 18's]=[ICBCUnder18],"", "↓"))
		lineageTag: 895353f3-4b59-47a4-963d-95c653c18571

	measure ICBCore20 = CALCULATE(SUM('Population Overview'[Core20]),ALLEXCEPT('Population Overview','Population Overview'[Core20]))/CALCULATE(SUM('Population Overview'[Population_Counter]),ALL('Population Overview'))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f9782e20-965b-44bf-b630-d181337690fe

	measure ComparisonCore20 = IF([Core 20]>[ICBCore20], "↑",IF([Core 20]=[ICBCore20],"", "↓"))
		lineageTag: 19c9f2d9-e341-496a-81dc-2d63c8fa7293

	measure ICBCEthnicMinority = CALCULATE(SUM('Population Overview'[EthnicMinority]),ALLEXCEPT('Population Overview','Population Overview'[EthnicMinority]))/CALCULATE(SUM('Population Overview'[Population_Counter]),ALL('Population Overview'))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 1235e556-a4eb-49ec-98b8-85146de8a425

	measure ComparisonEthnicMinority = IF([Ethnic Minorities]>[ICBCEthnicMinority], "↑",iF([Ethnic Minorities]=[ICBCEthnicMinority],"", "↓"))
		lineageTag: debd086b-60bb-484a-b0a4-c0744bbc582e

	measure ICBWorkingAge = CALCULATE(SUM([WorkingAge]),ALLEXCEPT('Population Overview','Population Overview'[WorkingAge]))/CALCULATE(SUM('Population Overview'[Population_Counter]),ALL('Population Overview'))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 68a3e346-6243-4976-aaa5-b293320b6a5e

	measure ComparisonWorkingAge = IF([Working Age]>[ICBWorkingAge], "↑",IF([Working Age]=[ICBWorkingAge],"", "↓"))
		lineageTag: 9c945faf-b9f7-4a38-ac35-a42fe3302c72

	measure NationalDeprivationICBComparator = ```
			
			VAR CurrentDecile = SELECTEDVALUE('Population Overview'[IMD_Decile_England])
			VAR TotalOverall = CALCULATE(COUNTROWS('Population Overview'), ALL('Population Overview'))
			VAR TotalInDecile = 
			    CALCULATE(
			        COUNTROWS('Population Overview'),
			        ALL('Population Overview'),
			        'Population Overview'[IMD_Decile_England] = CurrentDecile
			    )
			RETURN
			DIVIDE(TotalInDecile, TotalOverall)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 6d8ec06b-2619-41c6-9697-5e61474f6704

	measure EthnicityICBComparator =
			
			VAR TotalOverall = CALCULATE(COUNTROWS('Population Overview'), ALL('Population Overview'))
			VAR TotalByDecile = CALCULATE(COUNTROWS('Population Overview'), ALL('Population Overview'), VALUES('Population Overview'[Ethnicity]))
			RETURN
			DIVIDE(TotalByDecile, TotalOverall)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 2f8933f7-e127-469a-8eb5-018ee469f5cf

