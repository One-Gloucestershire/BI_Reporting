	measure 'Proportion - County Deprivation' = DIVIDE( SUM('Population Overview'[Population_Counter]), CALCULATE( SUM('Population Overview'[Population_Counter]), ALLSELECTED('Population Overview'[IMD_Decile_Gloucester])))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 42a82792-364d-49d2-8d4c-59a3cc50de50

	measure CountyDeprivationICBComparator = ```
			
			VAR CurrentDecile = SELECTEDVALUE('Population Overview'[IMD_Decile_Gloucester])
			VAR TotalOverall = CALCULATE(COUNTROWS('Population Overview'), ALL('Population Overview'))
			VAR TotalInDecile = 
			    CALCULATE(
			        COUNTROWS('Population Overview'),
			        ALL('Population Overview'),
			        'Population Overview'[IMD_Decile_Gloucester] = CurrentDecile
			    )
			RETURN
			DIVIDE(TotalInDecile, TotalOverall)
			```
		lineageTag: fbdb47bf-4b80-443f-8140-4b3efd039c9a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Map Distribution - Proportion' = ```
			
			
			VAR _NUMERATOR = SUM('Population Overview'[Population_Counter])
			
			VAR _DENOMINATOR = 
			
			CALCULATE(
			    SUM('Population Overview'[Population_Counter]),
			    ALL('Population Overview'[LSOA_2021])
			)
			
			RETURN
			
			(_NUMERATOR / _DENOMINATOR) * 1000
			```
		lineageTag: 017e32ac-0569-4597-8021-df06fcc1db93

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Proportion - LSOA' =
			
			DIVIDE(
			    SUM('Population Overview'[Population_Counter]),
			    CALCULATE(
			        SUM('Population Overview'[Population_Counter]),
			        ALLEXCEPT('Population Overview', 'Population Overview'[LSOA_2021])
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a46d414b-b620-4c80-a323-d44f3ff8aa57

	measure LSOATotalPopulation =
			CALCULATE(
			        SUM('Population Overview'[Population_Counter]),
			        ALLEXCEPT('Population Overview', 'Population Overview'[LSOA_2021])
			    )
		formatString: 0
		lineageTag: 0414c366-41e6-4f46-9b3c-6c9ed4d992ef

	measure ProportionLSOAMax =
			
			MAXX(
			    VALUES('Population Overview'[LSOA_2021]),
			    [Proportion - LSOA]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3dbd4ba5-d4d4-463d-a042-1eddebe33e1e

	measure ProportionLSOAMin =
			
			MINX(
			    VALUES('Population Overview'[LSOA_2021]),
			    [Proportion - LSOA]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 340ee3b4-6697-4190-bb4d-79f55b5b8f21

	measure 'Proportion - Practice' =
			
			DIVIDE(
			    SUM('Population Overview'[Population_Counter]),
			    CALCULATE(
