	measure 'Palliative Care Register' = ```
			
			
			VAR CurrentDate = MAX('Active Populations - Date Table'[date])
			
			RETURN 
			    CALCULATE(
			        DISTINCTCOUNT('EoL Data'[pseudo_nhs_number]),
			        'EoL Data'[palliative_care_register_date] <= CurrentDate,
			        OR (ISBLANK('EoL Data'[removal_date]), 'EoL Data'[removal_date] >= CurrentDate),
			        'EoL Data'[palliative_care_flag] = "Palliative Care"
			    )
			```
