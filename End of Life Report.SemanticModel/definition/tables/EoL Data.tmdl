	measure 'ReSPECT Population - Rate per 1,000' = ```
			
			
			VAR CurrentDate = MAX('Active Populations - Date Table'[date])
			VAR _POP = SUM('Census Population'[Counter])
			
			VAR RESPECT = 
			    CALCULATE(
			        DISTINCTCOUNT('EoL Data'[pseudo_nhs_number]),
			        'EoL Data'[respect_form_date] <= CurrentDate,
			        OR (ISBLANK('EoL Data'[removal_date]), 'EoL Data'[removal_date] >= CurrentDate),
			        'EoL Data'[respect_form_flag] = "ReSPECT Form Completed"
			    )
			
			    RETURN DIVIDE(RESPECT,_POP)*1000
