	measure '% ReSPECT Plan Deaths - Within 2 Years' = ```
			
			
			CALCULATE(
			    SUM( 'EoL Data'[counter] ),
			    FILTER(
			        'EoL Data',
			        'EoL Data'[respect_form_flag] = "ReSPECT Form Completed"
			            && 'EoL Data'[respect_form_date] >= EDATE('EoL Data'[death_date], -24)
			            && 'EoL Data'[respect_form_date] <= 'EoL Data'[death_date]
			    )
			)
			/ 
			    SUM('EoL Data'[counter])
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 87e2a503-5c33-4e0c-af68-73ffa1f0bae6

	measure '% ReSPECT Plan Deaths - No Plan Recorded - Within 2 Years' =
			
			
			1 - [% ReSPECT Plan Deaths - Within 2 Years]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 7efe6546-4e46-4f9a-81e1-d014b7c9fec9

	measure 'Total PC&SPs Recorded' = ```
			
			
			CALCULATE(
			    SUM('EoL Data'[counter]), 
			    'EoL Data'[pcsp_flag] = "PCSP Completed"
			    )
			```
		lineageTag: eaf58cf3-8da8-4873-98c0-07a279b9754a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

