	measure 'Excess Deaths' =
			
			
			VAR NumOfMonths = 60
			VAR LastCurrentDate =
			    MAX ( 'Death Date Reference'[Date] )
			VAR Period =
			    DATESINPERIOD ( 'Death Date Reference'[Date], LastCurrentDate, - NumOfMonths, MONTH )
			
			VAR Result =
			     CALCULATE (
			        AVERAGEX (
			            VALUES ( 'Death Date Reference'[year_month] ),
			            [Deaths]
			        ),
			        Period, NOT 'Death Date Reference'[year_month] IN {202004, 202012, 202101}
			    )
			VAR FirstDateInPeriod = MINX ( Period, 'Death Date Reference'[Date] )
			VAR LastDateWithSales = MAX ( 'Death Date Reference'[Date] )
			
			RETURN
			    IF ( FirstDateInPeriod <= LastDateWithSales, [Deaths] - Result )
		lineageTag: 6aad3cbb-ade9-4d64-9be6-6bcb16406d76

		annotation PBI_FormatHint = {"isGeneralNumber":true}

