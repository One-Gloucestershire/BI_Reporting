			VAR POP = CALCULATE(SUM('Census Population'[Counter]), ALL('GP Reference'), ALL('Gender Reference'), ALL('LTC Reference Table - ONLY LTC'), ALL('Deprivation Reference'), ALL('LTC Reference Table - ONLY LTC'), 'GP Reference'[PrimaryCareNetwork] <> BLANK(), ALL('Ethnicity Reference'))
			
