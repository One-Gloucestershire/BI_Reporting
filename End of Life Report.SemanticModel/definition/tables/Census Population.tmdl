	partition 'Census Population' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "PowerBI_Reporting", [Query="SELECT [Census_Date]#(lf)      ,[Derived_NHS_Number]#(lf)      ,[Removal_Date]#(lf)      ,[Practice_Code] = [PrimaryCareProvider]#(lf)      ,[Age_at_census]#(lf)      ,[efi_category] = CASE WHEN [POP].[efi_category] = 'No EFI deficits recorded' THEN 'Not Recorded'#(lf)#(tab)                         ELSE [POP].[efi_category] END#(lf)      ,[Gender]#(lf)      ,[Ethnicity] = [ETH].[Description]#(lf)      ,[IMDcountyDecile]#(lf)      ,[Core20Flag]#(lf)#(tab)  ,[Counter] = 1#(lf)#(lf)  FROM [PowerBI_Reporting].[AgeingWell].[tbl02_Proactive_Whiteboard_Registered_Population_Over_Time] AS [POP]#(lf)#(lf)  LEFT JOIN [CCG_Reference].[Reference].[vw_EthnicCategory] AS [ETH] ON [ETH].[NationalCode] = [POP].[Ethnicity_code]#(lf)#(lf)  WHERE [Derived_Registered_CCG] = '11M'#(lf)  AND [Census_Date] >= '20210401'"])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

