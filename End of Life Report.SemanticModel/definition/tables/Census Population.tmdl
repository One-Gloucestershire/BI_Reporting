table 'Census Population'
	lineageTag: 7dc0f6d6-9080-47b3-8a81-e4d1a9811ede

	measure 'Incidence Local Population' =
			
			
			SUM('Census Population'[Counter])
		formatString: 0
		lineageTag: 16960a0a-0b6a-473a-a6a3-e039c3f601e8

	measure 'Incidence Reference Population' = ```
			
			
			CALCULATE(
			    SUM('Census Population'[Counter]), 
			    ALL('GP Reference'), 
			    ALL('Gender Reference'),
			    ALL('GP Reference'),
			    ALL('EoL Data'[cause_of_death_primary], 'EoL Data'[cause_of_death_primary_chapter]), 
			    ALL('Ethnicity Reference'),
			    ALL('LTC Reference Table - ALL'),
			    ALL('LTC Reference Table - ONLY LTC'),
			    ALL('eFI Reference Table'),
			    ALL('Deprivation Reference')
			    )
			```
		formatString: 0
		lineageTag: 401f659b-a307-4032-a55e-6ea49859cbcb

	measure 'Incidence Reference Rate' =
			
			
			([Incidence Reference Events] / [Incidence Reference Population])
		formatString: 0.00000
		lineageTag: 34a72d8e-48f8-4a7e-99b0-b3fadf5de831

	measure 'Local Observed Deaths' = CALCULATE([DEATHS], ALL('Ethnicity Reference'))
		lineageTag: 9c029a9a-5e55-483b-959b-90c681a10af5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Local Reference Crude Rate' = ([Local Observed Deaths] / [Incidence Reference Population]) * 1000
		lineageTag: 204853a4-7437-49f6-9d3e-aa6c122ae453

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Local Reference Rate per 1,000' = [Incidence Reference Rate] * 1000
		lineageTag: 38b7c5a8-60e4-461b-8069-5434fef370fd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Incidence Local Events' =
			
			
			CALCULATE(
			    SUM('EoL Data'[counter]),
			    'EoL Data'[death_flag] = "Dead"
			)
		lineageTag: 6b949c36-5219-4fe7-9f69-f6c53bc9d506

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Incidence Reference Events' = ```
			
			
			CALCULATE(
			    SUM('EoL Data'[counter]), 
			    'EoL Data'[death_flag] = "Dead", 
			    ALL('GP Reference'),
			    ALL('Gender Reference'),
			    ALL('GP Reference'),
			    ALL('EoL Data'[cause_of_death_primary], 'EoL Data'[cause_of_death_primary_chapter]), 
			    ALL('Ethnicity Reference'),
			    ALL('LTC Reference Table - ALL'),
			    ALL('LTC Reference Table - ONLY LTC'),
			    ALL('eFI Reference Table'),
			    ALL('Deprivation Reference')
			    )
			```
		lineageTag: ba556e71-60f1-449b-9a78-39e58e7550d3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Incidence (Incorrect) Local Expected Events' = ```
			
			
			( [Incidence Reference Rate] * [Incidence Local Population] )
			
			```
		lineageTag: 89835d2b-bd39-4b91-9781-2f7d20d57881

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Incidence (Corrected) Local Expected Events' =
			
			
			SUMX(
			    VALUES('Age Band Reference'[5YR_Age_Band]),
			    [Incidence (Incorrect) Local Expected Events]
			)
		lineageTag: 759342bb-0f52-4db6-aa32-50935de2861e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Incidence Reference Rate per 1,000' =
			
			
			([Incidence Reference Events] / [Incidence Reference Population]) * 1000
		formatString: 0.00
		lineageTag: 88697847-665b-4e93-8ee5-e02bc0c5adbd

	measure 'Incidence Local Rate per 1,000 Indirectly Age Standardised' =
			
			
			([Incidence Local Events] / [Incidence (Corrected) Local Expected Events]) * [Incidence Reference Rate per 1,000]
		formatString: 0.00
		lineageTag: 51878691-70c0-4132-8bdd-1ad711436c3d

	measure 'Incidence - Age Standardisation Variance' =
			
			
			IF(
			    [Incidence Local Rate per 1,000 Indirectly Age Standardised] - [Incidence Reference Rate per 1,000] > 0 &&
			    [Incidence Local Rate per 1,000 Indirectly Age Standardised] - [Incidence Reference Rate per 1,000] < 0.00000000000001,
			    0,
			    [Incidence Local Rate per 1,000 Indirectly Age Standardised] - [Incidence Reference Rate per 1,000]
			)
		formatString: 0.000000000000000
		lineageTag: 6955bb5c-746e-491d-a02e-22dcdf5c4bc3

	measure 'Age Standardisation Colours' =
			
			
			IF([Incidence - Age Standardisation Variance] > 0, "#27a59d", "#ec5e5f")
		lineageTag: b2be9764-d898-4565-93f8-133d0fb4581d

	measure 'Incidence - Age Standardisation Variance Trendline' = ```
			
			
			VAR Temp_Table = 
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED( 'Death Date Reference'[financial_year], 'Death Date Reference'[financial_month],
			                         'Death Date Reference'[month_name], 'Death Date Reference'[month_number] ),
			            "Value_x", 'Death Date Reference'[month_number],
			            "Value_y", [Incidence - Age Standardisation Variance]
			        ),
			        AND (
			            NOT ( ISBLANK ( "Value_x" ) ),
			            NOT ( ISBLANK ( "Value_y" ) )
			        )
			    )
			
			VAR LINESTX_Table = 
			    LINESTX(Temp_Table, [Value_y], [Value_x], TRUE)
			VAR Slope = 
			    MAXX ( LINESTX_Table, [Slope1] )
			VAR Intercept = 
			    MAXX ( LINESTX_Table, [Intercept] )
			
			RETURN
			    SUMX (
			        DISTINCT ( 'Death Date Reference'[month_number] ),
			        Intercept + Slope * 'Death Date Reference'[month_number]
			    )
			```
		lineageTag: c954d74d-18f0-4e12-8622-19267585690c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

