	partition 'Age Band Reference' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Reference", [Query="SELECT [Age]#(lf)      ,[5YR_Age_Band]#(lf)#(tab)  ,[10YR_Age_Band]#(lf)#(tab)  ,[PBR_Age_Band]#(lf)#(tab)  ,[Standard_Age_Band]#(lf)#(tab)  ,[Risk_Strat_Age_Band]#(lf)#(tab)  ,[Risk_Strat_Age_BandInt]#(lf)#(tab)  ,[Adult_Age_Band] = CASE WHEN [Adult_Age_Band] = '<18' THEN '0-17 - Children and Young Adults'#(lf)#(tab)                           WHEN [Adult_Age_Band] = '18-64' THEN '18-64 - Working Age'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)   WHEN [Adult_Age_Band] = '65+' THEN '65+ - Older Adults' ELSE [Adult_Age_Band] END#(lf)#(tab)  ,[5YR_Age_Band_Order]#(lf)      ,[Mortality_AgeBand] = CASE WHEN [Age] BETWEEN 0 AND 14 THEN '00-14'#(lf)#(tab)                              WHEN [Age] BETWEEN 15 AND 44 THEN '15-44'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)  WHEN [Age] BETWEEN 45 AND 64 THEN '45-64'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)  WHEN [Age] BETWEEN 65 AND 74 THEN '65-74'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)  WHEN [Age] BETWEEN 75 AND 84 THEN '75-84'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)  WHEN [Age] >= 85 THEN '85+'#(lf)#(tab)                              ELSE 'Unknown' END#(lf)FROM [CCG_Reference].[Reference].[vw_AgeBand]#(lf)#(lf)WHERE [Age] BETWEEN 0 AND 128"])
				in
				    Source

