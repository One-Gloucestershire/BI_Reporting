	partition 'Age Band Reference' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db01_reference"), "select age as ""Age"", ""5yr_age_band"" as ""5YR_Age_Band"", ""10yr_age_band"" as ""10YR_Age_Band"", pbr_age_band as ""PBR_Age_Band"", standard_age_band as ""Standard_Age_Band"", risk_strat_age_band as ""Risk_Strat_Age_Band"", risk_strat_age_bandint as ""Risk_Strat_Age_BandInt"", case when adult_age_band='<18' then '0-17 - Children and Young Adults' when adult_age_band='18-64' then '18-64 - Working Age' when adult_age_band='65+' then '65+ - Older Adults' else adult_age_band end as ""Adult_Age_Band"", ""5yr_age_band_order"" as ""5YR_Age_Band_Order"", case when age between 0 and 14 then '00-14' when age between 15 and 44 then '15-44' when age between 45 and 64 then '45-64' when age between 65 and 74 then '65-74' when age between 75 and 84 then '75-84' when age>=85 then '85+' else 'Unknown' end as ""Mortality_AgeBand"" from ccg_reference.vw_ageband where age between 0 and 128", null, [EnableFolding=true])
				in
				    Source

