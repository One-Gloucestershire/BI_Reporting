table '% Performance Measures'
	lineageTag: 624a6c4a-62cb-4f97-95e6-d82c94cbd333

	measure '% Performance - Variance from Previous 12 Month - Population' =
			
			
			VAR Latest_Month = CALCULATE(SUM('Population'[population]), 'Death Date Reference'[latest_month_flag] = 1)
			VAR Previous_Month = CALCULATE(SUM('Population'[population]), 'Death Date Reference'[same_month_last_year_flag] = 1)
			
			RETURN (Latest_Month - Previous_Month)/Latest_Month
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: cdf972c3-ddba-4ce7-b66a-822da95de69a

	measure '% Performance - Variance from Previous Month - Population' =
			
			
