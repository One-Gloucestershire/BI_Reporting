			VAR Previous_Month = CALCULATE(SUM('Population'[population]), 'Death Date Reference'[previous_month_flag] = 1)
			
			RETURN (Latest_Month - Previous_Month)/Latest_Month
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 93ef930d-2cee-4a48-b488-05e3b1c08a0a

