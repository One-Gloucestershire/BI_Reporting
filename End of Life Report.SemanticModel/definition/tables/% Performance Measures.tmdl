	measure 'Z.% Grouping on Register' =
			
			
			VAR _POPULATION = CALCULATE(SUM('EoL Data'[counter]), 'EoL Data'[death_date] = BLANK(), 'EoL Data'[removal_date] = BLANK())
			
			RETURN
			
			DIVIDE([Palliative Care Register], _POPULATION)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: b0c94c4d-3c2b-46f0-8d97-47ed19c60fac

