	measure 'Quick LTC Measure' =
			
			
			VAR LTCPOP = SUM('EoL Data'[COUNTER])
			VAR OVERALLPOP = CALCULATE(SUM('EoL Data'[counter]), ALL('LTC Reference Table - ALL'))
			
			RETURN (LTCPOP/OVERALLPOP)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 40c4752d-ab42-4c26-ac57-6e44514c2826

