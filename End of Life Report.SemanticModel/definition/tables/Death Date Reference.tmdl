table 'Death Date Reference'
	lineageTag: e737355f-956c-4a8c-acd9-94e3ef81f092

	measure 'Death Date Trendline' = ```
			
			
			VAR Temp_Table = 
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED( 'Death Date Reference'[financial_year], 'Death Date Reference'[financial_month],
			                         'Death Date Reference'[month_name], 'Death Date Reference'[month_number] ),
			            "Value_x", 'Death Date Reference'[month_number],
			            "Value_y", 'Death Date Reference'[Deaths]
			        ),
			        AND (
			            NOT ( ISBLANK ( "Value_x" ) ),
			            NOT ( ISBLANK ( "Value_y" ) )
			        )
			    )
			
			VAR LINESTX_Table = 
			    LINESTX(Temp_Table, [Value_y], [Value_x], TRUE)
			VAR Slope = 
			    MAXX ( LINESTX_Table, [Slope1] )
			VAR Intercept = 
			    MAXX ( LINESTX_Table, [Intercept] )
			
			RETURN
			    SUMX (
			        DISTINCT ( 'Death Date Reference'[month_number] ),
			        Intercept + Slope * 'Death Date Reference'[month_number]
			    )
			```
		lineageTag: 0ae67228-d88a-43d4-9ad6-d02111179596

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Deaths = CALCULATE(SUM('EoL Data'[counter]), 'EoL Data'[death_flag] = "Dead")
		lineageTag: 43e50e4b-6244-4cb2-bb02-95aa48a1d8d0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Death Date - PCR - Trendline' = ```
			
			
			VAR Temp_Table = 
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED( 'Death Date Reference'[financial_year], 'Death Date Reference'[financial_month],
			                         'Death Date Reference'[month_name], 'Death Date Reference'[month_number] ),
			            "Value_x", 'Death Date Reference'[month_number],
			            "Value_y", 'EoL Data'[Palliative Care Register Deaths]
			        ),
			        AND (
			            NOT ( ISBLANK ( "Value_x" ) ),
			            NOT ( ISBLANK ( "Value_y" ) )
			        )
			    )
			
			VAR LINESTX_Table = 
			    LINESTX(Temp_Table, [Value_y], [Value_x], TRUE)
			VAR Slope = 
			    MAXX ( LINESTX_Table, [Slope1] )
			VAR Intercept = 
			    MAXX ( LINESTX_Table, [Intercept] )
			
			RETURN
			    SUMX (
			        DISTINCT ( 'Death Date Reference'[month_number] ),
			        Intercept + Slope * 'Death Date Reference'[month_number]
			    )
			```
		lineageTag: ec1acd8b-f5cc-42d9-8871-f39b8e1b7796

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Previous Year Deaths' =
			
			
			CALCULATE ( SUM('EoL Data'[counter]), (PREVIOUSYEAR('Death Date Reference'[date], "31/3")), 'Death Date Reference'[ytd_flag] = 1)
		lineageTag: 62ff3c84-629e-4442-811e-3f6787a343b0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Change in Deaths' = (DIVIDE([Deaths],[Previous Year Deaths]) - 1)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 968b7b5f-97fb-4b17-aaff-80dd65611e55

