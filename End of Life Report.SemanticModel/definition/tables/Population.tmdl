table Population
	lineageTag: 81a4ecf9-682b-42c4-99ca-16f18a149a5c

	measure 'Total Population' =
			
			
			SUM('Population'[population])
		lineageTag: e4011488-b615-4c38-bc5c-105fbdd294cc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Population - April (For Active Populations)' =
			
			
			CALCULATE(SUM('Census Population'[Counter]), 'Active Populations - Date Table'[month_name] IN {"Apr"})
		lineageTag: 5e9df699-75db-4dd2-a3f6-495db26e4ded

		annotation PBI_FormatHint = {"isGeneralNumber":true}

