	partition Population = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db02_nopid"), "select distinct practice_code, case when practice_name like 'Cam and Uley Family Practice' then 'Cam & Uley Family Practice' when practice_name like 'Newent Doctors Practice' then 'Holts Health Centre' when practice_name like 'Painswick Surgery' then 'Hoyland House' when practice_name like 'Prestbury Park' then 'Prestbury Park Medical' when practice_name like 'Royal Crescent' then 'Royal Crescent Surgery' when practice_name like 'Gloucester City Health Centre' then 'Severnside Medical Practice' when practice_name like 'Stroud Valleys Medical Practice' then 'Five Valleys Medical Practice' when practice_name like 'Locking Hill Surgery' then 'Five Valleys Medical Practice' else practice_name end as ""practice_name"", primary_care_network, locality, age_band, ""3_year_age_band"", sex, population, census_date, year_month, last_date_of_month, financial_year, 'Gloucestershire' as ""Legend_Helper"" from data_mart_primarycare.tbl01_gp_practice_populations where last_date_of_month between '2019-04-01' and last_day(dateadd(month,-1,current_date))", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

