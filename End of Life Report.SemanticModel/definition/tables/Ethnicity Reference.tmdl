	partition 'Ethnicity Reference' = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "CCG_Reference", [Query="  SELECT [Ethnic_Code] = [NationalCode]#(lf)        ,[Ethnic_Category_Detailed] = [Description]#(lf)#(tab)#(tab),[Ethnicity] = CASE WHEN [NationalCode] IN ('L', 'K', 'H', 'J') THEN 'Asian or Asian British'#(lf)#(tab)#(tab)                    WHEN [NationalCode] IN ('N', 'P', 'M') THEN 'Black or Black British'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [NationalCode] IN ('G', 'F', 'E', 'D') THEN 'Mixed'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [NationalCode] IN ('S', 'R') THEN 'Other Ethnic Groups'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN [NationalCode] IN ('C', 'A', 'B') THEN 'White'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ELSE NULL END#(lf)#(lf)  FROM [CCG_Reference].[Reference].[vw_EthnicCategory]"])
				in
				    Source

	annotation PBI_ResultType = Exception

	annotation PBI_NavigationStepName = Navigation

