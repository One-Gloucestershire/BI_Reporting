	partition 'Ethnicity Reference' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(AmazonRedshift.Database("ics-glos-reporting.cw0unw24a7tv.eu-west-2.redshift.amazonaws.com:5444","db01_reference"), "select nationalcode as ""Ethnic_Code"", description as ""Ethnic_Category_Detailed"", case when nationalcode in ('L','K','H','J') then 'Asian or Asian British' when nationalcode in ('N','P','M') then 'Black or Black British' when nationalcode in ('G','F','E','D') then 'Mixed' when nationalcode in ('S','R') then 'Other Ethnic Groups' when nationalcode in ('C','A','B') then 'White' else null end as ""Ethnicity"" from ccg_reference.vw_ethniccategory", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Exception

	annotation PBI_NavigationStepName = Navigation

