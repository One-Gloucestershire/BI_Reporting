table two_week_wait
	lineageTag: be82239b-e498-49b4-84e4-696f3d7ce249

	measure two_week_wait_performance = (SUM('two_week_wait'[total_referrals])-SUM('two_week_wait'[breaches]))/SUM('two_week_wait'[total_referrals])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: b0c1e4e6-ef15-481d-bf4e-979d5e0a705f

	measure 2ww_target = MIN('two_week_wait'[target])
		formatString: 0%;-0%;0%
		lineageTag: f3a66939-f23e-4164-af60-b345928663a8

	measure 2ww_target_checker = IF('two_week_wait'[two_week_wait_performance] >= 'two_week_wait'[2ww_target], "#63BE7B","#F8696B")
		lineageTag: 4c03aef3-0e76-4911-8f57-338196002624

	measure Testing = SUM('two_week_wait'[total_referrals])
		formatString: 0
		lineageTag: 9ce8449f-5238-4970-b9a1-d76019654b37

	measure 'Testing Breaches' = SUM('two_week_wait'[breaches])
		formatString: 0
		lineageTag: 8212cb04-3835-43c1-9d84-3beb7e2697bf

