	partition two_week_wait-fd7a2bcd-56fd-4454-8922-7a5cec6f62c5 = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "Data_Mart_Performance", [Query="------------------------------#(lf)--- two week wait standard ---#(lf)------------------------------#(lf)#(lf)select #(lf)[type] = '2WW',#(lf)[report_date] = [Report_Date], #(lf)[provider_code] = [Provider_Code],#(lf)[provider_name] = case when [Provider_Code] = 'RBA' then 'Somerset NHS Foundation Trust' #(lf)                       when [Provider_Code] = 'RQ6' then 'Liverpool University Hospitals NHS Foundation Trust' #(lf)                       else [p].[name] end,#(lf)[provider_group] = case when [Provider_Code] = 'RTE' then 'Gloucestershire Hospitals NHS Foundation Trust'#(lf)                        else 'Other Provider' end,#(lf)[tumour_type] = [Tumour_Type],#(lf)[tumour_group] = case when [Tumour_Type] = 'acute leukaemia' then 'Suspected Acute Leukaemia'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)  when [Tumour_Type] LIKE '%brain%' then 'Suspected Brain / Central Nervous System'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)  when [Tumour_Type] LIKE '%cancer not initially suspected%' then 'Non-Cancer Breast Symptoms'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)  when [Tumour_Type] LIKE '%breast%' then 'Suspected Breast'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)  when [Tumour_Type] LIKE '%children%' then 'Suspected Childrens Cancer'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)  when [Tumour_Type] LIKE '%gynaecological%' then 'Suspected Gynaecological'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)  when [Tumour_Type] LIKE '%Suspected haematological malignancies excluding acute leukaemia%' then 'Suspected Haematological Malignancies'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)  when [Tumour_Type] LIKE '%Head and Neck%' then 'Suspected Head and Neck'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)  when [Tumour_Type] LIKE '%lower gastrointestinal%' then 'Suspected Lower Gastrointestinal'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)  when [Tumour_Type] LIKE '%lung%' then 'Suspected Lung'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)  when [Tumour_Type] LIKE '%other%' then 'Suspected Other'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)  when [Tumour_Type] LIKE '%sarcoma%' then 'Suspected Sarcoma'#(tab)   #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)  when [Tumour_Type] LIKE '%skin%' then 'Suspected Skin'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)  when [Tumour_Type] LIKE '%suspected testicular%' then 'Suspected Testicular'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)  when [Tumour_Type] LIKE '%upper gastrointestinal%' then 'Suspected Upper Gastrointestinal'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)  when [Tumour_Type] LIKE '%Suspected urological cancers (excluding testicular)%' THEN 'Suspected Urological'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)  else 'ERROR' end,#(lf)[total_referrals] = [Total_Referrals_Seen_During_The_Period],#(lf)[breaches] = ([Seen_15_To_16_Days]+[Seen_17_To_21_Days]+[Seen_22_To_28_Days]+[Seen_After_28_Days]),#(lf)[target] = '93%',#(lf)[performance] = [%_Meeting_Standard] ,#(lf)[report_number] = [Report_Number],#(lf)[Report_name] = case when [Report_Number] = '6.3' then '6.3 - Two Week Wait'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab) when [Report_Number] = '6.4' then '6.4 - Breast Symptom Two Week Wait'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab) else 'ERROR' end,#(lf)[financial_year] = [d].[FinancialYear], #(lf)[month] = left([Report_Month],3),#(lf)[financial_month] = [d].[FinancialMonth] #(lf)#(lf)from [Data_Mart_Performance].[dbo].[Cancer_2_Week_Aggregate_Data] [a]#(lf)left join [CCG_Reference].[Reference].[vw_DateLookup] [d] on [a].[Report_Date] = [d].[Date]#(lf)left join [CCG_Reference].[Reference].[vw_OrganisationTrust] [p] on [a].[Provider_Code] = [p].[organisationcode]#(lf)where [Report_Date] > '20190331'#(lf)and [Extract_Type] = 'Monthly'#(lf)"]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"report_date", type date}, {"target", Percentage.Type}, {"performance", Int64.Type}, {"financial_month", Int64.Type}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

