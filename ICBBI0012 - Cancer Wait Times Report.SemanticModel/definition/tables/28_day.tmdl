	partition 28_day-92290be5-127e-4b9f-aaea-a197920d107b = m
		mode: import
		source =
				let
				    Source = Sql.Database("grh-ccg-sql", "Data_Mart_Performance", [Query="-----------------------#(lf)--- 28 DAY STANDARD ---#(lf)-----------------------#(lf)#(lf)select [type] = '28 Day'#(lf)      ,[first_seen_provider] [first_seen_provider_code]#(lf)#(tab)  ,[c].[name] [first_seen_provider]#(lf)#(tab)  ,case when [First_Seen_Provider] = 'RTE' then 'Gloucestershire Hospitals NHS Foundation Trust'#(lf)            else 'Other Provider' end as [first_seen_provider_group]#(lf)      ,[Urgent_Suspected_Cancer_Type] [tumour_type]#(lf)#(tab)  ,case when [Urgent_Suspected_Cancer_Type] = 'acute leukaemia' then 'Suspected Acute Leukaemia'#(lf)#(tab)        when [Urgent_Suspected_Cancer_Type] like '%brain%' then 'Suspected Brain / Central Nervous System'#(lf)#(tab)#(tab)#(tab)when [Urgent_Suspected_Cancer_Type] like '%cancer not initially suspected%' then 'Non-Cancer Breast Symptoms'#(lf)#(tab)#(tab)    when [Urgent_Suspected_Cancer_Type] like '%breast%' then 'Suspected Breast'#(lf)#(tab)#(tab)#(tab)when [Urgent_Suspected_Cancer_Type] like '%children%' then 'Suspected Childrens Cancer'#(lf)#(tab)#(tab)#(tab)when [Urgent_Suspected_Cancer_Type] like '%gynaecological%' then 'Suspected Gynaecological'#(lf)#(tab)#(tab)#(tab)when [Urgent_Suspected_Cancer_Type] like '%Suspected haematological malignancies excluding acute leukaemia%' then 'Suspected Haematological Malignancies'#(lf)#(tab)#(tab)#(tab)when [Urgent_Suspected_Cancer_Type] like '%Head and Neck%' then 'Suspected Head and Neck'#(lf)#(tab)#(tab)#(tab)when [Urgent_Suspected_Cancer_Type] like '%lower gastrointestinal%' then 'Suspected Lower Gastrointestinal'#(lf)#(tab)#(tab)#(tab)when [Urgent_Suspected_Cancer_Type] like '%lung%' then 'Suspected Lung'#(lf)#(tab)#(tab)#(tab)when [Urgent_Suspected_Cancer_Type] like '%other%' then 'Suspected Other'#(lf)#(tab)#(tab)#(tab)when [Urgent_Suspected_Cancer_Type] like '%sarcoma%' then 'Suspected Sarcoma'#(tab)   #(lf)#(tab)#(tab)#(tab)when [Urgent_Suspected_Cancer_Type] like '%skin%' then 'Suspected Skin'#(lf)#(tab)#(tab)#(tab)when [Urgent_Suspected_Cancer_Type] like '%suspected testicular%' then 'Suspected Testicular'#(lf)#(tab)#(tab)#(tab)when [Urgent_Suspected_Cancer_Type] like '%upper gastrointestinal%' then 'Suspected Upper Gastrointestinal'#(lf)#(tab)#(tab)#(tab)when [Urgent_Suspected_Cancer_Type] like '%Suspected urological cancers (excluding testicular)%' then 'Suspected Urological'#(lf)#(tab)#(tab)#(tab)else 'Unknown' end as [tumour_group]#(lf)#(tab)  ,[No_Of_Patients] [total_patients]#(lf)#(tab)  ,[breaches] = ([Days_29_To_38]+[Days_39_To_62]+[Days_63_And_More])#(lf)      ,[report_number]#(lf)      ,case when [report_number] = '18.1' then '18.1 28 Day Two Week Wait'#(lf)#(tab)        when [report_number] = '18.2' then '18.2 28 Day Two Week Wait Non-Cancer Breast Symptoms'#(lf)#(tab)#(tab)#(tab)when [report_number] = '18.3' then '18.3 28 Day Screening'#(lf)#(tab)#(tab)#(tab)else 'error' end as [report_name]#(lf)#(tab)  ,[target] = 0.75#(lf)#(tab)  ,[d].[FinancialYear] [financial_year]#(lf)      ,LEFT([Report_Month],3) as [month_name]#(lf)#(tab)  ,[d].[FinancialMonth] [financial_month]#(lf)#(tab)  ,[d].[YearMonth] [year_month]#(lf)#(lf)#(lf)  from [Data_Mart_Performance].[dbo].[Cancer_28_Day_Aggregate_Data] [a]#(lf)  left join  [CCG_Reference].[Reference].[vw_DateLookup] [d] on [a].[Report_Date] = [d].[Date]#(lf)  left join [CCG_Reference].[Reference].[vw_OrganisationTrust] [c] on [a].[First_Seen_Provider] = [c].[OrganisationCode]#(lf)  where [Report_Date] > '20190331'#(lf)  and [Extract_Type] = 'Monthly'"]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"financial_month", Int64.Type}, {"year_month", Int64.Type}})
				in
				    #"Changed Type"

