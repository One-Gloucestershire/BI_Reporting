table 28_day
	lineageTag: 82aa9b94-981a-4290-858c-1df5362a81e5

	measure 28_day_performance = (SUM('28_day'[total_patients])-SUM('28_day'[breaches]))/(SUM('28_day'[total_patients]))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: d877ca7f-871f-4f4a-a028-55c475a7648e

	measure 28_day_target_% = MIN('28_day'[target])
