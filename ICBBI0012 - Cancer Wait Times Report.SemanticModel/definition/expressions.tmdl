		  #"Reordered Columns" = Table.ReorderColumns(#"Kept Errors", {"Row Number", "standard_group", "first_seen_provider_code", "first_seen_provider", "first_seen_provider_group", "first_treatment_provider_code", "first_treatment_provider", "first_treatment_provider_group", "consultant_upgrade_provider_code", "consultant_upgrade_provider", "consultant_upgrade_provider_group", "tumour_type", "total_treated", "breaches", "target", "performance", "report_number", "report_name", "financial_year", "month_name", "financial_month"})
		in
